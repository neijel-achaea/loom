{
  "type": "group",
  "name": "patrolling",
  "enabled": true,
  "items": [
    {
      "type": "function",
      "name": "onInstall",
      "enabled": true,
      "code": "@file:oninstall.js"
    },
    {
      "type": "function",
      "name": "onUninstall",
      "enabled": true,
      "code": "@file:onuninstall.js"
    },
    {
      "type": "function",
      "name": "onLoad",
      "enabled": true,
      "code": "@file:onload.js"
    },
    {
      "type": "function",
      "name": "onGMCP",
      "enabled": true,
      "code": "@file:ongmcp.js"
    },
    {
      "type": "group",
      "name": "core",
      "enabled": true,
      "items": [
        {
          "type": "function",
          "name": "patrolling_setup",
          "enabled": true,
          "code": "@file:patrolling_setup.js"
        },
        {
          "type": "function",
          "name": "patrolling_status",
          "enabled": true,
          "code": "@file:patrolling_status.js"
        },
        {
          "type": "function",
          "name": "patrolling_help",
          "enabled": true,
          "code": "@file:patrolling_help.js"
        },
        {
          "type": "alias",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:alias_patrolling.js"
            }
          ],
          "text": "^patrolling(?:\\s+(.*))?$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": false,
          "prefix_suffix": true
        }
      ]
    },
    {
      "type": "group",
      "name": "check",
      "enabled": true,
      "items": [
        {
          "type": "function",
          "name": "patrolling_check",
          "enabled": true,
          "code": "@file:patrolling_check.js"
        },
        {
          "type": "function",
          "name": "patrolling_report",
          "enabled": true,
          "code": "@file:patrolling_report.js"
        },
        {
          "type": "trigger",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:trigger_plants_header.js"
            }
          ],
          "text": "growing in this room",
          "matching": "substring",
          "whole_words": false,
          "case_sensitive": true
        },
        {
          "type": "trigger",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:trigger_plant_line.js"
            }
          ],
          "text": "\\(([a-z]+)\\)\\s+[A-Z][a-z]+\\s*$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true
        },
        {
          "type": "trigger",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:trigger_info_shrine.js"
            }
          ],
          "text": "\\b(?:shrine|totem)\\b",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true
        },
        {
          "type": "trigger",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:trigger_info_gag.js"
            }
          ],
          "text": "^\\S+\\s+\\S",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true
        },
        {
          "type": "trigger",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:trigger_info_end.js"
            }
          ],
          "text": "Number of objects:",
          "matching": "substring",
          "whole_words": false,
          "case_sensitive": true
        }
      ]
    },
    {
      "type": "group",
      "name": "suggest",
      "enabled": true,
      "items": [
        {
          "type": "function",
          "name": "patrolling_suggest",
          "enabled": true,
          "code": "@file:patrolling_suggest.js"
