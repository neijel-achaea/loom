            {
              "type": "highlight",
              "enabled": true,
              "highlight_fg": "#fdfdfd",
              "highlight_bg": "#b9670b",
              "highlight": "match",
              "highlight_backref": ""
            }
          ],
          "text": "The feeble rays of the waning sun glimmer with hollow promise before the storm\\-filled clouds consuming the skies\\.",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true
        },
        {
          "type": "trigger",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "highlight",
              "enabled": true,
              "highlight_fg": "#ff0000",
