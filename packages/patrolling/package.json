        {
          "type": "trigger",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "highlight",
              "enabled": true,
              "highlight_fg": "#fdfdfd",
              "highlight_bg": "#b9670b",
              "highlight": "match",
              "highlight_backref": ""
            }
          ],
          "text": "Utter blackness descends\\, the starlit heavens utterly concealed behind roiling clouds marked by thunderous portent\\.",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true
        },
        {
          "type": "trigger",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "highlight",
              "enabled": true,
              "highlight_fg": "#fdfdfd",
              "highlight_bg": "#b9670b",
              "highlight": "match",
              "highlight_backref": ""
            }
          ],
