            {
              "type": "script",
              "enabled": true,
              "script": "@file:trigger_lightning.js"
            }
          ],
          "text": "^A lightning bolt streaks down from the skies\\, full of fury and anger\\.$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true
