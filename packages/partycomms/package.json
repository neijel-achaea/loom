{
  "type": "group",
  "name": "partycomms",
  "enabled": true,
  "items": [
    {
      "type": "function",
      "name": "onInstall",
      "enabled": true,
      "code": "@file:oninstall.js"
    },
    {
      "type": "function",
      "name": "onUninstall",
      "enabled": true,
      "code": "@file:onuninstall.js"
    },
    {
      "type": "function",
      "name": "onLoad",
      "enabled": true,
      "code": "@file:onload.js"
    },
    {
      "type": "function",
      "name": "partycomms_gmcp",
      "enabled": true,
      "code": "@file:partycomms_gmcp.js"
    },
    {
      "type": "function",
      "name": "onGMCP",
      "enabled": true,
      "code": "@file:ongmcp.js"
    },
    {
      "type": "function",
      "name": "partycomms_icon",
      "enabled": true,
      "code": "@file:partycomms_icon.js"
    },
    {
      "type": "function",
      "name": "partycomms_setup",
      "enabled": true,
      "code": "@file:partycomms_setup.js"
    },
    {
      "type": "function",
      "name": "partycomms_send",
      "enabled": true,
      "code": "@file:partycomms_send.js"
    },
    {
      "type": "function",
      "name": "partycomms_render",
      "enabled": true,
      "code": "@file:partycomms_render.js"
    },
    {
      "type": "function",
      "name": "partycomms_help",
      "enabled": true,
      "code": "@file:partycomms_help.js"
    },
    {
      "type": "trigger",
      "name": "partycomms report",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_receive.js"
        }
      ],
      "text": "\\[PARTY\\] (\\w+) (\\S+) (\\d+)/(\\d+) (\\d+)/(\\d+) (\\d+)/(\\d+) (\\d+)/(\\d+) (\\d+) ([\\d.]+) ~ (\\d+) (\\S+) (.*)$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "partycomms ih item",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_ih_item.js"
        }
      ],
      "text": "^(\\w*?)(\\d+)\\s{2,}(.+)$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "partycomms ih end",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_ih_end.js"
        }
      ],
      "text": "^Number of objects: \\d+$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "partycomms ih gold",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_ih_gold.js"
        }
      ],
      "text": "^[\\d,]+ gold sovereigns?\\.$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "partycomms no party",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_no_party.js"
        }
      ],
      "text": "^You are not the member of any party\\.$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "alias",
      "name": "partycomms",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:alias_partycomms.js"
        }
      ],
      "text": "^partycomms(?:\\s+(.*))?$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": false,
      "prefix_suffix": true
    }
  ],
  "description": "Share vitals, rage and target with your party; party chips tab"
}
