{
  "type": "group",
  "name": "security",
  "enabled": true,
  "items": [
    {
      "type": "function",
      "name": "onInstall",
      "enabled": true,
      "code": "@file:oninstall.js"
    },
    {
      "type": "function",
      "name": "onUninstall",
      "enabled": true,
      "code": "@file:onuninstall.js"
    },
    {
      "type": "function",
      "name": "onLoad",
      "enabled": true,
      "code": "@file:onload.js"
    },
    {
      "type": "function",
      "name": "onGMCP",
      "enabled": true,
      "code": "@file:ongmcp.js"
    },
    {
      "type": "group",
      "name": "core",
      "enabled": true,
      "items": [
        {
          "type": "function",
          "name": "security_setup",
          "enabled": true,
          "code": "@file:security_setup.js"
        },
        {
          "type": "function",
          "name": "security_help",
          "enabled": true,
          "code": "@file:security_help.js"
        },
        {
          "type": "function",
          "name": "security_status",
          "enabled": true,
          "code": "@file:security_status.js"
        },
        {
          "type": "alias",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:alias_security.js"
            }
          ],
          "text": "^security(?:\\s+(.*))?$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": false,
          "prefix_suffix": true
        }
      ]
    },
    {
      "type": "group",
      "name": "antitheft",
      "enabled": true,
      "items": [
        {
          "type": "alias",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:alias_gg.js"
            }
          ],
          "text": "^gg(?:\\s+(\\d+))?$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": false,
          "prefix_suffix": true
        },
        {
          "type": "alias",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:alias_pg.js"
            }
          ],
          "text": "^pg$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": false,
          "prefix_suffix": true
        },
        {
          "type": "trigger",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:trigger_remove.js"
            }
          ],
          "text": "^You remove (.+)\\.$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true
        },
        {
          "type": "trigger",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:trigger_gold_out.js"
            }
          ],
          "text": "^You get (\\d+) gold sovereigns? from (.+)\\.$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true
        },
        {
          "type": "trigger",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "highlight",
              "enabled": true,
              "highlight_fg": "#ff0000",
              "highlight_bg": "#000000",
              "highlight": "match",
              "highlight_backref": ""
            },
            {
              "type": "sound",
              "enabled": true,
              "sound": "alarm"
            },
            {
              "type": "notify",
              "enabled": true,
              "notice": "[security] Potential theft attempt!",
              "notice_fg": "#ff0000",
              "notice_bg": "#000000"
            }
          ],
          "text": "^(\\w+) snaps (\\w+) fingers in front of you\\.$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true
        }
      ]
    },
    {
      "type": "group",
      "name": "selfishness",
      "enabled": true,
      "items": [
        {
          "type": "function",
          "name": "security_wrap",
          "enabled": true,
          "code": "@file:security_wrap.js"
        },
        {
          "type": "trigger",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:trigger_selfish_up.js"
            }
          ],
          "text": "^You rub your hands together greedily\\.$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true
        },
        {
          "type": "trigger",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:trigger_selfish_down.js"
            }
          ],
          "text": "^A feeling of generosity spreads throughout you\\.$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true
        },
        {
          "type": "alias",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:alias_give.js"
            }
          ],
          "text": "^give (.*)$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true,
          "prefix_suffix": true
        },
        {
          "type": "alias",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:alias_sell.js"
            }
          ],
          "text": "^sell (.*)$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true,
          "prefix_suffix": true
        },
        {
          "type": "alias",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:alias_drop.js"
            }
          ],
          "text": "^drop (.*)$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true,
          "prefix_suffix": true
        },
        {
          "type": "alias",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:alias_offer.js"
            }
          ],
          "text": "^offer (.*)$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true,
          "prefix_suffix": true
        }
      ]
    }
  ],
  "description": "Antitheft for worn items and gold, backpack gold, selfish wrappers"
}
