{
 "type": "group",
 "name": "talpieces",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "@file:oninstall.js"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "@file:onuninstall.js"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "@file:onload.js"
  },
  {
   "type": "group",
   "name": "core",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "talpieces_setup",
     "enabled": true,
     "code": "@file:talpieces_setup.js"
    },
    {
     "type": "function",
     "name": "talpieces_status",
     "enabled": true,
     "code": "@file:talpieces_status.js"
    },
    {
     "type": "function",
     "name": "talpieces_help",
     "enabled": true,
     "code": "@file:talpieces_help.js"
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "@file:alias_talpieces.js"
      }
     ],
     "text": "^talpieces(?:\\s+(.*))?$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": false,
     "prefix_suffix": true
    }
   ]
  },
  {
   "type": "group",
   "name": "tracking",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "talpieces_sync",
     "enabled": true,
     "code": "@file:talpieces_sync.js"
    },
    {
     "type": "function",
     "name": "talpieces_record",
     "enabled": true,
     "code": "@file:talpieces_record.js"
    },
    {
     "type": "function",
     "name": "talpieces_flush",
     "enabled": true,
     "code": "@file:talpieces_flush.js"
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "@file:trigger_list_header.js"
      }
     ],
     "text": "^\\s*Num\\b.*\\bLevel\\b.*\\bKeyword\\b",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": false
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "@file:trigger_list_item.js"
      }
     ],
     "text": "^\\s*(?:[A-Za-z]\\s+)?\\(?(\\d+)\\)?\\s+(.+?)\\s+(\\d+)\\s+(?:Dragon\\s+)?(\\w+)dragon(\\w+)\\s*$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "@file:trigger_list_more.js"
      }
     ],
     "text": "Type MORE if you wish to continue",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": false
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "@file:trigger_found.js"
      }
     ],
     "text": "^You have found(?: a)? (\\w+) Dragon(?:'s)? (.+) \\(level (\\d+)\\) talisman piece!$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "@file:trigger_trade_in.js"
      }
     ],
     "text": "^(\\w+) has traded the level (\\d+) piece '(?:a )?(\\w+) Dragon(?:'s)? (.+)' to you\\.$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "@file:trigger_trade_out.js"
      }
     ],
     "text": "^You trade the level (\\d+) piece (?:a )?(\\w+) Dragon(?:'s)? (.+) to (\\w+)\\.$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    }
   ]
  },
  {
   "type": "group",
   "name": "reports",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "talpieces_render",
     "enabled": true,
     "code": "@file:talpieces_render.js"
    },
    {
     "type": "function",
     "name": "talpieces_need",
     "enabled": true,
     "code": "@file:talpieces_need.js"
    },
    {
     "type": "function",
     "name": "talpieces_rate",
     "enabled": true,
     "code": "@file:talpieces_rate.js"
    },
    {
     "type": "function",
     "name": "talpieces_seed",
     "enabled": true,
     "code": "@file:talpieces_seed.js"
    }
   ]
  },
  {
   "type": "group",
   "name": "combine",
   "enabled": true,
   "items": [
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "@file:trigger_combine.js"
      }
     ],
     "text": "([1-6])     Dragon     (\\w+)",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": false
    }
   ]
  },
  {
   "type": "group",
   "name": "highlights",
   "enabled": true,
   "items": [
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "highlight",
       "enabled": true,
       "highlight_fg": "#a100ff",
       "highlight_bg": "#000000",
       "highlight": "line",
       "highlight_backref": ""
      },
      {
       "type": "sound",
       "enabled": true,
       "sound": "bell"
      }
     ],
     "text": "talisman piece!",
     "matching": "substring",
     "whole_words": false,
     "case_sensitive": true
    }
   ]
  }
 ],
 "description": "Dragon talisman piece tracker with progress history. Live panel in a UI tab named 'Talismans'. TALPIECES HELP for commands. State in client.loom.talpieces; history in the talpieces_hist variable as [unixSeconds, cappedCommon, cappedRare], one point per hour in which totals change."
}
