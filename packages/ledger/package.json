{
  "type": "group",
  "name": "ledger",
  "enabled": true,
  "items": [
    {
      "type": "function",
      "name": "onInstall",
      "enabled": true,
      "code": "@file:oninstall.js"
    },
    {
      "type": "function",
      "name": "onUninstall",
      "enabled": true,
      "code": "@file:onuninstall.js"
    },
    {
      "type": "function",
      "name": "onLoad",
      "enabled": true,
      "code": "@file:onload.js"
    },
    {
      "type": "function",
      "name": "ledger_setup",
      "enabled": true,
      "code": "@file:ledger_setup.js"
    },
    {
      "type": "function",
      "name": "ledger_sync",
      "enabled": true,
      "code": "@file:ledger_sync.js"
    },
    {
      "type": "function",
      "name": "ledger_check",
      "enabled": true,
      "code": "@file:ledger_check.js"
    },
    {
      "type": "function",
      "name": "ledger_digest",
      "enabled": true,
      "code": "@file:ledger_digest.js"
    },
    {
      "type": "function",
      "name": "ledger_render",
      "enabled": true,
      "code": "@file:ledger_render.js"
    },
    {
      "type": "function",
      "name": "ledger_help",
      "enabled": true,
      "code": "@file:ledger_help.js"
    },
    {
      "type": "trigger",
      "name": "ledger date line",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_date_line.js"
        }
      ],
      "text": "^(?:It is now|Today is) the (\\d+)(?:st|nd|rd|th) of (\\w+), (\\d+) years after",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "ledger date echo",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_date_echo.js"
        }
      ],
      "text": "^date$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "ledger date block",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_it_is_a_z.js"
        }
      ],
      "text": "^It is [a-z\\- ]+\\.$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "ledger date block end",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_in_your_world_it_is.js"
        }
      ],
      "text": "^In your world it is ",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "alias",
      "name": "ledger",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:alias_ledger.js"
        }
      ],
      "text": "^ledger(?:\\s+(.*))?$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": false,
      "prefix_suffix": true
    }
  ],
  "description": "IC reminders and standing items on the Achaean calendar, in a UI tab named 'Ledger'. The date comes from the game's hourly rollover line and a gagged DATE on login. State in client.loom.ledger (publishes day, the Achaean day number); items in ledger_items. LEDGER HELP for commands."
}
