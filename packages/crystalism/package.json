              "type": "script",
              "enabled": true,
              "script": "@file:autorefine__trigger_s_d_s_crystal_s_w.js"
            }
          ],
          "text": "^(.*\\[\\s*\\d+\\]\\s*crystal\\s+\\w+.*)$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true
        },
        {
          "type": "trigger",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:autorefine__trigger_you_have_stored_d_facets_for_refinement.js"
            }
