{
  "type": "group",
  "name": "crystalism",
  "enabled": true,
  "items": [
    {
      "type": "group",
      "name": "autorefine",
      "enabled": true,
      "items": [
        {
          "type": "alias",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:autorefine__alias_autorefine_s_d.js"
            }
          ],
          "text": "^autorefine(?:\\s+(\\d+))?$",
          "matching": "regexp",
          "whole_words": true,
          "case_sensitive": true,
          "prefix_suffix": true
