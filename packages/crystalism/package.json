      "matching": "regexp",
      "whole_words": true,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_the_call_of_the_master_crystal_is.js"
        }
      ],
      "text": "^The call of the Master Crystal is irresistible and you are drawn to it\\.$",
      "matching": "regexp",
      "whole_words": true,
      "case_sensitive": true
