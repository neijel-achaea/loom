{
  "type": "group",
  "name": "crystalism",
  "enabled": true,
  "items": [
    {
      "type": "function",
      "name": "onInstall",
      "enabled": true,
      "code": "@file:oninstall.js"
    },
    {
      "type": "function",
      "name": "onUninstall",
      "enabled": true,
      "code": "@file:onuninstall.js"
    },
    {
      "type": "function",
      "name": "onLoad",
      "enabled": true,
      "code": "@file:onload.js"
    },
    {
      "type": "group",
      "name": "core",
      "enabled": true,
      "items": [
        {
          "type": "function",
          "name": "crystalism_setup",
          "enabled": true,
          "code": "@file:crystalism_setup.js"
        },
        {
          "type": "function",
          "name": "crystalism_status",
          "enabled": true,
          "code": "@file:crystalism_status.js"
        },
        {
          "type": "function",
          "name": "crystalism_help",
          "enabled": true,
          "code": "@file:crystalism_help.js"
        },
        {
          "type": "alias",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:alias_crystalism.js"
            }
          ],
          "text": "^crystalism(?:\\s+(.*))?$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": false,
          "prefix_suffix": true
        }
      ]
    },
    {
      "type": "group",
      "name": "refine",
      "enabled": true,
      "items": [
        {
          "type": "function",
          "name": "crystalism_refine",
          "enabled": true,
          "code": "@file:crystalism_refine.js"
        },
        {
          "type": "function",
          "name": "crystalism_watchdog",
          "enabled": true,
          "code": "@file:crystalism_watchdog.js"
        },
        {
          "type": "function",
          "name": "crystalism_touch",
          "enabled": true,
          "code": "@file:crystalism_touch.js"
        },
        {
          "type": "function",
          "name": "crystalism_plan",
          "enabled": true,
          "code": "@file:crystalism_plan.js"
        },
        {
          "type": "function",
          "name": "crystalism_pump",
          "enabled": true,
          "code": "@file:crystalism_pump.js"
        },
        {
          "type": "function",
          "name": "crystalism_abort",
          "enabled": true,
          "code": "@file:crystalism_abort.js"
        },
        {
          "type": "trigger",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:trigger_rift_row.js"
            }
          ],
          "text": "^(.*\\[\\s*\\d+\\]\\s*crystal\\s+\\w+.*)$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true
        },
        {
          "type": "trigger",
          "name": "",
          "enabled": true,
          "actions": [
            {
              "type": "script",
              "enabled": true,
              "script": "@file:trigger_facets.js"
            }
          ],
          "text": "^You have stored (\\d+) facets? for refinement\\.$",
          "matching": "regexp",
          "whole_words": false,
          "case_sensitive": true
        }
      ]
    },
    {
      "type": "trigger",
      "name": "",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_pearl.js"
        }
      ],
      "text": "^A glistening iridescent pearl tumbles out of the corpse of (.*)\\.$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_gate.js"
        }
      ],
      "text": "^(\\w+) tells you(.*)\\, \\\"Gate\\.\\\"$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_attune.js"
        }
      ],
      "text": "^You relax your muscles and attune yourself to your Master Crystal\\, feeling its vibrations draw your soul\\.$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_master_call.js"
        }
      ],
      "text": "^The call of the Master Crystal is irresistible and you are drawn to it\\.$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    }
  ],
  "description": "Even crystal refining, pearl pickup, and sonic portals for the city"
}
