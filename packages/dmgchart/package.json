{
  "type": "group",
  "name": "dmgchart",
  "enabled": true,
  "items": [
    {
      "type": "function",
      "name": "onInstall",
      "enabled": true,
      "code": "@file:oninstall.js"
    },
    {
      "type": "function",
      "name": "onUninstall",
      "enabled": true,
      "code": "@file:onuninstall.js"
    },
    {
      "type": "function",
      "name": "onLoad",
      "enabled": true,
      "code": "@file:onload.js"
    },
    {
      "type": "function",
      "name": "dmgchart_gmcp",
      "enabled": true,
      "code": "@file:dmgchart_gmcp.js"
    },
    {
      "type": "function",
      "name": "onGMCP",
      "enabled": true,
      "code": "@file:ongmcp.js"
    },
    {
      "type": "function",
      "name": "dmgchart_setup",
      "enabled": true,
      "code": "@file:dmgchart_setup.js"
    },
    {
      "type": "function",
      "name": "dmgchart_add",
      "enabled": true,
      "code": "@file:dmgchart_add.js"
    },
    {
      "type": "function",
      "name": "dmgchart_recent",
      "enabled": true,
      "code": "@file:dmgchart_recent.js"
    },
    {
      "type": "function",
      "name": "dmgchart_lasts",
      "enabled": true,
      "code": "@file:dmgchart_lasts.js"
    },
    {
      "type": "function",
      "name": "dmgchart_render",
      "enabled": true,
      "code": "@file:dmgchart_render.js"
    },
    {
      "type": "function",
      "name": "dmgchart_help",
      "enabled": true,
      "code": "@file:dmgchart_help.js"
    },
    {
      "type": "trigger",
      "name": "dmgchart crit",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_crit.js"
        }
      ],
      "text": "^You have scored an? (.*?) ?CRITICAL hit!$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "dmgchart outgoing",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_outgoing.js"
        }
      ],
      "text": "^Damage dealt: (\\d+) \\(([^)]+)\\)\\.$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "dmgchart incoming",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_incoming.js"
        }
      ],
      "text": "^Health lost: (\\d+) \\(([^)]+)\\)\\.$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "dmgchart bleed",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_bleed.js"
        }
      ],
      "text": "^You bleed (\\d+) health\\.$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "alias",
      "name": "dmgchart",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:alias_dmgchart.js"
        }
      ],
      "text": "^dmgchart(?:\\s+(.*))?$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": false,
      "prefix_suffix": true
    }
  ],
  "description": "Damage dealt and taken by type per fight, health lasts, recorded sessions"
}
