{
  "type": "group",
  "name": "huntstats",
  "enabled": true,
  "items": [
    {
      "type": "function",
      "name": "onInstall",
      "enabled": true,
      "code": "@file:oninstall.js"
    },
    {
      "type": "function",
      "name": "onUninstall",
      "enabled": true,
      "code": "@file:onuninstall.js"
    },
    {
      "type": "function",
      "name": "onLoad",
      "enabled": true,
      "code": "@file:onload.js"
    },
    {
      "type": "function",
      "name": "onGMCP",
      "enabled": true,
      "code": "@file:ongmcp.js"
    },
    {
      "type": "function",
      "name": "huntstats_setup",
      "enabled": true,
      "code": "@file:huntstats_setup.js"
    },
    {
      "type": "function",
      "name": "huntstats_finalize",
      "enabled": true,
      "code": "@file:huntstats_finalize.js"
    },
    {
      "type": "function",
      "name": "huntstats_render",
      "enabled": true,
      "code": "@file:huntstats_render.js"
    },
    {
      "type": "function",
      "name": "huntstats_status",
      "enabled": true,
      "code": "@file:huntstats_status.js"
    },
    {
      "type": "function",
      "name": "huntstats_help",
      "enabled": true,
      "code": "@file:huntstats_help.js"
    },
    {
      "type": "alias",
      "name": "",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:alias_huntstats.js"
        }
      ],
      "text": "^huntstats(?:\\s+(.*))?$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": false,
      "prefix_suffix": true
    },
    {
      "type": "trigger",
      "name": "",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_experience.js"
        }
      ],
      "text": "^You have gained (\\d+) experience\\.",
      "matching": "regexp",
      "whole_words": true,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_gold.js"
        }
      ],
      "text": "^You pick up ([\\d,]+) gold sovereigns\\.",
      "matching": "regexp",
      "whole_words": true,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_slain.js"
        }
      ],
      "text": "^You have slain ",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_level.js"
        }
      ],
      "text": "Level\\s*:\\s*(\\d+)\\s*\\(([\\d.]+)%\\)",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    }
  ],
  "description": "Per-area hunting records in a UI tab named 'Stats': xp, gold and kills an hour, Dragonhood progress and ETA, who hunted with you, area comparison. A hunt is filed when you leave its area and survives a refresh or disconnect. Area, players and level come from GMCP. State in client.loom.huntstats; records in huntstats_areas and huntstats_log. HUNTSTATS HELP for commands."
}
