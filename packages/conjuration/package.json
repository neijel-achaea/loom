{
  "type": "group",
  "name": "conjuration",
  "enabled": true,
  "items": [
    {
      "type": "function",
      "name": "onInstall",
      "enabled": true,
      "code": "@file:oninstall.js"
    },
    {
      "type": "function",
      "name": "onUninstall",
      "enabled": true,
      "code": "@file:onuninstall.js"
    },
    {
      "type": "alias",
      "name": "",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:alias_conjure_w.js"
        }
      ],
      "text": "^conjure (\\w+)$",
      "matching": "regexp",
      "whole_words": true,
      "case_sensitive": true,
      "prefix_suffix": true
    }
  ],
  "description": ""
}