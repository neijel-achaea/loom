          "script": "@file:trigger_ritual.js"
        }
      ],
      "text": "^(?:A somehow toneless yet beautiful sound is heard in the distance, indicating that you may begin\\.|You chant, \".*|A pure, clear tone fills the air as you ring a small silver bell\\.|The ouroboros flashes .*|You take .* from .*ouroboros.*|You must regain balance first\\.|You must wait a short while to use a say-like command again\\.|You have recovered balance on all limbs\\.|Glancing into your rift, you see:|\\[\\s*[\\d,]+\\] .*|-{10,}|A feeling of generosity spreads throughout you\\.|You rub your hands together greedily\\.)$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "alias",
      "name": "conjuration",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:alias_conjuration.js"
        }
      ],
      "text": "^conjuration(?:\\s+(.*))?$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": false,
      "prefix_suffix": true
    }
  ],
  "description": "Sigil creation rituals, one step at a time as the game is ready"
