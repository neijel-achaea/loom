     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "@file:trigger_cast_other.js"
      }
     ],
     "text": "^([A-Z][a-z]+) cocks back (?:his|her|their|its) arm and smoothly casts a line into",
     "matching": "regexp",
