     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "@file:trigger_hook_self.js"
      }
     ],
     "text": "^You quickly jerk back your fishing pole",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "@file:trigger_hook_other.js"
      }
     ],
     "text": "^([A-Z][a-z]+) quickly jerks back (?:his|her|their|its) fishing pole",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    }
   ]
  },
  {
   "type": "group",
   "name": "rankings",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "fishingstats_rank",
     "enabled": true,
     "code": "@file:fishingstats_rank.js"
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
