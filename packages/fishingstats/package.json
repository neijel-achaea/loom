     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "@file:trigger_rankings_row.js"
      }
     ],
     "text": "^(?:A|An|The)\\s+(.+?)\\s+([A-Z][a-z]+)\\s+(\\d+)\\s+(\\d+)\\s+\\d+(?:st|nd|rd|th)\\s+of\\s+\\w+,\\s+(\\d+)\\s+AF?\\s*$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    }
   ]
