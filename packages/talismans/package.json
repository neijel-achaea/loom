    {
      "type": "trigger",
      "name": "Talisman List Header",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_talisman_list_header.js"
        }
      ],
      "text": "^\\s*Num\\b.*\\bLevel\\b.*\\bKeyword\\b",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": false
    },
    {
      "type": "trigger",
      "name": "Talisman List Item",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_talisman_list_item.js"
        }
      ],
      "text": "^\\s*(?:[A-Za-z]\\s+)?\\(?(\\d+)\\)?\\s+(.+?)\\s+(\\d+)\\s+(?:Dragon\\s+)?(\\w+)dragon(\\w+)\\s*$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "Talisman List More",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_talisman_list_more.js"
        }
      ],
      "text": "Type MORE if you wish to continue",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": false
    },
    {
      "type": "trigger",
      "name": "Talisman Found",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_talisman_found.js"
        }
      ],
      "text": "^You have found(?: a)? (\\w+) Dragon(?:'s)? (.+) \\(level (\\d+)\\) talisman piece!$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "Talisman Trade In",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_talisman_trade_in.js"
        }
      ],
      "text": "^(\\w+) has traded the level (\\d+) piece '(?:a )?(\\w+) Dragon(?:'s)? (.+)' to you\\.$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "Talisman Trade Out",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_talisman_trade_out.js"
        }
      ],
      "text": "^You trade the level (\\d+) piece (?:a )?(\\w+) Dragon(?:'s)? (.+) to (\\w+)\\.$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "alias",
      "name": "Talisman Needed",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:alias_talisman_needed.js"
        }
      ],
      "text": "^dtneed$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true,
      "prefix_suffix": true
    },
    {
      "type": "alias",
      "name": "Talisman Wipe",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:alias_talisman_wipe.js"
        }
