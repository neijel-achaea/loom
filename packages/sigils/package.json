{
  "type": "group",
  "name": "sigils",
  "enabled": true,
  "items": [
    {
      "type": "function",
      "name": "onInstall",
      "enabled": true,
      "code": "@file:oninstall.js"
    },
    {
      "type": "function",
      "name": "onUninstall",
      "enabled": true,
      "code": "@file:onuninstall.js"
    },
    {
      "type": "function",
      "name": "onLoad",
      "enabled": true,
      "code": "@file:onload.js"
    },
    {
      "type": "function",
      "name": "onGMCP",
      "enabled": true,
      "code": "@file:ongmcp.js"
    },
    {
      "type": "function",
      "name": "sigils_setup",
      "enabled": true,
      "code": "@file:sigils_setup.js"
    },
    {
      "type": "function",
      "name": "sigils_enter",
      "enabled": true,
      "code": "@file:sigils_enter.js"
    },
    {
      "type": "function",
      "name": "sigils_take",
      "enabled": true,
      "code": "@file:sigils_take.js"
    },
    {
      "type": "function",
      "name": "sigils_parse",
      "enabled": true,
      "code": "@file:sigils_parse.js"
    },
    {
      "type": "function",
      "name": "sigils_settle",
      "enabled": true,
      "code": "@file:sigils_settle.js"
    },
    {
      "type": "function",
      "name": "sigils_flag",
      "enabled": true,
      "code": "@file:sigils_flag.js"
    },
    {
      "type": "function",
      "name": "sigils_status",
      "enabled": true,
      "code": "@file:sigils_status.js"
    },
    {
      "type": "function",
      "name": "sigils_help",
      "enabled": true,
      "code": "@file:sigils_help.js"
    },
    {
      "type": "function",
      "name": "sigils_watch",
      "enabled": true,
      "code": "@file:sigils_watch.js"
    },
    {
      "type": "function",
      "name": "sigils_report",
      "enabled": true,
      "code": "@file:sigils_report.js"
    },
    {
      "type": "function",
      "name": "sigils_ignore",
      "enabled": true,
      "code": "@file:sigils_ignore.js"
    },
    {
      "type": "function",
      "name": "sigils_unignore",
      "enabled": true,
      "code": "@file:sigils_unignore.js"
    },
    {
      "type": "function",
      "name": "sigils_threshold",
      "enabled": true,
      "code": "@file:sigils_threshold.js"
    },
    {
      "type": "function",
      "name": "sigils_cost",
      "enabled": true,
      "code": "@file:sigils_cost.js"
    },
    {
      "type": "alias",
      "name": "sigils",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:alias_sigils.js"
        }
      ],
      "text": "^sigils(?:\\s+(.*))?$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": false,
      "prefix_suffix": true
    },
    {
      "type": "trigger",
      "name": "sigils_usefulness",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_usefulness.js"
        }
      ],
      "text": "^It has (.+?) of usefulness left\\.$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "sigils_flame",
      "enabled": true,
      "actions": [
        {
          "type": "highlight",
          "enabled": true,
          "highlight_fg": "#ff008f",
          "highlight_bg": "#000000",
          "highlight": "line",
          "highlight_backref": ""
        },
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_flame.js"
        }
      ],
      "text": "^There is a flame-shaped sigil attached\\. \\((.+?) remaining\\)$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    },
    {
      "type": "trigger",
      "name": "sigils_nothing",
      "enabled": true,
      "actions": [
        {
          "type": "script",
          "enabled": true,
          "script": "@file:trigger_nothing.js"
        }
      ],
      "text": "^You (?:do not|don't) see that here\\.$",
      "matching": "regexp",
      "whole_words": false,
      "case_sensitive": true
    }
  ],
  "description": "Monolith and flame sigil watcher, with the cost of what's running out"
}
