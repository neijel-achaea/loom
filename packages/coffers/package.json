{
 "type": "group",
 "name": "coffers",
 "enabled": true,
 "description": "Gold tracker: fortune, income and spending by session and day, goals",
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "@file:oninstall.js"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "@file:onuninstall.js"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "@file:onload.js"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "@file:ongmcp.js"
  },
  {
   "type": "function",
   "name": "coffers_setup",
   "enabled": true,
   "code": "@file:coffers_setup.js"
  },
  {
   "type": "function",
   "name": "coffers_tick",
   "enabled": true,
   "code": "@file:coffers_tick.js"
  },
  {
   "type": "function",
   "name": "coffers_close",
   "enabled": true,
   "code": "@file:coffers_close.js"
  },
  {
   "type": "function",
   "name": "coffers_render",
   "enabled": true,
   "code": "@file:coffers_render.js"
  },
  {
   "type": "function",
   "name": "coffers_cmd",
   "enabled": true,
   "code": "@file:coffers_cmd.js"
  },
  {
   "type": "function",
   "name": "coffers_help",
   "enabled": true,
   "code": "@file:coffers_help.js"
  },
  {
    "type": "trigger",
    "name": "coffers gift",
    "enabled": true,
    "actions": [
      {
        "type": "script",
        "enabled": true,
        "script": "@file:trigger_gift.js"
      }
    ],
    "text": "^([A-Z][a-z]+) gives ([\\d,]+) gold sovereigns? to you\\.$",
    "matching": "regexp",
    "whole_words": false,
    "case_sensitive": true
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "@file:alias_coffers.js"
    }
   ],
   "text": "^coffers(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  }
 ]
}
