{
 "type": "group",
 "name": "numpad movement",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "if (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nclient.loom.registry.numpad_movement = { version: \"1.0.0\", keyword: \"\", desc: \"Move with the number pad; look, score and inventory keys\" };\ndisplay_notice(\"[numpad_movement] installed. Number pad: 1-9 the eight directions (5 is up), 0 down, + in, - out, . look, / score, * inventory.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down but the registry entry.\n// Leave LOOM and the integrations at once, not at the next load (#137):\n// loom takes the entry out and redraws the tabs that showed this package's answers.\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"numpad_movement\");\n  else delete client.loom.registry.numpad_movement;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Register with loom (the package has no command of its own). Done here\n// directly: the package is named \"numpad movement\", with a space.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nclient.loom.registry.numpad_movement = { version: \"1.0.0\", keyword: \"\", desc: \"Move with the number pad; look, score and inventory keys\" };\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Registers the package on the first GMCP message after an import; Nexus\n// doesn't run onInstall when importing over an existing package.\nif (!client.loom || !client.loom.registry || !client.loom.registry.numpad_movement) {\n  if (!client.loom) client.loom = {};\n  if (!client.loom.registry) client.loom.registry = {};\n  client.loom.registry.numpad_movement = { version: \"1.0.0\", keyword: \"\", desc: \"Move with the number pad; look, score and inventory keys\" };\n}\n"
  },
  {
   "type": "keybind",
   "name": "1 southwest",
   "enabled": true,
   "actions": [
    {
     "type": "command",
     "enabled": true,
     "command": "sw",
     "prefix_suffix": false
    }
   ],
   "key": "97",
   "key_alt": false,
   "key_ctrl": false,
   "key_shift": false
  },
