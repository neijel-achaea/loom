{
 "type": "group",
 "name": "numpad movement",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"numpad_movement_setup\", [], \"numpad_movement\");\ndisplay_notice(\"[numpad_movement] installed. Number pad: 1-9 the eight directions (5 is up), 0 down, + in, - out, . look, / score, * inventory.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down.\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"numpad_movement_setup\", [], \"numpad_movement\");\n"
  },
  {
   "type": "function",
   "name": "numpad_movement_setup",
   "enabled": true,
   "code": "// numpad_movement_setup -- run from onLoad and onInstall. The package is only\n// keybindings, so this just registers it (it has no command of its own).\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nclient.loom.registry.numpad_movement = { version: \"0.2.0\", keyword: \"\" };\nif (!client.loom.numpad_movement) client.loom.numpad_movement = {};\n"
  },
  {
   "type": "keybind",
   "name": "1 southwest",
   "enabled": true,
   "actions": [
    {
     "type": "command",
     "enabled": true,
     "command": "sw",
     "prefix_suffix": false
    }
   ],
   "key": "97",
   "key_alt": false,
   "key_ctrl": false,
   "key_shift": false
  },
