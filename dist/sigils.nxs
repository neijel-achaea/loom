{
 "type": "group",
 "name": "sigils",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"sigils_setup\", [], \"sigils\");\ndisplay_notice(\"[sigils] installed. SIGILS HELP for commands, SIGILS WATCH ON to start.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is uninstalled\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"sigils_setup\", [], \"sigils\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Sigils follows the room and the city itself.\nif (!client.loom) client.loom = {};\nif (!client.loom.sigils) client.loom.sigils = {};\nvar S = client.loom.sigils;\n// A payload that came empty or as something other than an object reads as\n// an empty one (#135).\nvar sgG = (args.gmcp_args && typeof args.gmcp_args == \"object\") ? args.gmcp_args : {};\n\nif (args.gmcp_method == \"Char.Status\" && sgG.city) {\n  S.city = String(sgG.city).replace(/\\s*\\(.*\\)\\s*$/, \"\");\n}\n\nif (args.gmcp_method == \"Room.Info\") {\n  S.room = { id: sgG.num, name: sgG.name };\n  run_function(\"sigils_enter\", [], \"sigils\");\n}\n"
  },
  {
   "type": "function",
   "name": "sigils_setup",
   "enabled": true,
   "code": "/*loom-hot sigils f:sigils_setup 4eb1687b47*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"sigils\"];\nif (!lhH || lhH.v !== \"4eb1687b47\") { run_function(\"sigils__hot\", [], \"sigils\"); lhH = client.loom.__hot[\"sigils\"]; }\nlhH.f[\"f:sigils_setup\"](args);"
  },
  {
   "type": "function",
   "name": "sigils_enter",
   "enabled": true,
   "code": "/*loom-hot sigils f:sigils_enter 4eb1687b47*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"sigils\"];\nif (!lhH || lhH.v !== \"4eb1687b47\") { run_function(\"sigils__hot\", [], \"sigils\"); lhH = client.loom.__hot[\"sigils\"]; }\nlhH.f[\"f:sigils_enter\"](args);"
  },
  {
   "type": "function",
   "name": "sigils_take",
   "enabled": true,
   "code": "// sigils_take -- pops the oldest queued room into S.head (or null).\n// Entries older than 15s are dropped: their reply was lost somewhere.\nvar S = client.loom.sigils;\nvar q = S.queue || [];\nvar now = Date.now();\nvar head = null;\nwhile (q.length > 0 && head === null) {\n  var e = q.shift();\n  if (now - e.t < 15000) head = e;\n}\nS.queue = q;\nS.head = head;\n"
  },
  {
   "type": "function",
   "name": "sigils_parse",
   "enabled": true,
   "code": "// sigils_parse -- S.parseIn (\"109 months\", \"about a month\", ...) -> S.parseOut.\n// -1 = unreadable, 0 = under a month.\nvar S = client.loom.sigils;\nvar txt = String(S.parseIn || \"\");\nvar months = -1;\nif (/^about a month$/i.test(txt)) months = 1;\nelse if (/^about a year$/i.test(txt)) months = 12;\nelse {\n  var m = /(\\d+)\\s*month/i.exec(txt);\n  var y = /(\\d+)\\s*year/i.exec(txt);\n  if (m) months = parseInt(m[1], 10);\n  else if (y) months = parseInt(y[1], 10) * 12;\n  else if (/less than/i.test(txt)) months = 0;\n}\nS.parseOut = months;\n"
  },
  {
   "type": "function",
   "name": "sigils_settle",
   "enabled": true,
   "code": "// sigils_settle -- finalises the monolith waiting in S.await.\n// No flame reading at this point means the flame line never showed: missing.\nvar S = client.loom.sigils;\nvar aw = S.await;\nif (aw) {\n  S.await = null;\n  var fl = (aw.flame === undefined || aw.flame === null) ? -1 : aw.flame;\n  S.flag = { id: aw.id, name: aw.name, months: aw.months, flame: fl };\n  run_function(\"sigils_flag\", [], \"sigils\");\n}\n"
  },
  {
   "type": "function",
   "name": "sigils_flag",
   "enabled": true,
   "code": "/*loom-hot sigils f:sigils_flag 4eb1687b47*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"sigils\"];\nif (!lhH || lhH.v !== \"4eb1687b47\") { run_function(\"sigils__hot\", [], \"sigils\"); lhH = client.loom.__hot[\"sigils\"]; }\nlhH.f[\"f:sigils_flag\"](args);"
  },
  {
   "type": "function",
   "name": "sigils_status",
   "enabled": true,
   "code": "var S = client.loom.sigils;\nvar on = get_variable(\"sigils_on\");\nvar thr = get_variable(\"sigils_threshold\");\nvar n = Object.keys(get_variable(\"sigils_flagged\") || {}).length;\nvar ni = Object.keys(get_variable(\"sigils_ignored\") || {}).length;\ndisplay_notice(\"[sigils] watch \" + (on ? \"ON\" : \"OFF\") + \", threshold \" + thr + \" months, \"\n  + n + \" room(s) flagged, \" + ni + \" ignored. SIGILS HELP for commands.\", on ? \"lime\" : \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "sigils_help",
   "enabled": true,
   "code": "/*loom-hot sigils f:sigils_help 4eb1687b47*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"sigils\"];\nif (!lhH || lhH.v !== \"4eb1687b47\") { run_function(\"sigils__hot\", [], \"sigils\"); lhH = client.loom.__hot[\"sigils\"]; }\nlhH.f[\"f:sigils_help\"](args);"
  },
  {
   "type": "function",
   "name": "sigils_watch",
   "enabled": true,
   "code": "/*loom-hot sigils f:sigils_watch 4eb1687b47*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"sigils\"];\nif (!lhH || lhH.v !== \"4eb1687b47\") { run_function(\"sigils__hot\", [], \"sigils\"); lhH = client.loom.__hot[\"sigils\"]; }\nlhH.f[\"f:sigils_watch\"](args);"
  },
  {
   "type": "function",
   "name": "sigils_report",
   "enabled": true,
   "code": "/*loom-hot sigils f:sigils_report 4eb1687b47*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"sigils\"];\nif (!lhH || lhH.v !== \"4eb1687b47\") { run_function(\"sigils__hot\", [], \"sigils\"); lhH = client.loom.__hot[\"sigils\"]; }\nlhH.f[\"f:sigils_report\"](args);"
  },
  {
   "type": "function",
   "name": "sigils_ignore",
   "enabled": true,
   "code": "/*loom-hot sigils f:sigils_ignore 4eb1687b47*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"sigils\"];\nif (!lhH || lhH.v !== \"4eb1687b47\") { run_function(\"sigils__hot\", [], \"sigils\"); lhH = client.loom.__hot[\"sigils\"]; }\nlhH.f[\"f:sigils_ignore\"](args);"
  },
  {
   "type": "function",
   "name": "sigils_unignore",
   "enabled": true,
   "code": "var S = client.loom.sigils;\nvar ign = get_variable(\"sigils_ignored\") || {};\nvar key = S.argv[0] || \"\";\nif (key === \"here\") key = S.room ? String(S.room.id) : \"\";\nif (key === \"\") {\n  display_notice(\"[sigils] use SIGILS UNIGNORE HERE or SIGILS UNIGNORE <room id>.\", \"orange\");\n} else if (ign[key] !== undefined) {\n  delete ign[key];\n  set_variable(\"sigils_ignored\", ign);\n  if (client.loom.notify) client.loom.notify(\"sigils\");\n  display_notice(\"[sigils] room \" + key + \" is watched again.\", \"lime\");\n} else {\n  display_notice(\"[sigils] room \" + key + \" was not on the ignore list.\", \"orange\");\n}\n"
  },
  {
   "type": "function",
   "name": "sigils_threshold",
   "enabled": true,
   "code": "var S = client.loom.sigils;\nvar v = parseInt(S.argv[0], 10);\nif (!isNaN(v) && v > 0) { set_variable(\"sigils_threshold\", v); if (client.loom.notify) client.loom.notify(\"sigils\"); }\ndisplay_notice(\"[sigils] threshold: \" + get_variable(\"sigils_threshold\") + \" months.\", (!isNaN(v) && v > 0) ? \"lime\" : \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "sigils_cost",
   "enabled": true,
   "code": "var S = client.loom.sigils;\nvar which = S.argv[0] || \"\";\nvar v = parseInt(S.argv[1], 10);\nif ((which === \"monolith\" || which === \"flame\") && !isNaN(v) && v >= 0) {\n  set_variable(\"sigils_cost_\" + which, v);\n} else if (which !== \"\") {\n  display_notice(\"[sigils] use SIGILS COST MONOLITH <gold> or SIGILS COST FLAME <gold>.\", \"orange\");\n}\ndisplay_notice(\"[sigils] costs: monolith sigil \" + get_variable(\"sigils_cost_monolith\")\n  + \" gold, flame sigil \" + get_variable(\"sigils_cost_flame\") + \" gold.\", (which === \"monolith\" || which === \"flame\") && !isNaN(v) && v >= 0 ? \"lime\" : \"cyan\");\n"
  },
  {
   "type": "alias",
   "name": "sigils",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "/*loom-hot sigils s:1 4eb1687b47*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"sigils\"];\nif (!lhH || lhH.v !== \"4eb1687b47\") { run_function(\"sigils__hot\", [], \"sigils\"); lhH = client.loom.__hot[\"sigils\"]; }\nlhH.f[\"s:1\"](args);"
    }
   ],
   "text": "^sigils(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "sigils_usefulness",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "var S = client.loom.sigils;\nif (S && S.queue && S.queue.length > 0) {\n  run_function(\"sigils_settle\", [], \"sigils\");\n  run_function(\"sigils_take\", [], \"sigils\");\n  var head = S.head;\n  if (head) {\n    S.parseIn = args[1];\n    run_function(\"sigils_parse\", [], \"sigils\");\n    head.months = S.parseOut;\n    // Wait for a possible flame line before deciding.\n    S.await = head;\n  }\n}\n"
    }
   ],
   "text": "^It has (.+?) of usefulness left\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "sigils_flame",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#ff008f",
     "highlight_bg": "#000000",
     "highlight": "line",
     "highlight_backref": ""
    },
    {
     "type": "script",
     "enabled": true,
     "script": "var S = client.loom.sigils;\nif (S && S.await) {\n  S.parseIn = args[1];\n  run_function(\"sigils_parse\", [], \"sigils\");\n  S.await.flame = S.parseOut;\n  run_function(\"sigils_settle\", [], \"sigils\");\n}\n"
    }
   ],
   "text": "^There is a flame-shaped sigil attached\\. \\((.+?) remaining\\)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "sigils_nothing",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "var S = client.loom.sigils;\nif (S && S.queue && S.queue.length > 0) {\n  run_function(\"sigils_settle\", [], \"sigils\");\n  run_function(\"sigils_take\", [], \"sigils\");\n  var head = S.head;\n  if (head) {\n    S.flag = { id: head.id, name: head.name, months: -1, flame: -1 };\n    run_function(\"sigils_flag\", [], \"sigils\");\n  }\n}\n"
    }
   ],
   "text": "^(?:What do you wish to examine\\?|You (?:do not|don't) see that here\\.)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "function",
   "name": "sigils__hot",
   "enabled": true,
   "code": "// sigils__hot -- generated by tools/build.py (#136). The bodies of this package's\n// longer scripts, made once per load; each script in the package is a stub\n// that calls its body here. Edit the source in packages/sigils/, never this.\nif (!client.loom) client.loom = {};\nif (!client.loom.__hot) client.loom.__hot = {};\nvar lhP = client.loom.__hot[\"sigils\"] = { v: \"4eb1687b47\", f: {} };\nlhP.f[\"f:sigils_setup\"] = function (args) {\n//@hot-begin f:sigils_setup\n// sigils_setup -- run from onLoad and onInstall. Namespace, registry,\n// one-time migration from the old eleusis variables, defaults.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.sigils) client.loom.sigils = {};\n// busy (#318): true while a monolith probe sigils sent has had no answer\n// yet, so Here's loyal probe waits its turn instead of gagging the answer.\n// An answer lost for 5 s no longer counts (sigils_take drops it at 15 s).\nclient.loom.registry.sigils = { version: \"0.2.8\", keyword: \"SIGILS\", desc: \"Monolith and flame sigil watcher, with the cost of what's running out\", busy: function () {\n  var Sb = client.loom.sigils, q = (Sb && Sb.queue) || [], now = Date.now();\n  for (var i = 0; i < q.length; i++) if (now - q[i].t < 5000) return true;\n  return false;\n} };\n\nvar S = client.loom.sigils;\nS.queue = [];\nS.await = null;\n\n// Migration: copy the eleusis-era mono_* variables once. The old ones are\n// left in place so an older package still finds its data.\nvar moves = [[\"mono_on\", \"sigils_on\"], [\"mono_threshold\", \"sigils_threshold\"],\n  [\"mono_bad\", \"sigils_flagged\"], [\"mono_ignore\", \"sigils_ignored\"],\n  [\"mono_cost_monolith\", \"sigils_cost_monolith\"], [\"mono_cost_flame\", \"sigils_cost_flame\"]];\nfor (var i = 0; i < moves.length; i++) {\n  var oldv = get_variable(moves[i][0]);\n  var newv = get_variable(moves[i][1]);\n  if ((newv === null || newv === undefined) && oldv !== null && oldv !== undefined) {\n    set_variable(moves[i][1], oldv);\n  }\n}\n\nif (get_variable(\"sigils_threshold\") === null || get_variable(\"sigils_threshold\") === undefined) set_variable(\"sigils_threshold\", 10);\nif (get_variable(\"sigils_cost_monolith\") === null || get_variable(\"sigils_cost_monolith\") === undefined) set_variable(\"sigils_cost_monolith\", 1500);\nif (get_variable(\"sigils_cost_flame\") === null || get_variable(\"sigils_cost_flame\") === undefined) set_variable(\"sigils_cost_flame\", 500);\nif (!get_variable(\"sigils_flagged\")) set_variable(\"sigils_flagged\", {});\nif (!get_variable(\"sigils_ignored\")) set_variable(\"sigils_ignored\", {});\n\n// The read-only look other tabs see through loom (#159, #165): what sigils\n// makes of a room, never its variables.\n//   look.isMonolith(name) -> true for a monolith among a room's items\n//   look.ignored(roomId)  -> true for a room on SIGILS IGNORE's list\n//   look.expiring()       -> the flagged rooms whose monolith is under the\n//     threshold, ignored ones left out (#42): [{ id, name, months, t }],\n//     months as read (-1 none, 0 under a month), t the reading's time (ms)\nS.look = {\n  isMonolith: function (name) { return /\\bmonolith\\b/i.test(String(name || \"\")); },\n  ignored: function (id) { var ign = get_variable(\"sigils_ignored\") || {}; return !!ign[String(id)]; },\n  expiring: function () {\n    var bad = get_variable(\"sigils_flagged\") || {}, ign = get_variable(\"sigils_ignored\") || {};\n    var thr = get_variable(\"sigils_threshold\");\n    if (thr === null || thr === undefined) thr = 10;\n    var out = [];\n    for (var k in bad) {\n      if (!bad.hasOwnProperty(k) || ign[k]) continue;\n      var r = bad[k];\n      var mo = (r.months === null || r.months === undefined) ? -1 : r.months;\n      if (mo < thr) out.push({ id: String(r.id), name: r.name || \"?\", months: mo, t: r.t || 0 });\n    }\n    return out;\n  }\n};\n\n//@hot-end f:sigils_setup\n};\nlhP.f[\"f:sigils_enter\"] = function (args) {\n//@hot-begin f:sigils_enter\n// sigils_enter -- on every room change while watching: queue the room and\n// probe its monolith. Every entry is re-probed; nothing is sent while paused.\nvar S = client.loom.sigils;\nvar here = S.room || {};\nvar rid = here.id;\n\nif (get_variable(\"sigils_on\") && get_variable(\"pauseTriggers\") != \"on\" && rid !== null && rid !== undefined && rid !== \"\") {\n  var key = String(rid);\n\n  // A monolith read in the previous room is still waiting for a flame line\n  // that never came: settle it as \"no flame\".\n  run_function(\"sigils_settle\", [], \"sigils\");\n\n  var ign = get_variable(\"sigils_ignored\") || {};\n  if (!ign[key]) {\n    if (!S.queue) S.queue = [];\n    S.queue.push({ id: key, name: here.name || \"?\", t: Date.now() });\n    if (S.queue.length > 20) S.queue = S.queue.slice(S.queue.length - 20);\n    send_command(\"probe monolith here\");\n  }\n}\n\n//@hot-end f:sigils_enter\n};\nlhP.f[\"f:sigils_flag\"] = function (args) {\n//@hot-begin f:sigils_flag\n// sigils_flag -- records one reading from S.flag = { id, name, months, flame }.\n// months/flame < 0 means none / no reading.\nvar S = client.loom.sigils;\nvar f = S.flag || {};\nvar fid = f.id;\nvar fmo = (f.months === null || f.months === undefined) ? -1 : f.months;\nvar ffl = (f.flame === null || f.flame === undefined || fmo < 0) ? -1 : f.flame;\n\nif (fid !== null && fid !== undefined && fid !== \"\") {\n  var key = String(fid);\n  var nm = f.name ? String(f.name) : \"?\";\n  var thr = get_variable(\"sigils_threshold\");\n  if (thr === null || thr === undefined) thr = 10;\n  var bad = get_variable(\"sigils_flagged\") || {};\n  var ign = get_variable(\"sigils_ignored\") || {};\n  var prev = bad[key];\n\n  var monoBad = fmo < thr;\n  var flameBad = ffl < thr;\n\n  if (ign[key] || (!monoBad && !flameBad)) {\n    // Healthy (or ignored): drop any earlier flag for this room.\n    if (prev) {\n      delete bad[key];\n      set_variable(\"sigils_flagged\", bad);\n      if (client.loom.notify) client.loom.notify(\"sigils\");\n      if (!ign[key]) display_notice(\"[sigils] \" + nm + \" (\" + key + \") -- all good now.\", \"lime\");\n    }\n  } else {\n    bad[key] = { id: key, name: nm, months: fmo, flame: ffl, t: Date.now() };\n    set_variable(\"sigils_flagged\", bad);\n    if (client.loom.notify) client.loom.notify(\"sigils\");\n\n    // Only announce new flags or changed readings, not every re-probe.\n    if (!prev || prev.months !== fmo || prev.flame !== ffl) {\n      var parts = [];\n      if (monoBad) {\n        if (fmo < 0) parts.push(\"no monolith\");\n        else if (fmo === 0) parts.push(\"monolith under a month\");\n        else parts.push(\"monolith \" + fmo + (fmo === 1 ? \" month\" : \" months\"));\n      }\n      if (flameBad && fmo >= 0) {\n        if (ffl < 0) parts.push(\"no flame sigil\");\n        else if (ffl === 0) parts.push(\"flame under a month\");\n        else parts.push(\"flame \" + ffl + (ffl === 1 ? \" month\" : \" months\"));\n      }\n      display_notice(\"[sigils] \" + nm + \" (\" + key + \") -- \" + parts.join(\", \"), \"orange\");\n    }\n  }\n}\n\n//@hot-end f:sigils_flag\n};\nlhP.f[\"f:sigils_help\"] = function (args) {\n//@hot-begin f:sigils_help\n// sigils_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[sigils] monolith and flame sigil watcher. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"SIGILS\", \"status\"],\n  [\"SIGILS WATCH [ON|OFF]\", \"probe the monolith in every room you enter\"],\n  [\"SIGILS REPORT\", \"rooms under the threshold, with estimated cost\"],\n  [\"SIGILS CHECK\", \"probe this room once\"],\n  [\"SIGILS IGNORE [HERE|id]\", \"skip a room (no argument: list ignored rooms)\"],\n  [\"SIGILS UNIGNORE HERE|id\", \"watch a room again\"],\n  [\"SIGILS THRESHOLD [n]\", \"flag sigils with fewer than n months left\"],\n  [\"SIGILS COST [MONOLITH|FLAME n]\", \"prices used in the report\"],\n  [\"SIGILS CLEAR\", \"wipe the flagged list\"],\n  [\"SIGILS RESET\", \"clear the queue, restore missing defaults\"],\n  [\"SIGILS DEBUG\", \"internal state\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n\n//@hot-end f:sigils_help\n};\nlhP.f[\"f:sigils_watch\"] = function (args) {\n//@hot-begin f:sigils_watch\nvar S = client.loom.sigils;\nvar mode = S.argv[0] || \"\";\nvar next = get_variable(\"sigils_on\") ? false : true;\nif (mode === \"on\") next = true;\nif (mode === \"off\") next = false;\nvar thr = get_variable(\"sigils_threshold\");\n\nrun_function(\"sigils_settle\", [], \"sigils\");\nset_variable(\"sigils_on\", next);\nS.queue = [];\nS.await = null;\nif (next) {\n  display_notice(\"[sigils] watch ON. Probing every room, flagging under \" + thr + \" months (monolith and flame).\", \"lime\");\n} else {\n  var n = Object.keys(get_variable(\"sigils_flagged\") || {}).length;\n  display_notice(\"[sigils] watch OFF. \" + n + \" room(s) flagged. SIGILS REPORT to see them.\", \"lime\");\n}\n\n//@hot-end f:sigils_watch\n};\nlhP.f[\"f:sigils_report\"] = function (args) {\n//@hot-begin f:sigils_report\nvar S = client.loom.sigils;\nrun_function(\"sigils_settle\", [], \"sigils\");\n\nvar bad = get_variable(\"sigils_flagged\") || {};\nvar ign = get_variable(\"sigils_ignored\") || {};\nvar thr = get_variable(\"sigils_threshold\");\nif (thr === null || thr === undefined) thr = 10;\nvar cm = get_variable(\"sigils_cost_monolith\");\nif (cm === null || cm === undefined) cm = 1500;\nvar cf = get_variable(\"sigils_cost_flame\");\nif (cf === null || cf === undefined) cf = 500;\n\nvar monoRows = [];\nvar flameRows = [];\nvar keys = Object.keys(bad);\nvar i = 0;\nfor (i = 0; i < keys.length; i++) {\n  var r = bad[keys[i]];\n  if (ign[r.id]) continue;\n  var fl = (r.flame === undefined || r.flame === null || r.months < 0) ? -1 : r.flame;\n  var idcol = (\"      \" + r.id).slice(-6);\n\n  if (r.months < thr) {\n    var ms = \"none\";\n    if (r.months === 0) ms = \"<1\";\n    if (r.months > 0) ms = String(r.months);\n    monoRows.push((\"00000\" + (r.months < 0 ? 0 : r.months + 1)).slice(-5)\n      + \"  \" + (\"      \" + ms).slice(-6) + \"  \" + idcol + \"  \" + r.name);\n  }\n  if (fl < thr) {\n    var fs = \"none\";\n    if (fl === 0) fs = \"<1\";\n    if (fl > 0) fs = String(fl);\n    flameRows.push((\"00000\" + (fl < 0 ? 0 : fl + 1)).slice(-5)\n      + \"  \" + (\"      \" + fs).slice(-6) + \"  \" + idcol + \"  \" + r.name);\n  }\n}\nmonoRows.sort();\nflameRows.sort();\n\nvar colhead = \"  Months    Room  Location\";\n\ndisplay_notice((S.city ? String(S.city).toUpperCase() + \" \" : \"\") + \"SIGIL REPORT\", \"cyan\");\ndisplay_notice(\"Rooms with less than \" + thr + \" months of usefulness left.\", \"white\");\ndisplay_notice(\" \", \"white\");\n\ndisplay_notice(\"EXPIRING MONOLITH SIGILS (\" + monoRows.length + \")\", \"yellow\");\nif (monoRows.length === 0) display_notice(\"  None.\", \"white\");\nelse {\n  display_notice(colhead, \"white\");\n  for (i = 0; i < monoRows.length; i++) display_notice(monoRows[i].slice(5), \"white\");\n}\ndisplay_notice(\" \", \"white\");\n\ndisplay_notice(\"EXPIRING FLAME SIGILS (\" + flameRows.length + \")\", \"yellow\");\nif (flameRows.length === 0) display_notice(\"  None.\", \"white\");\nelse {\n  display_notice(colhead, \"white\");\n  for (i = 0; i < flameRows.length; i++) display_notice(flameRows[i].slice(5), \"white\");\n}\ndisplay_notice(\" \", \"white\");\n\nvar tm = monoRows.length * cm;\nvar tf = flameRows.length * cf;\nvar money = [String(cm), String(cf), String(tm), String(tf), String(tm + tf)];\nfor (i = 0; i < money.length; i++) money[i] = money[i].replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\");\n\ndisplay_notice(\"ESTIMATED COST (NEXT 6 MONTHS)\", \"yellow\");\ndisplay_notice(\"  Monolith sigils \" + (\"   \" + monoRows.length).slice(-3) + \" x \" + (\"     \" + money[0]).slice(-5)\n  + \" = \" + (\"       \" + money[2]).slice(-7) + \" gold\", \"white\");\ndisplay_notice(\"  Flame sigils    \" + (\"   \" + flameRows.length).slice(-3) + \" x \" + (\"     \" + money[1]).slice(-5)\n  + \" = \" + (\"       \" + money[3]).slice(-7) + \" gold\", \"white\");\ndisplay_notice(\"  Total                         \" + (\"       \" + money[4]).slice(-7) + \" gold\", \"white\");\n\ndisplay_notice(\"[sigils] SIGILS CLEAR to wipe the list.\", \"cyan\");\n\n//@hot-end f:sigils_report\n};\nlhP.f[\"f:sigils_ignore\"] = function (args) {\n//@hot-begin f:sigils_ignore\nvar S = client.loom.sigils;\nvar ign = get_variable(\"sigils_ignored\") || {};\nvar arg = S.argv[0] || \"\";\n\nif (arg === \"\") {\n  var keys = Object.keys(ign);\n  if (keys.length === 0) display_notice(\"[sigils] no rooms ignored.\", \"cyan\");\n  else {\n    display_notice(\"[sigils] \" + keys.length + \" room(s) ignored:\", \"cyan\");\n    for (var i = 0; i < keys.length; i++) display_notice(\"  \" + (\"      \" + keys[i]).slice(-6) + \"  \" + ign[keys[i]], \"white\");\n  }\n} else if (arg !== \"here\" && !/^\\d+$/.test(arg)) {\n  display_notice(\"[sigils] use SIGILS IGNORE HERE or SIGILS IGNORE <room id>.\", \"orange\");\n} else {\n  var key = arg;\n  var nm = \"?\";\n  if (arg === \"here\") {\n    if (!S.room) { display_notice(\"[sigils] no room seen yet; move once and try again.\", \"orange\"); key = \"\"; }\n    else { key = String(S.room.id); nm = S.room.name || \"?\"; }\n  }\n  if (key !== \"\") {\n    var bad = get_variable(\"sigils_flagged\") || {};\n    if (bad[key]) {\n      if (nm === \"?\") nm = bad[key].name;\n      delete bad[key];\n      set_variable(\"sigils_flagged\", bad);\n    }\n    ign[key] = nm;\n    set_variable(\"sigils_ignored\", ign);\n    if (client.loom.notify) client.loom.notify(\"sigils\");\n    display_notice(\"[sigils] ignoring room \" + key + (nm !== \"?\" ? \" (\" + nm + \")\" : \"\") + \".\", \"lime\");\n  }\n}\n\n//@hot-end f:sigils_ignore\n};\nlhP.f[\"s:1\"] = function (args) {\n//@hot-begin s:1\n// SIGILS [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.sigils) run_function(\"sigils_setup\", [], \"sigils\");\nvar S = client.loom.sigils;\nvar raw = String(args[1] || \"\").trim();\nvar parts = raw.split(/\\s+/);\nvar sub = String(parts[0] || \"\").toLowerCase();\nS.argv = [];\nfor (var i = 1; i < parts.length; i++) S.argv.push(String(parts[i]).toLowerCase());\n\nif (sub === \"\" || sub === \"status\") run_function(\"sigils_status\", [], \"sigils\");\nelse if (sub === \"help\") run_function(\"sigils_help\", [], \"sigils\");\nelse if (sub === \"watch\") run_function(\"sigils_watch\", [], \"sigils\");\nelse if (sub === \"report\") run_function(\"sigils_report\", [], \"sigils\");\nelse if (sub === \"ignore\") run_function(\"sigils_ignore\", [], \"sigils\");\nelse if (sub === \"unignore\") run_function(\"sigils_unignore\", [], \"sigils\");\nelse if (sub === \"threshold\") run_function(\"sigils_threshold\", [], \"sigils\");\nelse if (sub === \"cost\") run_function(\"sigils_cost\", [], \"sigils\");\nelse if (sub === \"check\") {\n  var was = get_variable(\"sigils_on\");\n  set_variable(\"sigils_on\", true);\n  run_function(\"sigils_enter\", [], \"sigils\");\n  set_variable(\"sigils_on\", was);\n}\nelse if (sub === \"clear\") {\n  set_variable(\"sigils_flagged\", {});\n  if (client.loom.notify) client.loom.notify(\"sigils\");\n  S.queue = [];\n  S.await = null;\n  display_notice(\"[sigils] list cleared.\", \"lime\");\n}\nelse if (sub === \"reset\") {\n  run_function(\"sigils_setup\", [], \"sigils\");\n  display_notice(\"[sigils] reset: queue cleared, missing defaults restored. Flagged and ignored rooms are kept.\", \"lime\");\n}\nelse if (sub === \"debug\") {\n  display_notice(\"[sigils] on=\" + get_variable(\"sigils_on\")\n    + \" thr=\" + get_variable(\"sigils_threshold\")\n    + \" flagged=\" + Object.keys(get_variable(\"sigils_flagged\") || {}).length\n    + \" ignored=\" + Object.keys(get_variable(\"sigils_ignored\") || {}).join(\",\")\n    + \" queue=\" + JSON.stringify(S.queue)\n    + \" await=\" + JSON.stringify(S.await)\n    + \" room=\" + JSON.stringify(S.room)\n    + \" city=\" + (S.city || \"?\"), \"cyan\");\n}\nelse display_notice(\"[sigils] unknown command '\" + sub + \"'. SIGILS HELP for commands.\", \"orange\");\n\n//@hot-end s:1\n};\n"
  }
 ],
 "description": "Monolith and flame sigil watcher, with the cost of what's running out"
}