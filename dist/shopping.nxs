{
 "type": "group",
 "name": "shopping",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"shopping_setup\", [], \"shopping\");\nrun_function(\"shopping_render\", [], \"shopping\");\ndisplay_notice(\"[shopping] installed. Create a UI tab named 'Shopping'; in a city, SHOPPING ADD [n] <item> puts an item on the list. SHOPPING HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// The shopping_* variables are left intact.\nif (client.loom && client.loom.shopping) { client.loom.shopping.q = null; client.loom.shopping.choices = null; }\n// Leave LOOM and the integrations at once, not at the next load (#137).\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"shopping\");\n  else delete client.loom.registry.shopping;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it. A basket.\nvar tiTabs = [[\"Shopping\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\"><path d=\"M4.5 6.5 L7 2 M11.5 6.5 L9 2\" stroke=\"#c8bfae\" stroke-width=\"1.2\" stroke-linecap=\"round\" fill=\"none\"/><path d=\"M1.5 6.5 H14.5 L13 14 H3 Z\" fill=\"#e0b46c\"/><path d=\"M5.5 8.5 V12 M8 8.5 V12 M10.5 8.5 V12\" stroke=\"#7a5f33\" stroke-width=\"1.1\" stroke-linecap=\"round\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\n// A lookup can't survive a reload.\nif (client.loom && client.loom.shopping) { client.loom.shopping.q = null; client.loom.shopping.choices = null; }\nrun_function(\"shopping_setup\", [], \"shopping\");\nrun_function(\"shopping_render\", [], \"shopping\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Shopping notes the room you're in (its area is kept with each item; its\n// shop shows BUY) and steps a\n// lookup at each prompt.\nif (!client.loom || !client.loom.shopping || !client.loom.shopping.list) run_function(\"shopping_setup\", [], \"shopping\");\nvar SH = client.loom.shopping;\nif (args.gmcp_method == \"Room.Info\") {\n  var shG = (args.gmcp_args && typeof args.gmcp_args == \"object\") ? args.gmcp_args : {};\n  var shWas = SH.shopHere();\n  SH.here = { area: String(shG.area || \"\"), id: shG.num ? String(shG.num) : \"\", name: String(shG.name || \"\").replace(/\\s*\\((?:indoors|outdoors)\\)\\s*$/i, \"\") };\n  // BUY shows only in the shop you're in: redraw when that changes.\n  if (SH.shopHere() !== shWas) run_function(\"shopping_render\", [], \"shopping\");\n} else if (SH.q && args.gmcp_method == \"Char.Vitals\") {\n  // After the packet's own lines, so the table is read first.\n  setTimeout(SH.prompt, 0);\n}\n"
  },
  {
   "type": "function",
   "name": "shopping_setup",
   "enabled": true,
   "code": "// shopping_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Shopping: a list of what you mean to buy,\n// each item priced and placed by the game's DIRECTORY (the cheapest shop in\n// the city you're in), grouped by shop in the Shopping tab with a subtotal\n// per shop and a likely total. It only keeps the list: WALK and BUY send the game's WALKTO and BUY once per click.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.shopping) client.loom.shopping = {};\nvar SH = client.loom.shopping;\n// busy (#318): true while our DIRECTORY's answer is still coming, so other\n// packages' probes don't take its lines (or we theirs).\nclient.loom.registry.shopping = { version: \"0.1.5\", keyword: \"SHOPPING\", desc: \"A shopping list priced from the city's directory, grouped by shop in a tab\",\n  redraw: function () { run_function(\"shopping_render\", [], \"shopping\"); },\n  busy: function () { var q = client.loom.shopping.q; return !!(q && q.sent && Date.now() - q.at < client.loom.shopping.giveUpMs); } };\n\n// Saved: shopping_list = [{ desc, word, n, shops, shop, price, cur, area, at }]\n//   desc   the item as DIRECTORY describes it (\"a soot-blackened tinderbox\");\n//          a bulk item (\"10gp ea\") without the shop's stock count in front\n//   word   what you looked it up by (\"tinderbox\")\n//   n      how many you want\n//   shops  every shop the directory listed it in, in its order:\n//          [{ s: shop, p: price of one, c: gp|cr|mc, k: stock (-1 unknown) }]\n//   shop   the one it's listed under, price and cur its price there\n//          (cheapest, then fewest stops: see place)\n//   area   the area you were in when it was looked up; at: when\n// A variable that isn't readable starts afresh (#135).\nSH.readList = function (name) {\n  var v = get_variable(name);\n  if (typeof v == \"string\") { try { v = JSON.parse(v); } catch (e) { v = null; } }\n  return Array.isArray(v) ? v : [];\n};\nSH.list = [];\nvar shRaw = SH.readList(\"shopping_list\");\nfor (var shI = 0; shI < shRaw.length; shI++) {\n  var shE = shRaw[shI];\n  if (!shE || typeof shE != \"object\" || !String(shE.desc || \"\").trim() || !String(shE.shop || \"\").trim()) continue;\n  var shPrice = Math.max(0, Number(shE.price) || 0), shCur = /^(?:gp|cr|mc)$/.test(shE.cur) ? shE.cur : \"gp\";\n  var shOs = [], shSeen = {};\n  if (Array.isArray(shE.shops)) for (var shK = 0; shK < shE.shops.length; shK++) {\n    var shO = shE.shops[shK];\n    if (!shO || typeof shO != \"object\" || !String(shO.s || \"\").trim() || shSeen[String(shO.s).trim()]) continue;\n    shSeen[String(shO.s).trim()] = 1;\n    shOs.push({ s: String(shO.s).trim(), p: Math.max(0, Number(shO.p) || 0), c: /^(?:gp|cr|mc)$/.test(shO.c) ? shO.c : \"gp\", k: Number(shO.k) >= 0 ? Math.floor(Number(shO.k)) : -1 });\n  }\n  // 0.1.0 kept only the shops at the lowest price, as names.\n  if (!shOs.length && Array.isArray(shE.cheap)) for (var shL = 0; shL < shE.cheap.length; shL++) { var shS = String(shE.cheap[shL] || \"\").trim(); if (shS && !shSeen[shS]) { shSeen[shS] = 1; shOs.push({ s: shS, p: shPrice, c: shCur, k: -1 }); } }\n  if (!shSeen[String(shE.shop).trim()]) shOs.unshift({ s: String(shE.shop).trim(), p: shPrice, c: shCur, k: -1 });\n  SH.list.push({ desc: String(shE.desc).trim(), word: String(shE.word || \"\").trim(), n: Math.max(1, Math.min(9999, Math.floor(Number(shE.n)) || 1)),\n    shops: shOs, shop: String(shE.shop).trim(), price: shPrice, cur: shCur, area: String(shE.area || \"\"), at: Number(shE.at) || 0 });\n}\nSH.q = null;          // the DIRECTORY being read: { word, n, sent, at, prompts, head, rules, rows, descAt, shopAt }\nSH.choices = null;    // different items for one word, waiting for PICK: { word, n, area, opts: [{ desc, rows }] }\nSH.giveUpMs = 5000;   // a DIRECTORY that never answers\nif (SH.here === undefined) SH.here = null;  // { area, id, name } from Room.Info\n// shopping_rooms = { shop: room number }: the room each shop was found in,\n// learnt when a room's name is the shop's name or set by SHOPPING HERE.\nSH.rooms = {};\nvar shRm = get_variable(\"shopping_rooms\");\nif (typeof shRm == \"string\") { try { shRm = JSON.parse(shRm); } catch (e) { shRm = null; } }\nif (shRm && typeof shRm == \"object\" && !Array.isArray(shRm)) for (var shRk in shRm) if (shRm.hasOwnProperty(shRk) && /^\\d+$/.test(String(shRm[shRk]))) SH.rooms[shRk] = String(shRm[shRk]);\n\nSH.say = function (msg, col) { display_notice(\"[shopping] \" + msg, col || \"cyan\"); };\nSH.n = function (x) { return String(Math.round(x)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"); };\nSH.money = function (x, cur) { return SH.n(x) + (cur || \"gp\"); };\nSH.key = function (s) { return String(s || \"\").trim().toLowerCase().replace(/\\s+/g, \" \"); };\nSH.byDesc = function (desc) {\n  var k = SH.key(desc);\n  for (var i = 0; i < SH.list.length; i++) if (SH.key(SH.list[i].desc) === k) return SH.list[i];\n  return null;\n};\n\nSH.save = function () {\n  SH.place();\n  if (SH.list.length) set_variable(\"shopping_list\", JSON.stringify(SH.list)); else delete_variable(\"shopping_list\");\n  if (client.loom.notify) client.loom.notify(\"shopping\");\n  run_function(\"shopping_render\", [], \"shopping\");\n};\n\n// Where each item is bought. Cheapest first (Ricardo: save gold), among\n// those the shops with enough stock when one has it; then fewest stops:\n// an item sold at its lowest price by more than one shop goes to a shop\n// the list visits anyway. Items with one choice fix their shops first; then\n// the rest, fewest choices first, each to the choice already holding the\n// most items (the directory's order breaks ties). Run on every change, so\n// an earlier item moves when a later one makes a shop worth the stop.\nSH.cands = function (it) {\n  var low = null, cur = it.shops.length ? it.shops[0].c : \"gp\", out = [], enough = [];\n  for (var i = 0; i < it.shops.length; i++) if (it.shops[i].c === cur && (low === null || it.shops[i].p < low)) low = it.shops[i].p;\n  for (var j = 0; j < it.shops.length; j++) {\n    var o = it.shops[j];\n    if (o.c !== cur || o.p !== low) continue;\n    out.push(o);\n    if (o.k < 0 || o.k >= it.n) enough.push(o);\n  }\n  return enough.length ? enough : out;\n};\nSH.place = function () {\n  var count = {}, todo = [];\n  function add(s) { count[s] = (count[s] || 0) + 1; }\n  function set(it, o) { it.shop = o.s; it.price = o.p; it.cur = o.c; it.stock = o.k; add(o.s); }\n  for (var i = 0; i < SH.list.length; i++) {\n    var it = SH.list[i], c = SH.cands(it);\n    if (!c.length) { add(it.shop); continue; }\n    if (c.length === 1) set(it, c[0]); else todo.push({ it: it, c: c });\n  }\n  todo.sort(function (a, b) { return a.c.length - b.c.length; });\n  for (var j = 0; j < todo.length; j++) {\n    var best = todo[j].c[0];\n    for (var k = 1; k < todo[j].c.length; k++) if ((count[todo[j].c[k].s] || 0) > (count[best.s] || 0)) best = todo[j].c[k];\n    set(todo[j].it, best);\n  }\n};\n// The shops on the list (for marking choices).\nSH.onList = function (shop) {\n  for (var i = 0; i < SH.list.length; i++) if (SH.list[i].shop === shop) return true;\n  return false;\n};\n\n// The list by shop, in the order the tab and SHOPPING show it: shops by\n// name, items by description; each shop with its subtotal per currency.\nSH.byShop = function () {\n  var by = {}, order = [];\n  for (var i = 0; i < SH.list.length; i++) {\n    var it = SH.list[i];\n    if (!by[it.shop]) { by[it.shop] = { shop: it.shop, area: it.area, items: [], sum: {} }; order.push(it.shop); }\n    by[it.shop].items.push(it);\n    by[it.shop].sum[it.cur] = (by[it.shop].sum[it.cur] || 0) + it.n * it.price;\n  }\n  order.sort(function (a, b) { a = a.toLowerCase(); b = b.toLowerCase(); return a < b ? -1 : (a > b ? 1 : 0); });\n  var out = [];\n  for (var j = 0; j < order.length; j++) {\n    var g = by[order[j]];\n    g.items.sort(function (a, b) { var x = SH.key(a.desc), y = SH.key(b.desc); return x < y ? -1 : (x > y ? 1 : 0); });\n    out.push(g);\n  }\n  return out;\n};\n// Items in that order, numbered from 1 (REMOVE <number>).\nSH.ordered = function () {\n  var g = SH.byShop(), out = [];\n  for (var i = 0; i < g.length; i++) for (var j = 0; j < g[i].items.length; j++) out.push(g[i].items[j]);\n  return out;\n};\n// Sums per currency, as \"4,200gp\" or \"4,200gp + 30cr\".\nSH.sumText = function (sum) {\n  var parts = [];\n  for (var c in { gp: 1, cr: 1, mc: 1 }) if (sum[c]) parts.push(SH.money(sum[c], c));\n  return parts.length ? parts.join(\" + \") : \"0gp\";\n};\nSH.total = function () {\n  var t = {};\n  for (var i = 0; i < SH.list.length; i++) t[SH.list[i].cur] = (t[SH.list[i].cur] || 0) + SH.list[i].n * SH.list[i].price;\n  return t;\n};\n// An item by its number in SHOPPING's list, or by words in its description\n// or the word you looked it up by (one match only).\nSH.find = function (q) {\n  q = String(q || \"\").trim();\n  var o = SH.ordered();\n  if (/^\\d+$/.test(q)) return o[Number(q) - 1] || null;\n  var k = SH.key(q), hits = [];\n  for (var i = 0; i < o.length; i++) if (SH.key(o[i].desc) === k) return o[i];\n  for (var j = 0; j < o.length; j++) if (SH.key(o[j].desc).indexOf(k) >= 0 || SH.key(o[j].word) === k) hits.push(o[j]);\n  return hits.length === 1 ? hits[0] : (hits.length ? hits : null);\n};\n\n// ADD: look the word up with DIRECTORY, hidden. One lookup at a time.\nSH.paused = function () { return get_variable(\"pauseTriggers\") == \"on\"; };\nSH.add = function (n, word) {\n  if (SH.paused()) { SH.say(\"Loom is paused (LOOM PAUSE OFF to look things up).\", \"orange\"); return; }\n  if (SH.q) { SH.say(\"still reading the directory for \" + SH.q.word + \": a moment.\", \"orange\"); return; }\n  SH.q = { word: word, n: n, sent: false, at: Date.now(), prompts: 0, head: false, rules: 0, rows: [], descAt: -1, shopAt: -1 };\n  SH.send();\n  run_function(\"shopping_render\", [], \"shopping\");\n};\n// Another package waiting on an answer of its own: wait for the next prompt.\nSH.othersBusy = function () {\n  var r = client.loom.registry || {};\n  for (var k in r) {\n    if (!r.hasOwnProperty(k) || k == \"shopping\" || !r[k] || typeof r[k].busy != \"function\") continue;\n    try { if (r[k].busy()) return k; } catch (e) {}\n  }\n  return \"\";\n};\nSH.send = function () {\n  var q = SH.q;\n  if (!q || q.sent) return;\n  if (SH.othersBusy() && Date.now() - q.at < SH.giveUpMs) return;\n  q.sent = true; q.at = Date.now(); q.prompts = 0;\n  send_command(\"directory \" + q.word, 1);\n};\n// From onGMCP at each prompt (after its packet's lines). A lookup not sent\n// yet goes now; one with no table after two prompts found nothing (the\n// game's own answer is left on screen); a table without its closing rule\n// is taken as read.\nSH.prompt = function () {\n  var q = SH.q;\n  if (!q) return;\n  if (!q.sent) { SH.send(); return; }\n  q.prompts++;\n  if (q.head && q.prompts >= 1) SH.done();\n  else if (!q.head && (q.prompts >= 2 || Date.now() - q.at > SH.giveUpMs)) {\n    SH.q = null;\n    SH.say(\"the directory lists nothing for \" + q.word + \" here (DIRECTORY only covers the city or area you're in).\", \"orange\");\n    run_function(\"shopping_render\", [], \"shopping\");\n  }\n};\n\n// The table's lines, while our lookup is out. Columns are padded, so the\n// header tells where the description and the shop begin; when a row doesn't\n// fit them, its runs two or more spaces apart are read instead. A bulk\n// item's price is for one (\"10gp ea\") and its description starts with the\n// shop's stock (\"74 echinacea roots\"): the count is taken off and kept.\nSH.line = function (line) {\n  var q = SH.q;\n  if (!q || !q.sent) return false;\n  if (/^Price\\s+Item description\\s+Shop\\s*$/.test(line)) {\n    q.head = true; q.descAt = line.indexOf(\"Item description\"); q.shopAt = line.indexOf(\"Shop\", q.descAt + 16);\n    return true;\n  }\n  if (!q.head) return false;\n  if (/^-{20,}$/.test(line)) { q.rules++; if (q.rules >= 2) setTimeout(SH.done, 0); return true; }\n  var m = /^\\s*([\\d,]+)\\s*(gp|cr|mc)(\\s+ea\\b)?/.exec(line);\n  if (!m) return false;\n  var desc = \"\", shop = \"\", stock = -1;\n  if (q.shopAt > m[0].length && line.length > q.shopAt && /\\s/.test(line.charAt(q.shopAt - 1)) && /\\S/.test(line.charAt(q.shopAt))) {\n    desc = line.substring(m[0].length, q.shopAt).trim(); shop = line.substring(q.shopAt).trim();\n  }\n  if (!desc || !shop) {\n    var parts = line.substring(m[0].length).trim().split(/\\s{2,}/);\n    if (parts.length === 2) { desc = parts[0]; shop = parts[1]; }\n  }\n  if (!desc || !shop) return false;\n  var b = m[3] ? /^([\\d,]+)\\s+(.+)$/.exec(desc) : null;\n  if (b) { stock = Number(b[1].replace(/,/g, \"\")); desc = b[2]; }\n  q.rows.push({ price: Number(m[1].replace(/,/g, \"\")), cur: m[2], desc: desc, shop: shop, stock: stock });\n  return true;\n};\n\n// The table is read: one item → onto the list; several → ask which.\nSH.done = function () {\n  var q = SH.q;\n  if (!q) return;\n  SH.q = null;\n  if (!q.rows.length) { SH.say(\"the directory lists nothing for \" + q.word + \" here.\", \"orange\"); run_function(\"shopping_render\", [], \"shopping\"); return; }\n  var opts = [], idx = {};\n  for (var i = 0; i < q.rows.length; i++) {\n    var k = SH.key(q.rows[i].desc);\n    if (idx[k] === undefined) { idx[k] = opts.length; opts.push({ desc: q.rows[i].desc, rows: [] }); }\n    opts[idx[k]].rows.push(q.rows[i]);\n  }\n  var area = SH.here ? SH.here.area : \"\";\n  if (opts.length === 1) { SH.choices = null; SH.put(q.word, q.n, opts[0], area); return; }\n  // Cheapest first; at one price, those sold at a shop already on the list.\n  opts.sort(function (a, b) { return (SH.cheapest(a).price - SH.cheapest(b).price) || ((SH.optOnList(a) ? 0 : 1) - (SH.optOnList(b) ? 0 : 1)); });\n  SH.choices = { word: q.word, n: q.n, area: area, opts: opts };\n  SH.say(\"the directory has \" + opts.length + \" different items for \" + q.word + \": SHOPPING PICK <number> (or click one in the tab).\");\n  for (var j = 0; j < opts.length; j++) {\n    var c = SH.cheapest(opts[j]), on = SH.optOnList(opts[j]);\n    SH.say(\"  \" + (j + 1) + \". \" + opts[j].desc + \": from \" + SH.money(c.price, c.cur) + \" (\" + opts[j].rows.length + (opts[j].rows.length === 1 ? \" shop\" : \" shops\") + (on ? \"; at \" + on + \", already on your list\" : \"\") + \")\");\n  }\n  run_function(\"shopping_render\", [], \"shopping\");\n};\nSH.cheapest = function (opt) {\n  var best = opt.rows[0];\n  for (var i = 1; i < opt.rows.length; i++) if (opt.rows[i].price < best.price) best = opt.rows[i];\n  return best;\n};\n// A shop on the list selling this choice at its lowest price, if any.\nSH.optOnList = function (opt) {\n  var low = SH.cheapest(opt);\n  for (var i = 0; i < opt.rows.length; i++) if (opt.rows[i].price === low.price && SH.onList(opt.rows[i].shop)) return opt.rows[i].shop;\n  return \"\";\n};\nSH.pick = function (i) {\n  var C = SH.choices;\n  if (!C) { SH.say(\"nothing to pick from: SHOPPING ADD [n] <word> first.\", \"orange\"); return; }\n  var o = C.opts[i - 1];\n  if (!o) { SH.say(\"pick 1 to \" + C.opts.length + \".\", \"orange\"); return; }\n  SH.choices = null;\n  SH.put(C.word, C.n, o, C.area);\n};\nSH.cancelPick = function () { SH.choices = null; run_function(\"shopping_render\", [], \"shopping\"); };\n// Onto the list with every shop the directory named (place picks one). On\n// the list already: the quantity adds up, the shops are the fresh ones.\nSH.put = function (word, n, opt, area) {\n  var shops = [], seen = {};\n  for (var i = 0; i < opt.rows.length; i++) {\n    var r = opt.rows[i];\n    if (seen[r.shop]) continue;\n    seen[r.shop] = 1;\n    shops.push({ s: r.shop, p: r.price, c: r.cur, k: r.stock });\n  }\n  var it = SH.byDesc(opt.desc), was = it ? it.n : 0;\n  if (!it) { it = { desc: opt.desc, word: word, n: 0, shops: [], shop: shops[0].s, price: 0, cur: \"gp\", area: \"\", at: 0 }; SH.list.push(it); }\n  it.n = Math.min(9999, it.n + n); it.shops = shops; it.word = word; it.area = area || it.area; it.at = Date.now();\n  SH.save();\n  var ties = SH.cands(it).length - 1;\n  SH.say((was ? \"now \" + it.n + \" × \" : it.n + \" × \") + it.desc + \" at \" + SH.money(it.price, it.cur) + (it.n > 1 ? \" (\" + SH.money(it.n * it.price, it.cur) + \")\" : \"\") +\n    \", from \" + it.shop + (ties > 0 ? \" (also \" + ties + \" other \" + (ties > 1 ? \"shops\" : \"shop\") + \" at that price)\" : \"\") +\n    (it.stock >= 0 && it.stock < it.n ? \"; it has only \" + it.stock + \" in stock\" : \"\") +\n    \". Total \" + SH.sumText(SH.total()) + \".\", it.stock >= 0 && it.stock < it.n ? \"orange\" : \"lime\");\n};\nSH.remove = function (it, n) {\n  if (n && n < it.n) { it.n -= n; SH.save(); SH.say(\"now \" + it.n + \" × \" + it.desc + \". Total \" + SH.sumText(SH.total()) + \".\", \"lime\"); return; }\n  var k = SH.list.indexOf(it);\n  if (k >= 0) SH.list.splice(k, 1);\n  SH.save();\n  SH.say(\"removed \" + it.desc + \". \" + (SH.list.length ? \"Total \" + SH.sumText(SH.total()) + \".\" : \"The list is empty.\"), \"lime\");\n};\nSH.clear = function () {\n  SH.list = []; SH.choices = null;\n  SH.save();\n  SH.say(\"the shopping list is wiped.\", \"orange\");\n};\n\nSH.place();\n\n// WALK on a shop's line: the game's own walking, sent once per click; the\n// game stops it at a closed door or anything else in the way.\nSH.walkCmd = \"walkto\";\nSH.walk = function (shop) {\n  if (SH.paused()) { SH.say(\"Loom is paused (LOOM PAUSE OFF to walk).\", \"orange\"); return; }\n  send_command(SH.walkCmd + \" \" + shop, 1);\n  SH.say(\"walking to \" + shop + \".\");\n};\n\n// The shop on the list you're standing in, or \"\": the room whose number is\n// known for it, or a room named like it (then its number is learnt).\nSH.nameKey = function (s) { return SH.key(s).replace(/^the\\s+/, \"\").replace(/[^a-z0-9 ]/g, \"\"); };\nSH.saveRooms = function () {\n  var any = false;\n  for (var k in SH.rooms) if (SH.rooms.hasOwnProperty(k)) { any = true; break; }\n  if (any) set_variable(\"shopping_rooms\", JSON.stringify(SH.rooms)); else delete_variable(\"shopping_rooms\");\n};\nSH.shopHere = function () {\n  var H = SH.here;\n  if (!H || !H.id) return \"\";\n  var shops = {};\n  for (var i = 0; i < SH.list.length; i++) shops[SH.list[i].shop] = 1;\n  for (var s in shops) if (SH.rooms[s] === H.id) return s;\n  for (var t in shops) {\n    if (SH.rooms[t] === undefined && SH.nameKey(t) && SH.nameKey(t) === SH.nameKey(H.name)) { SH.rooms[t] = H.id; SH.saveRooms(); return t; }\n  }\n  return \"\";\n};\n// SHOPPING HERE <shop>: this room is that shop (when its name differs).\nSH.setHere = function (shop) {\n  if (!SH.here || !SH.here.id) { SH.say(\"no room yet: move or LOOK first.\", \"orange\"); return; }\n  SH.rooms[shop] = SH.here.id;\n  SH.saveRooms();\n  SH.say(shop + \" is room \" + SH.here.id + \" (\" + (SH.here.name || \"?\") + \"): BUY shows here for its items.\", \"lime\");\n  run_function(\"shopping_render\", [], \"shopping\");\n};\n\n// BUY on an item's line: \"buy <n> <word you looked it up by>\", once per\n// click, shown only in that item's shop. What the game hands over comes\n// off the list (received).\nSH.buyCmd = function (it) { return \"buy \" + it.n + \" \" + it.word; };\nSH.buy = function (it) {\n  if (SH.paused()) { SH.say(\"Loom is paused (LOOM PAUSE OFF to buy).\", \"orange\"); return; }\n  if (!it.word) { SH.say(\"no word to buy \" + it.desc + \" by: add it again.\", \"orange\"); return; }\n  if (SH.shopHere() !== it.shop) { SH.say(\"you're not in \" + it.shop + \": WALK there first (or SHOPPING HERE \" + it.shop + \" if this room is it).\", \"orange\"); return; }\n  SH.lastBuy = { it: it, at: Date.now() };\n  send_command(SH.buyCmd(it), 1);\n};\n\n// \"You pay 80 sovereigns and receive a group of 10 cohosh roots.\": what\n// you received comes off the list, the line going once it's all there.\n// Looked for among the items of the shop you're in (any shop when you're\n// in none), the last one you clicked BUY for first: its description, the\n// same without a bulk \"a group of N\", or the word you added it by.\nSH.received = function (what) {\n  var w = String(what || \"\").trim(), got = 1, m;\n  if ((m = /^(?:a|an|one) (?:group|bundle|bunch|pile) of ([\\d,]+) (.+)$/i.exec(w))) { got = Number(m[1].replace(/,/g, \"\")); w = m[2]; }\n  else if ((m = /^([\\d,]+) (.+)$/.exec(w))) { got = Number(m[1].replace(/,/g, \"\")); w = m[2]; }\n  var here = SH.shopHere(), pool = SH.list.filter(function (it) { return !here || it.shop === here; });\n  if (SH.lastBuy && Date.now() - SH.lastBuy.at < 30000 && pool.indexOf(SH.lastBuy.it) >= 0) { pool.splice(pool.indexOf(SH.lastBuy.it), 1); pool.unshift(SH.lastBuy.it); }\n  var k = SH.key(w), kA = SH.key(String(what || \"\")), hit = null;\n  for (var i = 0; i < pool.length && !hit; i++) if (SH.key(pool[i].desc) === k || SH.key(pool[i].desc) === kA) hit = pool[i];\n  for (var j = 0; j < pool.length && !hit; j++) if (pool[j].word && new RegExp(\"\\\\b\" + pool[j].word.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\"), \"i\").test(w)) hit = pool[j];\n  if (!hit) return;\n  SH.lastBuy = null;\n  if (got < hit.n) {\n    hit.n -= got;\n    SH.save();\n    SH.say(\"bought \" + got + \" \" + hit.desc + \"; \" + hit.n + \" still to buy.\", \"lime\");\n    return;\n  }\n  SH.list.splice(SH.list.indexOf(hit), 1);\n  SH.save();\n  SH.say(\"bought \" + hit.desc + \": off the list. \" + (SH.list.length ? SH.list.length + \" left, about \" + SH.sumText(SH.total()) + \".\" : \"The list is done.\"), \"lime\");\n};\n\n// The tab's clicks. Its page shares window with the scripts but can't reach\n// client.loom in every Nexus, so these closures carry them.\ntry {\n  window.loomShopping = {\n    remove: function (i) { var S = client.loom.shopping, it = S.ordered()[i]; if (it) S.remove(it); },\n    pick: function (i) { client.loom.shopping.pick(i + 1); },\n    buy: function (i) { var S = client.loom.shopping, it = S.ordered()[i]; if (it) S.buy(it); },\n    walk: function (i) { var S = client.loom.shopping, g = S.shopsDrawn || []; if (g[i] !== undefined) S.walk(g[i]); },\n    cancel: function () { client.loom.shopping.cancelPick(); }\n  };\n} catch (e) {}\nif (client.loom.notify) client.loom.notify(\"shopping\");\n"
  },
  {
   "type": "function",
   "name": "shopping_render",
   "enabled": true,
   "code": "// shopping_render -- the Shopping tab, in the house style shared with Here\n// and Waypoints: ink panel, serif small-caps headings, monospace rows.\n//   - title: items, shops and the likely total\n//   - a \"which one?\" box while DIRECTORY found different items for a word\n//   - the list by shop: shop name and subtotal, then each item with its\n//     quantity, unit price and line total; × on hover removes the item\nif (!client.loom || !client.loom.shopping || !client.loom.shopping.list) run_function(\"shopping_setup\", [], \"shopping\");\nvar SH = client.loom.shopping;\nvar TH = (client.loom && client.loom.theme) || {};\nvar AMBER = TH.acc || \"#e0b46c\";\nvar DEEP = TH.deep || \"#7a5f33\";\nvar TXT = TH.txt || \"#e8e2d6\";\nvar MUTED = TH.muted || \"#8f877a\";\nvar DIM = TH.dim || \"#6d665b\";\nvar RULE = TH.rule || \"#2b2620\";\nvar BG = TH.bg || \"#13110e\";\nvar GOLD = \"#e8c65a\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nvar SYM = \"'Segoe UI Symbol','DejaVu Sans',sans-serif\";\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\"); }\n\nvar groups = SH.byShop();\nSH.shopsDrawn = groups.map(function (x) { return x.shop; });\nvar inShop = SH.shopHere();\nvar total = SH.total();\nvar nItems = SH.list.length;\n\nvar html = '<div id=\"loom-shopping\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + BG + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;min-height:100%;box-sizing:border-box;display:flex;flex-direction:column;\">';\n\n// Title.\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\nhtml += '<span style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:2px;font-size:15px;color:' + AMBER + ';\">Shopping</span>';\nhtml += '<span style=\"color:' + MUTED + ';\">' + (nItems ? nItems + (nItems === 1 ? ' item' : ' items') + ' &middot; ' + groups.length + (groups.length === 1 ? ' shop' : ' shops') + ' &middot; ' : '') +\n  '<span style=\"color:' + (nItems ? GOLD : MUTED) + ';font-size:12px;\" title=\"at the prices the directory listed; a shopkeeper\\'s own policy can change them\">~' + esc(SH.sumText(total)) + '</span></span></div>';\n\n// Looking something up.\nif (SH.q) {\n  html += '<div style=\"margin-top:6px;font-family:' + SERIF + ';font-style:italic;font-size:12px;color:' + MUTED + ';\">Reading the directory for ' + esc(SH.q.word) + '…</div>';\n}\n\n// Different items for one word: pick one.\nvar C = SH.choices;\nif (C) {\n  html += '<div style=\"margin-top:6px;padding:4px 6px;border:1px dotted ' + AMBER + ';\">';\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;\"><span style=\"font-family:' + SERIF + ';font-size:13px;color:' + TXT + ';\">Which ' + esc(C.word) + '? <span style=\"color:' + MUTED + ';font-size:11px;font-style:italic;\">' + C.n + ' wanted</span></span>';\n  html += '<span onclick=\"window.loomShopping&&window.loomShopping.cancel()\" title=\"never mind\" style=\"cursor:pointer;padding:0 5px;border:1px solid ' + DEEP + ';color:' + DIM + ';letter-spacing:0.08em;\">CANCEL</span></div>';\n  for (var c = 0; c < C.opts.length; c++) {\n    var o = C.opts[c], low = SH.cheapest(o);\n    html += '<div class=\"loom-sh-pick\" onclick=\"window.loomShopping&&window.loomShopping.pick(' + c + ')\" title=\"put ' + esc(o.desc) + ' on the list (SHOPPING PICK ' + (c + 1) + ')\" style=\"cursor:pointer;display:flex;justify-content:space-between;gap:8px;padding:2px 2px;border-bottom:1px dotted ' + RULE + ';\">';\n    var onl = SH.optOnList(o);\n    html += '<span style=\"min-width:0;font-family:' + SERIF + ';font-size:13px;\"><span style=\"color:' + MUTED + ';font-family:' + MONO + ';font-size:10px;margin-right:5px;\">' + (c + 1) + '.</span>' + esc(o.desc) + (onl ? ' <span style=\"font-family:' + SYM + ';color:' + AMBER + ';\" title=\"sold at ' + esc(onl) + ', already on your list\">&#9873;</span>' : '') + '</span>';\n    html += '<span style=\"flex:none;white-space:nowrap;color:' + MUTED + ';\">' + o.rows.length + (o.rows.length === 1 ? ' shop' : ' shops') + ' &middot; from <span style=\"color:' + GOLD + ';\">' + esc(SH.money(low.price, low.cur)) + '</span></span></div>';\n  }\n  html += '</div>';\n}\n\n// The list, by shop.\nvar num = 0;\nfor (var g = 0; g < groups.length; g++) {\n  var G = groups[g];\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin:8px 0 2px;border-top:1px solid ' + RULE + ';padding-top:5px;\">';\n  html += '<span style=\"min-width:0;font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;font-size:13px;color:' + AMBER + ';\"><span style=\"font-family:' + SYM + ';color:' + DEEP + ';margin-right:4px;\">&#9873;</span>' + esc(G.shop) + (G.shop === inShop ? ' <span style=\"font-family:' + MONO + ';font-variant:normal;letter-spacing:0.08em;font-size:9px;color:' + AMBER + ';\">&#9673; HERE</span>' : '') + '</span>';\n  html += '<span style=\"flex:none;white-space:nowrap;color:' + GOLD + ';\">' + esc(SH.sumText(G.sum)) + (G.shop === inShop ? '' :\n    '<span onclick=\"window.loomShopping&&window.loomShopping.walk(' + g + ')\" title=\"walk to ' + esc(G.shop) + ' (' + esc(SH.walkCmd) + ' ' + esc(G.shop) + ')\" style=\"cursor:pointer;margin-left:8px;padding:0 5px;border:1px solid ' + AMBER + ';color:' + AMBER + ';letter-spacing:0.08em;font-size:9px;vertical-align:1px;\">WALK</span>') + '</span></div>';\n  if (G.area) html += '<div style=\"font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + DIM + ';padding-left:17px;margin-top:-2px;\">' + esc(G.area) + '</div>';\n  for (var k = 0; k < G.items.length; k++) {\n    var it = G.items[k];\n    // Hover: every shop the directory listed, cheapest first.\n    var others = it.shops.slice().sort(function (a, b) { return a.p - b.p; }).map(function (o) { return (o.s === it.shop ? '• ' : '  ') + o.s + ': ' + SH.money(o.p, o.c) + (o.k >= 0 ? ' (' + SH.n(o.k) + ' in stock)' : ''); });\n    var short = it.stock >= 0 && it.stock < it.n;\n    var also = (short ? 'only ' + SH.n(it.stock) + ' in stock here\\n' : '') + others.join('\\n');\n    html += '<div class=\"loom-sh-row\" title=\"' + esc(also) + '\" style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;padding:2px 4px 2px 17px;border-bottom:1px dotted ' + RULE + ';\">';\n    html += '<span style=\"min-width:0;font-family:' + SERIF + ';font-size:13px;\"><span style=\"font-family:' + MONO + ';font-size:11px;color:' + TXT + ';margin-right:5px;\">' + it.n + ' &times;</span>' + esc(it.desc) + (short ? ' <span style=\"font-family:' + SYM + ';color:#ff9a4c;\" title=\"only ' + SH.n(it.stock) + ' in stock\">&#9888;</span>' : '') + '</span>';\n    html += '<span style=\"flex:none;white-space:nowrap;color:' + MUTED + ';\">' + (it.n > 1 ? esc(SH.money(it.price, it.cur)) + ' ea &middot; ' : '') + '<span style=\"color:' + TXT + ';\">' + esc(SH.money(it.n * it.price, it.cur)) + '</span>';\n    if (G.shop === inShop) html += '<span onclick=\"window.loomShopping&&window.loomShopping.buy(' + num + ')\" title=\"' + esc(SH.buyCmd(it)) + '\" style=\"cursor:pointer;margin-left:8px;padding:0 4px;border:1px solid ' + DEEP + ';color:' + AMBER + ';letter-spacing:0.08em;font-size:9px;vertical-align:1px;\">BUY</span>';\n    html += '<span class=\"loom-sh-x\" onclick=\"window.loomShopping&&window.loomShopping.remove(' + num + ')\" title=\"remove ' + esc(it.desc) + ' from the list\" style=\"cursor:pointer;margin-left:6px;color:#ff9a4c;\">&times;</span></span></div>';\n    num++;\n  }\n}\nif (!nItems && !C && !SH.q) {\n  html += '<div style=\"margin-top:8px;font-family:' + SERIF + ';font-style:italic;font-size:12px;color:' + MUTED + ';\">Nothing on the list. In a city, SHOPPING ADD [n] &lt;item&gt; looks it up in the directory and puts it under its cheapest shop.</div>';\n}\nhtml += '<div style=\"margin-top:auto;padding-top:6px;font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + MUTED + ';\">Prices are the directory\\'s: a shopkeeper\\'s policy can change them. Hover an item for every shop that sells it; ⚑ in a choice: sold at a shop already on the list; × removes an item.</div>';\nhtml += '</div>';\n\n// The whole tab in the panel's colour (#355); the × shows on a row's hover.\ntry {\n  var shSt = document.getElementById(\"loom-shopping-style\");\n  if (!shSt) { shSt = document.createElement(\"style\"); shSt.id = \"loom-shopping-style\"; document.head.appendChild(shSt); }\n  var shCss = '.flexlayout__tab:has(#loom-shopping) { background: ' + BG + ' !important; } .flexlayout__tab:has(#loom-shopping) > * { min-height: 100%; } ' +\n    '#loom-shopping .loom-sh-x { visibility: hidden; } #loom-shopping .loom-sh-row:hover .loom-sh-x { visibility: visible; } #loom-shopping .loom-sh-row:hover, #loom-shopping .loom-sh-pick:hover { background: rgba(224,180,108,0.06); }';\n  if (shSt.textContent !== shCss) shSt.textContent = shCss;\n} catch (e) {}\ntry { set_custom_tab_html(\"Shopping\", html); } catch (e) {}\n"
  },
  {
   "type": "function",
   "name": "shopping_help",
   "enabled": true,
   "code": "// shopping_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[shopping] a list of what you mean to buy, priced from the city's directory and grouped by shop in the Shopping tab. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"SHOPPING\", \"the list by shop, numbered, with subtotals and the likely total\"],\n  [\"SHOPPING ADD [n] <item>\", \"look it up with DIRECTORY (in a city) and list n of it under its cheapest shop; again adds to the quantity\"],\n  [\"SHOPPING PICK <number>\", \"when the directory found different items for a word, the one you mean (or click it in the tab)\"],\n  [\"SHOPPING REMOVE <number|item> [n]\", \"take an item off the list, or only n of it (also the × on its row in the tab)\"],\n  [\"SHOPPING WALK <shop|number>\", \"walk to a shop on the list (WALKTO <shop>), as WALK on its line in the tab\"],\n  [\"SHOPPING BUY <number|item>\", \"in its shop: buy the wanted amount (BUY <n> <word you added it by>), as BUY on its line\"],\n  [\"SHOPPING HERE [shop|number]\", \"which shop you're in; with a shop: this room is it (when its room name differs)\"],\n  [\"SHOPPING CLEAR CONFIRM\", \"wipe the whole list\"],\n  [\"SHOPPING RESET\", \"reload the saved list, redraw the tab\"],\n  [\"SHOPPING DEBUG\", \"internal state\"],\n  [\"Prices are the directory's: a shopkeeper's policy can change them. WALK and BUY send one command per click; nothing runs on its own.\"],\n  [\"The tab is a custom tab named Shopping.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "Shopping control",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// SHOPPING [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.shopping || !client.loom.shopping.list) run_function(\"shopping_setup\", [], \"shopping\");\nvar SH = client.loom.shopping;\nvar shRaw = String(args[1] || \"\").trim();\nvar shSp = shRaw.search(/\\s/);\nvar shCmd = (shSp < 0 ? shRaw : shRaw.substring(0, shSp)).toLowerCase();\nvar shRest = shSp < 0 ? \"\" : shRaw.substring(shSp).trim();\nif (shCmd === \"\" || shCmd === \"list\") {\n  if (!SH.list.length) SH.say(\"the list is empty. In a city, SHOPPING ADD [n] <item> looks it up in the directory.\");\n  else {\n    var shG = SH.byShop(), shNum = 1;\n    SH.say(SH.list.length + (SH.list.length === 1 ? \" item\" : \" items\") + \" in \" + shG.length + (shG.length === 1 ? \" shop\" : \" shops\") + \", about \" + SH.sumText(SH.total()) + \":\");\n    for (var shI = 0; shI < shG.length; shI++) {\n      SH.say(shG[shI].shop + (shG[shI].area ? \" (\" + shG[shI].area + \")\" : \"\") + \": \" + SH.sumText(shG[shI].sum));\n      for (var shJ = 0; shJ < shG[shI].items.length; shJ++) {\n        var shIt = shG[shI].items[shJ];\n        SH.say(\"  \" + (shNum++) + \". \" + shIt.n + \" × \" + shIt.desc + \" at \" + SH.money(shIt.price, shIt.cur) + (shIt.n > 1 ? \" = \" + SH.money(shIt.n * shIt.price, shIt.cur) : \"\"));\n      }\n    }\n  }\n  if (SH.choices) SH.say(\"waiting for SHOPPING PICK <number> for \" + SH.choices.word + \".\");\n} else if (shCmd === \"help\") {\n  run_function(\"shopping_help\", [], \"shopping\");\n} else if (shCmd === \"add\") {\n  var shM = /^(?:(\\d+)\\s+)?(.+)$/.exec(shRest);\n  if (!shM) SH.say(\"SHOPPING ADD [n] <item>, e.g. SHOPPING ADD 5 tinderbox.\", \"orange\");\n  else {\n    var shN = shM[1] ? Number(shM[1]) : 1;\n    if (shN < 1 || shN > 9999) SH.say(\"how many: 1 to 9999.\", \"orange\");\n    else SH.add(shN, shM[2].trim());\n  }\n} else if (shCmd === \"pick\") {\n  if (/^\\d+$/.test(shRest)) SH.pick(Number(shRest));\n  else if (SH.choices) { SH.say(\"SHOPPING PICK <number>: \" + SH.choices.opts.map(function (o, i) { return (i + 1) + \". \" + o.desc; }).join(\", \") + \".\", \"orange\"); }\n  else SH.say(\"nothing to pick from: SHOPPING ADD [n] <item> first.\", \"orange\");\n} else if (shCmd === \"remove\" || shCmd === \"del\") {\n  var shR = /^(.+?)(?:\\s+(\\d+))?$/.exec(shRest);\n  // \"REMOVE 3\" is item 3; \"REMOVE 3 2\" two of item 3; \"REMOVE tinderbox 2\" two tinderboxes.\n  var shWhat = shR ? shR[1] : \"\", shCount = shR && shR[2] ? Number(shR[2]) : 0;\n  var shF = shWhat ? SH.find(shWhat) : null;\n  if (!shF && shCount) { shF = SH.find(shRest); shCount = 0; }\n  if (!shWhat) SH.say(\"SHOPPING REMOVE <number|item> [how many].\", \"orange\");\n  else if (!shF) SH.say(\"no item '\" + shWhat + \"' on the list. SHOPPING lists them, numbered.\", \"orange\");\n  else if (Array.isArray(shF)) SH.say(\"'\" + shWhat + \"' matches \" + shF.map(function (x) { return x.desc; }).join(\", \") + \": use its number from SHOPPING.\", \"orange\");\n  else SH.remove(shF, shCount);\n} else if (shCmd === \"buy\") {\n  var shB = shRest ? SH.find(shRest) : null;\n  if (!shRest) SH.say(\"SHOPPING BUY <number|item>, or BUY on its line in the tab.\", \"orange\");\n  else if (!shB) SH.say(\"no item '\" + shRest + \"' on the list. SHOPPING lists them, numbered.\", \"orange\");\n  else if (Array.isArray(shB)) SH.say(\"'\" + shRest + \"' matches \" + shB.map(function (x) { return x.desc; }).join(\", \") + \": use its number from SHOPPING.\", \"orange\");\n  else SH.buy(shB);\n} else if (shCmd === \"walk\") {\n  // A shop by its name (any case, or the start of it) or its place in SHOPPING's list.\n  var shShops = SH.byShop().map(function (x) { return x.shop; }), shTo = \"\";\n  if (/^\\d+$/.test(shRest)) shTo = shShops[Number(shRest) - 1] || \"\";\n  else if (shRest) { var shQ = SH.key(shRest); shTo = shShops.filter(function (x) { return SH.key(x) === shQ; })[0] || shShops.filter(function (x) { return SH.key(x).indexOf(shQ) === 0; })[0] || \"\"; }\n  if (!shRest) SH.say(\"SHOPPING WALK <shop|number>, or WALK on a shop's line in the tab.\", \"orange\");\n  else if (!shTo) SH.say(\"no shop '\" + shRest + \"' on the list.\", \"orange\");\n  else SH.walk(shTo);\n} else if (shCmd === \"here\") {\n  var shHs = SH.byShop().map(function (x) { return x.shop; }), shHt = \"\";\n  if (/^\\d+$/.test(shRest)) shHt = shHs[Number(shRest) - 1] || \"\";\n  else if (shRest) { var shHq = SH.key(shRest); shHt = shHs.filter(function (x) { return SH.key(x) === shHq; })[0] || shHs.filter(function (x) { return SH.key(x).indexOf(shHq) === 0; })[0] || \"\"; }\n  if (!shRest) { var shIn = SH.shopHere(); SH.say(shIn ? \"you're in \" + shIn + \".\" : \"this room isn't a shop on the list. SHOPPING HERE <shop|number> if it is.\"); }\n  else if (!shHt) SH.say(\"no shop '\" + shRest + \"' on the list.\", \"orange\");\n  else SH.setHere(shHt);\n} else if (shCmd === \"clear\") {\n  if (shRest.toLowerCase() === \"confirm\") SH.clear();\n  else SH.say(\"SHOPPING CLEAR CONFIRM wipes the whole list (\" + SH.list.length + (SH.list.length === 1 ? \" item\" : \" items\") + \").\", \"orange\");\n} else if (shCmd === \"reset\") {\n  SH.q = null;\n  run_function(\"shopping_setup\", [], \"shopping\");\n  run_function(\"shopping_render\", [], \"shopping\");\n  SH.say(\"reset: the list reloaded, the tab redrawn.\", \"lime\");\n} else if (shCmd === \"debug\") {\n  SH.say(\"here=\" + JSON.stringify(SH.here) + \" items=\" + SH.list.length + \" lookup=\" + (SH.q ? JSON.stringify({ word: SH.q.word, sent: SH.q.sent, prompts: SH.q.prompts, head: SH.q.head, rules: SH.q.rules, rows: SH.q.rows.length, descAt: SH.q.descAt, shopAt: SH.q.shopAt }) : \"none\") +\n    \" choices=\" + (SH.choices ? SH.choices.opts.length : 0) + \" waitingOn=\" + (SH.othersBusy() || \"none\"));\n} else {\n  SH.say(\"unknown command '\" + shCmd + \"'. SHOPPING HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^shopping(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "Bought",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"You pay 80 sovereigns and receive a group of 10 cohosh roots.\": the\n// item comes off the shopping list. args[1] is what was received.\nvar SH = client.loom && client.loom.shopping;\nif (SH && SH.list && SH.list.length) SH.received(args[1]);\n"
    }
   ],
   "text": "^You pay [\\d,]+ (?:gold )?sovereigns? and receive (.+)\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Directory table",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// The DIRECTORY table (header, rules, rows), hidden while our own lookup\n// reads it. args[0] is the line.\nvar SH = client.loom && client.loom.shopping;\nif (SH && SH.q && SH.q.sent && SH.line(String(args[0] || \"\"))) gag_current_line();\n"
    }
   ],
   "text": "^(?:Price\\s+Item description\\s+Shop\\s*|-{20,}|\\s*[\\d,]+\\s*(?:gp|cr|mc)\\b.*)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  }
 ],
 "description": "A shopping list priced from the city's directory, grouped by shop in a tab"
}