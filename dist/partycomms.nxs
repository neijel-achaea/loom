{
 "type": "group",
 "name": "partycomms",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"partycomms_icon\", [], \"partycomms\");\nrun_function(\"partycomms_setup\", [], \"partycomms\");\nrun_function(\"partycomms_render\", [], \"partycomms\");\ndisplay_notice(\"[partycomms] installed. Create a UI tab named 'Party' for the chips. PARTYCOMMS HELP for commands.\", \"lime\");\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"partycomms_gmcp\", [], \"partycomms\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; partycomms_on is left intact.\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"partycomms_icon\", [], \"partycomms\");\nrun_function(\"partycomms_setup\", [], \"partycomms\");\nrun_function(\"partycomms_render\", [], \"partycomms\");\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"partycomms_gmcp\", [], \"partycomms\");\n"
  },
  {
   "type": "function",
   "name": "partycomms_gmcp",
   "enabled": true,
   "code": "// partycomms_gmcp -- the work behind onGMCP, as a function made once per load\n// (client.loom.hooks.partycomms.gmcp). Nexus compiles a script afresh every time it\n// runs, and long ones cost on every GMCP message, so the script itself stays two\n// lines and calls this (#136). Run from onLoad and onInstall, so a reimport\n// replaces it.\nif (!client.loom) client.loom = {};\nif (!client.loom.hooks) client.loom.hooks = {};\nif (!client.loom.hooks.partycomms) client.loom.hooks.partycomms = {};\nclient.loom.hooks.partycomms.gmcp = function (args) {\n  // Everything partycomms broadcasts comes from GMCP: Char.Status for your\n  // name, class and level, Char.Vitals for health, mana, endurance, willpower, rage\n  // (its charstats line) and level progress, IRE.Target.Info for your target.\n  // Each Char.Vitals is also the moment to broadcast.\n  var pcM = \"\";\n  var pcA = null;\n  try { pcM = args.gmcp_method; pcA = args.gmcp_args; } catch (e) { pcM = \"\"; }\n  if (typeof pcA === \"string\") { try { pcA = JSON.parse(pcA); } catch (e) { pcA = null; } }\n  if (pcA && (pcM === \"Char.Vitals\" || pcM === \"Char.Status\" || pcM === \"Char.Name\" || pcM === \"IRE.Target.Info\")) {\n    if (!client.loom || !client.loom.partycomms || !client.loom.partycomms.members) run_function(\"partycomms_setup\", [], \"partycomms\");\n    var PC = client.loom.partycomms;\n    var ME = PC.me;\n    if (pcM === \"Char.Status\" || pcM === \"Char.Name\") {\n      if (pcA.name && String(pcA.name) !== ME.name) { ME.name = String(pcA.name); set_variable(\"partycomms_name\", ME.name); }\n      if (pcA[\"class\"] && String(pcA[\"class\"]) !== ME.cls) { ME.cls = String(pcA[\"class\"]); set_variable(\"partycomms_class\", ME.cls); }\n      // level: \"91 (52.41%)\" or \"91\" (#288)\n      // The game sends it at login only (unless CONFIG puts Level in the vitals'\n      // charstats), so the last one seen is kept in partycomms_level.\n      if (pcA.level !== undefined) { var pcLv = String(pcA.level).match(/^\\s*(\\d+)/); if (pcLv) PC.setLevel(parseInt(pcLv[1], 10)); }\n    } else if (pcM === \"IRE.Target.Info\") {\n      // Later updates for the same target can carry only its health, so a name\n      // already known for that id is kept.\n      var pcTi = String(pcA.id || \"\");\n      var pcTn = String(pcA.short_desc || \"\");\n      if (!pcTn && pcTi && pcTi === PC.tInfo.id) pcTn = PC.tInfo.name;\n      PC.tInfo = { id: pcTi, name: pcTn, hp: String(pcA.hpperc || \"\").replace(\"%\", \"\") };\n    } else {\n      var pcF = [\"hp\", \"maxhp\", \"mp\", \"maxmp\", \"ep\", \"maxep\", \"wp\", \"maxwp\"];\n      for (var pcI = 0; pcI < pcF.length; pcI++) {\n        if (pcA[pcF[pcI]] !== undefined) { var pcN = parseInt(pcA[pcF[pcI]], 10); if (!isNaN(pcN)) ME[pcF[pcI]] = pcN; }\n      }\n      if (pcA.nl !== undefined) { var pcL = parseFloat(pcA.nl); if (!isNaN(pcL)) ME.nl = pcL; }\n      if (pcA.charstats) {\n        for (var pcJ = 0; pcJ < pcA.charstats.length; pcJ++) {\n          var pcR = String(pcA.charstats[pcJ]).match(/^Rage:\\s*(\\d+)/);\n          if (pcR) ME.rage = parseInt(pcR[1], 10);\n          var pcP = String(pcA.charstats[pcJ]).match(/Level:\\s*(\\d+)\\s*\\(([\\d.]+)%\\)/);\n          if (pcP) { PC.setLevel(parseInt(pcP[1], 10)); ME.nl = parseFloat(pcP[2]); }\n        }\n      }\n      run_function(\"partycomms_send\", [], \"partycomms\");\n    }\n  }\n};\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// onGMCP: the work is in partycomms_gmcp (#136: this runs on every GMCP message, so it stays short).\nvar lkH = client.loom && client.loom.hooks && client.loom.hooks.partycomms;\nif (!lkH || !lkH.gmcp) { run_function(\"partycomms_gmcp\", [], \"partycomms\"); lkH = client.loom.hooks.partycomms; }\nlkH.gmcp(args);\n"
  },
  {
   "type": "function",
   "name": "partycomms_icon",
   "enabled": true,
   "code": "// partycomms_icon -- the Party tab's icon: pure CSS keyed on the tab button's\n// title, so Nexus's own redraws (selecting, dragging, layout resets) cannot\n// undo it. Run from onLoad and onInstall, so it shows straight after an\n// import as well as after a reload.\nvar tiTabs = [[\"Party\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 18 15\"><circle cx=\"4\" cy=\"5\" r=\"2.2\" fill=\"#3f6b60\"/><path d=\"M0.5 14 C1 10 2.5 8.8 4 8.8 C5.5 8.8 7 10 7.5 14 Z\" fill=\"#3f6b60\"/><circle cx=\"14\" cy=\"5\" r=\"2.2\" fill=\"#3f6b60\"/><path d=\"M10.5 14 C11 10 12.5 8.8 14 8.8 C15.5 8.8 17 10 17.5 14 Z\" fill=\"#3f6b60\"/><circle cx=\"9\" cy=\"3.6\" r=\"2.6\" fill=\"#7cc4b0\"/><path d=\"M4.8 14 C5.3 9.4 7.2 7.9 9 7.9 C10.8 7.9 12.7 9.4 13.2 14 Z\" fill=\"#7cc4b0\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "partycomms_setup",
   "enabled": true,
   "code": "// partycomms_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, one-time migration of the\n// party_* variables, then the state, each part built if missing.\n// Saved: partycomms_on, and the last name, class and level the game sent.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.partycomms) client.loom.partycomms = {};\nclient.loom.registry.partycomms = { version: \"0.2.7\", keyword: \"PARTYCOMMS\", desc: \"Share vitals, rage and target with your party; party chips tab\",\n  // Redrawn by loom when the tab theme changes (#310).\n  redraw: function () { if (client.loom.partycomms) client.loom.partycomms.lastRender = 0; run_function(\"partycomms_render\", [], \"partycomms\"); } };\nvar PC = client.loom.partycomms;\n\n// One-time migration. party_on becomes partycomms_on; the rest were working\n// state kept in variables (now in memory), so they are deleted.\nvar pcOn;\ntry { pcOn = get_variable(\"party_on\"); } catch (e) { pcOn = undefined; }\nif (pcOn !== undefined && pcOn !== null) {\n  var pcHave;\n  try { pcHave = get_variable(\"partycomms_on\"); } catch (e) { pcHave = undefined; }\n  if (pcHave === undefined || pcHave === null || (\"\" + pcHave) === \"\") set_variable(\"partycomms_on\", (\"\" + pcOn) === \"0\" ? \"0\" : \"1\");\n}\n// party_me (the old PARTYNAME) becomes the remembered name until the game\n// sends its own.\nvar pcMe;\ntry { pcMe = get_variable(\"party_me\"); } catch (e) { pcMe = undefined; }\nif (pcMe && (\"\" + pcMe) !== \"undefined\") {\n  var pcHaveName;\n  try { pcHaveName = get_variable(\"partycomms_name\"); } catch (e) { pcHaveName = undefined; }\n  if (!pcHaveName) set_variable(\"partycomms_name\", \"\" + pcMe);\n}\nvar pcGone = [\"party_on\", \"party_me\", \"party_data\", \"party_last_send\", \"party_last_sent\", \"party_last_render\", \"party_ih\", \"party_ih_at\", \"party_ih_tail\", \"tarname\", \"tarname_for\"];\nfor (var pcI = 0; pcI < pcGone.length; pcI++) {\n  var pcV;\n  try { pcV = get_variable(pcGone[pcI]); } catch (e) { pcV = undefined; }\n  if (pcV !== undefined && pcV !== null) delete_variable(pcGone[pcI]);\n}\n\n// Broadcasting is on unless switched off.\nif (PC.on === undefined) {\n  var pcSaved;\n  try { pcSaved = get_variable(\"partycomms_on\"); } catch (e) { pcSaved = undefined; }\n  PC.on = !((\"\" + pcSaved) === \"0\");\n}\n// Who you are and how you're doing, from GMCP.\n// The game sends your name and class only at login and when they change, so\n// the last ones seen are kept (partycomms_name, partycomms_class): a reload\n// that doesn't log in again still knows who you are.\nif (!PC.me) {\n  var pcName, pcCls;\n  try { pcName = get_variable(\"partycomms_name\"); } catch (e) { pcName = \"\"; }\n  try { pcCls = get_variable(\"partycomms_class\"); } catch (e) { pcCls = \"\"; }\n  PC.me = { name: (pcName && (\"\" + pcName) !== \"undefined\") ? \"\" + pcName : \"\", cls: (pcCls && (\"\" + pcCls) !== \"undefined\") ? \"\" + pcCls : \"\", hp: 0, maxhp: 0, mp: 0, maxmp: 0, ep: 0, maxep: 0, wp: 0, maxwp: 0, rage: 0, nl: 0 };\n}\n// The level, kept like the name and class (#288): the game sends it at login.\n// Helpers are rebuilt every run; only the data is kept.\nif (PC.me.lvl === undefined) {\n  var pcLvl;\n  try { pcLvl = parseInt(get_variable(\"partycomms_level\"), 10); } catch (e) { pcLvl = 0; }\n  PC.me.lvl = pcLvl > 0 ? pcLvl : 0;\n}\nPC.setLevel = function (n) {\n  if (n > 0 && n !== PC.me.lvl) { PC.me.lvl = n; set_variable(\"partycomms_level\", String(n)); }\n};\n// The target: IRE.Target.Info when the game sends it, the tar variable and\n// an IH lookup otherwise.\nif (!PC.tInfo) PC.tInfo = { id: \"\", name: \"\", hp: \"\" };\nif (!PC.tName) PC.tName = { id: \"\", name: \"\" };\nif (!PC.ih) PC.ih = { on: false, at: 0, tail: 0, id: \"\" };\n// Party members heard from, by name: their last report and when it came.\nif (!PC.members) PC.members = {};\nif (!PC.sent) PC.sent = { at: 0, hp: -1, mp: -1, tid: \"\", tname: \"\", thp: \"\" };\nif (PC.lastRender === undefined) PC.lastRender = 0;\n// The read-only look other packages see through loom (#256).\n//   look.targeting(id) -> names of the party members (you left out) whose\n//     latest report, under PC.lookMs old, has the mob numbered id as target.\nPC.lookMs = 30000;\nPC.look = {\n  targeting: function (id) {\n    var out = [], want = String(id || \"\"), now = Date.now() / 1000;\n    if (!want) return out;\n    for (var n in PC.members) {\n      if (!PC.members.hasOwnProperty(n) || n === PC.me.name) continue;\n      var m = PC.members[n];\n      if (m && String(m.tid) === want && now - m.t <= PC.lookMs / 1000) out.push(n);\n    }\n    return out.sort();\n  }\n};\n"
  },
  {
   "type": "function",
   "name": "partycomms_send",
   "enabled": true,
   "code": "// partycomms_send -- run on each Char.Vitals: works out your target, then\n// broadcasts over party tell when something moved, at most once a second\n// and at least every ten. Nothing goes to the game while triggers are paused\n// (an unset pauseTriggers counts as off) or with broadcasting off.\n//\n// The message, one line, fields separated by spaces; \"~\" splits the vitals\n// from the target (\"|\" would split the command in Nexus, \"@\" can expand as\n// a variable). A class with spaces is sent with underscores.\n// The class carries the level after a colon when known (\"Druid:91\", #288),\n// so copies of partycomms that predate it still match the line.\n//   [PARTY] Name Class[:level] hp/maxhp mp/maxmp ep/maxep wp/maxwp rage nl ~ tid thp target name\n// tid is 0 and thp and the name are \"-\" when unknown.\nvar PC = client.loom.partycomms;\nvar ME = PC.me;\nvar pcNow = Date.now() / 1000;\nvar pcPaused = (get_variable(\"pauseTriggers\") === \"on\");\n\n// --- the target ---\nvar pcTar = String(get_variable(\"tar\") || \"\").replace(/^\\s+|\\s+$/g, \"\");\nvar pcDig = pcTar.match(/(\\d+)/);\nvar pcTid = pcDig ? pcDig[1] : \"\";\nvar pcTname = \"\";\nvar pcThp = \"\";\nvar TI = PC.tInfo;\nif (TI.id && (pcTid === \"\" || TI.id === pcTid)) {\n  pcTid = TI.id;\n  pcTname = TI.name;\n  pcThp = TI.hp;\n}\nif (pcTid !== \"\" && pcTname === \"\") {\n  if (PC.tName.id === pcTid) {\n    pcTname = PC.tName.name;\n  } else if (PC.on && !pcPaused && PC.ih.id !== pcTid && pcNow - PC.ih.at >= 2) {\n    // Not named yet: look it up with IH (once per target), whose lines are\n    // hidden as they come.\n    PC.ih.on = true;\n    PC.ih.at = pcNow;\n    PC.ih.id = pcTid;\n    send_command(\"ih\", 1);\n  }\n} else if (pcTid === \"\" && pcTar !== \"\") {\n  pcTname = pcTar;\n}\nPC.target = { id: pcTid, name: pcTname, hp: pcThp };\n\n// --- the broadcast ---\n// PC.why says what's holding it back, for PARTYCOMMS.\nPC.why = !PC.on ? \"sharing is off (PARTYCOMMS ON)\" :\n  (pcPaused ? \"triggers are paused (LOOM PAUSE OFF)\" :\n  (!ME.name ? \"the game hasn't sent your name yet: log out and back in once, or PARTYCOMMS NAME <your name>\" :\n  (!(ME.maxhp > 0) ? \"no vitals from the game yet\" : \"\")));\nif (!PC.why) {\n  var pcHpp = Math.round(ME.hp * 100 / ME.maxhp);\n  var pcMpp = ME.maxmp > 0 ? Math.round(ME.mp * 100 / ME.maxmp) : 0;\n  var S0 = PC.sent;\n  var pcThpN = parseInt(pcThp, 10);\n  var pcMoved = Math.abs(pcHpp - S0.hp) >= 5 || Math.abs(pcMpp - S0.mp) >= 5 ||\n    pcTid !== S0.tid || pcTname !== S0.tname ||\n    (!isNaN(pcThpN) && (S0.thp === \"\" || Math.abs(pcThpN - parseInt(S0.thp, 10)) >= 10)) ||\n    pcNow - S0.at >= 10;\n  if (pcMoved && pcNow - S0.at >= 1) {\n    var pcCls = (ME.cls || \"-\").replace(/\\s+/g, \"_\") + (ME.lvl > 0 ? \":\" + ME.lvl : \"\");\n    var pcMsg = \"pt [PARTY] \" + ME.name + \" \" + pcCls +\n      \" \" + ME.hp + \"/\" + ME.maxhp + \" \" + ME.mp + \"/\" + ME.maxmp +\n      \" \" + ME.ep + \"/\" + ME.maxep + \" \" + ME.wp + \"/\" + ME.maxwp +\n      \" \" + (ME.rage || 0) + \" \" + (ME.nl || 0) +\n      \" ~ \" + (pcTid || \"0\") + \" \" + (pcThp !== \"\" ? pcThp : \"-\") + \" \" + (pcTname || \"-\");\n    send_command(pcMsg, 1);\n    PC.sent = { at: pcNow, hp: pcHpp, mp: pcMpp, tid: pcTid, tname: pcTname, thp: pcThp };\n  }\n}\nrun_function(\"partycomms_render\", [], \"partycomms\");\n"
  },
  {
   "type": "function",
   "name": "partycomms_render",
   "enabled": true,
   "code": "// partycomms_render -- draws the 'Party' tab in the house style shared with\n// Coffers, Level, Ledger and the rest: ink panel, serif small-caps heading,\n// monospace figures. Each party member is a chip: name and class, four slim\n// vitals bars, rage, and their target (green when it is yours too). Redrawn\n// at most once a second; a report older than 12 seconds fades as a lost\n// link, and one older than two minutes is dropped.\nvar PC = client.loom.partycomms;\nvar now = Date.now() / 1000;\nif (now - PC.lastRender >= 1) {\n  PC.lastRender = now;\n  // Tab theme (#310): loom's city palette when one is on, else this tab's own colours.\n  var TH = (client.loom && client.loom.theme) || {};\n  var SEA = TH.acc || \"#7cc4b0\";\n  var DEEP = TH.deep || \"#3f6b60\";\n  var TXT = TH.txt || \"#dfe8e5\";\n  var MUTED = TH.muted || \"#82918d\";\n  var RULE = TH.rule || \"#1f2b2a\";\n  var TRACK = TH.track || \"#1c2423\";\n  var CHIP = TH.panel || \"#111817\";\n  var BG = TH.bg || \"#0d1211\";\n  var WARN = \"#e6c25a\";\n  var OK = \"#8fd0a0\";\n  var LOW = \"#e0605a\";\n  var VITALS = [[\"hp\", \"health\", \"#d06a5e\"], [\"mp\", \"mana\", \"#6a96d6\"], [\"ep\", \"endurance\", \"#d2a64e\"], [\"wp\", \"willpower\", \"#a58ad8\"]];\n  var SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\n  var MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\n\n  function esc(t) { return String(t).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\"); }\n  function pct(c, m) { if (!(m > 0)) return 0; var p = Math.round(c * 100 / m); return p < 0 ? 0 : (p > 100 ? 100 : p); }\n  function thou(n) { var s = String(Math.round(n || 0)); var o = \"\"; while (s.length > 3) { o = \",\" + s.slice(-3) + o; s = s.slice(0, -3); } return s + o; }\n  // One vitals row: a letter, the bar, the percentage; the figures on hover.\n  function bar(label, title, col, c, m) {\n    var p = pct(c, m);\n    return '<div style=\"display:flex;align-items:center;gap:4px;margin:1px 0;\" title=\"' + esc(title + \": \" + thou(c) + \" / \" + thou(m)) + '\">' +\n      '<span style=\"color:' + MUTED + ';width:1.4em;\">' + label + '</span>' +\n      '<div style=\"flex:1 1 auto;background:' + TRACK + ';height:6px;\"><div style=\"background:' + col + ';height:6px;width:' + p + '%;\"></div></div>' +\n      '<span style=\"min-width:2.6em;text-align:right;color:' + (label === \"hp\" && p < 30 ? LOW : TXT) + ';\">' + p + '%</span></div>';\n  }\n\n  // Members heard from, freshest reports only; you first, then by name.\n  var names = [];\n  for (var nm in PC.members) {\n    if (PC.members.hasOwnProperty(nm)) {\n      if (now - PC.members[nm].t > 120) delete PC.members[nm];\n      else names.push(nm);\n    }\n  }\n  var me = PC.me.name;\n  function byMember(a, b) { if (a === me) return -1; if (b === me) return 1; return a < b ? -1 : (a > b ? 1 : 0); }\n  names.sort(byMember);\n\n  // Three figures side by side, the party tab's counterpart of the coin stack.\n  var glyph = '<svg width=\"18\" height=\"15\" viewBox=\"0 0 18 15\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n    '<circle cx=\"4\" cy=\"5\" r=\"2.2\" fill=\"' + DEEP + '\"/><path d=\"M0.5 14 C1 10 2.5 8.8 4 8.8 C5.5 8.8 7 10 7.5 14 Z\" fill=\"' + DEEP + '\"/>' +\n    '<circle cx=\"14\" cy=\"5\" r=\"2.2\" fill=\"' + DEEP + '\"/><path d=\"M10.5 14 C11 10 12.5 8.8 14 8.8 C15.5 8.8 17 10 17.5 14 Z\" fill=\"' + DEEP + '\"/>' +\n    '<circle cx=\"9\" cy=\"3.6\" r=\"2.6\" fill=\"' + SEA + '\"/><path d=\"M4.8 14 C5.3 9.4 7.2 7.9 9 7.9 C10.8 7.9 12.7 9.4 13.2 14 Z\" fill=\"' + SEA + '\"/></svg>';\n\n  var html = '<div id=\"loom-partycomms\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + BG + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;min-height:100%;box-sizing:border-box;\">';\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\n  html += '<div style=\"font-family:' + SERIF + ';color:' + SEA + ';font-size:14px;letter-spacing:0.22em;\">' + glyph + 'PARTY</div>';\n  var right = names.length + ' member' + (names.length === 1 ? '' : 's');\n  right += ' &middot; ' + (PC.on ? (me ? 'sharing as ' + esc(me) : 'sharing') : '<span style=\"color:' + WARN + ';\">not sharing</span>');\n  html += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + MUTED + ';font-size:11px;\">' + right + '</div></div>';\n\n  if (names.length === 0) {\n    html += '<div style=\"margin-top:8px;color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">No reports yet. In a party with partycomms on, members appear here as their reports arrive. PARTYCOMMS TEST shows two sample chips.</div>';\n  } else {\n    var myT = (PC.target && PC.target.id) ? PC.target.id : \"\";\n    html += '<div style=\"display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;\">';\n    for (var i = 0; i < names.length; i++) {\n      var p = PC.members[names[i]];\n      var age = now - p.t;\n      var lost = age > 12;\n      var hpP = pct(p.hp, p.maxhp);\n      var top = (hpP < 30) ? LOW : (names[i] === me ? SEA : DEEP);\n      var c = '<div style=\"flex:1 1 150px;min-width:150px;max-width:280px;background:' + CHIP + ';border:1px solid ' + RULE + ';border-top:2px solid ' + top + ';padding:3px 5px 4px;' + (lost ? 'opacity:0.45;' : '') + '\">';\n      c += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:6px;margin-bottom:2px;\">';\n      c += '<span style=\"font-family:' + SERIF + ';font-size:12px;color:' + (names[i] === me ? SEA : TXT) + ';white-space:nowrap;\">' + esc(names[i]) + '</span>';\n      c += '<span style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.08em;color:' + MUTED + ';font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">' + (lost ? '<span style=\"color:' + LOW + ';\">link lost ' + Math.round(age) + 's</span>' : esc((p.cls || \"\") + (p.lvl > 0 ? \" \" + p.lvl : \"\"))) + '</span></div>';\n      for (var v = 0; v < VITALS.length; v++) {\n        var k = VITALS[v][0];\n        if (p[\"max\" + k] > 0) c += bar(k, VITALS[v][1], VITALS[v][2], p[k], p[\"max\" + k]);\n      }\n      var rg = p.rage || 0;\n      var rcol = rg >= 36 ? OK : (rg >= 14 ? WARN : MUTED);\n      c += '<div style=\"display:flex;justify-content:space-between;gap:6px;margin-top:2px;border-top:1px dotted ' + RULE + ';padding-top:2px;\">';\n      c += '<span style=\"color:' + MUTED + ';\">rage <span style=\"color:' + rcol + ';\">' + rg + '</span></span>';\n      if (p.tid || p.tname) {\n        var same = myT && p.tid && p.tid === myT;\n        var tl = p.tname || (\"#\" + p.tid);\n        c += '<span style=\"color:' + (same ? OK : TXT) + ';white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:70%;\" title=\"' + esc(tl + (p.tid ? \" #\" + p.tid : \"\") + (same ? \", your target too\" : \"\")) + '\">&rarr; ' + esc(tl) + (p.thp !== \"\" && p.thp !== undefined ? ' <span style=\"color:' + MUTED + ';\">' + esc(p.thp) + '%</span>' : '') + '</span>';\n      } else {\n        c += '<span style=\"color:' + MUTED + ';font-style:italic;font-family:' + SERIF + ';\">no target</span>';\n      }\n      c += '</div></div>';\n      html += c;\n    }\n    html += '</div>';\n  }\n  html += '</div>';\n  // The whole tab in the panel's colour (#355), as Self and Comms do: the\n  // panel fills the tab, and the tab itself takes the colour while it resizes.\n  try {\n    var pcSt = document.getElementById(\"loom-partycomms-style\");\n    if (!pcSt) { pcSt = document.createElement(\"style\"); pcSt.id = \"loom-partycomms-style\"; document.head.appendChild(pcSt); }\n    var pcCss = '.flexlayout__tab:has(#loom-partycomms) { background: ' + BG + ' !important; } .flexlayout__tab:has(#loom-partycomms) > * { min-height: 100%; }';\n    if (pcSt.textContent !== pcCss) pcSt.textContent = pcCss;\n  } catch (e) {}\n  try { set_custom_tab_html(\"Party\", html); } catch (e) {}\n}\n"
  },
  {
   "type": "function",
   "name": "partycomms_help",
   "enabled": true,
   "code": "// partycomms_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[partycomms] shares your vitals, rage and target over party tell, and shows the party's in the Party tab. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"PARTYCOMMS\", \"sharing on or off, your target, and who you've heard from\"],\n  [\"PARTYCOMMS ON / OFF\", \"start or stop sharing\"],\n  [\"PARTYCOMMS NAME [<name>]\", \"your name, if the game hasn't sent it since you imported\"],\n  [\"PARTYCOMMS CLEAR\", \"forget the party's reports\"],\n  [\"PARTYCOMMS TEST\", \"two sample members, to check the tab solo\"],\n  [\"PARTYCOMMS DEBUG\", \"internal state\"],\n  [\"Sharing switches itself off when you're not in a party; PARTYCOMMS ON after joining one.\"],\n  [\"Everyone in the party needs this version: older reports are ignored.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "trigger",
   "name": "partycomms report",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// A party member's report (yours included, as the game echoes it): stored\n// by name and hidden. See partycomms_send for the format.\nif (!client.loom || !client.loom.partycomms || !client.loom.partycomms.members) run_function(\"partycomms_setup\", [], \"partycomms\");\nvar PC = client.loom.partycomms;\nvar pcCl = String(args[2]).split(\":\");\nvar pcE = {\n  cls: pcCl[0].replace(/_/g, \" \"),\n  lvl: pcCl.length > 1 ? parseInt(pcCl[1], 10) || 0 : 0,\n  hp: parseInt(args[3], 10), maxhp: parseInt(args[4], 10),\n  mp: parseInt(args[5], 10), maxmp: parseInt(args[6], 10),\n  ep: parseInt(args[7], 10), maxep: parseInt(args[8], 10),\n  wp: parseInt(args[9], 10), maxwp: parseInt(args[10], 10),\n  rage: parseInt(args[11], 10), nl: parseFloat(args[12]),\n  tid: args[13] === \"0\" ? \"\" : args[13],\n  thp: args[14] === \"-\" ? \"\" : args[14],\n  tname: String(args[15]).replace(/[\"'.\\s]+$/, \"\"),\n  t: Date.now() / 1000\n};\nif (pcE.cls === \"-\") pcE.cls = \"\";\nif (pcE.tname === \"-\") pcE.tname = \"\";\nvar pcWas = PC.members[args[1]];\nPC.members[args[1]] = pcE;\n// A new member or a changed target: tell loom, so Here shows who targets what\n// (#256). Health-only updates don't redraw anything.\nif ((!pcWas || pcWas.tid !== pcE.tid) && client.loom.notify) client.loom.notify(\"partycomms\");\ngag_current_line();\nPC.lastRender = 0;\nrun_function(\"partycomms_render\", [], \"partycomms\");\n"
    }
   ],
   "text": "\\[PARTY\\] (\\w+) (\\S+) (\\d+)/(\\d+) (\\d+)/(\\d+) (\\d+)/(\\d+) (\\d+)/(\\d+) (\\d+) ([\\d.]+) ~ (\\d+) (\\S+) (.*)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "partycomms ih item",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// An IH line while partycomms is looking up your target: hidden, and the\n// target's name kept when the number matches.\nvar PC = client.loom && client.loom.partycomms;\nif (PC && PC.ih.on && (Date.now() / 1000) - PC.ih.at < 3) {\n  gag_current_line();\n  if (PC.ih.id && PC.ih.id === args[2]) PC.tName = { id: args[2], name: args[3] };\n}\n"
    }
   ],
   "text": "^(\\w*?)(\\d+)\\s{2,}(.+)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "partycomms ih end",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// The last line of an IH lookup: hidden, and the lookup closed. The gold\n// line that can follow it is hidden too (trigger_ih_gold).\nvar PC = client.loom && client.loom.partycomms;\nif (PC && PC.ih.on) {\n  gag_current_line();\n  PC.ih.on = false;\n  PC.ih.tail = Date.now() / 1000;\n}\n"
    }
   ],
   "text": "^Number of objects: \\d+$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "partycomms ih gold",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// The gold line right after an IH lookup.\nvar PC = client.loom && client.loom.partycomms;\nif (PC && PC.ih.tail && (Date.now() / 1000) - PC.ih.tail < 2) {\n  gag_current_line();\n  PC.ih.tail = 0;\n}\n"
    }
   ],
   "text": "^[\\d,]+ gold sovereigns?\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "partycomms no party",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"You are not the member of any party.\" -- usually the answer to our own\n// broadcast, so broadcasting stops until PARTYCOMMS ON.\nif (!client.loom || !client.loom.partycomms || !client.loom.partycomms.members) run_function(\"partycomms_setup\", [], \"partycomms\");\nvar PC = client.loom.partycomms;\nif (PC.on) {\n  PC.on = false;\n  set_variable(\"partycomms_on\", \"0\");\n  display_notice(\"[partycomms] not in a party, so broadcasting is off. PARTYCOMMS ON once you join one.\", \"orange\");\n}\n"
    }
   ],
   "text": "^You are not the member of any party\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "alias",
   "name": "partycomms",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// PARTYCOMMS [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.partycomms || !client.loom.partycomms.members) run_function(\"partycomms_setup\", [], \"partycomms\");\nvar PC = client.loom.partycomms;\nvar pcW = String(args[1] || \"\").trim().toLowerCase().split(/\\s+/);\nvar pcSub = pcW[0];\nfunction pcSay(t, c) { display_notice(\"[partycomms] \" + t, c || \"cyan\"); }\nfunction pcRedraw() { PC.lastRender = 0; run_function(\"partycomms_render\", [], \"partycomms\"); }\n\nif (pcSub === \"\" || pcSub === \"status\") {\n  var ME = PC.me;\n  pcSay((PC.on ? \"sharing your vitals and target over party tell\" : \"not sharing (PARTYCOMMS ON to start)\") + (ME.name ? \", as \" + ME.name + (ME.cls ? \" (\" + ME.cls + (ME.lvl > 0 ? \" \" + ME.lvl : \"\") + \")\" : \"\") : \", once the game sends your name\") + \".\");\n  if (PC.why) pcSay(\"nothing is going out: \" + PC.why + \".\", \"orange\");\n  var T = PC.target || {};\n  pcSay(\"your target: \" + (T.id || T.name ? (T.name || \"?\") + (T.id ? \" #\" + T.id : \"\") + (T.hp ? \" \" + T.hp + \"%\" : \"\") : \"none\") + \".\");\n  var now = Date.now() / 1000;\n  var heard = [];\n  for (var nm in PC.members) {\n    if (PC.members.hasOwnProperty(nm)) {\n      var p = PC.members[nm];\n      var hpp = p.maxhp > 0 ? Math.round(p.hp * 100 / p.maxhp) : 0;\n      heard.push(nm + \" \" + hpp + \"%\" + (p.tname ? \" -> \" + p.tname : \"\") + (now - p.t > 12 ? \" (link lost \" + Math.round(now - p.t) + \"s)\" : \"\"));\n    }\n  }\n  pcSay(heard.length ? \"heard from: \" + heard.join(\"; \") + \".\" : \"no reports from the party yet.\");\n} else if (pcSub === \"help\") {\n  run_function(\"partycomms_help\", [], \"partycomms\");\n} else if (pcSub === \"on\" || pcSub === \"off\") {\n  PC.on = (pcSub === \"on\");\n  set_variable(\"partycomms_on\", PC.on ? \"1\" : \"0\");\n  PC.sent.at = 0;\n  pcSay(PC.on ? \"sharing on; your first report goes out with the next prompt.\" : \"sharing off.\", \"lime\");\n  pcRedraw();\n} else if (pcSub === \"name\") {\n  var pcNm = pcW[1] || \"\";\n  if (!pcNm) {\n    pcSay(PC.me.name ? \"sharing as \" + PC.me.name + \".\" : \"no name yet. PARTYCOMMS NAME <your name>, or log out and back in once.\");\n  } else {\n    // Capitalised as the game writes names; the game's own replaces it at login.\n    PC.me.name = pcNm.charAt(0).toUpperCase() + pcNm.slice(1);\n    set_variable(\"partycomms_name\", PC.me.name);\n    PC.sent.at = 0;\n    pcSay(\"sharing as \" + PC.me.name + \".\", \"lime\");\n  }\n} else if (pcSub === \"clear\") {\n  PC.members = {};\n  pcSay(\"party reports cleared.\", \"orange\");\n  pcRedraw();\n} else if (pcSub === \"test\") {\n  // Two sample members, so the tab can be checked solo.\n  var tNow = Date.now() / 1000;\n  PC.members[\"Testalpha\"] = { cls: \"Druid\", lvl: 91, hp: 3200, maxhp: 4784, mp: 4646, maxmp: 5096, ep: 18000, maxep: 21685, wp: 18870, maxwp: 23170, rage: 24, nl: 28.12, tid: (PC.target && PC.target.id) || \"12345\", thp: \"62\", tname: \"a plague rat\", t: tNow };\n  PC.members[\"Testbeta\"] = { cls: \"Black Dragon\", lvl: 99, hp: 900, maxhp: 4100, mp: 2000, maxmp: 4800, ep: 9000, maxep: 20000, wp: 11000, maxwp: 21000, rage: 41, nl: 92.4, tid: \"\", thp: \"\", tname: \"\", t: tNow - 30 };\n  pcSay(\"two sample members added; PARTYCOMMS CLEAR removes them.\", \"lime\");\n  pcRedraw();\n} else if (pcSub === \"debug\") {\n  pcSay(\"on=\" + PC.on + \" pause=\" + (get_variable(\"pauseTriggers\") || \"unset\") + \" me=\" + JSON.stringify(PC.me), \"cyan\");\n  pcSay(\"tar=\" + get_variable(\"tar\") + \" target=\" + JSON.stringify(PC.target) + \" tInfo=\" + JSON.stringify(PC.tInfo) + \" tName=\" + JSON.stringify(PC.tName) + \" ih=\" + JSON.stringify(PC.ih), \"cyan\");\n  pcSay(\"sent=\" + JSON.stringify(PC.sent) + \" members=\" + Object.keys(PC.members).join(\",\"), \"cyan\");\n} else {\n  pcSay(\"unknown command '\" + pcSub + \"'. PARTYCOMMS HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^partycomms(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  }
 ],
 "description": "Share vitals, rage and target with your party; party chips tab"
}