{
 "type": "group",
 "name": "crystalism",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"crystalism_setup\", [], \"crystalism\");\ndisplay_notice(\"[crystalism] installed. CRYSTALISM HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is uninstalled"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"crystalism_setup\", [], \"crystalism\");\n"
  },
  {
   "type": "group",
   "name": "core",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "crystalism_setup",
     "enabled": true,
     "code": "// crystalism_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, defaults.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.crystalism) client.loom.crystalism = {};\nclient.loom.registry.crystalism = { version: \"0.3.0\", keyword: \"CRYSTALISM\", desc: \"Even crystal refining, pearl pickup, and sonic portals for the city\" };\nvar CR = client.loom.crystalism;\n\nCR.shapes = [\"cube\", \"cylinder\", \"diamond\", \"disc\", \"egg\", \"pentagon\", \"polyhedron\", \"pyramid\", \"sphere\", \"spiral\", \"torus\"];\nCR.hardCap = 200;         // most crystals refined in one run\nCR.maxPerCommand = 10;    // REFINE takes at most this many at once\nCR.facetsPerCrystal = 1;\nif (!CR.state) CR.state = \"idle\";\nif (!CR.queue) CR.queue = [];\n// Crystals in the rift per shape, as last read by CRYSTALISM REFINE's IR\n// CRYSTAL; saved (crystalism_rift), so a reload doesn't forget them.\nif (!CR.rift || !Object.keys(CR.rift).length) {\n  try { CR.rift = JSON.parse(get_variable(\"crystalism_rift\") || \"{}\") || {}; } catch (e) { CR.rift = {}; }\n}\n// Minimum stock per shape (#44, Ricardo: as harvesting's): crystalism_min =\n// { torus: 80 }, any other shape at crystalism_default_min.\ntry { CR.min = JSON.parse(get_variable(\"crystalism_min\") || \"{}\") || {}; } catch (e) { CR.min = {}; }\nif (!to_number(get_variable(\"crystalism_default_min\"))) set_variable(\"crystalism_default_min\", 50);\nCR.defMin = to_number(get_variable(\"crystalism_default_min\"));\nCR.facetsPerPearl = 9;\n// The read-only look other packages see through loom (#159, #44).\n//   look.levels() -> [{ shape, have, min }] for every shape with a count\n//     read from the rift; empty when none has been read yet.\nCR.look = {\n  levels: function () {\n    var out = [];\n    for (var i = 0; i < CR.shapes.length; i++) {\n      var s = CR.shapes[i];\n      if (CR.rift[s] === undefined || CR.rift[s] === null) continue;\n      out.push({ shape: s, have: CR.rift[s], min: (CR.min[s] != null ? CR.min[s] : CR.defMin) });\n    }\n    return out;\n  }\n};\n\n// The pre-0.2 autorefine kept its state on window.nj.ar.\nif (window.nj && window.nj.ar) window.nj.ar = null;\n\nif (!get_variable(\"crystalism_pearls\")) set_variable(\"crystalism_pearls\", \"on\");\nif (!get_variable(\"crystalism_portal\")) set_variable(\"crystalism_portal\", \"off\");\n"
    },
    {
     "type": "function",
     "name": "crystalism_status",
     "enabled": true,
     "code": "if (!client.loom || !client.loom.crystalism || !client.loom.crystalism.shapes) run_function(\"crystalism_setup\", [], \"crystalism\");\nvar CR = client.loom.crystalism;\ndisplay_notice(\"[crystalism] refine \" + (CR.state === \"idle\" ? \"idle\" : CR.state + (CR.queue.length ? \" (\" + CR.queue.length + \" commands left)\" : \"\"))\n  + \", pearl pickup \" + String(get_variable(\"crystalism_pearls\")).toUpperCase()\n  + \", portal for city members \" + String(get_variable(\"crystalism_portal\")).toUpperCase() + \", minimum \" + CR.defMin + \" a shape. CRYSTALISM HELP for commands.\", \"cyan\");\n"
    },
    {
     "type": "function",
     "name": "crystalism_help",
     "enabled": true,
     "code": "// crystalism_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[crystalism] crystal refining, pearls and sonic portals. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"CRYSTALISM\", \"status\"],\n  [\"CRYSTALISM REFINE [n]\", \"refine stored facets into the shapes you have fewest of (at most n crystals, 200 a run)\"],\n  [\"CRYSTALISM STOP\", \"cancel a refine run\"],\n  [\"CRYSTALISM MIN [<n> | <shape> <n|DEFAULT>]\", \"minimum stock per shape (default for all, or one shape)\"],\n  [\"CRYSTALISM PEARLS ON|OFF\", \"pick up pearls that drop from corpses\"],\n  [\"CRYSTALISM PORTAL ON|OFF\", \"open a sonic portal for city members who tell you \\\"Gate.\\\" (needs social's city list)\"],\n  [\"CRYSTALISM DEBUG\", \"internal state\"],\n  [\"Triggers pause while you attune to the Master Crystal and resume when it calls you.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "// CRYSTALISM [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.crystalism || !client.loom.crystalism.shapes) run_function(\"crystalism_setup\", [], \"crystalism\");\nvar CR = client.loom.crystalism;\nvar crW = String(args[1] || \"\").trim().toLowerCase().split(/\\s+/);\nvar crSub = crW[0];\nvar crVal = crW[1] || \"\";\nvar C = \"cyan\";\nif (crSub === \"\" || crSub === \"status\") {\n  run_function(\"crystalism_status\", [], \"crystalism\");\n} else if (crSub === \"help\") {\n  run_function(\"crystalism_help\", [], \"crystalism\");\n} else if (crSub === \"refine\") {\n  if (crVal !== \"\" && !/^\\d+$/.test(crVal)) {\n    display_notice(\"[crystalism] CRYSTALISM REFINE [n]: n is how many crystals at most.\", \"orange\");\n  } else {\n    CR.askCap = crVal ? parseInt(crVal, 10) : Infinity;\n    run_function(\"crystalism_refine\", [], \"crystalism\");\n  }\n} else if (crSub === \"stop\") {\n  if (CR.state === \"idle\") display_notice(\"[crystalism] no refine run going.\", C);\n  else run_function(\"crystalism_abort\", [], \"crystalism\");\n} else if (crSub === \"pearls\" || crSub === \"portal\") {\n  if (crVal === \"on\" || crVal === \"off\") {\n    set_variable(\"crystalism_\" + crSub, crVal);\n    display_notice(\"[crystalism] \" + (crSub === \"pearls\" ? \"pearl pickup \" : \"portal for city members \") + crVal.toUpperCase() + \".\", \"lime\");\n  } else {\n    display_notice(\"[crystalism] CRYSTALISM \" + crSub.toUpperCase() + \" ON or OFF.\", \"orange\");\n  }\n} else if (crSub === \"min\") {\n  // CRYSTALISM MIN <n> | MIN <shape> <n|default> | MIN (show) (#44)\n  var crArg2 = crW[2] || \"\";\n  if (crVal === \"\") {\n    var crMs = [];\n    for (var crMi = 0; crMi < CR.shapes.length; crMi++) { var crSh = CR.shapes[crMi]; crMs.push(crSh + \" \" + (CR.min[crSh] != null ? CR.min[crSh] : CR.defMin) + (CR.rift[crSh] != null ? \" (have \" + CR.rift[crSh] + \")\" : \"\")); }\n    display_notice(\"[crystalism] default minimum \" + CR.defMin + \"; \" + crMs.join(\", \") + \".\", C);\n  } else if (/^\\d+$/.test(crVal) && crArg2 === \"\") {\n    CR.defMin = parseInt(crVal, 10);\n    set_variable(\"crystalism_default_min\", CR.defMin);\n    if (client.loom.notify) client.loom.notify(\"crystalism\");\n    display_notice(\"[crystalism] default minimum: \" + CR.defMin + \".\", \"lime\");\n  } else if (CR.shapes.indexOf(crVal) >= 0 && (crArg2 === \"default\" || /^\\d+$/.test(crArg2))) {\n    if (crArg2 === \"default\") delete CR.min[crVal]; else CR.min[crVal] = parseInt(crArg2, 10);\n    set_variable(\"crystalism_min\", JSON.stringify(CR.min));\n    if (client.loom.notify) client.loom.notify(\"crystalism\");\n    display_notice(\"[crystalism] minimum for \" + crVal + \": \" + (CR.min[crVal] != null ? CR.min[crVal] : CR.defMin + \" (default)\") + \".\", \"lime\");\n  } else {\n    display_notice(\"[crystalism] CRYSTALISM MIN <n>, or CRYSTALISM MIN <shape> <n|default>. Shapes: \" + CR.shapes.join(\", \") + \".\", \"orange\");\n  }\n} else if (crSub === \"debug\") {\n  display_notice(\"[crystalism] state=\" + CR.state + \" facets=\" + CR.facets + \" rift=\" + JSON.stringify(CR.rift) + \" queue=\" + JSON.stringify(CR.queue), C);\n} else {\n  display_notice(\"[crystalism] unknown command '\" + crSub + \"'. CRYSTALISM HELP for commands.\", \"orange\");\n}\n"
      }
     ],
     "text": "^crystalism(?:\\s+(.*))?$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": false,
     "prefix_suffix": true
    }
   ]
  },
  {
   "type": "group",
   "name": "refine",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "crystalism_refine",
     "enabled": true,
     "code": "// crystalism_refine -- start a run: read the rift (IR CRYSTAL), then the\n// stored facets (TOUCH CRYSTAL), then plan. CR.askCap is set by the command.\nvar CR = client.loom.crystalism;\nif (CR.state !== \"idle\") {\n  display_notice(\"[crystalism] a refine run is already going (\" + CR.state + \"). CRYSTALISM STOP to cancel it.\", \"orange\");\n} else {\n  CR.state = \"ir\";\n  CR.rift = {};\n  CR.facets = 0;\n  CR.queue = [];\n  clearTimeout(CR.watchdog);\n  CR.watchdog = setTimeout(function () { run_function(\"crystalism_watchdog\", [], \"crystalism\"); }, 8000);\n  send_command(\"ir crystal\");\n}\n"
    },
    {
     "type": "function",
     "name": "crystalism_watchdog",
     "enabled": true,
     "code": "var CR = client.loom.crystalism;\nif (CR.state === \"ir\" || CR.state === \"touch\") {\n  CR.abortWhy = \"no answer from the game while waiting for \" + (CR.state === \"ir\" ? \"the rift listing\" : \"the facet count\");\n  run_function(\"crystalism_abort\", [], \"crystalism\");\n}\n"
    },
    {
     "type": "function",
     "name": "crystalism_touch",
     "enabled": true,
     "code": "var CR = client.loom.crystalism;\nif (CR.state === \"ir\") {\n  // The rift's counts are settled: keep them, and tell loom (#44).\n  try { set_variable(\"crystalism_rift\", JSON.stringify(CR.rift)); } catch (e) {}\n  if (client.loom.notify) client.loom.notify(\"crystalism\");\n  CR.state = \"touch\";\n  send_command(\"touch crystal\");\n}\n"
    },
    {
     "type": "function",
     "name": "crystalism_plan",
     "enabled": true,
     "code": "// crystalism_plan -- water-fill: give each crystal to the shape with the\n// fewest so far, then queue REFINE commands, lowest shapes first.\nvar CR = client.loom.crystalism;\nvar crCounts = {}, crAdd = {};\nfor (var crI = 0; crI < CR.shapes.length; crI++) { crCounts[CR.shapes[crI]] = CR.rift[CR.shapes[crI]] || 0; crAdd[CR.shapes[crI]] = 0; }\nvar crBudget = Math.min(Math.floor(CR.facets / CR.facetsPerCrystal), CR.hardCap, CR.askCap);\nif (crBudget < 1) {\n  display_notice(\"[crystalism] nothing to refine (\" + CR.facets + \" facets stored).\", \"cyan\");\n  CR.state = \"idle\";\n} else {\n  for (var crB = 0; crB < crBudget; crB++) {\n    var crBest = null, crVal = Infinity;\n    for (var crJ = 0; crJ < CR.shapes.length; crJ++) {\n      var crS = CR.shapes[crJ];\n      if (crCounts[crS] + crAdd[crS] < crVal) { crVal = crCounts[crS] + crAdd[crS]; crBest = crS; }\n    }\n    crAdd[crBest] += 1;\n  }\n  var crOrder = CR.shapes.slice();\n  crOrder.sort(function (a, b) { return crCounts[a] - crCounts[b]; });\n  CR.queue = [];\n  var crParts = [];\n  for (var crK = 0; crK < crOrder.length; crK++) {\n    var crN = crAdd[crOrder[crK]];\n    if (crN > 0) crParts.push(crOrder[crK] + \" +\" + crN);\n    while (crN > 0) {\n      var crStep = Math.min(crN, CR.maxPerCommand);\n      CR.queue.push(\"refine \" + crStep + \" \" + crOrder[crK]);\n      crN -= crStep;\n    }\n  }\n  display_notice(\"[crystalism] refining \" + crBudget + \" crystals in \" + CR.queue.length + \" commands (\" + crParts.join(\", \") + \").\", \"cyan\");\n  CR.state = \"refining\";\n  run_function(\"crystalism_pump\", [], \"crystalism\");\n}\n"
    },
    {
     "type": "function",
     "name": "crystalism_pump",
     "enabled": true,
     "code": "// crystalism_pump -- one REFINE every 1.5s; waits while triggers are paused.\nvar CR = client.loom.crystalism;\nif (CR.state === \"refining\") {\n  if (get_variable(\"pauseTriggers\") == \"on\") {\n    CR.pumpT = setTimeout(function () { run_function(\"crystalism_pump\", [], \"crystalism\"); }, 1500);\n  } else if (!CR.queue.length) {\n    send_command(\"inr all\");\n    display_notice(\"[crystalism] refine done.\", \"lime\");\n    CR.state = \"idle\";\n  } else {\n    send_command(CR.queue.shift());\n    CR.pumpT = setTimeout(function () { run_function(\"crystalism_pump\", [], \"crystalism\"); }, 1500);\n  }\n}\n"
    },
    {
     "type": "function",
     "name": "crystalism_abort",
     "enabled": true,
     "code": "var CR = client.loom.crystalism;\nclearTimeout(CR.watchdog);\nclearTimeout(CR.settle);\nclearTimeout(CR.pumpT);\ndisplay_notice(\"[crystalism] refine stopped: \" + (CR.abortWhy || \"cancelled\") + \".\", \"orange\");\nCR.abortWhy = null;\nCR.state = \"idle\";\nCR.queue = [];\n"
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "// IR CRYSTAL rows while a run is reading the rift; TOUCH CRYSTAL once the\n// listing has been quiet for 0.4s.\nif (!client.loom || !client.loom.crystalism || !client.loom.crystalism.shapes) run_function(\"crystalism_setup\", [], \"crystalism\");\nvar CR = client.loom.crystalism;\nif (CR.state === \"ir\") {\n  var crRe = /\\[\\s*(\\d+)\\]\\s*crystal\\s+([a-z]+)/g;\n  var crM = crRe.exec(args[1]);\n  while (crM !== null) {\n    if (CR.shapes.indexOf(crM[2]) !== -1) CR.rift[crM[2]] = parseInt(crM[1], 10);\n    crM = crRe.exec(args[1]);\n  }\n  clearTimeout(CR.settle);\n  CR.settle = setTimeout(function () { run_function(\"crystalism_touch\", [], \"crystalism\"); }, 400);\n}\n"
      }
     ],
     "text": "^(.*\\[\\s*\\d+\\]\\s*crystal\\s+\\w+.*)$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.crystalism || !client.loom.crystalism.shapes) run_function(\"crystalism_setup\", [], \"crystalism\");\nvar CR = client.loom.crystalism;\nif (CR.state === \"touch\") {\n  CR.facets = parseInt(args[1], 10);\n  clearTimeout(CR.watchdog);\n  run_function(\"crystalism_plan\", [], \"crystalism\");\n}\n"
      }
     ],
     "text": "^You have stored (\\d+) facets? for refinement\\.$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    }
   ]
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// A pearl drops from a corpse: pick it up.\nif (get_variable(\"crystalism_pearls\") == \"on\" && get_variable(\"pauseTriggers\") != \"on\") send_command(\"queue add eb get pearl\");\n"
    }
   ],
   "text": "^A glistening iridescent pearl tumbles out of the corpse of (.*)\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"<name> tells you, \\\"Gate.\\\"\": open a sonic portal for city members (from\n// social's city list, when social is installed).\nif (!client.loom || !client.loom.crystalism || !client.loom.crystalism.shapes) run_function(\"crystalism_setup\", [], \"crystalism\");\nvar CR = client.loom.crystalism;\nif (get_variable(\"crystalism_portal\") == \"on\") {\n  var crWho = args[1];\n  var crCity = (client.loom.social && client.loom.social.lists && client.loom.social.lists.city) || (client.hl && client.hl.city) || null;\n  if (!crCity) {\n    display_notice(\"[crystalism] \" + crWho + \" asked for a portal, but no city list is available (social isn't installed).\", \"orange\");\n  } else if (get_variable(\"pauseTriggers\") == \"on\") {\n    display_notice(\"[crystalism] \" + crWho + \" asked for a portal; not sent while triggers are paused.\", \"orange\");\n  } else if (!crCity[crWho.toLowerCase()]) {\n    send_command(\"tell \" + crWho + \" Sorry, you're not in my allowed list.\");\n  } else {\n    send_command(\"embed sonicportal \" + crWho);\n    display_notice(\"[crystalism] portal opened for \" + crWho + \".\", \"lime\");\n  }\n}\n"
    }
   ],
   "text": "^(\\w+) tells you(.*)\\, \\\"Gate\\.\\\"$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Attuning to the Master Crystal is interrupted by anything sent: pause.\nset_variable(\"pauseTriggers\", \"on\");\n"
    }
   ],
   "text": "^You relax your muscles and attune yourself to your Master Crystal\\, feeling its vibrations draw your soul\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"off\");\n"
    }
   ],
   "text": "^The call of the Master Crystal is irresistible and you are drawn to it\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  }
 ],
 "description": "Even crystal refining, pearl pickup, and sonic portals for the city"
}