{
 "type": "group",
 "name": "social",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"social_setup\", [], \"social\");\nrun_function(\"social_online\", [], \"social\");\ndisplay_notice(\"[social] installed. SOCIAL HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is uninstalled"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon (Online, #76): pure CSS keyed on the tab button's title, so\n// Nexus's own redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"Online\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 17 17\"><circle cx=\"7\" cy=\"5.5\" r=\"3\" fill=\"none\" stroke=\"#e2e8e6\" stroke-width=\"1.3\"/><path d=\"M1.5 15.5 C1.8 11.5 4 10 7 10 C10 10 12.2 11.5 12.5 15.5\" fill=\"none\" stroke=\"#e2e8e6\" stroke-width=\"1.3\"/><circle cx=\"13.5\" cy=\"4\" r=\"2.3\" fill=\"#7fd6c8\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\n\nrun_function(\"social_setup\", [], \"social\");\nrun_function(\"social_online\", [], \"social\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Own name (Char.Name) for highlighting, city (Char.Status) for the enemies list.\nif (!client.loom || !client.loom.social || !client.loom.social.lists) run_function(\"social_setup\", [], \"social\");\nvar S = client.loom.social;\nif (args.gmcp_method == \"Char.Name\" && args.gmcp_args.name) {\n  S.me = String(args.gmcp_args.name).toLowerCase();\n  // You just logged in: the Online tab counts those already on from now.\n  S.loginAt = Date.now();\n}\nif (args.gmcp_method == \"Char.Status\") {\n  if (args.gmcp_args.name) S.me = String(args.gmcp_args.name).toLowerCase();\n  if (args.gmcp_args.city !== undefined) S.city = String(args.gmcp_args.city).replace(/\\s*\\(.*\\)\\s*$/, \"\").toLowerCase();\n}\n"
  },
  {
   "type": "function",
   "name": "social_setup",
   "enabled": true,
   "code": "// social_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Namespace, registry, migration, lists, watchlist.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.social) client.loom.social = {};\n// redraw: how loom redraws the Online tab when an integration's source changes (#159).\nclient.loom.registry.social = { version: \"0.3.5\", keyword: \"SOCIAL\", desc: \"Name highlights by group; who you watch, online in the Online tab\", redraw: function () { run_function(\"social_online\", [], \"social\"); } };\nvar S = client.loom.social;\n\n// Groups in priority order: a name in two groups takes the colour of the first.\nS.groups = [\"family\", \"enemies\", \"order\", \"house\", \"city\", \"allies\", \"friends\"];\nS.defColor = { family: \"#30c4ff\", enemies: \"#ff5f5f\", order: \"#e0b8ff\", house: \"#b8ff29\", city: \"#27f5c5\", allies: \"#ff9f4f\", friends: \"#ffd77f\", self: \"#fdff4d\" };\n\n// One-time migration from the hl*/wl* variables, then cleared.\nvar soOldVar = { family: \"hlFamily\", enemies: \"hlEnemies\", order: \"hlOrder\", house: \"hlHouse\", city: \"hlCity\", allies: \"hlAllies\", friends: \"hlFriends\" };\nvar soLists = get_variable(\"social_lists\");\nvar soColors = get_variable(\"social_colors\");\nvar soMig = false;\nif (!soLists) {\n  soLists = {};\n  for (var soI = 0; soI < S.groups.length; soI++) {\n    var soG = S.groups[soI];\n    var soRaw = get_variable(soOldVar[soG]);\n    soLists[soG] = soRaw ? String(soRaw) : \"\";\n    if (soRaw !== null && soRaw !== undefined) { delete_variable(soOldVar[soG]); soMig = true; }\n  }\n  set_variable(\"social_lists\", soLists);\n}\nif (!soColors) {\n  soColors = {};\n  for (var soJ = 0; soJ < S.groups.length; soJ++) {\n    var soC = get_variable(\"hlColor_\" + S.groups[soJ]);\n    if (soC && soC != S.defColor[S.groups[soJ]]) soColors[S.groups[soJ]] = soC;\n    if (soC !== null && soC !== undefined) delete_variable(\"hlColor_\" + S.groups[soJ]);\n  }\n  set_variable(\"social_colors\", soColors);\n}\nvar soWlOld = [[\"wlEnabled\", \"social_poll\"], [\"wlDebug\", \"social_debug\"], [\"wlWatch\", \"social_watch\"]];\nfor (var soK = 0; soK < soWlOld.length; soK++) {\n  var soOv = get_variable(soWlOld[soK][0]);\n  if (soOv === null || soOv === undefined) continue;\n  var soNv = get_variable(soWlOld[soK][1]);\n  if (soNv === null || soNv === undefined) {\n    if (soWlOld[soK][0] == \"wlWatch\") set_variable(\"social_watch\", String(soOv));\n    else set_variable(soWlOld[soK][1], String(soOv) === \"1\" ? \"on\" : \"off\");\n  }\n  delete_variable(soWlOld[soK][0]);\n}\nif (!get_variable(\"social_poll\")) set_variable(\"social_poll\", \"on\");\nif (!get_variable(\"social_debug\")) set_variable(\"social_debug\", \"off\");\nif (get_variable(\"social_watch\") === null || get_variable(\"social_watch\") === undefined) set_variable(\"social_watch\", S.groups.join(\",\"));\nif (soMig) display_notice(\"[social] lists carried over from the hl* variables.\", \"cyan\");\n\n// Lists: S.lists[group] = { lowercasename: true }. Kept as the same objects\n// across re-setups so readers holding a reference stay current.\nif (!S.lists) S.lists = {};\nfor (var soL = 0; soL < S.groups.length; soL++) {\n  var soGr = S.groups[soL];\n  S.lists[soGr] = S.lists[soGr] || {};\n  for (var soKey in S.lists[soGr]) delete S.lists[soGr][soKey];\n  var soNames = String(soLists[soGr] || \"\").split(\",\");\n  for (var soN = 0; soN < soNames.length; soN++) {\n    var soNm = soNames[soN].trim().toLowerCase();\n    if (soNm.length) S.lists[soGr][soNm] = true;\n  }\n}\nS.color = {};\nfor (var soCk in S.defColor) S.color[soCk] = soColors[soCk] || S.defColor[soCk];\n\n// Watchlist (online/offline notices for listed names, from polling QW).\nS.watch = {};\nvar soW = String(get_variable(\"social_watch\") || \"\").split(\",\");\nfor (var soWi = 0; soWi < soW.length; soWi++) { if (soW[soWi].trim()) S.watch[soW[soWi].trim()] = true; }\nS.debug = get_variable(\"social_debug\") == \"on\";\nS.interval = 5000;\nif (S.prev === undefined) S.prev = null;\nS.capturing = false;\n// The Online tab (#76): when each online person was first seen, recent\n// arrivals and departures (glow / greyed for S.flashMs), the last poll and\n// QW's hidden and total counts.\nif (!S.since) S.since = {};\n// Your own login: whoever was already online when you came on (no login of\n// theirs seen) counts from here. Set again by Char.Name, which the game sends\n// at login; until then, from when this package was set up.\nif (!S.loginAt) S.loginAt = Date.now();\nif (!S.flash) S.flash = {};\nS.flashMs = 10000;\n// When each listed person was last seen online (social_seen, name -> ms),\n// for the tab's Offline section. Only names in a list are kept, so it stays\n// small. Written when someone logs off, and at most once a minute otherwise.\nif (!S.seen) {\n  try { S.seen = JSON.parse(get_variable(\"social_seen\") || \"{}\") || {}; } catch (e) { S.seen = {}; }\n}\nif (S.seenSaved === undefined) S.seenSaved = 0;\n// Offline section shown or folded (social_offline on/off, default on).\nS.showOffline = get_variable(\"social_offline\") != \"off\";\nif (S.lastPoll === undefined) S.lastPoll = 0;\nS.buf = [];\nif (!S.lastCount) S.lastCount = 0;\n// A line of QW names: wrapped lines end in \",\" or \"and\", or start with \"and\" (#75).\nS.reNames = /^(?:and\\s+)?[A-Z][a-z]+(?:(?:,\\s*(?:and\\s+)?|\\s+and\\s+)[A-Z][a-z]+)*(?:,|,?\\s+and|\\.)?$/;\nS.reFooter = /^Plus another \\d+/;\nS.reWord = /[A-Z][a-z]+/g;\nif (S.timer) clearInterval(S.timer);\n// The pre-0.2 package kept its own 5s QW timer on client.wl. After importing\n// over it, that timer would keep polling with no trigger left to gag the\n// output, so stop it.\nif (client.wl) {\n  if (client.wl.timer) clearInterval(client.wl.timer);\n  if (client.wl.safetyT) clearTimeout(client.wl.safetyT);\n  if (client.wl.flushT) clearTimeout(client.wl.flushT);\n  client.wl.enabled = false;\n  client.wl = null;\n}\nS.timer = setInterval(function () { run_function(\"social_poll\", [], \"social\"); }, S.interval);\n\n// The read-only look other tabs see through loom's display entry point\n// (#159): what social knows about a person, never its variables. Groups in\n// priority order, so a name in two groups takes the first one's colour, as\n// in the game's highlights. Every group counts here, watched or not.\nS.look = {\n  group: function (name) {\n    var n = String(name || \"\").trim().toLowerCase();\n    if (!n) return undefined;\n    for (var i = 0; i < S.groups.length; i++) { if (S.lists[S.groups[i]] && S.lists[S.groups[i]][n]) return S.groups[i]; }\n    return undefined;\n  },\n  colour: function (name) { var g = S.look.group(name); return g ? S.color[g] : undefined; }\n};\n// A reimport may change lists or colours: tell loom (guarded: social works\n// without it).\nif (client.loom.notify) client.loom.notify(\"social\");\n\n// LEGACY: packages that haven't had their v0.2 pass read client.hl\n// (client.hl.groups, client.hl.color, client.hl[group]). Same objects, so\n// changes show up there too. Removed once no package reads it.\nclient.hl = { groups: S.groups, color: S.color };\nfor (var soH = 0; soH < S.groups.length; soH++) client.hl[S.groups[soH]] = S.lists[S.groups[soH]];\n"
  },
  {
   "type": "function",
   "name": "social_save",
   "enabled": true,
   "code": "// social_save -- writes the lists and the non-default colours.\nvar S = client.loom.social;\nvar soOut = {};\nfor (var soI = 0; soI < S.groups.length; soI++) soOut[S.groups[soI]] = Object.keys(S.lists[S.groups[soI]]).sort().join(\",\");\nset_variable(\"social_lists\", soOut);\nvar soCol = {};\nfor (var soC in S.color) { if (S.color[soC] != S.defColor[soC]) soCol[soC] = S.color[soC]; }\nset_variable(\"social_colors\", soCol);\nvar soW = [];\nfor (var soJ = 0; soJ < S.groups.length; soJ++) { if (S.watch[S.groups[soJ]]) soW.push(S.groups[soJ]); }\nset_variable(\"social_watch\", soW.join(\",\"));\n"
  },
  {
   "type": "function",
   "name": "social_poll",
   "enabled": true,
   "code": "// social_poll -- every 5s: send QW and capture its lines (trigger_line).\n// The capture ends on QW's own last line, \"Plus another N whose presence you\n// cannot fully sense (M total).\" (#75), so a lagged reply is still gagged.\n// While a capture is open no new QW is sent; a reply that never comes (a\n// disconnect) is given up after 30s.\nvar S = client.loom.social;\nif (S && (get_variable(\"social_poll\") == \"on\" || S.reportOnce) && get_variable(\"pauseTriggers\") != \"on\") {\n  if (S.capturing) {\n    if (S.debug) display_notice(\"[social] tick skipped: still waiting for the last QW\", \"cyan\");\n  } else {\n    if (S.debug) display_notice(\"[social] tick -> qw\", \"cyan\");\n    S.buf = [];\n    S.capturing = true;\n    clearTimeout(S.safetyT);\n    S.safetyT = setTimeout(function () { run_function(\"social_flush\", [], \"social\"); }, 30000);\n    send_command(\"qw\");\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "social_flush",
   "enabled": true,
   "code": "// social_flush -- end of a QW capture (its \"Plus another\" line, or the 30s\n// safety when no reply came): compare with the previous set and announce\n// watched names that came online or went offline.\nvar S = client.loom.social;\nS.capturing = false;\nclearTimeout(S.safetyT);\nclearTimeout(S.flushT);\n// QW's last line: \"Plus another N whose presence you cannot fully sense (M total).\"\nvar soFoot = S.buf.join(\" \").match(/Plus another (\\d+)[\\s\\S]*?\\((\\d+) total\\)/);\nif (soFoot) { S.qwHidden = parseInt(soFoot[1], 10); S.qwTotal = parseInt(soFoot[2], 10); }\nvar soText = S.buf.join(\" \").replace(/Plus another[\\s\\S]*$/, \"\").replace(/\\[([^\\]]+)\\]\\([^)]*\\)/g, \"$1\");\nS.buf = [];\nvar soParts = soText.split(/,|\\band\\b/);\nvar soNames = [];\nfor (var soI = 0; soI < soParts.length; soI++) {\n  var soS = soParts[soI].replace(/[^A-Za-z]/g, \"\");\n  if (/^[A-Z][a-z]+$/.test(soS)) soNames.push(soS.toLowerCase());\n}\nS.lastCount = soNames.length;\nif (!soNames.length) {\n  if (S.reportOnce) { display_notice(\"[social] poll returned no names (kept the previous set).\", \"cyan\"); S.reportOnce = false; }\n} else {\n  var soNow = {};\n  for (var soJ = 0; soJ < soNames.length; soJ++) soNow[soNames[soJ]] = true;\n  var soUp = 0, soDown = 0, soPrimed = false;\n  if (S.prev === null) {\n    soPrimed = true;\n    // Online before the first poll: counted from your login.\n    for (var soP in soNow) S.since[soP] = S.loginAt || Date.now();\n  } else {\n    // name -> colour of its highest-priority watched group\n    var soIdx = {};\n    for (var soG = 0; soG < S.groups.length; soG++) {\n      var soGr = S.groups[soG];\n      if (!S.watch[soGr]) continue;\n      for (var soN in S.lists[soGr]) { if (!soIdx[soN]) soIdx[soN] = S.color[soGr]; }\n    }\n    for (var soA in soNow) {\n      if (!S.prev[soA]) { soUp++; S.since[soA] = Date.now(); S.flash[soA] = { kind: \"in\", at: Date.now() }; if (soIdx[soA]) display_notice(\"[social] \" + soA.charAt(0).toUpperCase() + soA.slice(1) + \" has awoken.\", soIdx[soA]); }\n    }\n    for (var soB in S.prev) {\n      if (!soNow[soB]) { soDown++; delete S.since[soB]; S.flash[soB] = { kind: \"out\", at: Date.now() }; if (soIdx[soB]) display_notice(\"[social] \" + soB.charAt(0).toUpperCase() + soB.slice(1) + \" has drifted into slumber.\", soIdx[soB]); }\n    }\n  }\n  // Anyone online whose login we never saw counts from yours.\n  for (var soQ in soNow) { if (!S.since[soQ]) S.since[soQ] = S.loginAt || Date.now(); }\n  S.prev = soNow;\n  if (S.reportOnce || S.debug) {\n    display_notice(soPrimed ? \"[social] primed with \" + soNames.length + \" names.\" : \"[social] poll: \" + soUp + \" new, \" + soDown + \" gone (\" + soNames.length + \" online).\", \"cyan\");\n    S.reportOnce = false;\n  }\n}\n// Last seen, for the Offline section: everyone listed who is online now. Those\n// who just left keep the time of the last poll that saw them.\nvar soListed = function (n) { for (var g = 0; g < S.groups.length; g++) { if (S.lists[S.groups[g]][n]) return true; } return false; };\nvar soSeenNow = Date.now();\nfor (var soS1 = 0; soS1 < soNames.length; soS1++) { if (soListed(soNames[soS1])) S.seen[soNames[soS1]] = soSeenNow; }\nif (soDown > 0 || soSeenNow - S.seenSaved > 60000) {\n  // Drop names no longer in any list, then save.\n  for (var soD in S.seen) { if (!soListed(soD)) delete S.seen[soD]; }\n  set_variable(\"social_seen\", JSON.stringify(S.seen));\n  S.seenSaved = soSeenNow;\n}\n// The Online tab (#76), after every poll.\nS.lastPoll = Date.now();\nrun_function(\"social_online\", [], \"social\");\n"
  },
  {
   "type": "function",
   "name": "social_status",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.social || !client.loom.social.lists) run_function(\"social_setup\", [], \"social\");\nvar S = client.loom.social;\nvar soCounts = [];\nvar soWatch = [];\nfor (var soI = 0; soI < S.groups.length; soI++) {\n  soCounts.push(S.groups[soI] + \" \" + Object.keys(S.lists[S.groups[soI]]).length);\n  if (S.watch[S.groups[soI]]) soWatch.push(S.groups[soI]);\n}\ndisplay_notice(\"[social] lists: \" + soCounts.join(\", \") + \".\", \"cyan\");\ndisplay_notice(\"[social] polling \" + String(get_variable(\"social_poll\")).toUpperCase()\n  + (S.prev ? \" (\" + Object.keys(S.prev).length + \" online)\" : \" (not primed yet)\")\n  + \", watching \" + (soWatch.length ? soWatch.join(\", \") : \"nothing\") + \". SOCIAL HELP for commands.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "social_online",
   "enabled": true,
   "code": "// social_online -- the Online tab (#76): the watched people who are online,\n// one row each, alphabetical, in the colour of their group. Watched means in\n// a group that SOCIAL WATCH covers, so the tab agrees with the \"has awoken\"\n// notices. Drawn after every QW poll (social_flush); nothing is sent for it.\n//   - arrivals glow for S.flashMs, departures stay greyed for as long\n//   - \"online for\", counted from the first poll that saw them\n//   - the group's name in a tooltip on the name (Ricardo: colour is enough)\n//   - below, OFFLINE: the other watched people, last seen most recent first,\n//     folded or shown by clicking its heading or with SOCIAL OFFLINE ON/OFF\n//   - room on each row for columns other packages may add (#196 standings,\n//     #197 ledger, through the display entry point #159); none yet\n// Through loom's display entry point (#159): your standing with each person\n// (#196, from standings), when both are installed and the link is on.\nvar LL = client.loom.loom;\nfunction ask(q, n) { return (LL && LL.answer) ? LL.answer(\"social\", q, n) : undefined; }\n// The standing column: the band in its colour, an arrow when it moved in the\n// last few days, the score and the dealings on hover. Empty for someone not\n// on the books, so the column stays quiet.\nfunction standCell(n) {\n  var st = ask(\"person.standing\", cap(n));\n  if (!st) return '<span style=\"flex:none;min-width:8em;\"></span>';\n  var arrow = st.trend > 0 ? ' &#9650;' : (st.trend < 0 ? ' &#9660;' : '');\n  var sc = (st.score > 0 ? \"+\" : \"\") + (Math.round(st.score * 10) / 10).toFixed(1);\n  var tip = st.band + \" \" + sc + (st.recent ? \", \" + st.recent + \" dealing\" + (st.recent === 1 ? \"\" : \"s\") + \" in the last few days\" + (st.trend > 0 ? \", up\" : (st.trend < 0 ? \", down\" : \"\")) : \"\");\n  return '<span title=\"' + esc(tip) + '\" style=\"flex:none;min-width:8em;text-align:right;white-space:nowrap;cursor:default;color:' + esc(st.colour) + ';\">' + esc(st.band) + '<span style=\"font-size:8px;\">' + arrow + '</span></span>';\n}\n// House style shared with Stats, DmgChart, Standings: ink panel, serif\n// small-caps headings, monospace rows. The accent is a moonlit teal.\nvar S = client.loom.social;\nvar TEAL = \"#7fd6c8\";\nvar DEEP = \"#3f6f69\";\nvar TXT = \"#e2e8e6\";\nvar MUTED = \"#86908e\";\nvar RULE = \"#232b2a\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nvar now = Date.now();\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\nfunction cap(n) { return n.charAt(0).toUpperCase() + n.slice(1); }\nfunction p2(n) { return (n < 10 ? \"0\" : \"\") + n; }\nfunction agoTxt(ms) {\n  var m = Math.floor(ms / 60000);\n  if (m < 1) return \"just now\";\n  if (m < 60) return m + \"m ago\";\n  var h = Math.floor(m / 60);\n  if (h < 48) return h + \"h ago\";\n  return Math.floor(h / 24) + \"d ago\";\n}\nfunction forTxt(ms) {\n  var m = Math.floor(ms / 60000);\n  if (m < 1) return \"&lt;1m\";\n  if (m < 60) return m + \"m\";\n  return Math.floor(m / 60) + \"h \" + p2(m % 60) + \"m\";\n}\n\n// name -> its first watched group, in priority order (the colour it takes).\nvar grp = {};\nvar watchedN = 0;\nfor (var gi = 0; gi < S.groups.length; gi++) {\n  var g = S.groups[gi];\n  if (!S.watch[g]) continue;\n  for (var nm in S.lists[g]) {\n    if (S.lists[g].hasOwnProperty(nm) && !grp[nm] && nm !== S.me) { grp[nm] = g; watchedN++; }\n  }\n}\n\n// Rows: watched and online, plus watched people who just left.\nvar rows = [];\nvar onN = 0;\nvar on = S.prev || {};\nfor (var n1 in on) {\n  if (on.hasOwnProperty(n1) && grp[n1]) { rows.push({ n: n1, out: false }); onN++; }\n}\nvar fl = S.flash || {};\nfor (var n2 in fl) {\n  if (!fl.hasOwnProperty(n2)) continue;\n  if (now - fl[n2].at > S.flashMs) { delete fl[n2]; continue; }\n  if (fl[n2].kind === \"out\" && grp[n2] && !on[n2]) rows.push({ n: n2, out: true });\n}\nrows.sort(function (a, b) { return a.n < b.n ? -1 : (a.n > b.n ? 1 : 0); });\n\nvar dt = S.lastPoll ? new Date(S.lastPoll) : null;\nvar polling = get_variable(\"social_poll\") == \"on\";\nvar html = '<div id=\"loom-online\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:#0f1312;border:1px solid ' + RULE + ';padding:7px 8px 8px;min-height:100%;box-sizing:border-box;\">';\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\nhtml += '<div style=\"font-family:' + SERIF + ';color:' + TEAL + ';font-size:14px;letter-spacing:0.22em;\">ONLINE</div>';\nhtml += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + MUTED + ';font-size:11px;\"><span style=\"color:' + TEAL + ';\">' + onN + '</span> of ' + watchedN + ' watched</div></div>';\n\nif (!watchedN) {\n  html += '<div style=\"margin-top:8px;color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">Nobody is watched yet. Add people to a group (SOCIAL ADD &lt;group&gt; &lt;name&gt;) and watch it (SOCIAL WATCH).</div>';\n} else if (S.prev === null) {\n  html += '<div style=\"margin-top:8px;color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">' + (polling ? \"Waiting for the first poll…\" : \"Polling is off (SOCIAL POLL ON).\") + '</div>';\n} else if (!rows.length) {\n  html += '<div style=\"margin-top:8px;color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">None of your watched people are online.</div>';\n} else {\n  html += '<div style=\"margin-top:5px;\">';\n  for (var ri = 0; ri < rows.length; ri++) {\n    var r = rows[ri];\n    var g2 = grp[r.n];\n    var col = S.color[g2] || TXT;\n    var f = fl[r.n];\n    var glow = !r.out && f && f.kind === \"in\";\n    var nameStyle = r.out ? 'color:' + MUTED + ';text-decoration:line-through;' : 'color:' + col + ';' + (glow ? 'font-weight:bold;text-shadow:0 0 6px ' + col + ',0 0 2px ' + col + ';' : '');\n    // Online since their login, or since yours if we never saw theirs.\n    var sinceAt = (S.since && S.since[r.n]) || S.loginAt;\n    var since = sinceAt ? now - sinceAt : null;\n    var right = r.out ? \"logged out\" : (glow ? \"logged in\" : (since !== null ? forTxt(since) : \"\"));\n    html += '<div style=\"display:flex;align-items:baseline;gap:8px;border-bottom:1px dotted ' + RULE + ';padding:2px 0;' + (r.out ? 'opacity:0.6;' : '') + '\">';\n    html += '<span title=\"' + esc(g2) + '\" style=\"flex:1 1 auto;white-space:nowrap;font-family:' + SERIF + ';font-size:12px;cursor:default;' + nameStyle + '\">' + esc(cap(r.n)) + '</span>';\n    // Integration columns go here, between the name and the time: standing\n    // (#196), then ledger (#197).\n    html += standCell(r.n);\n    html += '<span style=\"min-width:5.5em;text-align:right;color:' + (r.out ? MUTED : (glow ? col : MUTED)) + ';white-space:nowrap;\">' + right + '</span>';\n    html += '</div>';\n  }\n  html += '</div>';\n}\n// OFFLINE: watched people not online (nor just left), last seen most recent\n// first, never seen last. A click on the heading folds or unfolds it until\n// the page reloads; SOCIAL OFFLINE ON/OFF sets it for good.\nif (watchedN && S.prev !== null) {\n  var off = [];\n  for (var n3 in grp) {\n    if (grp.hasOwnProperty(n3) && !on[n3] && !(fl[n3] && fl[n3].kind === \"out\")) off.push({ n: n3, seen: (S.seen && S.seen[n3]) || 0 });\n  }\n  off.sort(function (a, b) { return (b.seen - a.seen) || (a.n < b.n ? -1 : (a.n > b.n ? 1 : 0)); });\n  if (off.length) {\n    // The fold isn't in this HTML at all: a class on the page body\n    // (loom-ofl-fold) hides the list and turns the arrow, through a style\n    // set up once below. The click toggles that class; redraws never touch\n    // it, so they can't undo it or flicker. SOCIAL OFFLINE ON/OFF and a page\n    // load set it from the saved setting.\n    html += '<div onclick=\"document.body.classList.toggle(\\'loom-ofl-fold\\')\" style=\"cursor:pointer;margin-top:9px;border-top:1px solid ' + RULE + ';padding-top:5px;font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;font-size:11px;color:' + DEEP + ';\"><span class=\"loom-ofl-arrow\"></span>offline <span style=\"color:' + MUTED + ';\">' + off.length + '</span></div>';\n    html += '<div class=\"loom-ofl-list\">';\n    for (var oi = 0; oi < off.length; oi++) {\n      var o = off[oi];\n      html += '<div style=\"display:flex;align-items:baseline;gap:8px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;opacity:0.55;\">';\n      html += '<span title=\"' + esc(grp[o.n]) + '\" style=\"flex:1 1 auto;white-space:nowrap;font-family:' + SERIF + ';font-size:11px;cursor:default;color:' + (S.color[grp[o.n]] || TXT) + ';\">' + esc(cap(o.n)) + '</span>';\n      html += standCell(o.n);\n      html += '<span style=\"min-width:5.5em;text-align:right;color:' + MUTED + ';white-space:nowrap;\">' + (o.seen ? agoTxt(now - o.seen) : \"not seen yet\") + '</span>';\n      html += '</div>';\n    }\n    html += '</div>';\n  }\n}\nhtml += '<div style=\"display:flex;justify-content:space-between;margin-top:6px;color:' + MUTED + ';\">';\nhtml += '<span>' + (S.qwTotal ? S.lastCount + ' visible &middot; ' + S.qwHidden + ' hidden &middot; ' + S.qwTotal + ' total' : '') + '</span>';\nhtml += '<span>' + (polling ? (dt ? 'last poll ' + p2(dt.getHours()) + ':' + p2(dt.getMinutes()) + ':' + p2(dt.getSeconds()) : '') : '<span style=\"color:#e0a05a;\">polling off</span>') + '</span></div>';\nhtml += '</div>';\n// The page style: the fold, and the panel filling the tab however few rows it\n// has (the tab's own container takes the panel's ink, in case Nexus doesn't pass\n// its height down). Its text is set on every draw, so a reimport's change shows\n// without a page reload; the body class starts from the setting the first time.\ntry {\n  var oflSt = document.getElementById(\"loom-ofl-style\");\n  if (!oflSt) {\n    oflSt = document.createElement(\"style\");\n    oflSt.id = \"loom-ofl-style\";\n    document.head.appendChild(oflSt);\n    document.body.classList.toggle(\"loom-ofl-fold\", S.showOffline === false);\n  }\n  var oflCss = 'body.loom-ofl-fold .loom-ofl-list { display: none; } .loom-ofl-arrow::before { content: \"\\\\25BE  \"; } body.loom-ofl-fold .loom-ofl-arrow::before { content: \"\\\\25B8  \"; }' +\n    ' .flexlayout__tab:has(#loom-online) { background: #0f1312 !important; } .flexlayout__tab:has(#loom-online) > * { min-height: 100%; }';\n  if (oflSt.textContent !== oflCss) oflSt.textContent = oflCss;\n} catch (e) {}\ntry { set_custom_tab_html(\"Online\", html); } catch (e) {}\n"
  },
  {
   "type": "function",
   "name": "social_help",
   "enabled": true,
   "code": "// social_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[social] name highlighting by group, online/offline notices and the Online tab for the names you watch. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"SOCIAL\", \"status: list sizes, polling, watched groups\"],\n  [\"SOCIAL ADD <group> <name>\", \"add a name to a group\"],\n  [\"SOCIAL DEL <group> <name>\", \"remove it\"],\n  [\"SOCIAL LIST [group]\", \"names in a group (no group: counts)\"],\n  [\"SOCIAL COLOR <group|self> [#rrggbb]\", \"highlight colour (no colour: back to the default)\"],\n  [\"SOCIAL WATCH [group]\", \"announce when that group's names log in or out (no group: show)\"],\n  [\"SOCIAL OFFLINE [ON|OFF]\", \"show or fold the Online tab's offline section (clicking its heading flips it too)\"],\n  [\"SOCIAL UNWATCH <group>\", \"stop announcing it\"],\n  [\"SOCIAL POLL ON|OFF|NOW\", \"the QW poll behind the announcements (every 5s)\"],\n  [\"SOCIAL RESET\", \"reload the lists, re-prime the watchlist\"],\n  [\"SOCIAL DEBUG [ON|OFF]\", \"internal state; ON shows each poll\"],\n  [\"Groups, highest priority first: family, enemies, order, house, city, allies, friends.\"],\n  [\"Your city's enemies list reloads itself whenever the game shows it (e.g. CITY ENEMIES).\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// SOCIAL [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.social || !client.loom.social.lists) run_function(\"social_setup\", [], \"social\");\nvar S = client.loom.social;\nvar soW = String(args[1] || \"\").trim().toLowerCase().split(/\\s+/);\nvar soSub = soW[0];\nvar C = \"cyan\";\nvar soGroup = soW[1] || \"\";\nvar soIsGroup = S.lists[soGroup] !== undefined;\n\nif (soSub === \"\" || soSub === \"status\") {\n  run_function(\"social_status\", [], \"social\");\n} else if (soSub === \"help\") {\n  run_function(\"social_help\", [], \"social\");\n} else if ((soSub === \"add\" || soSub === \"del\") && soW.length == 3) {\n  if (!soIsGroup) {\n    display_notice(\"[social] no group '\" + soGroup + \"'. Groups: \" + S.groups.join(\", \") + \".\", \"orange\");\n  } else if (soSub === \"add\") {\n    S.lists[soGroup][soW[2]] = true;\n    run_function(\"social_save\", [], \"social\");\n    display_notice(\"[social] +\" + soW[2] + \" -> \" + soGroup, S.color[soGroup]);\n  } else if (S.lists[soGroup][soW[2]]) {\n    delete S.lists[soGroup][soW[2]];\n    run_function(\"social_save\", [], \"social\");\n    display_notice(\"[social] -\" + soW[2] + \" from \" + soGroup, \"lime\");\n  } else {\n    display_notice(\"[social] \" + soW[2] + \" is not in \" + soGroup + \".\", \"orange\");\n  }\n} else if (soSub === \"list\") {\n  if (soGroup === \"\") {\n    for (var soI = 0; soI < S.groups.length; soI++) display_notice(\"  \" + S.groups[soI] + \": \" + Object.keys(S.lists[S.groups[soI]]).length, S.color[S.groups[soI]]);\n  } else if (!soIsGroup) {\n    display_notice(\"[social] no group '\" + soGroup + \"'.\", \"orange\");\n  } else {\n    var soNames = Object.keys(S.lists[soGroup]).sort();\n    display_notice(\"[social] \" + soGroup + \" (\" + soNames.length + \"): \" + (soNames.length ? soNames.join(\", \") : \"empty\"), S.color[soGroup]);\n  }\n} else if (soSub === \"color\" || soSub === \"colour\") {\n  if (S.defColor[soGroup] === undefined) {\n    display_notice(\"[social] SOCIAL COLOR <group|self> [#rrggbb] (no colour: back to the default).\", \"orange\");\n  } else if (soW[2] && /^#[0-9a-f]{6}$/.test(soW[2])) {\n    S.color[soGroup] = soW[2];\n    run_function(\"social_save\", [], \"social\");\n    display_notice(\"[social] \" + soGroup + \" colour \" + soW[2] + \".\", soW[2]);\n  } else if (!soW[2]) {\n    S.color[soGroup] = S.defColor[soGroup];\n    run_function(\"social_save\", [], \"social\");\n    display_notice(\"[social] \" + soGroup + \" colour back to \" + S.defColor[soGroup] + \".\", S.defColor[soGroup]);\n  } else {\n    display_notice(\"[social] colours are #rrggbb, e.g. #ff9f4f.\", \"orange\");\n  }\n} else if (soSub === \"watch\" || soSub === \"unwatch\") {\n  if (soGroup === \"\") {\n    var soOn = [], soOff = [];\n    for (var soJ = 0; soJ < S.groups.length; soJ++) { if (S.watch[S.groups[soJ]]) soOn.push(S.groups[soJ]); else soOff.push(S.groups[soJ]); }\n    display_notice(\"[social] watching (priority order): \" + (soOn.length ? soOn.join(\", \") : \"none\") + \"; not watching: \" + (soOff.length ? soOff.join(\", \") : \"none\") + \".\", C);\n  } else if (!soIsGroup) {\n    display_notice(\"[social] no group '\" + soGroup + \"'.\", \"orange\");\n  } else {\n    S.watch[soGroup] = (soSub === \"watch\");\n    run_function(\"social_save\", [], \"social\");\n    display_notice(\"[social] \" + (S.watch[soGroup] ? \"now watching \" : \"no longer watching \") + soGroup + \".\", \"lime\");\n  }\n} else if (soSub === \"poll\") {\n  if (soGroup === \"on\" || soGroup === \"off\") {\n    set_variable(\"social_poll\", soGroup);\n    display_notice(\"[social] polling \" + soGroup.toUpperCase() + \".\", C);\n  } else if (soGroup === \"now\") {\n    S.reportOnce = true;\n    run_function(\"social_poll\", [], \"social\");\n  } else {\n    display_notice(\"[social] polling is \" + String(get_variable(\"social_poll\")).toUpperCase() + \". SOCIAL POLL ON|OFF|NOW.\", C);\n  }\n} else if (soSub === \"offline\") {\n  // SOCIAL OFFLINE [ON|OFF]: show or fold the Online tab's Offline section.\n  var soOff = (soW[1] || \"\").toLowerCase();\n  if (soOff === \"on\" || soOff === \"off\") {\n    S.showOffline = soOff === \"on\";\n    set_variable(\"social_offline\", soOff);\n    // Also overrides a fold set by clicking the heading this session.\n    try { document.body.classList.toggle(\"loom-ofl-fold\", !S.showOffline); } catch (e) {}\n    display_notice(\"[social] the Online tab's offline section is \" + (S.showOffline ? \"shown\" : \"folded\") + \".\", \"lime\");\n  } else {\n    display_notice(\"[social] the Online tab's offline section is \" + (S.showOffline ? \"shown\" : \"folded\") + \". SOCIAL OFFLINE ON or OFF to change it; clicking its heading flips it too.\", \"cyan\");\n  }\n} else if (soSub === \"debug\") {\n  if (soGroup === \"on\" || soGroup === \"off\") {\n    S.debug = (soGroup === \"on\");\n    set_variable(\"social_debug\", soGroup);\n  }\n  display_notice(\"[social] debug \" + (S.debug ? \"ON\" : \"OFF\") + \" | me \" + S.me + \" | city \" + S.city + \" | primed \" + (S.prev ? Object.keys(S.prev).length : \"no\") + \" | last count \" + S.lastCount + \" | timer \" + (S.timer ? \"set\" : \"none\"), C);\n} else if (soSub === \"reset\") {\n  S.prev = null;\n  run_function(\"social_setup\", [], \"social\");\n  display_notice(\"[social] reset: lists reloaded, watchlist re-primes on the next poll.\", \"lime\");\n} else {\n  display_notice(\"[social] unknown command '\" + soSub + \"'. SOCIAL HELP for commands.\", \"orange\");\n}\n// Lists, colours, watches and polling all show on the Online tab (#76).\nif ([\"add\", \"del\", \"color\", \"colour\", \"watch\", \"unwatch\", \"poll\", \"reset\", \"offline\"].indexOf(soSub) >= 0) run_function(\"social_online\", [], \"social\");\n// Lists and colours are what social's look reports (#159): tell loom, so the\n// tabs showing them redraw (guarded: social works without loom).\nif ([\"add\", \"del\", \"color\", \"colour\"].indexOf(soSub) >= 0 && client.loom.notify) client.loom.notify(\"social\");\n"
    }
   ],
   "text": "^social(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "line",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Every line: colour listed names (and your own), and collect QW output while\n// a poll is capturing.\nif (!client.loom || !client.loom.social || !client.loom.social.lists) run_function(\"social_setup\", [], \"social\");\nvar S = client.loom.social;\nvar soLine = args[1];\nif (soLine) {\n  var soRe = S.reWord;\n  soRe.lastIndex = 0;\n  var soM;\n  while ((soM = soRe.exec(soLine)) !== null) {\n    var soName = soM[0].toLowerCase();\n    if (S.me && soName == S.me) {\n      colorize_current_line(soM.index, soM[0].length, S.color.self, \"\");\n      continue;\n    }\n    for (var soI = 0; soI < S.groups.length; soI++) {\n      if (S.lists[S.groups[soI]][soName]) {\n        colorize_current_line(soM.index, soM[0].length, S.color[S.groups[soI]], \"\");\n        break;\n      }\n    }\n  }\n}\n// The capture ends on QW's last line, \"Plus another N ... (M total).\" (#75),\n// not on a timer; only QW-shaped lines are gagged.\nif (S.capturing) {\n  if (soLine === \"qw\") {\n    gag_current_line();\n  } else if (S.reFooter.test(soLine)) {\n    S.buf.push(soLine);\n    gag_current_line();\n    run_function(\"social_flush\", [], \"social\");\n  } else if (S.reNames.test(soLine)) {\n    S.buf.push(soLine);\n    gag_current_line();\n  }\n}\n"
    }
   ],
   "text": "^(.*)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"Enemies of <your city>:\" -- start replacing the enemies list with the\n// names that follow, up to \"Total: n\". Only your own city's list (city from\n// GMCP); house, order or other cities' lists are left alone.\nif (!client.loom || !client.loom.social || !client.loom.social.lists) run_function(\"social_setup\", [], \"social\");\nvar S = client.loom.social;\n// Cities whose list header doesn't carry the city's name.\nvar soHeaders = { cyrene: \"thalassan empire\" };\nvar soHead = args[1].toLowerCase();\nvar soMine = S.city && (soHead.indexOf(S.city) >= 0 || (soHeaders[S.city] && soHead.indexOf(soHeaders[S.city]) >= 0));\nif (soMine) {\n  S.loadEnemies = {};\n} else if (S.debug) {\n  display_notice(\"[social] enemies list not loaded: '\" + args[1] + \"' isn't \" + (S.city || \"your city (none known yet)\") + \".\", \"cyan\");\n}\n"
    }
   ],
   "text": "^Enemies of (.+):",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.social || !client.loom.social.lists) run_function(\"social_setup\", [], \"social\");\nvar S = client.loom.social;\nif (S.loadEnemies) {\n  var soParts = args[1].split(\",\");\n  for (var soI = 0; soI < soParts.length; soI++) {\n    var soNm = soParts[soI].trim().toLowerCase();\n    if (soNm.length && soNm !== \"none\") S.loadEnemies[soNm] = true;\n  }\n}\n"
    }
   ],
   "text": "^([A-Z][a-z]+(?:,\\s*[A-Z][a-z]+)*),?\\s*$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.social || !client.loom.social.lists) run_function(\"social_setup\", [], \"social\");\nvar S = client.loom.social;\nif (S.loadEnemies) {\n  var soE = S.lists.enemies;\n  for (var soK in soE) delete soE[soK];\n  for (var soN in S.loadEnemies) soE[soN] = true;\n  S.loadEnemies = null;\n  run_function(\"social_save\", [], \"social\");\n  var soHave = Object.keys(soE).length;\n  var soWant = parseInt(args[1], 10);\n  display_notice(\"[social] city enemies loaded: \" + soHave + \" / \" + soWant + (soHave !== soWant ? \" (count mismatch)\" : \"\") + \".\", soHave === soWant ? \"cyan\" : \"orange\");\n}\n"
    }
   ],
   "text": "^Total: (\\d+)",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  }
 ],
 "description": "Name highlights by group; who you watch, online in the Online tab"
}