{
 "type": "group",
 "name": "fishing",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is installed"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is uninstalled"
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"bait\", args[1]);\ndisplay_notice(\"Bait set to \" + get_variable(\"bait\"));"
    }
   ],
   "text": "^bait (\\w+)$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "var bait = get_variable(\"bait\");\nsend_command(\"bait hook with \" + bait);\nsend_command(\"cast line \" + args[1]);"
    }
   ],
   "text": "^cl (\\w+)$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "var pause = get_variable(\"pauseTriggers\");\n\nif (pause == \"off\") {\n  setTimeout(() => send_command(\"tease line\"), 2100);\n} else {\n  display_notice(\"[common] Triggers are currently paused.\", \"orange\");\n}"
    },
    {
     "type": "rewrite",
     "enabled": true,
     "rewrite_text_type": "value",
     "rewrite_text": "[1/4] ",
     "rewrite": "prefix",
     "rewrite_backref": "",
     "rewrite_colors": true,
     "rewrite_fg": "#fbff00",
     "rewrite_bg": "#000000"
    }
   ],
   "text": "^You feel a fish nibbling on your hook\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "var pause = get_variable(\"pauseTriggers\");\n\nif (pause == \"off\") {\n  setTimeout(() => send_command(\"tease line\"), 2100);\n} else {\n  display_notice(\"[common] Triggers are currently paused.\", \"orange\");\n}\n\n"
    },
    {
     "type": "rewrite",
     "enabled": true,
     "rewrite_text_type": "value",
     "rewrite_text": "[1/4]",
     "rewrite": "prefix",
     "rewrite_backref": "",
     "rewrite_colors": true,
     "rewrite_fg": "#fbff00",
     "rewrite_bg": "#000000"
    }
   ],
   "text": "strikes at your bait",
   "matching": "substring",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "var pause = get_variable(\"pauseTriggers\");\n\nif (pause == \"off\") {\n  setTimeout(() => send_command(\"jerk pole\"), 1800);\n} else {\n  display_notice(\"[common] Triggers are currently paused.\", \"orange\");\n}"
    },
    {
     "type": "rewrite",
     "enabled": true,
     "rewrite_text_type": "value",
     "rewrite_text": "[2/4] ",
     "rewrite": "prefix",
     "rewrite_backref": "",
     "rewrite_colors": true,
     "rewrite_fg": "#c5ff00",
     "rewrite_bg": "#000000"
    }
   ],
   "text": "^You feel a fish make a small strike at your bait\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "var pause = get_variable(\"pauseTriggers\");\n\nif (pause == \"off\") {\n  setTimeout(() => send_command(\"jerk pole\"), 1800);\n} else {\n  display_notice(\"[common] Triggers are currently paused.\", \"orange\");\n}"
    },
    {
     "type": "rewrite",
     "enabled": true,
     "rewrite_text_type": "value",
     "rewrite_text": "[2/4] ",
     "rewrite": "prefix",
     "rewrite_backref": "",
     "rewrite_colors": true,
     "rewrite_fg": "#c5ff00",
     "rewrite_bg": "#000000"
    }
   ],
   "text": "^You see the water ripple as a fish makes a medium strike at your bait\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "var pause = get_variable(\"pauseTriggers\");\n\nif (pause == \"off\") {\n  setTimeout(() => send_command(\"jerk pole\"), 1800);\n} else {\n  display_notice(\"[common] Triggers are currently paused.\", \"orange\");\n}"
    },
    {
     "type": "rewrite",
     "enabled": true,
     "rewrite_text_type": "value",
     "rewrite_text": "[2/4] ",
     "rewrite": "prefix",
     "rewrite_backref": "",
     "rewrite_colors": true,
     "rewrite_fg": "#c5ff00",
     "rewrite_bg": "#000000"
    }
   ],
   "text": "^You stagger as a fish makes a large strike at your bait\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "var pause = get_variable(\"pauseTriggers\");\n\nif (pause == \"off\") {\n  send_command(\"queue add  bal reel line\");\n} else {\n  display_notice(\"[common] Triggers are currently paused.\", \"orange\");\n}"
    },
    {
     "type": "rewrite",
     "enabled": true,
     "rewrite_text_type": "value",
     "rewrite_text": "[3/4] ",
     "rewrite": "prefix",
     "rewrite_backref": "",
     "rewrite_colors": true,
     "rewrite_fg": "#1bff00",
     "rewrite_bg": "#000000"
    }
   ],
   "text": "^You quickly jerk back your fishing pole and feel the line go taut\\.(.*)$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "var pause = get_variable(\"pauseTriggers\");\n\nif (pause == \"off\") {\n  setTimeout(() => send_command(\"reel line\"), 100);\n} else {\n  display_notice(\"[common] Triggers are currently paused.\", \"orange\");\n}"
    }
   ],
   "text": "^Relaxing the tension on your line\\, you are able to reel again\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "rewrite",
     "enabled": true,
     "rewrite_text_type": "value",
     "rewrite_text": "[4/4] ",
     "rewrite": "prefix",
     "rewrite_backref": "",
     "rewrite_colors": true,
     "rewrite_fg": "#00ffd7",
     "rewrite_bg": "#000000"
    },
    {
     "type": "sound",
     "enabled": true,
     "sound": "eagle"
    }
   ],
   "text": "^With a final tug\\, you finish reeling in the line and land (.*)\\!$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "rewrite",
     "enabled": true,
     "rewrite_text_type": "value",
     "rewrite_text": "[4/4] ",
     "rewrite": "prefix",
     "rewrite_backref": "",
     "rewrite_colors": true,
     "rewrite_fg": "#00ffd7",
     "rewrite_bg": "#000000"
    },
    {
     "type": "sound",
     "enabled": true,
     "sound": "eagle"
    }
   ],
   "text": "^You reel in the last bit of line and your struggle is over\\.(.*)$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "var pause = get_variable(\"pauseTriggers\");\n\nif (pause == \"off\") {\n  setTimeout(() => send_command(\"tease line\"), 3000);\n} else {\n  display_notice(\"[common] Triggers are currently paused.\", \"orange\");\n}"
    },
    {
     "type": "rewrite",
     "enabled": true,
     "rewrite_text_type": "value",
     "rewrite_text": "[0/4] ",
     "rewrite": "prefix",
     "rewrite_backref": "",
     "rewrite_colors": true,
     "rewrite_fg": "#ff8f00",
     "rewrite_bg": "#000000"
    }
   ],
   "text": "^You quickly jerk back your fishing pole\\, but the hook pulls free of the fish\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Fishing Record",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#6998de",
     "highlight_bg": "#000000",
     "highlight": "match",
     "highlight_backref": ""
    },
    {
     "type": "sound",
     "enabled": true,
     "sound": "ding"
    },
    {
     "type": "script",
     "enabled": true,
     "script": "var pause = get_variable(\"pauseTriggers\");\n\nif (pause == \"off\") {\n  send_command(\"partytell Ding fish!\");\n} else {\n  display_notice(\"[common] Triggers are currently paused.\", \"orange\");\n}"
    }
   ],
   "text": "You've just set a new record for this year for that catch!",
   "matching": "substring",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#48ff00",
     "highlight_bg": "#000000",
     "highlight": "match",
     "highlight_backref": ""
    }
   ],
   "text": "^The fish appear to be plentiful here\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#ff6b00",
     "highlight_bg": "#000000",
     "highlight": "match",
     "highlight_backref": ""
    }
   ],
   "text": "^The fish appear to be fairly sparse here\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  }
 ],
 "description": "Fishing reflexes"
}