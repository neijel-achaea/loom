     "case_sensitive": true
    }
   ]
  },
  {
   "type": "group",
   "name": "suggest",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "patrolling_suggest",
     "enabled": true,
     "code": "// patrolling_suggest -- a weighted random area: weight x hours since patrolled\n// (never patrolled counts as a week).\nvar P = client.loom.patrolling;\nvar paLast = get_variable(\"patrolling_last\") || {};\nvar paNow = new Date().getTime();\nvar paNames = Object.keys(P.areas);\nvar paScores = [];\nvar paTotal = 0;\nfor (var paI = 0; paI < paNames.length; paI++) {\n  var paH = paLast[paNames[paI]] ? (paNow - paLast[paNames[paI]]) / 3600000 : 168;\n  var paS = P.areas[paNames[paI]] * paH;\n  paScores.push(paS);\n  paTotal += paS;\n}\nif (paTotal <= 0) {\n  display_notice(\"[patrolling] no areas with a weight above 0.\", \"orange\");\n} else {\n  var paR = Math.random() * paTotal;\n  var paK = 0;\n  while (paK < paNames.length - 1 && paR >= paScores[paK]) { paR -= paScores[paK]; paK++; }\n  var paPick = paNames[paK];\n  var paAgo = paLast[paPick] ? Math.round((paNow - paLast[paPick]) / 3600000) + \"h ago\" : \"never\";\n  display_notice(\"[patrolling] suggest: \" + paPick + \" (weight \" + P.areas[paPick] + \", last patrolled \" + paAgo + \").\", \"cyan\");\n}\n"
    }
   ]
  },
  {
   "type": "group",
   "name": "clan",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "patrolling_date",
     "enabled": true,
     "code": "// patrolling_date -- today's Achaean date into P.dateTxt, from ledger when it\n// is loaded (client.loom.ledger, or the pre-0.2 client.lg); \"\" otherwise.\nvar P = client.loom.patrolling;\nvar paLg = (client.loom.ledger && client.loom.ledger.day > 0) ? client.loom.ledger : client.lg;\nvar paDay = (paLg && paLg.day > 0) ? paLg.day : 0;\nP.dateTxt = \"\";\nif (paDay > 0) {\n  var paN = paDay - 1;\n  var paY = Math.floor(paN / 300);\n  var paRem = paN - paY * 300;\n  P.dateTxt = ((paRem % 25) + 1) + \" \" + P.months[Math.floor(paRem / 25)] + \", \" + paY + \" AF\";\n}\n"
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "// Replanting: write it to the clan log, dated when ledger knows the date.\nif (!client.loom || !client.loom.patrolling || !client.loom.patrolling.expected) run_function(\"patrolling_setup\", [], \"patrolling\");\nvar P = client.loom.patrolling;\nvar paClan = get_variable(\"patrolling_clan\");\nif (paClan && get_variable(\"pauseTriggers\") != \"on\") {\n  run_function(\"patrolling_date\", [], \"patrolling\");\n  send_command(\"writelog \" + paClan + \" \" + (P.dateTxt || \"date not known\") + \" - Replanted \" + args[1] + \" at \" + P.room.name + \" (\" + P.room.id + \") in \" + P.room.area);\n}\n"
      }
     ],
     "text": "^You reach down and dig a small hole for (.*)\\. Putting it in the hole\\, you then cover it",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    }
   ]
  },
