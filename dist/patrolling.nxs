{
 "type": "group",
 "name": "patrolling",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"patrolling_setup\", [], \"patrolling\");\ndisplay_notice(\"[patrolling] installed. PATROLLING HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is uninstalled"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"patrolling_setup\", [], \"patrolling\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Patrolling follows the room itself, and checks each new room when ON.\nif (!client.loom || !client.loom.patrolling || !client.loom.patrolling.expected) run_function(\"patrolling_setup\", [], \"patrolling\");\nvar P = client.loom.patrolling;\nif (args.gmcp_method == \"Room.Info\") {\n  var paG = args.gmcp_args || {};\n  P.room = { id: paG.num, name: paG.name || \"\", area: paG.area || \"\", env: paG.environment || \"\" };\n  P.active = false;\n  P.gag = false;\n  // What PLANTS found belongs to the room it was found in, and only until you\n  // leave it: coming back with patrolling off shows nothing (#166).\n  P.plantsHere = null;\n  if (get_variable(\"patrolling_on\") == \"on\") run_function(\"patrolling_check\", [], \"patrolling\");\n}\n"
  },
  {
   "type": "group",
   "name": "core",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "patrolling_setup",
     "enabled": true,
     "code": "// patrolling_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, migration, tables.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.patrolling) client.loom.patrolling = {};\n// busy (#318): true while the room check's PLANTS and INFO HERE are still\n// coming (until INFO HERE's \"Number of objects\" line), so Here's loyal\n// probe waits its turn. A check with no end line for 5 s no longer counts.\nclient.loom.registry.patrolling = { version: \"0.3.2\", keyword: \"PATROLLING\", desc: \"Checks each room's plants and shrines, and suggests areas to patrol\", busy: function () {\n  var Pb = client.loom.patrolling;\n  return !!(Pb && Pb.active && Date.now() - (Pb.activeAt || 0) < 5000);\n} };\nvar P = client.loom.patrolling;\n\n// One-time migration: patrol_last -> patrolling_last; the old session object\n// on client.patrol is dropped (its ON state carries over).\nvar paOld = get_variable(\"patrol_last\");\nif (paOld !== null && paOld !== undefined) {\n  if (!get_variable(\"patrolling_last\")) set_variable(\"patrolling_last\", paOld);\n  delete_variable(\"patrol_last\");\n}\nif (client.patrol) {\n  if (client.patrol.on && !get_variable(\"patrolling_on\")) set_variable(\"patrolling_on\", \"on\");\n  client.patrol = null;\n}\nif (!get_variable(\"patrolling_on\")) set_variable(\"patrolling_on\", \"off\");\n// Clan for fire alerts, lightning reports and replanting logs; empty = none.\nif (get_variable(\"patrolling_clan\") === null || get_variable(\"patrolling_clan\") === undefined) set_variable(\"patrolling_clan\", \"\");\n// Gods by stance (#164, Ricardo): patrolling_gods = { sartan: \"hostile\",\n// gaia: \"friendly\" }; any god not listed is neutral. Shrines and totems of\n// friendly gods aren't reported on patrol; the Here tab marks friendly and\n// hostile ones. One-time migration: the old single patrolling_god becomes a\n// friendly god (it only ever meant \"don't flag these\").\nP.gods = {};\ntry { P.gods = JSON.parse(get_variable(\"patrolling_gods\") || \"{}\") || {}; } catch (e) { P.gods = {}; }\nvar paOldGod = get_variable(\"patrolling_god\");\nif (paOldGod !== null && paOldGod !== undefined) {\n  if (String(paOldGod).trim()) P.gods[String(paOldGod).trim().toLowerCase()] = \"friendly\";\n  delete_variable(\"patrolling_god\");\n  set_variable(\"patrolling_gods\", JSON.stringify(P.gods));\n}\nP.saveGods = function () {\n  set_variable(\"patrolling_gods\", JSON.stringify(P.gods));\n  if (client.loom.notify) client.loom.notify(\"patrolling\");\n};\n// The read-only look other tabs see through loom's display entry point\n// (#159): what patrolling makes of an item, never its variables.\n//   look.item(name) -> { kind: \"shrine\"|\"totem\", god, stance } for a shrine\n//     or totem (\"friendly\", \"hostile\" or \"neutral\"), undefined otherwise.\n//     A listed god is found as a word anywhere in the name (\"a shrine of\n//     Sartan\", \"a totem to Sartan\"); god is \"\" when none is listed.\n//   look.plants(roomId) -> the plants PLANTS found in that room on its last\n//     check ([\"ginseng\", ...]), or undefined when that room wasn't the last\n//     one checked (#166: Here colours the environment's plants by it)\n//   look.expected(env) -> the plants that should grow in that environment\n//     (GMCP's name, any case), from the expected table; undefined if unknown\nP.look = {\n  expected: function (env) {\n    var e = String(env || \"\").trim().toLowerCase();\n    for (var k in P.expected) { if (P.expected.hasOwnProperty(k) && k.toLowerCase() === e) return P.expected[k].slice(); }\n    return undefined;\n  },\n  plants: function (id) {\n    var ph = P.plantsHere;\n    return (ph && id !== undefined && id !== null && String(ph.id) === String(id)) ? ph.present.slice() : undefined;\n  },\n  item: function (name) {\n    var n = String(name || \"\");\n    var km = n.match(/\\b(shrine|totem)\\b/i);\n    if (!km) return undefined;\n    for (var g in P.gods) {\n      if (P.gods.hasOwnProperty(g) && new RegExp(\"\\\\b\" + g.replace(/[^a-z' -]/g, \"\") + \"\\\\b\", \"i\").test(n)) return { kind: km[1].toLowerCase(), god: g, stance: P.gods[g] };\n    }\n    return { kind: km[1].toLowerCase(), god: \"\", stance: \"neutral\" };\n  }\n};\nif (!get_variable(\"patrolling_last\")) set_variable(\"patrolling_last\", {});\n\nP.active = false;\nP.gag = false;\nP.present = [];\nP.shrines = [];\nif (!P.room) P.room = { id: \"\", name: \"\", area: \"\", env: \"\" };\nP.months = [\"Sarapin\", \"Daedalan\", \"Aeguary\", \"Miraman\", \"Scarlatan\", \"Ero\", \"Valnuary\", \"Lupar\", \"Phaestian\", \"Chronos\", \"Glacian\", \"Mayan\"];\n\n// Plants each environment should hold (GMCP environment name).\nP.expected = {\n  \"Deep Ocean\": [],\n  \"Reef\": [],\n  \"Shadowscape\": [],\n  \"Wastelands\": [],\n  \"Water\": [],\n  \"Ocean\": [\"kelp\"],\n  \"Trees\": [],\n  \"Ruins\": [],\n  \"Road\": [],\n  \"Constructed underground\": [],\n  \"Blighted\": [],\n  \"Hills\": [\"hawthorn\",\"bayberry\"],\n  \"Desert\": [\"pear\",\"weed\"],\n  \"Jungle\": [\"kola\",\"skullcap\",\"kuzu\",\"fruit\",\"cacao\"],\n  \"Valley\": [\"sileris\",\"olive\"],\n  \"Mountains\": [\"valerian\"],\n  \"Beach\": [],\n  \"Path\": [],\n  \"Urban\": [],\n  \"Natural underground\": [\"moss\",\"lumic\",\"bloodroot\"],\n  \"Garden\": [\"echinacea\",\"ginger\",\"lobelia\",\"myrrh\",\"ginseng\",\"elm\",\"fruit\",\"vegetable\"],\n  \"River\": [\"kelp\"],\n  \"Swamp\": [\"cohosh\",\"bellwort\",\"ash\"],\n  \"Freshwater\": [\"kelp\"],\n  \"Grasslands\": [\"slipper\",\"sugarcane\",\"grain\",\"goldenseal\"],\n  \"Forest\": [\"burdock\",\"ginseng\",\"ginger\",\"myrrh\",\"echinacea\",\"lobelia\",\"elm\",\"nut\"]\n};\n\n// How much each area is worth patrolling (PATROLLING SUGGEST weighs by this\n// and by hours since the last patrol); 0 = never suggest.\nP.areas = {\n  \"Aalen\": 10,\n  \"Actar Valley\": 3,\n  \"Adryn's Keep\": 3,\n  \"Aerinewild\": 10,\n  \"Ageiro\": 3,\n  \"Annwyn\": 1,\n  \"Aran'riod\": 1,\n  \"Arcadia\": 1,\n  \"Asterian Peninsula\": 1,\n  \"Aster Keep\": 1,\n  \"Atrousian Jungle\": 1,\n  \"Aureliana\": 10,\n  \"Aurick Manor\": 3,\n  \"Azdun\": 3,\n  \"Bagwar's Copse\": 3,\n  \"Bataoac\": 1,\n  \"Battlesite of Mourning Pass\": 1,\n  \"Belladona's Keep\": 3,\n  \"Bitterfork\": 3,\n  \"Black Forest\": 10,\n  \"Blackrock\": 3,\n  \"Bog\": 3,\n  \"Boldarihm\": 3,\n  \"Bopalopia\": 1,\n  \"Brass Lantern Inn\": 3,\n  \"Chaghut Encampment\": 1,\n  \"Chapel of All Gods\": 3,\n  \"Clockwork Isle\": 3,\n  \"Colchis\": 3,\n  \"Cormorant Rock\": 3,\n  \"Creville Asylum\": 3,\n  \"Crystal Leaf Inn\": 3,\n  \"Dakhota Hills\": 3,\n  \"Daoric Plains\": 1,\n  \"Dardanic Plains\": 3,\n  \"Darkenwood\": 10,\n  \"Delos\": 3,\n  \"Digsite of Blood\": 3,\n  \"Digsite of Discord\": 1,\n  \"Digsite of Equilibrium\": 3,\n  \"Digsite of Husks\": 3,\n  \"Digsite of Luck\": 3,\n  \"Digsite of Pain\": 3,\n  \"Digsite of Rage\": 3,\n  \"Digsite of the Mind\": 3,\n  \"Digsite of the Soul\": 1,\n  \"Digsite of War\": 3,\n  \"Digsite of Waves\": 3,\n  \"Digsite of Wealth\": 3,\n  \"Dreamspear\": 1,\n  \"Dryad Gardens\": 10,\n  \"Dun\": 3,\n  \"Dwarven Camp\": 3,\n  \"Eastern Ithmia\": 10,\n  \"Eastern Reaches\": 3,\n  \"Eastern Road\": 3,\n  \"Eastern Shore\": 3,\n  \"Eirenwaar\": 3,\n  \"Enverren Marsh\": 3,\n  \"Erymanthus\": 1,\n  \"Fissure of Echoes\": 1,\n  \"Fluvadha River\": 1,\n  \"Forest Watch\": 3,\n  \"Frozen Tundra\": 1,\n  \"Genji\": 3,\n  \"Ghezavat Commune\": 3,\n  \"Goblin Village\": 3,\n  \"Granite Hills\": 3,\n  \"Great Rock\": 3,\n  \"Green Lake\": 3,\n  \"Grukai Swamp\": 1,\n  \"Gulf of Nilakantha\": 1,\n  \"Hriddan\": 1,\n  \"Hthrak\": 1,\n  \"Ilyrean Tundra\": 3,\n  \"Inbhir Ness\": 1,\n  \"Isaia\": 1,\n  \"Ishana Steppes\": 1,\n  \"Isle of Harae\": 3,\n  \"Isolation\": 1,\n  \"Istar Jungle\": 1,\n  \"Istarion\": 1,\n  \"Jaru\": 3,\n  \"Judgement Mountain\": 1,\n  \"Ka'doloki\": 3,\n  \"Kamleikan\": 1,\n  \"Karbaz\": 3,\n  \"Lake Dakhota\": 3,\n  \"Lake Narcisse\": 3,\n  \"Lake Vundamere\": 3,\n  \"Lake Xulighae\": 1,\n  \"Luman Village\": 1,\n  \"Mannaseh Swamp\": 3,\n  \"Manticore Caves\": 3,\n  \"Manusha\": 3,\n  \"Mesmerium\": 3,\n  \"Mhaldor Isle\": 3,\n  \"Mhojave\": 3,\n  \"Mines of Iskadar\": 1,\n  \"Minos\": 3,\n  \"Mirror Caves\": 1,\n  \"Mnemosyne Delta\": 1,\n  \"Mnemosyne River\": 1,\n  \"Morindar\": 1,\n  \"Mount Piraeus\": 3,\n  \"Muurn Jungle/Lake\": 3,\n  \"Mysia\": 3,\n  \"New Hope\": 3,\n  \"New Thera\": 3,\n  \"Nilakantha\": 1,\n  \"Nimick\": 3,\n  \"Northern Ithmia\": 10,\n  \"Northern Plains\": 3,\n  \"Northern Scrublands\": 1,\n  \"Northern Vashnars\": 3,\n  \"Northreach\": 10,\n  \"Northreach Barrows\": 3,\n  \"Orcish Outpost\": 3,\n  \"Pachacacha\": 3,\n  \"Pash Valley\": 3,\n  \"Peshwar Delta\": 3,\n  \"Petra\": 3,\n  \"Pherklos Ruins\": 3,\n  \"Polyargos\": 3,\n  \"Prin\": 0,\n  \"Prison\": 1,\n  \"Quartz Peak\": 3,\n  \"Qurnok\": 3,\n  \"Rheodad\": 1,\n  \"Rhodestrian\": 3,\n  \"Riagath\": 1,\n  \"Riparium\": 3,\n  \"Saiha'balan Grotto\": 3,\n  \"Salt mines of Ulsyndar\": 1,\n  \"Saoghal Valley\": 1,\n  \"Sangre Plains\": 3,\n  \"Sarave Foothills\": 1,\n  \"Savannah\": 3,\n  \"Scorpion Pit\": 3,\n  \"Sea Lion Cove\": 3,\n  \"Seat of Vastar\": 1,\n  \"Shala-Khulia\": 3,\n  \"Shala'jen-Past\": 1,\n  \"Shala'jen-Present\": 3,\n  \"Shamtota Hills\": 3,\n  \"Shipwrecks Isle\": 3,\n  \"Silverveil River\": 3,\n  \"Siroccian Mountains\": 3,\n  \"Sirocco Fortress\": 1,\n  \"Southern Vashnars\": 3,\n  \"Squall Cleft\": 1,\n  \"Suliel\": 3,\n  \"Sunderlands\": 0, // Nothing to patrol there\n  \"Tapoa\": 3,\n  \"Tasur'ke\": 3,\n  \"Temple of the Sky\": 0,\n  \"Thraasi Foothills\": 3,\n  \"Tir Murann\": 3,\n  \"Tomacula Village\": 3,\n  \"Tower of Falaq'tor\": 1,\n  \"Tuar\": 3,\n  \"Ulangi\": 3,\n  \"Umbrin\": 3,\n  \"Urubamba\": 3,\n  \"Valho Coast\": 1,\n  \"Vashnars\": 3,\n  \"Vasnari Mountains\": 1,\n  \"Wevaga Valley\": 1,\n  \"Western Ithmia\": 10,\n  \"Western Vashnars\": 3,\n  \"Xhaiden Dale\": 3,\n  \"Zanzibaar\": 3,\n  \"Zaphar Isle\": 3,\n  \"Zaphar River\": 3,\n};\n"
    },
    {
     "type": "function",
     "name": "patrolling_status",
     "enabled": true,
     "code": "var P = client.loom.patrolling;\ndisplay_notice(\"[patrolling] \" + String(get_variable(\"patrolling_on\")).toUpperCase()\n  + \", clan \" + (get_variable(\"patrolling_clan\") || \"none\")\n  + \", gods \" + (function () { var f = 0, h = 0; for (var g in (P.gods || {})) { if (P.gods.hasOwnProperty(g)) { if (P.gods[g] === \"hostile\") h++; else f++; } } return f + \" friendly, \" + h + \" hostile\"; })()\n  + \", here: \" + (P.room.area || \"?\") + \" / \" + (P.room.env || \"?\") + \". PATROLLING HELP for commands.\", \"cyan\");\n"
    },
    {
     "type": "function",
     "name": "patrolling_help",
     "enabled": true,
     "code": "// patrolling_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[patrolling] room-by-room plant and shrine checks for patrols. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"PATROLLING\", \"status\"],\n  [\"PATROLLING ON|OFF\", \"check every room you enter\"],\n  [\"PATROLLING HERE\", \"check this room once\"],\n  [\"PATROLLING LEARN\", \"print this room's plants as a table entry\"],\n  [\"PATROLLING SUGGEST\", \"an area to patrol, weighed by worth and time since last\"],\n  [\"PATROLLING STAMP [area]\", \"mark an area as patrolled (no area: the one you're in)\"],\n  [\"PATROLLING FIRE\", \"tell your clan there's a fire here\"],\n  [\"PATROLLING CLAN <clan|OFF>\", \"clan for fire alerts, lightning reports and replanting logs\"],\n  [\"PATROLLING GODS\", \"friendly and hostile gods; every other god is neutral\"],\n  [\"PATROLLING GODS FRIENDLY <god>\", \"not reported on patrol; marked friendly in Here\"],\n  [\"PATROLLING GODS HOSTILE <god>\", \"marked hostile in Here, with a warning in its header\"],\n  [\"PATROLLING GODS NEUTRAL <god>\", \"take a god off the lists\"],\n  [\"PATROLLING RESET / DEBUG\", \"reload the tables / internal state\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "// PATROLLING [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.patrolling || !client.loom.patrolling.expected) run_function(\"patrolling_setup\", [], \"patrolling\");\nvar P = client.loom.patrolling;\nvar paRaw = String(args[1] || \"\").trim();\nvar paW = paRaw.toLowerCase().split(/\\s+/);\nvar paSub = paW[0];\nvar paRest = paRaw.substring(paW[0].length).trim();\nvar C = \"cyan\";\nif (paSub === \"\" || paSub === \"status\") {\n  run_function(\"patrolling_status\", [], \"patrolling\");\n} else if (paSub === \"help\") {\n  run_function(\"patrolling_help\", [], \"patrolling\");\n} else if (paSub === \"on\" || paSub === \"off\") {\n  set_variable(\"patrolling_on\", paSub);\n  if (paSub === \"off\") { P.active = false; P.gag = false; P.plantsHere = null; if (client.loom.notify) client.loom.notify(\"patrolling\"); }\n  display_notice(\"[patrolling] \" + paSub.toUpperCase() + \".\", \"lime\");\n  if (paSub === \"on\") run_function(\"patrolling_check\", [], \"patrolling\");\n} else if (paSub === \"here\") {\n  run_function(\"patrolling_check\", [], \"patrolling\");\n} else if (paSub === \"learn\") {\n  P.learn = true;\n  run_function(\"patrolling_check\", [], \"patrolling\");\n} else if (paSub === \"suggest\") {\n  run_function(\"patrolling_suggest\", [], \"patrolling\");\n} else if (paSub === \"stamp\") {\n  var paIn = (paRest || P.room.area || \"\").toLowerCase();\n  var paMatch = \"\";\n  for (var paA in P.areas) { if (paA.toLowerCase() == paIn) paMatch = paA; }\n  if (paMatch) {\n    var paLast = get_variable(\"patrolling_last\") || {};\n    paLast[paMatch] = new Date().getTime();\n    set_variable(\"patrolling_last\", paLast);\n    display_notice(\"[patrolling] \" + paMatch + \" stamped as patrolled.\", \"lime\");\n  } else {\n    display_notice(\"[patrolling] area '\" + (paRest || P.room.area || \"?\") + \"' isn't in the table.\", \"orange\");\n  }\n} else if (paSub === \"fire\") {\n  var paClan = get_variable(\"patrolling_clan\");\n  if (!paClan) display_notice(\"[patrolling] no clan set. PATROLLING CLAN <clan>.\", \"orange\");\n  else { send_command(\"clan switch \" + paClan); send_command(\"clt Fire at me! \" + P.room.name + \" (\" + P.room.id + \") at \" + P.room.area); }\n} else if (paSub === \"gods\") {\n  // PATROLLING GODS [FRIENDLY|HOSTILE|NEUTRAL <god>] (#164)\n  var paGw = paRest.split(/\\s+/);\n  var paSt = String(paGw[0] || \"\").toLowerCase();\n  var paGn = paGw.slice(1).join(\" \").trim().toLowerCase();\n  if (paRest === \"\") {\n    var paF = [], paH = [];\n    for (var paG in P.gods) { if (P.gods.hasOwnProperty(paG)) (P.gods[paG] === \"hostile\" ? paH : paF).push(paG.charAt(0).toUpperCase() + paG.slice(1)); }\n    display_notice(\"[patrolling] friendly: \" + (paF.length ? paF.sort().join(\", \") : \"none\") + \". hostile: \" + (paH.length ? paH.sort().join(\", \") : \"none\") + \". Every other god is neutral.\", C);\n  } else if ((paSt === \"friendly\" || paSt === \"hostile\" || paSt === \"neutral\") && paGn) {\n    if (paSt === \"neutral\") delete P.gods[paGn]; else P.gods[paGn] = paSt;\n    P.saveGods();\n    display_notice(\"[patrolling] \" + paGn.charAt(0).toUpperCase() + paGn.slice(1) + \" is now \" + paSt + \".\", \"lime\");\n  } else {\n    display_notice(\"[patrolling] usage: PATROLLING GODS [FRIENDLY|HOSTILE|NEUTRAL <god>]\", \"orange\");\n  }\n} else if (paSub === \"god\") {\n  // The old single god (before #164): it meant \"don't flag these\", which is\n  // what a friendly god is now. Kept as a spelling until patrolling 0.4.0.\n  if (paRest === \"\" || paRest.toLowerCase() === \"off\") {\n    display_notice(\"[patrolling] PATROLLING GOD is now PATROLLING GODS: PATROLLING GODS lists them, PATROLLING GODS FRIENDLY|HOSTILE|NEUTRAL <god> sets one.\", \"orange\");\n  } else {\n    P.gods[paRest.toLowerCase()] = \"friendly\";\n    P.saveGods();\n    display_notice(\"[patrolling] PATROLLING GOD is now PATROLLING GODS FRIENDLY <god>; \" + paRest.charAt(0).toUpperCase() + paRest.slice(1).toLowerCase() + \" added as friendly.\", \"lime\");\n  }\n} else if (paSub === \"clan\") {\n  if (paRest === \"\") {\n    display_notice(\"[patrolling] \" + paSub + \": \" + (get_variable(\"patrolling_\" + paSub) || \"none\") + \".\", C);\n  } else {\n    var paV = (paRest.toLowerCase() === \"off\") ? \"\" : paRest.toLowerCase();\n    set_variable(\"patrolling_\" + paSub, paV);\n    display_notice(\"[patrolling] \" + paSub + \": \" + (paV || \"none\") + \".\", \"lime\");\n  }\n} else if (paSub === \"reset\") {\n  run_function(\"patrolling_setup\", [], \"patrolling\");\n  display_notice(\"[patrolling] tables reloaded.\", \"lime\");\n} else if (paSub === \"debug\") {\n  display_notice(\"[patrolling] room=\" + JSON.stringify(P.room) + \" active=\" + P.active + \" present=\" + JSON.stringify(P.present) + \" shrines=\" + JSON.stringify(P.shrines), C);\n} else {\n  display_notice(\"[patrolling] unknown command '\" + paSub + \"'. PATROLLING HELP for commands.\", \"orange\");\n}\n"
      }
     ],
     "text": "^patrolling(?:\\s+(.*))?$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": false,
     "prefix_suffix": true
    }
   ]
  },
  {
   "type": "group",
   "name": "check",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "patrolling_check",
     "enabled": true,
     "code": "// patrolling_check -- PLANTS and INFO HERE, captured by the triggers below.\nvar P = client.loom.patrolling;\nif (get_variable(\"pauseTriggers\") != \"on\") {\n  P.present = [];\n  P.shrines = [];\n  P.active = true;\n  P.activeAt = Date.now();\n  P.gag = false;\n  send_command(\"PLANTS\", 1);\n  send_command(\"INFO HERE\", 1);\n}\n"
    },
    {
     "type": "function",
     "name": "patrolling_report",
     "enabled": true,
     "code": "var P = client.loom.patrolling;\nvar paEnv = P.room.env || \"unknown\";\n// What PLANTS found here, for the look (#166); loom redraws Here.\nP.plantsHere = { id: P.room.id, env: paEnv, present: (P.present || []).slice() };\nif (client.loom.notify) client.loom.notify(\"patrolling\");\nif (P.learn) {\n  P.learn = false;\n  display_notice('[patrolling] table entry ->  \"' + paEnv + '\": ' + JSON.stringify(P.present) + ',', \"cyan\");\n} else {\n  var paExp = P.expected[paEnv];\n  var paOut = [];\n  var paCol = \"lime\";\n  if (!paExp) {\n    paOut.push(\"no expected list for '\" + paEnv + \"' (PATROLLING LEARN prints one)\");\n    paCol = \"orange\";\n  } else {\n    var paMiss = [];\n    for (var paI = 0; paI < paExp.length; paI++) { if (P.present.indexOf(paExp[paI]) < 0) paMiss.push(paExp[paI]); }\n    if (paMiss.length) { paOut.push(\"missing \" + paMiss.join(\", \")); paCol = \"orange\"; }\n    else paOut.push(\"all present\");\n  }\n  if (P.shrines.length) { paOut.push(\"SHRINE/TOTEM: \" + P.shrines.join(\" ; \")); paCol = \"orange\"; }\n  display_notice(\"[patrolling] \" + paEnv + \": \" + paOut.join(\"  |  \"), paCol);\n}\n"
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.patrolling || !client.loom.patrolling.expected) run_function(\"patrolling_setup\", [], \"patrolling\");\nvar P = client.loom.patrolling;\nif (P.active) { P.gag = true; gag_current_line(); }\n"
      }
     ],
     "text": "growing in this room",
     "matching": "substring",
     "whole_words": false,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.patrolling || !client.loom.patrolling.expected) run_function(\"patrolling_setup\", [], \"patrolling\");\nvar P = client.loom.patrolling;\nif (P.active) { P.present.push(args[1]); gag_current_line(); }\n"
      }
     ],
     "text": "\\(([a-z]+)\\)\\s+[A-Z][a-z]+\\s*$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.patrolling || !client.loom.patrolling.expected) run_function(\"patrolling_setup\", [], \"patrolling\");\nvar P = client.loom.patrolling;\nif (P.active && P.gag && !/Number of objects/i.test(current_text())) {\n  gag_current_line();\n  // Friendly gods' shrines and totems aren't reported (#164).\n  var paIt = P.look ? P.look.item(current_text()) : null;\n  if (!paIt || paIt.stance !== \"friendly\") P.shrines.push(current_text().trim());\n}\n"
      }
     ],
     "text": "\\b(?:shrine|totem)\\b",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.patrolling || !client.loom.patrolling.expected) run_function(\"patrolling_setup\", [], \"patrolling\");\nvar P = client.loom.patrolling;\nif (P.active && P.gag && !/Number of objects/i.test(current_text())) gag_current_line();\n"
      }
     ],
     "text": "^\\S+\\s+\\S",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.patrolling || !client.loom.patrolling.expected) run_function(\"patrolling_setup\", [], \"patrolling\");\nvar P = client.loom.patrolling;\nif (P.active) { gag_current_line(); P.active = false; P.gag = false; run_function(\"patrolling_report\", [], \"patrolling\"); }\n"
      }
     ],
     "text": "Number of objects:",
