{
 "type": "group",
 "name": "waypoints",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"waypoints_setup\", [], \"waypoints\");\nrun_function(\"waypoints_render\", [], \"waypoints\");\ndisplay_notice(\"[waypoints] installed. Create a UI tab named 'Waypoints'; WAYPOINTS ADD <name> saves the room you're in. WAYPOINTS HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// The waypoints_* variables are left intact.\n// Leave LOOM and the integrations at once, not at the next load (#137).\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"waypoints\");\n  else delete client.loom.registry.waypoints;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it. A pennant.\nvar tiTabs = [[\"Waypoints\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\"><path d=\"M3.5 1.5 V15\" stroke=\"#c8bfae\" stroke-width=\"1.3\" stroke-linecap=\"round\"/><path d=\"M4.2 2 L13.5 4.6 L4.2 7.4 Z\" fill=\"#e0b46c\"/><ellipse cx=\"3.5\" cy=\"15\" rx=\"2.6\" ry=\"0.8\" fill=\"#7a5f33\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\nrun_function(\"waypoints_setup\", [], \"waypoints\");\nrun_function(\"waypoints_render\", [], \"waypoints\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Waypoints follows the room itself: the room you're in is highlighted in\n// the tab, and ADD saves it.\nif (!client.loom || !client.loom.waypoints || !client.loom.waypoints.list) run_function(\"waypoints_setup\", [], \"waypoints\");\nif (args.gmcp_method == \"Room.Info\") {\n  var wpG = (args.gmcp_args && typeof args.gmcp_args == \"object\") ? args.gmcp_args : {};\n  var WP = client.loom.waypoints;\n  WP.here = wpG.num ? { id: String(wpG.num), name: WP.roomName(wpG.name), area: String(wpG.area || \"\"), env: String(wpG.environment || \"\") } : null;\n  run_function(\"waypoints_render\", [], \"waypoints\");\n}\n"
  },
  {
   "type": "function",
   "name": "waypoints_setup",
   "enabled": true,
   "code": "// waypoints_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Waypoints (#369): rooms you save by number\n// with a name you give them (and an optional note), listed by area in the\n// Waypoints tab; a click walks you there with PATH FIND.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.waypoints) client.loom.waypoints = {};\nclient.loom.registry.waypoints = { version: \"0.1.0\", keyword: \"WAYPOINTS\", desc: \"Rooms you save by name, listed by area in a tab; a click walks you there\",\n  redraw: function () { run_function(\"waypoints_render\", [], \"waypoints\"); } };\nvar WP = client.loom.waypoints;\n\n// Saved: waypoints_list = [{ id, name, note, room, area, env, at }], where\n// room, area and env are the game's, read when the waypoint was added;\n// waypoints_folded = [area, …], the areas folded in the tab. A variable that\n// isn't readable starts afresh (#135).\nWP.readList = function (name) {\n  var v = get_variable(name);\n  if (typeof v == \"string\") { try { v = JSON.parse(v); } catch (e) { v = null; } }\n  return Array.isArray(v) ? v : [];\n};\nWP.list = [];\nvar wpRaw = WP.readList(\"waypoints_list\");\nfor (var wpI = 0; wpI < wpRaw.length; wpI++) {\n  var wpE = wpRaw[wpI];\n  if (!wpE || typeof wpE != \"object\" || !/^\\d+$/.test(String(wpE.id || \"\")) || !String(wpE.name || \"\").trim()) continue;\n  WP.list.push({ id: String(wpE.id), name: String(wpE.name).trim(), note: String(wpE.note || \"\"), room: String(wpE.room || \"\"), area: String(wpE.area || \"\"), env: String(wpE.env || \"\"), at: Number(wpE.at) || 0 });\n}\nWP.folded = {};\nvar wpF = WP.readList(\"waypoints_folded\");\nfor (var wpJ = 0; wpJ < wpF.length; wpJ++) if (typeof wpF[wpJ] == \"string\") WP.folded[wpF[wpJ]] = true;\nif (WP.here === undefined) WP.here = null;\n\nWP.save = function () {\n  if (WP.list.length) set_variable(\"waypoints_list\", JSON.stringify(WP.list)); else delete_variable(\"waypoints_list\");\n  if (client.loom.notify) client.loom.notify(\"waypoints\");\n  run_function(\"waypoints_render\", [], \"waypoints\");\n};\nWP.saveFolded = function () {\n  var out = [];\n  for (var a in WP.folded) if (WP.folded.hasOwnProperty(a) && WP.folded[a]) out.push(a);\n  if (out.length) set_variable(\"waypoints_folded\", JSON.stringify(out)); else delete_variable(\"waypoints_folded\");\n};\nWP.roomName = function (n) { return String(n || \"\").replace(/\\s*\\((?:indoors|outdoors)\\)\\s*$/i, \"\"); };\nWP.byId = function (id) {\n  for (var i = 0; i < WP.list.length; i++) if (WP.list[i].id === String(id)) return WP.list[i];\n  return null;\n};\nWP.byName = function (name) {\n  var n = String(name || \"\").trim().toLowerCase();\n  for (var i = 0; i < WP.list.length; i++) if (WP.list[i].name.toLowerCase() === n) return WP.list[i];\n  return null;\n};\n// A waypoint by its name or its room number.\nWP.find = function (q) {\n  q = String(q || \"\").trim();\n  return (/^\\d+$/.test(q) && WP.byId(q)) || WP.byName(q);\n};\n// \"<name or number> <rest>\": the longest waypoint name (or a number) the\n// text starts with, and what follows it; names can have spaces.\nWP.split = function (text) {\n  var t = String(text || \"\").trim(), tl = t.toLowerCase(), best = null;\n  for (var i = 0; i < WP.list.length; i++) {\n    var n = WP.list[i].name.toLowerCase();\n    if ((tl === n || tl.indexOf(n + \" \") === 0) && (!best || n.length > best.name.length)) best = WP.list[i];\n  }\n  if (best) return { w: best, rest: t.substring(best.name.length).trim() };\n  var m = /^(\\d+)(?:\\s+(.*))?$/.exec(t);\n  if (m && WP.byId(m[1])) return { w: WP.byId(m[1]), rest: (m[2] || \"\").trim() };\n  return null;\n};\nWP.label = function (w) { return w.name + \" (\" + w.id + \")\"; };\n\nWP.add = function (name) {\n  name = String(name || \"\").trim();\n  var H = WP.here;\n  if (!H || !H.id) { display_notice(\"[waypoints] no room yet: move or LOOK first.\", \"orange\"); return; }\n  if (!name) { display_notice(\"[waypoints] WAYPOINTS ADD <name> saves the room you're in.\", \"orange\"); return; }\n  var had = WP.byId(H.id);\n  if (had) { display_notice(\"[waypoints] this room is saved already, as \" + had.name + \". WAYPOINTS RENAME \" + had.name + \" <new name> to rename it.\", \"orange\"); return; }\n  if (/^\\d+$/.test(name)) { display_notice(\"[waypoints] give it a name, not a number: the number is the room's.\", \"orange\"); return; }\n  if (WP.byName(name)) { display_notice(\"[waypoints] \" + WP.byName(name).name + \" is taken: pick another name.\", \"orange\"); return; }\n  WP.list.push({ id: H.id, name: name, note: \"\", room: H.name, area: H.area, env: H.env, at: Date.now() });\n  WP.save();\n  display_notice(\"[waypoints] saved \" + name + \" (\" + H.id + \", \" + (H.name || \"?\") + (H.area ? \", \" + H.area : \"\") + \").\", \"lime\");\n};\nWP.remove = function (w) {\n  for (var i = 0; i < WP.list.length; i++) {\n    if (WP.list[i] === w) { WP.list.splice(i, 1); break; }\n  }\n  WP.save();\n  display_notice(\"[waypoints] removed \" + WP.label(w) + \".\", \"lime\");\n};\nWP.go = function (w) {\n  if (get_variable(\"pauseTriggers\") == \"on\") { display_notice(\"[waypoints] Loom is paused (LOOM PAUSE OFF to walk).\", \"orange\"); return; }\n  if (WP.here && WP.here.id === w.id) { display_notice(\"[waypoints] you're at \" + WP.label(w) + \" already.\", \"cyan\"); return; }\n  send_command(\"path find \" + w.id, 1);\n  display_notice(\"[waypoints] walking to \" + WP.label(w) + \".\", \"cyan\");\n};\nWP.fold = function (area) {\n  WP.folded[area] = !WP.folded[area];\n  WP.saveFolded();\n  run_function(\"waypoints_render\", [], \"waypoints\");\n};\n\n// The read-only look other packages see through loom: never its variables.\n//   look.at(id) -> { name, note } when that room is a waypoint, else undefined.\nWP.look = {\n  at: function (id) { var w = WP.byId(id); return w ? { name: w.name, note: w.note } : undefined; }\n};\n\n// The tab's clicks. Its page shares window with the scripts but can't reach\n// client.loom in every Nexus, so these closures carry them.\ntry {\n  window.loomWaypoints = {\n    go: function (id) { var w = client.loom.waypoints.byId(id); if (w) client.loom.waypoints.go(w); },\n    remove: function (id) { var w = client.loom.waypoints.byId(id); if (w) client.loom.waypoints.remove(w); },\n    fold: function (i) { var g = client.loom.waypoints.areasDrawn || []; if (g[i] !== undefined) client.loom.waypoints.fold(g[i]); },\n    // Remembered box: room's own buttons, through loom (link room-waypoints).\n    mark: function (what) {\n      var L = client.loom.loom, r = (L && L.answer) ? L.answer(\"waypoints\", \"waypoints.remembered\") : undefined;\n      if (r && typeof r[what] == \"function\") r[what]();\n    },\n    // ADD HERE: \"waypoints add \" in the input line, for the name.\n    add: function () {\n      var inp = window.loomWaypoints.input();\n      if (!inp) { display_notice(\"[waypoints] couldn't find the input line: type WAYPOINTS ADD <name>.\", \"orange\"); return; }\n      var v = \"waypoints add \";\n      try {\n        var desc = Object.getOwnPropertyDescriptor(Object.getPrototypeOf(inp), \"value\");\n        if (desc && desc.set) desc.set.call(inp, v); else inp.value = v;\n      } catch (e) { inp.value = v; }\n      try { inp.dispatchEvent(new Event(\"input\", { bubbles: true })); } catch (e) {}\n      try { inp.focus(); inp.setSelectionRange(v.length, v.length); } catch (e) {}\n    },\n    input: function () {\n      var ids = [\"userinput\", \"user_input\", \"input\", \"command_input\"];\n      for (var i = 0; i < ids.length; i++) {\n        var e = document.getElementById(ids[i]);\n        if (e && (e.tagName === \"TEXTAREA\" || e.tagName === \"INPUT\")) return e;\n      }\n      var li = window.loomWaypointsLastInput;\n      if (li && li.isConnected && li.offsetParent !== null) return li;\n      var sels = [\"textarea\", \"input[type=text], input:not([type])\"];\n      for (var s = 0; s < sels.length; s++) {\n        var all = document.querySelectorAll(sels[s]);\n        for (var j = 0; j < all.length; j++) { if (all[j].offsetParent !== null) return all[j]; }\n      }\n      return null;\n    }\n  };\n  if (!window.loomWaypointsFocus) {\n    window.loomWaypointsFocus = true;\n    document.addEventListener(\"focusin\", function (ev) {\n      var t = ev.target;\n      if (t && (t.tagName === \"TEXTAREA\" || (t.tagName === \"INPUT\" && (!t.type || t.type === \"text\")))) window.loomWaypointsLastInput = t;\n    }, true);\n  }\n} catch (e) {}\nif (client.loom.notify) client.loom.notify(\"waypoints\");\n"
  },
  {
   "type": "function",
   "name": "waypoints_render",
   "enabled": true,
   "code": "// waypoints_render -- the Waypoints tab (#369, mockup A), in the house style\n// shared with Here: ink panel, serif small-caps headings, monospace rows.\n//   - title: saved and areas counts, ⊕ ADD HERE when this room isn't saved\n//   - Remembered (room's REMEMBER, through loom's link room-waypoints),\n//     pinned in a dotted box with GO BACK; a placeholder with REMEMBER HERE\n//     when nothing is remembered\n//   - waypoints by area, the area you're in first; areas fold (remembered);\n//     two lines a row: ⚑ name and number, then the room · environment and\n//     the note; the room you're in highlighted with HERE; × on hover removes\nif (!client.loom || !client.loom.waypoints || !client.loom.waypoints.list) run_function(\"waypoints_setup\", [], \"waypoints\");\nvar WP = client.loom.waypoints;\nvar TH = (client.loom && client.loom.theme) || {};\nvar AMBER = TH.acc || \"#e0b46c\";\nvar DEEP = TH.deep || \"#7a5f33\";\nvar TXT = TH.txt || \"#e8e2d6\";\nvar MUTED = TH.muted || \"#8f877a\";\nvar DIM = TH.dim || \"#6d665b\";\nvar RULE = TH.rule || \"#2b2620\";\nvar BG = TH.bg || \"#13110e\";\nvar HI = TH.hi || \"#f0cc8c\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nvar SYM = \"'Segoe UI Symbol','DejaVu Sans',sans-serif\";\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\"); }\nfunction js(s) { return esc(String(s).replace(/\\\\/g, \"\\\\\\\\\").replace(/'/g, \"\\\\'\")); }\nfunction ago(t) {\n  var m = Math.floor((Date.now() - t) / 60000);\n  if (m < 1) return \"just now\";\n  if (m < 60) return m + \" min ago\";\n  if (m < 1440) return Math.floor(m / 60) + \" h ago\";\n  return Math.floor(m / 1440) + \" d ago\";\n}\nfunction chip(label, fn, col, border, tip) {\n  return '<span onclick=\"window.loomWaypoints&&window.loomWaypoints.' + fn + '\" title=\"' + esc(tip) + '\" style=\"flex:none;cursor:pointer;padding:0 5px;border:1px solid ' + border + ';color:' + col + ';letter-spacing:0.08em;white-space:nowrap;\">' + label + '</span>';\n}\n\nvar here = WP.here || {};\nvar hereW = here.id ? WP.byId(here.id) : null;\n\n// Group by area: the area you're in first, then the rest by name.\nvar groups = {}, order = [];\nfor (var i = 0; i < WP.list.length; i++) {\n  var a = WP.list[i].area || \"unknown area\";\n  if (!groups[a]) { groups[a] = []; order.push(a); }\n  groups[a].push(WP.list[i]);\n}\norder.sort(function (x, y) {\n  if (x === here.area) return -1;\n  if (y === here.area) return 1;\n  return x.toLowerCase() < y.toLowerCase() ? -1 : (x.toLowerCase() > y.toLowerCase() ? 1 : 0);\n});\nWP.areasDrawn = order.slice();\n\nvar html = '<div id=\"loom-waypoints\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + BG + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;min-height:100%;box-sizing:border-box;display:flex;flex-direction:column;\">';\n\n// Title.\nvar count = WP.list.length + ' saved' + (order.length ? ' &middot; ' + order.length + (order.length === 1 ? ' area' : ' areas') : '');\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\nhtml += '<span style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:2px;font-size:15px;color:' + AMBER + ';\">Waypoints</span>';\nhtml += '<span style=\"display:flex;align-items:baseline;gap:8px;\"><span style=\"color:' + MUTED + ';\">' + count + '</span>';\nif (here.id && !hereW) html += chip('&#8853; ADD HERE', 'add()', MUTED, DEEP, 'save the room you\\'re in: type its name after WAYPOINTS ADD');\nhtml += '</span></div>';\n\n// Remembered (room's REMEMBER), through loom.\nvar L = client.loom.loom;\nvar rem = (L && L.answer) ? L.answer(\"waypoints\", \"waypoints.remembered\") : undefined;\nif (rem && rem.id) {\n  var remHere = here.id === rem.id;\n  var sub = [rem.name, rem.area, rem.at ? ago(rem.at) : \"\"].filter(function (s) { return s; }).map(esc).join(' &middot; ');\n  html += '<div style=\"margin-top:6px;padding:4px 6px;border:1px dotted ' + DEEP + ';display:flex;gap:8px;align-items:center;\">';\n  html += '<div style=\"flex:1 1 auto;min-width:0;\"><div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;\">';\n  html += '<span style=\"font-family:' + SERIF + ';font-size:14px;color:' + TXT + ';\"><span style=\"font-family:' + SYM + ';color:' + AMBER + ';margin-right:4px;\">&#8630;</span>Remembered</span>';\n  html += '<span style=\"color:' + (remHere ? AMBER : MUTED) + ';letter-spacing:' + (remHere ? '0.08em' : '0') + ';\">' + (remHere ? 'HERE &middot; ' : '') + esc(rem.id) + '</span></div>';\n  html += '<div style=\"font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + MUTED + ';\">' + sub + '</div></div>';\n  html += remHere ? chip('FORGET', \"mark('forget')\", DIM, DEEP, 'forget the remembered room') : chip('GO BACK', \"mark('back')\", AMBER, AMBER, 'walk back to ' + rem.name + ' (PATH FIND)');\n  html += '</div>';\n} else if (rem && here.id) {\n  html += '<div onclick=\"window.loomWaypoints&&window.loomWaypoints.mark(\\'remember\\')\" title=\"remember the room you\\'re in (as REMEMBER in Here)\" style=\"cursor:pointer;margin-top:6px;padding:4px 6px;border:1px dashed ' + RULE + ';display:flex;gap:8px;align-items:center;\">';\n  html += '<span style=\"flex:1 1 auto;min-width:0;font-family:' + SERIF + ';font-size:14px;color:' + MUTED + ';\"><span style=\"font-family:' + SYM + ';color:' + DIM + ';margin-right:4px;\">&#8630;</span>Nothing remembered</span>';\n  html += '<span style=\"flex:none;padding:0 5px;border:1px solid ' + DEEP + ';color:' + MUTED + ';letter-spacing:0.08em;white-space:nowrap;\">REMEMBER HERE</span></div>';\n}\n\n// The waypoints, by area.\nfor (var g = 0; g < order.length; g++) {\n  var area = order[g], ws = groups[area], folded = !!WP.folded[area];\n  var names = \"\";\n  if (folded) {\n    var nl = [];\n    for (var f = 0; f < ws.length; f++) nl.push(esc(ws[f].name));\n    names = ' <span style=\"color:' + DIM + ';font-variant:normal;letter-spacing:0;font-style:italic;\">&middot; ' + nl.join(', ') + '</span>';\n  }\n  html += '<div onclick=\"window.loomWaypoints&&window.loomWaypoints.fold(' + g + ')\" title=\"click to ' + (folded ? 'unfold' : 'fold') + '\" style=\"cursor:pointer;font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;font-size:11px;color:' + AMBER + ';margin:8px 0 2px;border-top:1px solid ' + RULE + ';padding-top:5px;\">';\n  html += '<span style=\"font-family:' + SYM + ';display:inline-block;width:12px;color:' + MUTED + ';\">' + (folded ? '&#9656;' : '&#9662;') + '</span>' + esc(area.toLowerCase()) + ' <span style=\"color:' + MUTED + ';\">' + ws.length + '</span>' + names + '</div>';\n  if (folded) continue;\n  for (var k = 0; k < ws.length; k++) {\n    var w = ws[k], isHere = here.id === w.id;\n    var tip = isHere ? \"you're here\" : \"walk to \" + w.name + \" (PATH FIND \" + w.id + \")\";\n    html += '<div class=\"loom-wp-row\" onclick=\"window.loomWaypoints&&window.loomWaypoints.go(\\'' + js(w.id) + '\\')\" title=\"' + esc(tip) + '\" style=\"cursor:pointer;padding:3px 4px;border-bottom:1px dotted ' + RULE + ';' + (isHere ? 'background:rgba(224,180,108,0.08);' : '') + '\">';\n    html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;\">';\n    html += '<span style=\"min-width:0;font-family:' + SERIF + ';font-size:14px;color:' + (isHere ? AMBER : TXT) + ';\"><span style=\"font-family:' + SYM + ';color:' + (isHere ? AMBER : DEEP) + ';margin-right:4px;\">&#9873;</span>' + esc(w.name) + '</span>';\n    html += '<span style=\"flex:none;white-space:nowrap;color:' + (isHere ? AMBER : MUTED) + ';' + (isHere ? 'letter-spacing:0.08em;' : '') + '\">' + (isHere ? 'HERE &middot; ' : '') + esc(w.id);\n    html += '<span class=\"loom-wp-x\" onclick=\"event.stopPropagation();window.loomWaypoints&&window.loomWaypoints.remove(\\'' + js(w.id) + '\\')\" title=\"remove ' + esc(w.name) + '\" style=\"cursor:pointer;margin-left:6px;color:#ff9a4c;\">&times;</span></span></div>';\n    var line2 = [w.room, (w.env || \"\").toLowerCase()].filter(function (s) { return s; }).map(esc).join(' &middot; ');\n    html += '<div style=\"font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + MUTED + ';padding-left:17px;\">' + line2 + (w.note ? ' <span style=\"color:' + DIM + ';\">&mdash; ' + esc(w.note) + '</span>' : '') + '</div>';\n    html += '</div>';\n  }\n}\nif (!WP.list.length) {\n  html += '<div style=\"margin-top:8px;font-family:' + SERIF + ';font-style:italic;font-size:12px;color:' + MUTED + ';\">No waypoints yet.</div>';\n}\nhtml += '<div style=\"margin-top:auto;padding-top:6px;font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + MUTED + ';\">Click a waypoint to walk there; click an area to fold it. WAYPOINTS ADD &lt;name&gt; saves the room you\\'re in.</div>';\nhtml += '</div>';\n\n// The whole tab in the panel's colour (#355); the × shows on a row's hover.\ntry {\n  var wpSt = document.getElementById(\"loom-waypoints-style\");\n  if (!wpSt) { wpSt = document.createElement(\"style\"); wpSt.id = \"loom-waypoints-style\"; document.head.appendChild(wpSt); }\n  var wpCss = '.flexlayout__tab:has(#loom-waypoints) { background: ' + BG + ' !important; } .flexlayout__tab:has(#loom-waypoints) > * { min-height: 100%; } ' +\n    '#loom-waypoints .loom-wp-x { visibility: hidden; } #loom-waypoints .loom-wp-row:hover .loom-wp-x { visibility: visible; } #loom-waypoints .loom-wp-row:hover { background: rgba(224,180,108,0.05); }';\n  if (wpSt.textContent !== wpCss) wpSt.textContent = wpCss;\n} catch (e) {}\ntry { set_custom_tab_html(\"Waypoints\", html); } catch (e) {}\n"
  },
  {
   "type": "function",
   "name": "waypoints_help",
   "enabled": true,
   "code": "// waypoints_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[waypoints] rooms you save by name, one click away in the Waypoints tab. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"WAYPOINTS\", \"status: how many saved, and whether this room is one\"],\n  [\"WAYPOINTS LIST\", \"every waypoint, by area\"],\n  [\"WAYPOINTS ADD <name>\", \"save the room you're in (also ADD HERE in the tab)\"],\n  [\"WAYPOINTS REMOVE <name|number>\", \"forget one (also the × on its row in the tab)\"],\n  [\"WAYPOINTS RENAME <name|number> <new name>\", \"give it another name\"],\n  [\"WAYPOINTS NOTE <name|number> <text>\", \"a note under it in the tab; no text clears it\"],\n  [\"WAYPOINTS GO <name|number>\", \"walk there (PATH FIND), as a click in the tab\"],\n  [\"WAYPOINTS RESET\", \"reload saved waypoints, redraw the tab\"],\n  [\"WAYPOINTS DEBUG\", \"internal state\"],\n  [\"The tab is a custom tab named Waypoints. Click an area to fold it.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "Waypoints control",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// WAYPOINTS [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.waypoints || !client.loom.waypoints.list) run_function(\"waypoints_setup\", [], \"waypoints\");\nvar WP = client.loom.waypoints;\nvar wpRaw = String(args[1] || \"\").trim();\nvar wpSp = wpRaw.search(/\\s/);\nvar wpCmd = (wpSp < 0 ? wpRaw : wpRaw.substring(0, wpSp)).toLowerCase();\nvar wpRest = wpSp < 0 ? \"\" : wpRaw.substring(wpSp).trim();\nvar wpW;\nif (wpCmd === \"\" || wpCmd === \"status\") {\n  var wpAreas = {}, wpNA = 0;\n  for (var wpI = 0; wpI < WP.list.length; wpI++) { var wpA = WP.list[wpI].area || \"?\"; if (!wpAreas[wpA]) { wpAreas[wpA] = 1; wpNA++; } }\n  var wpH = WP.here && WP.byId(WP.here.id);\n  display_notice(\"[waypoints] \" + WP.list.length + \" saved in \" + wpNA + (wpNA === 1 ? \" area\" : \" areas\") + \". Here: \" + (wpH ? wpH.name : (WP.here ? \"not saved (WAYPOINTS ADD <name>)\" : \"no room yet\")) + \". WAYPOINTS LIST, WAYPOINTS HELP.\", \"cyan\");\n} else if (wpCmd === \"help\") {\n  run_function(\"waypoints_help\", [], \"waypoints\");\n} else if (wpCmd === \"list\") {\n  if (!WP.list.length) display_notice(\"[waypoints] none saved yet: WAYPOINTS ADD <name> saves the room you're in.\", \"cyan\");\n  var wpBy = {}, wpOrd = [];\n  for (var wpJ = 0; wpJ < WP.list.length; wpJ++) { var wpB = WP.list[wpJ].area || \"unknown area\"; if (!wpBy[wpB]) { wpBy[wpB] = []; wpOrd.push(wpB); } wpBy[wpB].push(WP.list[wpJ]); }\n  wpOrd.sort();\n  for (var wpK = 0; wpK < wpOrd.length; wpK++) {\n    display_notice(\"[waypoints] \" + wpOrd[wpK] + \":\", \"cyan\");\n    for (var wpL = 0; wpL < wpBy[wpOrd[wpK]].length; wpL++) {\n      var wpX = wpBy[wpOrd[wpK]][wpL];\n      display_notice(\"  \" + wpX.name + \" (\" + wpX.id + \") \" + (wpX.room || \"\") + (wpX.note ? \" - \" + wpX.note : \"\"), \"cyan\");\n    }\n  }\n} else if (wpCmd === \"add\") {\n  WP.add(wpRest);\n} else if (wpCmd === \"remove\" || wpCmd === \"del\") {\n  wpW = WP.find(wpRest);\n  if (wpW) WP.remove(wpW);\n  else display_notice(\"[waypoints] no waypoint '\" + wpRest + \"'. WAYPOINTS REMOVE <name|number>.\", \"orange\");\n} else if (wpCmd === \"rename\") {\n  var wpS = WP.split(wpRest);\n  if (!wpS || !wpS.rest) display_notice(\"[waypoints] WAYPOINTS RENAME <name|number> <new name>.\", \"orange\");\n  else if (/^\\d+$/.test(wpS.rest)) display_notice(\"[waypoints] give it a name, not a number.\", \"orange\");\n  else if (WP.byName(wpS.rest) && WP.byName(wpS.rest) !== wpS.w) display_notice(\"[waypoints] \" + wpS.rest + \" is taken: pick another name.\", \"orange\");\n  else { var wpOld = wpS.w.name; wpS.w.name = wpS.rest; WP.save(); display_notice(\"[waypoints] \" + wpOld + \" is now \" + wpS.w.name + \".\", \"lime\"); }\n} else if (wpCmd === \"note\") {\n  var wpN = WP.split(wpRest);\n  if (!wpN) display_notice(\"[waypoints] WAYPOINTS NOTE <name|number> <text>; no text clears the note.\", \"orange\");\n  else { wpN.w.note = wpN.rest; WP.save(); display_notice(wpN.rest ? \"[waypoints] note on \" + wpN.w.name + \": \" + wpN.rest + \".\" : \"[waypoints] note on \" + wpN.w.name + \" cleared.\", \"lime\"); }\n} else if (wpCmd === \"go\") {\n  wpW = WP.find(wpRest);\n  if (wpW) WP.go(wpW);\n  else display_notice(\"[waypoints] no waypoint '\" + wpRest + \"'. WAYPOINTS GO <name|number>.\", \"orange\");\n} else if (wpCmd === \"reset\") {\n  run_function(\"waypoints_setup\", [], \"waypoints\");\n  run_function(\"waypoints_render\", [], \"waypoints\");\n  display_notice(\"[waypoints] reset: saved waypoints reloaded, tab redrawn.\", \"lime\");\n} else if (wpCmd === \"debug\") {\n  display_notice(\"[waypoints] here=\" + JSON.stringify(WP.here) + \" saved=\" + WP.list.length + \" folded=\" + JSON.stringify(Object.keys(WP.folded).filter(function (a) { return WP.folded[a]; })), \"cyan\");\n} else {\n  display_notice(\"[waypoints] unknown command '\" + wpCmd + \"'. WAYPOINTS HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^waypoints(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  }
 ],
 "description": "Rooms you save by name, listed by area in a tab; a click walks you there"
}