{
 "type": "group",
 "name": "ledger",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"ledger_setup\", [], \"ledger\");\nrun_function(\"ledger_render\", [], \"ledger\");\ndisplay_notice(\"[ledger] installed. Create a UI tab named 'Ledger' for the calendar. LEDGER HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; the ledger_* variables are left intact.\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"Ledger\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 17\"><path d=\"M14.5 1 C9 2.5 5.5 6.5 3.5 12.5 L5 12.8 C7 8 10 4.5 14.5 1 Z\" fill=\"#e6d5ac\"/><path d=\"M14.5 1 C10.5 4 7.5 8 5 12.8\" fill=\"none\" stroke=\"#8b6b47\" stroke-width=\"0.7\"/><path d=\"M3.5 12.5 L2.2 15.8\" stroke=\"#e6d5ac\" stroke-width=\"1.1\"/><circle cx=\"2\" cy=\"16\" r=\"0.9\" fill=\"#d0604c\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\n\n// Set up, then ask the game for the date; the digest prints once it answers.\nrun_function(\"ledger_setup\", [], \"ledger\");\nclient.loom.ledger.pendingDigest = true;\nrun_function(\"ledger_render\", [], \"ledger\");\nrun_function(\"ledger_sync\", [], \"ledger\");\n"
  },
  {
   "type": "function",
   "name": "ledger_setup",
   "enabled": true,
   "code": "/*loom-hot ledger f:ledger_setup 656ca755a0*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"ledger\"];\nif (!lhH || lhH.v !== \"656ca755a0\") { run_function(\"ledger__hot\", [], \"ledger\"); lhH = client.loom.__hot[\"ledger\"]; }\nlhH.f[\"f:ledger_setup\"](args);"
  },
  {
   "type": "function",
   "name": "ledger_sync",
   "enabled": true,
   "code": "// ledger_sync -- ask the game for the date. Suppressed while triggers are\n// paused, because that is the one thing that must not reach the server. An\n// unset pauseTriggers (no loom package) counts as off.\nif (!client.loom || !client.loom.ledger || !client.loom.ledger.months) run_function(\"ledger_setup\", [], \"ledger\");\nvar pause = get_variable(\"pauseTriggers\");\nif (pause !== \"on\") {\n  client.loom.ledger.armed = true;\n  send_command(\"date\");\n} else {\n  if (client.loom.ledger.debug) { display_notice(\"[ledger] sync skipped - triggers paused\", \"orange\"); }\n}\n"
  },
  {
   "type": "function",
   "name": "ledger_check",
   "enabled": true,
   "code": "/*loom-hot ledger f:ledger_check 656ca755a0*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"ledger\"];\nif (!lhH || lhH.v !== \"656ca755a0\") { run_function(\"ledger__hot\", [], \"ledger\"); lhH = client.loom.__hot[\"ledger\"]; }\nlhH.f[\"f:ledger_check\"](args);"
  },
  {
   "type": "function",
   "name": "ledger_digest",
   "enabled": true,
   "code": "/*loom-hot ledger f:ledger_digest 656ca755a0*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"ledger\"];\nif (!lhH || lhH.v !== \"656ca755a0\") { run_function(\"ledger__hot\", [], \"ledger\"); lhH = client.loom.__hot[\"ledger\"]; }\nlhH.f[\"f:ledger_digest\"](args);"
  },
  {
   "type": "function",
   "name": "ledger_render",
   "enabled": true,
   "code": "/*loom-hot ledger f:ledger_render 656ca755a0*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"ledger\"];\nif (!lhH || lhH.v !== \"656ca755a0\") { run_function(\"ledger__hot\", [], \"ledger\"); lhH = client.loom.__hot[\"ledger\"]; }\nlhH.f[\"f:ledger_render\"](args);"
  },
  {
   "type": "function",
   "name": "ledger_help",
   "enabled": true,
   "code": "/*loom-hot ledger f:ledger_help 656ca755a0*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"ledger\"];\nif (!lhH || lhH.v !== \"656ca755a0\") { run_function(\"ledger__hot\", [], \"ledger\"); lhH = client.loom.__hot[\"ledger\"]; }\nlhH.f[\"f:ledger_help\"](args);"
  },
  {
   "type": "trigger",
   "name": "ledger date line",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "/*loom-hot ledger s:1 656ca755a0*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"ledger\"];\nif (!lhH || lhH.v !== \"656ca755a0\") { run_function(\"ledger__hot\", [], \"ledger\"); lhH = client.loom.__hot[\"ledger\"]; }\nlhH.f[\"s:1\"](args);"
    }
   ],
   "text": "^(?:It is now|Today is) the (\\d+)(?:st|nd|rd|th) of (\\w+), (\\d+) years after",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "ledger date echo",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Echoed command. Only ever gagged between asking for the date and getting it.\nif (client.loom && client.loom.ledger && client.loom.ledger.armed) { gag_current_line(); }"
    }
   ],
   "text": "^date$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "ledger date block",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Only inside a confirmed DATE block, so a stray \"It is raining.\" is never eaten.\nif (client.loom && client.loom.ledger && client.loom.ledger.inBlock) { gag_current_line(); }"
    }
   ],
   "text": "^It is [a-z\\- ]+\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "ledger date block end",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Known last line of the DATE block - this is what closes the capture.\nif (client.loom && client.loom.ledger && client.loom.ledger.inBlock) {\n  gag_current_line();\n  client.loom.ledger.inBlock = false;\n}\n"
    }
   ],
   "text": "^In your world it is ",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "alias",
   "name": "ledger",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "/*loom-hot ledger s:5 656ca755a0*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"ledger\"];\nif (!lhH || lhH.v !== \"656ca755a0\") { run_function(\"ledger__hot\", [], \"ledger\"); lhH = client.loom.__hot[\"ledger\"]; }\nlhH.f[\"s:5\"](args);"
    }
   ],
   "text": "^ledger(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "function",
   "name": "ledger__hot",
   "enabled": true,
   "code": "// ledger__hot -- generated by tools/build.py (#136). The bodies of this package's\n// longer scripts, made once per load; each script in the package is a stub\n// that calls its body here. Edit the source in packages/ledger/, never this.\nif (!client.loom) client.loom = {};\nif (!client.loom.__hot) client.loom.__hot = {};\nvar lhP = client.loom.__hot[\"ledger\"] = { v: \"656ca755a0\", f: {} };\nlhP.f[\"f:ledger_setup\"] = function (args) {\n//@hot-begin f:ledger_setup\n// ledger_setup -- run from onLoad and onInstall, by LEDGER REBUILD (which\n// empties the namespace first), and by any reflex that finds the namespace\n// missing. Namespace, registry, one-time migration of the lg_* variables and\n// the old client.lg, then the state, each part built if missing.\n//\n// Publishes client.loom.ledger.day: today's Achaean day number (year * 300 +\n// month * 25 + day, months from 0), 0 while unknown. patrolling and\n// standings read it when ledger is installed.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.ledger) client.loom.ledger = {};\nclient.loom.registry.ledger = { version: \"0.3.5\", keyword: \"LEDGER\", desc: \"Reminders and standing items on the Achaean calendar\",\n  // Redrawn by loom when the tab theme changes (#310).\n  redraw: function () { run_function(\"ledger_render\", [], \"ledger\"); } };\nvar LG = client.loom.ledger;\n\n// One-time migration: lg_* -> ledger_*. A new variable that already holds\n// data wins; the old one is deleted either way.\nvar lgMoves = [[\"items\", \"[]\"], [\"seq\", \"0\"], [\"day\", \"\"], [\"debug\", \"\"]];\nfor (var lgI = 0; lgI < lgMoves.length; lgI++) {\n  var lgOld;\n  try { lgOld = get_variable(\"lg_\" + lgMoves[lgI][0]); } catch (e) { lgOld = undefined; }\n  if (lgOld !== undefined && lgOld !== null) {\n    var lgNew;\n    try { lgNew = get_variable(\"ledger_\" + lgMoves[lgI][0]); } catch (e) { lgNew = undefined; }\n    if (lgNew === undefined || lgNew === null || (\"\" + lgNew) === \"\" || (\"\" + lgNew) === lgMoves[lgI][1]) set_variable(\"ledger_\" + lgMoves[lgI][0], lgOld);\n    delete_variable(\"lg_\" + lgMoves[lgI][0]);\n  }\n}\n// Fresh profile: the stores start empty (never clobbered on a reimport).\nvar lgHave;\ntry { lgHave = get_variable(\"ledger_items\"); } catch (e) { lgHave = undefined; }\nif (lgHave === undefined || lgHave === null || (\"\" + lgHave) === \"\") { set_variable(\"ledger_items\", \"[]\"); set_variable(\"ledger_seq\", \"0\"); }\n\n// The old package kept its state in client.lg. On a reimport without a page\n// reload, what is in memory carries over.\nif (client.lg) {\n  var lgCarry = [\"day\", \"armed\", \"inBlock\", \"pendingDigest\", \"debug\"];\n  for (var lgJ = 0; lgJ < lgCarry.length; lgJ++) {\n    if (LG[lgCarry[lgJ]] === undefined && client.lg[lgCarry[lgJ]] !== undefined) LG[lgCarry[lgJ]] = client.lg[lgCarry[lgJ]];\n  }\n}\ntry { delete client.lg; } catch (e) { client.lg = undefined; }\n\nLG.months = [\"Sarapin\", \"Daedalan\", \"Aeguary\", \"Miraman\", \"Scarlatan\", \"Ero\", \"Valnuary\", \"Lupar\", \"Phaestian\", \"Chronos\", \"Glacian\", \"Mayan\"];\nif (LG.day === undefined) {\n  LG.day = 0;\n  var lgStored;\n  try { lgStored = get_variable(\"ledger_day\"); } catch (e) { lgStored = undefined; }\n  if (lgStored && (\"\" + lgStored).length) LG.day = parseInt(lgStored, 10) || 0;\n}\n// ord(12) -> \"12th\": days are shown the way the game writes them.\nLG.ord = function (n) {\n  var t = n % 100;\n  if (t >= 11 && t <= 13) return n + \"th\";\n  return n + ([\"th\", \"st\", \"nd\", \"rd\"][n % 10] || \"th\");\n};\nif (LG.armed === undefined) LG.armed = false;\nif (LG.inBlock === undefined) LG.inBlock = false;\nif (LG.pendingDigest === undefined) LG.pendingDigest = false;\nif (LG.debug === undefined) LG.debug = (get_variable(\"ledger_debug\") === \"1\");\nif (LG.debug) display_notice(\"[ledger] set up (day \" + LG.day + \")\", \"cyan\");\n\n// The entry point other packages feed (#34), through loom's integrations.\n// Their items appear in the ledger straight away (reminders, not\n// judgements), marked with their source, and are theirs to update and take\n// back: each is keyed by source + key, so an integration only ever touches\n// its own items, never the player's. Defined on every run, so a reimport\n// replaces it.\n//   entry.upsert({ source, key, text, due, dueIn }) -> the item's number,\n//     or 0 when not added. due is an Achaean day number (as LG.day), dueIn\n//     days from today; neither = a standing item. An existing item for that\n//     source and key is updated quietly (its due notice re-armed if the date\n//     moved); a new one is announced.\n//   entry.withdraw(source[, key]) -> how many items were taken back; for a\n//     condition that cleared, or a link switched off.\n// The player may DONE or DROP a generated item: it then stays away\n// (ledger_dismissed) until its source withdraws it, i.e. until its\n// condition clears; if the condition comes back, so does the item.\nLG.dismissed = {};\ntry { LG.dismissed = JSON.parse(get_variable(\"ledger_dismissed\") || \"{}\") || {}; } catch (e) { LG.dismissed = {}; }\nLG.saveDismissed = function () {\n  var any = false;\n  for (var k in LG.dismissed) { if (LG.dismissed.hasOwnProperty(k)) { any = true; break; } }\n  if (any) set_variable(\"ledger_dismissed\", JSON.stringify(LG.dismissed));\n  else delete_variable(\"ledger_dismissed\");\n};\nLG.entry = {\n  upsert: function (it) {\n    if (!it || !it.source || it.key === undefined || it.key === null || !it.text) return 0;\n    var src = String(it.source), key = String(it.key);\n    if (LG.dismissed[src + \"|\" + key]) return 0;\n    var items;\n    try { items = JSON.parse(get_variable(\"ledger_items\")) || []; } catch (e) { items = []; }\n    var today = LG.day;\n    var due = null;\n    if (it.due) due = parseInt(it.due, 10) || null;\n    else if (it.dueIn !== undefined && it.dueIn !== null && today > 0) due = today + (parseInt(it.dueIn, 10) || 0);\n    for (var i = 0; i < items.length; i++) {\n      if (items[i].source === src && items[i].key === key) {\n        var moved = items[i].due !== due;\n        items[i].text = String(it.text);\n        items[i].due = due;\n        if (moved) items[i].notified = false;\n        set_variable(\"ledger_items\", JSON.stringify(items));\n        run_function(\"ledger_check\", [], \"ledger\");\n        return items[i].id;\n      }\n    }\n    var seq = parseInt(get_variable(\"ledger_seq\") || \"0\", 10) + 1;\n    items.push({ id: seq, text: String(it.text), source: src, key: key, status: \"open\", created: today, touched: today, due: due, repeat: null, tag: null, link: null, notified: false });\n    set_variable(\"ledger_items\", JSON.stringify(items));\n    set_variable(\"ledger_seq\", \"\" + seq);\n    display_notice(\"[ledger] #\" + seq + \" from \" + src + \": \" + it.text, \"cyan\");\n    run_function(\"ledger_check\", [], \"ledger\");\n    return seq;\n  },\n  // entry.get(source, key) -> a copy of that source's item, or null; so an\n  // integration can tell whether its reminder is already standing.\n  get: function (source, key) {\n    var items;\n    try { items = JSON.parse(get_variable(\"ledger_items\")) || []; } catch (e) { items = []; }\n    for (var i = 0; i < items.length; i++) { if (items[i].source === String(source) && items[i].key === String(key)) return JSON.parse(JSON.stringify(items[i])); }\n    return null;\n  },\n  withdraw: function (source, key) {\n    if (!source) return 0;\n    var src = String(source), k = (key === undefined || key === null) ? null : String(key);\n    var items;\n    try { items = JSON.parse(get_variable(\"ledger_items\")) || []; } catch (e) { items = []; }\n    var n = 0, last = null;\n    for (var i = items.length - 1; i >= 0; i--) {\n      if (items[i].source === src && (k === null || items[i].key === k)) { last = items[i]; items.splice(i, 1); n++; }\n    }\n    // Its condition cleared: a dismissal of it is over, so it can come back.\n    var dropped = false;\n    for (var dk in LG.dismissed) {\n      if (LG.dismissed.hasOwnProperty(dk) && (k === null ? dk.indexOf(src + \"|\") === 0 : dk === src + \"|\" + k)) { delete LG.dismissed[dk]; dropped = true; }\n    }\n    if (dropped) LG.saveDismissed();\n    if (n) {\n      set_variable(\"ledger_items\", JSON.stringify(items));\n      display_notice(\"[ledger] \" + src + \" took back \" + (n === 1 ? \"#\" + last.id + \": \" + last.text : n + \" items\"), \"cyan\");\n      run_function(\"ledger_render\", [], \"ledger\");\n    }\n    return n;\n  }\n};\n\n// The read-only look other packages see through loom (#197): never its\n// variables. Defined on every run.\n//   look.about(name) -> the open items whose text names that person, as a\n//     capitalised whole word (\"pay back Ana 5k\" names Ana, \"banana\" and\n//     \"ana\" don't), most urgent first: [{ id, text, due, state, when }].\n//     state is \"overdue\", \"soon\" (due today or within 5 days, as the tab\n//     marks it), \"later\" or \"standing\" (no date); when is how the ledger\n//     says it (\"overdue 2d\", \"today\", \"in 1mo 3d\", \"\" for standing).\nLG.soonDays = 5;\nLG.span = function (d) { var m = Math.floor(d / 25), r = d % 25; return ((m ? m + \"mo \" : \"\") + (r || !m ? r + \"d\" : \"\")).trim(); };\nLG.look = {\n  about: function (name) {\n    name = String(name || \"\").trim();\n    if (!/^[A-Za-z]+$/.test(name)) return [];\n    name = name.charAt(0).toUpperCase() + name.slice(1).toLowerCase();\n    var re = new RegExp(\"(^|[^A-Za-z])\" + name + \"(?![A-Za-z])\");\n    var items;\n    try { items = JSON.parse(get_variable(\"ledger_items\")) || []; } catch (e) { items = []; }\n    var today = LG.day, out = [];\n    for (var i = 0; i < items.length; i++) {\n      var it = items[i];\n      if (it.status && it.status !== \"open\") continue;\n      if (!re.test(String(it.text || \"\"))) continue;\n      var st = \"standing\", when = \"\";\n      if (it.due) {\n        var diff = today > 0 ? it.due - today : null;\n        if (diff === null) { st = \"later\"; }\n        else if (diff < 0) { st = \"overdue\"; when = \"overdue \" + LG.span(-diff); }\n        else if (diff === 0) { st = \"soon\"; when = \"today\"; }\n        else { st = diff <= LG.soonDays ? \"soon\" : \"later\"; when = \"in \" + LG.span(diff); }\n      }\n      out.push({ id: it.id, text: String(it.text), due: it.due || null, state: st, when: when });\n    }\n    var rank = { overdue: 0, soon: 1, later: 2, standing: 3 };\n    out.sort(function (a, b) { return (rank[a.state] - rank[b.state]) || ((a.due || 0) - (b.due || 0)) || (a.id - b.id); });\n    return out;\n  }\n};\n\n//@hot-end f:ledger_setup\n};\nlhP.f[\"f:ledger_check\"] = function (args) {\n//@hot-begin f:ledger_check\n// ledger_check -- fire notices for anything now due, then refresh the tab.\nif (!client.loom || !client.loom.ledger || !client.loom.ledger.months) run_function(\"ledger_setup\", [], \"ledger\");\nvar items = [];\ntry { items = JSON.parse(get_variable(\"ledger_items\")) || []; } catch (e) { items = []; }\nvar today = client.loom.ledger.day;\nvar dirty = false;\nvar i;\nfor (i = 0; i < items.length; i++) {\n  if (items[i].due && items[i].due <= today && !items[i].notified) {\n    items[i].notified = true;\n    dirty = true;\n    display_notice(\"[ledger] #\" + items[i].id + \" due - \" + items[i].text + (items[i].source && items[i].source !== \"manual\" ? \" (\" + items[i].source + \")\" : \"\"), \"orange\");\n  }\n}\nif (dirty) { set_variable(\"ledger_items\", JSON.stringify(items)); }\nrun_function(\"ledger_render\", [], \"ledger\");\nif (client.loom.ledger.pendingDigest) {\n  client.loom.ledger.pendingDigest = false;\n  run_function(\"ledger_digest\", [], \"ledger\");\n}\n\n//@hot-end f:ledger_check\n};\nlhP.f[\"f:ledger_digest\"] = function (args) {\n//@hot-begin f:ledger_digest\n// ledger_digest -- on-demand / login summary printed to the main window.\nif (!client.loom || !client.loom.ledger || !client.loom.ledger.months) run_function(\"ledger_setup\", [], \"ledger\");\nvar items = [];\ntry { items = JSON.parse(get_variable(\"ledger_items\")) || []; } catch (e) { items = []; }\nvar today = client.loom.ledger.day;\n\nvar n = today - 1;\nvar yy = Math.floor(n / 300);\nvar rem = n - yy * 300;\nvar mi = Math.floor(rem / 25);\nvar dd = (rem % 25) + 1;\nvar stamp = today > 0 ? (client.loom.ledger.ord(dd) + \" \" + client.loom.ledger.months[mi] + \" \" + yy) : \"date unknown\";\ndisplay_notice(\"[ledger] \" + stamp, \"cyan\");\n\nvar dated = [];\nvar standing = [];\nvar i;\nfor (i = 0; i < items.length; i++) {\n  if (items[i].due) { dated.push(items[i]); } else { standing.push(items[i]); }\n}\n\nvar j, cur;\nfor (i = 1; i < dated.length; i++) {\n  cur = dated[i]; j = i - 1;\n  while (j >= 0 && dated[j].due > cur.due) { dated[j + 1] = dated[j]; j--; }\n  dated[j + 1] = cur;\n}\nfor (i = 1; i < standing.length; i++) {\n  cur = standing[i]; j = i - 1;\n  while (j >= 0 && standing[j].touched > cur.touched) { standing[j + 1] = standing[j]; j--; }\n  standing[j + 1] = cur;\n}\n\nvar shown = 0;\nfor (i = 0; i < dated.length; i++) {\n  var diff = dated[i].due - today;\n  var mag = diff < 0 ? -diff : diff;\n  var mm = Math.floor(mag / 25);\n  var ddiff = mag % 25;\n  var rel = \"\";\n  if (mm > 0) { rel = mm + (mm == 1 ? \" month\" : \" months\"); }\n  if (ddiff > 0) { rel = rel + (rel.length ? \", \" : \"\") + ddiff + (ddiff == 1 ? \" day\" : \" days\"); }\n  if (!rel.length) { rel = \"today\"; }\n  if (diff < 0) {\n    display_notice(\"[ledger] #\" + dated[i].id + \" OVERDUE by \" + rel + \" - \" + dated[i].text + (dated[i].source && dated[i].source !== \"manual\" ? \" (\" + dated[i].source + \")\" : \"\"), \"orange\");\n    shown++;\n  } else if (shown < 5) {\n    var lead = (diff === 0) ? \"today\" : (\"in \" + rel);\n    display_notice(\"[ledger] #\" + dated[i].id + \" \" + lead + \" - \" + dated[i].text + (dated[i].source && dated[i].source !== \"manual\" ? \" (\" + dated[i].source + \")\" : \"\"), \"cyan\");\n    shown++;\n  }\n}\nif (dated.length === 0) { display_notice(\"[ledger] nothing on the calendar\", \"cyan\"); }\n\nif (standing.length > 0) {\n  display_notice(\"[ledger] \" + standing.length + \" standing - oldest: #\" + standing[0].id + \" \" + standing[0].text, \"cyan\");\n}\n\n//@hot-end f:ledger_digest\n};\nlhP.f[\"f:ledger_render\"] = function (args) {\n//@hot-begin f:ledger_render\n// ledger_render -- rebuild the 'Ledger' custom tab in the house style shared with Coffers and\n// Level: ink panel, serif small-caps headings, one large figure (here the\n// Achaean date), monospace ledger rows. Accents are parchment, sepia ink and\n// sealing-wax red for anything overdue.\nif (!client.loom || !client.loom.ledger || !client.loom.ledger.months) run_function(\"ledger_setup\", [], \"ledger\");\nvar items = [];\ntry { items = JSON.parse(get_variable(\"ledger_items\")) || []; } catch (e) { items = []; }\nvar today = client.loom.ledger.day;\n\n// Tab theme (#310): loom's city palette when one is on, else this tab's own colours.\nvar TH = (client.loom && client.loom.theme) || {};\nvar PARCH = TH.acc || \"#e6d5ac\";\nvar SEPIA = TH.deep || \"#8b6b47\";\nvar WAX = \"#d0604c\";\nvar AMBER = \"#e0a95a\";\nvar TXT = TH.txt || \"#e4dccb\";\nvar MUTED = TH.muted || \"#8c8272\";\nvar RULE = TH.rule || \"#352c22\";\nvar PAST = TH.edge || \"#2a231b\";\nvar AHEAD = TH.track || \"#1f1a14\";\nvar BG = TH.bg || \"#15120e\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nvar SOON = 5;\n\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\nfunction rel(mag) {\n  var mm = Math.floor(mag / 25);\n  var dd = mag % 25;\n  var r = \"\";\n  if (mm > 0) { r = mm + \"mo\"; }\n  if (dd > 0) { r = r + (r.length ? \" \" : \"\") + dd + \"d\"; }\n  return r;\n}\nfunction dayName(d) {\n  var n = d - 1;\n  var y = Math.floor(n / 300);\n  var rem = n - y * 300;\n  return client.loom.ledger.ord((rem % 25) + 1) + \" \" + client.loom.ledger.months[Math.floor(rem / 25)];\n}\nfunction caps(t, col) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (col || SEPIA) + ';font-size:11px;margin:0 0 2px;\">' + t + '</div>'; }\nfunction section(title, inner, col) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title, col) + inner + '</div>'; }\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">' + t + '</div>'; }\n// Items another package added (#34) carry their source, muted.\nfunction srcMark(it) { return (it.source && it.source !== \"manual\") ? ' <span style=\"color:' + MUTED + ';\" title=\"added by ' + esc(it.source) + '\">&middot; ' + esc(it.source) + '</span>' : ''; }\n// One ledger line: entry number in the margin, the text, and the reckoning on the right.\nfunction entry(id, text, right, rightCol, textCol) {\n  return '<div style=\"display:flex;gap:6px;align-items:baseline;border-bottom:1px dotted ' + RULE + ';padding:2px 0;\">' +\n    '<span style=\"color:' + SEPIA + ';min-width:2.4em;\">#' + id + '</span>' +\n    '<span style=\"flex:1 1 auto;min-width:0;color:' + (textCol || TXT) + ';\">' + text + '</span>' +\n    '<span style=\"color:' + rightCol + ';white-space:nowrap;text-align:right;\">' + right + '</span></div>';\n}\n\n// Sort: dated by due day, standing by oldest touch first.\nvar dated = [];\nvar standing = [];\nvar i, j, cur;\nfor (i = 0; i < items.length; i++) { if (items[i].due) { dated.push(items[i]); } else { standing.push(items[i]); } }\nfor (i = 1; i < dated.length; i++) {\n  cur = dated[i]; j = i - 1;\n  while (j >= 0 && dated[j].due > cur.due) { dated[j + 1] = dated[j]; j--; }\n  dated[j + 1] = cur;\n}\nfor (i = 1; i < standing.length; i++) {\n  cur = standing[i]; j = i - 1;\n  while (j >= 0 && standing[j].touched > cur.touched) { standing[j + 1] = standing[j]; j--; }\n  standing[j + 1] = cur;\n}\nvar overdue = 0, soon = 0;\nfor (i = 0; i < dated.length; i++) {\n  if (today > 0 && dated[i].due < today) { overdue++; }\n  else if (today > 0 && dated[i].due - today <= SOON) { soon++; }\n}\n\n// A quill for the title, the ledger's counterpart of the coin stack.\nvar quill = '<svg width=\"16\" height=\"17\" viewBox=\"0 0 16 17\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<path d=\"M14.5 1 C9 2.5 5.5 6.5 3.5 12.5 L5 12.8 C7 8 10 4.5 14.5 1 Z\" fill=\"' + PARCH + '\"/>' +\n  '<path d=\"M14.5 1 C10.5 4 7.5 8 5 12.8\" fill=\"none\" stroke=\"' + SEPIA + '\" stroke-width=\"0.7\"/>' +\n  '<path d=\"M3.5 12.5 L2.2 15.8\" stroke=\"' + PARCH + '\" stroke-width=\"1.1\"/><circle cx=\"2\" cy=\"16\" r=\"0.9\" fill=\"' + WAX + '\"/></svg>';\n\nvar html = '<div style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + BG + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;\">';\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + SEPIA + ';padding-bottom:3px;\">';\nhtml += '<div style=\"font-family:' + SERIF + ';color:' + PARCH + ';font-size:14px;letter-spacing:0.22em;\">' + quill + 'LEDGER</div>';\nvar tally = [];\nif (overdue > 0) { tally.push('<span style=\"color:' + WAX + ';\">' + overdue + ' overdue</span>'); }\nif (soon > 0) { tally.push('<span style=\"color:' + AMBER + ';\">' + soon + ' soon</span>'); }\ntally.push(standing.length + ' standing');\nhtml += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + SEPIA + ';font-size:11px;\">' + tally.join(' &middot; ') + '</div></div>';\n\n// The date itself is the headline figure.\nif (today > 0) {\n  var n = today - 1;\n  var yy = Math.floor(n / 300);\n  var rem = n - yy * 300;\n  var mi = Math.floor(rem / 25);\n  var dd = (rem % 25) + 1;\n  html += '<div style=\"margin:6px 0 2px;\"><span style=\"font-family:' + SERIF + ';font-size:24px;color:' + PARCH + ';\">' + client.loom.ledger.ord(dd) + ' ' + client.loom.ledger.months[mi] + '</span>';\n  html += ' <span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">the year ' + yy + ' AF</span></div>';\n\n  // The month as a strip of 25 days: past days faded, today lit, and a wax\n  // dot on any day this month that has something due.\n  var monthStart = yy * 300 + mi * 25 + 1;\n  var marks = {};\n  for (i = 0; i < dated.length; i++) {\n    if (dated[i].due >= monthStart && dated[i].due < monthStart + 25) { marks[dated[i].due - monthStart + 1] = dated[i].due < today ? WAX : AMBER; }\n  }\n  var strip = '<div style=\"display:flex;gap:2px;margin:3px 0 1px;\">';\n  for (var c = 1; c <= 25; c++) {\n    var bg = c < dd ? PAST : (c === dd ? PARCH : AHEAD);\n    var bd = c === dd ? PARCH : (c < dd ? PAST : RULE);\n    strip += '<div style=\"flex:1 1 0;height:9px;background:' + bg + ';border:1px solid ' + bd + ';position:relative;\">';\n    if (marks[c]) { strip += '<div style=\"position:absolute;left:50%;top:50%;width:5px;height:5px;margin:-2.5px 0 0 -2.5px;border-radius:50%;background:' + (c === dd ? BG : marks[c]) + ';\"></div>'; }\n    strip += '</div>';\n  }\n  strip += '</div>';\n  html += strip;\n  html += '<div style=\"display:flex;justify-content:space-between;color:' + MUTED + ';\"><span>1st ' + client.loom.ledger.months[mi] + '</span><span>' + (25 - dd) + ' day' + (25 - dd === 1 ? '' : 's') + ' left in the month</span><span>25</span></div>';\n} else {\n  html += '<div style=\"margin:6px 0 2px;font-family:' + SERIF + ';font-size:18px;color:' + MUTED + ';font-style:italic;\">date not yet known</div>';\n  html += '<div style=\"color:' + MUTED + ';\">LEDGER DATE asks the game.</div>';\n}\n\n// Approaching: dated items in due order.\nvar ap = \"\";\nif (dated.length === 0) {\n  ap = quiet(\"Nothing on the calendar.\");\n} else {\n  for (i = 0; i < dated.length; i++) {\n    var diff = dated[i].due - today;\n    var r = rel(diff < 0 ? -diff : diff);\n    var when, col;\n    if (diff < 0) { when = \"overdue \" + r; col = WAX; }\n    else if (diff === 0) { when = \"today\"; col = AMBER; }\n    else if (diff <= SOON) { when = \"in \" + r; col = AMBER; }\n    else { when = \"in \" + r; col = TXT; }\n    var txt = esc(dated[i].text) + srcMark(dated[i]);\n    if (dated[i].repeat) { txt += ' <span style=\"color:' + SEPIA + ';\" title=\"repeats\">&#8635;</span>'; }\n    var right = '<span style=\"color:' + MUTED + ';\">' + dayName(dated[i].due) + '</span>&nbsp; ' + when;\n    ap += entry(dated[i].id, txt, right, col, diff < 0 ? WAX : TXT);\n  }\n}\nhtml += section(\"Approaching\", ap, PARCH);\n\n// Standing: undated items, oldest touch first; long neglect warms toward amber.\nvar st = \"\";\nif (standing.length === 0) {\n  st = quiet(\"Nothing outstanding.\");\n} else {\n  for (i = 0; i < standing.length; i++) {\n    var age = today - standing[i].touched;\n    var arel = rel(age);\n    if (!arel.length) { arel = \"fresh\"; }\n    else { arel = \"untouched \" + arel; }\n    st += entry(standing[i].id, esc(standing[i].text) + srcMark(standing[i]), arel, age >= 50 ? AMBER : MUTED);\n  }\n}\nhtml += section(\"Standing\", st, PARCH);\n\nhtml += '</div>';\ntry { set_custom_tab_html(\"Ledger\", html); } catch (e) {}\n// The items may have changed: tell loom (#197, the Online tab and the login\n// notice read them).\nif (client.loom.notify) client.loom.notify(\"ledger\");\n\n//@hot-end f:ledger_render\n};\nlhP.f[\"f:ledger_help\"] = function (args) {\n//@hot-begin f:ledger_help\n// ledger_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[ledger] reminders and standing items on the Achaean calendar. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"LEDGER\", \"today's date, what is due or overdue, the oldest standing item\"],\n  [\"LEDGER ADD <text>\", \"a standing item, with no date\"],\n  [\"LEDGER ADD <text> @ 15th Miraman 1015\", \"due on that Achaean date (15 works too)\"],\n  [\"LEDGER ADD <text> @ +4 months\", \"due in that many days or months\"],\n  [\"  ... [repeat]\", \"add REPEAT to either date to make it recur\"],\n  [\"LEDGER DONE <#>\", \"done: removed, or moved to its next date if it repeats\"],\n  [\"LEDGER DROP <#>\", \"remove without doing it\"],\n  [\"LEDGER TOUCH <#>\", \"mark a standing item as looked at today\"],\n  [\"LEDGER DATE\", \"ask the game for today's date\"],\n  [\"LEDGER DEBUG [ON|OFF]\", \"internal state, or debug notices\"],\n  [\"LEDGER REBUILD\", \"rebuild from the saved variables\"],\n  [\"Items other packages add show their source (\\u00b7 harvesting); they go away by themselves when\"],\n  [\"their condition clears. DONE or DROP one and it stays away until then.\"],\n  [\"LEDGER DISMISSED\", \"those you've sent away, waiting for their condition to clear\"],\n  [\"LEDGER RESTORE <source> [key]\", \"bring one back now (ALL for every one)\"],\n  [\"One Achaean day is one real hour; the date updates itself as each day begins.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n\n//@hot-end f:ledger_help\n};\nlhP.f[\"s:1\"] = function (args) {\n//@hot-begin s:1\n// Handles BOTH the hourly rollover and the DATE reply - same tail, one pattern.\nif (!client.loom || !client.loom.ledger || !client.loom.ledger.months) run_function(\"ledger_setup\", [], \"ledger\");\nvar dd = parseInt(args[1], 10);\nvar mn = args[2].toLowerCase();\nvar yy = parseInt(args[3], 10);\nvar mi = -1;\nvar i;\nfor (i = 0; i < client.loom.ledger.months.length; i++) {\n  if (client.loom.ledger.months[i].toLowerCase() == mn) { mi = i; }\n}\nif (mi < 0) {\n  display_notice(\"[ledger] unknown month in date line: \" + args[2], \"orange\");\n} else {\n  if (client.loom.ledger.armed) {\n    gag_current_line();\n    client.loom.ledger.armed = false;\n    client.loom.ledger.inBlock = true;\n  }\n  client.loom.ledger.day = yy * 300 + mi * 25 + dd;\n  set_variable(\"ledger_day\", \"\" + client.loom.ledger.day);\n  run_function(\"ledger_check\", [], \"ledger\");\n}\n\n//@hot-end s:1\n};\nlhP.f[\"s:5\"] = function (args) {\n//@hot-begin s:5\n// LEDGER [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.ledger || !client.loom.ledger.months) run_function(\"ledger_setup\", [], \"ledger\");\nvar LG = client.loom.ledger;\nvar lgRaw = String(args[1] || \"\").trim();\nvar lgSp = lgRaw.search(/\\s/);\nvar lgSub = (lgSp < 0 ? lgRaw : lgRaw.slice(0, lgSp)).toLowerCase();\nvar lgRest = lgSp < 0 ? \"\" : lgRaw.slice(lgSp + 1).trim();\nfunction lgSay(t, c) { display_notice(\"[ledger] \" + t, c || \"cyan\"); }\nfunction lgLoad() { var a = []; try { a = JSON.parse(get_variable(\"ledger_items\")) || []; } catch (e) { a = []; } return a; }\nfunction lgSave(a) { set_variable(\"ledger_items\", JSON.stringify(a)); }\n// Entry numbers may be typed as 3 or #3.\nfunction lgFind(items, want) { for (var i = 0; i < items.length; i++) { if (items[i].id === want) return i; } return -1; }\nvar lgWant = parseInt(lgRest.replace(/^#/, \"\"), 10);\n\nif (lgSub === \"\" || lgSub === \"status\") {\n  run_function(\"ledger_digest\", [], \"ledger\");\n  run_function(\"ledger_sync\", [], \"ledger\");\n} else if (lgSub === \"help\") {\n  run_function(\"ledger_help\", [], \"ledger\");\n} else if (lgSub === \"date\") {\n  run_function(\"ledger_sync\", [], \"ledger\");\n} else if (lgSub === \"add\") {\n  var raw = lgRest;\n  var at = raw.indexOf(\" @ \");\n  var txt = raw;\n  var tail = \"\";\n  if (at >= 0) {\n    txt = raw.substring(0, at).trim();\n    tail = raw.substring(at + 3).trim().toLowerCase();\n  }\n  var today = LG.day;\n  var due = null;\n  var rep = null;\n  var bad = \"\";\n  if (!txt.length) {\n    bad = \"no text given. LEDGER ADD <text> [@ 15th Miraman 1015 | @ +4 months] [repeat]\";\n  } else if (tail.length && today === 0) {\n    bad = \"date not known yet - run LEDGER DATE first\";\n  } else if (tail.length) {\n    var mRel = tail.match(/^\\+(\\d+)\\s+(day|days|month|months)(\\s+repeat)?$/);\n    var mFix = tail.match(/^(\\d+)(?:st|nd|rd|th)?\\s+([a-z]+)\\s+(\\d+)(\\s+repeat)?$/);\n    if (mRel) {\n      var nn = parseInt(mRel[1], 10);\n      var step = (mRel[2].charAt(0) == \"m\") ? nn * 25 : nn;\n      due = today + step;\n      if (mRel[3]) rep = { t: \"i\", n: step };\n    } else if (mFix) {\n      var fd = parseInt(mFix[1], 10);\n      var fy = parseInt(mFix[3], 10);\n      var fi = -1;\n      for (var k = 0; k < LG.months.length; k++) { if (LG.months[k].toLowerCase() == mFix[2]) fi = k; }\n      if (fi < 0) bad = \"unknown month: \" + mFix[2];\n      else if (fd < 1 || fd > 25) bad = \"day must be 1-25\";\n      else {\n        due = fy * 300 + fi * 25 + fd;\n        if (mFix[4]) rep = { t: \"a\", m: fi, d: fd };\n      }\n    } else {\n      bad = \"cannot read '\" + tail + \"' - use '15th Miraman 1015' or '+4 months', optionally + ' repeat'\";\n    }\n    if (!bad.length && due < today) bad = \"that date is already behind you - nothing added\";\n  }\n  if (bad.length) {\n    lgSay(bad, \"orange\");\n  } else {\n    var items = lgLoad();\n    var seq = parseInt(get_variable(\"ledger_seq\") || \"0\", 10) + 1;\n    items.push({ id: seq, text: txt, source: \"manual\", status: \"open\", created: today, touched: today, due: due, repeat: rep, tag: null, link: null, notified: false });\n    lgSave(items);\n    set_variable(\"ledger_seq\", \"\" + seq);\n    lgSay(\"#\" + seq + \" added\" + (due ? \"\" : \" (standing)\"), \"lime\");\n    run_function(\"ledger_check\", [], \"ledger\");\n  }\n} else if (lgSub === \"done\" || lgSub === \"drop\" || lgSub === \"touch\") {\n  var its = lgLoad();\n  var idx = isNaN(lgWant) ? -1 : lgFind(its, lgWant);\n  var td = LG.day;\n  if (isNaN(lgWant)) {\n    lgSay(\"LEDGER \" + lgSub.toUpperCase() + \" <#>\", \"orange\");\n  } else if (idx < 0) {\n    lgSay(\"no item #\" + lgWant, \"orange\");\n  } else if (lgSub === \"touch\") {\n    its[idx].touched = td;\n    lgSave(its);\n    lgSay(\"#\" + lgWant + \" touched\", \"lime\");\n  } else if (lgSub === \"done\" && its[idx].repeat) {\n    var r = its[idx].repeat;\n    var next;\n    if (r.t == \"i\") { next = td + r.n; }\n    else {\n      var y = Math.floor((td - 1) / 300);\n      next = y * 300 + r.m * 25 + r.d;\n      while (next <= td) next = next + 300;\n    }\n    its[idx].due = next;\n    its[idx].touched = td;\n    its[idx].notified = false;\n    lgSave(its);\n    var gap = next - td;\n    lgSay(\"#\" + lgWant + \" done - next in \" + Math.floor(gap / 25) + \"mo \" + (gap % 25) + \"d\", \"lime\");\n  } else {\n    var gone = its[idx].text;\n    // An item another package added stays away until its condition clears\n    // (its source withdraws it), instead of coming straight back (#34).\n    if (its[idx].source && its[idx].source !== \"manual\" && its[idx].key !== undefined) {\n      LG.dismissed[its[idx].source + \"|\" + its[idx].key] = true;\n      LG.saveDismissed();\n    }\n    its.splice(idx, 1);\n    lgSave(its);\n    lgSay(\"#\" + lgWant + \" \" + (lgSub === \"done\" ? \"done\" : \"dropped\") + \" - \" + gone, lgSub === \"done\" ? \"lime\" : \"orange\");\n  }\n  run_function(\"ledger_render\", [], \"ledger\");\n} else if (lgSub === \"dismissed\") {\n  // Reminders other packages made that you DONE/DROPped, kept away until\n  // their condition clears (#34).\n  var lgDk = [];\n  for (var lgD in LG.dismissed) { if (LG.dismissed.hasOwnProperty(lgD)) lgDk.push(lgD.replace(\"|\", \" \")); }\n  if (!lgDk.length) lgSay(\"nothing dismissed.\");\n  else lgSay(\"dismissed, kept away until their condition clears: \" + lgDk.sort().join(\", \") + \". LEDGER RESTORE <source> [key] brings one back.\");\n} else if (lgSub === \"restore\") {\n  // LEDGER RESTORE <source> [key] | ALL: end dismissals; the source is asked\n  // to look again at once (through loom), so a reminder still due comes back.\n  var lgRw = lgRest.toLowerCase().split(/\\s+/);\n  var lgRs = lgRw[0] || \"\", lgRk = lgRw.slice(1).join(\" \");\n  if (!lgRs) {\n    lgSay(\"LEDGER RESTORE <source> [key], or LEDGER RESTORE ALL. LEDGER DISMISSED lists them.\", \"orange\");\n  } else {\n    var lgGone = [], lgSrcs = {};\n    for (var lgX in LG.dismissed) {\n      if (!LG.dismissed.hasOwnProperty(lgX)) continue;\n      var lgP = lgX.split(\"|\");\n      if (lgRs === \"all\" || (lgP[0] === lgRs && (!lgRk || lgP[1] === lgRk))) { lgGone.push(lgP.join(\" \")); lgSrcs[lgP[0]] = true; delete LG.dismissed[lgX]; }\n    }\n    if (!lgGone.length) {\n      lgSay(\"nothing dismissed for '\" + lgRest + \"'. LEDGER DISMISSED lists them.\", \"orange\");\n    } else {\n      LG.saveDismissed();\n      lgSay(\"restored: \" + lgGone.join(\", \") + \".\", \"lime\");\n      for (var lgS in lgSrcs) { if (lgSrcs.hasOwnProperty(lgS) && client.loom.notify) client.loom.notify(lgS); }\n    }\n  }\n} else if (lgSub === \"debug\") {\n  var dv = lgRest.toLowerCase();\n  if (dv === \"on\" || dv === \"off\") {\n    LG.debug = (dv === \"on\");\n    set_variable(\"ledger_debug\", LG.debug ? \"1\" : \"0\");\n    lgSay(\"debug \" + (LG.debug ? \"ON\" : \"OFF\"), \"lime\");\n  } else {\n    var all = lgLoad();\n    lgSay(\"day \" + LG.day + \" | items \" + all.length + \" | seq \" + get_variable(\"ledger_seq\") + \" | armed \" + (LG.armed ? \"yes\" : \"no\") + \" | inblock \" + (LG.inBlock ? \"yes\" : \"no\") + \" | pause \" + (get_variable(\"pauseTriggers\") || \"unset\") + \" | debug \" + (LG.debug ? \"ON\" : \"OFF\") + \". LEDGER DEBUG ON/OFF.\");\n  }\n} else if (lgSub === \"rebuild\") {\n  client.loom.ledger = {};\n  run_function(\"ledger_setup\", [], \"ledger\");\n  run_function(\"ledger_render\", [], \"ledger\");\n  lgSay(\"rebuilt from the saved variables (day \" + client.loom.ledger.day + \")\", \"lime\");\n} else {\n  lgSay(\"unknown command '\" + lgSub + \"'. LEDGER HELP for commands.\", \"orange\");\n}\n\n//@hot-end s:5\n};\n"
  }
 ],
 "description": "Reminders and standing items on the Achaean calendar"
}