{
 "type": "group",
 "name": "gathering",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"gathering_setup\", [], \"gathering\");\ndisplay_notice(\"[gathering] installed. GATHERING ON to start, GATHERING HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// The gathering_* variables are left intact.\n// Leave LOOM and the integrations at once, not at the next load (#137).\nif (client.loom && client.loom.gathering) { client.loom.gathering.on = false; client.loom.gathering.queue = []; client.loom.gathering.current = null; }\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"gathering\");\n  else delete client.loom.registry.gathering;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"gathering_setup\", [], \"gathering\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Gathering follows the room and the prompt itself.\nif (!client.loom || !client.loom.gathering || !client.loom.gathering.envs) run_function(\"gathering_setup\", [], \"gathering\");\nvar GA = client.loom.gathering;\nvar gaG = (args.gmcp_args && typeof args.gmcp_args == \"object\") ? args.gmcp_args : {};\nif (args.gmcp_method == \"Room.Info\") GA.room(gaG.environment);\nelse if (args.gmcp_method == \"Char.Vitals\" && GA.on) {\n  GA.bal = gaG.bal != \"0\";\n  GA.eq = gaG.eq != \"0\";\n  // After the packet's own lines, so a success line is seen first.\n  setTimeout(GA.prompt, 0);\n}\n"
  },
  {
   "type": "function",
   "name": "gathering_setup",
   "enabled": true,
   "code": "// gathering_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, saved state, helpers.\n// Gathering is the Gathering trade skill's counterpart to harvesting: on\n// entering a room it gathers the materials of the room's environment that\n// your rift is short of, one per balance, and puts each into the rift.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.gathering) client.loom.gathering = {};\nvar GA = client.loom.gathering;\n// busy (#318): true while a GATHER or the rift reading is out, or while the\n// room's queue is still being worked through, so Here's probe and other\n// packages wait their turn. 10 s without a send no longer counts.\nclient.loom.registry.gathering = { version: \"0.1.1\", keyword: \"GATHERING\", desc: \"Gathers the materials your rift is short of as you walk the rooms\", busy: function () {\n  var g = client.loom.gathering;\n  return !!(g && g.on && (g.current || g.reading || (g.queue && g.queue.length)) && Date.now() - (g.sentAt || 0) < 10000);\n} };\n\n// What each environment (GMCP Room.Info environment, lower case) gives.\n// Saltwater and milk need an empty vial, and GATHER FROM FARM gives eggs or\n// milk at random, so those three are left to you.\nGA.envs = {\n  jungle:                [\"fruit\", \"cacao\"],\n  garden:                [\"fruit\", \"vegetables\"],\n  grasslands:            [\"grain\", \"sugarcane\"],\n  valley:                [\"olives\"],\n  forest:                [\"nuts\"],\n  \"natural underground\": [\"lumic\", \"dust\"],\n  river:                 [\"clay\"]\n};\n// Other names a material goes by (patrolling's plant names, singulars).\nGA.alias = { vegetable: \"vegetables\", olive: \"olives\", nut: \"nuts\", fruits: \"fruit\", grains: \"grain\", sugarcanes: \"sugarcane\", cacaos: \"cacao\", diamond: \"dust\" };\nGA.name = function (s) {\n  var n = String(s || \"\").trim().toLowerCase();\n  return GA.alias[n] || n;\n};\nGA.known = function (m) {\n  for (var e in GA.envs) { if (GA.envs.hasOwnProperty(e) && GA.envs[e].indexOf(m) >= 0) return true; }\n  return false;\n};\n\n// Saved state. A variable that isn't a readable table starts afresh (#135).\nGA.readTable = function (name, dflt) {\n  var v = get_variable(name);\n  if (typeof v == \"string\") { try { v = JSON.parse(v); } catch (e) { v = null; } }\n  return (v && typeof v == \"object\" && !Array.isArray(v)) ? v : dflt;\n};\nGA.min = GA.readTable(\"gathering_min\", {});\n// Material -> its name in the rift, where they differ. Learnt from the\n// \"You store N …\" line that follows our own INR.\nGA.map = GA.readTable(\"gathering_map\", { vegetables: \"vegetable\", olives: \"olive\" });\nGA.stock = GA.readTable(\"gathering_stock\", {});\nif (!to_number(get_variable(\"gathering_default_min\"))) set_variable(\"gathering_default_min\", 500);\nGA.defMin = to_number(get_variable(\"gathering_default_min\"));\n\n// Runtime state. The switch is never remembered: gathering loads off.\nif (GA.on === undefined) GA.on = false;\nif (!GA.queue) GA.queue = [];\nif (GA.current === undefined) GA.current = null;\nif (GA.here === undefined) GA.here = \"\";\nif (GA.reading === undefined) GA.reading = false;\nif (GA.wantRead === undefined) GA.wantRead = false;\nGA.inRift = false;\nGA.ownRift = false;\nGA.dashes = 0;\nGA.inrFor = null;\nGA.lastFail = null;\nGA.bal = true;\nGA.eq = true;\nif (!GA.rttMin) GA.rttMin = 0;\nGA.timeoutMs = 5000;\n\nGA.rift = function (m) { return GA.map[m] || m; };\n// The word INR takes: the material's own word, not its rift name (INR RED\n// CLAY would read as \"red\"; Ricardo: INR CLAY works).\nGA.inrWord = { vegetables: \"vegetable\", olives: \"olive\" };\nGA.inr = function (m) { return GA.inrWord[m] || m; };\nGA.minOf = function (m) { return GA.min[m] != null ? GA.min[m] : GA.defMin; };\nGA.have = function (m) { var s = GA.stock[GA.rift(m)]; return (s === undefined || s === null) ? null : s; };\nGA.paused = function () { return get_variable(\"pauseTriggers\") == \"on\"; };\nGA.save = function () {\n  set_variable(\"gathering_min\", GA.min);\n  set_variable(\"gathering_map\", GA.map);\n  set_variable(\"gathering_stock\", GA.stock);\n  if (client.loom.notify) client.loom.notify(\"gathering\");\n};\n// Is any other package waiting for an answer to something it sent (#318)?\n// Gathering shares harvesting's success line, so it never has a GATHER out\n// while harvesting (or a probe) has a command out.\nGA.othersBusy = function () {\n  var r = client.loom.registry || {};\n  for (var k in r) {\n    if (!r.hasOwnProperty(k) || k == \"gathering\" || !r[k] || typeof r[k].busy != \"function\") continue;\n    try { if (r[k].busy()) return k; } catch (e) {}\n  }\n  return \"\";\n};\n\n// A new room: queue this environment's materials that are short.\nGA.room = function (env) {\n  GA.here = String(env || \"\").toLowerCase();\n  GA.queue = [];\n  GA.current = null;\n  GA.lastFail = null;\n  if (!GA.on || GA.paused()) return;\n  if (!GA.started) { GA.started = true; GA.wantRead = true; }\n  var list = GA.envs[GA.here] || [];\n  for (var i = 0; i < list.length; i++) {\n    var h = GA.have(list[i]);\n    if ((h || 0) < GA.minOf(list[i])) GA.queue.push(list[i]);\n  }\n  if (GA.queue.length || GA.wantRead) GA.sentAt = Date.now();\n};\n\n// At each prompt (after its packet's lines): settle a GATHER that got no\n// success line, then send the next thing when balance, equilibrium and every\n// other package allow it.\nGA.prompt = function () {\n  // A rift reading whose listing never came (an empty rift, say) stops waiting.\n  if (GA.reading && Date.now() - GA.sentAt > GA.timeoutMs) { GA.reading = false; GA.ownRift = false; }\n  if (GA.current) {\n    GA.prompts++;\n    var waited = Date.now() - GA.sentAt;\n    var soonest = GA.rttMin ? Math.floor(GA.rttMin * 0.8) : 60;\n    if ((GA.prompts >= 1 && waited >= soonest) || GA.prompts >= 2 || waited > GA.timeoutMs) GA.fail(GA.current);\n    else return;\n  }\n  GA.pump();\n};\nGA.pump = function () {\n  if (!GA.on || GA.paused() || GA.current || GA.reading) return;\n  if (!GA.wantRead && !GA.queue.length) return;\n  if (!GA.bal || !GA.eq || GA.othersBusy()) return;\n  if (GA.wantRead) {\n    GA.wantRead = false;\n    GA.reading = true;\n    GA.sentAt = Date.now();\n    send_command(\"ir ingredients\");\n    return;\n  }\n  GA.current = GA.queue.shift();\n  GA.prompts = 0;\n  GA.sentAt = Date.now();\n  send_command(\"gather \" + GA.current);\n};\n// A success line for what we sent (or for one we gave up on a moment ago).\nGA.success = function () {\n  var m = GA.current;\n  if (!m && GA.lastFail && Date.now() - GA.lastFail.at < 3000) m = GA.lastFail.m;\n  if (!m) return false;\n  if (GA.current) {\n    var rtt = Date.now() - GA.sentAt;\n    if (rtt > 0 && (!GA.rttMin || rtt < GA.rttMin)) GA.rttMin = rtt;\n  }\n  GA.current = null;\n  GA.lastFail = null;\n  GA.inrFor = m;\n  GA.last = m;\n  GA.lastAt = Date.now();\n  send_command(\"queue add be inr \" + GA.inr(m));\n  return true;\n};\n// Anything that came with a gather (seeds with fruit, gold with clay) goes\n// into the rift too.\nGA.extra = function (what) {\n  if (!GA.lastAt || Date.now() - GA.lastAt > 1000) return;\n  send_command(\"queue add be inr \" + what);\n};\nGA.fail = function (m) {\n  GA.current = null;\n  GA.lastFail = { m: m, at: Date.now() };\n};\n// \"You store N x, bringing the total in the rift to M.\"\nGA.stored = function (name, total) {\n  if (GA.inrFor) {\n    // Learn the rift name, unless it is another material's.\n    var other = GA.riftOwner(name);\n    if (!other || other == GA.inrFor) {\n      if (name != GA.inrFor) GA.map[GA.inrFor] = name;\n      else delete GA.map[GA.inrFor];\n    }\n    GA.inrFor = null;\n  } else if (!GA.isRiftName(name)) return;\n  GA.stock[name] = total;\n  GA.save();\n};\n// The material whose rift name this is, if any.\nGA.riftOwner = function (name) {\n  for (var e in GA.envs) {\n    if (!GA.envs.hasOwnProperty(e)) continue;\n    for (var i = 0; i < GA.envs[e].length; i++) if (GA.rift(GA.envs[e][i]) == name) return GA.envs[e][i];\n  }\n  return \"\";\n};\nGA.isRiftName = function (name) {\n  return GA.stock.hasOwnProperty(name) || !!GA.riftOwner(name);\n};\n\n// The read-only look other packages see through loom (#159), same shape as\n// harvesting's: look.plant(name) -> { stock, min, tracked }, look.levels().\nGA.look = {\n  plant: function (name) {\n    var m = GA.name(name);\n    return { stock: GA.have(m), min: GA.minOf(m), tracked: GA.known(m) };\n  },\n  levels: function () {\n    var out = [], seen = {};\n    for (var e in GA.envs) {\n      if (!GA.envs.hasOwnProperty(e)) continue;\n      for (var i = 0; i < GA.envs[e].length; i++) {\n        var m = GA.envs[e][i];\n        if (seen[m]) continue;\n        seen[m] = true;\n        var h = GA.have(m);\n        if (h !== null) out.push({ plant: m, stock: h, min: GA.minOf(m) });\n      }\n    }\n    return out;\n  }\n};\nif (client.loom.notify) client.loom.notify(\"gathering\");\n"
  },
  {
   "type": "function",
   "name": "gathering_status",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.gathering || !client.loom.gathering.envs) run_function(\"gathering_setup\", [], \"gathering\");\nvar GA = client.loom.gathering;\nvar gaOut = [], gaSeen = {};\nfor (var gaEnv in GA.envs) {\n  for (var gaI = 0; gaI < GA.envs[gaEnv].length; gaI++) {\n    var gaM = GA.envs[gaEnv][gaI];\n    if (gaSeen[gaM]) continue;\n    gaSeen[gaM] = true;\n    var gaH = GA.have(gaM);\n    if (gaH == null || gaH < GA.minOf(gaM)) gaOut.push(gaM + \" \" + (gaH == null ? \"?\" : gaH) + \"/\" + GA.minOf(gaM));\n  }\n}\ndisplay_notice(\"[gathering] \" + (GA.on ? \"ON\" : \"OFF\") + \", default minimum \" + GA.defMin + \", environment here: \" + (GA.here || \"?\") + \". GATHERING HELP for commands.\", \"cyan\");\ndisplay_notice(gaOut.length ? \"[gathering] below minimum: \" + gaOut.join(\", \") : \"[gathering] everything at or above its minimum.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "gathering_help",
   "enabled": true,
   "code": "// gathering_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[gathering] gathers and stores materials below their minimum rift stock as you walk. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"GATHERING\", \"status: what is below its minimum\"],\n  [\"GATHERING ON|OFF\", \"ON also reads your rift (IR INGREDIENTS); loads OFF\"],\n  [\"GATHERING MIN <n>\", \"default minimum for every material (default 500)\"],\n  [\"GATHERING MIN <material> <n>\", \"minimum for one material (DEFAULT to go back to the default)\"],\n  [\"GATHERING STOCK\", \"re-read your rift now\"],\n  [\"GATHERING RESET\", \"clear the queue, reload saved state\"],\n  [\"GATHERING DEBUG\", \"internal state\"],\n  [\"Materials: fruit, cacao (jungle); fruit, vegetables (garden); grain, sugarcane (grasslands); olives (valley); nuts (forest); lumic, dust (natural underground); clay (river).\"],\n  [\"Saltwater, eggs and milk are left to you: they need an empty vial, and GATHER FROM FARM gives either.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "Gathering control",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// GATHERING [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.gathering || !client.loom.gathering.envs) run_function(\"gathering_setup\", [], \"gathering\");\nvar GA = client.loom.gathering;\nvar gaA = String(args[1] || \"\").toLowerCase().trim().split(/\\s+/);\nif (gaA[0] === \"\" || gaA[0] === \"status\") {\n  run_function(\"gathering_status\", [], \"gathering\");\n} else if (gaA[0] === \"help\") {\n  run_function(\"gathering_help\", [], \"gathering\");\n} else if (gaA[0] === \"on\") {\n  GA.on = true;\n  GA.started = true;\n  GA.wantRead = true;\n  GA.room(GA.here);\n  GA.wantRead = true;\n  GA.sentAt = Date.now();\n  display_notice(\"[gathering] ON: reading your rift stock (IR INGREDIENTS), then gathering what's short in each room you enter.\", \"lime\");\n} else if (gaA[0] === \"off\") {\n  GA.on = false;\n  GA.queue = [];\n  GA.current = null;\n  GA.reading = false;\n  GA.wantRead = false;\n  display_notice(\"[gathering] OFF.\", \"lime\");\n} else if (gaA[0] === \"stock\") {\n  GA.reading = true;\n  GA.sentAt = Date.now();\n  send_command(\"ir ingredients\");\n} else if (gaA[0] === \"min\" && gaA.length == 2 && /^\\d+$/.test(gaA[1])) {\n  GA.defMin = parseInt(gaA[1], 10);\n  set_variable(\"gathering_default_min\", GA.defMin);\n  if (client.loom.notify) client.loom.notify(\"gathering\");\n  display_notice(\"[gathering] default minimum: \" + GA.defMin + \".\", \"lime\");\n} else if (gaA[0] === \"min\" && gaA.length == 3 && (gaA[2] === \"default\" || /^\\d+$/.test(gaA[2])) && GA.known(GA.name(gaA[1]))) {\n  var gaM = GA.name(gaA[1]);\n  if (gaA[2] === \"default\") delete GA.min[gaM];\n  else GA.min[gaM] = parseInt(gaA[2], 10);\n  GA.save();\n  display_notice(\"[gathering] minimum for \" + gaM + \": \" + (GA.min[gaM] != null ? GA.min[gaM] : GA.defMin + \" (default)\") + \".\", \"lime\");\n} else if (gaA[0] === \"min\" && gaA.length == 3) {\n  display_notice(\"[gathering] '\" + gaA[1] + \"' isn't a material gathering knows. GATHERING HELP lists them.\", \"orange\");\n} else if (gaA[0] === \"min\") {\n  display_notice(\"[gathering] GATHERING MIN <n>, or GATHERING MIN <material> <n|DEFAULT>.\", \"orange\");\n} else if (gaA[0] === \"reset\") {\n  GA.queue = [];\n  GA.current = null;\n  GA.reading = false;\n  GA.wantRead = false;\n  run_function(\"gathering_setup\", [], \"gathering\");\n  display_notice(\"[gathering] reset: queue cleared, state reloaded from saved variables.\", \"lime\");\n} else if (gaA[0] === \"debug\") {\n  display_notice(\"[gathering] on=\" + GA.on + \" here=\" + GA.here + \" queue=\" + JSON.stringify(GA.queue) + \" current=\" + GA.current + \" reading=\" + GA.reading + \" wantRead=\" + GA.wantRead + \" bal=\" + GA.bal + \" eq=\" + GA.eq + \" waitingOn=\" + (GA.othersBusy() || \"-\") + \" rttMin=\" + GA.rttMin + \" lastFail=\" + JSON.stringify(GA.lastFail) + \" map=\" + JSON.stringify(GA.map), \"cyan\");\n} else {\n  display_notice(\"[gathering] unknown command '\" + gaA[0] + \"'. GATHERING HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^gathering(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "Gather success",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// A gather succeeded: harvesting's own wording for most materials, its own\n// lines for clay and dust. Only ours if gathering sent the GATHER.\nif (client.loom && client.loom.gathering && client.loom.gathering.success) client.loom.gathering.success();\n"
    }
   ],
   "text": "^(?:You reach out and carefully harvest .+|Sifting through the soft riverbed with your fingers, you collect .+|Carefully scouring the nooks and crannies of the surrounding rock, you gather .+)\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Gather seeds",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Fruit, vegetables and nuts sometimes bring seeds too.\nif (client.loom && client.loom.gathering && client.loom.gathering.extra) client.loom.gathering.extra(\"seeds\");\n"
    }
   ],
   "text": "^With your keen eyes, you spot some additional edibles and you gather .+ to supplement your collection\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Gather gold",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Clay sometimes hides gold flakes.\nif (client.loom && client.loom.gathering && client.loom.gathering.extra) client.loom.gathering.extra(\"flakes\");\n"
    }
   ],
   "text": "^As you cleanse the clay in the riverwater, you discover .+ hidden by the silt\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Gather failure",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Known failure lines settle the GATHER at once; any other answer is\n// settled at the prompt (gathering_setup, GA.prompt).\nif (client.loom && client.loom.gathering && client.loom.gathering.current) client.loom.gathering.fail(client.loom.gathering.current);\n"
    }
   ],
   "text": "^(?:What do you wish to harvest\\?|That plant has been fully harvested\\.|You carefully dig through the soft soil of the river bed but are unable to find any suitable clay\\.)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Rift store",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (client.loom && client.loom.gathering && client.loom.gathering.stored) client.loom.gathering.stored(args[2], parseInt(args[3].replace(/,/g, \"\"), 10));\n"
    }
   ],
   "text": "^You store ([\\d,]+) (.+), bringing the total in the rift to ([\\d,]+)\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Rift remove",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (client.loom && client.loom.gathering && client.loom.gathering.isRiftName && client.loom.gathering.isRiftName(args[2])) {\n  client.loom.gathering.stock[args[2]] = parseInt(args[3].replace(/,/g, \"\"), 10);\n  client.loom.gathering.save();\n}\n"
    }
   ],
   "text": "^You remove ([\\d,]+) (.+), bringing the total in the rift to ([\\d,]+)\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Rift header",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (client.loom && client.loom.gathering && client.loom.gathering.envs) {\n  var GA = client.loom.gathering;\n  GA.inRift = true;\n  GA.ownRift = GA.reading;\n  GA.dashes = 0;\n  if (GA.ownRift) gag_current_line();\n}\n"
    }
   ],
   "text": "^Glancing into your rift, you see:$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Rift title",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// The category line of our own IR INGREDIENTS.\nif (client.loom && client.loom.gathering && client.loom.gathering.ownRift && client.loom.gathering.inRift) gag_current_line();\n"
    }
   ],
   "text": "^Ingredients$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Rift rule",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (client.loom && client.loom.gathering && client.loom.gathering.inRift) {\n  var GA = client.loom.gathering;\n  if (GA.ownRift) gag_current_line();\n  GA.dashes++;\n  if (GA.dashes >= 2) {\n    GA.inRift = false;\n    if (GA.ownRift) { GA.ownRift = false; GA.reading = false; }\n  }\n}\n"
    }
   ],
   "text": "^-{20,}$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Rift rows",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Rift rows: all of them from our own reading, only gathered materials from\n// one you typed.\nif (client.loom && client.loom.gathering && client.loom.gathering.inRift) {\n  var GA = client.loom.gathering;\n  if (GA.ownRift) gag_current_line();\n  var gaRe = /\\[\\s*([\\d,]+)\\]\\s+(.+?)(?=\\s+\\[|\\s*$)/g, gaM, gaAny = false;\n  while ((gaM = gaRe.exec(args[0])) !== null) {\n    if (GA.ownRift || GA.isRiftName(gaM[2])) { GA.stock[gaM[2]] = parseInt(gaM[1].replace(/,/g, \"\"), 10); gaAny = true; }\n  }\n  if (gaAny) GA.save();\n}\n"
    }
   ],
   "text": "^\\s*\\[\\s*[\\d,]+\\]\\s.*$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  }
 ],
 "description": "Gathers the materials your rift is short of as you walk the rooms"
}