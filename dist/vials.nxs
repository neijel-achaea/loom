{
 "type": "group",
 "name": "vials",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"vials_setup\", [], \"vials\");\ndisplay_notice(\"[vials] installed. VIALS SET <elixir> <vial number> for each vial, then VIALS REFILL <elixir|ALL>. VIALS HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; vials_map is left intact.\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"vials_setup\", [], \"vials\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Sets the package up on the first GMCP message after an import (Nexus\n// doesn't run onInstall when importing over an existing package).\nif (!client.loom || !client.loom.vials || !client.loom.vials.map) run_function(\"vials_setup\", [], \"vials\");\n"
  },
  {
   "type": "function",
   "name": "vials_setup",
   "enabled": true,
   "code": "/*loom-hot vials f:vials_setup 1ad21c5793*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"vials\"];\nif (!lhH || lhH.v !== \"1ad21c5793\") { run_function(\"vials__hot\", [], \"vials\"); lhH = client.loom.__hot[\"vials\"]; }\nlhH.f[\"f:vials_setup\"](args);"
  },
  {
   "type": "function",
   "name": "vials_learn",
   "enabled": true,
   "code": "/*loom-hot vials f:vials_learn 1ad21c5793*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"vials\"];\nif (!lhH || lhH.v !== \"1ad21c5793\") { run_function(\"vials__hot\", [], \"vials\"); lhH = client.loom.__hot[\"vials\"]; }\nlhH.f[\"f:vials_learn\"](args);"
  },
  {
   "type": "function",
   "name": "vials_help",
   "enabled": true,
   "code": "/*loom-hot vials f:vials_help 1ad21c5793*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"vials\"];\nif (!lhH || lhH.v !== \"1ad21c5793\") { run_function(\"vials__hot\", [], \"vials\"); lhH = client.loom.__hot[\"vials\"]; }\nlhH.f[\"f:vials_help\"](args);"
  },
  {
   "type": "alias",
   "name": "vials",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "/*loom-hot vials s:1 1ad21c5793*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"vials\"];\nif (!lhH || lhH.v !== \"1ad21c5793\") { run_function(\"vials__hot\", [], \"vials\"); lhH = client.loom.__hot[\"vials\"]; }\nlhH.f[\"s:1\"](args);"
    }
   ],
   "text": "^vials(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "vials elixlist",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "/*loom-hot vials s:2 1ad21c5793*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"vials\"];\nif (!lhH || lhH.v !== \"1ad21c5793\") { run_function(\"vials__hot\", [], \"vials\"); lhH = client.loom.__hot[\"vials\"]; }\nlhH.f[\"s:2\"](args);"
    }
   ],
   "text": "^(?:Vial\\s+Fluid\\s+Sips\\s+Months\\s*|-{10,}\\s*|.*\\bvial\\d+\\s+.+\\s+\\d+\\s+(?:---|\\d+)\\s*)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "function",
   "name": "vials__hot",
   "enabled": true,
   "code": "// vials__hot -- generated by tools/build.py (#136). The bodies of this package's\n// longer scripts, made once per load; each script in the package is a stub\n// that calls its body here. Edit the source in packages/vials/, never this.\nif (!client.loom) client.loom = {};\nif (!client.loom.__hot) client.loom.__hot = {};\nvar lhP = client.loom.__hot[\"vials\"] = { v: \"1ad21c5793\", f: {} };\nlhP.f[\"f:vials_setup\"] = function (args) {\n//@hot-begin f:vials_setup\n// vials_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Namespace, registry, and your vials: which vial\n// holds which elixir (vials_map, a JSON object of elixir -> vial number).\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.vials) client.loom.vials = {};\nclient.loom.registry.vials = { version: \"0.2.4\", keyword: \"VIALS\", desc: \"Refill your vials from the rift by elixir\" };\nvar VI = client.loom.vials;\nif (!VI.map) {\n  var viRaw;\n  try { viRaw = get_variable(\"vials_map\"); } catch (e) { viRaw = undefined; }\n  try { VI.map = JSON.parse(viRaw) || {}; } catch (e) { VI.map = {}; }\n  if (Object.prototype.toString.call(VI.map) !== \"[object Object]\") VI.map = {};\n}\n// Sips and months per elixir from the last VIALS LEARN (vials_info), shown by\n// VIALS; vials set by hand have none.\nif (!VI.info) {\n  try { VI.info = JSON.parse(get_variable(\"vials_info\") || \"{}\") || {}; } catch (e) { VI.info = {}; }\n}\nif (VI.learn === undefined) VI.learn = null;\n\n//@hot-end f:vials_setup\n};\nlhP.f[\"f:vials_learn\"] = function (args) {\n//@hot-begin f:vials_learn\n// vials_learn -- end of an ELIXLIST capture (VIALS LEARN, #106): the vials\n// found replace the stored map. Fluid to elixir: \"an elixir of X\" and \"a salve\n// of X\" give X; \"an X salve\" gives X (epidermal, caloric). Empty vials (no\n// sips, or \"empty\") are skipped; a fluid of no known shape is reported. Two\n// vials of one elixir: the one with more sips is kept. Sips and months are\n// kept too (vials_info), for VIALS to show.\nvar VI = client.loom.vials;\nvar L = VI.learn;\nVI.learn = null;\nclearTimeout(VI.learnT);\nfunction lnSay(t, c) { display_notice(\"[vials] \" + t, c || \"cyan\"); }\nfunction lnElixir(fl) {\n  var f = String(fl).toLowerCase().trim();\n  var m = f.match(/^(?:an?\\s+)?(?:elixir|salve|tonic|tincture|poultice)\\s+of\\s+([a-z]+)$/);\n  if (m) return m[1];\n  m = f.match(/^(?:an?\\s+)?([a-z]+)\\s+(?:salve|elixir|tonic|tincture|poultice)$/);\n  if (m) return m[1];\n  return null;\n}\nif (L) {\n  var lnNew = {}, lnInfo = {}, lnSpare = [], lnOdd = [], lnEmpty = 0;\n  for (var lnI = 0; lnI < L.rows.length; lnI++) {\n    var r = L.rows[lnI];\n    if (!r.sips || /\\bempty\\b/i.test(r.fluid)) { lnEmpty++; continue; }\n    var el = lnElixir(r.fluid);\n    if (!el) { lnOdd.push(\"vial\" + r.vial + \" (\" + r.fluid + \")\"); continue; }\n    if (lnInfo[el]) {\n      // Keep the vial with more sips; mention the other.\n      if (r.sips > lnInfo[el].sips) { lnSpare.push(el + \" in vial\" + lnNew[el] + \" (\" + lnInfo[el].sips + \" sips)\"); lnNew[el] = r.vial; lnInfo[el] = { sips: r.sips, months: r.months }; }\n      else lnSpare.push(el + \" in vial\" + r.vial + \" (\" + r.sips + \" sips)\");\n      continue;\n    }\n    lnNew[el] = r.vial;\n    lnInfo[el] = { sips: r.sips, months: r.months };\n  }\n  var lnSet = [], lnChanged = [], lnGone = [];\n  for (var k in lnNew) {\n    if (!lnNew.hasOwnProperty(k)) continue;\n    if (!VI.map[k]) lnSet.push(k);\n    else if (VI.map[k] !== lnNew[k]) lnChanged.push(k + \" vial\" + VI.map[k] + \" -> vial\" + lnNew[k]);\n  }\n  for (var g in VI.map) { if (VI.map.hasOwnProperty(g) && !lnNew[g]) lnGone.push(g + \" (vial\" + VI.map[g] + \")\"); }\n  var lnCount = Object.keys(lnNew).length;\n  if (!L.rows.length) {\n    lnSay(\"ELIXLIST showed no vials; nothing changed.\", \"orange\");\n  } else {\n    VI.map = lnNew;\n    VI.info = lnInfo;\n    set_variable(\"vials_map\", JSON.stringify(VI.map));\n    set_variable(\"vials_info\", JSON.stringify(VI.info));\n    lnSay(\"learned \" + lnCount + \" vial\" + (lnCount === 1 ? \"\" : \"s\") + \" from ELIXLIST\" + (lnSet.length || lnChanged.length || lnGone.length ? \".\" : \", same as before.\"), \"lime\");\n    if (lnSet.length) lnSay(\"new: \" + lnSet.sort().join(\", \") + \".\", \"lime\");\n    if (lnChanged.length) lnSay(\"moved: \" + lnChanged.sort().join(\", \") + \".\", \"lime\");\n    if (lnGone.length) lnSay(\"no longer found, forgotten: \" + lnGone.sort().join(\", \") + \".\", \"orange\");\n    if (lnSpare.length) lnSay(\"a second vial, not used for refills: \" + lnSpare.join(\", \") + \".\", \"cyan\");\n    if (lnEmpty) lnSay(lnEmpty + \" empty vial\" + (lnEmpty === 1 ? \"\" : \"s\") + \" skipped.\", \"cyan\");\n    if (lnOdd.length) lnSay(\"fluid not recognised, skipped: \" + lnOdd.join(\", \") + \". VIALS SET can add it by hand.\", \"orange\");\n    lnSay(\"VIALS lists them.\", \"cyan\");\n  }\n}\n\n//@hot-end f:vials_learn\n};\nlhP.f[\"f:vials_help\"] = function (args) {\n//@hot-begin f:vials_help\n// vials_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[vials] refill your vials from the rift. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"VIALS\", \"which vial holds which elixir, with sips and decay after a LEARN\"],\n  [\"VIALS LEARN\", \"read your vials from ELIXLIST and set them all\"],\n  [\"VIALS REFILL <elixir>\", \"fill that elixir's vial from the rift\"],\n  [\"VIALS REFILL ALL\", \"fill every vial set\"],\n  [\"VIALS SET <elixir> <vial> [...]\", \"which vial holds an elixir; several pairs on one line\"],\n  [\"VIALS FORGET <elixir>\", \"stop tracking that vial\"],\n  [\"VIALS DEBUG\", \"internal state\"],\n  [\"VIALS LEARN replaces the list with what ELIXLIST shows. Nothing is sent while triggers are paused.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n\n//@hot-end f:vials_help\n};\nlhP.f[\"s:1\"] = function (args) {\n//@hot-begin s:1\n// VIALS [subcommand ...]: refill vials from the rift, and which vial holds\n// which elixir.\nif (!client.loom || !client.loom.vials || !client.loom.vials.map) run_function(\"vials_setup\", [], \"vials\");\nvar VI = client.loom.vials;\nvar viW = String(args[1] || \"\").trim().toLowerCase().split(/\\s+/);\nvar viSub = viW[0];\nfunction viSay(t, c) { display_notice(\"[vials] \" + t, c || \"cyan\"); }\nfunction viKeys() { var a = []; for (var k in VI.map) { if (VI.map.hasOwnProperty(k)) a.push(k); } a.sort(); return a; }\nfunction viSave() { set_variable(\"vials_map\", JSON.stringify(VI.map)); }\nfunction viFill(el) { send_command(\"fill vial\" + VI.map[el] + \" with \" + el + \" from rift\"); }\n\nif (viSub === \"\" || viSub === \"list\") {\n  var viK = viKeys();\n  if (!viK.length) viSay(\"no vials set yet. VIALS LEARN reads them from ELIXLIST, or VIALS SET <elixir> <vial number> [...].\", \"orange\");\n  else {\n    // A monospace block through nexusclient.add_html_line when this Nexus has\n    // it, so the columns line up; otherwise plain notices.\n    viSay(viK.length + \" vial\" + (viK.length === 1 ? \"\" : \"s\") + \":\");\n    var viHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\n    var viRows = [];\n    for (var viI = 0; viI < viK.length; viI++) {\n      var viName = (viK[viI] + \"              \").slice(0, 13);\n      var viIn = (VI.info && VI.info[viK[viI]]) || null;\n      var viVial = (\"vial\" + VI.map[viK[viI]] + \"            \").slice(0, 12);\n      var viMore = viIn ? viIn.sips + \" sips\" + (viIn.months !== null && viIn.months !== undefined ? \", decays in \" + viIn.months + \" months\" : \"\") : \"\";\n      if (viHtml) viRows.push('  <span style=\"color:#00ffff\">' + viName + '</span><span style=\"color:#9fc9c9\">' + viVial + '</span><span style=\"color:#7a9a9a\">' + viMore + '</span>');\n      else display_notice(\"  \" + viName + viVial + viMore, \"cyan\");\n    }\n    if (viHtml) nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + viRows.join(\"\\n\") + '</span>');\n  }\n} else if (viSub === \"help\") {\n  run_function(\"vials_help\", [], \"vials\");\n} else if (viSub === \"set\") {\n  // Pairs: elixir vial [elixir vial ...]; \"vial123\" or \"123\" both work.\n  var viP = viW.slice(1);\n  if (viP.length < 2 || viP.length % 2) {\n    viSay(\"VIALS SET <elixir> <vial number>, as many pairs as you like on one line.\", \"orange\");\n  } else {\n    var viSet = [], viBad = [];\n    for (var viJ = 0; viJ < viP.length; viJ += 2) {\n      var viN = viP[viJ + 1].replace(/^vial/, \"\");\n      if (/^\\d+$/.test(viN) && /^[a-z]+$/.test(viP[viJ])) { VI.map[viP[viJ]] = viN; viSet.push(viP[viJ] + \" vial\" + viN); }\n      else viBad.push(viP[viJ] + \" \" + viP[viJ + 1]);\n    }\n    viSave();\n    if (viSet.length) viSay(\"set: \" + viSet.join(\", \") + \".\", \"lime\");\n    if (viBad.length) viSay(\"not understood: \" + viBad.join(\", \") + \".\", \"orange\");\n  }\n} else if (viSub === \"learn\") {\n  // VIALS LEARN (#106): send ELIXLIST and set the vials from its table. The\n  // capture ends on the table's closing line (trigger_elixlist); a reply that\n  // never comes is given up after 30s.\n  if (get_variable(\"pauseTriggers\") === \"on\") {\n    viSay(\"triggers are paused, so nothing was sent.\", \"orange\");\n  } else {\n    VI.learn = { stage: 0, rows: [] };\n    clearTimeout(VI.learnT);\n    VI.learnT = setTimeout(function () {\n      if (client.loom.vials.learn) { client.loom.vials.learn = null; display_notice(\"[vials] no ELIXLIST table came back; nothing changed.\", \"orange\"); }\n    }, 30000);\n    send_command(\"elixlist\", 1);\n  }\n} else if (viSub === \"forget\") {\n  var viF = viW[1] || \"\";\n  if (!VI.map[viF]) viSay(\"no vial set for '\" + viF + \"'.\", \"orange\");\n  else { delete VI.map[viF]; if (VI.info) { delete VI.info[viF]; set_variable(\"vials_info\", JSON.stringify(VI.info)); } viSave(); viSay(viF + \" forgotten.\", \"lime\"); }\n} else if (viSub === \"refill\") {\n  var viE = viW[1] || \"\";\n  if (get_variable(\"pauseTriggers\") === \"on\") {\n    viSay(\"triggers are paused, so nothing was sent.\", \"orange\");\n  } else if (viE === \"all\") {\n    var viA = viKeys();\n    if (!viA.length) viSay(\"no vials set yet. VIALS SET <elixir> <vial number>.\", \"orange\");\n    for (var viL = 0; viL < viA.length; viL++) viFill(viA[viL]);\n  } else if (VI.map[viE]) {\n    viFill(viE);\n  } else {\n    viSay(viE ? \"no vial set for '\" + viE + \"'. VIALS lists yours.\" : \"VIALS REFILL <elixir> or VIALS REFILL ALL.\", \"orange\");\n  }\n} else if (viSub === \"debug\") {\n  viSay(\"map=\" + JSON.stringify(VI.map) + \" info=\" + JSON.stringify(VI.info || {}) + \" learning=\" + (VI.learn ? \"stage \" + VI.learn.stage + \", \" + VI.learn.rows.length + \" rows\" : \"no\") + \" saved=\" + get_variable(\"vials_map\") + \" pause=\" + (get_variable(\"pauseTriggers\") || \"unset\"), \"cyan\");\n} else {\n  viSay(\"unknown command '\" + viSub + \"'. VIALS HELP for commands.\", \"orange\");\n}\n\n//@hot-end s:1\n};\nlhP.f[\"s:2\"] = function (args) {\n//@hot-begin s:2\n// ELIXLIST capture for VIALS LEARN (#106). Only while a VIALS LEARN is under\n// way (VI.learn), so an ELIXLIST typed by hand shows as usual. The table runs\n// from its \"Vial Fluid Sips Months\" header to its second dashed line, which\n// ends the capture; every line of it is hidden.\nif (!client.loom || !client.loom.vials || !client.loom.vials.map) run_function(\"vials_setup\", [], \"vials\");\nvar VI = client.loom.vials;\nvar L = VI.learn;\nvar elLine = String(args[0]);\nif (L) {\n  if (/^Vial\\s+Fluid\\s+Sips\\s+Months\\s*$/.test(elLine)) {\n    L.stage = 1;\n    gag_current_line();\n  } else if (/^-{10,}\\s*$/.test(elLine) && L.stage >= 1) {\n    gag_current_line();\n    if (L.stage === 1) L.stage = 2;\n    else run_function(\"vials_learn\", [], \"vials\");\n  } else if (L.stage === 2) {\n    var elM = elLine.match(/\\bvial(\\d+)\\s+(.+?)\\s+(\\d+)\\s+(---|\\d+)\\s*$/);\n    if (elM) {\n      L.rows.push({ vial: elM[1], fluid: elM[2], sips: parseInt(elM[3], 10), months: elM[4] === \"---\" ? null : parseInt(elM[4], 10) });\n      gag_current_line();\n    }\n  }\n}\n\n//@hot-end s:2\n};\n"
  }
 ],
 "description": "Refill your vials from the rift by elixir"
}