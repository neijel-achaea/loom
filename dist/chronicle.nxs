{
 "type": "group",
 "name": "chronicle",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"chronicle_setup\", [], \"chronicle\");\nrun_function(\"chronicle_gmcp\", [], \"chronicle\");\ndisplay_notice(\"[chronicle] installed: keeping a record of each Achaean day. Make a custom tab called Chronicle to see it; CHRONICLE HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// The chronicle_* variables are left intact; what's unsaved is saved now.\nif (client.loom && client.loom.chronicle) {\n  var crU = client.loom.chronicle;\n  if (crU.saveT) { clearTimeout(crU.saveT); crU.saveT = null; if (crU.save) crU.save(); }\n  if (crU.drawT) { clearTimeout(crU.drawT); crU.drawT = null; }\n  crU.capt = null;\n}\n// Leave LOOM and the integrations at once, not at the next load (#137).\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"chronicle\");\n  else delete client.loom.registry.chronicle;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it. An open book.\nvar tiTabs = [[\"Chronicle\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\"><path d=\"M8 4 C6 2.6 3.5 2.4 1 3 L1 13 C3.5 12.4 6 12.6 8 14 Z\" fill=\"#e6d5ac\"/><path d=\"M8 4 C10 2.6 12.5 2.4 15 3 L15 13 C12.5 12.4 10 12.6 8 14 Z\" fill=\"#cdb98a\"/><path d=\"M8 4 L8 14\" stroke=\"#8b6b47\" stroke-width=\"0.8\"/><path d=\"M3 5.5 L6.2 6 M3 7.5 L6.2 8 M3 9.5 L6.2 10 M9.8 6 L13 5.5 M9.8 8 L13 7.5\" stroke=\"#8b6b47\" stroke-width=\"0.5\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\nrun_function(\"chronicle_setup\", [], \"chronicle\");\nrun_function(\"chronicle_gmcp\", [], \"chronicle\");\nrun_function(\"chronicle_render\", [], \"chronicle\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// The work is in chronicle_gmcp (#136: this runs on every GMCP message, so it stays short).\nvar crH = client.loom && client.loom.hooks && client.loom.hooks.chronicle;\nif (!crH || !crH.gmcp) { run_function(\"chronicle_gmcp\", [], \"chronicle\"); crH = client.loom.hooks.chronicle; }\ncrH.gmcp(args);\n"
  },
  {
   "type": "function",
   "name": "chronicle_setup",
   "enabled": true,
   "code": "// chronicle_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, saved state, helpers.\n//\n// Chronicle (#491) keeps a record of what happens to your character, one\n// Achaean day (one real hour) at a time: the areas you spend time in and the\n// rooms you linger in, the IC channels, emotes in your room, the letters,\n// messages and news you read, notes you add, and what other packages report\n// through loom. This is the record only; summaries written from it come in a\n// later version (docs/chronicle.md).\n//\n// Data kept, per day: CR.days = [{ d, ev: [event...] }], oldest first, saved\n// in chronicle_days. d is the Achaean day number (as ledger's: year * 300 +\n// month * 25 + day, months from 0), 0 for events from before the date was\n// known. Every event has t (ms) and k (its kind):\n//   place  { area, room }             an area you spent a minute or more in\n//   stay   { room, area, min, with }  a room you stayed in 5 minutes or more\n//   chan   { ch, name, who, text }    a line on an IC channel (tells too)\n//   emote  { who, text }              an emote by someone in your room\n//   letter { what, text }             a letter you read\n//   msg    { num, who, text }         a message you read\n//   news   { section, num, date, from, to, subject, text }\n//   note   { text }                   CHRONICLE NOTE\n//   link   { src, key, text }         from another package, through loom\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.chronicle) client.loom.chronicle = {};\nclient.loom.registry.chronicle = { version: \"0.1.0\", keyword: \"CHRONICLE\", desc: \"A record of each Achaean day: places, IC talk, letters and news, notes\",\n  redraw: function () { run_function(\"chronicle_render\", [], \"chronicle\"); } };\nvar CR = client.loom.chronicle;\n\n// Limits. A day keeps its last perDay events; the record keeps maxDays days,\n// and drops the oldest while it's over maxBytes saved.\nCR.perDay = 600;\nCR.maxDays = 30;\nCR.maxBytes = 400000;\nCR.textMax = 600;     // a channel line or emote\nCR.longMax = 5000;    // a letter, message or news post\nCR.areaMs = 60000;    // an area counts after a minute in it\nCR.stayMs = 300000;   // a room after five minutes\nCR.capMs = 10000;     // a capture with no prompt seen ends after this\nCR.emoteMax = 6;      // emotes from one person in a minute before they're taken for combat\nCR.emoteMute = 120000;\n\n// Saved state. A variable that isn't a readable table starts afresh (#135).\nCR.readVar = function (name) {\n  var v;\n  try { v = get_variable(name); } catch (e) { v = undefined; }\n  if (typeof v == \"string\") { try { v = JSON.parse(v); } catch (e) { v = null; } }\n  return v;\n};\nif (!Array.isArray(CR.days)) {\n  var crD = CR.readVar(\"chronicle_days\");\n  CR.days = [];\n  if (Array.isArray(crD)) {\n    for (var crI = 0; crI < crD.length; crI++) {\n      var crB = crD[crI];\n      if (crB && typeof crB == \"object\" && typeof crB.d == \"number\" && Array.isArray(crB.ev)) CR.days.push({ d: crB.d, ev: crB.ev.filter(function (e) { return e && typeof e == \"object\" && e.k; }) });\n    }\n  }\n}\nif (!CR.anchor) {\n  var crA = CR.readVar(\"chronicle_anchor\");\n  CR.anchor = (crA && typeof crA == \"object\" && typeof crA.d == \"number\" && crA.d > 0 && typeof crA.at == \"number\") ? crA : null;\n}\nif (!CR.over || typeof CR.over != \"object\") {\n  var crO = CR.readVar(\"chronicle_channels\");\n  CR.over = (crO && typeof crO == \"object\" && !Array.isArray(crO)) ? crO : {};\n}\nif (CR.me === undefined) { var crM = CR.readVar(\"chronicle_name\"); CR.me = typeof crM == \"string\" ? crM : \"\"; }\nif (!CR.seen) CR.seen = {};        // channel key -> true, heard this session\nif (!CR.captions) CR.captions = {};\nif (!CR.players) CR.players = {};  // lower-case name -> name, in your room\nif (!CR.room) CR.room = null;\nif (!CR.area) CR.area = null;\nif (!CR.rate) CR.rate = {};\nif (!CR.recent) CR.recent = [];    // channel lines just heard: [plain, at]\nif (CR.capt === undefined) CR.capt = null;\nif (CR.cont === undefined) CR.cont = null;\n\n// --- time and days ---------------------------------------------------------\n// One Achaean day is one real hour, and a new one begins at the top of the\n// hour (Ricardo). So from one known date (the anchor) any moment's day is\n// worked out by counting whole hours: the date stays right across reloads and\n// time away. Every date line the game shows moves the anchor.\nCR.hour = function (t) { return Math.floor(t / 3600000); };\nCR.dayOf = function (t) {\n  var a = CR.anchor;\n  return a ? a.d + CR.hour(t) - CR.hour(a.at) : 0;\n};\nCR.months = [\"Sarapin\", \"Daedalan\", \"Aeguary\", \"Miraman\", \"Scarlatan\", \"Ero\", \"Valnuary\", \"Lupar\", \"Phaestian\", \"Chronos\", \"Glacian\", \"Mayan\"];\nCR.ord = function (n) {\n  var s = (n % 100 >= 11 && n % 100 <= 13) ? \"th\" : ([\"th\", \"st\", \"nd\", \"rd\"][n % 10] || \"th\");\n  return n + s;\n};\nCR.dayName = function (d) {\n  if (!d) return \"undated\";\n  var n = d - 1, y = Math.floor(n / 300), r = n - y * 300;\n  return CR.ord((r % 25) + 1) + \" \" + CR.months[Math.floor(r / 25)] + \", \" + y + \" AF\";\n};\n// A date line: \"It is now the 5th of Lupar, 1016 years after...\" (the hourly\n// rollover) or \"Today is the ...\" (DATE).\nCR.setDate = function (dd, month, yy) {\n  var mi = -1;\n  for (var i = 0; i < CR.months.length; i++) { if (CR.months[i].toLowerCase() == String(month).toLowerCase()) mi = i; }\n  if (mi < 0) return;\n  var d = yy * 300 + mi * 25 + dd;\n  var had = !!CR.anchor;\n  CR.anchor = { d: d, at: Date.now() };\n  set_variable(\"chronicle_anchor\", JSON.stringify(CR.anchor));\n  if (!had) CR.relabel();\n  CR.dirty();\n};\n// Ledger's date, when it has one and ours is missing.\nCR.borrowDate = function () {\n  var lg = client.loom && client.loom.ledger;\n  if (!CR.anchor && lg && typeof lg.day == \"number\" && lg.day > 0) {\n    CR.anchor = { d: lg.day, at: Date.now() };\n    set_variable(\"chronicle_anchor\", JSON.stringify(CR.anchor));\n    CR.relabel();\n  }\n};\n// Events kept before the date was known go to their own day once it is.\nCR.relabel = function () {\n  var und = null, i;\n  for (i = 0; i < CR.days.length; i++) { if (CR.days[i].d === 0) und = CR.days.splice(i, 1)[0]; }\n  if (!und || !CR.anchor) { if (und) CR.days.unshift(und); return; }\n  for (i = 0; i < und.ev.length; i++) CR.put(und.ev[i]);\n};\nCR.today = function () { return CR.dayOf(Date.now()); };\nCR.bucket = function (d, make) {\n  for (var i = CR.days.length - 1; i >= 0; i--) { if (CR.days[i].d === d) return CR.days[i]; }\n  if (!make) return null;\n  var b = { d: d, ev: [] };\n  var at = CR.days.length;\n  while (at > 0 && CR.days[at - 1].d > d) at--;\n  CR.days.splice(at, 0, b);\n  return b;\n};\n\n// --- recording ---------------------------------------------------------------\nCR.plain = function (s) { return String(s === undefined || s === null ? \"\" : s).replace(/\\u001b\\[[0-9;]*m/g, \"\").replace(/[\\u0000-\\u0009\\u000b-\\u001f]/g, \"\").replace(/\\s+$/, \"\"); };\nCR.clip = function (s, n) { s = String(s); return s.length > n ? s.slice(0, n - 1) + \"\\u2026\" : s; };\nCR.put = function (ev) {\n  var b = CR.bucket(CR.dayOf(ev.t), true);\n  // In time order: an area or a stay is recorded when it has lasted, but\n  // belongs where it began.\n  var at = b.ev.length;\n  while (at > 0 && b.ev[at - 1].t > ev.t) at--;\n  b.ev.splice(at, 0, ev);\n  if (b.ev.length > CR.perDay) b.ev.splice(0, b.ev.length - CR.perDay);\n};\nCR.add = function (ev) {\n  if (!ev.t) ev.t = Date.now();\n  CR.borrowDate();\n  CR.put(ev);\n  CR.dirty();\n  return ev;\n};\n// Saved a little later, so a busy hour writes once in a while rather than per\n// line; drawn soon after, so a burst is one draw.\nCR.dirty = function () {\n  if (!CR.saveT) CR.saveT = setTimeout(function () { client.loom.chronicle.saveT = null; client.loom.chronicle.save(); }, 10000);\n  if (!CR.drawT) CR.drawT = setTimeout(function () { client.loom.chronicle.drawT = null; run_function(\"chronicle_render\", [], \"chronicle\"); }, 300);\n};\nCR.save = function () {\n  while (CR.days.length > CR.maxDays) CR.days.shift();\n  var s = JSON.stringify(CR.days);\n  while (s.length > CR.maxBytes && CR.days.length > 1) { CR.days.shift(); s = JSON.stringify(CR.days); }\n  set_variable(\"chronicle_days\", s);\n};\n\n// --- channels -----------------------------------------------------------------\n// IC channels are kept, OOC and utility ones not (Ricardo, 2026-11-13): say,\n// tells, yell, the city, house and order, house newbie, group, clans and the\n// gods' emotes. Any other channel is left out until CHRONICLE CHANNEL <key> ON.\nCR.names = function (k) {\n  k = String(k || \"\");\n  return [k, String(CR.captions[k] || \"\").replace(/^the\\s+/i, \"\")].join(\"|\").toLowerCase();\n};\nCR.chanDefault = function (k) {\n  if (/^tell\\s/i.test(String(k))) return true;\n  return /(?:^|\\|)(?:says?|tells?|yells?|ct|city|ht|gt|house|hnt|gnt|house newbie[^|]*|ot|order|group|emotes?|clt\\d+|clan of[^|]*)(?:\\||$)/.test(CR.names(k));\n};\nCR.chanKey = function (k) { k = String(k || \"\"); return /^tell\\s/i.test(k) ? \"tells\" : k; };\nCR.chanOn = function (k) {\n  var key = CR.chanKey(k);\n  if (CR.over[key] !== undefined) return !!CR.over[key];\n  return CR.chanDefault(k);\n};\nCR.chanName = function (k) {\n  k = String(k || \"\");\n  if (/^tell\\s/i.test(k)) return \"tell\";\n  if (CR.captions[k]) return CR.captions[k].replace(/^the\\s+(?:clan\\s+of\\s+)?/i, \"\");\n  return k;\n};\n// Anything after // is OOC (Ricardo) and left out; a line with nothing IC\n// left goes altogether. A URL's :// is not a marker.\nCR.ic = function (text) {\n  var m = /(^|[^:])\\/\\/.*$/.exec(text);\n  if (!m) return text;\n  var t = text.slice(0, m.index + m[1].length).replace(/\\s+$/, \"\");\n  if ((t.match(/\"/g) || []).length % 2 === 1) {\n    if (/\"\\s*$/.test(t)) return \"\";\n    t += '\"';\n  }\n  if (/^\\([^)]*\\):?\\s*$/.test(t) || /,\\s*\"\"$/.test(t) || !/\\S/.test(t)) return \"\";\n  return t;\n};\nCR.chan = function (g) {\n  var k = String(g.channel || \"\");\n  if (!k) return;\n  CR.seen[CR.chanKey(k)] = true;\n  if (!CR.chanOn(k)) return;\n  var text = CR.ic(CR.plain(g.text));\n  if (!text) return;\n  // The channel's own prefix (\"(Heartwood): \") goes: the entry names it.\n  var bare = text.replace(/^\\([^)]{1,40}\\):\\s+/, \"\");\n  var now = Date.now();\n  CR.recent.push([text, now]);\n  while (CR.recent.length > 20 || (CR.recent.length && now - CR.recent[0][1] > 5000)) CR.recent.shift();\n  // The same line taken for an emote a moment ago (it came as text first).\n  var b = CR.bucket(CR.dayOf(now), false);\n  if (b) {\n    for (var i = b.ev.length - 1; i >= 0 && i >= b.ev.length - 5; i--) {\n      if (b.ev[i].k == \"emote\" && b.ev[i].text == text && now - b.ev[i].t < 5000) b.ev.splice(i, 1);\n    }\n  }\n  CR.add({ t: now, k: \"chan\", ch: CR.chanKey(k), name: CR.chanName(k), who: String(g.talker || \"\"), text: CR.clip(bare, CR.textMax) });\n};\n\n// --- places ---------------------------------------------------------------------\nCR.enter = function (g) {\n  var num = g.num !== undefined ? String(g.num) : \"\";\n  if (CR.room && CR.room.num === num) return;\n  var now = Date.now();\n  CR.leave(now);\n  var area = String(g.area || \"\");\n  if (!CR.area || CR.area.name !== area) CR.area = { name: area, at: now, ev: null };\n  CR.room = { num: num, name: CR.plain(g.name), area: area, at: now, ev: null, with: {} };\n  CR.players = {};\n};\nCR.leave = function (now) {\n  var r = CR.room;\n  if (r && r.ev) { r.ev.min = Math.round((now - r.at) / 60000); r.ev.with = CR.withList(r); CR.dirty(); }\n};\nCR.withList = function (r) {\n  var out = [];\n  for (var n in r.with) { if (r.with.hasOwnProperty(n)) out.push(r.with[n]); }\n  return out;\n};\nCR.meet = function (name) {\n  name = String(name || \"\").split(/\\s+/)[0];\n  if (!/^[A-Za-z]+$/.test(name)) return;\n  name = name.charAt(0).toUpperCase() + name.slice(1).toLowerCase();\n  CR.players[name.toLowerCase()] = name;\n  if (CR.room && name.toLowerCase() !== String(CR.me).toLowerCase()) {\n    CR.room.with[name.toLowerCase()] = name;\n    if (CR.room.ev) CR.room.ev.with = CR.withList(CR.room);\n  }\n};\n// Every prompt: an area or room long enough is recorded, and a capture that\n// never saw its prompt ends.\nCR.tick = function () {\n  var now = Date.now();\n  if (CR.area && !CR.area.ev && CR.area.name && now - CR.area.at >= CR.areaMs) {\n    CR.area.ev = CR.add({ t: CR.area.at, k: \"place\", area: CR.area.name, room: CR.room ? CR.room.name : \"\" });\n  }\n  var r = CR.room;\n  if (r && !r.ev && r.name && now - r.at >= CR.stayMs) {\n    r.ev = CR.add({ t: r.at, k: \"stay\", room: r.name, area: r.area, min: Math.round((now - r.at) / 60000), with: CR.withList(r) });\n  } else if (r && r.ev) {\n    var mn = Math.round((now - r.at) / 60000);\n    if (mn !== r.ev.min) { r.ev.min = mn; CR.dirty(); }\n  }\n  if (CR.capt && now - CR.capt.at > CR.capMs) CR.finish();\n};\n\n// --- game lines -----------------------------------------------------------------\n// The prompt ends a capture. Standard prompts start \"7547h, 5989m\"; a custom\n// one is known by your health and mana from Char.Vitals, as room does.\nCR.promptRe = /^\\s*\\d+h, \\d+m\\b/;\nCR.isPrompt = function (raw) {\n  if (CR.promptRe.test(raw)) return true;\n  var hm = CR.vitHM;\n  if (!hm || !hm[0] || !hm[1]) return false;\n  return new RegExp(\"(^|\\\\D)\" + hm[0] + \"(\\\\D|$)\").test(raw) && new RegExp(\"(^|\\\\D)\" + hm[1] + \"(\\\\D|$)\").test(raw);\n};\nCR.re = {\n  date: /^(?:It is now|Today is) the (\\d+)(?:st|nd|rd|th) of (\\w+), (\\d+) years after/,\n  letter: /^You read what is written on (.+):\\s*$/,\n  news: /^([A-Z][A-Za-z ]*?) NEWS #(\\d+)\\s+\\((.+)\\)\\s*$/,\n  msg: /^Message #(\\d+)\\s+Sent by (\\S+)\\s*$/,\n  more: /^\\[Type MORE if you wish to continue reading\\./,\n  moreCmd: /^\\s*more\\s*$/i,\n  // Lines starting with a name that aren't emotes: talk (it comes by GMCP)\n  // and comings and goings.\n  talk: /^\\w+ (?:says|asks|exclaims|whispers|yells|shouts|tells|answers|replies|mutters|sings|quietly says)\\b/,\n  move: /^\\w+ (?:arrives|leaves|has arrived|has left|enters|walks|flies|swims|rides|sprints|bounds|lopes|slithers|crawls|limps|strides|trots|glides|wanders|stumbles|is here|appears|vanishes|disappears)\\b/\n};\nCR.line = function (raw) {\n  raw = CR.plain(raw);\n  if (CR.isPrompt(raw)) { if (CR.capt) CR.finish(); return; }\n  var m;\n  if ((m = CR.re.date.exec(raw))) { CR.setDate(parseInt(m[1], 10), m[2], parseInt(m[3], 10)); return; }\n  if ((m = CR.re.letter.exec(raw))) { CR.start({ k: \"letter\", what: m[1] }); return; }\n  if ((m = CR.re.news.exec(raw))) { CR.start({ k: \"news\", section: m[1], num: parseInt(m[2], 10), date: m[3] }); return; }\n  if ((m = CR.re.msg.exec(raw))) { CR.start({ k: \"msg\", num: parseInt(m[1], 10), who: m[2] }); return; }\n  if (CR.re.moreCmd.test(raw)) {\n    if (CR.cont && Date.now() - CR.cont.at < 600000) { CR.capt = { ev: CR.cont.ev, lines: [], at: Date.now(), more: true }; CR.cont = null; }\n    return;\n  }\n  if (CR.capt) {\n    if (CR.capt.ev.k == \"news\" && CR.re.more.test(raw)) { CR.cont = { ev: CR.capt.ev, at: Date.now() }; CR.finish(); return; }\n    CR.capt.lines.push(raw);\n    if (CR.capt.lines.length > 400) CR.finish();\n    return;\n  }\n  CR.emote(raw);\n};\nCR.start = function (ev) {\n  if (CR.capt) CR.finish();\n  CR.cont = null;\n  ev.t = Date.now();\n  CR.capt = { ev: ev, lines: [], at: ev.t, more: false };\n};\n// The captured lines, blank runs closed up, become the event's text.\nCR.finish = function () {\n  var c = CR.capt;\n  CR.capt = null;\n  if (!c) return;\n  var ev = c.ev, out = [], i;\n  for (i = 0; i < c.lines.length; i++) {\n    var ln = c.lines[i], f;\n    if (ev.k == \"news\" && !c.more) {\n      if ((f = /^From\\s*:\\s*(.*)$/.exec(ln))) { ev.from = f[1]; continue; }\n      if ((f = /^To\\s*:\\s*(.*)$/.exec(ln))) { ev.to = f[1]; continue; }\n      if ((f = /^Subject\\s*:\\s*(.*)$/.exec(ln))) { ev.subject = f[1]; continue; }\n      if (/^-{5,}\\s*$/.test(ln)) continue;\n    }\n    if (ev.k == \"msg\" && !out.length && (f = /^(\\d{4}\\/\\d\\d\\/\\d\\d\\/\\d\\d:\\d\\d)\\s+(.*)$/.exec(ln))) { ev.when = f[1]; ln = f[2]; }\n    if (!/\\S/.test(ln) && (!out.length || !/\\S/.test(out[out.length - 1]))) continue;\n    out.push(ln.replace(/^\\s+/, \"\"));\n  }\n  while (out.length && !/\\S/.test(out[out.length - 1])) out.pop();\n  var text = out.join(\"\\n\");\n  if (c.more) {\n    ev.text = CR.clip((ev.text ? ev.text + \"\\n\" : \"\") + text, CR.longMax);\n    CR.dirty();\n    return;\n  }\n  ev.text = CR.clip(text, CR.longMax);\n  if (!CR.known(ev)) CR.add(ev);\n  else if (CR.cont && CR.cont.ev === ev) CR.cont = null;\n};\n// A message or news post read again isn't recorded again; a letter read again\n// the same day isn't either.\nCR.known = function (ev) {\n  for (var i = CR.days.length - 1; i >= 0; i--) {\n    var b = CR.days[i];\n    for (var j = b.ev.length - 1; j >= 0; j--) {\n      var e = b.ev[j];\n      if (e.k !== ev.k) continue;\n      if (ev.k == \"news\" && e.section == ev.section && e.num == ev.num) return true;\n      if (ev.k == \"msg\" && e.num == ev.num) return true;\n      if (ev.k == \"letter\" && b.d === CR.dayOf(ev.t) && e.text == ev.text) return true;\n    }\n  }\n  return false;\n};\n// An emote: a line starting with the name of someone in your room (you too),\n// that isn't talk or a coming or going. Someone with more than a few lines a\n// minute is fighting, not emoting: left out for a while.\nCR.emote = function (raw) {\n  var m = /^([A-Z][a-z]+)\\b/.exec(raw);\n  if (!m) return;\n  var lc = m[1].toLowerCase();\n  if (!CR.players[lc] && lc !== String(CR.me).toLowerCase()) return;\n  if (CR.re.talk.test(raw) || CR.re.move.test(raw) || / says,? \"/.test(raw)) return;\n  var now = Date.now(), i;\n  for (i = 0; i < CR.recent.length; i++) { if (CR.recent[i][0] == raw) return; }\n  var rt = CR.rate[lc] || (CR.rate[lc] = { at: [], mute: 0 });\n  if (rt.mute > now) return;\n  while (rt.at.length && now - rt.at[0] > 60000) rt.at.shift();\n  rt.at.push(now);\n  if (rt.at.length > CR.emoteMax) {\n    rt.mute = now + CR.emoteMute;\n    // The burst so far was combat too: take it back out.\n    var b = CR.bucket(CR.dayOf(now), false);\n    if (b) { for (i = b.ev.length - 1; i >= 0; i--) { if (b.ev[i].k == \"emote\" && b.ev[i].who == m[1] && now - b.ev[i].t <= 60000) b.ev.splice(i, 1); } }\n    CR.dirty();\n    return;\n  }\n  CR.add({ t: now, k: \"emote\", who: m[1], text: CR.clip(raw, CR.textMax) });\n};\n\n// --- the record as text ----------------------------------------------------------\nCR.hhmm = function (t) { var d = new Date(t); return (\"0\" + d.getHours()).slice(-2) + \":\" + (\"0\" + d.getMinutes()).slice(-2); };\nCR.describe = function (e) {\n  switch (e.k) {\n    case \"place\": return \"In \" + e.area + (e.room ? \" (\" + e.room + \")\" : \"\");\n    case \"stay\": return \"Stayed \" + (e.min || 0) + \" min in \" + e.room + (e.area ? \", \" + e.area : \"\") + (e.with && e.with.length ? \", with \" + e.with.join(\", \") : \"\");\n    case \"chan\": return \"[\" + e.name + \"] \" + e.text;\n    case \"emote\": return e.text;\n    case \"letter\": return \"Read \" + e.what + \":\\n\" + (e.text || \"\");\n    case \"msg\": return \"Message from \" + e.who + \": \" + (e.text || \"\");\n    case \"news\": return \"Read \" + e.section + \" news #\" + e.num + (e.subject ? \", \\\"\" + e.subject + \"\\\"\" : \"\") + (e.from ? \" by \" + e.from : \"\") + \":\\n\" + (e.text || \"\");\n    case \"note\": return \"Note: \" + e.text;\n    case \"link\": return e.text + \" (\" + e.src + \")\";\n  }\n  return String(e.text || \"\");\n};\nCR.markdown = function (days) {\n  var out = [\"# Chronicle\" + (CR.me ? \" of \" + CR.me : \"\"), \"\"];\n  for (var i = 0; i < days.length; i++) {\n    var b = days[i];\n    if (!b.ev.length) continue;\n    out.push(\"## \" + CR.dayName(b.d), \"\");\n    for (var j = 0; j < b.ev.length; j++) {\n      var e = b.ev[j], txt = CR.describe(e).split(\"\\n\");\n      out.push(\"- \" + CR.hhmm(e.t) + \" **\" + e.k + \"** \" + txt[0]);\n      for (var l = 1; l < txt.length; l++) out.push(\"  > \" + txt[l]);\n    }\n    out.push(\"\");\n  }\n  return out.join(\"\\n\");\n};\n// A Markdown file of the whole record, downloaded by the browser.\nCR.download = function () {\n  var md = CR.markdown(CR.days);\n  CR.lastExport = md;\n  try {\n    var blob = new Blob([md], { type: \"text/markdown\" });\n    var a = document.createElement(\"a\");\n    var d = new Date();\n    a.href = URL.createObjectURL(blob);\n    a.download = \"chronicle-\" + (CR.me || \"character\").toLowerCase() + \"-\" + d.getFullYear() + \"-\" + (\"0\" + (d.getMonth() + 1)).slice(-2) + \"-\" + (\"0\" + d.getDate()).slice(-2) + \".md\";\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    setTimeout(function () { try { URL.revokeObjectURL(a.href); } catch (e) {} }, 10000);\n    return true;\n  } catch (e) { return false; }\n};\n\n// --- what other packages offer, through loom -------------------------------------\n// entry.record({ source, key, text, at }): one line in the record, tagged with\n// its source; the same source and key is recorded once. entry.withdraw(source\n// [, key]) takes them back out of the current day (earlier days are history).\nCR.entry = {\n  record: function (it) {\n    if (!it || !it.source || !it.text) return false;\n    var src = String(it.source), key = String(it.key === undefined ? \"\" : it.key);\n    for (var i = 0; i < CR.days.length; i++) {\n      for (var j = 0; j < CR.days[i].ev.length; j++) { var e = CR.days[i].ev[j]; if (e.k == \"link\" && e.src == src && e.key == key) return false; }\n    }\n    CR.add({ t: (typeof it.at == \"number\" && it.at > 0 && it.at <= Date.now()) ? it.at : Date.now(), k: \"link\", src: src, key: key, text: CR.clip(String(it.text), CR.textMax) });\n    return true;\n  },\n  withdraw: function (source, key) {\n    var b = CR.bucket(CR.today(), false);\n    if (!b) return;\n    var n = b.ev.length;\n    b.ev = b.ev.filter(function (e) { return !(e.k == \"link\" && e.src == String(source) && (key === undefined || e.key == String(key))); });\n    if (b.ev.length !== n) CR.dirty();\n  }\n};\n// What it offers: the record of a day (today if none given).\nCR.look = {\n  day: function (d) { var b = CR.bucket(d === undefined ? CR.today() : d, false); return b ? b.ev.slice() : []; }\n};\n"
  },
  {
   "type": "function",
   "name": "chronicle_gmcp",
   "enabled": true,
   "code": "// chronicle_gmcp -- the work behind onGMCP, as a function made once per load\n// (client.loom.hooks.chronicle.gmcp): onGMCP runs on every message, so the\n// script itself stays short (#136). Run from onLoad and onInstall.\nif (!client.loom) client.loom = {};\nif (!client.loom.hooks) client.loom.hooks = {};\nif (!client.loom.hooks.chronicle) client.loom.hooks.chronicle = {};\nclient.loom.hooks.chronicle.gmcp = function (args) {\n  var m = args && args.gmcp_method;\n  if (m !== \"Char.Vitals\" && m !== \"Room.Info\" && m !== \"Comm.Channel.Text\" && m !== \"Room.Players\" && m !== \"Room.AddPlayer\" &&\n      m !== \"Room.RemovePlayer\" && m !== \"Comm.Channel.List\" && m !== \"Char.Name\" && m !== \"Char.Status\") return;\n  if (!client.loom.chronicle || !client.loom.chronicle.line) run_function(\"chronicle_setup\", [], \"chronicle\");\n  var CR = client.loom.chronicle;\n  var raw = args.gmcp_args;\n  if (typeof raw == \"string\" && m !== \"Room.RemovePlayer\") { try { raw = JSON.parse(raw); } catch (e) { raw = null; } }\n  var g = (raw && typeof raw == \"object\") ? raw : {};\n  if (m === \"Char.Vitals\") {\n    if (g.hp !== undefined && g.mp !== undefined) CR.vitHM = [String(g.hp).replace(/\\D/g, \"\"), String(g.mp).replace(/\\D/g, \"\")];\n    CR.tick();\n  } else if (m === \"Room.Info\") {\n    CR.enter(g);\n  } else if (m === \"Comm.Channel.Text\") {\n    CR.chan(g);\n  } else if (m === \"Room.Players\") {\n    CR.players = {};\n    if (Array.isArray(raw)) { for (var i = 0; i < raw.length; i++) { if (raw[i] && raw[i].name) CR.meet(raw[i].name); } }\n  } else if (m === \"Room.AddPlayer\") {\n    if (g.name) CR.meet(g.name);\n  } else if (m === \"Room.RemovePlayer\") {\n    var gone = String(typeof raw == \"string\" ? raw : (g.name || \"\")).replace(/^\"|\"$/g, \"\").toLowerCase();\n    if (gone) delete CR.players[gone];\n  } else if (m === \"Comm.Channel.List\") {\n    if (Array.isArray(raw)) { for (var j = 0; j < raw.length; j++) { if (raw[j] && raw[j].name && raw[j].caption) CR.captions[String(raw[j].name)] = String(raw[j].caption); } }\n  } else if (g.name) {\n    var n = String(g.name).split(/\\s+/)[0];\n    if (n && n !== CR.me) { CR.me = n; set_variable(\"chronicle_name\", n); }\n  }\n};\n"
  },
  {
   "type": "function",
   "name": "chronicle_render",
   "enabled": true,
   "code": "// chronicle_render -- the 'Chronicle' custom tab, in the house style shared\n// with Ledger and Coffers: ink panel, serif small-caps headings, monospace\n// rows. Today's record, newest first; then the earlier days kept, with how\n// much each holds.\nif (!client.loom || !client.loom.chronicle || !client.loom.chronicle.line) run_function(\"chronicle_setup\", [], \"chronicle\");\nvar CR = client.loom.chronicle;\nCR.borrowDate();\n\n// Tab theme (#310): loom's city palette when one is on, else this tab's own colours.\nvar TH = (client.loom && client.loom.theme) || {};\nvar PARCH = TH.acc || \"#e6d5ac\";\nvar SEPIA = TH.deep || \"#8b6b47\";\nvar TXT = TH.txt || \"#e4dccb\";\nvar MUTED = TH.muted || \"#8c8272\";\nvar RULE = TH.rule || \"#352c22\";\nvar BG = TH.bg || \"#15120e\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\n// One colour per kind, muted enough to read as ink.\nvar KIND = {\n  place: [\"#9cc96b\", \"place\"], stay: [\"#9cc96b\", \"stay\"], chan: [\"#7fb2c9\", \"said\"], emote: [\"#c9a27f\", \"emote\"],\n  letter: [\"#e0a95a\", \"letter\"], msg: [\"#e0a95a\", \"message\"], news: [\"#e0a95a\", \"news\"], note: [\"#e6d5ac\", \"note\"], link: [\"#b39ddb\", \"deed\"]\n};\n\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\"); }\nfunction caps(t, col) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (col || SEPIA) + ';font-size:11px;margin:0 0 2px;\">' + t + '</div>'; }\nfunction section(title, inner, col) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title, col) + inner + '</div>'; }\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">' + t + '</div>'; }\n// One row: the time in the margin, the kind, and the entry. Long texts\n// (letters, news) show their first line; the whole text on hover.\nfunction row(e) {\n  var kd = KIND[e.k] || [TXT, e.k];\n  var full = CR.describe(e);\n  var first = full.split(\"\\n\")[0];\n  var more = full.indexOf(\"\\n\") >= 0;\n  return '<div style=\"display:flex;gap:6px;align-items:baseline;border-bottom:1px dotted ' + RULE + ';padding:2px 0;\"' + (more ? ' title=\"' + esc(CR.clip(full, 1500)) + '\"' : '') + '>' +\n    '<span style=\"color:' + SEPIA + ';min-width:3.2em;\">' + CR.hhmm(e.t) + '</span>' +\n    '<span style=\"color:' + kd[0] + ';min-width:4.6em;font-family:' + SERIF + ';font-variant:small-caps;\">' + kd[1] + '</span>' +\n    '<span style=\"flex:1 1 auto;min-width:0;color:' + TXT + ';overflow-wrap:anywhere;\">' + esc(first) + (more ? ' <span style=\"color:' + MUTED + ';\">&hellip;</span>' : '') + '</span></div>';\n}\n\nvar book = '<svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<path d=\"M8 4 C6 2.6 3.5 2.4 1 3 L1 13 C3.5 12.4 6 12.6 8 14 Z\" fill=\"' + PARCH + '\"/><path d=\"M8 4 C10 2.6 12.5 2.4 15 3 L15 13 C12.5 12.4 10 12.6 8 14 Z\" fill=\"' + PARCH + '\" opacity=\"0.8\"/>' +\n  '<path d=\"M8 4 L8 14\" stroke=\"' + SEPIA + '\" stroke-width=\"0.8\"/></svg>';\n\nvar today = CR.today();\nvar cur = CR.bucket(today, false);\nvar html = '<div id=\"loom-chronicle\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + BG + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;min-height:100%;box-sizing:border-box;\">';\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + SEPIA + ';padding-bottom:3px;\">';\nhtml += '<div style=\"font-family:' + SERIF + ';color:' + PARCH + ';font-size:14px;letter-spacing:0.22em;\">' + book + 'CHRONICLE</div>';\nhtml += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + SEPIA + ';font-size:11px;\">' + (cur ? cur.ev.length : 0) + ' today &middot; ' + CR.days.length + ' day' + (CR.days.length === 1 ? '' : 's') + ' kept</div></div>';\n\nif (today) {\n  html += '<div style=\"margin:6px 0 2px;\"><span style=\"font-family:' + SERIF + ';font-size:20px;color:' + PARCH + ';\">' + esc(CR.dayName(today).replace(/, \\d+ AF$/, \"\")) + '</span>';\n  html += ' <span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">' + esc(CR.dayName(today).replace(/^.*, /, \"the year \")) + '</span></div>';\n} else {\n  html += '<div style=\"margin:6px 0 2px;font-family:' + SERIF + ';font-size:18px;color:' + MUTED + ';font-style:italic;\">date not yet known</div>';\n  html += '<div style=\"color:' + MUTED + ';\">It comes with the next hour\\'s date line, or type DATE.</div>';\n}\n\n// Today, newest first.\nvar td = \"\";\nif (!cur || !cur.ev.length) td = quiet(\"Nothing recorded yet this day.\");\nelse {\n  var shown = 0;\n  for (var i = cur.ev.length - 1; i >= 0 && shown < 150; i--, shown++) td += row(cur.ev[i]);\n  if (cur.ev.length > shown) td += quiet((cur.ev.length - shown) + \" earlier entries: CHRONICLE EXPORT for all of them.\");\n}\nhtml += section(today ? \"This day\" : \"Before the date was known\", td, PARCH);\n\n// Earlier days, newest first, with what they hold.\nvar ea = \"\";\nfor (var j = CR.days.length - 1; j >= 0; j--) {\n  var b = CR.days[j];\n  if (b === cur) continue;\n  var n = {};\n  for (var k = 0; k < b.ev.length; k++) n[b.ev[k].k] = (n[b.ev[k].k] || 0) + 1;\n  var bits = [];\n  if (n.place || n.stay) bits.push(((n.place || 0) + (n.stay || 0)) + \" places\");\n  if (n.chan) bits.push(n.chan + \" said\");\n  if (n.emote) bits.push(n.emote + \" emotes\");\n  if (n.letter || n.msg || n.news) bits.push(((n.letter || 0) + (n.msg || 0) + (n.news || 0)) + \" read\");\n  if (n.note) bits.push(n.note + \" notes\");\n  if (n.link) bits.push(n.link + \" deeds\");\n  ea += '<div style=\"display:flex;gap:6px;align-items:baseline;border-bottom:1px dotted ' + RULE + ';padding:2px 0;\">' +\n    '<span style=\"flex:1 1 auto;color:' + TXT + ';\">' + esc(CR.dayName(b.d)) + '</span>' +\n    '<span style=\"color:' + MUTED + ';white-space:nowrap;\">' + esc(bits.join(\" · \") || \"empty\") + '</span></div>';\n}\nif (ea) html += section(\"Earlier days\", ea, PARCH);\n\nhtml += '</div>';\n// The whole tab in the panel's colour (#355), as Ledger does.\ntry {\n  var crSt = document.getElementById(\"loom-chronicle-style\");\n  if (!crSt) { crSt = document.createElement(\"style\"); crSt.id = \"loom-chronicle-style\"; document.head.appendChild(crSt); }\n  var crCss = '.flexlayout__tab:has(#loom-chronicle) { background: ' + BG + ' !important; } .flexlayout__tab:has(#loom-chronicle) > * { min-height: 100%; }';\n  if (crSt.textContent !== crCss) crSt.textContent = crCss;\n} catch (e) {}\ntry { set_custom_tab_html(\"Chronicle\", html); } catch (e) {}\n"
  },
  {
   "type": "function",
   "name": "chronicle_help",
   "enabled": true,
   "code": "// chronicle_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[chronicle] a record of each Achaean day. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"CHRONICLE\", \"today's date and what has been recorded\"],\n  [\"CHRONICLE NOTE <text>\", \"add a note of your own to today's record\"],\n  [\"CHRONICLE CHANNELS\", \"the channels heard this session, and which are kept\"],\n  [\"CHRONICLE CHANNEL <name> ON|OFF\", \"keep or leave out a channel (TELLS for all tells)\"],\n  [\"CHRONICLE CHANNEL <name> DEFAULT\", \"back to the default for that channel\"],\n  [\"CHRONICLE EXPORT\", \"download the whole record as a Markdown file\"],\n  [\"CHRONICLE EXPORT SHOW\", \"print the last export here, if no download started\"],\n  [\"CHRONICLE DEBUG\", \"internal state\"],\n  [\"CHRONICLE RESET\", \"rebuild from the saved variables (the record is kept)\"],\n  [\"CHRONICLE CLEAR CONFIRM\", \"throw the whole record away\"],\n  [\"Kept by itself: areas you spend a minute in, rooms you stay five minutes in (and who was\"],\n  [\"there), IC channels (say, tells, yell, city, house, order, clans, the gods' emotes), emotes\"],\n  [\"in your room, and letters, messages and news you read. Anything after // is taken as OOC.\"],\n  [\"The record keeps the last 30 Achaean days you played in (one Achaean day is one real hour),\"],\n  [\"saved with your character's settings, so it follows you to any device.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "Chronicle control",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// CHRONICLE [command] -- see chronicle_help.\nif (!client.loom || !client.loom.chronicle || !client.loom.chronicle.line) run_function(\"chronicle_setup\", [], \"chronicle\");\nvar CR = client.loom.chronicle;\nvar crIn = String(args[1] || \"\").replace(/^\\s+|\\s+$/g, \"\");\nvar crW = crIn.split(/\\s+/);\nvar crCmd = crIn ? crW[0].toUpperCase() : \"\";\nvar crRest = crIn.replace(/^\\S+\\s*/, \"\");\nCR.borrowDate();\nif (crCmd === \"\" || crCmd === \"STATUS\") {\n  var crToday = CR.today();\n  var crB = CR.bucket(crToday, false);\n  var crKept = 0;\n  for (var crI = 0; crI < CR.days.length; crI++) crKept += CR.days[crI].ev.length;\n  display_notice(\"[chronicle] \" + (crToday ? \"Today is the \" + CR.dayName(crToday) + \".\" : \"The date isn't known yet: it comes with the next hour's date line, or DATE.\") +\n    \" Today: \" + (crB ? crB.ev.length : 0) + \" entr\" + (crB && crB.ev.length === 1 ? \"y\" : \"ies\") + \". Kept: \" + CR.days.length + \" day\" + (CR.days.length === 1 ? \"\" : \"s\") + \", \" + crKept + \" entries.\", \"cyan\");\n} else if (crCmd === \"HELP\") {\n  run_function(\"chronicle_help\", [], \"chronicle\");\n} else if (crCmd === \"NOTE\") {\n  if (!crRest) display_notice(\"[chronicle] usage: CHRONICLE NOTE <text>\", \"orange\");\n  else { CR.add({ k: \"note\", text: CR.clip(crRest, CR.textMax) }); display_notice(\"[chronicle] noted.\", \"lime\"); }\n} else if (crCmd === \"CHANNELS\") {\n  var crKeys = {};\n  for (var crK in CR.seen) { if (CR.seen.hasOwnProperty(crK)) crKeys[crK] = true; }\n  for (var crO in CR.over) { if (CR.over.hasOwnProperty(crO)) crKeys[crO] = true; }\n  var crList = [];\n  for (var crL in crKeys) { if (crKeys.hasOwnProperty(crL)) crList.push(crL); }\n  crList.sort();\n  if (!crList.length) display_notice(\"[chronicle] no channel heard yet this session.\", \"cyan\");\n  else {\n    display_notice(\"[chronicle] channels (heard this session or set by you):\", \"cyan\");\n    for (var crJ = 0; crJ < crList.length; crJ++) {\n      var crC = crList[crJ];\n      var crOn = crC === \"tells\" ? (CR.over.tells !== undefined ? !!CR.over.tells : true) : CR.chanOn(crC);\n      var crCap = CR.captions[crC] ? \" (\" + CR.captions[crC] + \")\" : \"\";\n      display_notice(\"  \" + crC + crCap + \": \" + (crOn ? \"kept\" : \"left out\") + (CR.over[crC] !== undefined ? \", set by you\" : \"\"), crOn ? \"lime\" : \"cyan\");\n    }\n  }\n} else if (crCmd === \"CHANNEL\") {\n  var crName = String(crW[1] || \"\").toLowerCase();\n  var crSw = String(crW[2] || \"\").toUpperCase();\n  if (!crName || (crSw !== \"ON\" && crSw !== \"OFF\" && crSw !== \"DEFAULT\")) display_notice(\"[chronicle] usage: CHRONICLE CHANNEL <name> ON|OFF|DEFAULT (names as CHRONICLE CHANNELS shows them)\", \"orange\");\n  else {\n    if (crName === \"tell\") crName = \"tells\";\n    if (crSw === \"DEFAULT\") delete CR.over[crName];\n    else CR.over[crName] = crSw === \"ON\";\n    set_variable(\"chronicle_channels\", JSON.stringify(CR.over));\n    display_notice(\"[chronicle] \" + crName + \": \" + (crSw === \"DEFAULT\" ? \"back to the default (\" + ((crName === \"tells\" || CR.chanDefault(crName)) ? \"kept\" : \"left out\") + \")\" : (crSw === \"ON\" ? \"kept\" : \"left out\")) + \".\", \"lime\");\n  }\n} else if (crCmd === \"EXPORT\") {\n  if (String(crW[1] || \"\").toUpperCase() === \"SHOW\") {\n    var crMd = CR.lastExport || CR.markdown(CR.days);\n    var crEsc = crMd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    if (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\") nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre-wrap\">' + crEsc + '</span>');\n    else display_notice(crMd, \"cyan\");\n  } else if (!CR.days.length) {\n    display_notice(\"[chronicle] nothing recorded yet.\", \"cyan\");\n  } else if (CR.download()) {\n    display_notice(\"[chronicle] exported \" + CR.days.length + \" day\" + (CR.days.length === 1 ? \"\" : \"s\") + \" as a Markdown file. No download? CHRONICLE EXPORT SHOW prints it here to copy.\", \"lime\");\n  } else {\n    display_notice(\"[chronicle] the browser refused the download: CHRONICLE EXPORT SHOW prints the record here to copy.\", \"orange\");\n  }\n} else if (crCmd === \"DEBUG\") {\n  var crN = 0;\n  for (var crD = 0; crD < CR.days.length; crD++) crN += CR.days[crD].ev.length;\n  display_notice(\"[chronicle] me=\" + (CR.me || \"?\") + \" anchor=\" + (CR.anchor ? JSON.stringify(CR.anchor) : \"none\") + \" today=\" + CR.today() +\n    \" days=\" + CR.days.length + \" events=\" + crN + \" bytes~\" + JSON.stringify(CR.days).length +\n    \" room=\" + (CR.room ? CR.room.name + \" (\" + Math.round((Date.now() - CR.room.at) / 1000) + \"s)\" : \"none\") +\n    \" area=\" + (CR.area ? CR.area.name : \"none\") + \" players=\" + Object.keys(CR.players).join(\",\") +\n    \" capture=\" + (CR.capt ? CR.capt.ev.k + \"/\" + CR.capt.lines.length : \"none\") + \" more=\" + (CR.cont ? \"waiting\" : \"no\") +\n    \" overrides=\" + JSON.stringify(CR.over), \"cyan\");\n} else if (crCmd === \"RESET\") {\n  if (CR.saveT) { clearTimeout(CR.saveT); CR.saveT = null; CR.save(); }\n  client.loom.chronicle = {};\n  run_function(\"chronicle_setup\", [], \"chronicle\");\n  run_function(\"chronicle_render\", [], \"chronicle\");\n  display_notice(\"[chronicle] rebuilt from the saved variables; the record is kept.\", \"lime\");\n} else if (crCmd === \"CLEAR\") {\n  var crAll = 0;\n  for (var crE = 0; crE < CR.days.length; crE++) crAll += CR.days[crE].ev.length;\n  if (String(crW[1] || \"\").toUpperCase() !== \"CONFIRM\") display_notice(\"[chronicle] this throws away the whole record (\" + CR.days.length + \" days, \" + crAll + \" entries). CHRONICLE CLEAR CONFIRM to do it; CHRONICLE EXPORT first to keep a copy.\", \"orange\");\n  else {\n    CR.days = [];\n    CR.save();\n    run_function(\"chronicle_render\", [], \"chronicle\");\n    display_notice(\"[chronicle] the record is cleared.\", \"lime\");\n  }\n} else {\n  display_notice(\"[chronicle] unknown command '\" + crW[0] + \"'. CHRONICLE HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^chronicle(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "Chronicle every line",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Every line: the work is in chronicle_setup's CR.line (#136: this runs on every game line, so it stays short).\nif (!client.loom || !client.loom.chronicle || !client.loom.chronicle.line) run_function(\"chronicle_setup\", [], \"chronicle\");\nclient.loom.chronicle.line(args[0]);\n"
    }
   ],
   "text": "^(.*)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  }
 ],
 "description": "A record of each Achaean day: places, IC talk, letters and news, notes"
}