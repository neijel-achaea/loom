{
 "type": "group",
 "name": "chronicle",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"chronicle_setup\", [], \"chronicle\");\nrun_function(\"chronicle_gmcp\", [], \"chronicle\");\ndisplay_notice(\"[chronicle] installed: keeping a record of each Achaean day. Make a custom tab called Chronicle to see it; CHRONICLE HELP for commands. Summaries are optional: they need your own Anthropic API key, cost money, and send each day's record (including what others say around you) to Anthropic. See the package page before turning them on.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// The chronicle_* variables are left intact; what's unsaved is saved now.\nif (client.loom && client.loom.chronicle) {\n  var crU = client.loom.chronicle;\n  if (crU.saveT) { clearTimeout(crU.saveT); crU.saveT = null; if (crU.save) crU.save(); }\n  if (crU.drawT) { clearTimeout(crU.drawT); crU.drawT = null; }\n  if (crU.retryT) { clearTimeout(crU.retryT); crU.retryT = null; }\n  crU.queue = [];\n  crU.capt = null;\n}\n// Leave LOOM and the integrations at once, not at the next load (#137).\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"chronicle\");\n  else delete client.loom.registry.chronicle;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it. An open book.\nvar tiTabs = [[\"Chronicle\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\"><path d=\"M8 4 C6 2.6 3.5 2.4 1 3 L1 13 C3.5 12.4 6 12.6 8 14 Z\" fill=\"#e6d5ac\"/><path d=\"M8 4 C10 2.6 12.5 2.4 15 3 L15 13 C12.5 12.4 10 12.6 8 14 Z\" fill=\"#cdb98a\"/><path d=\"M8 4 L8 14\" stroke=\"#8b6b47\" stroke-width=\"0.8\"/><path d=\"M3 5.5 L6.2 6 M3 7.5 L6.2 8 M3 9.5 L6.2 10 M9.8 6 L13 5.5 M9.8 8 L13 7.5\" stroke=\"#8b6b47\" stroke-width=\"0.5\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\nrun_function(\"chronicle_setup\", [], \"chronicle\");\nrun_function(\"chronicle_gmcp\", [], \"chronicle\");\nrun_function(\"chronicle_render\", [], \"chronicle\");\n// Days that ended while you were away get their summaries, once things settle.\nsetTimeout(function () { var c = client.loom && client.loom.chronicle; if (c && c.due) { c.seenDay = c.today(); c.due(); } }, 15000);\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// The work is in chronicle_gmcp (#136: this runs on every GMCP message, so it stays short).\nvar crH = client.loom && client.loom.hooks && client.loom.hooks.chronicle;\nif (!crH || !crH.gmcp) { run_function(\"chronicle_gmcp\", [], \"chronicle\"); crH = client.loom.hooks.chronicle; }\ncrH.gmcp(args);\n"
  },
  {
   "type": "function",
   "name": "chronicle_setup",
   "enabled": true,
   "code": "// chronicle_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, saved state, helpers.\n//\n// Chronicle (#491) keeps a record of what happens to your character, one\n// Achaean day (one real hour) at a time: the areas you spend time in and the\n// rooms you linger in, the IC channels, emotes in your room, the letters,\n// messages and news you read, notes you add, and what other packages report\n// through loom. This is the record only; summaries written from it come in a\n// later version (docs/chronicle.md).\n//\n// Data kept, per day: CR.days = [{ d, ev: [event...] }], oldest first, saved\n// in chronicle_days. d is the Achaean day number (as ledger's: year * 300 +\n// month * 25 + day, months from 0), 0 for events from before the date was\n// known. Every event has t (ms) and k (its kind):\n//   place  { area, room }             an area you spent a minute or more in\n//   stay   { room, area, min, with }  a room you stayed in 5 minutes or more\n//   chan   { ch, name, who, text }    a line on an IC channel (tells too)\n//   emote  { who, text }              an emote by someone in your room\n//   letter { what, text }             a letter you read\n//   msg    { num, who, text }         a message you read\n//   news   { section, num, date, from, to, subject, text }\n//   note   { text }                   CHRONICLE NOTE\n//   link   { src, key, text }         from another package, through loom\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.chronicle) client.loom.chronicle = {};\nclient.loom.registry.chronicle = { version: \"0.2.1\", keyword: \"CHRONICLE\", desc: \"A record of each Achaean day: places, IC talk, letters and news, notes\",\n  redraw: function () { run_function(\"chronicle_render\", [], \"chronicle\"); } };\nvar CR = client.loom.chronicle;\n\n// Limits. A day keeps its last perDay events; the record keeps maxDays days,\n// and drops the oldest while it's over maxBytes saved.\nCR.perDay = 600;\nCR.maxDays = 30;\nCR.maxBytes = 400000;\nCR.textMax = 600;     // a channel line or emote\nCR.longMax = 5000;    // a letter, message or news post\nCR.areaMs = 60000;    // an area counts after a minute in it\nCR.stayMs = 300000;   // a room after five minutes\nCR.capMs = 10000;     // a capture with no prompt seen ends after this\nCR.emoteMax = 6;      // emotes from one person in a minute before they're taken for combat\nCR.emoteMute = 120000;\n\n// Saved state. A variable that isn't a readable table starts afresh (#135).\nCR.readVar = function (name) {\n  var v;\n  try { v = get_variable(name); } catch (e) { v = undefined; }\n  if (typeof v == \"string\") { try { v = JSON.parse(v); } catch (e) { v = null; } }\n  return v;\n};\nif (!Array.isArray(CR.days)) {\n  var crD = CR.readVar(\"chronicle_days\");\n  CR.days = [];\n  if (Array.isArray(crD)) {\n    for (var crI = 0; crI < crD.length; crI++) {\n      var crB = crD[crI];\n      if (crB && typeof crB == \"object\" && typeof crB.d == \"number\" && Array.isArray(crB.ev)) {\n        var crNb = { d: crB.d, ev: crB.ev.filter(function (e) { return e && typeof e == \"object\" && e.k; }) };\n        if (crB.sum && typeof crB.sum == \"object\" && typeof crB.sum.text == \"string\") crNb.sum = crB.sum;\n        if (typeof crB.fails == \"number\") crNb.fails = crB.fails;\n        CR.days.push(crNb);\n      }\n    }\n  }\n}\nif (!CR.anchor) {\n  var crA = CR.readVar(\"chronicle_anchor\");\n  CR.anchor = (crA && typeof crA == \"object\" && typeof crA.d == \"number\" && crA.d > 0 && typeof crA.at == \"number\") ? crA : null;\n}\nif (!CR.over || typeof CR.over != \"object\") {\n  var crO = CR.readVar(\"chronicle_channels\");\n  CR.over = (crO && typeof crO == \"object\" && !Array.isArray(crO)) ? crO : {};\n}\n// People left out of the record entirely (CHRONICLE IGNORE): their words,\n// emotes, messages and posts aren't kept, and their name is left off the\n// lists of who was there. Lower case.\nif (!Array.isArray(CR.ignore)) {\n  var crIg = CR.readVar(\"chronicle_ignore\");\n  CR.ignore = Array.isArray(crIg) ? crIg.filter(function (n) { return typeof n == \"string\" && n; }).map(function (n) { return n.toLowerCase(); }) : [];\n}\nCR.ignored = function (name) { return !!name && CR.ignore.indexOf(String(name).split(/[\\s,]+/)[0].toLowerCase()) >= 0; };\n// Their name, where another line mentions it, becomes \"someone\".\nCR.scrub = function (text) {\n  text = String(text);\n  for (var i = 0; i < CR.ignore.length; i++) text = text.replace(new RegExp(\"\\\\b\" + CR.ignore[i] + \"\\\\b\", \"gi\"), \"someone\");\n  return text;\n};\n// Takes what's already kept about them back out (summaries already written\n// stay as they are).\nCR.purge = function (name) {\n  var lc = String(name).toLowerCase(), n = 0;\n  for (var i = 0; i < CR.days.length; i++) {\n    var b = CR.days[i], before = b.ev.length;\n    b.ev = b.ev.filter(function (e) {\n      if ((e.k == \"chan\" || e.k == \"emote\" || e.k == \"msg\") && String(e.who).split(/[\\s,]+/)[0].toLowerCase() === lc) return false;\n      if (e.k == \"chan\" && e.to && String(e.to).toLowerCase() === lc) return false;\n      if (e.k == \"news\" && String(e.from || \"\").split(/[\\s,]+/)[0].toLowerCase() === lc) return false;\n      return true;\n    });\n    n += before - b.ev.length;\n    for (var j = 0; j < b.ev.length; j++) {\n      var e = b.ev[j];\n      if (e.with && e.with.length) e.with = e.with.filter(function (w) { return String(w).toLowerCase() !== lc; });\n      if (e.k == \"link\" || e.k == \"chan\" || e.k == \"emote\") e.text = CR.scrub(e.text);\n    }\n  }\n  CR.dirty();\n  return n;\n};\nif (CR.me === undefined) { var crM = CR.readVar(\"chronicle_name\"); CR.me = typeof crM == \"string\" ? crM : \"\"; }\nif (!CR.seen) CR.seen = {};        // channel key -> true, heard this session\nif (!CR.captions) CR.captions = {};\nif (!CR.players) CR.players = {};  // lower-case name -> name, in your room\nif (!CR.room) CR.room = null;\nif (!CR.area) CR.area = null;\nif (!CR.rate) CR.rate = {};\nif (!CR.recent) CR.recent = [];    // channel lines just heard: [plain, at]\nif (CR.capt === undefined) CR.capt = null;\nif (!CR.view) { var crVw = CR.readVar(\"chronicle_view\"); CR.view = (crVw === \"months\" || crVw === \"years\") ? crVw : \"days\"; }\nCR.setView = function (v) {\n  CR.view = v;\n  set_variable(\"chronicle_view\", v);\n  run_function(\"chronicle_render\", [], \"chronicle\");\n};\n// The tab's headings are clicked through this (inline handlers, as atlas's).\nwindow.loomChronicle = { view: function (v) { if (client.loom && client.loom.chronicle && client.loom.chronicle.setView) client.loom.chronicle.setView(v); } };\nif (CR.cont === undefined) CR.cont = null;\n\n// --- time and days ---------------------------------------------------------\n// One Achaean day is one real hour, and a new one begins at the top of the\n// hour (Ricardo). So from one known date (the anchor) any moment's day is\n// worked out by counting whole hours: the date stays right across reloads and\n// time away. Every date line the game shows moves the anchor.\nCR.hour = function (t) { return Math.floor(t / 3600000); };\nCR.dayOf = function (t) {\n  var a = CR.anchor;\n  return a ? a.d + CR.hour(t) - CR.hour(a.at) : 0;\n};\nCR.months = [\"Sarapin\", \"Daedalan\", \"Aeguary\", \"Miraman\", \"Scarlatan\", \"Ero\", \"Valnuary\", \"Lupar\", \"Phaestian\", \"Chronos\", \"Glacian\", \"Mayan\"];\nCR.ord = function (n) {\n  var s = (n % 100 >= 11 && n % 100 <= 13) ? \"th\" : ([\"th\", \"st\", \"nd\", \"rd\"][n % 10] || \"th\");\n  return n + s;\n};\nCR.dayName = function (d) {\n  if (!d) return \"undated\";\n  var n = d - 1, y = Math.floor(n / 300), r = n - y * 300;\n  return CR.ord((r % 25) + 1) + \" \" + CR.months[Math.floor(r / 25)] + \", \" + y + \" AF\";\n};\n// A date line: \"It is now the 5th of Lupar, 1016 years after...\" (the hourly\n// rollover) or \"Today is the ...\" (DATE).\nCR.setDate = function (dd, month, yy) {\n  var mi = -1;\n  for (var i = 0; i < CR.months.length; i++) { if (CR.months[i].toLowerCase() == String(month).toLowerCase()) mi = i; }\n  if (mi < 0) return;\n  var d = yy * 300 + mi * 25 + dd;\n  var had = !!CR.anchor;\n  CR.anchor = { d: d, at: Date.now() };\n  set_variable(\"chronicle_anchor\", JSON.stringify(CR.anchor));\n  if (!had) CR.relabel();\n  CR.dirty();\n};\n// Ledger's date, when it has one and ours is missing.\nCR.borrowDate = function () {\n  var lg = client.loom && client.loom.ledger;\n  if (!CR.anchor && lg && typeof lg.day == \"number\" && lg.day > 0) {\n    CR.anchor = { d: lg.day, at: Date.now() };\n    set_variable(\"chronicle_anchor\", JSON.stringify(CR.anchor));\n    CR.relabel();\n  }\n};\n// Events kept before the date was known go to their own day once it is.\nCR.relabel = function () {\n  var und = null, i;\n  for (i = 0; i < CR.days.length; i++) { if (CR.days[i].d === 0) und = CR.days.splice(i, 1)[0]; }\n  if (!und || !CR.anchor) { if (und) CR.days.unshift(und); return; }\n  for (i = 0; i < und.ev.length; i++) CR.put(und.ev[i]);\n};\nCR.today = function () { return CR.dayOf(Date.now()); };\nCR.bucket = function (d, make) {\n  for (var i = CR.days.length - 1; i >= 0; i--) { if (CR.days[i].d === d) return CR.days[i]; }\n  if (!make) return null;\n  var b = { d: d, ev: [] };\n  var at = CR.days.length;\n  while (at > 0 && CR.days[at - 1].d > d) at--;\n  CR.days.splice(at, 0, b);\n  return b;\n};\n\n// --- recording ---------------------------------------------------------------\nCR.plain = function (s) { return String(s === undefined || s === null ? \"\" : s).replace(/\\u001b\\[[0-9;]*m/g, \"\").replace(/[\\u0000-\\u0009\\u000b-\\u001f]/g, \"\").replace(/\\s+$/, \"\"); };\nCR.clip = function (s, n) { s = String(s); return s.length > n ? s.slice(0, n - 1) + \"\\u2026\" : s; };\nCR.put = function (ev) {\n  var b = CR.bucket(CR.dayOf(ev.t), true);\n  // In time order: an area or a stay is recorded when it has lasted, but\n  // belongs where it began.\n  var at = b.ev.length;\n  while (at > 0 && b.ev[at - 1].t > ev.t) at--;\n  b.ev.splice(at, 0, ev);\n  if (b.ev.length > CR.perDay) b.ev.splice(0, b.ev.length - CR.perDay);\n};\nCR.add = function (ev) {\n  if (!ev.t) ev.t = Date.now();\n  CR.borrowDate();\n  // The same line again within two minutes (an NPC thanking you for each\n  // corpse, someone following you room after room) counts up the first.\n  if (ev.k == \"chan\" || ev.k == \"emote\") {\n    var rb = CR.bucket(CR.dayOf(ev.t), false);\n    if (rb) {\n      for (var ri = rb.ev.length - 1; ri >= 0 && ri >= rb.ev.length - 8; ri--) {\n        var re = rb.ev[ri];\n        if (ev.t - re.t > 120000) break;\n        if (re.k == ev.k && re.text == ev.text) { re.n = (re.n || 1) + 1; CR.dirty(); return re; }\n      }\n    }\n  }\n  CR.put(ev);\n  CR.dirty();\n  return ev;\n};\n// Saved a little later, so a busy hour writes once in a while rather than per\n// line; drawn soon after, so a burst is one draw.\nCR.dirty = function () {\n  if (!CR.saveT) CR.saveT = setTimeout(function () { client.loom.chronicle.saveT = null; client.loom.chronicle.save(); }, 10000);\n  if (!CR.drawT) CR.drawT = setTimeout(function () { client.loom.chronicle.drawT = null; run_function(\"chronicle_render\", [], \"chronicle\"); }, 300);\n};\n// What gives way when the record is too big: first the raw lines of the\n// oldest days that have their summary (the summary stays), then the oldest\n// days whole. Only maxDays days keep their raw lines.\nCR.save = function () {\n  var today = CR.today(), i, raw = 0;\n  for (i = CR.days.length - 1; i >= 0; i--) {\n    var b = CR.days[i];\n    if (!b.ev.length) continue;\n    raw++;\n    if (raw > CR.maxDays && (b.sum || b.d !== today)) b.ev = [];\n  }\n  CR.days = CR.days.filter(function (b) { return b.ev.length || b.sum; });\n  var s = JSON.stringify(CR.days);\n  // Then the days of months that have their own summary; then the oldest.\n  var an = CR.annals && CR.annals.m;\n  while (s.length > CR.maxBytes) {\n    var cut = -1, drop = -1;\n    for (i = 0; i < CR.days.length - 1 && cut < 0; i++) { if (CR.days[i].sum && CR.days[i].ev.length) cut = i; }\n    for (i = 0; an && cut < 0 && i < CR.days.length - 1 && drop < 0; i++) { var mm = an[Math.floor((CR.days[i].d - 1) / 25)]; if (mm && !mm.draft) drop = i; }\n    if (cut >= 0) CR.days[cut].ev = [];\n    else if (drop >= 0) CR.days.splice(drop, 1);\n    else if (CR.days.length > 1) CR.days.shift();\n    else break;\n    s = JSON.stringify(CR.days);\n  }\n  set_variable(\"chronicle_days\", s);\n};\n\n// --- channels -----------------------------------------------------------------\n// IC channels are kept, OOC and utility ones not (Ricardo, 2026-11-13): say,\n// tells, yell, the city, house and order, house newbie, group, clans and the\n// gods' emotes. Any other channel is left out until CHRONICLE CHANNEL <key> ON.\nCR.names = function (k) {\n  k = String(k || \"\");\n  return [k, String(CR.captions[k] || \"\").replace(/^the\\s+/i, \"\")].join(\"|\").toLowerCase();\n};\nCR.chanDefault = function (k) {\n  if (/^tell\\s/i.test(String(k))) return true;\n  return /(?:^|\\|)(?:says?|tells?|yells?|ct|city|ht|gt|house|hnt|gnt|house newbie[^|]*|ot|order|group|emotes?|clt\\d+|clan of[^|]*)(?:\\||$)/.test(CR.names(k));\n};\nCR.chanKey = function (k) { k = String(k || \"\"); return /^tell\\s/i.test(k) ? \"tells\" : k; };\nCR.chanOn = function (k) {\n  var key = CR.chanKey(k);\n  if (CR.over[key] !== undefined) return !!CR.over[key];\n  return CR.chanDefault(k);\n};\nCR.chanName = function (k) {\n  k = String(k || \"\");\n  if (/^tell\\s/i.test(k)) return \"tell\";\n  if (CR.captions[k]) return CR.captions[k].replace(/^the\\s+(?:clan\\s+of\\s+)?/i, \"\");\n  // Until the game sends the channel list (at login): the key, readably.\n  var nice = { says: \"Says\", ct: \"City\", ht: \"House\", gt: \"House\", hnt: \"House newbie\", gnt: \"House newbie\", ot: \"Order\", yell: \"Yell\", yells: \"Yell\", emotes: \"Emotes\" };\n  return nice[k] || k;\n};\n// Anything after // is OOC (Ricardo) and left out; a line with nothing IC\n// left goes altogether. A URL's :// is not a marker.\nCR.ic = function (text) {\n  var m = /(^|[^:])\\/\\/.*$/.exec(text);\n  if (!m) return text;\n  var t = text.slice(0, m.index + m[1].length).replace(/\\s+$/, \"\");\n  if ((t.match(/\"/g) || []).length % 2 === 1) {\n    if (/\"\\s*$/.test(t)) return \"\";\n    t += '\"';\n  }\n  if (/^\\([^)]*\\):?\\s*$/.test(t) || /,\\s*\"\"$/.test(t) || !/\\S/.test(t)) return \"\";\n  return t;\n};\nCR.chan = function (g) {\n  var k = String(g.channel || \"\");\n  if (!k) return;\n  CR.seen[CR.chanKey(k)] = true;\n  if (!CR.chanOn(k)) return;\n  var to = /^tell\\s+(\\S+)/i.exec(k);\n  if (CR.ignored(g.talker) || (to && CR.ignored(to[1]))) return;\n  var text = CR.ic(CR.plain(g.text));\n  if (!text) return;\n  // The channel's own prefix (\"(Heartwood): \") goes: the entry names it.\n  var bare = text.replace(/^\\([^)]{1,40}\\):\\s+/, \"\");\n  var now = Date.now();\n  CR.recent.push([text, now]);\n  while (CR.recent.length > 20 || (CR.recent.length && now - CR.recent[0][1] > 5000)) CR.recent.shift();\n  // The same line taken for an emote a moment ago (it came as text first).\n  var b = CR.bucket(CR.dayOf(now), false);\n  if (b) {\n    for (var i = b.ev.length - 1; i >= 0 && i >= b.ev.length - 5; i--) {\n      if (b.ev[i].k == \"emote\" && b.ev[i].text == text && now - b.ev[i].t < 5000) b.ev.splice(i, 1);\n    }\n  }\n  var cev = { t: now, k: \"chan\", ch: CR.chanKey(k), name: CR.chanName(k), who: String(g.talker || \"\"), text: CR.clip(CR.scrub(bare), CR.textMax) };\n  if (to) cev.to = to[1];\n  CR.add(cev);\n};\n\n// --- places ---------------------------------------------------------------------\nCR.enter = function (g) {\n  var num = g.num !== undefined ? String(g.num) : \"\";\n  if (CR.room && CR.room.num === num) return;\n  var now = Date.now();\n  CR.leave(now);\n  var area = String(g.area || \"\");\n  if (!CR.area || CR.area.name !== area) CR.area = { name: area, at: now, ev: null };\n  CR.room = { num: num, name: CR.plain(g.name), area: area, at: now, ev: null, with: {} };\n  CR.players = {};\n};\nCR.leave = function (now) {\n  var r = CR.room;\n  if (r && r.ev) { r.ev.min = Math.round((now - r.at) / 60000); r.ev.with = CR.withList(r); CR.dirty(); }\n};\nCR.withList = function (r) {\n  var out = [];\n  for (var n in r.with) { if (r.with.hasOwnProperty(n) && !CR.ignored(n)) out.push(r.with[n]); }\n  return out;\n};\nCR.meet = function (name) {\n  name = String(name || \"\").split(/\\s+/)[0];\n  if (!/^[A-Za-z]+$/.test(name)) return;\n  name = name.charAt(0).toUpperCase() + name.slice(1).toLowerCase();\n  CR.players[name.toLowerCase()] = name;\n  if (CR.room && name.toLowerCase() !== String(CR.me).toLowerCase()) {\n    CR.room.with[name.toLowerCase()] = name;\n    if (CR.room.ev) CR.room.ev.with = CR.withList(CR.room);\n  }\n};\n// Every prompt: an area or room long enough is recorded, and a capture that\n// never saw its prompt ends.\nCR.tick = function () {\n  var now = Date.now();\n  // A new day: the ones before it get their summaries.\n  var td = CR.today();\n  if (td && td !== CR.seenDay) { var first = !CR.seenDay; CR.seenDay = td; if (!first && CR.due) CR.due(); }\n  if (CR.area && !CR.area.ev && CR.area.name && now - CR.area.at >= CR.areaMs) {\n    CR.area.ev = CR.add({ t: CR.area.at, k: \"place\", area: CR.area.name, room: CR.room ? CR.room.name : \"\" });\n  }\n  var r = CR.room;\n  if (r && !r.ev && r.name && now - r.at >= CR.stayMs) {\n    r.ev = CR.add({ t: r.at, k: \"stay\", room: r.name, area: r.area, min: Math.round((now - r.at) / 60000), with: CR.withList(r) });\n  } else if (r && r.ev) {\n    var mn = Math.round((now - r.at) / 60000);\n    if (mn !== r.ev.min) { r.ev.min = mn; CR.dirty(); }\n  }\n  if (CR.capt && now - CR.capt.at > CR.capMs) CR.finish();\n};\n\n// --- game lines -----------------------------------------------------------------\n// The prompt ends a capture. Standard prompts start \"7547h, 5989m\"; a custom\n// one is known by your health and mana from Char.Vitals, as room does.\nCR.promptRe = /^\\s*\\d+h, \\d+m\\b/;\nCR.isPrompt = function (raw) {\n  if (CR.promptRe.test(raw)) return true;\n  var hm = CR.vitHM;\n  if (!hm || !hm[0] || !hm[1]) return false;\n  return new RegExp(\"(^|\\\\D)\" + hm[0] + \"(\\\\D|$)\").test(raw) && new RegExp(\"(^|\\\\D)\" + hm[1] + \"(\\\\D|$)\").test(raw);\n};\nCR.re = {\n  date: /^(?:It is now|Today is) the (\\d+)(?:st|nd|rd|th) of (\\w+), (\\d+) years after/,\n  letter: /^You read what is written on (.+):\\s*$/,\n  news: /^([A-Z][A-Za-z ]*?) NEWS #(\\d+)\\s+\\((.+)\\)\\s*$/,\n  msg: /^Message #(\\d+)\\s+Sent by (\\S+)\\s*$/,\n  more: /^\\[Type MORE if you wish to continue reading\\./,\n  moreCmd: /^\\s*more\\s*$/i,\n  // Your own custom emotes (EMOTE, and roleplay's ambient ones) come back as\n  // \"You have emoted: Neijel draws his lips back...\" (Ricardo). Socials\n  // (\"You skip about merrily.\") aren't kept: they look like every other\n  // \"You ...\" line.\n  mine: /^You have emoted: (.+)$/,\n  // Lines starting with a name that aren't emotes: talk (it comes by GMCP)\n  // and comings and goings.\n  talk: /^\\w+ (?:says|asks|exclaims|whispers|yells|shouts|tells|answers|replies|mutters|sings|quietly says)\\b/,\n  // Housekeeping, not roleplay: curing, gold, wielding, following.\n  chore: /^\\w+ (?:takes some salve|rubs some|eats (?:a|an|some)\\b|sips|quaffs|smokes|applies|presses|touches|puts some gold sovereigns|picks up \\d+ gold|starts to wield|ceases to wield|begins to wield|follows you|follows \\w+ |begins to follow|stops following|stands up|sits down)/,\n  move: /^\\w+ (?:arrives|leaves|has arrived|has left|enters|walks|flies|swims|rides|sprints|bounds|lopes|slithers|crawls|limps|strides|trots|glides|wanders|stumbles|is here|appears|vanishes|disappears)\\b/\n};\nCR.line = function (raw) {\n  raw = CR.plain(raw);\n  if (CR.isPrompt(raw)) { if (CR.capt) CR.finish(); return; }\n  var m;\n  if ((m = CR.re.date.exec(raw))) { CR.setDate(parseInt(m[1], 10), m[2], parseInt(m[3], 10)); return; }\n  if ((m = CR.re.letter.exec(raw))) { CR.start({ k: \"letter\", what: m[1] }); return; }\n  if ((m = CR.re.news.exec(raw))) { CR.start({ k: \"news\", section: m[1], num: parseInt(m[2], 10), date: m[3] }); return; }\n  if ((m = CR.re.msg.exec(raw))) { CR.start({ k: \"msg\", num: parseInt(m[1], 10), who: m[2] }); return; }\n  if (CR.re.moreCmd.test(raw)) {\n    if (CR.cont && Date.now() - CR.cont.at < 600000) { CR.capt = { ev: CR.cont.ev, lines: [], at: Date.now(), more: true }; CR.cont = null; }\n    return;\n  }\n  if (!CR.capt && (m = CR.re.mine.exec(raw))) { CR.add({ k: \"emote\", who: CR.me || \"you\", text: CR.clip(CR.scrub(m[1]), CR.textMax) }); return; }\n  if (CR.capt) {\n    if (CR.capt.ev.k == \"news\" && CR.re.more.test(raw)) { CR.cont = { ev: CR.capt.ev, at: Date.now() }; CR.finish(); return; }\n    CR.capt.lines.push(raw);\n    if (CR.capt.lines.length > 400) CR.finish();\n    return;\n  }\n  CR.emote(raw);\n};\nCR.start = function (ev) {\n  if (CR.capt) CR.finish();\n  CR.cont = null;\n  ev.t = Date.now();\n  CR.capt = { ev: ev, lines: [], at: ev.t, more: false };\n};\n// The captured lines, blank runs closed up, become the event's text.\nCR.finish = function () {\n  var c = CR.capt;\n  CR.capt = null;\n  if (!c) return;\n  var ev = c.ev, out = [], i;\n  for (i = 0; i < c.lines.length; i++) {\n    var ln = c.lines[i], f;\n    if (ev.k == \"news\" && !c.more) {\n      if ((f = /^From\\s*:\\s*(.*)$/.exec(ln))) { ev.from = f[1]; continue; }\n      if ((f = /^To\\s*:\\s*(.*)$/.exec(ln))) { ev.to = f[1]; continue; }\n      if ((f = /^Subject\\s*:\\s*(.*)$/.exec(ln))) { ev.subject = f[1]; continue; }\n      if (/^-{5,}\\s*$/.test(ln)) continue;\n    }\n    if (ev.k == \"msg\" && !out.length && (f = /^(\\d{4}\\/\\d\\d\\/\\d\\d\\/\\d\\d:\\d\\d)\\s+(.*)$/.exec(ln))) { ev.when = f[1]; ln = f[2]; }\n    if (!/\\S/.test(ln) && (!out.length || !/\\S/.test(out[out.length - 1]))) continue;\n    out.push(ln.replace(/^\\s+/, \"\"));\n  }\n  while (out.length && !/\\S/.test(out[out.length - 1])) out.pop();\n  var text = out.join(\"\\n\");\n  if (c.more) {\n    ev.text = CR.clip((ev.text ? ev.text + \"\\n\" : \"\") + text, CR.longMax);\n    CR.dirty();\n    return;\n  }\n  ev.text = CR.clip(text, CR.longMax);\n  if ((ev.k == \"msg\" && CR.ignored(ev.who)) || (ev.k == \"news\" && CR.ignored(ev.from))) return;\n  if (!CR.known(ev)) CR.add(ev);\n  else if (CR.cont && CR.cont.ev === ev) CR.cont = null;\n};\n// A message or news post read again isn't recorded again; a letter read again\n// the same day isn't either.\nCR.known = function (ev) {\n  for (var i = CR.days.length - 1; i >= 0; i--) {\n    var b = CR.days[i];\n    for (var j = b.ev.length - 1; j >= 0; j--) {\n      var e = b.ev[j];\n      if (e.k !== ev.k) continue;\n      if (ev.k == \"news\" && e.section == ev.section && e.num == ev.num) return true;\n      if (ev.k == \"msg\" && e.num == ev.num) return true;\n      if (ev.k == \"letter\" && b.d === CR.dayOf(ev.t) && e.text == ev.text) return true;\n    }\n  }\n  return false;\n};\n// An emote: a line starting with the name of someone in your room (you too),\n// that isn't talk or a coming or going. Someone with more than a few lines a\n// minute is fighting, not emoting: left out for a while.\nCR.emote = function (raw) {\n  var m = /^([A-Z][a-z]+)\\b/.exec(raw);\n  if (!m) return;\n  var lc = m[1].toLowerCase();\n  if (!CR.players[lc] && lc !== String(CR.me).toLowerCase()) return;\n  if (CR.ignored(lc)) return;\n  if (CR.re.talk.test(raw) || CR.re.move.test(raw) || CR.re.chore.test(raw) || / says,? \"/.test(raw)) return;\n  var now = Date.now(), i;\n  for (i = 0; i < CR.recent.length; i++) { if (CR.recent[i][0] == raw) return; }\n  var rt = CR.rate[lc] || (CR.rate[lc] = { at: [], mute: 0 });\n  if (rt.mute > now) return;\n  while (rt.at.length && now - rt.at[0] > 60000) rt.at.shift();\n  rt.at.push(now);\n  if (rt.at.length > CR.emoteMax) {\n    rt.mute = now + CR.emoteMute;\n    // The burst so far was combat too: take it back out.\n    var b = CR.bucket(CR.dayOf(now), false);\n    if (b) { for (i = b.ev.length - 1; i >= 0; i--) { if (b.ev[i].k == \"emote\" && b.ev[i].who == m[1] && now - b.ev[i].t <= 60000) b.ev.splice(i, 1); } }\n    CR.dirty();\n    return;\n  }\n  CR.add({ t: now, k: \"emote\", who: m[1], text: CR.clip(CR.scrub(raw), CR.textMax) });\n};\n\n// --- the record as text ----------------------------------------------------------\nCR.hhmm = function (t) { var d = new Date(t); return (\"0\" + d.getHours()).slice(-2) + \":\" + (\"0\" + d.getMinutes()).slice(-2); };\nCR.describe = function (e) {\n  switch (e.k) {\n    case \"place\": return \"In \" + e.area + (e.room ? \" (\" + e.room + \")\" : \"\");\n    case \"stay\": return \"Stayed \" + (e.min || 0) + \" min in \" + e.room + (e.area ? \", \" + e.area : \"\") + (e.with && e.with.length ? \", with \" + e.with.join(\", \") : \"\");\n    case \"chan\": return \"[\" + e.name + \"] \" + e.text;\n    case \"emote\": return e.text;\n    case \"letter\": return \"Read \" + e.what + \":\\n\" + (e.text || \"\");\n    case \"msg\": return \"Message from \" + e.who + \": \" + (e.text || \"\");\n    case \"news\": return \"Read \" + e.section + \" news #\" + e.num + (e.subject ? \", \\\"\" + e.subject + \"\\\"\" : \"\") + (e.from ? \" by \" + e.from : \"\") + \":\\n\" + (e.text || \"\");\n    case \"note\": return \"Note: \" + e.text;\n    case \"link\": return e.text + \" (\" + e.src + \")\";\n  }\n  return String(e.text || \"\");\n};\nCR.show = function (e) { return CR.describe(e) + (e.n > 1 ? \" (\\u00d7\" + e.n + \")\" : \"\"); };\nCR.markdown = function (days) {\n  var out = [\"# Chronicle\" + (CR.me ? \" of \" + CR.me : \"\"), \"\"], k;\n  var an = CR.annals || { m: {}, y: {} };\n  var ys = Object.keys(an.y || {}).map(Number).sort(function (a, b) { return a - b; });\n  var ms = Object.keys(an.m || {}).map(Number).sort(function (a, b) { return a - b; });\n  if (ys.length) { out.push(\"## Years\", \"\"); for (k = 0; k < ys.length; k++) out.push(\"### \" + CR.yearName(ys[k]).replace(/^the y/, \"Y\") + (an.y[ys[k]].draft ? \" (so far)\" : \"\"), \"\", an.y[ys[k]].text, \"\"); }\n  if (ms.length) { out.push(\"## Months\", \"\"); for (k = 0; k < ms.length; k++) out.push(\"### \" + CR.monthName(ms[k]) + (an.m[ms[k]].draft ? \" (so far)\" : \"\"), \"\", an.m[ms[k]].text, \"\"); }\n  var dh = (ys.length || ms.length) ? \"### \" : \"## \";\n  if (ys.length || ms.length) out.push(\"## Days\", \"\");\n  for (var i = 0; i < days.length; i++) {\n    var b = days[i];\n    if (!b.ev.length && !b.sum) continue;\n    out.push(dh + CR.dayName(b.d), \"\");\n    if (b.sum) out.push(b.sum.text, \"\");\n    if (b.sum && b.ev.length) out.push(\"The record:\", \"\");\n    for (var j = 0; j < b.ev.length; j++) {\n      var e = b.ev[j], txt = CR.show(e).split(\"\\n\");\n      out.push(\"- \" + CR.hhmm(e.t) + \" **\" + e.k + \"** \" + txt[0]);\n      for (var l = 1; l < txt.length; l++) out.push(\"  > \" + txt[l]);\n    }\n    out.push(\"\");\n  }\n  return out.join(\"\\n\");\n};\n// A Markdown file of the whole record, downloaded by the browser.\nCR.download = function () {\n  var md = CR.markdown(CR.days);\n  CR.lastExport = md;\n  try {\n    var blob = new Blob([md], { type: \"text/markdown\" });\n    var a = document.createElement(\"a\");\n    var d = new Date();\n    a.href = URL.createObjectURL(blob);\n    a.download = \"chronicle-\" + (CR.me || \"character\").toLowerCase() + \"-\" + d.getFullYear() + \"-\" + (\"0\" + (d.getMonth() + 1)).slice(-2) + \"-\" + (\"0\" + d.getDate()).slice(-2) + \".md\";\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    setTimeout(function () { try { URL.revokeObjectURL(a.href); } catch (e) {} }, 10000);\n    return true;\n  } catch (e) { return false; }\n};\n\nrun_function(\"chronicle_summary\", [], \"chronicle\");\n\n// --- what other packages offer, through loom -------------------------------------\n// entry.record({ source, key, text, at }): one line in the record, tagged with\n// its source; the same source and key is recorded once. entry.withdraw(source\n// [, key]) takes them back out of the current day (earlier days are history).\nCR.entry = {\n  record: function (it) {\n    if (!it || !it.source || !it.text) return false;\n    var src = String(it.source), key = String(it.key === undefined ? \"\" : it.key);\n    for (var i = 0; i < CR.days.length; i++) {\n      for (var j = 0; j < CR.days[i].ev.length; j++) { var e = CR.days[i].ev[j]; if (e.k == \"link\" && e.src == src && e.key == key) return false; }\n    }\n    CR.add({ t: (typeof it.at == \"number\" && it.at > 0 && it.at <= Date.now()) ? it.at : Date.now(), k: \"link\", src: src, key: key, text: CR.clip(CR.scrub(String(it.text)), CR.textMax) });\n    return true;\n  },\n  withdraw: function (source, key) {\n    var b = CR.bucket(CR.today(), false);\n    if (!b) return;\n    var n = b.ev.length;\n    b.ev = b.ev.filter(function (e) { return !(e.k == \"link\" && e.src == String(source) && (key === undefined || e.key == String(key))); });\n    if (b.ev.length !== n) CR.dirty();\n  }\n};\n// What it offers: the record of a day (today if none given).\nCR.look = {\n  day: function (d) { var b = CR.bucket(d === undefined ? CR.today() : d, false); return b ? b.ev.slice() : []; }\n};\n"
  },
  {
   "type": "function",
   "name": "chronicle_gmcp",
   "enabled": true,
   "code": "// chronicle_gmcp -- the work behind onGMCP, as a function made once per load\n// (client.loom.hooks.chronicle.gmcp): onGMCP runs on every message, so the\n// script itself stays short (#136). Run from onLoad and onInstall.\nif (!client.loom) client.loom = {};\nif (!client.loom.hooks) client.loom.hooks = {};\nif (!client.loom.hooks.chronicle) client.loom.hooks.chronicle = {};\nclient.loom.hooks.chronicle.gmcp = function (args) {\n  var m = args && args.gmcp_method;\n  if (m !== \"Char.Vitals\" && m !== \"Room.Info\" && m !== \"Comm.Channel.Text\" && m !== \"Room.Players\" && m !== \"Room.AddPlayer\" &&\n      m !== \"Room.RemovePlayer\" && m !== \"Comm.Channel.List\" && m !== \"Char.Name\" && m !== \"Char.Status\") return;\n  if (!client.loom.chronicle || !client.loom.chronicle.line) run_function(\"chronicle_setup\", [], \"chronicle\");\n  var CR = client.loom.chronicle;\n  var raw = args.gmcp_args;\n  if (typeof raw == \"string\" && m !== \"Room.RemovePlayer\") { try { raw = JSON.parse(raw); } catch (e) { raw = null; } }\n  var g = (raw && typeof raw == \"object\") ? raw : {};\n  if (m === \"Char.Vitals\") {\n    if (g.hp !== undefined && g.mp !== undefined) CR.vitHM = [String(g.hp).replace(/\\D/g, \"\"), String(g.mp).replace(/\\D/g, \"\")];\n    CR.tick();\n  } else if (m === \"Room.Info\") {\n    CR.enter(g);\n  } else if (m === \"Comm.Channel.Text\") {\n    CR.chan(g);\n  } else if (m === \"Room.Players\") {\n    CR.players = {};\n    if (Array.isArray(raw)) { for (var i = 0; i < raw.length; i++) { if (raw[i] && raw[i].name) CR.meet(raw[i].name); } }\n  } else if (m === \"Room.AddPlayer\") {\n    if (g.name) CR.meet(g.name);\n  } else if (m === \"Room.RemovePlayer\") {\n    var gone = String(typeof raw == \"string\" ? raw : (g.name || \"\")).replace(/^\"|\"$/g, \"\").toLowerCase();\n    if (gone) delete CR.players[gone];\n  } else if (m === \"Comm.Channel.List\") {\n    if (Array.isArray(raw)) { for (var j = 0; j < raw.length; j++) { if (raw[j] && raw[j].name && raw[j].caption) CR.captions[String(raw[j].name)] = String(raw[j].caption); } }\n  } else if (g.name) {\n    if (CR.status) CR.status(g);\n    var n = String(g.name).split(/\\s+/)[0];\n    if (n && n !== CR.me) { CR.me = n; set_variable(\"chronicle_name\", n); }\n  }\n};\n"
  },
  {
   "type": "function",
   "name": "chronicle_render",
   "enabled": true,
   "code": "// chronicle_render -- the 'Chronicle' custom tab, in the house style shared\n// with Ledger and Coffers: ink panel, serif small-caps headings, monospace\n// rows. Today's record, newest first; then the earlier days kept, with how\n// much each holds.\nif (!client.loom || !client.loom.chronicle || !client.loom.chronicle.line) run_function(\"chronicle_setup\", [], \"chronicle\");\nvar CR = client.loom.chronicle;\nCR.borrowDate();\n\n// Tab theme (#310): loom's city palette when one is on, else this tab's own colours.\nvar TH = (client.loom && client.loom.theme) || {};\nvar PARCH = TH.acc || \"#e6d5ac\";\nvar SEPIA = TH.deep || \"#8b6b47\";\nvar TXT = TH.txt || \"#e4dccb\";\nvar MUTED = TH.muted || \"#8c8272\";\nvar RULE = TH.rule || \"#352c22\";\nvar BG = TH.bg || \"#15120e\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\n// One colour per kind, muted enough to read as ink.\nvar KIND = {\n  place: [\"#9cc96b\", \"place\"], stay: [\"#9cc96b\", \"stay\"], chan: [\"#7fb2c9\", \"said\"], emote: [\"#c9a27f\", \"emote\"],\n  letter: [\"#e0a95a\", \"letter\"], msg: [\"#e0a95a\", \"message\"], news: [\"#e0a95a\", \"news\"], note: [\"#e6d5ac\", \"note\"], link: [\"#b39ddb\", \"deed\"]\n};\n\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\"); }\nfunction caps(t, col) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (col || SEPIA) + ';font-size:11px;margin:0 0 2px;\">' + t + '</div>'; }\nfunction section(title, inner, col) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title, col) + inner + '</div>'; }\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">' + t + '</div>'; }\n// One row: the time in the margin, the kind, and the entry. Long texts\n// (letters, news) show their first line; the whole text on hover.\nfunction row(e) {\n  var kd = KIND[e.k] || [TXT, e.k];\n  var full = CR.show(e);\n  var first = full.split(\"\\n\")[0];\n  var more = full.indexOf(\"\\n\") >= 0;\n  return '<div style=\"display:flex;gap:6px;align-items:baseline;border-bottom:1px dotted ' + RULE + ';padding:2px 0;\"' + (more ? ' title=\"' + esc(CR.clip(full, 1500)) + '\"' : '') + '>' +\n    '<span style=\"color:' + SEPIA + ';min-width:3.2em;\">' + CR.hhmm(e.t) + '</span>' +\n    '<span style=\"color:' + kd[0] + ';min-width:4.6em;font-family:' + SERIF + ';font-variant:small-caps;\">' + kd[1] + '</span>' +\n    '<span style=\"flex:1 1 auto;min-width:0;color:' + TXT + ';overflow-wrap:anywhere;\">' + esc(first) + (more ? ' <span style=\"color:' + MUTED + ';\">&hellip;</span>' : '') + '</span></div>';\n}\n\nvar book = '<svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<path d=\"M8 4 C6 2.6 3.5 2.4 1 3 L1 13 C3.5 12.4 6 12.6 8 14 Z\" fill=\"' + PARCH + '\"/><path d=\"M8 4 C10 2.6 12.5 2.4 15 3 L15 13 C12.5 12.4 10 12.6 8 14 Z\" fill=\"' + PARCH + '\" opacity=\"0.8\"/>' +\n  '<path d=\"M8 4 L8 14\" stroke=\"' + SEPIA + '\" stroke-width=\"0.8\"/></svg>';\n\nvar today = CR.today();\nvar cur = CR.bucket(today, false);\nvar html = '<div id=\"loom-chronicle\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + BG + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;min-height:100%;box-sizing:border-box;\">';\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + SEPIA + ';padding-bottom:3px;\">';\nhtml += '<div style=\"font-family:' + SERIF + ';color:' + PARCH + ';font-size:14px;letter-spacing:0.22em;\">' + book + 'CHRONICLE</div>';\nhtml += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + SEPIA + ';font-size:11px;\">' + (cur ? cur.ev.length : 0) + ' today &middot; ' + CR.days.length + ' day' + (CR.days.length === 1 ? '' : 's') + ' kept</div></div>';\n\nif (today) {\n  html += '<div style=\"margin:6px 0 2px;\"><span style=\"font-family:' + SERIF + ';font-size:20px;color:' + PARCH + ';\">' + esc(CR.dayName(today).replace(/, \\d+ AF$/, \"\")) + '</span>';\n  html += ' <span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">' + esc(CR.dayName(today).replace(/^.*, /, \"the year \")) + '</span></div>';\n} else {\n  html += '<div style=\"margin:6px 0 2px;font-family:' + SERIF + ';font-size:18px;color:' + MUTED + ';font-style:italic;\">date not yet known</div>';\n  html += '<div style=\"color:' + MUTED + ';\">It comes with the next hour\\'s date line, or type DATE.</div>';\n}\n\n// A summary, in the chronicle's hand.\nfunction prose(sum, size) {\n  return '<div style=\"font-family:' + SERIF + ';font-size:' + (size || 12) + 'px;line-height:1.45;color:' + TXT + ';margin:3px 0 4px;\">' + esc(sum.text) +\n    (sum.draft ? ' <span style=\"color:' + MUTED + ';font-style:italic;font-size:10px;\">(so far)</span>' : '') + '</div>';\n}\n// What a summary still to come says about itself.\nfunction pending(it, finished) {\n  if (CR.busy && CR.writing === it) return \"being written…\";\n  if (!CR.getKey() || !finished) return \"\";\n  if (CR.fails(it) >= CR.retryMs.length) return \"summary failed\";\n  return CR.auto ? \"summary to come\" : \"\";\n}\nfunction entry(title, right, sum, size) {\n  return '<div style=\"border-bottom:1px dotted ' + RULE + ';padding:3px 0;\">' +\n    '<div style=\"display:flex;gap:6px;align-items:baseline;\">' +\n    '<span style=\"flex:1 1 auto;color:' + PARCH + ';font-family:' + SERIF + ';font-size:' + (size ? size + 1 : 12) + 'px;\">' + esc(title) + '</span>' +\n    '<span style=\"color:' + MUTED + ';white-space:nowrap;\">' + esc(right || \"\") + '</span></div>' +\n    (sum ? prose(sum, size) : '') + '</div>';\n}\n// The three views, as headings to click.\nvar VIEWS = [[\"days\", \"Days\"], [\"months\", \"Months\"], [\"years\", \"Years\"]];\nvar tabs = '<div style=\"display:flex;gap:14px;margin:7px 0 0;border-bottom:1px solid ' + RULE + ';\">';\nfor (var v = 0; v < VIEWS.length; v++) {\n  var on = CR.view === VIEWS[v][0];\n  tabs += '<span onclick=\"window.loomChronicle&&window.loomChronicle.view(\\'' + VIEWS[v][0] + '\\')\" style=\"cursor:pointer;user-select:none;font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;font-size:12px;padding:0 1px 2px;' +\n    'color:' + (on ? PARCH : MUTED) + ';border-bottom:2px solid ' + (on ? SEPIA : \"transparent\") + ';margin-bottom:-1px;\">' + VIEWS[v][1] + '</span>';\n}\nhtml += tabs + '</div>';\n\nvar curM = today ? CR.monthOf(today) : -1, curY = today ? CR.yearOf(today) : -1;\nif (CR.view === \"months\") {\n  // The months of this year (and the last, while this one is young), newest first.\n  var mset = {}, mk;\n  for (var di = 0; di < CR.days.length; di++) { if (CR.days[di].d > 0) mset[CR.monthOf(CR.days[di].d)] = true; }\n  for (mk in CR.annals.m) { if (CR.annals.m.hasOwnProperty(mk)) mset[mk] = true; }\n  var mlist = Object.keys(mset).map(Number).filter(function (m) { return curY < 0 || Math.floor(m / 12) >= curY - 1; }).sort(function (a, b) { return b - a; });\n  var mh = \"\";\n  for (var mi = 0; mi < mlist.length; mi++) {\n    var m = mlist[mi], ds = CR.daysOfMonth(m), sm = CR.annals.m[m];\n    var played = ds.length + \" day\" + (ds.length === 1 ? \"\" : \"s\") + \" played\";\n    mh += entry(CR.monthName(m), (m === curM ? \"this month · \" : \"\") + (sm ? played : (pending(\"m\" + m, m < curM) || played)), sm, 12);\n  }\n  html += mh || '<div style=\"margin-top:6px;\">' + quiet(\"No months yet. A month's summary is written when it ends, from the summaries of its days (an Achaean month is about a day of real time).\") + '</div>';\n} else if (CR.view === \"years\") {\n  var yset = {}, yk;\n  for (var dj = 0; dj < CR.days.length; dj++) { if (CR.days[dj].d > 0) yset[CR.yearOf(CR.days[dj].d)] = true; }\n  for (yk in CR.annals.m) { if (CR.annals.m.hasOwnProperty(yk)) yset[Math.floor(yk / 12)] = true; }\n  for (yk in CR.annals.y) { if (CR.annals.y.hasOwnProperty(yk)) yset[yk] = true; }\n  var ylist = Object.keys(yset).map(Number).sort(function (a, b) { return b - a; });\n  var yh = \"\";\n  for (var yi = 0; yi < ylist.length; yi++) {\n    var y = ylist[yi], sy = CR.annals.y[y], nm = CR.monthsOfYear(y).length;\n    var mp = nm + \" month\" + (nm === 1 ? \"\" : \"s\");\n    yh += entry(CR.yearName(y).replace(/^the y/, \"Y\"), (y === curY ? \"this year · \" : \"\") + (sy ? mp : (pending(\"y\" + y, y < curY) || mp)), sy, 13);\n  }\n  html += yh || '<div style=\"margin-top:6px;\">' + quiet(\"No years yet. A year's summary is written when it ends, from its months (an Achaean year is about twelve days of real time).\") + '</div>';\n} else {\n  // Today, newest first.\n  var td = \"\";\n  if (cur && cur.sum) td += prose(cur.sum);\n  if (!cur || !cur.ev.length) td += quiet(\"Nothing recorded yet this day.\");\n  else {\n    var shown = 0;\n    for (var i = cur.ev.length - 1; i >= 0 && shown < 150; i--, shown++) td += row(cur.ev[i]);\n    if (cur.ev.length > shown) td += quiet((cur.ev.length - shown) + \" earlier entries: CHRONICLE EXPORT for all of them.\");\n  }\n  html += section(today ? \"This day\" : \"Before the date was known\", td, PARCH);\n  // Earlier days, newest first: the summary when there is one, and what the\n  // record holds.\n  var ea = \"\";\n  for (var j = CR.days.length - 1; j >= 0; j--) {\n    var b = CR.days[j];\n    if (b === cur) continue;\n    var n = {};\n    for (var k = 0; k < b.ev.length; k++) n[b.ev[k].k] = (n[b.ev[k].k] || 0) + 1;\n    var bits = [];\n    if (n.place || n.stay) bits.push(((n.place || 0) + (n.stay || 0)) + \" places\");\n    if (n.chan) bits.push(n.chan + \" said\");\n    if (n.emote) bits.push(n.emote + \" emotes\");\n    if (n.letter || n.msg || n.news) bits.push(((n.letter || 0) + (n.msg || 0) + (n.news || 0)) + \" read\");\n    if (n.note) bits.push(n.note + \" notes\");\n    if (n.link) bits.push(n.link + \" deeds\");\n    var state = (!b.sum && b.d > 0 && b.ev.length) ? pending(b.d, true) : \"\";\n    ea += entry(CR.dayName(b.d), state || bits.join(\" · \") || (b.sum ? \"\" : \"empty\"), b.sum);\n  }\n  if (ea) html += section(\"Earlier days\", ea, PARCH);\n}\nif (!CR.getKey()) html += '<div style=\"margin-top:8px;color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">No summaries without an API key: CHRONICLE HELP.</div>';\nhtml += '</div>';\n// The whole tab in the panel's colour (#355), as Ledger does.\ntry {\n  var crSt = document.getElementById(\"loom-chronicle-style\");\n  if (!crSt) { crSt = document.createElement(\"style\"); crSt.id = \"loom-chronicle-style\"; document.head.appendChild(crSt); }\n  var crCss = '.flexlayout__tab:has(#loom-chronicle) { background: ' + BG + ' !important; } .flexlayout__tab:has(#loom-chronicle) > * { min-height: 100%; }';\n  if (crSt.textContent !== crCss) crSt.textContent = crCss;\n} catch (e) {}\ntry { set_custom_tab_html(\"Chronicle\", html); } catch (e) {}\n"
  },
  {
   "type": "function",
   "name": "chronicle_help",
   "enabled": true,
   "code": "// chronicle_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[chronicle] a record of each Achaean day. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"CHRONICLE\", \"today's date and what has been recorded\"],\n  [\"CHRONICLE NOTE <text>\", \"add a note of your own to today's record\"],\n  [\"CHRONICLE CHANNELS\", \"the channels heard this session, and which are kept\"],\n  [\"CHRONICLE CHANNEL <name> ON|OFF\", \"keep or leave out a channel (TELLS for all tells)\"],\n  [\"CHRONICLE CHANNEL <name> DEFAULT\", \"back to the default for that channel\"],\n  [\"CHRONICLE KEY <key>|CLEAR\", \"your Anthropic API key, kept in this browser only (summaries need it)\"],\n  [\"CHRONICLE VOICE [text|CLEAR]\", \"your notes on the character, for the summaries\"],\n  [\"CHRONICLE PERSON FIRST|THIRD\", \"a chronicler's record (third, default) or the character's journal\"],\n  [\"CHRONICLE SUMMARIES ON|OFF\", \"a summary at the end of each Achaean day (on)\"],\n  [\"CHRONICLE WRITE [day]\", \"write a day's summary now: today, yesterday, or e.g. 8 Scarlatan\"],\n  [\"CHRONICLE WRITE MONTH|YEAR [which]\", \"write a month's or year's now (this one so far if none named)\"],\n  [\"CHRONICLE RETRY\", \"try again every summary that failed, and write what's due\"],\n  [\"CHRONICLE VIEW DAYS|MONTHS|YEARS\", \"what the tab shows (or click the headings)\"],\n  [\"CHRONICLE MODEL [id|DEFAULT]\", \"the model that writes them\"],\n  [\"CHRONICLE IGNORE|UNIGNORE [name]\", \"leave someone out of the record (and its summaries) entirely\"],\n  [\"CHRONICLE EXPORT\", \"download the whole record as a Markdown file\"],\n  [\"CHRONICLE EXPORT SHOW\", \"print the last export here, if no download started\"],\n  [\"CHRONICLE DEBUG\", \"internal state\"],\n  [\"CHRONICLE RESET\", \"rebuild from the saved variables (the record is kept)\"],\n  [\"CHRONICLE CLEAR CONFIRM\", \"throw the whole record away\"],\n  [\"Kept by itself: areas you spend a minute in, rooms you stay five minutes in (and who was\"],\n  [\"there), IC channels (say, tells, yell, city, house, order, clans, the gods' emotes), emotes\"],\n  [\"in your room, and letters, messages and news you read. Anything after // is taken as OOC.\"],\n  [\"The record keeps the lines of the last 30 Achaean days you played in (one Achaean day is one\"],\n  [\"real hour), and summaries for longer, saved with your character's settings. Summaries need\"],\n  [\"your own Anthropic API key (CHRONICLE KEY): each day's record is sent to write them, at a cost.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "function",
   "name": "chronicle_summary",
   "enabled": true,
   "code": "// chronicle_summary -- run from chronicle_setup. Context from other\n// packages (#493) comes through loom's links, see CR.context. Summaries: when an Achaean\n// day ends, its record is sent to an LLM (Anthropic's API, with the player's\n// own key) and comes back as a short paragraph in the chronicle's voice.\n//\n// The voice is built in three layers (Ricardo, 2026-11-13):\n//   1. a chronicler's voice that fits Achaea, the same for everyone;\n//   2. what the game says of the character (Char.Status: race, class, age,\n//      city, house, order), kept in chronicle_char;\n//   3. what the player writes (CHRONICLE VOICE), in chronicle_voice.\n// Third person by default; CHRONICLE PERSON FIRST writes it as their journal.\n//\n// The key lives in this browser's localStorage only, never in a Nexus\n// variable (variables are stored with IRE and travel in .nxs exports).\nvar CR = client.loom.chronicle;\n\nCR.keyName = \"loom_chronicle_key\";\nCR.api = \"https://api.anthropic.com/v1/messages\";\nCR.defaultModel = \"claude-haiku-5-5\";\nCR.words = 100;\nCR.quietLines = 15;     // fewer lines than this (places aside) make a quiet day\nCR.budget = 24000;               // characters of record sent for one day\nCR.retryMs = [30000, 120000, 600000];\n\nCR.getKey = function () { try { return localStorage.getItem(CR.keyName) || \"\"; } catch (e) { return \"\"; } };\nCR.setKey = function (k) {\n  try { if (k) localStorage.setItem(CR.keyName, k); else localStorage.removeItem(CR.keyName); return true; } catch (e) { return false; }\n};\n// Text settings are saved as plain strings (\"first\", a model name, the\n// voice notes), not JSON, so they're read raw: through CR.readVar they failed\n// to parse and every one fell back to its default at each load.\nCR.str = function (name, dflt) {\n  var v;\n  try { v = get_variable(name); } catch (e) { v = undefined; }\n  return typeof v == \"string\" ? v : dflt;\n};\nCR.voice = CR.str(\"chronicle_voice\", \"\");\nCR.person = CR.str(\"chronicle_person\", \"third\") === \"first\" ? \"first\" : \"third\";\nCR.model = CR.str(\"chronicle_model\", \"\") || CR.defaultModel;\nCR.auto = CR.str(\"chronicle_auto\", \"on\") !== \"off\";\nif (!CR.char || typeof CR.char != \"object\") {\n  var crCh = CR.readVar(\"chronicle_char\");\n  CR.char = (crCh && typeof crCh == \"object\" && !Array.isArray(crCh)) ? crCh : {};\n}\nif (!CR.usage || typeof CR.usage != \"object\") {\n  var crUs = CR.readVar(\"chronicle_usage\");\n  CR.usage = (crUs && typeof crUs == \"object\" && typeof crUs.calls == \"number\") ? crUs : { calls: 0, inTok: 0, outTok: 0 };\n}\nif (!Array.isArray(CR.queue)) CR.queue = [];\nif (CR.busy === undefined) CR.busy = false;\n\n// Layer 2, from Char.Status. In dragonform the race reads as a dragon: the\n// last other race seen is kept.\nCR.status = function (g) {\n  var c = CR.char, changed = false;\n  var put = function (k, v) {\n    v = String(v === undefined || v === null ? \"\" : v).replace(/\\s*\\(\\d+\\)\\s*$/, \"\").replace(/^\\s+|\\s+$/g, \"\");\n    if (/^(none|\\(none\\))$/i.test(v)) v = \"\";\n    if (c[k] !== v) { c[k] = v; changed = true; }\n  };\n  if (g.fullname !== undefined) put(\"fullname\", g.fullname);\n  if (g.race !== undefined && !/dragon/i.test(String(g.race))) put(\"race\", g.race);\n  if (g.race !== undefined && /dragon/i.test(String(g.race))) put(\"dragon\", g.race);\n  if (g[\"class\"] !== undefined) put(\"cls\", g[\"class\"]);\n  if (g.age !== undefined) put(\"age\", g.age);\n  if (g.city !== undefined) put(\"city\", g.city);\n  if (g.house !== undefined) put(\"house\", g.house);\n  if (g.order !== undefined) put(\"order\", g.order);\n  if (g.gender !== undefined) put(\"gender\", g.gender);\n  if (changed) set_variable(\"chronicle_char\", JSON.stringify(c));\n};\nCR.facts = function () {\n  var c = CR.char, out = [];\n  var who = c.fullname || CR.me;\n  if (!who) return \"\";\n  var bits = [];\n  if (c.gender) bits.push(c.gender);\n  if (c.race) bits.push(c.race);\n  if (c.cls) bits.push(c.cls);\n  out.push(who + (bits.length ? \", a \" + bits.join(\" \") : \"\") + (c.age ? \", \" + c.age + \" years old\" : \"\") + \".\");\n  if (c.dragon) out.push(\"Has attained Dragonhood (\" + c.dragon + \") and is often in dragonform.\");\n  out.push(c.city ? \"Citizen of \" + c.city + \".\" : \"Belongs to no city.\");\n  if (c.house) out.push(\"Member of \" + c.house + \".\");\n  if (c.order) out.push(\"Of the order of \" + c.order + \".\");\n  return out.join(\" \");\n};\n\n// Layer 1, and the rules.\nCR.system = function (prev, scope) {\n  scope = scope || { what: \"day\", words: CR.words };\n  var name = CR.me || \"the adventurer\";\n  var p = [];\n  if (CR.person === \"first\") {\n    p.push(\"You keep the private journal of \" + name + \", an adventurer of Achaea. Write as \" + name + \", in the first person and past tense, as an entry written at the end of the day: plain, measured prose in their own manner, the way a journal kept in Sapience would read.\");\n  } else {\n    p.push(\"You are the chronicler of \" + name + \", an adventurer of Achaea. Write as an unnamed scribe keeping their annals: third person, past tense, measured and plain, the way a record kept in Sapience would read.\");\n  }\n  p.push(\"Use the world's own terms. Never mention game mechanics: experience, levels, renown, credits, kill counts, minutes, commands, quests as such, or the client. Hunting is hunting; a quest is a task or a deed.\");\n  p.push(\"Leave out anything out of character: talk of the game and its tools, the real world, and anything that reads as players talking rather than their characters.\");\n  p.push(\"Invent nothing: no events, motives, feelings or relationships the lines don't show. Where they're unclear, say less.\");\n  p.push(\"Don't guess anyone's sex: use a person's pronouns only when the lines or the notes give them (a 'she says', 'his', a note); otherwise use their name, or 'they'.\");\n  p.push(\"No padding: a quiet day gets a sentence or two, not scenery. Atmosphere only from what the lines name (a room's name, the weather, an emote); no invented actions, sights or sensations to fill space.\");\n  p.push(\"Write from the chronicler's own knowledge: never mention the record, its lines, or what it doesn't say, and don't remark on gaps or abrupt endings. Don't open with the date.\");\n  p.push(\"Tells reach someone from afar: a person heard only through tells wasn't there in person. Who was present shows in what was said aloud, emotes, and who was in the room. Say who did what: don't credit \" + name + \" with what a companion did.\");\n  p.push(\"Keep what changes things: people met, promises made, tasks taken on, letters, messages and news, places first seen, words that mattered. Pass over routine. Name people as the record names them.\");\n  if (scope.what === \"day\" && scope.quiet) p.push(\"This was a quiet day. Write at most two short sentences (about \" + scope.words + \" words), plain text, no heading and no date. Say what little happened and stop; don't add duration, scenery or reflection.\");\n  else if (scope.what === \"day\") p.push(\"Write one paragraph of about \" + scope.words + \" words (fewer for a quiet day), plain text, no heading and no date: the date is shown above it. British spelling.\");\n  else p.push(\"You are given the entries already written for each \" + (scope.what === \"month\" ? \"day of a month\" : \"month of a year\") + \". From them, write the entry for the whole \" + scope.what + \": what changed and what mattered over it (people, turning points, tasks begun and finished, where \" + name + \" stands at its end), not a list of \" + (scope.what === \"month\" ? \"days\" : \"months\") + \". About \" + scope.words + \" words, one or two paragraphs, plain text, no heading and no date. British spelling.\");\n  var f = CR.facts();\n  if (f) p.push(\"Who \" + name + \" is, as the world knows: \" + f);\n  if (CR.voice) p.push(\"What the player tells you about \" + name + \" (take it as true, and let it shape what matters, without repeating it): \" + CR.voice);\n  if (scope.ctx) p.push(scope.ctx);\n  if (prev) p.push(\"The previous \" + scope.what + \"'s entry, for continuity only (don't repeat it): \" + prev);\n  return p.join(\"\\n\\n\");\n};\n// The time of the Achaean day a moment falls in. The real clock means\n// nothing in the world (a day is one real hour), so the summary is given the\n// part of the day instead (Ricardo). Assumes the day starts at midnight on\n// the hour and has 24 hours of 2.5 real minutes.\nCR.phase = function (t) {\n  var d = new Date(t), h = (d.getMinutes() + d.getSeconds() / 60) * 24 / 60;\n  return h < 5 ? \"night\" : h < 7 ? \"dawn\" : h < 12 ? \"morning\" : h < 14 ? \"midday\" : h < 18 ? \"afternoon\" : h < 21 ? \"evening\" : \"late evening\";\n};\n// The day's record as lines, cut to the budget.\nCR.recordText = function (b) {\n  var out = [], len = 0;\n  for (var i = 0; i < b.ev.length; i++) {\n    var e = b.ev[i];\n    if (e.k == \"link\" && e.src == \"chronicle\") continue;\n    // A stay's minutes are the real clock: say how long in the world's terms.\n    var what = e.k == \"stay\" ? \"Stayed \" + ((e.min || 0) >= 30 ? \"most of the day\" : (e.min || 0) >= 15 ? \"a good while\" : \"a while\") + \" in \" + e.room + (e.area ? \", \" + e.area : \"\") + (e.with && e.with.length ? \", with \" + e.with.join(\", \") : \"\") : CR.show(e);\n    var ln = CR.phase(e.t) + \" \" + e.k + \": \" + CR.clip(what, 1500).replace(/\\n/g, \" / \");\n    if (len + ln.length > CR.budget) { out.push(\"(the rest of the record is cut short)\"); break; }\n    out.push(ln);\n    len += ln.length + 1;\n  }\n  return out.join(\"\\n\");\n};\nCR.prevSum = function (d) {\n  for (var i = CR.days.length - 1; i >= 0; i--) { if (CR.days[i].d < d && CR.days[i].sum) return CR.days[i].sum.text; }\n  return \"\";\n};\n\n// --- what other packages know, through loom (#493) ---------------------------\n// The people in a stretch of days, and what the character's own books say\n// about them and about what they're after: asked of loom's links as\n// questions (person.context, person.aims, character.goals), so chronicle\n// knows nothing of standings or ledger. With no links, nothing is added.\nCR.people = function (ds) {\n  var seen = {}, out = [], me = String(CR.me || \"\").toLowerCase();\n  var add = function (n) {\n    n = String(n || \"\").split(/[\\s,]+/)[0];\n    if (!/^[A-Za-z]{2,}$/.test(n)) return;\n    var lc = n.toLowerCase();\n    if (lc === me || lc === \"you\" || seen[lc] || CR.ignored(lc)) return;\n    seen[lc] = true;\n    out.push(n.charAt(0).toUpperCase() + n.slice(1).toLowerCase());\n  };\n  for (var i = 0; i < ds.length; i++) {\n    for (var j = 0; j < ds[i].ev.length; j++) {\n      var e = ds[i].ev[j];\n      if (e.k == \"chan\" || e.k == \"emote\" || e.k == \"msg\") add(e.who);\n      if (e.to) add(e.to);\n      if (e.k == \"news\") add(e.from);\n      if (e.with) { for (var w = 0; w < e.with.length; w++) add(e.with[w]); }\n    }\n  }\n  return out;\n};\nCR.context = function (ds, from, to) {\n  var LL = client.loom && client.loom.loom;\n  if (!LL || typeof LL.answer != \"function\") return \"\";\n  var lines = [], names = CR.people(ds).slice(0, 20);\n  for (var i = 0; i < names.length; i++) {\n    var bits = [];\n    var who = LL.answers(\"chronicle\", \"person.context\", names[i]);\n    for (var a = 0; a < who.length; a++) bits.push(String(who[a].value));\n    var aims = LL.answers(\"chronicle\", \"person.aims\", names[i]);\n    for (var b = 0; b < aims.length; b++) bits.push(String(aims[b].value));\n    if (bits.length) lines.push(\"- \" + names[i] + \": \" + bits.join(\"; \"));\n  }\n  var out = [];\n  if (lines.length) out.push(\"The people in it, as \" + (CR.me || \"the character\") + \"'s own books describe them (true; use what matters, don't recite it):\\n\" + lines.join(\"\\n\"));\n  var goals = LL.answers(\"chronicle\", \"character.goals\", { from: from, to: to });\n  for (var g = 0; g < goals.length; g++) out.push(String(goals[g].value));\n  return out.join(\"\\n\\n\");\n};\n\n// --- months and years --------------------------------------------------------\n// A day number's month and year: day d is year * 300 + month * 25 + day, so\n// (d - 1) / 25 counts months and (d - 1) / 300 years from 0 AF.\nCR.monthOf = function (d) { return Math.floor((d - 1) / 25); };\nCR.yearOf = function (d) { return Math.floor((d - 1) / 300); };\nCR.monthName = function (m) { return CR.months[m % 12] + \", \" + Math.floor(m / 12) + \" AF\"; };\nCR.yearName = function (y) { return \"the year \" + y + \" AF\"; };\n// The rollups, saved apart from the days: chronicle_annals = { m: { month:\n// sum }, y: { year: sum }, f: { \"m123\": failures } }.\nif (!CR.annals || typeof CR.annals != \"object\") {\n  var crAn = CR.readVar(\"chronicle_annals\");\n  CR.annals = (crAn && typeof crAn == \"object\" && !Array.isArray(crAn)) ? crAn : {};\n}\nif (!CR.annals.m || typeof CR.annals.m != \"object\") CR.annals.m = {};\nif (!CR.annals.y || typeof CR.annals.y != \"object\") CR.annals.y = {};\nif (!CR.annals.f || typeof CR.annals.f != \"object\") CR.annals.f = {};\nCR.saveAnnals = function () { set_variable(\"chronicle_annals\", JSON.stringify(CR.annals)); };\nCR.daysOfMonth = function (m) { return CR.days.filter(function (b) { return b.d > 0 && CR.monthOf(b.d) === m; }); };\nCR.monthsOfYear = function (y) {\n  var seen = {}, out = [], i;\n  for (i = 0; i < CR.days.length; i++) { if (CR.days[i].d > 0 && CR.yearOf(CR.days[i].d) === y) seen[CR.monthOf(CR.days[i].d)] = true; }\n  for (var k in CR.annals.m) { if (CR.annals.m.hasOwnProperty(k) && Math.floor(k / 12) === y) seen[k] = true; }\n  for (var n in seen) { if (seen.hasOwnProperty(n)) out.push(parseInt(n, 10)); }\n  return out.sort(function (a, b) { return a - b; });\n};\n// What a rollup is written from: the entries below it, and the player's own\n// notes (they're what a summary of summaries most easily loses).\nCR.monthText = function (m) {\n  var out = [], notes = [], ds = CR.daysOfMonth(m);\n  for (var i = 0; i < ds.length; i++) {\n    if (ds[i].sum && !ds[i].sum.draft) out.push(\"[\" + CR.dayName(ds[i].d).replace(/,.*$/, \"\") + \"] \" + ds[i].sum.text);\n    for (var j = 0; j < ds[i].ev.length; j++) { if (ds[i].ev[j].k == \"note\") notes.push(ds[i].ev[j].text); }\n  }\n  return out.join(\"\\n\\n\") + (notes.length ? \"\\n\\nNotes the player made this month: \" + notes.join(\" / \") : \"\");\n};\nCR.yearText = function (y) {\n  var out = [], ms = CR.monthsOfYear(y);\n  for (var i = 0; i < ms.length; i++) { var a = CR.annals.m[ms[i]]; if (a && !a.draft) out.push(\"[\" + CR.months[ms[i] % 12] + \"] \" + a.text); }\n  return out.join(\"\\n\\n\");\n};\n\n// --- the queue ----------------------------------------------------------------\n// Items: a day number, \"m<month>\" or \"y<year>\". Every finished day with a\n// record and no summary (or a draft), then every finished month whose days\n// are all done, then every finished year whose months are: written one at a\n// time, oldest first, at each new day and at load. Three failures leave an\n// item for CHRONICLE WRITE.\nCR.fails = function (it) { return typeof it == \"number\" ? ((CR.bucket(it, false) || {}).fails || 0) : (CR.annals.f[it] || 0); };\nCR.due = function () {\n  var today = CR.today();\n  if (!today || CR.retryT) return;\n  var curM = CR.monthOf(today), curY = CR.yearOf(today), i, max = CR.retryMs.length;\n  var add = function (it) { if (CR.queue.indexOf(it) < 0 && CR.fails(it) < max) CR.queue.push(it); };\n  var months = {}, years = {};\n  for (i = 0; i < CR.days.length; i++) {\n    var b = CR.days[i];\n    if (b.d <= 0) continue;\n    if (b.d < today && b.ev.length && (!b.sum || b.sum.draft)) add(b.d);\n    months[CR.monthOf(b.d)] = true;\n  }\n  for (var m in months) {\n    if (!months.hasOwnProperty(m)) continue;\n    m = parseInt(m, 10);\n    years[Math.floor(m / 12)] = true;\n    var am = CR.annals.m[m];\n    if (m >= curM || (am && !am.draft)) continue;\n    var ds = CR.daysOfMonth(m), ready = true, any = false;\n    for (i = 0; i < ds.length; i++) {\n      if (ds[i].sum && !ds[i].sum.draft) any = true;\n      else if (ds[i].ev.length && (ds[i].fails || 0) < max) ready = false;\n    }\n    if (ready && any) add(\"m\" + m);\n  }\n  for (var k in CR.annals.m) { if (CR.annals.m.hasOwnProperty(k)) years[Math.floor(k / 12)] = true; }\n  for (var y in years) {\n    if (!years.hasOwnProperty(y)) continue;\n    y = parseInt(y, 10);\n    var ay = CR.annals.y[y];\n    if (y >= curY || (ay && !ay.draft)) continue;\n    var ms = CR.monthsOfYear(y), done = true, has = false;\n    for (i = 0; i < ms.length; i++) {\n      var a = CR.annals.m[ms[i]];\n      if (a && !a.draft) has = true;\n      else if ((CR.annals.f[\"m\" + ms[i]] || 0) < max && CR.daysOfMonth(ms[i]).length) done = false;\n    }\n    if (done && has) add(\"y\" + y);\n  }\n  var rank = function (it) { return typeof it == \"number\" ? [0, it] : it.charAt(0) === \"m\" ? [1, +it.slice(1)] : [2, +it.slice(1)]; };\n  CR.queue.sort(function (a, c) { var x = rank(a), z = rank(c); return x[0] - z[0] || x[1] - z[1]; });\n  CR.pump();\n};\nCR.pump = function () {\n  if (CR.busy || !CR.queue.length || !CR.auto || !CR.getKey()) return;\n  CR.write(CR.queue.shift(), false);\n};\nCR.label = function (it) { return typeof it == \"number\" ? CR.dayName(it) : it.charAt(0) === \"m\" ? CR.monthName(+it.slice(1)) : CR.yearName(+it.slice(1)); };\n// The request. Recent models think before answering, and thinking counts\n// against max_tokens: a busy day's thinking used up 900 and left no text\n// (Ricardo, 2026-11-13). So: room for both, and low effort (a summary\n// doesn't need deep thought). A model that refuses those settings (400) is\n// asked again without them, and they stay off for the session.\nCR.lean = CR.lean !== false;\nCR.request = function (sys, user) {\n  var r = { model: CR.model, max_tokens: 4000, system: sys, messages: [{ role: \"user\", content: user }] };\n  if (CR.lean) { r.thinking = { type: \"adaptive\" }; r.output_config = { effort: \"low\" }; }\n  return r;\n};\n// One call. manual: CHRONICLE WRITE, which reports back and ignores past\n// failures. Something still going (today, this month) gets a draft, replaced\n// when it ends.\nCR.write = function (it, manual) {\n  var key = CR.getKey(), sys, user;\n  if (typeof it == \"number\") {\n    var b = CR.bucket(it, false);\n    if (!b || !b.ev.length) { if (manual) display_notice(\"[chronicle] nothing recorded for \" + CR.dayName(it) + \".\", \"cyan\"); CR.pump(); return; }\n    // A quiet day (few lines beyond places) is told as one: a sentence or two.\n    var said = 0;\n    for (var qi = 0; qi < b.ev.length; qi++) { if (b.ev[qi].k != \"place\" && b.ev[qi].k != \"stay\") said += b.ev[qi].n || 1; }\n    var quiet = said < CR.quietLines;\n    sys = CR.system(CR.prevSum(it), { what: \"day\", words: quiet ? 40 : CR.words, quiet: quiet, ctx: CR.context([b], it, it) });\n    user = \"The record of \" + CR.dayName(it) + \", line by line (part of the day, kind, what happened):\\n\\n\" + CR.recordText(b) + \"\\n\\nWrite the entry for this day.\";\n  } else if (it.charAt(0) === \"m\") {\n    var m = +it.slice(1), mt = CR.monthText(m);\n    if (!/\\S/.test(mt)) { if (manual) display_notice(\"[chronicle] no day of \" + CR.monthName(m) + \" has its summary yet.\", \"cyan\"); CR.pump(); return; }\n    var pm = CR.annals.m[m - 1];\n    sys = CR.system(pm ? pm.text : \"\", { what: \"month\", words: 200, ctx: CR.context(CR.daysOfMonth(m), m * 25 + 1, m * 25 + 25) });\n    user = \"The entries for the days of \" + CR.monthName(m) + \" that were played, in order:\\n\\n\" + mt + \"\\n\\nWrite the entry for this month.\";\n  } else {\n    var y = +it.slice(1), yt = CR.yearText(y);\n    if (!/\\S/.test(yt)) { if (manual) display_notice(\"[chronicle] no month of \" + CR.yearName(y) + \" has its summary yet.\", \"cyan\"); CR.pump(); return; }\n    var py = CR.annals.y[y - 1];\n    sys = CR.system(py ? py.text : \"\", { what: \"year\", words: 250, ctx: CR.context([], y * 300 + 1, y * 300 + 300) });\n    user = \"The entries for the months of \" + CR.yearName(y) + \" that were played, in order:\\n\\n\" + yt + \"\\n\\nWrite the entry for this year.\";\n  }\n  if (!key) { if (manual) display_notice(\"[chronicle] no API key in this browser: CHRONICLE KEY <key> first.\", \"orange\"); return; }\n  CR.busy = true;\n  CR.writing = it;\n  var started = Date.now();\n  fetch(CR.api, {\n    method: \"POST\",\n    headers: { \"x-api-key\": key, \"anthropic-version\": \"2023-06-01\", \"anthropic-dangerous-direct-browser-access\": \"true\", \"content-type\": \"application/json\" },\n    body: JSON.stringify(CR.request(sys, user))\n  }).then(function (r) {\n    return r.json().then(function (j) { return { status: r.status, j: j }; }, function () { return { status: r.status, j: null }; });\n  }).then(function (res) {\n    client.loom.chronicle.written(it, res, manual, started);\n  }).catch(function (e) {\n    client.loom.chronicle.written(it, { status: 0, j: null, err: String(e && e.message || e) }, manual, started);\n  });\n};\nCR.written = function (it, res, manual, started) {\n  CR.busy = false;\n  CR.writing = null;\n  var j = res.j || {}, today = CR.today();\n  // The answer's text blocks (a model may put other blocks, such as its\n  // thinking, before them).\n  var text = \"\", kinds = [];\n  if (Array.isArray(j.content)) {\n    for (var ci = 0; ci < j.content.length; ci++) {\n      var blk = j.content[ci] || {};\n      kinds.push(blk.type || \"?\");\n      if (blk.type === \"text\" && typeof blk.text == \"string\") text += (text ? \"\\n\\n\" : \"\") + blk.text;\n    }\n  }\n  text = text.replace(/^\\s+|\\s+$/g, \"\");\n  try { CR.lastRes = res.status + \" \" + CR.clip(JSON.stringify(j), 600); } catch (e) { CR.lastRes = String(res.status); }\n  var label = CR.label(it);\n  if (res.status === 200 && text) {\n    if (j.usage) { CR.usage.calls++; CR.usage.inTok += j.usage.input_tokens || 0; CR.usage.outTok += j.usage.output_tokens || 0; set_variable(\"chronicle_usage\", JSON.stringify(CR.usage)); }\n    var sum = { text: text, at: Date.now(), model: CR.model };\n    if (typeof it == \"number\") {\n      var b = CR.bucket(it, false);\n      if (b) { sum.draft = it >= today; b.sum = sum; delete b.fails; }\n    } else if (it.charAt(0) === \"m\") {\n      sum.draft = +it.slice(1) >= CR.monthOf(today); CR.annals.m[+it.slice(1)] = sum; delete CR.annals.f[it]; CR.saveAnnals();\n    } else {\n      sum.draft = +it.slice(1) >= CR.yearOf(today); CR.annals.y[+it.slice(1)] = sum; delete CR.annals.f[it]; CR.saveAnnals();\n    }\n    CR.lastErr = \"\";\n    if (manual) display_notice(\"[chronicle] \" + label + \" written.\", \"lime\");\n    CR.save();\n    CR.dirty();\n    if (!manual) CR.due(); else CR.pump();\n    return;\n  }\n  var why = res.err ? \"no answer (\" + res.err + \")\" : (j.error && j.error.message) ? res.status + \": \" + j.error.message :\n    res.status === 200 ? \"an answer with no text (stop: \" + (j.stop_reason || \"?\") + \", blocks: \" + (kinds.join(\", \") || \"none\") + \"; CHRONICLE DEBUG shows it)\" : \"answer \" + res.status;\n  CR.lastErr = why;\n  if (res.status === 400 && CR.lean && /thinking|effort|output_config/i.test(String(j.error && j.error.message || \"\"))) {\n    CR.lean = false;\n    CR.write(it, manual);\n    return;\n  }\n  // A bad key or a bad model won't get better by waiting: stop and say so.\n  if (res.status === 401 || res.status === 403 || res.status === 404 || res.status === 400) {\n    CR.queue = [];\n    display_notice(\"[chronicle] the summary for \" + label + \" failed, \" + why + \". \" +\n      (res.status === 401 || res.status === 403 ? \"Check your key (CHRONICLE KEY <key>).\" : \"Check the model (CHRONICLE MODEL).\"), \"orange\");\n    CR.dirty();\n    return;\n  }\n  var n = 0;\n  if (!manual) {\n    if (typeof it == \"number\") { var fb = CR.bucket(it, false); if (fb) n = fb.fails = (fb.fails || 0) + 1; }\n    else { n = CR.annals.f[it] = (CR.annals.f[it] || 0) + 1; CR.saveAnnals(); }\n  }\n  if (manual) display_notice(\"[chronicle] the summary for \" + label + \" failed, \" + why + \".\", \"orange\");\n  else if (n < CR.retryMs.length) {\n    CR.queue = [];\n    CR.retryT = setTimeout(function () { var c = client.loom.chronicle; c.retryT = null; c.due(); }, CR.retryMs[n - 1]);\n  } else display_notice(\"[chronicle] gave up on the summary for \" + label + \" after \" + n + \" tries (\" + why + \"). CHRONICLE WRITE to try again.\", \"orange\");\n  CR.save();\n  CR.dirty();\n  CR.pump();\n};\n// What CHRONICLE WRITE names: a day (\"8 Scarlatan\", \"today\", \"yesterday\", or\n// nothing for the last day before today), MONTH [name] (this month if none),\n// or YEAR [number] (this year if none).\nCR.findItem = function (s) {\n  s = String(s || \"\").replace(/^\\s+|\\s+$/g, \"\").toLowerCase();\n  var today = CR.today(), m;\n  if ((m = /^month(?:\\s+(.+))?$/.exec(s))) {\n    if (!m[1]) return today ? \"m\" + CR.monthOf(today) : 0;\n    for (var k = CR.months.length - 1; k >= 0; k--) {\n      if (CR.months[k].toLowerCase().indexOf(m[1]) === 0) {\n        var cm = CR.monthOf(today), yy = Math.floor(cm / 12);\n        var mi = yy * 12 + k;\n        if (mi > cm) mi -= 12;\n        return \"m\" + mi;\n      }\n    }\n    return 0;\n  }\n  if ((m = /^year(?:\\s+(\\d+))?$/.exec(s))) return m[1] ? \"y\" + parseInt(m[1], 10) : (today ? \"y\" + CR.yearOf(today) : 0);\n  if (!s) { for (var i = CR.days.length - 1; i >= 0; i--) { if (CR.days[i].d > 0 && CR.days[i].d < today && CR.days[i].ev.length) return CR.days[i].d; } return 0; }\n  if (s === \"today\") return today;\n  if (s === \"yesterday\") return today - 1;\n  if (!(m = /^(\\d+)(?:st|nd|rd|th)?\\s+(?:of\\s+)?([a-z]+)/.exec(s))) return 0;\n  for (var j = CR.days.length - 1; j >= 0; j--) {\n    if (CR.dayName(CR.days[j].d).toLowerCase().indexOf(CR.ord(parseInt(m[1], 10)) + \" \" + m[2]) === 0) return CR.days[j].d;\n  }\n  return 0;\n};\n"
  },
  {
   "type": "alias",
   "name": "Chronicle control",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// CHRONICLE [command] -- see chronicle_help.\nif (!client.loom || !client.loom.chronicle || !client.loom.chronicle.line) run_function(\"chronicle_setup\", [], \"chronicle\");\nvar CR = client.loom.chronicle;\nvar crIn = String(args[1] || \"\").replace(/^\\s+|\\s+$/g, \"\");\nvar crW = crIn.split(/\\s+/);\nvar crCmd = crIn ? crW[0].toUpperCase() : \"\";\nvar crRest = crIn.replace(/^\\S+\\s*/, \"\");\nCR.borrowDate();\nif (crCmd === \"\" || crCmd === \"STATUS\") {\n  var crToday = CR.today();\n  var crB = CR.bucket(crToday, false);\n  var crKept = 0;\n  for (var crI = 0; crI < CR.days.length; crI++) crKept += CR.days[crI].ev.length;\n  display_notice(\"[chronicle] \" + (crToday ? \"Today is the \" + CR.dayName(crToday) + \".\" : \"The date isn't known yet: it comes with the next hour's date line, or DATE.\") +\n    \" Today: \" + (crB ? crB.ev.length : 0) + \" entr\" + (crB && crB.ev.length === 1 ? \"y\" : \"ies\") + \". Kept: \" + CR.days.length + \" day\" + (CR.days.length === 1 ? \"\" : \"s\") + \", \" + crKept + \" entries.\" +\n    \" Summaries: \" + (!CR.getKey() ? \"no key (CHRONICLE KEY)\" : CR.auto ? \"on, \" + CR.model : \"off\") + (CR.usage.calls ? \"; \" + CR.usage.calls + \" written, \" + CR.usage.inTok + \" tokens in, \" + CR.usage.outTok + \" out\" : \"\") + (CR.lastErr ? \"; last error: \" + CR.lastErr : \"\") + \".\", \"cyan\");\n} else if (crCmd === \"HELP\") {\n  run_function(\"chronicle_help\", [], \"chronicle\");\n} else if (crCmd === \"NOTE\") {\n  if (!crRest) display_notice(\"[chronicle] usage: CHRONICLE NOTE <text>\", \"orange\");\n  else { CR.add({ k: \"note\", text: CR.clip(crRest, CR.textMax) }); display_notice(\"[chronicle] noted.\", \"lime\"); }\n} else if (crCmd === \"CHANNELS\") {\n  var crKeys = {};\n  for (var crK in CR.seen) { if (CR.seen.hasOwnProperty(crK)) crKeys[crK] = true; }\n  for (var crO in CR.over) { if (CR.over.hasOwnProperty(crO)) crKeys[crO] = true; }\n  var crList = [];\n  for (var crL in crKeys) { if (crKeys.hasOwnProperty(crL)) crList.push(crL); }\n  crList.sort();\n  if (!crList.length) display_notice(\"[chronicle] no channel heard yet this session.\", \"cyan\");\n  else {\n    display_notice(\"[chronicle] channels (heard this session or set by you):\", \"cyan\");\n    for (var crJ = 0; crJ < crList.length; crJ++) {\n      var crC = crList[crJ];\n      var crOn = crC === \"tells\" ? (CR.over.tells !== undefined ? !!CR.over.tells : true) : CR.chanOn(crC);\n      var crCap = CR.captions[crC] ? \" (\" + CR.captions[crC] + \")\" : \"\";\n      display_notice(\"  \" + crC + crCap + \": \" + (crOn ? \"kept\" : \"left out\") + (CR.over[crC] !== undefined ? \", set by you\" : \"\"), crOn ? \"lime\" : \"cyan\");\n    }\n  }\n} else if (crCmd === \"CHANNEL\") {\n  var crName = String(crW[1] || \"\").toLowerCase();\n  var crSw = String(crW[2] || \"\").toUpperCase();\n  if (!crName || (crSw !== \"ON\" && crSw !== \"OFF\" && crSw !== \"DEFAULT\")) display_notice(\"[chronicle] usage: CHRONICLE CHANNEL <name> ON|OFF|DEFAULT (names as CHRONICLE CHANNELS shows them)\", \"orange\");\n  else {\n    if (crName === \"tell\") crName = \"tells\";\n    if (crSw === \"DEFAULT\") delete CR.over[crName];\n    else CR.over[crName] = crSw === \"ON\";\n    set_variable(\"chronicle_channels\", JSON.stringify(CR.over));\n    display_notice(\"[chronicle] \" + crName + \": \" + (crSw === \"DEFAULT\" ? \"back to the default (\" + ((crName === \"tells\" || CR.chanDefault(crName)) ? \"kept\" : \"left out\") + \")\" : (crSw === \"ON\" ? \"kept\" : \"left out\")) + \".\", \"lime\");\n  }\n} else if (crCmd === \"EXPORT\") {\n  if (String(crW[1] || \"\").toUpperCase() === \"SHOW\") {\n    var crMd = CR.lastExport || CR.markdown(CR.days);\n    var crEsc = crMd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    if (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\") nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre-wrap\">' + crEsc + '</span>');\n    else display_notice(crMd, \"cyan\");\n  } else if (!CR.days.length) {\n    display_notice(\"[chronicle] nothing recorded yet.\", \"cyan\");\n  } else if (CR.download()) {\n    display_notice(\"[chronicle] exported \" + CR.days.length + \" day\" + (CR.days.length === 1 ? \"\" : \"s\") + \" as a Markdown file. No download? CHRONICLE EXPORT SHOW prints it here to copy.\", \"lime\");\n  } else {\n    display_notice(\"[chronicle] the browser refused the download: CHRONICLE EXPORT SHOW prints the record here to copy.\", \"orange\");\n  }\n} else if (crCmd === \"KEY\") {\n  var crKey = crW[1] || \"\";\n  if (!crKey) display_notice(\"[chronicle] \" + (CR.getKey() ? \"an API key is set in this browser.\" : \"no API key in this browser.\") + \" CHRONICLE KEY <key> sets it, CHRONICLE KEY CLEAR removes it.\", \"cyan\");\n  else if (crKey.toUpperCase() === \"CLEAR\") { CR.setKey(\"\"); display_notice(\"[chronicle] key removed from this browser.\", \"lime\"); }\n  else if (!CR.setKey(crKey)) display_notice(\"[chronicle] this browser wouldn't store the key.\", \"orange\");\n  else {\n    display_notice(\"[chronicle] key stored in this browser only (not in your Nexus settings: set it again on another computer). Each day's record, including what others said around you, is sent to Anthropic to write its summary; it costs a little per day on your key.\", \"lime\");\n    CR.due();\n  }\n} else if (crCmd === \"VOICE\") {\n  if (!crRest) display_notice(\"[chronicle] \" + (CR.voice ? \"your notes on the character: \" + CR.voice : \"no notes on the character yet: CHRONICLE VOICE <text> (who they are, what they're after, how they speak).\") + \" The game adds: \" + (CR.facts() || \"nothing yet (log in again)\") + \" Written in the \" + CR.person + \" person.\", \"cyan\");\n  else if (crRest.toUpperCase() === \"CLEAR\") { CR.voice = \"\"; set_variable(\"chronicle_voice\", \"\"); display_notice(\"[chronicle] notes cleared.\", \"lime\"); }\n  else { CR.voice = CR.clip(crRest, 2000); set_variable(\"chronicle_voice\", CR.voice); display_notice(\"[chronicle] notes kept; the next summary uses them.\", \"lime\"); }\n} else if (crCmd === \"PERSON\") {\n  var crP = String(crW[1] || \"\").toUpperCase();\n  if (crP !== \"FIRST\" && crP !== \"THIRD\") display_notice(\"[chronicle] usage: CHRONICLE PERSON FIRST|THIRD (now \" + CR.person + \").\", \"orange\");\n  else { CR.person = crP.toLowerCase(); set_variable(\"chronicle_person\", CR.person); display_notice(\"[chronicle] summaries in the \" + CR.person + \" person\" + (CR.person === \"first\" ? \", as the character's journal.\" : \", as a chronicler's record.\"), \"lime\"); }\n} else if (crCmd === \"MODEL\") {\n  if (!crW[1]) display_notice(\"[chronicle] model: \" + CR.model + \". CHRONICLE MODEL <id> to change it, DEFAULT for \" + CR.defaultModel + \".\", \"cyan\");\n  else { CR.model = crW[1].toUpperCase() === \"DEFAULT\" ? CR.defaultModel : crW[1]; set_variable(\"chronicle_model\", CR.model === CR.defaultModel ? \"\" : CR.model); display_notice(\"[chronicle] model: \" + CR.model + \".\", \"lime\"); }\n} else if (crCmd === \"SUMMARIES\") {\n  var crS = String(crW[1] || \"\").toUpperCase();\n  if (crS !== \"ON\" && crS !== \"OFF\") display_notice(\"[chronicle] usage: CHRONICLE SUMMARIES ON|OFF (now \" + (CR.auto ? \"on\" : \"off\") + \").\", \"orange\");\n  else { CR.auto = crS === \"ON\"; set_variable(\"chronicle_auto\", CR.auto ? \"on\" : \"off\"); display_notice(\"[chronicle] summaries at the end of each day \" + (CR.auto ? \"on.\" : \"off: CHRONICLE WRITE still writes one by hand.\"), \"lime\"); if (CR.auto) CR.due(); }\n} else if (crCmd === \"WRITE\") {\n  var crWd = CR.findItem(crRest);\n  if (!crWd) display_notice(\"[chronicle] nothing by that name in the record\" + (crRest ? \" ('\" + crRest + \"')\" : \"\") + \". CHRONICLE WRITE [today|yesterday|<day> <month>|MONTH [name]|YEAR [number]].\", \"orange\");\n  else if (CR.busy) display_notice(\"[chronicle] a summary is being written; try again in a moment.\", \"orange\");\n  else { display_notice(\"[chronicle] writing \" + CR.label(crWd) + \"...\", \"cyan\"); CR.write(crWd, true); }\n} else if (crCmd === \"RETRY\") {\n  var crF = 0;\n  for (var crR = 0; crR < CR.days.length; crR++) { if (CR.days[crR].fails) { crF++; delete CR.days[crR].fails; } }\n  for (var crAf in CR.annals.f) { if (CR.annals.f.hasOwnProperty(crAf)) crF++; }\n  CR.annals.f = {};\n  CR.saveAnnals();\n  if (CR.retryT) { clearTimeout(CR.retryT); CR.retryT = null; }\n  CR.save();\n  display_notice(\"[chronicle] \" + (crF ? crF + \" failed summar\" + (crF === 1 ? \"y\" : \"ies\") + \" will be tried again\" : \"nothing had failed\") + \"; writing what's due.\", \"lime\");\n  CR.due();\n  run_function(\"chronicle_render\", [], \"chronicle\");\n} else if (crCmd === \"IGNORE\" || crCmd === \"UNIGNORE\") {\n  var crWho = String(crW[1] || \"\").replace(/[^A-Za-z]/g, \"\");\n  if (!crWho) display_notice(\"[chronicle] \" + (CR.ignore.length ? \"left out of the record: \" + CR.ignore.map(function (n) { return n.charAt(0).toUpperCase() + n.slice(1); }).join(\", \") + \".\" : \"no one is left out of the record.\") + \" CHRONICLE IGNORE|UNIGNORE <name>.\", \"cyan\");\n  else {\n    var crLc = crWho.toLowerCase(), crNm = crLc.charAt(0).toUpperCase() + crLc.slice(1);\n    if (crCmd === \"IGNORE\") {\n      if (CR.ignore.indexOf(crLc) < 0) CR.ignore.push(crLc);\n      set_variable(\"chronicle_ignore\", JSON.stringify(CR.ignore));\n      var crGone = CR.purge(crLc);\n      CR.save();\n      display_notice(\"[chronicle] \" + crNm + \" is left out of the record from now on: their words, emotes, messages and posts aren't kept, and other lines say \\\"someone\\\" for them.\" + (crGone ? \" \" + crGone + \" line\" + (crGone === 1 ? \"\" : \"s\") + \" already kept were removed.\" : \"\") + \" Summaries already written stay as they are (CHRONICLE WRITE <day> rewrites one).\", \"lime\");\n    } else {\n      CR.ignore = CR.ignore.filter(function (n) { return n !== crLc; });\n      set_variable(\"chronicle_ignore\", JSON.stringify(CR.ignore));\n      display_notice(\"[chronicle] \" + crNm + \" is recorded again from now on.\", \"lime\");\n    }\n  }\n} else if (crCmd === \"VIEW\") {\n  var crV = String(crW[1] || \"\").toLowerCase();\n  if (crV !== \"days\" && crV !== \"months\" && crV !== \"years\") display_notice(\"[chronicle] usage: CHRONICLE VIEW DAYS|MONTHS|YEARS (or click them in the tab).\", \"orange\");\n  else CR.setView(crV);\n} else if (crCmd === \"DEBUG\") {\n  var crN = 0;\n  for (var crD = 0; crD < CR.days.length; crD++) crN += CR.days[crD].ev.length;\n  display_notice(\"[chronicle] me=\" + (CR.me || \"?\") + \" anchor=\" + (CR.anchor ? JSON.stringify(CR.anchor) : \"none\") + \" today=\" + CR.today() +\n    \" days=\" + CR.days.length + \" events=\" + crN + \" bytes~\" + JSON.stringify(CR.days).length +\n    \" room=\" + (CR.room ? CR.room.name + \" (\" + Math.round((Date.now() - CR.room.at) / 1000) + \"s)\" : \"none\") +\n    \" area=\" + (CR.area ? CR.area.name : \"none\") + \" players=\" + Object.keys(CR.players).join(\",\") +\n    \" capture=\" + (CR.capt ? CR.capt.ev.k + \"/\" + CR.capt.lines.length : \"none\") + \" more=\" + (CR.cont ? \"waiting\" : \"no\") +\n    \" overrides=\" + JSON.stringify(CR.over) + \" queue=\" + JSON.stringify(CR.queue) + \" busy=\" + CR.busy + \" key=\" + (CR.getKey() ? \"set\" : \"none\") + \" char=\" + JSON.stringify(CR.char) + (CR.lastRes ? \" lastAnswer=\" + CR.lastRes : \"\"), \"cyan\");\n} else if (crCmd === \"RESET\") {\n  if (CR.saveT) { clearTimeout(CR.saveT); CR.saveT = null; CR.save(); }\n  client.loom.chronicle = {};\n  run_function(\"chronicle_setup\", [], \"chronicle\");\n  run_function(\"chronicle_render\", [], \"chronicle\");\n  display_notice(\"[chronicle] rebuilt from the saved variables; the record is kept.\", \"lime\");\n} else if (crCmd === \"CLEAR\") {\n  var crAll = 0;\n  for (var crE = 0; crE < CR.days.length; crE++) crAll += CR.days[crE].ev.length;\n  if (String(crW[1] || \"\").toUpperCase() !== \"CONFIRM\") display_notice(\"[chronicle] this throws away the whole record (\" + CR.days.length + \" days, \" + crAll + \" entries). CHRONICLE CLEAR CONFIRM to do it; CHRONICLE EXPORT first to keep a copy.\", \"orange\");\n  else {\n    CR.days = [];\n    CR.save();\n    run_function(\"chronicle_render\", [], \"chronicle\");\n    display_notice(\"[chronicle] the record is cleared.\", \"lime\");\n  }\n} else {\n  display_notice(\"[chronicle] unknown command '\" + crW[0] + \"'. CHRONICLE HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^chronicle(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "Chronicle every line",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Every line: the work is in chronicle_setup's CR.line (#136: this runs on every game line, so it stays short).\nif (!client.loom || !client.loom.chronicle || !client.loom.chronicle.line) run_function(\"chronicle_setup\", [], \"chronicle\");\nclient.loom.chronicle.line(args[0]);\n"
    }
   ],
   "text": "^(.*)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  }
 ],
 "description": "A record of each Achaean day: places, IC talk, letters and news, notes"
}