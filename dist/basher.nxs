{
 "type": "group",
 "name": "basher",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"basher_setup\", [], \"basher\");\ndisplay_notice(\"[basher] installed, OFF. BASHER HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Stop the loop, so nothing is sent once the package is gone.\nvar B = client.loom && client.loom.basher;\nif (B && B.loop) { clearInterval(B.loop); B.loop = null; }\nif (B) B.on = false;\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Always loads OFF. Hunting may load after this package, so its absence is\n// told a little later, once.\nrun_function(\"basher_setup\", [], \"basher\");\nsetTimeout(function () {\n  var B = client.loom && client.loom.basher;\n  if (B && !B.hunting()) display_notice(\"[basher] needs the hunting package to attack; it sends nothing without it.\", \"orange\");\n}, 5000);\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// The basher's own view of the room and of you, from GMCP (it reads nothing\n// of room's): balance, equilibrium and health from Char.Vitals; mobs and\n// items here from Char.Items; players here from Room.Players.\nif (!client.loom || !client.loom.basher) run_function(\"basher_setup\", [], \"basher\");\nvar B = client.loom.basher;\nvar bsM = args.gmcp_method;\nvar bsA = args.gmcp_args;\n\nif (bsM === \"Char.Vitals\" && bsA) {\n  B.bal = String(bsA.bal) == \"1\";\n  B.eq = String(bsA.eq) == \"1\";\n  B.hp = to_number(bsA.hp);\n  B.maxhp = to_number(bsA.maxhp);\n  // The attack went out: balance or equilibrium is gone. The next recovery\n  // may attack again.\n  if (!B.bal || !B.eq) { B.sentAt = 0; B.misses = 0; }\n} else if (bsM === \"Room.Info\") {\n  // A new room: what was here is gone until its Char.Items.List.\n  B.room = {};\n  B.roomKnown = false;\n} else if (/^Char\\.Items\\.(List|Add|Remove|Update)$/.test(bsM) && bsA && bsA.location === \"room\") {\n  var bsIt = function (it) { return { name: String(it.name || \"\"), attrib: String(it.attrib || \"\") }; };\n  if (bsM === \"Char.Items.List\") {\n    B.room = {};\n    B.roomKnown = true;\n    var bsL = bsA.items || [];\n    for (var bsI = 0; bsI < bsL.length; bsI++) B.room[String(bsL[bsI].id)] = bsIt(bsL[bsI]);\n  } else if (bsM === \"Char.Items.Remove\") {\n    delete B.room[String(typeof bsA.item === \"object\" ? bsA.item.id : bsA.item)];\n  } else if (bsA.item) {\n    B.room[String(bsA.item.id)] = bsIt(bsA.item);\n  }\n} else if (bsM === \"IRE.Target.Set\") {\n  // The game's target as typed or an id, maybe quoted; empty means none.\n  var bsTs = String(bsA === null || bsA === undefined ? \"\" : (typeof bsA === \"object\" ? (bsA.target || bsA.id || \"\") : bsA)).replace(/^\"|\"$/g, \"\").trim();\n  B.game = { id: bsTs, name: \"\", at: Date.now() };\n} else if (bsM === \"IRE.Target.Info\" && bsA && bsA.id !== undefined) {\n  // Later updates for the same target carry only its health: keep its time.\n  var bsTi = String(bsA.id || \"\");\n  if (!(B.game && B.game.id === bsTi)) B.game = { id: bsTi, name: String(bsA.short_desc || \"\"), at: Date.now() };\n} else if (bsM === \"Room.Players\" && bsA) {\n  B.players = {};\n  for (var bsP = 0; bsP < bsA.length; bsP++) B.players[String(bsA[bsP].name || \"\").toLowerCase()] = true;\n} else if (bsM === \"Room.AddPlayer\" && bsA && bsA.name) {\n  B.players[String(bsA.name).toLowerCase()] = true;\n} else if (bsM === \"Room.RemovePlayer\" && bsA !== undefined) {\n  delete B.players[String(typeof bsA === \"object\" ? bsA.name : bsA).toLowerCase()];\n}\n"
  },
  {
   "type": "function",
   "name": "basher_setup",
   "enabled": true,
   "code": "// basher_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Namespace, registry, defaults, and the helpers\n// (rebuilt on every run; only data is kept).\n//\n// The basher is the automation layer over hunting (#115): it reads hunting's\n// class data (the main attack in use, HU.mainNow), and never writes to it.\n// Without hunting it sends nothing. Attended by design: it only reacts to\n// the current room and never walks.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.basher) client.loom.basher = {};\nclient.loom.registry.basher = { version: \"0.1.0\", keyword: \"BASHER\", desc: \"Attended autobasher: attacks your target with hunting's main attack\" };\nvar B = client.loom.basher;\n\n// Health threshold: attacks hold below it and resume 10 points above it.\nif (!get_variable(\"basher_health\")) set_variable(\"basher_health\", \"40\");\n\n// Runtime state, kept across a reimport. ON is never remembered across a load:\n// the basher always starts OFF.\n// Ricardo: BASHER ON only primes it (B.on); your own attack starts a run\n// (B.run, from basher_attackline), which lasts until the room has no more of\n// your target or BASHER STOP. Then it waits primed for your next attack.\nif (B.on === undefined) B.on = false;\nif (B.run === undefined) B.run = false;\nif (!B.room) B.room = {};          // mobs and items here: { id: { name, attrib } }\n// Whether B.room is this room's list: only once a Char.Items.List came after\n// the last Room.Info. Installed or reimported mid-room it isn't (Ricardo's\n// first test: the bear was \"not here\"), and then the target counts as here.\nif (B.roomKnown === undefined) B.roomKnown = false;\n// The game's own target (IRE.Target.Set/Info: { id, name, at }) and when the\n// tar variable last changed: whichever changed last is the target, as in\n// room's Here tab. Ricardo's test: tar went empty while the game still had\n// the bear targeted, and the staff hit it.\nif (B.game === undefined) B.game = null;\nif (B.tarSeen === undefined) { B.tarSeen = String(get_variable(\"tar\") || \"\").trim(); B.tarAt = 0; }\nif (!B.players) B.players = {};    // players here, lowercase name -> true\nif (B.bal === undefined) { B.bal = false; B.eq = false; B.hp = 0; B.maxhp = 0; }\nB.sentAt = B.sentAt || 0;          // when the last attack went out (0: none pending)\nB.misses = B.misses || 0;          // attacks sent without balance or equilibrium going\nB.low = !!B.low;                   // holding for health\nB.why = B.why || \"\";               // why it isn't attacking right now (status)\n\nB.tickMs = 250;    // how often the loop looks\nB.retryMs = 2500;  // an attack that took no balance by then is counted as a miss\nB.maxMisses = 3;   // that many in a row: the basher switches itself off\n\n// Hunting, read only. Undefined when it isn't installed (or not set up yet).\nB.hunting = function () {\n  var hu = client.loom.hunting;\n  return (hu && hu.classes && client.loom.registry.hunting) ? hu : undefined;\n};\n\n// The main attack: hunting's in use (HUNTING MAIN), else, for classes whose F1\n// is a plain key (dragons: {dragon} @tar), that key when it's a \"main\" attack\n// on the target. { name, cmd } or undefined.\nB.main = function () {\n  var hu = B.hunting();\n  if (!hu) return undefined;\n  if (hu.mainNow && hu.mainNow.cmd) return { name: hu.mainNow.name, cmd: hu.mainNow.cmd };\n  var e = hu.classes[hu.cls];\n  var f1 = e && e.keys && e.keys[0];\n  if (f1 && f1[2] == \"main\" && /@tar\\b/.test(f1[1] || \"\")) {\n    var nm = String(f1[0]) == \"{DRAGON}\" ? \"dragon attack\" : String(f1[0]);\n    return { name: nm, cmd: f1[1] };\n  }\n  return undefined;\n};\n\n// The attack: the main attack, sent bare on recovery (Ricardo:\n// send on recovery rather than the server's queue). Its \"queue add <flags>\"\n// prefixes are dropped, placeholders filled as hunting's buttons fill them,\n// and @tar replaced by the target. A list, one command per part (\"a | b\").\nB.commands = function (tar) {\n  var main = B.main();\n  if (!main) return [];\n  var staff = (client.loom.artificing && client.loom.artificing.staff) || get_variable(\"artificing_staff\") || \"scintilla\";\n  var dragon = get_variable(\"hunting_dragon_attack\") || \"gut\";\n  var party = get_variable(\"hunting_party_target\") || \"\";\n  var parts = String(main.cmd).split(\"|\");\n  var out = [];\n  for (var i = 0; i < parts.length; i++) {\n    var c = parts[i].trim().replace(/^queue\\s+add\\s+\\S+\\s+/i, \"\");\n    c = c.replace(/\\{staff\\}/g, staff).replace(/\\{dragon\\}/g, dragon).replace(/\\{target\\}/g, party).replace(/@tar\\b/gi, tar).trim();\n    if (c) out.push(c);\n  }\n  return out;\n};\n\n// The target is the tar variable (Ricardo: you pick it until auto-targeting,\n// #123). An id is found by id; a word is the first living mob whose name has\n// it as a whole word. Never a player: a word that is a player's name here\n// counts as no target, so the basher can't attack a person.\nB.target = function () {\n  var tv = String(get_variable(\"tar\") || \"\").trim();\n  if (tv !== B.tarSeen) { B.tarSeen = tv; B.tarAt = Date.now(); }\n  var g = B.game;\n  var useGame = !!(g && (g.id || g.name) && (!tv || (g.at || 0) >= (B.tarAt || 0)));\n  var tar = useGame ? String(g.id || g.name) : tv;\n  if (!tar) return { tar: \"\", why: \"no target\" };\n  if (B.players[tar.toLowerCase()]) return { tar: tar, why: tar + \" is a player here: not attacking\" };\n  if (!B.roomKnown) return { tar: tar, why: \"\" };\n  var mob = function (it) { return /m/.test(it.attrib || \"\") && !/d/.test(it.attrib || \"\"); };\n  if (/^\\d+$/.test(tar)) {\n    var it = B.room[tar];\n    if (it && mob(it)) { if (B.run) B.runName = it.name; return { tar: tar, name: it.name, why: \"\" }; }\n    // That one is dead or gone: during a run, the next living mob with the\n    // same name (Ricardo: it goes on until the room runs out of targets).\n    if (B.run && B.runName) {\n      for (var nx in B.room) {\n        if (B.room.hasOwnProperty(nx) && mob(B.room[nx]) && B.room[nx].name === B.runName) return { tar: nx, name: B.runName, why: \"\" };\n      }\n      return { tar: tar, why: \"no more \" + B.runName.replace(/^(a|an|the|some)\\s+/i, \"\") + \" here\" };\n    }\n    return { tar: tar, why: \"target \" + tar + \" isn't here\" };\n  }\n  var re = new RegExp(\"\\\\b\" + tar.toLowerCase().replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\") + \"\\\\b\");\n  for (var id in B.room) {\n    if (B.room.hasOwnProperty(id) && mob(B.room[id]) && re.test(String(B.room[id].name).toLowerCase())) return { tar: tar, name: B.room[id].name, why: \"\" };\n  }\n  return { tar: tar, why: \"no \" + tar + \" here\" };\n};\n\n// Why it can't attack right now (\"\" when it can). Health is checked first,\n// so the hold and the resume are announced even without balance.\nB.blocked = function () {\n  if (!B.hunting()) return \"hunting isn't installed\";\n  if (get_variable(\"pauseTriggers\") == \"on\") return \"paused (pauseTriggers)\";\n  var hu = B.hunting();\n  if (!B.main()) return \"no main attack for \" + (hu.cls || \"this class\") + \" (HUNTING MAIN)\";\n  var min = to_number(get_variable(\"basher_health\")) || 0;\n  var pct = B.maxhp > 0 ? Math.round(B.hp * 100 / B.maxhp) : 100;\n  if (!B.low && pct < min) {\n    B.low = true;\n    display_notice(\"[basher] health \" + pct + \"% is under \" + min + \"%: holding attacks until \" + Math.min(100, min + 10) + \"%.\", \"orange\");\n  } else if (B.low && pct >= Math.min(100, min + 10)) {\n    B.low = false;\n    display_notice(\"[basher] health back to \" + pct + \"%: attacking again.\", \"lime\");\n  }\n  if (B.low) return \"holding for health (\" + pct + \"%)\";\n  var t = B.target();\n  if (t.why) return t.why;\n  if (!B.bal || !B.eq) return \"waiting for balance and equilibrium\";\n  return \"\";\n};\n\n// One look: attack once per recovery. Balance or equilibrium going (onGMCP)\n// clears sentAt; an attack that took neither within retryMs is a miss.\nB.tick = function () {\n  if (!B.on || !B.run) return;\n  // Out of targets: the run ends, still primed.\n  var t = B.target();\n  if (t.why) { B.end(t.why); return; }\n  B.why = B.blocked();\n  if (B.why) return;\n  var now = Date.now();\n  if (B.sentAt && now - B.sentAt < B.retryMs) return;\n  if (B.sentAt) {\n    B.misses++;\n    if (B.misses >= B.maxMisses) {\n      B.stop(\"[basher] OFF: \" + B.misses + \" attacks took no balance or equilibrium. Check your target and HUNTING MAIN, then BASHER ON.\", \"orange\");\n      return;\n    }\n  }\n  var cmds = B.commands(B.target().tar);\n  if (!cmds.length) return;\n  for (var i = 0; i < cmds.length; i++) send_command(cmds[i], 1);\n  B.sentAt = now;\n  if (get_variable(\"debug\") == \"on\") display_notice(\"[debug][basher] \" + cmds.join(\" | \"), \"cyan\");\n};\n\n// The run is over (no more targets here): still primed.\nB.end = function (why) {\n  B.run = false; B.sentAt = 0; B.misses = 0; B.why = \"\";\n  display_notice(\"[basher] \" + why + \": run over, still primed. Attack something to start again.\", \"cyan\");\n};\n\n// Your own attack seen while primed: the run starts. That attack is the one\n// in flight, so the next goes out on the next recovery (balance and\n// equilibrium count as gone until Char.Vitals says otherwise, whichever of\n// the line and the vitals came first).\nB.begin = function () {\n  if (!B.on || B.run) return;\n  B.run = true;\n  B.runName = \"\";\n  B.sentAt = 0; B.misses = 0;\n  B.bal = false; B.eq = false;\n  var m = B.main();\n  display_notice(\"[basher] running: \" + (m ? m.name.toUpperCase() : \"attack\") + \" on \" + (B.target().name || B.target().tar || \"your target\") + \" until the room runs out of them. BASHER STOP stops it.\", \"lime\");\n};\n\n// Your attack lines are hunting's (the class's \"lines\" and the shared ones),\n// read only. True when the line is one of them.\nB.isAttack = function (line) {\n  var hu = B.hunting();\n  var e = hu && hu.classes[hu.cls];\n  var rows = ((e && e.lines) || []).concat(hu ? (hu.sharedLines || []) : []);\n  for (var i = 0; i < rows.length; i++) if (rows[i][0].test(line)) return true;\n  return false;\n};\n\n// BASHER ON: primed, not attacking yet.\nB.start = function () {\n  B.on = true; B.run = false;\n  B.sentAt = 0; B.misses = 0; B.low = false;\n  if (B.loop) clearInterval(B.loop);\n  B.loop = setInterval(function () { client.loom.basher.tick(); }, B.tickMs);\n};\n\n// The kill switch: stops at once; nothing it sent is left queued, since it\n// sends on recovery.\nB.stop = function (msg, colour) {\n  B.on = false; B.run = false;\n  if (B.loop) { clearInterval(B.loop); B.loop = null; }\n  B.sentAt = 0; B.misses = 0; B.low = false; B.why = \"\";\n  if (msg) display_notice(msg, colour || \"lime\");\n};\n\n// A reimport keeps a running basher running, with the new helpers.\nif (B.loop) { clearInterval(B.loop); B.loop = null; }\nif (B.on) B.loop = setInterval(function () { client.loom.basher.tick(); }, B.tickMs);\n"
  },
  {
   "type": "function",
   "name": "basher_status",
   "enabled": true,
   "code": "// basher_status -- bare BASHER: on or off, what it attacks with, and why it\n// isn't attacking right now.\nvar B = client.loom.basher;\nvar bsHu = B.hunting();\nvar bsMain = B.main() ? B.main().name.toUpperCase() : \"\";\nvar bsMin = get_variable(\"basher_health\");\nvar bsPct = B.maxhp > 0 ? Math.round(B.hp * 100 / B.maxhp) + \"%\" : \"unknown\";\nif (!bsHu) {\n  display_notice(\"[basher] OFF: needs the hunting package, which isn't installed. BASHER HELP for commands.\", \"orange\");\n} else if (B.on && B.run) {\n  var bsWhy = B.blocked();\n  display_notice(\"[basher] RUNNING as \" + (bsHu.cls || \"?\") + \": \" + (bsMain || \"no main attack\") + \" on \" + (B.target().tar || \"no target\")\n    + \" — \" + (bsWhy || \"attacking\") + \". Holds below \" + bsMin + \"% health (now \" + bsPct + \"). BASHER STOP to stop.\", \"cyan\");\n} else if (B.on) {\n  display_notice(\"[basher] PRIMED as \" + (bsHu.cls || \"?\") + \": attack something and it carries on with \" + (bsMain || \"no main attack\")\n    + \" until the room runs out of your target. Holds below \" + bsMin + \"% health. BASHER STOP to stand down.\", \"cyan\");\n} else {\n  display_notice(\"[basher] OFF. Attacks your target (tar) with hunting's main attack\" + (bsMain ? \" (\" + bsMain + \" as \" + bsHu.cls + \")\" : \"\")\n    + \" once you attack something, until the room runs out of your target; holds below \" + bsMin + \"% health. BASHER ON to prime it, BASHER HELP for commands.\", \"cyan\");\n}\n"
  },
  {
   "type": "function",
   "name": "basher_help",
   "enabled": true,
   "code": "// basher_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[basher] attended bashing on top of hunting: attacks your target on balance and equilibrium. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"BASHER\", \"status: off, primed or running, and why it isn't attacking\"],\n  [\"BASHER ON\", \"prime it: your next attack starts a run of hunting's main attack on tar\"],\n  [\"BASHER STOP\", \"stop at once and stand down (the kill switch); BASHER OFF does the same\"],\n  [\"BASHER HEALTH [percent]\", \"hold attacks below this health (default 40), resume 10 above\"],\n  [\"It attacks only a living mob in the room (never a player), keeps going while the room has more of your target (one attack per recovery), ends the run when it has none (still primed), and sends nothing while pauseTriggers is on. It always loads OFF and never moves you.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "trigger",
   "name": "basher attack line",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Every line: while primed and not yet running, one of your own attack lines\n// (hunting's patterns, read only) starts the run. While the room's list isn't\n// known (installed mid-room), your kill ends the run instead of the list.\nvar B = client.loom && client.loom.basher;\nif (B && B.on) {\n  var bsLine = String(args[1] || \"\");\n  if (!B.run && B.isAttack(bsLine)) B.begin();\n  else if (B.run && !B.roomKnown && /^You have slain /.test(bsLine)) B.end(\"your target is dead and this room's list isn't known yet\");\n}\n"
    }
   ],
   "text": "^(.*)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// BASHER [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.basher) run_function(\"basher_setup\", [], \"basher\");\nvar B = client.loom.basher;\nvar bsW = String(args[1] || \"\").trim().toLowerCase().split(/\\s+/);\nvar bsSub = bsW[0];\nif (bsSub === \"\" || bsSub === \"status\") {\n  run_function(\"basher_status\", [], \"basher\");\n} else if (bsSub === \"help\") {\n  run_function(\"basher_help\", [], \"basher\");\n} else if (bsSub === \"on\") {\n  var bsHu = B.hunting();\n  if (!bsHu) {\n    display_notice(\"[basher] needs the hunting package: it takes the attack from there. Nothing sent.\", \"orange\");\n  } else if (!B.main()) {\n    display_notice(\"[basher] no main attack for \" + (bsHu.cls || \"this class\") + \" in hunting. HUNTING MAIN lists them; nothing sent.\", \"orange\");\n  } else {\n    B.start();\n    display_notice(\"[basher] primed: attack something to start. It then keeps attacking your target with \" + B.main().name.toUpperCase()\n      + \" on each recovery until the room runs out of it; BASHER STOP stops it.\", \"lime\");\n  }\n} else if (bsSub === \"off\" || bsSub === \"stop\") {\n  var bsWas = B.on;\n  B.stop();\n  display_notice(bsWas ? \"[basher] OFF.\" : \"[basher] already OFF.\", bsWas ? \"lime\" : \"cyan\");\n} else if (bsSub === \"health\") {\n  var bsN = bsW[1];\n  if (bsN === undefined || bsN === \"\") {\n    display_notice(\"[basher] attacks hold below \" + get_variable(\"basher_health\") + \"% health. BASHER HEALTH <0-90> to change it.\", \"cyan\");\n  } else if (/^\\d+$/.test(bsN) && to_number(bsN) <= 90) {\n    set_variable(\"basher_health\", String(to_number(bsN)));\n    B.low = false;\n    display_notice(\"[basher] attacks hold below \" + to_number(bsN) + \"% health and resume at \" + (to_number(bsN) + 10) + \"%.\", \"lime\");\n  } else {\n    display_notice(\"[basher] BASHER HEALTH <0-90>: the health percent attacks hold below.\", \"orange\");\n  }\n} else {\n  display_notice(\"[basher] unknown command '\" + bsW.join(\" \") + \"'. BASHER HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^basher(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  }
 ],
 "description": "Attended autobasher: attacks your target with hunting's main attack"
}