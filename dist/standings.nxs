{
 "type": "group",
 "name": "standings",
 "enabled": true,
 "description": "Standings with adventurers and organisations, kept per character",
 "items": [
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"Standings\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 18 16\"><path d=\"M9 1.5 V14 M5 15 H13 M2 4 H16\" stroke=\"#b8c4d6\" stroke-width=\"1.1\"/><path d=\"M2 4 L0.5 9 H3.5 Z M16 4 L14.5 9 H17.5 Z\" fill=\"none\" stroke=\"#b8c4d6\" stroke-width=\"0.9\"/><path d=\"M0.5 9 Q2 11 3.5 9 Z\" fill=\"#8fd0a0\"/><path d=\"M14.5 9 Q16 11 17.5 9 Z\" fill=\"#e08a78\"/><circle cx=\"9\" cy=\"1.5\" r=\"1.1\" fill=\"#b8c4d6\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\n\nrun_function(\"standings_ensure\", [], \"standings\");\nrun_function(\"standings_render\", [], \"standings\");"
  },
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"standings_ensure\", [], \"standings\");\ndisplay_notice(\"[standings] installed. Create a custom tab named Standings, then STANDINGS HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "standings_ensure",
   "enabled": true,
   "code": "// Builds client.loom.standings: the book (db, view, cal) and the helpers (F)\n// from stored variables, once. Each character keeps its own book, since Nexus stores variables per\n// character. STANDINGS REBUILD drops the helpers so edits to them take effect.\nfunction stLoad(name, def) {\n  var raw;\n  try { raw = get_variable(name); } catch (e) { raw = undefined; }\n  if (raw === undefined || raw === null || raw === \"\") { return def; }\n  if (typeof raw === \"object\") { return raw; }\n  try { return JSON.parse(raw); } catch (e) { return def; }\n}\n\n// Nudge sizes by step (1 = +, 2 = ++, 3 = +++). Logs store the step, not the\n// amount, so these can be retuned later without rewriting any history.\nvar SIZES = [0, 0.5, 1.5, 4];\n// Bands, lowest first: [upper bound, label, colour]. Renaming later is a data edit.\n// Band names (Ricardo, 2026-10-15, once standings showed in more tabs):\n// Nemesis, Hostile, Strained, Neutral, Acquaintance, Friend, Soulmate. Only\n// the names changed; the thresholds and colours are as before, and nothing\n// stores a band name (bands are always worked out from the score).\n// [up to, name, colour, icon]: the icon stands in for the name where room is\n// short (the Online tab, with the name on hover); text symbols, so they take\n// the band's colour (shown with U+FE0E so no font draws them as emoji).\nvar BANDS = [[-6, \"Nemesis\", \"#d9534f\", \"\\u2620\"], [-2.5, \"Hostile\", \"#e07a4f\", \"\\u2694\"], [-0.5, \"Strained\", \"#d8b45a\", \"\\u26a0\"], [0.5, \"Neutral\", \"#9a9aa3\", \"\\u25cb\"], [2.5, \"Acquaintance\", \"#8fc3d8\", \"\\u263a\"], [6, \"Friend\", \"#5a9be0\", \"\\u2665\"], [10.01, \"Soulmate\", \"#7b8ff0\", \"\\u2766\"]];\nvar MONTHS = [\"Sarapin\", \"Daedalan\", \"Aeguary\", \"Miraman\", \"Scarlatan\", \"Ero\", \"Valnuary\", \"Lupar\", \"Phaestian\", \"Chronos\", \"Glacian\", \"Mayan\"];\n\n// Standing from a log: each nudge counts for less the closer the standing\n// already is to the end it pushes toward, so trust is slow to earn and quick\n// to lose. Bounded to -10..+10 by construction. An entry with a fifth field\n// is a \"set\": it places the standing at that value outright (for catching up\n// on history from before the book), and later nudges build on it.\nfunction stScore(log) {\n  var s = 0;\n  for (var i = 0; i < log.length; i++) {\n    var st = log[i][2];\n    if (log[i].length > 4 && typeof log[i][4] === \"number\") { s = Math.max(-10, Math.min(10, log[i][4])); }\n    else if (st > 0) { s += SIZES[st] * (10 - s) / 10; }\n    else if (st < 0) { s -= SIZES[-st] * (10 + s) / 10; }\n  }\n  return Math.round(s * 100) / 100;\n}\nfunction stBand(s) {\n  for (var i = 0; i < BANDS.length; i++) { if (s <= BANDS[i][0]) { return BANDS[i]; } }\n  return BANDS[BANDS.length - 1];\n}\nfunction stKey(name) { return String(name).toLowerCase(); }\nfunction stProper(name) { var n = String(name); return n.charAt(0).toUpperCase() + n.slice(1).toLowerCase(); }\nfunction stSigned(s) { return (s > 0 ? \"+\" : \"\") + (Math.round(s * 10) / 10).toFixed(1); }\nfunction stSteps(st) {\n  if (st === 0) { return \"note\"; }\n  var ch = st > 0 ? \"+\" : \"-\";\n  var out = \"\";\n  for (var i = 0; i < Math.abs(st); i++) { out += ch; }\n  return out;\n}\n\n// IC day number (as the Ledger counts it) for a real time. Read from the\n// Ledger when it is loaded; otherwise extrapolated from the last reading,\n// since one Achaean day is one real hour. 0 means unknown.\nfunction stIc(t) {\n  // Ledger's day, wherever this version of ledger keeps it.\n  var lg = (client.loom && client.loom.ledger && client.loom.ledger.day > 0) ? client.loom.ledger : client.lg;\n  var cal = client.loom.standings.cal;\n  if (lg && lg.day > 0) {\n    if (!cal || cal.d !== lg.day) {\n      client.loom.standings.cal = { d: lg.day, t: Math.floor(new Date().getTime() / 1000) };\n      try { set_variable(\"standings_cal\", JSON.stringify(client.loom.standings.cal)); } catch (e) {}\n    }\n    return lg.day;\n  }\n  if (cal && cal.d > 0) { return cal.d + Math.floor((t - cal.t) / 3600); }\n  return 0;\n}\nfunction stIcTxt(d) {\n  if (!d || d <= 0) { return \"\"; }\n  var n = d - 1;\n  var y = Math.floor(n / 300);\n  var rem = n - y * 300;\n  return ((rem % 25) + 1) + \" \" + MONTHS[Math.floor(rem / 25)] + \" \" + y;\n}\nfunction stRealTxt(t) {\n  var MN = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"];\n  var d = new Date(t * 1000);\n  return d.getDate() + \" \" + MN[d.getMonth()] + \" \" + d.getFullYear();\n}\n// Dealings are nudges, not notes; they weight averages and show acquaintance.\nfunction stDealings(ent) {\n  var n = 0;\n  for (var i = 0; i < ent.log.length; i++) { if (ent.log[i][2] !== 0) { n++; } }\n  return n;\n}\n// People carrying a tag. \"eleusis\" matches both \"eleusis\" and \"city:eleusis\".\nfunction stHasTag(ent, q) {\n  var tags = ent.tags || [];\n  for (var i = 0; i < tags.length; i++) {\n    if (tags[i] === q) { return true; }\n    var c = tags[i].indexOf(\":\");\n    if (c >= 0 && tags[i].slice(c + 1) === q) { return true; }\n  }\n  return false;\n}\n// Weighted average over the people carrying a tag: each person counts by how\n// many dealings they have had, at least one.\nfunction stTagAvg(q) {\n  var db = client.loom.standings.db.e;\n  var sum = 0, w = 0, n = 0;\n  for (var k in db) {\n    if (db.hasOwnProperty(k) && !db[k].org && stHasTag(db[k], q)) {\n      var wt = Math.max(1, stDealings(db[k]));\n      sum += db[k].s * wt;\n      w += wt;\n      n++;\n    }\n  }\n  return { avg: w > 0 ? Math.round(sum / w * 100) / 100 : 0, n: n, w: w };\n}\n// Social package lists, in the social package's own priority order:\n// groups names the lists, lists[group] holds lowercase names as keys, and\n// color[group] is the list's highlight colour (client.loom.social, or the\n// legacy client.hl view of the same lists). Optional:\n// with no social package loaded there are simply no chips.\nfunction stLists(name) {\n  var out = [];\n  var so = client.loom.social;\n  var groups = (so && so.groups) || (client.hl && client.hl.groups);\n  if (!groups || !groups.length) { return out; }\n  var lists = (so && so.lists) || client.hl;\n  var colors = (so && so.color) || (client.hl && client.hl.color) || {};\n  var key = stKey(name);\n  for (var i = 0; i < groups.length; i++) {\n    var g = groups[i];\n    if (lists[g] && lists[g][key]) { out.push([g, colors[g] || \"#9a9aa3\"]); }\n  }\n  return out;\n}\n// Saving is also the moment standings' state changes, so loom's display\n// integrations (#159) hear about it here, guarded: standings works without loom.\nfunction stSave() {\n  try { set_variable(\"standings_db\", JSON.stringify(client.loom.standings.db)); } catch (e) {}\n  if (client.loom.notify) { client.loom.notify(\"standings\"); }\n}\n\nif (!client.loom) { client.loom = {}; }\nif (!client.loom.registry) { client.loom.registry = {}; }\nif (!client.loom.standings) { client.loom.standings = {}; }\nclient.loom.registry.standings = { version: \"0.3.2\", keyword: \"STANDINGS\", desc: \"Standings with adventurers and organisations, kept per character\" };\nvar ST = client.loom.standings;\n\n// One-time migration from the pre-0.2 names: st_db/st_cal become\n// standings_db/standings_cal, and the old session objects are dropped.\nvar stMoves = [[\"st_db\", \"standings_db\"], [\"st_cal\", \"standings_cal\"]];\nfor (var stM = 0; stM < stMoves.length; stM++) {\n  var stOld = get_variable(stMoves[stM][0]);\n  if (stOld === null || stOld === undefined) { continue; }\n  var stNew = get_variable(stMoves[stM][1]);\n  if (stNew === null || stNew === undefined || stNew === \"\") { set_variable(stMoves[stM][1], stOld); }\n  delete_variable(stMoves[stM][0]);\n}\nif (client.st) { client.st = undefined; }\nif (client.stF) { client.stF = undefined; }\n\n// The helpers are rebuilt on every run (they're only functions and tables),\n// so a reimport brings in changed ones at once: kept from the first run, a\n// reimport left the old band names in place until a page reload (#218).\nST.F = { SIZES: SIZES, BANDS: BANDS, MONTHS: MONTHS, score: stScore, band: stBand, key: stKey, proper: stProper, signed: stSigned, steps: stSteps, ic: stIc, icTxt: stIcTxt, realTxt: stRealTxt, dealings: stDealings, hasTag: stHasTag, tagAvg: stTagAvg, lists: stLists, save: stSave };\nif (!ST.db) {\n  var stDb = stLoad(\"standings_db\", null);\n  if (!stDb || typeof stDb !== \"object\" || !stDb.e) { stDb = { e: {}, pending: [] }; }\n  if (!stDb.pending) { stDb.pending = []; }\n  // Stored standings are a cache: recompute them from the logs with the\n  // current rules, so a change to the scoring heals old entries on load.\n  for (var stK in stDb.e) { if (stDb.e.hasOwnProperty(stK)) { stDb.e[stK].s = stScore(stDb.e[stK].log || []); } }\n  ST.db = stDb;\n  ST.view = null;\n  ST.cal = stLoad(\"standings_cal\", null);\n}\n\n// The entry point other packages feed (#36), through loom's integrations:\n// a suggested dealing lands in the review list, tagged with its source, and\n// is never recorded until the player says STANDINGS OK. Defined on every\n// run, so a reimport replaces it.\n//   entry.suggest({ who, step, why, source }) -> true when queued or updated\n//     With a source, one pending item per source and person: a newer\n//     suggestion replaces the older one instead of piling up. Without one\n//     (this package's own triggers), the same who and why within two\n//     minutes queue once.\n//   entry.withdraw(source[, who]) -> how many were taken back; for a source\n//     whose condition cleared or whose link was switched off.\nST.entry = {\n  suggest: function (sg) {\n    if (!sg || !sg.who) { return false; }\n    var F = ST.F;\n    var P = ST.db.pending;\n    var now = Math.floor(new Date().getTime() / 1000);\n    var who = F.proper(sg.who);\n    var why = String(sg.why || \"something happened\");\n    var step = parseInt(sg.step, 10) || 0;\n    var src = sg.source ? String(sg.source) : \"\";\n    for (var i = 0; i < P.length; i++) {\n      if (src && P[i].src === src && P[i].who === who) {\n        P[i].why = why; P[i].step = step; P[i].t = now; P[i].ic = F.ic(now);\n        F.save();\n        run_function(\"standings_render\", [], \"standings\");\n        return true;\n      }\n      if (!src && !P[i].src && P[i].who === who && P[i].why === why && now - P[i].t < 120) { return false; }\n    }\n    var item = { t: now, ic: F.ic(now), who: who, why: why, step: step };\n    if (src) { item.src = src; }\n    P.push(item);\n    while (P.length > 20) { P.shift(); }\n    F.save();\n    display_notice(\"[standings] review: \" + who + \" \\u2014 \" + why + \" (suggested \" + F.steps(step) + (src ? \", from \" + src : \"\") + \"). STANDINGS OK to record, STANDINGS SKIP to dismiss.\", \"cyan\");\n    run_function(\"standings_render\", [], \"standings\");\n    return true;\n  },\n  withdraw: function (source, who) {\n    var P = ST.db.pending;\n    var src = String(source || \"\");\n    if (!src) { return 0; }\n    var wk = who ? ST.F.proper(who) : \"\";\n    var n = 0;\n    for (var i = P.length - 1; i >= 0; i--) {\n      if (P[i].src === src && (!wk || P[i].who === wk)) { P.splice(i, 1); n++; }\n    }\n    if (n) { ST.F.save(); run_function(\"standings_render\", [], \"standings\"); }\n    return n;\n  }\n};\n\n// The read-only look other tabs see through loom's display entry point\n// (#159): what standings knows about a person, never its book.\n//   look.standing(name) -> { band, colour, icon, score, trend, recent } or\n//     undefined when they aren't on the books. trend: the sign of the\n//     nudges in the last ST.recentDays real days (1 up, -1 down, 0 none);\n//     recent: how many dealings in that time.\nST.recentDays = 3;\nST.look = {\n  standing: function (name) {\n    if (!name || !ST.db || !ST.db.e) { return undefined; }\n    var e = ST.db.e[stKey(name)];\n    if (!e || !e.log || !e.log.length) { return undefined; }\n    var b = stBand(e.s);\n    var since = Math.floor(new Date().getTime() / 1000) - ST.recentDays * 86400;\n    var sum = 0, n = 0;\n    for (var i = 0; i < e.log.length; i++) { if (e.log[i][0] >= since) { sum += e.log[i][2] || 0; n++; } }\n    return { band: b[1], colour: b[2], icon: b[3] || \"\", score: e.s, trend: sum > 0 ? 1 : (sum < 0 ? -1 : 0), recent: n };\n  }\n};\n"
  },
  {
   "type": "function",
   "name": "standings_cmd",
   "enabled": true,
   "code": "// STANDINGS <words>. The alias stores the raw text in client.loom.standings.args, since\n// run_function cannot pass parameters. \"@tag\" addresses an organisation.\nrun_function(\"standings_ensure\", [], \"standings\");\nvar F = client.loom.standings.F;\nvar DB = client.loom.standings.db;\nvar raw = String(client.loom.standings.args || \"\").replace(/^\\s+|\\s+$/g, \"\");\nvar W = raw.length ? raw.split(/\\s+/) : [];\nvar now = Math.floor(new Date().getTime() / 1000);\n\nfunction say(t, c) { display_notice(\"[standings] \" + t, c || \"cyan\"); }\nfunction render() { run_function(\"standings_render\", [], \"standings\"); }\nfunction restOf(from) { return W.slice(from).join(\" \"); }\n// Get or create the entity for a name; organisations are keyed with \"@\".\nfunction ent(word, create) {\n  var isOrg = word.charAt(0) === \"@\";\n  var k = isOrg ? \"@\" + word.slice(1).toLowerCase() : F.key(word);\n  if (!DB.e[k] && create) { DB.e[k] = { name: isOrg ? k : F.proper(word), org: isOrg, tags: [], log: [], s: 0 }; }\n  return DB.e[k] || null;\n}\nfunction kOf(e) { return e.org ? e.name : F.key(e.name); }\nfunction record(e, step, note) {\n  var ic = F.ic(now);\n  e.log.push([now, ic, step, note || \"\"]);\n  var before = e.s;\n  e.s = F.score(e.log);\n  F.save();\n  var b = F.band(e.s);\n  if (step === 0) { say(\"noted for \" + e.name + (ic ? \" (\" + F.icTxt(ic) + \")\" : \"\") + \": \" + (note || \"\"), \"lime\"); }\n  else { say(e.name + \" \" + F.steps(step) + \": \" + F.signed(before) + \" → \" + F.signed(e.s) + \" (\" + b[1] + \")\" + (note ? \" — \" + note : \"\"), b[2]); }\n  client.loom.standings.view = { k: kOf(e) };\n  render();\n}\n\nif (W.length === 0 || W[0].toLowerCase() === \"home\") {\n  client.loom.standings.view = null;\n  render();\n  say(\"overview shown in the Standings tab.\");\n}\nelse if (W[0].toLowerCase() === \"help\") {\n  run_function(\"standings_help\", [], \"standings\");\n}\nelse if (W[0].toLowerCase() === \"list\") {\n  var nl = Math.max(1, Math.min(100, parseInt(W[1], 10) || 15));\n  var all = [];\n  for (var k in DB.e) { if (DB.e.hasOwnProperty(k) && !DB.e[k].org) { all.push(DB.e[k]); } }\n  var i, j, tmp;\n  for (i = 1; i < all.length; i++) { tmp = all[i]; j = i - 1; while (j >= 0 && all[j].s < tmp.s) { all[j + 1] = all[j]; j--; } all[j + 1] = tmp; }\n  say(all.length + \" adventurer(s) on the books, highest first:\");\n  for (i = 0; i < all.length && i < nl; i++) { var bb = F.band(all[i].s); display_notice(\"  \" + F.signed(all[i].s) + \"  \" + all[i].name + \"  (\" + bb[1] + \", \" + F.dealings(all[i]) + (F.dealings(all[i]) === 1 ? \" dealing)\" : \" dealings)\"), bb[2]); }\n}\nelse if (W[0].toLowerCase() === \"tags\") {\n  var seen = {};\n  for (var k2 in DB.e) {\n    if (DB.e.hasOwnProperty(k2) && !DB.e[k2].org) {\n      var tg = DB.e[k2].tags || [];\n      for (var t2 = 0; t2 < tg.length; t2++) { seen[tg[t2]] = 1; }\n    }\n  }\n  var names = [];\n  for (var s2 in seen) { if (seen.hasOwnProperty(s2)) { names.push(s2); } }\n  names.sort();\n  if (names.length === 0) { say(\"no tags yet. STANDINGS <name> TAG city:eleusis\"); }\n  for (var t3 = 0; t3 < names.length; t3++) {\n    var av = F.tagAvg(names[t3]);\n    display_notice(\"  \" + names[t3] + \": \" + F.signed(av.avg) + \" (\" + F.band(av.avg)[1] + \") over \" + av.n + \" people, \" + av.w + \" dealings\", F.band(av.avg)[2]);\n  }\n}\nelse if (W[0].toLowerCase() === \"review\" || W[0].toLowerCase() === \"pending\") {\n  var P = DB.pending;\n  if (P.length === 0) { say(\"nothing waiting for review.\"); }\n  for (var p = 0; p < P.length; p++) { say((p === 0 ? \"next: \" : \"then: \") + P[p].who + \" — \" + P[p].why + \" (suggested \" + F.steps(P[p].step) + (P[p].src ? \", from \" + P[p].src : \"\") + \")\"); }\n  if (P.length > 0) { say(\"STANDINGS OK to record the first as suggested, STANDINGS OK ++ to choose the size, STANDINGS SKIP to dismiss it.\"); }\n}\nelse if (W[0].toLowerCase() === \"ok\") {\n  var P1 = DB.pending;\n  if (P1.length === 0) { say(\"nothing waiting for review.\"); }\n  else {\n    var sg = P1.shift();\n    var stepO = sg.step;\n    var noteO = sg.why;\n    if (W[1] && /^[+-]{1,3}$/.test(W[1])) { stepO = W[1].length * (W[1].charAt(0) === \"+\" ? 1 : -1); if (W.length > 2) { noteO = restOf(2); } }\n    else if (W.length > 1) { noteO = restOf(1); }\n    record(ent(sg.who, true), stepO, noteO);\n  }\n}\nelse if (W[0].toLowerCase() === \"skip\") {\n  if (DB.pending.length === 0) { say(\"nothing waiting for review.\"); }\n  else { var sk = DB.pending.shift(); F.save(); say(\"dismissed: \" + sk.who + \" — \" + sk.why + \".\" + (DB.pending.length ? \" \" + DB.pending.length + \" more waiting.\" : \"\"), \"lime\"); render(); }\n}\nelse if (W[0].toLowerCase() === \"rebuild\") {\n  client.loom.standings.F = undefined;\n  run_function(\"standings_ensure\", [], \"standings\");\n  F = client.loom.standings.F;\n  // Recompute every standing with the fresh rules.\n  for (var kr in DB.e) { if (DB.e.hasOwnProperty(kr)) { DB.e[kr].s = F.score(DB.e[kr].log || []); } }\n  F.save();\n  say(\"helpers rebuilt and every standing recomputed.\", \"lime\");\n  render();\n}\nelse if (W[0].toLowerCase() === \"debug\") {\n  var cnt = 0, orgs = 0;\n  for (var k3 in DB.e) { if (DB.e.hasOwnProperty(k3)) { if (DB.e[k3].org) { orgs++; } else { cnt++; } } }\n  say(cnt + \" people, \" + orgs + \" organisations, \" + DB.pending.length + \" pending; standings_db is \" + JSON.stringify(DB).length + \" chars.\");\n  say(\"IC day now: \" + F.ic(now) + \" (\" + (F.icTxt(F.ic(now)) || \"unknown\") + \"); Ledger \" + ((client.loom.ledger || client.lg) ? \"loaded\" : \"not loaded\") + \"; social lists \" + ((client.loom.social || client.hl) ? \"found\" : \"not found\") + \".\");\n}\nelse {\n  var who = W[0];\n  var verb = (W[1] || \"\").toLowerCase();\n  if (/^[+-]{1,3}$/.test(W[1] || \"\")) {\n    record(ent(who, true), W[1].length * (W[1].charAt(0) === \"+\" ? 1 : -1), restOf(2));\n  }\n  else if (verb === \"set\") {\n    // Catching up: place the standing at a value outright. It is logged like\n    // any other entry, so UNDO takes it back and the record shows it.\n    var sv = parseFloat(W[2]);\n    if (isNaN(sv) || sv < -10 || sv > 10) { say(\"usage: STANDINGS <name> SET <-10 to 10> [note], e.g. STANDINGS Oceana SET 5 known her for years\", \"orange\"); }\n    else {\n      var es = ent(who, true);\n      var before = es.s;\n      var ics = F.ic(now);\n      es.log.push([now, ics, 0, restOf(3), Math.round(sv * 100) / 100]);\n      es.s = F.score(es.log);\n      F.save();\n      var bs = F.band(es.s);\n      say(es.name + \" set: \" + F.signed(before) + \" → \" + F.signed(es.s) + \" (\" + bs[1] + \")\" + (restOf(3) ? \" — \" + restOf(3) : \"\"), bs[2]);\n      client.loom.standings.view = { k: kOf(es) };\n      render();\n    }\n  }\n  else if (verb === \"note\") {\n    if (W.length < 3) { say(\"usage: STANDINGS <name> NOTE <text>\", \"orange\"); }\n    else { record(ent(who, true), 0, restOf(2)); }\n  }\n  else if (verb === \"undo\") {\n    var eu = ent(who, false);\n    if (!eu || eu.log.length === 0) { say(\"nothing to undo for \" + who + \".\", \"orange\"); }\n    else {\n      var gone = eu.log.pop();\n      eu.s = F.score(eu.log);\n      F.save();\n      say(\"removed \" + (gone.length > 4 ? \"set \" + F.signed(gone[4]) : F.steps(gone[2])) + (gone[3] ? \" (\" + gone[3] + \")\" : \"\") + \" from \" + eu.name + \"; now \" + F.signed(eu.s) + \".\", \"lime\");\n      client.loom.standings.view = { k: kOf(eu) };\n      render();\n    }\n  }\n  else if (verb === \"tag\" || verb === \"untag\") {\n    if (W.length < 3) { say(\"usage: STANDINGS <name> \" + verb.toUpperCase() + \" <tag> [more tags]\", \"orange\"); }\n    else {\n      var et = ent(who, verb === \"tag\");\n      if (!et) { say(who + \" is not on the books.\", \"orange\"); }\n      else {\n        if (!et.tags) { et.tags = []; }\n        for (var a = 2; a < W.length; a++) {\n          var tag = W[a].toLowerCase();\n          var at = -1;\n          for (var b = 0; b < et.tags.length; b++) { if (et.tags[b] === tag) { at = b; } }\n          if (verb === \"tag\" && at < 0) { et.tags.push(tag); }\n          if (verb === \"untag\" && at >= 0) { et.tags.splice(at, 1); }\n        }\n        F.save();\n        say(et.name + \" tags: \" + (et.tags.length ? et.tags.join(\", \") : \"none\") + \".\", \"lime\");\n        client.loom.standings.view = { k: kOf(et) };\n        render();\n      }\n    }\n  }\n  else if (verb === \"forget\") {\n    var ef = ent(who, false);\n    if (!ef) { say(who + \" is not on the books.\", \"orange\"); }\n    else if ((W[2] || \"\").toLowerCase() !== \"confirm\") { say(\"this erases \" + ef.name + \"'s whole history. STANDINGS \" + who.toUpperCase() + \" FORGET CONFIRM to proceed.\", \"orange\"); }\n    else { delete DB.e[kOf(ef)]; F.save(); client.loom.standings.view = null; say(ef.name + \" has been struck from the books.\", \"orange\"); render(); }\n  }\n  else if (verb === \"\") {\n    var ev = ent(who, false);\n    if (!ev && who.charAt(0) !== \"@\") { say(who + \" is not on the books yet; they stand at Neutral. A first nudge or note will add them.\"); }\n    else {\n      var kv = ev ? kOf(ev) : \"@\" + who.slice(1).toLowerCase();\n      client.loom.standings.view = { k: kv };\n      render();\n      if (ev && !ev.org) { var bv = F.band(ev.s); say(ev.name + \": \" + F.signed(ev.s) + \" (\" + bv[1] + \"), \" + F.dealings(ev) + (F.dealings(ev) === 1 ? \" dealing\" : \" dealings\") + \". Details in the Standings tab.\", bv[2]); }\n      else { var tv = F.tagAvg(kv.slice(1)); say(kv + \": members average \" + F.signed(tv.avg) + \" over \" + tv.n + \" people\" + (ev ? \", direct standing \" + F.signed(ev.s) : \"\") + \". Details in the Standings tab.\"); }\n    }\n  }\n  else { say(\"did not understand '\" + W[1] + \"'. STANDINGS HELP lists the forms.\", \"orange\"); }\n}"
  },
  {
   "type": "function",
   "name": "standings_render",
   "enabled": true,
   "code": "// Draws the Standings tab in the house style shared with Coffers, Level,\n// Ledger and the rest: ink panel, serif small-caps headings, one large\n// figure, monospace ledger rows. The accent is a cool steel; the bands carry\n// their own colours, red through grey to blue, as in EVE.\nrun_function(\"standings_ensure\", [], \"standings\");\nvar F = client.loom.standings.F;\nvar DB = client.loom.standings.db;\nvar view = client.loom.standings.view;\nvar STEEL = \"#b8c4d6\";\nvar DEEP = \"#5a6478\";\nvar TXT = \"#e2e5ea\";\nvar MUTED = \"#868c97\";\nvar RULE = \"#262b33\";\nvar KIND = \"#8fd0a0\";\nvar UNKIND = \"#e08a78\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nvar now = Math.floor(new Date().getTime() / 1000);\n\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\nfunction n1(v) { return Math.round(v * 10) / 10; }\nfunction caps(t, c) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (c || STEEL) + ';font-size:11px;margin:0 0 3px;\">' + t + '</div>'; }\nfunction row(label, value, c) {\n  return '<div style=\"display:flex;justify-content:space-between;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"color:' + MUTED + ';white-space:nowrap;\">' + label + '</span><span style=\"color:' + (c || TXT) + ';white-space:nowrap;\">' + value + '</span></div>';\n}\nfunction box(inner) { return '<div style=\"flex:1 1 150px;min-width:150px;border-top:2px solid ' + DEEP + ';padding:3px 2px 0;\">' + inner + '</div>'; }\nfunction section(title, inner) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title) + inner + '</div>'; }\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">' + t + '</div>'; }\nfunction chip(t, c, filled) {\n  return '<span style=\"display:inline-block;margin:0 4px 3px 0;padding:0 5px;border:1px solid ' + c + ';' + (filled ? 'background:' + c + ';color:#101216;' : 'color:' + c + ';') + 'white-space:nowrap;\">' + esc(t) + '</span>';\n}\nfunction when(e) { return e[1] > 0 ? F.icTxt(e[1]) : F.realTxt(e[0]); }\nfunction stepTxt(st) {\n  if (st === 0) { return '<span style=\"color:' + MUTED + ';\">note</span>'; }\n  return '<span style=\"color:' + (st > 0 ? KIND : UNKIND) + ';letter-spacing:0.05em;\">' + F.steps(st) + '</span>';\n}\nfunction standing(s, size) {\n  var b = F.band(s);\n  return '<span style=\"font-family:' + SERIF + ';font-size:' + size + 'px;color:' + b[2] + ';\">' + F.signed(s) + '</span>';\n}\nfunction byStanding(a, b) { return b.s - a.s; }\n\n// The scale from -10 to +10: each band a faded segment, the standing a tick.\nfunction scale(s) {\n  var out = '<div style=\"position:relative;display:flex;height:8px;margin:3px 0 1px;\">';\n  var lo = -10;\n  for (var i = 0; i < F.BANDS.length; i++) {\n    var hi = Math.min(10, F.BANDS[i][0]);\n    out += '<div title=\"' + F.BANDS[i][1] + '\" style=\"flex:' + n1(hi - lo) + ' 1 0;background:' + F.BANDS[i][2] + ';opacity:0.35;margin-right:1px;\"></div>';\n    lo = hi;\n  }\n  var pct = (s + 10) / 20 * 100;\n  out += '<div style=\"position:absolute;top:-3px;left:calc(' + n1(pct) + '% - 1.5px);width:3px;height:14px;background:#ffffff;\"></div></div>';\n  out += '<div style=\"display:flex;justify-content:space-between;color:' + MUTED + ';\"><span>-10</span><span>neutral</span><span>+10</span></div>';\n  return out;\n}\n// Standing after each dealing, as a step line across the -10..+10 frame.\nfunction history(log, W, H) {\n  var fs = 8;\n  var x0 = 22, x1 = W - 6, y0 = 4, y1 = H - 4;\n  var pts = [0];\n  var sub = [];\n  for (var i = 0; i < log.length; i++) { sub.push(log[i]); pts.push(F.score(sub)); }\n  function sy(v) { return y1 - ((v + 10) / 20) * (y1 - y0); }\n  function sx(i2) { return x0 + (pts.length > 1 ? i2 / (pts.length - 1) : 0) * (x1 - x0); }\n  var svg = '<svg viewBox=\"0 0 ' + W + ' ' + H + '\" width=\"100%\" style=\"display:block;height:auto;\" xmlns=\"http://www.w3.org/2000/svg\">';\n  var lo = -10;\n  for (var b = 0; b < F.BANDS.length; b++) {\n    var hi = Math.min(10, F.BANDS[b][0]);\n    svg += '<rect x=\"' + x0 + '\" y=\"' + n1(sy(hi)) + '\" width=\"' + (x1 - x0) + '\" height=\"' + n1(sy(lo) - sy(hi)) + '\" fill=\"' + F.BANDS[b][2] + '\" fill-opacity=\"0.08\"/>';\n    lo = hi;\n  }\n  svg += '<line x1=\"' + x0 + '\" y1=\"' + n1(sy(0)) + '\" x2=\"' + x1 + '\" y2=\"' + n1(sy(0)) + '\" stroke=\"' + DEEP + '\" stroke-width=\"0.8\"/>';\n  var labs = [10, 0, -10];\n  for (var l = 0; l < labs.length; l++) { svg += '<text x=\"' + (x0 - 3) + '\" y=\"' + n1(sy(labs[l]) + 3) + '\" text-anchor=\"end\" font-family=\"' + MONO + '\" font-size=\"' + fs + '\" fill=\"' + MUTED + '\">' + (labs[l] > 0 ? \"+\" : \"\") + labs[l] + '</text>'; }\n  var d = \"M\" + n1(sx(0)) + \",\" + n1(sy(0));\n  for (var p = 1; p < pts.length; p++) { d += \"H\" + n1(sx(p)) + \"V\" + n1(sy(pts[p])); }\n  svg += '<path d=\"' + d + '\" fill=\"none\" stroke=\"' + STEEL + '\" stroke-width=\"1.4\"/>';\n  for (var q = 1; q < pts.length; q++) {\n    var st = log[q - 1][2];\n    if (log[q - 1].length > 4) { svg += '<circle cx=\"' + n1(sx(q)) + '\" cy=\"' + n1(sy(pts[q])) + '\" r=\"2.2\" fill=\"none\" stroke=\"' + STEEL + '\" stroke-width=\"1\"/>'; }\n    else if (st !== 0) { svg += '<circle cx=\"' + n1(sx(q)) + '\" cy=\"' + n1(sy(pts[q])) + '\" r=\"2\" fill=\"' + (st > 0 ? KIND : UNKIND) + '\"/>'; }\n  }\n  return svg + '</svg>';\n}\n// One dealing as a ledger line: when, the nudge, the note, the standing after.\nfunction isSet(e) { return e.length > 4 && typeof e[4] === \"number\"; }\nfunction dealing(e, after, who) {\n  var mark = isSet(e) ? '<span style=\"color:' + STEEL + ';\">set</span>' : stepTxt(e[2]);\n  if (isSet(e) && after === null) { after = e[4]; }\n  return '<div style=\"display:flex;gap:6px;align-items:baseline;border-bottom:1px dotted ' + RULE + ';padding:2px 0;\">' +\n    '<span style=\"color:' + MUTED + ';min-width:8.5em;white-space:nowrap;\">' + when(e) + '</span>' +\n    (who ? '<span style=\"color:' + TXT + ';min-width:5.5em;font-family:' + SERIF + ';font-size:11px;\">' + esc(who) + '</span>' : '') +\n    '<span style=\"min-width:2.4em;\">' + mark + '</span>' +\n    '<span style=\"flex:1 1 auto;min-width:0;color:' + TXT + ';\">' + esc(e[3] || \"\") + '</span>' +\n    (after !== null ? '<span style=\"white-space:nowrap;color:' + F.band(after)[2] + ';\">' + F.signed(after) + '</span>' : '') + '</div>';\n}\nfunction personRow(e) {\n  var b = F.band(e.s);\n  return '<div style=\"display:flex;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\">' +\n    '<span style=\"flex:1 1 auto;font-family:' + SERIF + ';font-size:11px;color:' + TXT + ';\">' + esc(e.name) + '</span>' +\n    '<span style=\"color:' + b[2] + ';min-width:6.5em;text-align:right;\">' + b[1] + '</span>' +\n    '<span style=\"color:' + b[2] + ';min-width:3.5em;text-align:right;\">' + F.signed(e.s) + '</span>' +\n    '<span style=\"color:' + MUTED + ';min-width:5.5em;text-align:right;\">' + F.dealings(e) + ' dealt</span></div>';\n}\nfunction pendingRows(filterKey) {\n  var out = \"\";\n  for (var i = 0; i < DB.pending.length; i++) {\n    var p = DB.pending[i];\n    if (filterKey && F.key(p.who) !== filterKey) { continue; }\n    out += '<div style=\"display:flex;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"color:' + MUTED + ';min-width:8.5em;\">' + (p.ic > 0 ? F.icTxt(p.ic) : F.realTxt(p.t)) + '</span>' +\n      (filterKey ? '' : '<span style=\"font-family:' + SERIF + ';font-size:11px;min-width:5.5em;\">' + esc(p.who) + '</span>') +\n      '<span style=\"flex:1 1 auto;\">' + esc(p.why) + (p.src ? ' <span style=\"color:' + MUTED + ';\">\\u00b7 ' + esc(p.src) + '</span>' : '') + '</span><span>' + stepTxt(p.step) + '?</span></div>';\n  }\n  if (out) { out += '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;margin-top:2px;\">STANDINGS OK records the first as suggested, STANDINGS SKIP dismisses it.</div>'; }\n  return out;\n}\n\n// A balance, the standings tab's counterpart of the coin stack.\nvar glyph = '<svg width=\"18\" height=\"16\" viewBox=\"0 0 18 16\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<path d=\"M9 1.5 V14 M5 15 H13 M2 4 H16\" stroke=\"' + STEEL + '\" stroke-width=\"1.1\"/>' +\n  '<path d=\"M2 4 L0.5 9 H3.5 Z M16 4 L14.5 9 H17.5 Z\" fill=\"none\" stroke=\"' + STEEL + '\" stroke-width=\"0.9\"/>' +\n  '<path d=\"M0.5 9 Q2 11 3.5 9 Z\" fill=\"' + KIND + '\"/><path d=\"M14.5 9 Q16 11 17.5 9 Z\" fill=\"' + UNKIND + '\"/><circle cx=\"9\" cy=\"1.5\" r=\"1.1\" fill=\"' + STEEL + '\"/></svg>';\n\nvar people = [];\nvar orgsN = 0;\nfor (var k in DB.e) { if (DB.e.hasOwnProperty(k)) { if (DB.e[k].org) { orgsN++; } else { people.push(DB.e[k]); } } }\n\nvar html = '<div style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:#101216;border:1px solid ' + RULE + ';padding:7px 8px 8px;\">';\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\nhtml += '<div style=\"font-family:' + SERIF + ';color:' + STEEL + ';font-size:14px;letter-spacing:0.22em;\">' + glyph + 'STANDINGS</div>';\nhtml += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + MUTED + ';font-size:11px;\">' + people.length + ' on the books' + (DB.pending.length ? ' &middot; <span style=\"color:' + STEEL + ';\">' + DB.pending.length + ' to review</span>' : '') + '</div></div>';\n\nvar vk = view && view.k ? view.k : null;\nvar E = vk ? DB.e[vk] : null;\n\nif (vk && vk.charAt(0) !== \"@\" && E) {\n  // ------------------------------------------------------------ a person ---\n  var b = F.band(E.s);\n  html += '<div style=\"margin:6px 0 0;font-family:' + SERIF + ';font-size:17px;color:' + TXT + ';\">' + esc(E.name) + '</div>';\n  html += '<div style=\"margin:0 0 2px;\">' + standing(E.s, 26) + ' <span style=\"font-family:' + SERIF + ';font-style:italic;color:' + b[2] + ';font-size:13px;\">' + b[1] + '</span></div>';\n  html += scale(E.s);\n  var lists = F.lists(E.name);\n  var chips = \"\";\n  for (var li = 0; li < lists.length; li++) { chips += chip(lists[li][0], lists[li][1], true); }\n  for (var ti = 0; ti < (E.tags || []).length; ti++) { chips += chip(E.tags[ti], STEEL, false); }\n  if (chips) { html += '<div style=\"margin-top:6px;\">' + chips + '</div>'; }\n\n  var kindN = 0, unkindN = 0, notesN = 0;\n  var setsN = 0;\n  for (var i = 0; i < E.log.length; i++) { if (isSet(E.log[i])) { setsN++; } else if (E.log[i][2] > 0) { kindN++; } else if (E.log[i][2] < 0) { unkindN++; } else { notesN++; } }\n  var cols = '<div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-top:6px;\">';\n  var db1 = caps(\"Dealings\");\n  db1 += row(\"kindnesses\", String(kindN), kindN ? KIND : MUTED);\n  db1 += row(\"slights\", String(unkindN), unkindN ? UNKIND : MUTED);\n  db1 += row(\"notes\", String(notesN));\n  if (setsN) { db1 += row(\"set by hand\", String(setsN), STEEL); }\n  cols += box(db1);\n  var db2 = caps(\"Acquaintance\");\n  if (E.log.length > 0) {\n    db2 += row(\"first\", when(E.log[0]));\n    db2 += row(\"latest\", when(E.log[E.log.length - 1]));\n    var lastT = E.log[E.log.length - 1][0];\n    var ago = Math.floor((now - lastT) / 86400);\n    db2 += row(\"real time since\", ago < 1 ? \"today\" : ago + \"d\");\n  } else { db2 += quiet(\"Never dealt with.\"); }\n  cols += box(db2);\n  html += cols + '</div>';\n\n  var pr = pendingRows(F.key(E.name));\n  if (pr) { html += section(\"Awaiting review\", pr); }\n  if (E.log.length > 1) { html += section(\"Over time\", history(E.log, 640, 90)); }\n\n  var dl = \"\";\n  var sub = [];\n  var afters = [];\n  for (var a = 0; a < E.log.length; a++) { sub.push(E.log[a]); afters.push(F.score(sub)); }\n  for (var c = E.log.length - 1; c >= 0 && c >= E.log.length - 25; c--) { dl += dealing(E.log[c], E.log[c][2] !== 0 ? afters[c] : null, null); }\n  html += section(\"The record\" + (E.log.length > 25 ? \", latest 25 of \" + E.log.length : \"\"), dl || quiet(\"Nothing recorded yet.\"));\n}\nelse if (vk && vk.charAt(0) === \"@\") {\n  // ------------------------------------------------------ an organisation ---\n  var tag = vk.slice(1);\n  var av = F.tagAvg(tag);\n  var ab = F.band(av.avg);\n  html += '<div style=\"margin:6px 0 0;font-family:' + SERIF + ';font-size:17px;color:' + TXT + ';\">' + esc(tag) + ' <span style=\"font-size:12px;font-style:italic;color:' + MUTED + ';\">organisation</span></div>';\n  html += '<div style=\"margin:0 0 2px;\">' + standing(av.avg, 26) + ' <span style=\"font-family:' + SERIF + ';font-style:italic;color:' + ab[2] + ';font-size:13px;\">' + ab[1] + '</span> <span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">members&rsquo; average, ' + av.n + ' ' + (av.n === 1 ? 'person' : 'people') + ', weighted by ' + av.w + ' dealings</span></div>';\n  html += scale(av.avg);\n  if (E) {\n    var eb = F.band(E.s);\n    html += '<div style=\"margin-top:5px;color:' + MUTED + ';\">standing with ' + esc(tag) + ' itself: ' + standing(E.s, 14) + ' <span style=\"color:' + eb[2] + ';font-family:' + SERIF + ';font-style:italic;\">' + eb[1] + '</span></div>';\n  }\n  var mem = [];\n  for (var m = 0; m < people.length; m++) { if (F.hasTag(people[m], tag)) { mem.push(people[m]); } }\n  mem.sort(byStanding);\n  var mr = \"\";\n  for (var m2 = 0; m2 < mem.length; m2++) { mr += personRow(mem[m2]); }\n  html += section(\"Members\", mr || quiet(\"No one carries this tag yet. STANDINGS &lt;name&gt; TAG \" + esc(tag)));\n  if (E && E.log.length) {\n    var ol = \"\";\n    var osub = [];\n    var oaft = [];\n    for (var oa = 0; oa < E.log.length; oa++) { osub.push(E.log[oa]); oaft.push(F.score(osub)); }\n    for (var oc = E.log.length - 1; oc >= 0 && oc >= E.log.length - 15; oc--) { ol += dealing(E.log[oc], E.log[oc][2] !== 0 ? oaft[oc] : null, null); }\n    html += section(\"Dealings with \" + esc(tag) + \" itself\", ol);\n  }\n}\nelse {\n  // ------------------------------------------------------------ overview ---\n  html += '<div style=\"margin:6px 0 2px;\"><span style=\"font-family:' + SERIF + ';font-size:26px;color:' + STEEL + ';\">' + people.length + '</span> <span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">' + (people.length === 1 ? 'adventurer' : 'adventurers') + ' on the books' + (orgsN ? ', ' + orgsN + ' organisation' + (orgsN === 1 ? '' : 's') : '') + '</span></div>';\n  if (vk && !E) { html += '<div style=\"color:' + MUTED + ';\">' + esc(vk) + ' is not on the books.</div>'; }\n  // Suggestions waiting (from triggers or other packages, #36), even before\n  // anyone is on the books: a suggestion may be someone's first dealing.\n  var pa = pendingRows(null);\n  if (pa) { html += section(\"Awaiting review\", pa); }\n  if (people.length === 0) {\n    if (!pa) { html += quiet(\"No one yet. Everyone starts Neutral; STANDINGS &lt;name&gt; ++ shared tea in the grove adds the first entry.\"); }\n  } else {\n    // Recent dealings across everyone.\n    var rec = [];\n    for (var r = 0; r < people.length; r++) { for (var rl = 0; rl < people[r].log.length; rl++) { rec.push([people[r].log[rl], people[r].name]); } }\n    var rr, rj, rt;\n    for (rr = 1; rr < rec.length; rr++) { rt = rec[rr]; rj = rr - 1; while (rj >= 0 && rec[rj][0][0] < rt[0][0]) { rec[rj + 1] = rec[rj]; rj--; } rec[rj + 1] = rt; }\n    var rd = \"\";\n    for (rr = 0; rr < rec.length && rr < 10; rr++) { rd += dealing(rec[rr][0], null, rec[rr][1]); }\n    html += section(\"Recent dealings\", rd);\n    people.sort(byStanding);\n    var hiR = \"\", loR = \"\";\n    for (var h = 0; h < people.length && h < 5; h++) { if (people[h].s > 0.5) { hiR += personRow(people[h]); } }\n    for (var lw = people.length - 1; lw >= 0 && lw >= people.length - 5; lw--) { if (people[lw].s < -0.5) { loR += personRow(people[lw]); } }\n    if (hiR) { html += section(\"Held in highest regard\", hiR); }\n    if (loR) { html += section(\"Held in lowest regard\", loR); }\n    // Tag averages.\n    var seen = {};\n    var tl = [];\n    for (var s2 = 0; s2 < people.length; s2++) { var tg = people[s2].tags || []; for (var t2 = 0; t2 < tg.length; t2++) { if (!seen[tg[t2]]) { seen[tg[t2]] = 1; tl.push(tg[t2]); } } }\n    tl.sort();\n    var tr = \"\";\n    for (var t3 = 0; t3 < tl.length; t3++) {\n      var ta = F.tagAvg(tl[t3]);\n      var tb = F.band(ta.avg);\n      tr += '<div style=\"display:flex;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"flex:1 1 auto;color:' + STEEL + ';\">' + esc(tl[t3]) + '</span><span style=\"color:' + tb[2] + ';min-width:6.5em;text-align:right;\">' + tb[1] + '</span><span style=\"color:' + tb[2] + ';min-width:3.5em;text-align:right;\">' + F.signed(ta.avg) + '</span><span style=\"color:' + MUTED + ';min-width:5.5em;text-align:right;\">' + ta.n + ' people</span></div>';\n    }\n    if (tr) { html += section(\"By tag\", tr); }\n  }\n}\nhtml += '<div style=\"color:' + MUTED + ';margin-top:6px;font-family:' + SERIF + ';font-style:italic;\">STANDINGS HELP lists the commands. STANDINGS alone returns here.</div>';\nhtml += '</div>';\ntry { set_custom_tab_html(\"Standings\", html); } catch (e) {}"
  },
  {
   "type": "function",
   "name": "standings_suggest",
   "enabled": true,
   "code": "// For triggers: set client.loom.standings.sug = { who: \"Name\", step: -3, why: \"tried to\n// steal from you\" } and run this. It queues the dealing for review instead of\n// recording it, since a standing is a judgement call; STANDINGS OK records it.\n// The queueing itself is the entry point other packages use too (#36):\n// client.loom.standings.entry.suggest, in standings_ensure.\nrun_function(\"standings_ensure\", [], \"standings\");\nvar sg = client.loom.standings.sug;\nclient.loom.standings.sug = null;\nif (sg && sg.who) { client.loom.standings.entry.suggest(sg); }\n"
  },
  {
   "type": "function",
   "name": "standings_help",
   "enabled": true,
   "code": "// standings_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[standings] standings with adventurers and organisations, kept per character. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"STANDINGS\", \"overview in the Standings tab\"],\n  [\"STANDINGS <name>\", \"show them in the tab\"],\n  [\"STANDINGS @<tag>\", \"an organisation (everyone tagged with it)\"],\n  [\"STANDINGS <name> + | ++ | +++\", \"nudge up, small to large [note]\"],\n  [\"STANDINGS <name> - | -- | ---\", \"nudge down, small to large [note]\"],\n  [\"STANDINGS <name> SET <-10..10> [note]\", \"place a standing outright, to catch up on the past\"],\n  [\"STANDINGS <name> NOTE <text>\", \"a note without a nudge\"],\n  [\"STANDINGS <name> UNDO\", \"remove the last entry\"],\n  [\"STANDINGS <name> TAG <t> [t2..]\", \"tags: plain or typed (city:eleusis, house:sentaari, order:gaia)\"],\n  [\"STANDINGS <name> UNTAG <t>\", \"remove a tag\"],\n  [\"STANDINGS <name> FORGET CONFIRM\", \"erase their whole history\"],\n  [\"STANDINGS LIST [n]\", \"people on the books, highest first (15 unless n)\"],\n  [\"STANDINGS TAGS\", \"tags in use, with their averages\"],\n  [\"STANDINGS REVIEW\", \"suggested dealings waiting for you\"],\n  [\"STANDINGS OK [nudge] [note]\", \"record the first suggestion (optionally another size)\"],\n  [\"STANDINGS SKIP\", \"dismiss it\"],\n  [\"STANDINGS DEBUG / REBUILD\", \"counts and links / reload the rules and recompute\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "Standings",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "client.loom.standings.args = args[1] || \"\";\nrun_function(\"standings_cmd\", [], \"standings\");"
    }
   ],
   "text": "^standings(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  }
 ]
}