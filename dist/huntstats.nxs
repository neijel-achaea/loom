{
 "type": "group",
 "name": "huntstats",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"huntstats_setup\", [], \"huntstats\");\nrun_function(\"huntstats_render\", [], \"huntstats\");\ndisplay_notice(\"[huntstats] installed. Create a UI tab named 'Stats' for the panel. HUNTSTATS HELP for commands.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; the huntstats_* variables are left intact.\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"Stats\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 18 17\"><path d=\"M2 15 L12 5\" stroke=\"#e4e6da\" stroke-width=\"1.2\"/><path d=\"M10 2 L16 2 L16 8 Z\" fill=\"#a9c46c\"/><path d=\"M2 15 L1 12 M2 15 L5 16 M3.6 13.4 L2.4 10.6 M3.6 13.4 L6.4 14.6\" stroke=\"#56693a\" stroke-width=\"1\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\nrun_function(\"huntstats_setup\", [], \"huntstats\");\nrun_function(\"huntstats_render\", [], \"huntstats\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Everything huntstats knows about where you are and how far along you are\n// comes from GMCP: Room.Info for the area, Room.Players for who hunted with\n// you, Char.Status and Char.Vitals for the level and percent to next.\nvar hsM = \"\";\nvar hsA = null;\ntry { hsM = args.gmcp_method; hsA = args.gmcp_args; } catch (e) { hsM = \"\"; }\nif (typeof hsA === \"string\") { try { hsA = JSON.parse(hsA); } catch (e) { hsA = null; } }\nif (!client.loom || !client.loom.huntstats || !client.loom.huntstats.xpTable) run_function(\"huntstats_setup\", [], \"huntstats\");\nvar HS = client.loom.huntstats;\n\n// --- resume or bank an interrupted hunt (once per connection) ---\n// client.* is wiped on a refresh or reconnect, so HS.resumed is unset again\n// and the huntstats_open checkpoint (a saved variable) is recovered here.\nif (!HS.resumed) {\n  HS.resumed = true;\n  var hsSaved = \"\";\n  try { hsSaved = get_variable(\"huntstats_open\"); } catch (e) { hsSaved = \"\"; }\n  if (hsSaved) {\n    var hsB = null;\n    try { hsB = JSON.parse(hsSaved); } catch (e) { hsB = null; }\n    if (hsB && hsB.area !== undefined && hsB.firstXpAt && hsB.xp > 0) {\n      var hsIdle = Date.now() - (hsB.lastXpAt || hsB.firstXpAt);\n      HS.cur = hsB;\n      if (hsIdle < 600000) {\n        display_notice(\"[huntstats] resumed hunt in \" + hsB.area + \" (\" + hsB.xp.toLocaleString() + \" xp so far)\", \"cyan\");\n      } else {\n        run_function(\"huntstats_finalize\", [], \"huntstats\");\n        display_notice(\"[huntstats] filed interrupted hunt in \" + hsB.area, \"cyan\");\n      }\n    } else {\n      try { set_variable(\"huntstats_open\", \"\"); } catch (e) {}\n    }\n  }\n}\n\nif (hsM === \"Char.Status\" && hsA && hsA.level !== undefined) {\n  var hsS = String(hsA.level).match(/(\\d+)(?:\\s*\\(([\\d.]+)%\\))?/);\n  if (hsS) {\n    HS.level = parseInt(hsS[1], 10);\n    if (hsS[2] !== undefined) HS.nl = parseFloat(hsS[2]);\n  }\n}\n\nif (hsM === \"Char.Vitals\" && hsA) {\n  var hsP = null;\n  if (hsA.charstats) {\n    for (var hsI = 0; hsI < hsA.charstats.length; hsI++) {\n      var hsC = String(hsA.charstats[hsI]).match(/Level:\\s*(\\d+)\\s*\\(([\\d.]+)%\\)/);\n      if (hsC) { hsP = hsC; break; }\n    }\n  }\n  if (hsP) {\n    HS.level = parseInt(hsP[1], 10);\n    HS.nl = parseFloat(hsP[2]);\n  } else if (hsA.nl !== undefined) {\n    // Whole percent only: keep a precise figure already held for it.\n    var hsN = parseFloat(hsA.nl);\n    if (!isNaN(hsN) && (HS.nl === undefined || Math.floor(HS.nl) !== hsN)) HS.nl = hsN;\n  }\n}\n\nif (hsM === \"Room.Info\" && hsA && hsA.area) {\n  if (!HS.cur || HS.cur.area === undefined) {\n    HS.fresh();\n    HS.cur.area = hsA.area;\n  } else if (hsA.area !== HS.cur.area) {\n    run_function(\"huntstats_finalize\", [], \"huntstats\");\n    HS.cur.area = hsA.area;\n  }\n}\n\nif (hsM === \"Room.Players\" && hsA && hsA.length && HS.cur) {\n  if (!HS.cur.players) HS.cur.players = {};\n  for (var hsJ = 0; hsJ < hsA.length; hsJ++) {\n    if (hsA[hsJ] && hsA[hsJ].name) HS.cur.players[hsA[hsJ].name] = 1;\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "huntstats_setup",
   "enabled": true,
   "code": "// huntstats_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, one-time migration of the\n// hs_* variables and the old loose client keys, the Dragonhood table, helpers\n// and settings, each built if missing.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.huntstats) client.loom.huntstats = {};\nclient.loom.registry.huntstats = { version: \"0.2.0\", keyword: \"HUNTSTATS\" };\nvar HS = client.loom.huntstats;\n\n// One-time migration: hs_* -> huntstats_*. A new variable that already holds\n// data wins; the old one is deleted either way.\nvar hsMoves = [[\"areas\", \"{}\"], [\"log\", \"[]\"], [\"open\", \"\"]];\nfor (var hsI = 0; hsI < hsMoves.length; hsI++) {\n  var hsOld;\n  try { hsOld = get_variable(\"hs_\" + hsMoves[hsI][0]); } catch (e) { hsOld = undefined; }\n  if (hsOld !== undefined && hsOld !== null) {\n    var hsNew;\n    try { hsNew = get_variable(\"huntstats_\" + hsMoves[hsI][0]); } catch (e) { hsNew = undefined; }\n    if (hsNew === undefined || hsNew === null || hsNew === \"\" || hsNew === hsMoves[hsI][1]) set_variable(\"huntstats_\" + hsMoves[hsI][0], hsOld);\n    delete_variable(\"hs_\" + hsMoves[hsI][0]);\n  }\n}\n// Fresh profile: the stores start empty (never clobbered on a reimport).\nvar hsHave;\ntry { hsHave = get_variable(\"huntstats_log\"); } catch (e) { hsHave = undefined; }\nif (hsHave === undefined || hsHave === null || hsHave === \"\") set_variable(\"huntstats_log\", \"[]\");\ntry { hsHave = get_variable(\"huntstats_areas\"); } catch (e) { hsHave = undefined; }\nif (hsHave === undefined || hsHave === null || hsHave === \"\") set_variable(\"huntstats_areas\", \"{}\");\n\n// The old package kept its state in loose client keys. A session still in\n// memory on a reimport without a page reload carries over; it has already\n// been resumed, so the checkpoint isn't recovered a second time.\nif (client.track && !HS.cur) { HS.cur = client.track; HS.resumed = true; }\nif (client.hsResumed) HS.resumed = true;\nvar hsOldKeys = [\"track\", \"dragonXP\", \"hsResumed\", \"hsLastSave\", \"_dragonBtnLabel\"];\nfor (var hsJ = 0; hsJ < hsOldKeys.length; hsJ++) {\n  if (client[hsOldKeys[hsJ]] !== undefined) delete client[hsOldKeys[hsJ]];\n}\n\n// Total experience at the start of each level, 1-99. Dragonhood is the share\n// of the experience to level 99 already earned.\nif (!HS.xpTable) {\n  HS.xpTable = {\n    1:0, 2:5000, 3:10500, 4:20550, 5:35205, 6:50525, 7:70577, 8:95043, 9:122000,\n    10:152000, 11:185000, 12:225000, 13:267000, 14:312000, 15:359000, 16:407000,\n    17:456000, 18:506000, 19:561000, 20:621000, 21:691000, 22:761000, 23:836000,\n    24:916000, 25:1001000, 26:1091000, 27:1186000, 28:1286000, 29:1391000,\n    30:1501000, 31:1616000, 32:1736000, 33:1861000, 34:1986000, 35:2116000,\n    36:2251000, 37:2391000, 38:2536000, 39:2686000, 40:2941000, 41:3096000,\n    42:3256000, 43:3416000, 44:3581000, 45:3746000, 46:3916000, 47:4150000,\n    48:4353395, 49:4794382, 50:5279468, 51:5813062, 52:6400016, 53:7045665,\n    54:7755879, 55:8537115, 56:9396474, 57:10341769, 58:11381594, 59:12525401,\n    60:13783589, 61:15167596, 62:16690004, 63:18364653, 64:20206766, 65:22233091,\n    66:24462048, 67:26913901, 68:29610939, 69:32576939, 70:35840356, 71:39430114,\n    72:43378848, 73:47722456, 74:52500425, 75:60000000, 76:70000000, 77:83000000,\n    78:100000000, 79:120000000, 80:150000000, 81:185000000, 82:225000000,\n    83:270000000, 84:320000000, 85:375000000, 86:435000000, 87:500000000,\n    88:570000000, 89:645000000, 90:725000000, 91:810000000, 92:900000000,\n    93:995000000, 94:1095000000, 95:1200000000, 96:1310000000, 97:1425000000,\n    98:1545000000, 99:1670000000\n  };\n}\n\n// Helpers, rebuilt on every setup so a reimport picks up new code.\n// dragon(): Dragonhood % from the current level reading, or null.\nHS.dragon = function () {\n  var t = HS.xpTable;\n  if (HS.level === undefined || HS.nl === undefined) return null;\n  var l = Math.floor(HS.level);\n  if (l >= 99) return 100;\n  if (t[l] === undefined || t[l + 1] === undefined) return null;\n  return ((t[l] + (HS.nl / 100) * (t[l + 1] - t[l])) / t[99]) * 100;\n};\n// xpToNext(): experience left to the next level, or null.\nHS.xpToNext = function () {\n  var t = HS.xpTable;\n  if (HS.level === undefined || HS.nl === undefined) return null;\n  var l = Math.floor(HS.level);\n  if (l >= 99 || t[l] === undefined || t[l + 1] === undefined) return null;\n  return (100 - HS.nl) / 100 * (t[l + 1] - t[l]);\n};\n// xpToDragon(): experience left to level 99, or null.\nHS.xpToDragon = function () {\n  var t = HS.xpTable;\n  if (HS.level === undefined || HS.nl === undefined) return null;\n  var l = Math.floor(HS.level);\n  if (l >= 99) return 0;\n  if (t[l] === undefined || t[l + 1] === undefined) return null;\n  return t[99] - (t[l] + (HS.nl / 100) * (t[l + 1] - t[l]));\n};\nHS.dur = function (ms) { var m = Math.floor(ms / 60000); return Math.floor(m / 60) + \"h \" + (m % 60) + \"m\"; };\n// fresh(): empty accumulators for a new hunt, keeping the area.\nHS.fresh = function () {\n  if (!HS.cur) HS.cur = {};\n  HS.cur.xp = 0; HS.cur.gold = 0; HS.cur.kills = 0;\n  HS.cur.firstXpAt = 0; HS.cur.lastXpAt = 0;\n  HS.cur.startDragonPct = null; HS.cur.players = {};\n};\n// save(): checkpoint the open hunt so a refresh, crash or disconnect can\n// recover it. Throttled to once every five seconds unless forced.\nHS.save = function (force) {\n  var now = Date.now();\n  if (!force && HS.lastSave && (now - HS.lastSave) <= 5000) return;\n  HS.lastSave = now;\n  try { set_variable(\"huntstats_open\", JSON.stringify(HS.cur)); } catch (e) {}\n};\n\n// The Dragonhood F-key setting existed briefly before release; drop it.\ntry { if (get_variable(\"huntstats_button\") !== undefined && get_variable(\"huntstats_button\") !== null) delete_variable(\"huntstats_button\"); } catch (e) {}\n"
  },
  {
   "type": "function",
   "name": "huntstats_finalize",
   "enabled": true,
   "code": "// huntstats_finalize -- close the current hunt. It is filed only when it\n// earned experience over a minute or more; either way the accumulators are\n// cleared (the area and level reading stay) and the checkpoint is dropped.\n// Called on leaving an area, by HUNTSTATS FLUSH, and by loom's QUIT wrapper.\nif (!client.loom || !client.loom.huntstats || !client.loom.huntstats.xpTable) run_function(\"huntstats_setup\", [], \"huntstats\");\nvar HS = client.loom.huntstats;\nvar T = HS.cur;\n\nif (T && T.firstXpAt && T.xp > 0 && (T.lastXpAt - T.firstXpAt) >= 60000) {\n  var ms = T.lastXpAt - T.firstXpAt;\n  var hrs = ms / 3600000;\n  var xpHr = Math.round(T.xp / hrs);\n  var goldHr = Math.round(T.gold / hrs);\n\n  var ep = HS.dragon();\n  var dGain = (ep !== null && T.startDragonPct !== null && T.startDragonPct !== undefined) ? (ep - T.startDragonPct) : null;\n\n  var players = [];\n  for (var k in T.players) { if (T.players.hasOwnProperty(k)) players.push(k); }\n\n  var rec = { area: T.area, xp: T.xp, gold: T.gold, kills: T.kills || 0, ms: ms,\n              xpHr: xpHr, goldHr: goldHr, dGain: dGain, players: players, at: Date.now() };\n\n  var log = [];\n  try { log = JSON.parse(get_variable(\"huntstats_log\")) || []; } catch (e) { log = []; }\n  log.unshift(rec);\n  if (log.length > 5) log = log.slice(0, 5);\n  set_variable(\"huntstats_log\", JSON.stringify(log));\n\n  var areas = {};\n  try { areas = JSON.parse(get_variable(\"huntstats_areas\")) || {}; } catch (e) { areas = {}; }\n  var a = areas[rec.area] || { xp: 0, gold: 0, kills: 0, ms: 0, sessions: 0 };\n  a.xp += rec.xp; a.gold += rec.gold; a.kills += rec.kills; a.ms += rec.ms; a.sessions += 1;\n  areas[rec.area] = a;\n  set_variable(\"huntstats_areas\", JSON.stringify(areas));\n\n  var extra = (dGain !== null) ? (\", \" + (dGain < 0 ? \"\" : \"+\") + dGain.toFixed(3) + \"% dragon\") : \"\";\n  display_notice(\"[huntstats] \" + rec.area + \": \" + rec.xp.toLocaleString() + \" xp (\" + xpHr.toLocaleString() + \"/hr), \" + rec.gold.toLocaleString() + \" gold, \" + rec.kills + \" kills, \" + HS.dur(ms) + extra, \"cyan\");\n  run_function(\"huntstats_render\", [], \"huntstats\");\n}\n\nHS.fresh();\nHS.lastSave = 0;\ntry { set_variable(\"huntstats_open\", \"\"); } catch (e) {}\n"
  },
  {
   "type": "function",
   "name": "huntstats_render",
   "enabled": true,
   "code": "// huntstats_render -- rebuild the 'Stats' custom tab from the persistent log + area aggregates,\n// in the house style shared with Coffers, Level, Ledger, Fishing, DmgChart and\n// Talismans: ink panel, serif small-caps headings, one large figure, monospace\n// ledger rows. The accent is a hunter's moss green.\nvar log = [];\ntry { log = JSON.parse(get_variable(\"huntstats_log\")) || []; } catch (e) { log = []; }\nvar areas = {};\ntry { areas = JSON.parse(get_variable(\"huntstats_areas\")) || {}; } catch (e) { areas = {}; }\n\nvar MOSS = \"#a9c46c\";\nvar DEEP = \"#56693a\";\nvar GOLD = \"#e2bd5a\";\nvar DRAGON = \"#b99be0\";\nvar TXT = \"#e4e6da\";\nvar MUTED = \"#878c7a\";\nvar RULE = \"#272d1f\";\nvar TRACK = \"#1a1f14\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\n\nfunction fmtDur(ms) { var m = Math.floor(ms / 60000); return m < 60 ? m + \"m\" : Math.floor(m / 60) + \"h \" + (m % 60) + \"m\"; }\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\nfunction thou(n) { var neg = n < 0; var s = String(Math.round(Math.abs(n))); var o = \"\"; while (s.length > 3) { o = \",\" + s.slice(-3) + o; s = s.slice(0, -3); } return (neg ? \"-\" : \"\") + s + o; }\nfunction ago(t) {\n  var s = Math.floor((Date.now() - t) / 1000);\n  if (s < 3600) { return Math.max(1, Math.round(s / 60)) + \"m ago\"; }\n  if (s < 86400) { return Math.round(s / 3600) + \"h ago\"; }\n  return Math.round(s / 86400) + \"d ago\";\n}\nfunction caps(t, c) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (c || DEEP) + ';font-size:11px;margin:0 0 3px;\">' + t + '</div>'; }\nfunction row(label, value, c) {\n  return '<div style=\"display:flex;justify-content:space-between;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"color:' + MUTED + ';white-space:nowrap;\">' + label + '</span><span style=\"color:' + (c || TXT) + ';white-space:nowrap;\">' + value + '</span></div>';\n}\nfunction box(inner, c) { return '<div style=\"flex:1 1 150px;min-width:150px;border-top:2px solid ' + (c || DEEP) + ';padding:3px 2px 0;\">' + inner + '</div>'; }\nfunction section(title, inner) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title, MOSS) + inner + '</div>'; }\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">' + t + '</div>'; }\nfunction byTime(x, y) { return y.ms - x.ms; }\n\n// Dragonhood, when the level is known this connection.\nvar dh = null;\ntry { dh = client.loom.huntstats.dragon(); } catch (e) { dh = null; }\n\n// An arrowhead over a sprig, the hunting tab's counterpart of the coin stack.\nvar glyph = '<svg width=\"18\" height=\"17\" viewBox=\"0 0 18 17\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<path d=\"M2 15 L12 5\" stroke=\"' + TXT + '\" stroke-width=\"1.2\"/><path d=\"M10 2 L16 2 L16 8 Z\" fill=\"' + MOSS + '\"/>' +\n  '<path d=\"M2 15 L1 12 M2 15 L5 16 M3.6 13.4 L2.4 10.6 M3.6 13.4 L6.4 14.6\" stroke=\"' + DEEP + '\" stroke-width=\"1\"/></svg>';\n\nvar arr = [];\nvar lt = { xp: 0, gold: 0, kills: 0, ms: 0, sessions: 0 };\nfor (var k in areas) {\n  if (areas.hasOwnProperty(k)) {\n    var a = areas[k];\n    var hrs = a.ms / 3600000;\n    arr.push({ area: k, xpHr: hrs > 0 ? Math.round(a.xp / hrs) : 0, goldHr: hrs > 0 ? Math.round(a.gold / hrs) : 0, sessions: a.sessions, ms: a.ms });\n    lt.xp += a.xp || 0; lt.gold += a.gold || 0; lt.kills += a.kills || 0; lt.ms += a.ms || 0; lt.sessions += a.sessions || 0;\n  }\n}\narr.sort(byTime);\n\nvar html = '<div style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:#11130d;border:1px solid ' + RULE + ';padding:7px 8px 8px;\">';\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\nhtml += '<div style=\"font-family:' + SERIF + ';color:' + MOSS + ';font-size:14px;letter-spacing:0.22em;\">' + glyph + 'HUNTING</div>';\nhtml += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + MUTED + ';font-size:11px;\">' + (dh !== null ? 'dragonhood <span style=\"color:' + DRAGON + ';\">' + dh.toFixed(2) + '%</span>' : arr.length + ' area' + (arr.length === 1 ? '' : 's')) + '</div></div>';\n\nif (log.length === 0) {\n  html += '<div style=\"margin-top:8px;\">' + quiet(\"No hunts logged yet. A hunt is filed when you leave the area, or with HUNTSTATS FLUSH; it needs a minute or more of experience to count.\") + '</div>';\n} else {\n  // The headline is the most recent hunt's experience rate.\n  var L = log[0];\n  html += '<div style=\"margin:6px 0 1px;\"><span style=\"font-family:' + SERIF + ';font-size:26px;color:' + MOSS + ';\">' + thou(L.xpHr) + '</span> ';\n  html += '<span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">xp/hour, last hunt</span></div>';\n  html += '<div style=\"color:' + MUTED + ';\">in <span style=\"font-family:' + SERIF + ';color:' + TXT + ';\">' + esc(L.area) + '</span>' + (L.at ? ' &middot; ' + ago(L.at) : '') + '</div>';\n\n  var cols = '<div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;\">';\n  var lb = caps(\"Last hunt\", MOSS);\n  lb += row(\"time\", fmtDur(L.ms));\n  lb += row(\"experience\", thou(L.xp));\n  lb += row(\"gold\", thou(L.gold) + ' <span style=\"color:' + MUTED + ';\">(' + thou(L.goldHr) + '/hr)</span>', GOLD);\n  lb += row(\"kills\", String(L.kills) + (L.ms > 0 ? ' <span style=\"color:' + MUTED + ';\">(' + Math.round(L.kills / (L.ms / 3600000)) + '/hr)</span>' : ''));\n  if (L.dGain !== null && L.dGain !== undefined) { lb += row(\"dragonhood\", '+' + L.dGain.toFixed(3) + '%', DRAGON); }\n  cols += box(lb, MOSS);\n  var hb = caps(\"Lifetime\", MOSS);\n  var lh = lt.ms / 3600000;\n  hb += row(\"time hunted\", fmtDur(lt.ms));\n  hb += row(\"hunts\", String(lt.sessions));\n  hb += row(\"xp / hr\", lh > 0 ? thou(lt.xp / lh) : \"&mdash;\", MOSS);\n  hb += row(\"gold / hr\", lh > 0 ? thou(lt.gold / lh) : \"&mdash;\", GOLD);\n  hb += row(\"kills\", thou(lt.kills));\n  cols += box(hb, DEEP);\n  html += cols + '</div>';\n\n  // Recent hunts, newest first, each as a two-line ledger entry.\n  var rs = \"\";\n  for (var i = 0; i < log.length; i++) {\n    var s = log[i];\n    rs += '<div style=\"border-bottom:1px dotted ' + RULE + ';padding:2px 0 3px;\">';\n    rs += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:6px;\"><span style=\"font-family:' + SERIF + ';color:' + TXT + ';font-size:11px;\">' + esc(s.area) + '</span>';\n    rs += '<span style=\"color:' + MUTED + ';white-space:nowrap;\">' + fmtDur(s.ms) + (s.at ? ' &middot; ' + ago(s.at) : '') + '</span></div>';\n    rs += '<div style=\"color:' + MUTED + ';\"><span style=\"color:' + MOSS + ';\">' + thou(s.xpHr) + '</span> xp/hr &middot; <span style=\"color:' + GOLD + ';\">' + thou(s.gold) + '</span> gold &middot; ' + s.kills + ' kills';\n    if (s.dGain !== null && s.dGain !== undefined) { rs += ' &middot; <span style=\"color:' + DRAGON + ';\">+' + s.dGain.toFixed(3) + '%</span>'; }\n    rs += '</div>';\n    if (s.players && s.players.length) { rs += '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">with ' + esc(s.players.join(\", \")) + '</div>'; }\n    rs += '</div>';\n  }\n  html += section(\"Recent hunts\", rs);\n}\n\n// Areas, by total time; each bar is its xp/hr against the best area.\nvar ar = \"\";\nif (arr.length === 0) {\n  ar = quiet(\"No area history yet.\");\n} else {\n  var best = 0;\n  for (var j = 0; j < arr.length; j++) { if (arr[j].xpHr > best) { best = arr[j].xpHr; } }\n  for (var j2 = 0; j2 < arr.length; j2++) {\n    var r = arr[j2];\n    var top = (r.xpHr === best && arr.length > 1);\n    var pct = best > 0 ? Math.round(r.xpHr / best * 100) : 0;\n    ar += '<div style=\"margin:0 0 5px;\">';\n    ar += '<div style=\"display:flex;justify-content:space-between;gap:6px;\"><span style=\"color:' + TXT + ';\">' + esc(r.area) + (top ? ' <span style=\"color:' + MOSS + ';\" title=\"best xp/hr\">&#9733;</span>' : '') + '</span>';\n    ar += '<span style=\"color:' + MOSS + ';white-space:nowrap;\">' + thou(r.xpHr) + ' <span style=\"color:' + MUTED + ';\">xp/hr</span></span></div>';\n    ar += '<div style=\"background:' + TRACK + ';height:5px;margin:2px 0 1px;\"><div style=\"background:' + (top ? MOSS : DEEP) + ';height:5px;width:' + pct + '%;\"></div></div>';\n    ar += '<div style=\"color:' + MUTED + ';\"><span style=\"color:' + GOLD + ';\">' + thou(r.goldHr) + '</span> gold/hr &middot; ' + r.sessions + ' hunt' + (r.sessions === 1 ? '' : 's') + ' &middot; ' + fmtDur(r.ms) + '</div>';\n    ar += '</div>';\n  }\n}\nhtml += section(\"Areas, by time spent\", ar);\nhtml += '</div>';\n\ntry { set_custom_tab_html(\"Stats\", html); } catch (e) {}"
  },
  {
   "type": "function",
   "name": "huntstats_status",
   "enabled": true,
   "code": "// huntstats_status -- the bare HUNTSTATS view: the hunt under way, with\n// rates, time to the next level and Dragonhood.\nvar HS = client.loom.huntstats;\nvar T = HS.cur;\nfunction say(t, c) { display_notice(\"[huntstats] \" + t, c || \"white\"); }\n\nif (!T || T.area === undefined) {\n  say(\"waiting for room data...\", \"yellow\");\n} else if (!T.firstXpAt) {\n  say(T.area + \" - no kills yet this hunt\", \"yellow\");\n} else {\n  var ms = Date.now() - T.firstXpAt;\n  var hrs = ms / 3600000;\n  var xpHr = hrs > 0 ? Math.round(T.xp / hrs) : 0;\n  var goldHr = hrs > 0 ? Math.round(T.gold / hrs) : 0;\n  say(T.area + \" - \" + HS.dur(ms));\n  say(\"xp:    \" + T.xp.toLocaleString() + \"  (\" + xpHr.toLocaleString() + \"/hr)\");\n  say(\"gold:  \" + T.gold.toLocaleString() + \"  (\" + goldHr.toLocaleString() + \"/hr)\");\n  say(\"kills: \" + (T.kills || 0));\n\n  var toNext = HS.xpToNext();\n  if (toNext !== null && xpHr > 0) {\n    var mNext = Math.round(toNext / xpHr * 60);\n    say(\"level \" + (Math.floor(HS.level) + 1) + \" in ~\" + Math.floor(mNext / 60) + \"h \" + (mNext % 60) + \"m\");\n  }\n  var dh = HS.dragon();\n  if (dh !== null && dh < 100) {\n    var gained = (T.startDragonPct !== null && T.startDragonPct !== undefined) ? \"  (\" + ((dh - T.startDragonPct) < 0 ? \"\" : \"+\") + (dh - T.startDragonPct).toFixed(3) + \"% this hunt)\" : \"\";\n    say(\"Dragonhood: \" + dh.toFixed(2) + \"%\" + gained);\n    var toDragon = HS.xpToDragon();\n    if (toDragon !== null && xpHr > 0) {\n      var mDragon = Math.round(toDragon / xpHr * 60);\n      say(\"Dragonhood ETA: ~\" + Math.floor(mDragon / 60) + \"h \" + (mDragon % 60) + \"m\");\n    }\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "huntstats_help",
   "enabled": true,
   "code": "// huntstats_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[huntstats] per-area hunting records: xp, gold and kills an hour, Dragonhood. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"HUNTSTATS\", \"the hunt under way: rates, next level, Dragonhood\"],\n  [\"HUNTSTATS AREAS\", \"every area hunted, by total time, with its rates\"],\n  [\"HUNTSTATS LOG\", \"the last five hunts\"],\n  [\"HUNTSTATS FLUSH\", \"file the hunt under way now\"],\n  [\"HUNTSTATS WIPE CONFIRM\", \"clear all area records and the log\"],\n  [\"HUNTSTATS DEBUG\", \"internal state\"],\n  [\"A hunt is filed when you leave its area, and needs a minute or more of experience.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// HUNTSTATS [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.huntstats || !client.loom.huntstats.xpTable) run_function(\"huntstats_setup\", [], \"huntstats\");\nvar HS = client.loom.huntstats;\nvar hsW = String(args[1] || \"\").trim().toLowerCase().split(/\\s+/);\nvar hsSub = hsW[0];\nvar hsP1 = hsW[1] || \"\";\nfunction hsSay(t, col) { display_notice(\"[huntstats] \" + t, col || \"cyan\"); }\n\nif (hsSub === \"\" || hsSub === \"status\") {\n  run_function(\"huntstats_status\", [], \"huntstats\");\n} else if (hsSub === \"help\") {\n  run_function(\"huntstats_help\", [], \"huntstats\");\n} else if (hsSub === \"areas\") {\n  var areas = {};\n  try { areas = JSON.parse(get_variable(\"huntstats_areas\")) || {}; } catch (e) { areas = {}; }\n  var arr = [];\n  for (var k in areas) {\n    if (areas.hasOwnProperty(k)) {\n      var a = areas[k]; var hrs = a.ms / 3600000;\n      arr.push({ area: k, xpHr: hrs > 0 ? Math.round(a.xp / hrs) : 0, goldHr: hrs > 0 ? Math.round(a.gold / hrs) : 0, sessions: a.sessions, ms: a.ms });\n    }\n  }\n  if (arr.length === 0) { hsSay(\"no area history yet\", \"yellow\"); }\n  else {\n    arr.sort(function (x, y) { return y.ms - x.ms; });\n    hsSay(\"areas by total time (lifetime):\", \"white\");\n    for (var j = 0; j < arr.length; j++) {\n      var r = arr[j];\n      display_notice(\"  \" + r.area + \" - \" + r.xpHr.toLocaleString() + \" xp/hr, \" + r.goldHr.toLocaleString() + \" gold/hr (\" + r.sessions + \" hunt\" + (r.sessions === 1 ? \"\" : \"s\") + \", \" + HS.dur(r.ms) + \")\");\n    }\n  }\n} else if (hsSub === \"log\") {\n  var log = [];\n  try { log = JSON.parse(get_variable(\"huntstats_log\")) || []; } catch (e) { log = []; }\n  if (log.length === 0) { hsSay(\"no hunts logged yet\", \"yellow\"); }\n  else {\n    hsSay(\"last \" + log.length + \" hunt\" + (log.length === 1 ? \"\" : \"s\") + \":\", \"white\");\n    for (var i = 0; i < log.length; i++) {\n      var s = log[i];\n      var pl = (s.players && s.players.length) ? (\"  party: \" + s.players.join(\", \")) : \"\";\n      var dg = (s.dGain !== null && s.dGain !== undefined) ? (\"  \" + (s.dGain < 0 ? \"\" : \"+\") + s.dGain.toFixed(3) + \"% dragon\") : \"\";\n      display_notice(\"  \" + s.area + \" - \" + HS.dur(s.ms) + \", \" + s.xp.toLocaleString() + \" xp (\" + s.xpHr.toLocaleString() + \"/hr), \" + s.gold.toLocaleString() + \" gold, \" + s.kills + \" kills\" + dg + pl);\n    }\n  }\n} else if (hsSub === \"flush\") {\n  var hsHad = HS.cur && HS.cur.firstXpAt && HS.cur.xp > 0;\n  var hsLong = hsHad && (HS.cur.lastXpAt - HS.cur.firstXpAt) >= 60000;\n  run_function(\"huntstats_finalize\", [], \"huntstats\");\n  if (hsLong) hsSay(\"hunt filed\", \"green\");\n  else if (hsHad) hsSay(\"under a minute of experience, so nothing was filed; counters reset.\", \"yellow\");\n  else hsSay(\"no hunt under way.\", \"yellow\");\n} else if (hsSub === \"wipe\") {\n  if (hsP1 === \"confirm\") {\n    set_variable(\"huntstats_areas\", \"{}\");\n    set_variable(\"huntstats_log\", \"[]\");\n    run_function(\"huntstats_render\", [], \"huntstats\");\n    hsSay(\"all area records and the log wiped\", \"red\");\n  } else {\n    hsSay(\"this clears ALL area records and the hunt log. HUNTSTATS WIPE CONFIRM to proceed.\", \"yellow\");\n  }\n} else if (hsSub === \"debug\") {\n  var T = HS.cur || {};\n  hsSay(\"level=\" + HS.level + \" nl=\" + HS.nl + \" dragon=\" + (HS.dragon() === null ? \"?\" : HS.dragon().toFixed(3)) + \" resumed=\" + !!HS.resumed);\n  hsSay(\"area=\" + T.area + \" xp=\" + T.xp + \" gold=\" + T.gold + \" kills=\" + T.kills + \" firstXpAt=\" + T.firstXpAt + \" lastXpAt=\" + T.lastXpAt + \" players=\" + Object.keys(T.players || {}).join(\",\"));\n} else {\n  hsSay(\"unknown command '\" + hsSub + \"'. HUNTSTATS HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^huntstats(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"You have gained <n> experience.\" -- the hunt starts with the first one.\nvar HS = client.loom && client.loom.huntstats;\nif (HS && HS.cur && HS.cur.area !== undefined) {\n  var hsG = parseInt(args[1], 10);\n  if (!isNaN(hsG)) {\n    if (!HS.cur.firstXpAt) {\n      HS.cur.firstXpAt = Date.now();\n      HS.cur.startDragonPct = HS.dragon();\n    }\n    HS.cur.xp += hsG;\n    HS.cur.lastXpAt = Date.now();\n    HS.save(false);\n  }\n}\n"
    }
   ],
   "text": "^You have gained (\\d+) experience\\.",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"You pick up <n> gold sovereigns.\"\nvar HS = client.loom && client.loom.huntstats;\nif (HS && HS.cur && HS.cur.area !== undefined) {\n  var hsG = parseInt(String(args[1]).replace(/,/g, \"\"), 10);\n  if (!isNaN(hsG)) HS.cur.gold += hsG;\n}\n"
    }
   ],
   "text": "^You pick up ([\\d,]+) gold sovereigns\\.",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"You have slain ...\"\nvar HS = client.loom && client.loom.huntstats;\nif (HS && HS.cur && HS.cur.area !== undefined) {\n  HS.cur.kills = (HS.cur.kills || 0) + 1;\n  HS.cur.lastXpAt = Date.now();\n}\n"
    }
   ],
   "text": "^You have slain ",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"Level: <n> (<p>%)\" in game output, such as SCORE: the precise figure,\n// between the whole-percent GMCP updates.\nif (!client.loom || !client.loom.huntstats || !client.loom.huntstats.xpTable) run_function(\"huntstats_setup\", [], \"huntstats\");\nvar HS = client.loom.huntstats;\nvar hsL = parseInt(args[1], 10);\nvar hsP = parseFloat(args[2]);\nif (!isNaN(hsL)) HS.level = hsL;\nif (!isNaN(hsP)) HS.nl = hsP;\n"
    }
   ],
   "text": "Level\\s*:\\s*(\\d+)\\s*\\(([\\d.]+)%\\)",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  }
 ],
 "description": "Per-area hunting records in a UI tab named 'Stats': xp, gold and kills an hour, Dragonhood progress and ETA, who hunted with you, area comparison. A hunt is filed when you leave its area and survives a refresh or disconnect. Area, players and level come from GMCP. State in client.loom.huntstats; records in huntstats_areas and huntstats_log. HUNTSTATS HELP for commands."
}