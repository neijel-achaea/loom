{
 "type": "group",
 "name": "huntstats",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "// Initialise persistent stores without clobbering existing data on reimport.\nvar have = false;\ntry { if (get_variable(\"hs_log\") !== undefined) { have = true; } } catch (e) { have = false; }\nif (!have) { set_variable(\"hs_areas\", \"{}\"); set_variable(\"hs_log\", \"[]\"); }\nset_variable(\"hs_open\", \"\");\ndisplay_notice(\"[huntstats] installed. Create a UI tab named 'Stats' for the live panel.\", \"cyan\");"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; persistent variables are left intact."
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"Stats\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 18 17\"><path d=\"M2 15 L12 5\" stroke=\"#e4e6da\" stroke-width=\"1.2\"/><path d=\"M10 2 L16 2 L16 8 Z\" fill=\"#a9c46c\"/><path d=\"M2 15 L1 12 M2 15 L5 16 M3.6 13.4 L2.4 10.6 M3.6 13.4 L6.4 14.6\" stroke=\"#56693a\" stroke-width=\"1\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}"
  },
  {
   "type": "function",
   "name": "hs_ensureTable",
   "enabled": true,
   "code": "if (!client.dragonXP) {\n  client.dragonXP = {\n    1:0, 2:5000, 3:10500, 4:20550, 5:35205, 6:50525, 7:70577, 8:95043, 9:122000,\n    10:152000, 11:185000, 12:225000, 13:267000, 14:312000, 15:359000, 16:407000,\n    17:456000, 18:506000, 19:561000, 20:621000, 21:691000, 22:761000, 23:836000,\n    24:916000, 25:1001000, 26:1091000, 27:1186000, 28:1286000, 29:1391000,\n    30:1501000, 31:1616000, 32:1736000, 33:1861000, 34:1986000, 35:2116000,\n    36:2251000, 37:2391000, 38:2536000, 39:2686000, 40:2941000, 41:3096000,\n    42:3256000, 43:3416000, 44:3581000, 45:3746000, 46:3916000, 47:4150000,\n    48:4353395, 49:4794382, 50:5279468, 51:5813062, 52:6400016, 53:7045665,\n    54:7755879, 55:8537115, 56:9396474, 57:10341769, 58:11381594, 59:12525401,\n    60:13783589, 61:15167596, 62:16690004, 63:18364653, 64:20206766, 65:22233091,\n    66:24462048, 67:26913901, 68:29610939, 69:32576939, 70:35840356, 71:39430114,\n    72:43378848, 73:47722456, 74:52500425, 75:60000000, 76:70000000, 77:83000000,\n    78:100000000, 79:120000000, 80:150000000, 81:185000000, 82:225000000,\n    83:270000000, 84:320000000, 85:375000000, 86:435000000, 87:500000000,\n    88:570000000, 89:645000000, 90:725000000, 91:810000000, 92:900000000,\n    93:995000000, 94:1095000000, 95:1200000000, 96:1310000000, 97:1425000000,\n    98:1545000000, 99:1670000000\n  };\n}"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Auto-called by Nexus on every GMCP message.\n// NOTE: if you already run an onGMCP in another package and Nexus only honours\n// one, copy the blocks below into that handler instead and disable this function.\n\n// --- resume-or-bank an interrupted session (runs once per connection) ---\n// client.* is wiped on refresh/reconnect, so client.hsResumed is undefined again,\n// and hs_open (a saved variable) survives to be recovered here.\nif (!client.hsResumed) {\n  client.hsResumed = true;\n  var _saved = \"\";\n  try { _saved = get_variable(\"hs_open\"); } catch (e) { _saved = \"\"; }\n  if (_saved) {\n    var _b = null;\n    try { _b = JSON.parse(_saved); } catch (e) { _b = null; }\n    if (_b && _b.firstXpAt && _b.xp > 0) {\n      var _idle = Date.now() - (_b.lastXpAt || _b.firstXpAt);\n      client.track = _b;\n      if (_idle < 600000) {\n        display_notice(\"[huntstats] resumed session in \" + _b.area + \" (\" + _b.xp.toLocaleString() + \" xp so far)\", \"cyan\");\n      } else {\n        run_function(\"hs_finalize\", [], \"huntstats\");\n        display_notice(\"[huntstats] banked interrupted session in \" + _b.area, \"cyan\");\n      }\n    } else {\n      try { set_variable(\"hs_open\", \"\"); } catch (e) {}\n    }\n  }\n}\n\nif (args.gmcp_method === \"Char.Vitals\") {\n  var v = args.gmcp_args;\n  if (v) {\n    if (!client.track) { client.track = {}; }\n    // live update on every push (nl here is an integer, e.g. \"58\")\n    if (v.nl !== undefined) {\n      var nlv = parseFloat(v.nl);\n      if (!isNaN(nlv)) { client.track.nl = nlv; }\n    }\n    // refine to the precise decimal + capture level when charstats is present\n    if (v.charstats && v.charstats[0]) {\n      var mm = String(v.charstats[0]).match(/Level:\\s*(\\d+)\\s*\\(([\\d.]+)%\\)/);\n      if (mm) { client.track.level = parseInt(mm[1], 10); client.track.nl = parseFloat(mm[2]); }\n    }\n  }\n\n  // --- update F9 Dragonhood % button ---\n  run_function(\"hs_ensureTable\", [], \"huntstats\");\n  if (client.track && client.track.level !== undefined && client.track.nl !== undefined && client.dragonXP[Math.floor(client.track.level)] !== undefined) {\n    var _l = Math.floor(client.track.level);\n    var _pct;\n    if (_l >= 99) { _pct = 100; }\n    else { var _bb = client.dragonXP[_l], _n = client.dragonXP[_l + 1]; _pct = ((_bb + (client.track.nl / 100) * (_n - _bb)) / client.dragonXP[99]) * 100; }\n    var _label = \"DH \" + _pct.toFixed(2) + \"%\";\n    if (_label !== client._dragonBtnLabel) {\n      client._dragonBtnLabel = _label;\n      try { buttons_set_label(9, _label); } catch (e) {}\n    }\n  }\n}\n\nif (args.gmcp_method === \"Room.Info\") {\n  var info = args.gmcp_args;\n  if (info && info.area) {\n    if (!client.track) { client.track = {}; }\n    if (client.track.area === undefined) {\n      client.track.area = info.area;\n      client.track.xp = 0; client.track.gold = 0; client.track.kills = 0;\n      client.track.firstXpAt = 0; client.track.lastXpAt = 0;\n      client.track.startDragonPct = null; client.track.players = {};\n    } else if (info.area !== client.track.area) {\n      run_function(\"hs_finalize\", [], \"huntstats\");\n      client.track.area = info.area;\n    }\n  }\n}\n\nif (args.gmcp_method === \"Room.Players\") {\n  var ps = args.gmcp_args;\n  if (ps && ps.length && client.track) {\n    if (!client.track.players) { client.track.players = {}; }\n    for (var i = 0; i < ps.length; i++) {\n      if (ps[i] && ps[i].name) { client.track.players[ps[i].name] = 1; }\n    }\n  }\n}"
  },
  {
   "type": "function",
   "name": "hs_finalize",
   "enabled": true,
   "code": "// Close the current area bucket. Logs a session only if xp was gained.\n// Then clears accumulators (keeps area / level / nl) so the next kill starts fresh.\nif (client.track && client.track.firstXpAt && client.track.xp > 0 && (client.track.lastXpAt - client.track.firstXpAt) >= 60000) {\n  var ms = client.track.lastXpAt - client.track.firstXpAt;\n  var hrs = ms / 3600000;\n  var xpHr = Math.round(client.track.xp / hrs);\n  var goldHr = Math.round(client.track.gold / hrs);\n\n  run_function(\"hs_ensureTable\", [], \"huntstats\");\n  var ep = null;\n  if (client.track.level !== undefined && client.track.nl !== undefined && client.dragonXP[Math.floor(client.track.level)] !== undefined) {\n    var l = Math.floor(client.track.level);\n    if (l >= 99) { ep = 100; }\n    else { var b = client.dragonXP[l], n = client.dragonXP[l + 1]; ep = ((b + (client.track.nl / 100) * (n - b)) / client.dragonXP[99]) * 100; }\n  }\n  var dGain = (ep !== null && client.track.startDragonPct !== null && client.track.startDragonPct !== undefined) ? (ep - client.track.startDragonPct) : null;\n\n  var players = [];\n  for (var k in client.track.players) { if (client.track.players.hasOwnProperty(k)) { players.push(k); } }\n\n  var rec = { area: client.track.area, xp: client.track.xp, gold: client.track.gold,\n              kills: client.track.kills || 0, ms: ms, xpHr: xpHr, goldHr: goldHr,\n              dGain: dGain, players: players, at: Date.now() };\n\n  var log = [];\n  try { log = JSON.parse(get_variable(\"hs_log\")) || []; } catch (e) { log = []; }\n  log.unshift(rec);\n  if (log.length > 5) { log = log.slice(0, 5); }\n  set_variable(\"hs_log\", JSON.stringify(log));\n\n  var areas = {};\n  try { areas = JSON.parse(get_variable(\"hs_areas\")) || {}; } catch (e) { areas = {}; }\n  var a = areas[rec.area] || { xp: 0, gold: 0, kills: 0, ms: 0, sessions: 0 };\n  a.xp += rec.xp; a.gold += rec.gold; a.kills += rec.kills; a.ms += rec.ms; a.sessions += 1;\n  areas[rec.area] = a;\n  set_variable(\"hs_areas\", JSON.stringify(areas));\n\n  var mins = Math.floor(ms / 60000);\n  var dur = Math.floor(mins / 60) + \"h \" + (mins % 60) + \"m\";\n  var extra = (dGain !== null) ? (\", +\" + dGain.toFixed(3) + \"% dragon\") : \"\";\n  display_notice(\"[huntstats] \" + rec.area + \": \" + rec.xp.toLocaleString() + \" xp (\" + xpHr.toLocaleString() + \"/hr), \" + rec.gold.toLocaleString() + \" gold, \" + rec.kills + \" kills, \" + dur + extra, \"cyan\");\n  // send_command(\"pt [huntstats] \" + rec.area + \": \" + rec.xp.toLocaleString() + \" xp (\" + xpHr.toLocaleString() + \"/hr), \" + rec.gold.toLocaleString() + \" gold, \" + rec.kills + \" kills, \" + dur + extra);\n  run_function(\"hs_render\", [], \"huntstats\");\n}\n\n// always reset accumulators + clear the open-session checkpoint\nif (client.track) {\n  client.track.xp = 0; client.track.gold = 0; client.track.kills = 0;\n  client.track.firstXpAt = 0; client.track.lastXpAt = 0;\n  client.track.startDragonPct = null; client.track.players = {};\n}\nclient.hsLastSave = 0;\ntry { set_variable(\"hs_open\", \"\"); } catch (e) {}"
  },
  {
   "type": "function",
   "name": "hs_render",
   "enabled": true,
   "code": "// Rebuild the 'Stats' custom tab from the persistent log + area aggregates,\n// in the house style shared with Coffers, Level, Ledger, Fishing, DmgChart and\n// Talismans: ink panel, serif small-caps headings, one large figure, monospace\n// ledger rows. The accent is a hunter's moss green.\nvar log = [];\ntry { log = JSON.parse(get_variable(\"hs_log\")) || []; } catch (e) { log = []; }\nvar areas = {};\ntry { areas = JSON.parse(get_variable(\"hs_areas\")) || {}; } catch (e) { areas = {}; }\n\nvar MOSS = \"#a9c46c\";\nvar DEEP = \"#56693a\";\nvar GOLD = \"#e2bd5a\";\nvar DRAGON = \"#b99be0\";\nvar TXT = \"#e4e6da\";\nvar MUTED = \"#878c7a\";\nvar RULE = \"#272d1f\";\nvar TRACK = \"#1a1f14\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\n\nfunction fmtDur(ms) { var m = Math.floor(ms / 60000); return m < 60 ? m + \"m\" : Math.floor(m / 60) + \"h \" + (m % 60) + \"m\"; }\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\nfunction thou(n) { var neg = n < 0; var s = String(Math.round(Math.abs(n))); var o = \"\"; while (s.length > 3) { o = \",\" + s.slice(-3) + o; s = s.slice(0, -3); } return (neg ? \"-\" : \"\") + s + o; }\nfunction ago(t) {\n  var s = Math.floor((Date.now() - t) / 1000);\n  if (s < 3600) { return Math.max(1, Math.round(s / 60)) + \"m ago\"; }\n  if (s < 86400) { return Math.round(s / 3600) + \"h ago\"; }\n  return Math.round(s / 86400) + \"d ago\";\n}\nfunction caps(t, c) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (c || DEEP) + ';font-size:11px;margin:0 0 3px;\">' + t + '</div>'; }\nfunction row(label, value, c) {\n  return '<div style=\"display:flex;justify-content:space-between;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"color:' + MUTED + ';white-space:nowrap;\">' + label + '</span><span style=\"color:' + (c || TXT) + ';white-space:nowrap;\">' + value + '</span></div>';\n}\nfunction box(inner, c) { return '<div style=\"flex:1 1 150px;min-width:150px;border-top:2px solid ' + (c || DEEP) + ';padding:3px 2px 0;\">' + inner + '</div>'; }\nfunction section(title, inner) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title, MOSS) + inner + '</div>'; }\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">' + t + '</div>'; }\nfunction byTime(x, y) { return y.ms - x.ms; }\n\n// Dragonhood, when the level is known this connection.\nvar dh = null;\ntry {\n  run_function(\"hs_ensureTable\", [], \"huntstats\");\n  var tr = client.track;\n  if (tr && tr.level !== undefined && tr.nl !== undefined && client.dragonXP[Math.floor(tr.level)] !== undefined) {\n    var lv = Math.floor(tr.level);\n    if (lv >= 99) { dh = 100; }\n    else { var b0 = client.dragonXP[lv], b1 = client.dragonXP[lv + 1]; dh = ((b0 + (tr.nl / 100) * (b1 - b0)) / client.dragonXP[99]) * 100; }\n  }\n} catch (e) { dh = null; }\n\n// An arrowhead over a sprig, the hunting tab's counterpart of the coin stack.\nvar glyph = '<svg width=\"18\" height=\"17\" viewBox=\"0 0 18 17\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<path d=\"M2 15 L12 5\" stroke=\"' + TXT + '\" stroke-width=\"1.2\"/><path d=\"M10 2 L16 2 L16 8 Z\" fill=\"' + MOSS + '\"/>' +\n  '<path d=\"M2 15 L1 12 M2 15 L5 16 M3.6 13.4 L2.4 10.6 M3.6 13.4 L6.4 14.6\" stroke=\"' + DEEP + '\" stroke-width=\"1\"/></svg>';\n\nvar arr = [];\nvar lt = { xp: 0, gold: 0, kills: 0, ms: 0, sessions: 0 };\nfor (var k in areas) {\n  if (areas.hasOwnProperty(k)) {\n    var a = areas[k];\n    var hrs = a.ms / 3600000;\n    arr.push({ area: k, xpHr: hrs > 0 ? Math.round(a.xp / hrs) : 0, goldHr: hrs > 0 ? Math.round(a.gold / hrs) : 0, sessions: a.sessions, ms: a.ms });\n    lt.xp += a.xp || 0; lt.gold += a.gold || 0; lt.kills += a.kills || 0; lt.ms += a.ms || 0; lt.sessions += a.sessions || 0;\n  }\n}\narr.sort(byTime);\n\nvar html = '<div style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:#11130d;border:1px solid ' + RULE + ';padding:7px 8px 8px;\">';\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\nhtml += '<div style=\"font-family:' + SERIF + ';color:' + MOSS + ';font-size:14px;letter-spacing:0.22em;\">' + glyph + 'HUNTING</div>';\nhtml += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + MUTED + ';font-size:11px;\">' + (dh !== null ? 'dragonhood <span style=\"color:' + DRAGON + ';\">' + dh.toFixed(2) + '%</span>' : arr.length + ' area' + (arr.length === 1 ? '' : 's')) + '</div></div>';\n\nif (log.length === 0) {\n  html += '<div style=\"margin-top:8px;\">' + quiet(\"No hunts logged yet. A hunt is filed when you leave the area, or with HUNTFLUSH; it needs a minute or more of experience to count.\") + '</div>';\n} else {\n  // The headline is the most recent hunt's experience rate.\n  var L = log[0];\n  html += '<div style=\"margin:6px 0 1px;\"><span style=\"font-family:' + SERIF + ';font-size:26px;color:' + MOSS + ';\">' + thou(L.xpHr) + '</span> ';\n  html += '<span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">xp/hour, last hunt</span></div>';\n  html += '<div style=\"color:' + MUTED + ';\">in <span style=\"font-family:' + SERIF + ';color:' + TXT + ';\">' + esc(L.area) + '</span>' + (L.at ? ' &middot; ' + ago(L.at) : '') + '</div>';\n\n  var cols = '<div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;\">';\n  var lb = caps(\"Last hunt\", MOSS);\n  lb += row(\"time\", fmtDur(L.ms));\n  lb += row(\"experience\", thou(L.xp));\n  lb += row(\"gold\", thou(L.gold) + ' <span style=\"color:' + MUTED + ';\">(' + thou(L.goldHr) + '/hr)</span>', GOLD);\n  lb += row(\"kills\", String(L.kills) + (L.ms > 0 ? ' <span style=\"color:' + MUTED + ';\">(' + Math.round(L.kills / (L.ms / 3600000)) + '/hr)</span>' : ''));\n  if (L.dGain !== null && L.dGain !== undefined) { lb += row(\"dragonhood\", '+' + L.dGain.toFixed(3) + '%', DRAGON); }\n  cols += box(lb, MOSS);\n  var hb = caps(\"Lifetime\", MOSS);\n  var lh = lt.ms / 3600000;\n  hb += row(\"time hunted\", fmtDur(lt.ms));\n  hb += row(\"hunts\", String(lt.sessions));\n  hb += row(\"xp / hr\", lh > 0 ? thou(lt.xp / lh) : \"&mdash;\", MOSS);\n  hb += row(\"gold / hr\", lh > 0 ? thou(lt.gold / lh) : \"&mdash;\", GOLD);\n  hb += row(\"kills\", thou(lt.kills));\n  cols += box(hb, DEEP);\n  html += cols + '</div>';\n\n  // Recent hunts, newest first, each as a two-line ledger entry.\n  var rs = \"\";\n  for (var i = 0; i < log.length; i++) {\n    var s = log[i];\n    rs += '<div style=\"border-bottom:1px dotted ' + RULE + ';padding:2px 0 3px;\">';\n    rs += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:6px;\"><span style=\"font-family:' + SERIF + ';color:' + TXT + ';font-size:11px;\">' + esc(s.area) + '</span>';\n    rs += '<span style=\"color:' + MUTED + ';white-space:nowrap;\">' + fmtDur(s.ms) + (s.at ? ' &middot; ' + ago(s.at) : '') + '</span></div>';\n    rs += '<div style=\"color:' + MUTED + ';\"><span style=\"color:' + MOSS + ';\">' + thou(s.xpHr) + '</span> xp/hr &middot; <span style=\"color:' + GOLD + ';\">' + thou(s.gold) + '</span> gold &middot; ' + s.kills + ' kills';\n    if (s.dGain !== null && s.dGain !== undefined) { rs += ' &middot; <span style=\"color:' + DRAGON + ';\">+' + s.dGain.toFixed(3) + '%</span>'; }\n    rs += '</div>';\n    if (s.players && s.players.length) { rs += '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">with ' + esc(s.players.join(\", \")) + '</div>'; }\n    rs += '</div>';\n  }\n  html += section(\"Recent hunts\", rs);\n}\n\n// Areas, by total time; each bar is its xp/hr against the best area.\nvar ar = \"\";\nif (arr.length === 0) {\n  ar = quiet(\"No area history yet.\");\n} else {\n  var best = 0;\n  for (var j = 0; j < arr.length; j++) { if (arr[j].xpHr > best) { best = arr[j].xpHr; } }\n  for (var j2 = 0; j2 < arr.length; j2++) {\n    var r = arr[j2];\n    var top = (r.xpHr === best && arr.length > 1);\n    var pct = best > 0 ? Math.round(r.xpHr / best * 100) : 0;\n    ar += '<div style=\"margin:0 0 5px;\">';\n    ar += '<div style=\"display:flex;justify-content:space-between;gap:6px;\"><span style=\"color:' + TXT + ';\">' + esc(r.area) + (top ? ' <span style=\"color:' + MOSS + ';\" title=\"best xp/hr\">&#9733;</span>' : '') + '</span>';\n    ar += '<span style=\"color:' + MOSS + ';white-space:nowrap;\">' + thou(r.xpHr) + ' <span style=\"color:' + MUTED + ';\">xp/hr</span></span></div>';\n    ar += '<div style=\"background:' + TRACK + ';height:5px;margin:2px 0 1px;\"><div style=\"background:' + (top ? MOSS : DEEP) + ';height:5px;width:' + pct + '%;\"></div></div>';\n    ar += '<div style=\"color:' + MUTED + ';\"><span style=\"color:' + GOLD + ';\">' + thou(r.goldHr) + '</span> gold/hr &middot; ' + r.sessions + ' hunt' + (r.sessions === 1 ? '' : 's') + ' &middot; ' + fmtDur(r.ms) + '</div>';\n    ar += '</div>';\n  }\n}\nhtml += section(\"Areas, by time spent\", ar);\nhtml += '</div>';\n\ntry { set_custom_tab_html(\"Stats\", html); } catch (e) {}"
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.track || client.track.area === undefined) {\n  display_notice(\"[huntstats] waiting for room data...\", \"yellow\");\n} else if (!client.track.firstXpAt) {\n  display_notice(\"[huntstats] \" + client.track.area + \" - no kills yet this session\", \"yellow\");\n} else {\n  var ms = Date.now() - client.track.firstXpAt;\n  var mins = Math.floor(ms / 60000);\n  var elapsed = Math.floor(mins / 60) + \"h \" + (mins % 60) + \"m\";\n  var hrs = ms / 3600000;\n  var xpHr = hrs > 0 ? Math.round(client.track.xp / hrs) : 0;\n  var goldHr = hrs > 0 ? Math.round(client.track.gold / hrs) : 0;\n  display_notice(\"[huntstats] \" + client.track.area + \" - \" + elapsed);\n  display_notice(\"[huntstats] xp:    \" + client.track.xp.toLocaleString() + \"  (\" + xpHr.toLocaleString() + \"/hr)\");\n  display_notice(\"[huntstats] gold:  \" + client.track.gold.toLocaleString() + \"  (\" + goldHr.toLocaleString() + \"/hr)\");\n  display_notice(\"[huntstats] kills: \" + (client.track.kills || 0));\n\n  run_function(\"hs_ensureTable\", [], \"huntstats\");\n  if (client.track.level !== undefined && client.track.nl !== undefined && client.dragonXP[Math.floor(client.track.level)] !== undefined) {\n    var l = Math.floor(client.track.level);\n    if (l < 99) {\n      var b = client.dragonXP[l], n = client.dragonXP[l + 1];\n      var expPerPct = (n - b) / 100;\n      if (xpHr > 0 && expPerPct > 0) {\n        var pctLeft = 100 - client.track.nl;\n        var minsLeft = Math.round(((pctLeft * expPerPct) / xpHr) * 60);\n        display_notice(\"[huntstats] level \" + (l + 1) + \" in ~\" + Math.floor(minsLeft / 60) + \"h \" + (minsLeft % 60) + \"m\");\n      }\n    }\n    var curDragon;\n    if (l >= 99) { curDragon = 100; }\n    else { var bb = client.dragonXP[l], nn = client.dragonXP[l + 1]; curDragon = ((bb + (client.track.nl / 100) * (nn - bb)) / client.dragonXP[99]) * 100; }\n    var gainedTxt = \"\";\n    if (client.track.startDragonPct !== null && client.track.startDragonPct !== undefined) {\n      gainedTxt = \"  (+\" + (curDragon - client.track.startDragonPct).toFixed(3) + \"% this session)\";\n    }\n    \n    if (l < 99 && xpHr > 0) {\n      display_notice(\"[huntstats] Dragonhood: \" + curDragon.toFixed(2) + \"%\" + gainedTxt, \"white\");\n      var xpToDragon = client.dragonXP[99] - (client.dragonXP[l] + (client.track.nl / 100) * (client.dragonXP[l + 1] - client.dragonXP[l]));\n      var hToDragon = xpToDragon / xpHr;\n      display_notice(\"[huntstats] Dragonhood ETA: ~\" + Math.floor(hToDragon) + \"h \" + Math.round((hToDragon - Math.floor(hToDragon)) * 60) + \"m\");\n    }\n  }\n}"
    }
   ],
   "text": "^huntstats$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "var areas = {};\ntry { areas = JSON.parse(get_variable(\"hs_areas\")) || {}; } catch (e) { areas = {}; }\nvar arr = [];\nfor (var k in areas) {\n  if (areas.hasOwnProperty(k)) {\n    var a = areas[k]; var hrs = a.ms / 3600000;\n    arr.push({ area: k, xpHr: hrs > 0 ? Math.round(a.xp / hrs) : 0, goldHr: hrs > 0 ? Math.round(a.gold / hrs) : 0, sessions: a.sessions, ms: a.ms });\n  }\n}\nif (arr.length === 0) { display_notice(\"[huntstats] no area history yet\", \"yellow\"); }\nelse {\n  arr.sort(function (x, y) { return y.ms - x.ms; });\n  display_notice(\"[huntstats] Areas by total ime (lifetime):\", \"white\");\n  for (var j = 0; j < arr.length; j++) {\n    var r = arr[j]; var m = Math.floor(r.ms / 60000); var dur = Math.floor(m / 60) + \"h \" + (m % 60) + \"m\";\n    display_notice(\"  \" + r.area + \" - \" + r.xpHr.toLocaleString() + \" xp/hr, \" + r.goldHr.toLocaleString() + \" gold/hr (\" + r.sessions + \" sessions, \" + dur + \")\");\n  }\n}"
    }
   ],
   "text": "^huntareas$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "var log = [];\ntry { log = JSON.parse(get_variable(\"hs_log\")) || []; } catch (e) { log = []; }\nif (log.length === 0) { display_notice(\"[huntstats] no sessions logged yet\", \"yellow\"); }\nelse {\n  display_notice(\"[huntstats] Last \" + log.length + \" sessions:\", \"white\");\n  for (var i = 0; i < log.length; i++) {\n    var s = log[i]; var m = Math.floor(s.ms / 60000); var dur = Math.floor(m / 60) + \"h \" + (m % 60) + \"m\";\n    var pl = (s.players && s.players.length) ? (\"  party: \" + s.players.join(\", \")) : \"\";\n    var dg = (s.dGain !== null && s.dGain !== undefined) ? (\"  +\" + s.dGain.toFixed(3) + \"% dragon\") : \"\";\n    display_notice(\"  \" + s.area + \" - \" + dur + \", \" + s.xp.toLocaleString() + \" xp (\" + s.xpHr.toLocaleString() + \"/hr), \" + s.gold.toLocaleString() + \" gold, \" + s.kills + \" kills\" + dg + pl);\n  }\n}"
    }
   ],
   "text": "^huntlog$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"hs_finalize\", [], \"huntstats\");\ndisplay_notice(\"[huntstats] current session banked\", \"green\");"
    }
   ],
   "text": "^huntflush$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "var arg = args[1] || \"\";\nif (arg === \"confirm\") {\n  set_variable(\"hs_areas\", \"{}\"); set_variable(\"hs_log\", \"[]\");\n  run_function(\"hs_render\", [], \"huntstats\");\n  display_notice(\"[huntstats] history wiped\", \"red\");\n} else {\n  display_notice(\"[huntstats] This clears ALL saved area stats and the session log. Type HUNTWIPE CONFIRM to proceed.\", \"yellow\");\n}"
    }
   ],
   "text": "^huntwipe(?:\\s+(confirm))?$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (client.track && client.track.area !== undefined) {\n  var gained = parseInt(args[1], 10);\n  if (!isNaN(gained)) {\n    if (!client.track.firstXpAt) {\n      client.track.firstXpAt = Date.now();\n      run_function(\"hs_ensureTable\", [], \"huntstats\");\n      var sp = null;\n      if (client.track.level !== undefined && client.track.nl !== undefined && client.dragonXP[Math.floor(client.track.level)] !== undefined) {\n        var l = Math.floor(client.track.level);\n        if (l >= 99) { sp = 100; }\n        else { var b = client.dragonXP[l], n = client.dragonXP[l + 1]; sp = ((b + (client.track.nl / 100) * (n - b)) / client.dragonXP[99]) * 100; }\n      }\n      client.track.startDragonPct = sp;\n    }\n    client.track.xp += gained;\n    client.track.lastXpAt = Date.now();\n\n    // checkpoint the open bucket (throttled) so a refresh/crash/disconnect can recover it\n    var nowMs = Date.now();\n    if (!client.hsLastSave || (nowMs - client.hsLastSave) > 5000) {\n      client.hsLastSave = nowMs;\n      try { set_variable(\"hs_open\", JSON.stringify(client.track)); } catch (e) {}\n    }\n  }\n}"
    }
   ],
   "text": "^You have gained (\\d+) experience\\.",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (client.track && client.track.area !== undefined) {\n  var g = parseInt(args[1].replace(/,/g, \"\"), 10);\n  if (!isNaN(g)) { client.track.gold += g; }\n}"
    }
   ],
   "text": "^You pick up ([\\d,]+) gold sovereigns\\.",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (client.track && client.track.area !== undefined) {\n  client.track.kills = (client.track.kills || 0) + 1;\n  client.track.lastXpAt = Date.now();\n}"
    }
   ],
   "text": "^You have slain ",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.track) { client.track = {}; }\nvar lvl = parseInt(args[1], 10);\nvar pct = parseFloat(args[2]);\nif (!isNaN(lvl)) { client.track.level = lvl; }\nif (!isNaN(pct)) { client.track.nl = pct; }\n\nset_variable(\"my_level\", lvl);"
    }
   ],
   "text": "Level\\s*:\\s*(\\d+)\\s*\\(([\\d.]+)%\\)",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  }
 ],
 "description": "Automatic per-area hunting sessions with persistent stats, kill counts, group co-presence, Dragonhood progress, crash-safe checkpointing, a quit wrapper, and a 'Stats' UI tab."
}