{
 "type": "group",
 "name": "huntstats",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"huntstats_setup\", [], \"huntstats\");\nrun_function(\"huntstats_render\", [], \"huntstats\");\ndisplay_notice(\"[huntstats] installed. Create a UI tab named 'Stats' for the panel. HUNTSTATS HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; the huntstats_* variables are left intact.\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"Stats\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 18 17\"><path d=\"M2 15 L12 5\" stroke=\"#e4e6da\" stroke-width=\"1.2\"/><path d=\"M10 2 L16 2 L16 8 Z\" fill=\"#a9c46c\"/><path d=\"M2 15 L1 12 M2 15 L5 16 M3.6 13.4 L2.4 10.6 M3.6 13.4 L6.4 14.6\" stroke=\"#56693a\" stroke-width=\"1\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\nrun_function(\"huntstats_setup\", [], \"huntstats\");\nrun_function(\"huntstats_render\", [], \"huntstats\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Everything huntstats knows about where you are and how far along you are\n// comes from GMCP: Room.Info for the area, Char.Status and Char.Vitals for the\n// level and percent to next. Who hunted with you is the manual party list\n// (HUNTSTATS PARTY, #87), not whoever was in the room.\nvar hsM = \"\";\nvar hsA = null;\ntry { hsM = args.gmcp_method; hsA = args.gmcp_args; } catch (e) { hsM = \"\"; }\nif (typeof hsA === \"string\") { try { hsA = JSON.parse(hsA); } catch (e) { hsA = null; } }\nif (!client.loom || !client.loom.huntstats || !client.loom.huntstats.xpTable) run_function(\"huntstats_setup\", [], \"huntstats\");\nvar HS = client.loom.huntstats;\n\n// --- resume or bank an interrupted hunt (once per connection) ---\n// client.* is wiped on a refresh or reconnect, so HS.resumed is unset again\n// and the huntstats_open checkpoint (a saved variable) is recovered here.\nif (!HS.resumed) {\n  HS.resumed = true;\n  var hsSaved = \"\";\n  try { hsSaved = get_variable(\"huntstats_open\"); } catch (e) { hsSaved = \"\"; }\n  if (hsSaved) {\n    var hsB = null;\n    try { hsB = JSON.parse(hsSaved); } catch (e) { hsB = null; }\n    if (hsB && hsB.area !== undefined && hsB.firstXpAt && hsB.xp > 0) {\n      var hsIdle = Date.now() - (hsB.lastXpAt || hsB.firstXpAt);\n      HS.cur = hsB;\n      if (hsIdle < 600000) {\n        display_notice(\"[huntstats] resumed hunt in \" + hsB.area + \" (\" + hsB.xp.toLocaleString() + \" xp so far)\", \"cyan\");\n      } else {\n        run_function(\"huntstats_finalize\", [], \"huntstats\");\n        display_notice(\"[huntstats] filed interrupted hunt in \" + hsB.area, \"lime\");\n      }\n    } else {\n      try { set_variable(\"huntstats_open\", \"\"); } catch (e) {}\n    }\n  }\n}\n\n// Your name, for the split's party tell report (#89). The game sends it only\n// at login, so it's kept (huntstats_name) for a package loaded mid-session.\nif ((hsM === \"Char.Name\" || hsM === \"Char.Status\") && hsA && hsA.name && String(hsA.name) !== HS.me) {\n  HS.me = String(hsA.name);\n  try { set_variable(\"huntstats_name\", HS.me); } catch (e) {}\n}\n\nif (hsM === \"Char.Status\" && hsA && hsA.level !== undefined) {\n  var hsS = String(hsA.level).match(/(\\d+)(?:\\s*\\(([\\d.]+)%\\))?/);\n  if (hsS) {\n    HS.level = parseInt(hsS[1], 10);\n    if (hsS[2] !== undefined) HS.nl = parseFloat(hsS[2]);\n  }\n}\n\nif (hsM === \"Char.Vitals\" && hsA) {\n  // Max health, for HUNTSTATS TANK's colours (#59).\n  var hsMx = parseInt(hsA.maxhp, 10);\n  if (!isNaN(hsMx) && hsMx > 0) HS.maxhp = hsMx;\n  var hsP = null;\n  if (hsA.charstats) {\n    for (var hsI = 0; hsI < hsA.charstats.length; hsI++) {\n      var hsC = String(hsA.charstats[hsI]).match(/Level:\\s*(\\d+)\\s*\\(([\\d.]+)%\\)/);\n      if (hsC) { hsP = hsC; break; }\n    }\n  }\n  if (hsP) {\n    HS.level = parseInt(hsP[1], 10);\n    HS.nl = parseFloat(hsP[2]);\n  } else if (hsA.nl !== undefined) {\n    // Whole percent only: keep a precise figure already held for it.\n    var hsN = parseFloat(hsA.nl);\n    if (!isNaN(hsN) && (HS.nl === undefined || Math.floor(HS.nl) !== hsN)) HS.nl = hsN;\n  }\n}\n\nif (hsM === \"Room.Info\" && hsA && hsA.area) {\n  if (!HS.cur || HS.cur.area === undefined) {\n    HS.fresh();\n    HS.cur.area = hsA.area;\n  } else if (hsA.area !== HS.cur.area) {\n    run_function(\"huntstats_finalize\", [], \"huntstats\");\n    HS.cur.area = hsA.area;\n  }\n}\n\n"
  },
  {
   "type": "function",
   "name": "huntstats_setup",
   "enabled": true,
   "code": "// huntstats_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, one-time migration of the\n// hs_* variables and the old loose client keys, the Dragonhood table, helpers\n// and settings, each built if missing.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.huntstats) client.loom.huntstats = {};\nclient.loom.registry.huntstats = { version: \"0.3.3\", keyword: \"HUNTSTATS\", desc: \"Per-area hunting records: xp, gold and kills an hour, Dragonhood\",\n  // Redrawn by loom when the tab theme changes (#310).\n  redraw: function () { run_function(\"huntstats_render\", [], \"huntstats\"); } };\nvar HS = client.loom.huntstats;\n\n// One-time migration: hs_* -> huntstats_*. A new variable that already holds\n// data wins; the old one is deleted either way.\nvar hsMoves = [[\"areas\", \"{}\"], [\"log\", \"[]\"], [\"open\", \"\"]];\nfor (var hsI = 0; hsI < hsMoves.length; hsI++) {\n  var hsOld;\n  try { hsOld = get_variable(\"hs_\" + hsMoves[hsI][0]); } catch (e) { hsOld = undefined; }\n  if (hsOld !== undefined && hsOld !== null) {\n    var hsNew;\n    try { hsNew = get_variable(\"huntstats_\" + hsMoves[hsI][0]); } catch (e) { hsNew = undefined; }\n    if (hsNew === undefined || hsNew === null || hsNew === \"\" || hsNew === hsMoves[hsI][1]) set_variable(\"huntstats_\" + hsMoves[hsI][0], hsOld);\n    delete_variable(\"hs_\" + hsMoves[hsI][0]);\n  }\n}\n// Fresh profile: the stores start empty (never clobbered on a reimport).\nvar hsHave;\ntry { hsHave = get_variable(\"huntstats_log\"); } catch (e) { hsHave = undefined; }\nif (hsHave === undefined || hsHave === null || hsHave === \"\") set_variable(\"huntstats_log\", \"[]\");\ntry { hsHave = get_variable(\"huntstats_areas\"); } catch (e) { hsHave = undefined; }\nif (hsHave === undefined || hsHave === null || hsHave === \"\") set_variable(\"huntstats_areas\", \"{}\");\n\n// The old package kept its state in loose client keys. A session still in\n// memory on a reimport without a page reload carries over; it has already\n// been resumed, so the checkpoint isn't recovered a second time.\nif (client.track && !HS.cur) { HS.cur = client.track; HS.resumed = true; }\nif (client.hsResumed) HS.resumed = true;\nvar hsOldKeys = [\"track\", \"dragonXP\", \"hsResumed\", \"hsLastSave\", \"_dragonBtnLabel\"];\nfor (var hsJ = 0; hsJ < hsOldKeys.length; hsJ++) {\n  if (client[hsOldKeys[hsJ]] !== undefined) delete client[hsOldKeys[hsJ]];\n}\n\n// Total experience at the start of each level, 1-99. Dragonhood is the share\n// of the experience to level 99 already earned.\nif (!HS.xpTable) {\n  HS.xpTable = {\n    1:0, 2:5000, 3:10500, 4:20550, 5:35205, 6:50525, 7:70577, 8:95043, 9:122000,\n    10:152000, 11:185000, 12:225000, 13:267000, 14:312000, 15:359000, 16:407000,\n    17:456000, 18:506000, 19:561000, 20:621000, 21:691000, 22:761000, 23:836000,\n    24:916000, 25:1001000, 26:1091000, 27:1186000, 28:1286000, 29:1391000,\n    30:1501000, 31:1616000, 32:1736000, 33:1861000, 34:1986000, 35:2116000,\n    36:2251000, 37:2391000, 38:2536000, 39:2686000, 40:2941000, 41:3096000,\n    42:3256000, 43:3416000, 44:3581000, 45:3746000, 46:3916000, 47:4150000,\n    48:4353395, 49:4794382, 50:5279468, 51:5813062, 52:6400016, 53:7045665,\n    54:7755879, 55:8537115, 56:9396474, 57:10341769, 58:11381594, 59:12525401,\n    60:13783589, 61:15167596, 62:16690004, 63:18364653, 64:20206766, 65:22233091,\n    66:24462048, 67:26913901, 68:29610939, 69:32576939, 70:35840356, 71:39430114,\n    72:43378848, 73:47722456, 74:52500425, 75:60000000, 76:70000000, 77:83000000,\n    78:100000000, 79:120000000, 80:150000000, 81:185000000, 82:225000000,\n    83:270000000, 84:320000000, 85:375000000, 86:435000000, 87:500000000,\n    88:570000000, 89:645000000, 90:725000000, 91:810000000, 92:900000000,\n    93:995000000, 94:1095000000, 95:1200000000, 96:1310000000, 97:1425000000,\n    98:1545000000, 99:1670000000\n  };\n}\n\n// Helpers, rebuilt on every setup so a reimport picks up new code.\n// dragon(): Dragonhood % from the current level reading, or null.\nHS.dragon = function () {\n  var t = HS.xpTable;\n  if (HS.level === undefined || HS.nl === undefined) return null;\n  var l = Math.floor(HS.level);\n  if (l >= 99) return 100;\n  if (t[l] === undefined || t[l + 1] === undefined) return null;\n  return ((t[l] + (HS.nl / 100) * (t[l + 1] - t[l])) / t[99]) * 100;\n};\n// xpToNext(): experience left to the next level, or null.\nHS.xpToNext = function () {\n  var t = HS.xpTable;\n  if (HS.level === undefined || HS.nl === undefined) return null;\n  var l = Math.floor(HS.level);\n  if (l >= 99 || t[l] === undefined || t[l + 1] === undefined) return null;\n  return (100 - HS.nl) / 100 * (t[l + 1] - t[l]);\n};\n// xpToDragon(): experience left to level 99, or null.\nHS.xpToDragon = function () {\n  var t = HS.xpTable;\n  if (HS.level === undefined || HS.nl === undefined) return null;\n  var l = Math.floor(HS.level);\n  if (l >= 99) return 0;\n  if (t[l] === undefined || t[l + 1] === undefined) return null;\n  return t[99] - (t[l] + (HS.nl / 100) * (t[l + 1] - t[l]));\n};\nHS.dur = function (ms) { var m = Math.floor(ms / 60000); return Math.floor(m / 60) + \"h \" + (m % 60) + \"m\"; };\n// The party (#87): names added by hand with HUNTSTATS PARTY ADD, kept until\n// removed or cleared, across hunts and reloads (saved as huntstats_party).\n// Each hunt starts with the party as it stands, and names added during a\n// hunt join it; the hunt's players are what the log and the tab show.\nif (!HS.party) {\n  HS.party = [];\n  try { HS.party = JSON.parse(get_variable(\"huntstats_party\") || \"[]\") || []; } catch (e) { HS.party = []; }\n}\nif (!HS.me) { try { HS.me = String(get_variable(\"huntstats_name\") || \"\"); } catch (e) { HS.me = \"\"; } }\n// HUNTSTATS SUGGEST weights (#88): xp, gold, variety (huntstats_weights).\nif (!HS.weights) {\n  var hsWt = String(get_variable(\"huntstats_weights\") || \"\").split(/[\\s,]+/);\n  HS.weights = (hsWt.length === 3 && !isNaN(parseFloat(hsWt[0]))) ? [parseFloat(hsWt[0]), parseFloat(hsWt[1]), parseFloat(hsWt[2])] : [70, 25, 5];\n}\nif (HS.splitTell === undefined) HS.splitTell = (String(get_variable(\"huntstats_splittell\") || \"\") === \"on\");\n// HUNTSTATS TANK (#59): how much of your max health per second you can heal\n// back, in percent (huntstats_tank, default 3: the health elixir alone gave\n// about 3.6% in Ricardo's measurements). An area's incoming damage per\n// combat second is held against it: green under half, yellow up to it,\n// red above.\nif (HS.tank === undefined) {\n  HS.tank = parseFloat(get_variable(\"huntstats_tank\"));\n  if (isNaN(HS.tank) || HS.tank <= 0) HS.tank = 3;\n}\n// damage(from): what dmgchart saw from the fight that brought the time\n// `from` until now, through loom (link dmgchart-huntstats): { dmg, combatMs,\n// maxHit, fights }, or undefined (link off, dmgchart missing, or a reload\n// since, so the record doesn't reach back that far).\nHS.damage = function (from) {\n  var Lm = client.loom.loom;\n  if (!from || !Lm || typeof Lm.answer !== \"function\") return undefined;\n  var v = Lm.answer(\"huntstats\", \"hunt.damage\", { from: from });\n  return (v && typeof v.dmg === \"number\") ? v : undefined;\n};\n// rate(dmg, combatMs): incoming damage per combat second, or null.\nHS.rate = function (dmg, combatMs) { return (combatMs >= 1000 && dmg >= 0) ? dmg / (combatMs / 1000) : null; };\n// tankTone(dps): { colour, word, cap } against HUNTSTATS TANK and your\n// current max health (GMCP), or null while max health is unknown.\nHS.tankTone = function (dps) {\n  if (dps === null || dps === undefined || !HS.maxhp) return null;\n  var cap = HS.tank / 100 * HS.maxhp;\n  if (dps < cap / 2) return { colour: \"#8fd694\", word: \"under half of what you heal\", cap: cap };\n  if (dps <= cap) return { colour: \"#e8c65a\", word: \"up to what you heal\", cap: cap };\n  return { colour: \"#ff6a5e\", word: \"more than you heal\", cap: cap };\n};\nHS.saveParty = function () { try { set_variable(\"huntstats_party\", JSON.stringify(HS.party)); } catch (e) {} };\n// fresh(): empty accumulators for a new hunt, keeping the area; the party\n// carries over.\nHS.fresh = function () {\n  if (!HS.cur) HS.cur = {};\n  HS.cur.xp = 0; HS.cur.gold = 0; HS.cur.kills = 0;\n  HS.cur.firstXpAt = 0; HS.cur.lastXpAt = 0;\n  HS.cur.startDragonPct = null; HS.cur.players = {};\n  for (var fI = 0; fI < HS.party.length; fI++) HS.cur.players[HS.party[fI]] = 1;\n  HS.cur.ledger = {}; HS.cur.unknown = [];\n};\n// The gold split (#89). HS.cur.ledger holds each of the hunt's people's net\n// gold from this hunt (\"you\" and the party): picked up, less dropped, plus\n// given to them, less given away. Gold dropped and picked up within the party\n// just moves; gold that leaves to someone outside it leaves the pot; someone\n// who put in their own gold ends negative and is paid back by the split. Gold others pass between\n// themselves shows no amount (\"gives some gold sovereigns\"), so it goes in\n// HS.cur.unknown instead. Anyone outside the party is ignored.\n// held(who, n): add n (or take it, if negative) to who's gold in hand.\nHS.held = function (who, n) {\n  var T = HS.cur;\n  if (!T || T.area === undefined || isNaN(n)) return;\n  if (who !== \"you\" && !(T.players && T.players[who])) return;\n  if (!T.ledger) T.ledger = {};\n  T.ledger[who] = (T.ledger[who] || 0) + n;\n  HS.save();\n};\nHS.inHunt = function (who) { return who === \"you\" || !!(HS.cur && HS.cur.players && HS.cur.players[who]); };\nHS.n = function (x) { return Math.round(x).toLocaleString(); };\n// split(tell): the split of the hunt under way as lines of text, or null\n// when there is no party or no gold. Even shares, and the fewest transfers\n// that get everyone there (largest debtor pays largest creditor first).\n// With tell, the party tell report instead: one line per person under your\n// own name (HS.me, from GMCP), then TOTAL and SPLIT, readable by everyone.\nHS.split = function (tell) {\n  var T = HS.cur;\n  if (!T) return null;\n  var who = [\"you\"];\n  for (var sK in (T.players || {})) { if (T.players.hasOwnProperty(sK)) who.push(sK); }\n  if (who.length < 2) return null;\n  var L = T.ledger || {};\n  var total = 0;\n  for (var sI = 0; sI < who.length; sI++) total += (L[who[sI]] || 0);\n  if (total <= 0) return null;\n  var share = total / who.length;\n  // Until your name has come over GMCP once (at a login), \"I\".\n  var me = HS.me || \"I\";\n  function nm(w) { return w === \"you\" ? me : w; }\n  var pay = [], get = [];\n  for (var sM = 0; sM < who.length; sM++) {\n    var b = (L[who[sM]] || 0) - share;\n    if (b >= 1) pay.push({ who: who[sM], amt: b });\n    else if (b <= -1) get.push({ who: who[sM], amt: -b });\n  }\n  pay.sort(function (x, y) { return y.amt - x.amt; });\n  get.sort(function (x, y) { return y.amt - x.amt; });\n  var moves = [], movesTell = [];\n  var pI = 0, gI = 0;\n  while (pI < pay.length && gI < get.length) {\n    var m = Math.min(pay[pI].amt, get[gI].amt);\n    if (Math.round(m) >= 1) {\n      var from = pay[pI].who, to = get[gI].who;\n      moves.push(from === \"you\" ? \"you give \" + to + \" \" + HS.n(m) : (to === \"you\" ? from + \" gives you \" + HS.n(m) : from + \" gives \" + to + \" \" + HS.n(m)));\n      movesTell.push(nm(from) + (nm(from) === \"I\" ? \" give \" : \" gives \") + nm(to) + \" \" + HS.n(m));\n    }\n    pay[pI].amt -= m; get[gI].amt -= m;\n    if (pay[pI].amt < 1) pI++;\n    if (get[gI].amt < 1) gI++;\n  }\n  var lines = [];\n  if (tell) {\n    for (var tJ = 0; tJ < who.length; tJ++) lines.push(nm(who[tJ]) + \": \" + HS.n(L[who[tJ]] || 0) + \" gold\");\n    lines.push(\"TOTAL: \" + HS.n(total) + \" gold, \" + HS.n(share) + \" each\");\n    lines.push(\"SPLIT: \" + (movesTell.length ? movesTell.join(\", \") : \"already even\"));\n    if (T.unknown && T.unknown.length) lines.push(\"Not counted (no amount shown): \" + T.unknown.join(\", \").replace(/\\byou\\b/g, me));\n    return lines;\n  }\n  var heldTxt = [];\n  for (var sJ = 0; sJ < who.length; sJ++) heldTxt.push(who[sJ] + \" \" + HS.n(L[who[sJ]] || 0));\n  lines.push(\"split: \" + HS.n(total) + \" gold among \" + who.length + \", \" + HS.n(share) + \" each. Net this hunt: \" + heldTxt.join(\", \") + \".\");\n  lines.push(moves.length ? \"to settle: \" + moves.join(\"; \") + \".\" : \"already even.\");\n  if (T.unknown && T.unknown.length) lines.push(\"not counted (the game shows no amount): \" + T.unknown.join(\", \") + \".\");\n  return lines;\n};\n// tellSplit(): send the report to party tell, one line each; false when\n// there is nothing to send or outbound commands are paused.\nHS.tellSplit = function () {\n  var tl = HS.split(true);\n  if (!tl || get_variable(\"pauseTriggers\") == \"on\") return false;\n  for (var tI = 0; tI < tl.length; tI++) send_command(\"pt \" + tl[tI], 1);\n  return true;\n};\n// save(): checkpoint the open hunt so a refresh, crash or disconnect can\n// recover it. Throttled to once every five seconds unless forced.\nHS.save = function (force) {\n  var now = Date.now();\n  if (!force && HS.lastSave && (now - HS.lastSave) <= 5000) return;\n  HS.lastSave = now;\n  try { set_variable(\"huntstats_open\", JSON.stringify(HS.cur)); } catch (e) {}\n};\n\n// The Dragonhood F-key setting existed briefly before release; drop it.\ntry { if (get_variable(\"huntstats_button\") !== undefined && get_variable(\"huntstats_button\") !== null) delete_variable(\"huntstats_button\"); } catch (e) {}\n\n// The read-only look other packages see through loom (#39): never its variables.\n//   look.filed()    -> the last filed hunt: { area, ms, players, at }\n//   look.hunt()     -> { area } while a hunt is under way (experience earned\n//                      in this area), undefined otherwise\n//   look.average(area) -> { gold, hunts } for that area: the average gold one\n//                      filed hunt earned there (total gold / hunts), or\n//                      undefined when no hunt there is on record\nHS.look = {\n  // look.party() -> the party's names as kept with HUNTSTATS PARTY, plus\n  //   anyone who joined the hunt under way (#53 skips their gold).\n  party: function () {\n    var out = HS.party.slice();\n    var pl = (HS.cur && HS.cur.players) || {};\n    for (var k in pl) { if (pl.hasOwnProperty(k) && out.indexOf(k) < 0) out.push(k); }\n    return out;\n  },\n  // look.filed() -> the last filed hunt, { area, ms, players, at }, or\n  //   undefined; players are the party's names (#40).\n  filed: function () {\n    var lg = [];\n    try { lg = JSON.parse(get_variable(\"huntstats_log\")) || []; } catch (e) { lg = []; }\n    var r = lg[0];\n    return r ? { area: r.area, ms: r.ms, players: (r.players || []).slice(), at: r.at } : undefined;\n  },\n  hunt: function () {\n    var c = HS.cur;\n    return (c && c.area !== undefined && c.firstXpAt && c.xp > 0) ? { area: c.area } : undefined;\n  },\n  average: function (area) {\n    var areas = {};\n    try { areas = JSON.parse(get_variable(\"huntstats_areas\")) || {}; } catch (e) { areas = {}; }\n    var a = areas[area];\n    return (a && a.sessions > 0 && a.gold > 0) ? { gold: Math.round(a.gold / a.sessions), hunts: a.sessions } : undefined;\n  }\n};\n"
  },
  {
   "type": "function",
   "name": "huntstats_finalize",
   "enabled": true,
   "code": "// huntstats_finalize -- close the current hunt. It is filed only when it\n// earned experience over a minute or more; either way the accumulators are\n// cleared (the area and level reading stay) and the checkpoint is dropped.\n// Called on leaving an area, by HUNTSTATS FLUSH, and by loom's QUIT wrapper.\nif (!client.loom || !client.loom.huntstats || !client.loom.huntstats.xpTable) run_function(\"huntstats_setup\", [], \"huntstats\");\nvar HS = client.loom.huntstats;\nvar T = HS.cur;\n\nif (T && T.firstXpAt && T.xp > 0 && (T.lastXpAt - T.firstXpAt) >= 60000) {\n  var ms = T.lastXpAt - T.firstXpAt;\n  var hrs = ms / 3600000;\n  var xpHr = Math.round(T.xp / hrs);\n  var goldHr = Math.round(T.gold / hrs);\n\n  var ep = HS.dragon();\n  // No Dragonhood gain for a hunt that started as a dragon.\n  var dGain = (ep !== null && T.startDragonPct !== null && T.startDragonPct !== undefined && T.startDragonPct < 100) ? (ep - T.startDragonPct) : null;\n\n  var players = [];\n  for (var k in T.players) { if (T.players.hasOwnProperty(k)) players.push(k); }\n\n  var rec = { area: T.area, xp: T.xp, gold: T.gold, kills: T.kills || 0, ms: ms,\n              xpHr: xpHr, goldHr: goldHr, dGain: dGain, players: players, at: Date.now() };\n\n  // Damage taken over the hunt, from dmgchart through loom (#59). Without\n  // it (link off, a reload mid-hunt) the hunt is filed without figures\n  // rather than wrong ones.\n  var dmg = HS.damage(T.firstXpAt);\n  if (dmg && dmg.combatMs >= 1000) { rec.dmgIn = dmg.dmg; rec.combatMs = dmg.combatMs; rec.maxHit = dmg.maxHit; }\n\n  var log = [];\n  try { log = JSON.parse(get_variable(\"huntstats_log\")) || []; } catch (e) { log = []; }\n  log.unshift(rec);\n  if (log.length > 5) log = log.slice(0, 5);\n  set_variable(\"huntstats_log\", JSON.stringify(log));\n\n  var areas = {};\n  try { areas = JSON.parse(get_variable(\"huntstats_areas\")) || {}; } catch (e) { areas = {}; }\n  var a = areas[rec.area] || { xp: 0, gold: 0, kills: 0, ms: 0, sessions: 0 };\n  a.xp += rec.xp; a.gold += rec.gold; a.kills += rec.kills; a.ms += rec.ms; a.sessions += 1;\n  if (rec.combatMs) {\n    // Per area: damage over combat time, summed over the hunts that have it.\n    a.dmgIn = (a.dmgIn || 0) + rec.dmgIn;\n    a.combatMs = (a.combatMs || 0) + rec.combatMs;\n    if (rec.maxHit > (a.maxHit || 0)) a.maxHit = rec.maxHit;\n  }\n  a.last = rec.at; // when you last hunted here, for HUNTSTATS SUGGEST (#88)\n  areas[rec.area] = a;\n  set_variable(\"huntstats_areas\", JSON.stringify(areas));\n\n  var dps = rec.combatMs ? HS.rate(rec.dmgIn, rec.combatMs) : null;\n  var extra = (dGain !== null) ? (\", \" + (dGain < 0 ? \"\" : \"+\") + dGain.toFixed(3) + \"% dragon\") : \"\";\n  display_notice(\"[huntstats] \" + rec.area + \": \" + rec.xp.toLocaleString() + \" xp (\" + xpHr.toLocaleString() + \"/hr), \" + rec.gold.toLocaleString() + \" gold, \" + rec.kills + \" kills, \" + HS.dur(ms) + extra + (dps !== null ? \", took \" + Math.round(dps).toLocaleString() + \"/s (max hit \" + rec.maxHit.toLocaleString() + \")\" : \"\"), \"lime\");\n  // The party's gold split (#89), and to party tell with SPLIT TELL ON.\n  var spl = HS.split();\n  if (spl) {\n    for (var spI = 0; spI < spl.length; spI++) display_notice(\"[huntstats] \" + spl[spI], \"cyan\");\n    if (HS.splitTell) HS.tellSplit();\n  }\n}\n\nHS.fresh();\nHS.lastSave = 0;\ntry { set_variable(\"huntstats_open\", \"\"); } catch (e) {}\n// Redrawn after the hunt is cleared, so the tab no longer shows it as under\n// way (#90).\nrun_function(\"huntstats_render\", [], \"huntstats\");\n// The hunt is over: tell loom (#39 withdraws its goal proposal).\nif (client.loom.notify) client.loom.notify(\"huntstats\");\n"
  },
  {
   "type": "function",
   "name": "huntstats_render",
   "enabled": true,
   "code": "// huntstats_render -- rebuild the 'Stats' custom tab from the persistent log + area aggregates,\n// in the house style shared with Coffers, Level, Ledger, Fishing, DmgChart and\n// Talismans: ink panel, serif small-caps headings, one large figure, monospace\n// ledger rows. The accent is a hunter's moss green.\nvar log = [];\ntry { log = JSON.parse(get_variable(\"huntstats_log\")) || []; } catch (e) { log = []; }\nvar areas = {};\ntry { areas = JSON.parse(get_variable(\"huntstats_areas\")) || {}; } catch (e) { areas = {}; }\n\n// Tab theme (#310): loom's city palette when one is on, else this tab's own colours.\nvar TH = (client.loom && client.loom.theme) || {};\nvar MOSS = TH.acc || \"#a9c46c\";\nvar DEEP = TH.deep || \"#56693a\";\nvar GOLD = \"#e2bd5a\";\nvar DRAGON = \"#b99be0\";\nvar TXT = TH.txt || \"#e4e6da\";\nvar MUTED = TH.muted || \"#878c7a\";\nvar RULE = TH.rule || \"#272d1f\";\nvar TRACK = TH.track || \"#1a1f14\";\nvar BG = TH.bg || \"#11130d\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\n\nfunction fmtDur(ms) { var m = Math.floor(ms / 60000); return m < 60 ? m + \"m\" : Math.floor(m / 60) + \"h \" + (m % 60) + \"m\"; }\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\nfunction thou(n) { var neg = n < 0; var s = String(Math.round(Math.abs(n))); var o = \"\"; while (s.length > 3) { o = \",\" + s.slice(-3) + o; s = s.slice(0, -3); } return (neg ? \"-\" : \"\") + s + o; }\nfunction ago(t) {\n  var s = Math.floor((Date.now() - t) / 1000);\n  if (s < 3600) { return Math.max(1, Math.round(s / 60)) + \"m ago\"; }\n  if (s < 86400) { return Math.round(s / 3600) + \"h ago\"; }\n  return Math.round(s / 86400) + \"d ago\";\n}\nfunction caps(t, c) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (c || DEEP) + ';font-size:11px;margin:0 0 3px;\">' + t + '</div>'; }\nfunction row(label, value, c) {\n  return '<div style=\"display:flex;justify-content:space-between;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"color:' + MUTED + ';white-space:nowrap;\">' + label + '</span><span style=\"color:' + (c || TXT) + ';white-space:nowrap;\">' + value + '</span></div>';\n}\nfunction box(inner, c) { return '<div style=\"flex:1 1 150px;min-width:150px;border-top:2px solid ' + (c || DEEP) + ';padding:3px 2px 0;\">' + inner + '</div>'; }\nfunction section(title, inner) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title, MOSS) + inner + '</div>'; }\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">' + t + '</div>'; }\nfunction byTime(x, y) { return y.ms - x.ms; }\n// Damage taken (#59): per combat second and the biggest hit, coloured\n// against HUNTSTATS TANK when max health is known; the hover says why.\nvar HSr = client.loom.huntstats;\nfunction dmgTxt(dmg, combatMs, maxHit) {\n  var dps = HSr.rate(dmg, combatMs);\n  if (dps === null) return null;\n  var tone = HSr.tankTone(dps);\n  var tip = tone ? ' title=\"' + thou(dps) + '/s taken in combat, ' + tone.word + ' (tank ' + HSr.tank + '% = ' + thou(tone.cap) + '/s)\"' : ' title=\"damage taken per second of combat\"';\n  return '<span style=\"color:' + (tone ? tone.colour : TXT) + ';\"' + tip + '>' + thou(dps) + '/s</span> <span style=\"color:' + MUTED + ';\">&middot; max ' + thou(maxHit) + '</span>';\n}\n\n// Dragonhood, when the level is known this connection and you aren't a dragon yet.\nvar dh = null;\ntry { dh = client.loom.huntstats.dragon(); } catch (e) { dh = null; }\nif (dh !== null && dh >= 100) dh = null;\n\n// An arrowhead over a sprig, the hunting tab's counterpart of the coin stack.\nvar glyph = '<svg width=\"18\" height=\"17\" viewBox=\"0 0 18 17\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<path d=\"M2 15 L12 5\" stroke=\"' + TXT + '\" stroke-width=\"1.2\"/><path d=\"M10 2 L16 2 L16 8 Z\" fill=\"' + MOSS + '\"/>' +\n  '<path d=\"M2 15 L1 12 M2 15 L5 16 M3.6 13.4 L2.4 10.6 M3.6 13.4 L6.4 14.6\" stroke=\"' + DEEP + '\" stroke-width=\"1\"/></svg>';\n\nvar arr = [];\nvar lt = { xp: 0, gold: 0, kills: 0, ms: 0, sessions: 0 };\nfor (var k in areas) {\n  if (areas.hasOwnProperty(k)) {\n    var a = areas[k];\n    var hrs = a.ms / 3600000;\n    arr.push({ area: k, xpHr: hrs > 0 ? Math.round(a.xp / hrs) : 0, goldHr: hrs > 0 ? Math.round(a.gold / hrs) : 0, sessions: a.sessions, ms: a.ms, dmg: dmgTxt(a.dmgIn, a.combatMs, a.maxHit || 0) });\n    lt.xp += a.xp || 0; lt.gold += a.gold || 0; lt.kills += a.kills || 0; lt.ms += a.ms || 0; lt.sessions += a.sessions || 0;\n  }\n}\narr.sort(byTime);\n\nvar html = '<div style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + BG + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;\">';\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\nhtml += '<div style=\"font-family:' + SERIF + ';color:' + MOSS + ';font-size:14px;letter-spacing:0.22em;\">' + glyph + 'HUNTING</div>';\nhtml += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + MUTED + ';font-size:11px;\">' + (dh !== null ? 'dragonhood <span style=\"color:' + DRAGON + ';\">' + dh.toFixed(2) + '%</span>' : arr.length + ' area' + (arr.length === 1 ? '' : 's')) + '</div></div>';\n\n// The hunt under way (#90): running from its first experience until it is\n// filed, or idle for 10 minutes (the same gap after which a resumed hunt is\n// filed instead). While it runs it heads the tab; otherwise the last\n// finished hunt does.\nvar C = null;\ntry { C = client.loom.huntstats.cur; } catch (e) { C = null; }\nvar live = !!(C && C.area !== undefined && C.firstXpAt && C.xp > 0 && (Date.now() - (C.lastXpAt || C.firstXpAt)) < 600000);\nfunction lifeBox() {\n  var hb = caps(\"Lifetime\", MOSS);\n  var lh = lt.ms / 3600000;\n  hb += row(\"time hunted\", fmtDur(lt.ms));\n  hb += row(\"hunts\", String(lt.sessions));\n  hb += row(\"xp / hr\", lh > 0 ? thou(lt.xp / lh) : \"&mdash;\", MOSS);\n  hb += row(\"gold / hr\", lh > 0 ? thou(lt.gold / lh) : \"&mdash;\", GOLD);\n  hb += row(\"kills\", thou(lt.kills));\n  return box(hb, DEEP);\n}\n\nif (live) {\n  var cMs = Math.max(1000, Date.now() - C.firstXpAt);\n  var cH = cMs / 3600000;\n  html += '<div style=\"margin:6px 0 1px;\"><span style=\"font-family:' + SERIF + ';font-size:26px;color:' + MOSS + ';\">' + thou(C.xp / cH) + '</span> ';\n  html += '<span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">xp/hour, this hunt</span></div>';\n  html += '<div style=\"color:' + MUTED + ';\">in <span style=\"font-family:' + SERIF + ';color:' + TXT + ';\">' + esc(C.area) + '</span> &middot; under way</div>';\n  var cb = caps(\"This hunt\", MOSS);\n  cb += row(\"time\", fmtDur(cMs));\n  cb += row(\"experience\", thou(C.xp));\n  cb += row(\"gold\", thou(C.gold || 0) + ' <span style=\"color:' + MUTED + ';\">(' + thou((C.gold || 0) / cH) + '/hr)</span>', GOLD);\n  cb += row(\"kills\", String(C.kills || 0) + ' <span style=\"color:' + MUTED + ';\">(' + Math.round((C.kills || 0) / cH) + '/hr)</span>');\n  var cD = HSr.damage(C.firstXpAt);\n  var cDt = cD ? dmgTxt(cD.dmg, cD.combatMs, cD.maxHit) : null;\n  if (cDt) cb += row(\"taken\", cDt);\n  var cP = [];\n  for (var cK in (C.players || {})) { if (C.players.hasOwnProperty(cK)) cP.push(cK); }\n  cb += row(\"party\", cP.length ? esc(cP.join(\", \")) : \"alone\");\n  if (dh !== null && C.startDragonPct !== null && C.startDragonPct !== undefined && dh - C.startDragonPct > 0) { cb += row(\"dragonhood\", '+' + (dh - C.startDragonPct).toFixed(3) + '%', DRAGON); }\n  html += '<div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;\">' + box(cb, MOSS) + lifeBox() + '</div>';\n}\n\nif (log.length === 0) {\n  if (!live) html += '<div style=\"margin-top:8px;\">' + quiet(\"No hunts logged yet. A hunt is filed when you leave the area, or with HUNTSTATS FLUSH; it needs a minute or more of experience to count.\") + '</div>';\n} else {\n  // Without a hunt under way, the headline is the most recent hunt's rate.\n  var L = log[0];\n  if (!live) {\n  html += '<div style=\"margin:6px 0 1px;\"><span style=\"font-family:' + SERIF + ';font-size:26px;color:' + MOSS + ';\">' + thou(L.xpHr) + '</span> ';\n  html += '<span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">xp/hour, last hunt</span></div>';\n  html += '<div style=\"color:' + MUTED + ';\">in <span style=\"font-family:' + SERIF + ';color:' + TXT + ';\">' + esc(L.area) + '</span>' + (L.at ? ' &middot; ' + ago(L.at) : '') + '</div>';\n\n  var cols = '<div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;\">';\n  var lb = caps(\"Last hunt\", MOSS);\n  lb += row(\"time\", fmtDur(L.ms));\n  lb += row(\"experience\", thou(L.xp));\n  lb += row(\"gold\", thou(L.gold) + ' <span style=\"color:' + MUTED + ';\">(' + thou(L.goldHr) + '/hr)</span>', GOLD);\n  lb += row(\"kills\", String(L.kills) + (L.ms > 0 ? ' <span style=\"color:' + MUTED + ';\">(' + Math.round(L.kills / (L.ms / 3600000)) + '/hr)</span>' : ''));\n  var lDt = L.combatMs ? dmgTxt(L.dmgIn, L.combatMs, L.maxHit) : null;\n  if (lDt) lb += row(\"taken\", lDt);\n  if (L.dGain !== null && L.dGain !== undefined && L.dGain !== 0) { lb += row(\"dragonhood\", '+' + L.dGain.toFixed(3) + '%', DRAGON); }\n  cols += box(lb, MOSS);\n  cols += lifeBox();\n  html += cols + '</div>';\n  }\n\n  // Recent hunts, newest first, each as a two-line ledger entry.\n  var rs = \"\";\n  for (var i = 0; i < log.length; i++) {\n    var s = log[i];\n    rs += '<div style=\"border-bottom:1px dotted ' + RULE + ';padding:2px 0 3px;\">';\n    rs += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:6px;\"><span style=\"font-family:' + SERIF + ';color:' + TXT + ';font-size:11px;\">' + esc(s.area) + '</span>';\n    rs += '<span style=\"color:' + MUTED + ';white-space:nowrap;\">' + fmtDur(s.ms) + (s.at ? ' &middot; ' + ago(s.at) : '') + '</span></div>';\n    rs += '<div style=\"color:' + MUTED + ';\"><span style=\"color:' + MOSS + ';\">' + thou(s.xpHr) + '</span> xp/hr &middot; <span style=\"color:' + GOLD + ';\">' + thou(s.gold) + '</span> gold &middot; ' + s.kills + ' kills';\n    if (s.dGain !== null && s.dGain !== undefined && s.dGain !== 0) { rs += ' &middot; <span style=\"color:' + DRAGON + ';\">+' + s.dGain.toFixed(3) + '%</span>'; }\n    rs += '</div>';\n    if (s.players && s.players.length) { rs += '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">with ' + esc(s.players.join(\", \")) + '</div>'; }\n    rs += '</div>';\n  }\n  html += section(\"Recent hunts\", rs);\n}\n\n// Areas, by total time; each bar is its xp/hr against the best area.\nvar ar = \"\";\nif (arr.length === 0) {\n  ar = quiet(\"No area history yet.\");\n} else {\n  var best = 0;\n  for (var j = 0; j < arr.length; j++) { if (arr[j].xpHr > best) { best = arr[j].xpHr; } }\n  for (var j2 = 0; j2 < arr.length; j2++) {\n    var r = arr[j2];\n    var top = (r.xpHr === best && arr.length > 1);\n    var pct = best > 0 ? Math.round(r.xpHr / best * 100) : 0;\n    ar += '<div style=\"margin:0 0 5px;\">';\n    ar += '<div style=\"display:flex;justify-content:space-between;gap:6px;\"><span style=\"color:' + TXT + ';\">' + esc(r.area) + (top ? ' <span style=\"color:' + MOSS + ';\" title=\"best xp/hr\">&#9733;</span>' : '') + '</span>';\n    ar += '<span style=\"color:' + MOSS + ';white-space:nowrap;\">' + thou(r.xpHr) + ' <span style=\"color:' + MUTED + ';\">xp/hr</span></span></div>';\n    ar += '<div style=\"background:' + TRACK + ';height:5px;margin:2px 0 1px;\"><div style=\"background:' + (top ? MOSS : DEEP) + ';height:5px;width:' + pct + '%;\"></div></div>';\n    ar += '<div style=\"color:' + MUTED + ';\"><span style=\"color:' + GOLD + ';\">' + thou(r.goldHr) + '</span> gold/hr &middot; ' + r.sessions + ' hunt' + (r.sessions === 1 ? '' : 's') + ' &middot; ' + fmtDur(r.ms) + '</div>' + (r.dmg ? '<div style=\"color:' + MUTED + ';\">takes ' + r.dmg + '</div>' : '');\n    ar += '</div>';\n  }\n}\nhtml += section(\"Areas, by time spent\", ar);\nhtml += '</div>';\n\ntry { set_custom_tab_html(\"Stats\", html); } catch (e) {}"
  },
  {
   "type": "function",
   "name": "huntstats_status",
   "enabled": true,
   "code": "// huntstats_status -- the bare HUNTSTATS view: the hunt under way, with\n// rates, time to the next level and Dragonhood.\nvar HS = client.loom.huntstats;\nvar T = HS.cur;\nfunction say(t, c) { display_notice(\"[huntstats] \" + t, c || \"cyan\"); }\n\nif (!T || T.area === undefined) {\n  say(\"waiting for room data...\", \"cyan\");\n} else if (!T.firstXpAt) {\n  say(T.area + \" - no kills yet this hunt\", \"cyan\");\n} else {\n  var ms = Date.now() - T.firstXpAt;\n  var hrs = ms / 3600000;\n  var xpHr = hrs > 0 ? Math.round(T.xp / hrs) : 0;\n  var goldHr = hrs > 0 ? Math.round(T.gold / hrs) : 0;\n  say(T.area + \" - \" + HS.dur(ms));\n  say(\"xp:    \" + T.xp.toLocaleString() + \"  (\" + xpHr.toLocaleString() + \"/hr)\");\n  say(\"gold:  \" + T.gold.toLocaleString() + \"  (\" + goldHr.toLocaleString() + \"/hr)\");\n  say(\"kills: \" + (T.kills || 0));\n\n  var toNext = HS.xpToNext();\n  if (toNext !== null && xpHr > 0) {\n    var mNext = Math.round(toNext / xpHr * 60);\n    say(\"level \" + (Math.floor(HS.level) + 1) + \" in ~\" + Math.floor(mNext / 60) + \"h \" + (mNext % 60) + \"m\");\n  }\n  var dh = HS.dragon();\n  if (dh !== null && dh < 100) {\n    var gained = (T.startDragonPct !== null && T.startDragonPct !== undefined) ? \"  (\" + ((dh - T.startDragonPct) < 0 ? \"\" : \"+\") + (dh - T.startDragonPct).toFixed(3) + \"% this hunt)\" : \"\";\n    say(\"Dragonhood: \" + dh.toFixed(2) + \"%\" + gained);\n    var toDragon = HS.xpToDragon();\n    if (toDragon !== null && xpHr > 0) {\n      var mDragon = Math.round(toDragon / xpHr * 60);\n      say(\"Dragonhood ETA: ~\" + Math.floor(mDragon / 60) + \"h \" + (mDragon % 60) + \"m\");\n    }\n  }\n}\n// Who this hunt is with (#87): the hunt's players, which include anyone\n// added during it.\nif (T) {\n  var stP = [];\n  for (var stK in (T.players || {})) { if (T.players.hasOwnProperty(stK)) stP.push(stK); }\n  say(stP.length ? \"party: \" + stP.join(\", \") : \"hunting alone (HUNTSTATS PARTY ADD <name> to add someone)\");\n}\n"
  },
  {
   "type": "function",
   "name": "huntstats_help",
   "enabled": true,
   "code": "// huntstats_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[huntstats] per-area hunting records: xp, gold and kills an hour, Dragonhood. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"HUNTSTATS\", \"the hunt under way: rates, next level, Dragonhood\"],\n  [\"HUNTSTATS AREAS\", \"every area hunted, by total time, with its rates and the damage it deals\"],\n  [\"HUNTSTATS TANK [percent]\", \"how much of your max health a second you can heal back (default 3); colours the damage areas deal\"],\n  [\"HUNTSTATS LOG\", \"the last five hunts\"],\n  [\"HUNTSTATS SUGGEST\", \"the ten best areas to hunt next, by xp/hr, gold/hr and how long since you went\"],\n  [\"HUNTSTATS SUGGEST WEIGHTS <x> <g> <v>\", \"how much xp, gold and variety count (default 70 25 5)\"],\n  [\"HUNTSTATS FLUSH\", \"file the hunt under way now\"],\n  [\"HUNTSTATS PARTY\", \"who you're hunting with\"],\n  [\"HUNTSTATS PARTY ADD <names>\", \"add people to the party (kept until removed)\"],\n  [\"HUNTSTATS PARTY DEL <names>\", \"remove people from the party\"],\n  [\"HUNTSTATS PARTY CLEAR\", \"back to hunting alone\"],\n  [\"HUNTSTATS SPLIT\", \"the party's gold so far and the transfers that even it out\"],\n  [\"HUNTSTATS SPLIT REPORT\", \"send the split to party tell now, one line per person\"],\n  [\"HUNTSTATS SPLIT TELL ON|OFF\", \"also send it to party tell when a party hunt ends (default off)\"],\n  [\"HUNTSTATS WIPE CONFIRM\", \"clear all area records and the log\"],\n  [\"HUNTSTATS DEBUG\", \"internal state\"],\n  [\"A hunt is filed when you leave its area, and needs a minute or more of experience. A party hunt's gold split is shown then.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// HUNTSTATS [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.huntstats || !client.loom.huntstats.xpTable) run_function(\"huntstats_setup\", [], \"huntstats\");\nvar HS = client.loom.huntstats;\nvar hsW = String(args[1] || \"\").trim().toLowerCase().split(/\\s+/);\nvar hsSub = hsW[0];\nvar hsP1 = hsW[1] || \"\";\nfunction hsSay(t, col) { display_notice(\"[huntstats] \" + t, col || \"cyan\"); }\n\nif (hsSub === \"\" || hsSub === \"status\") {\n  run_function(\"huntstats_status\", [], \"huntstats\");\n} else if (hsSub === \"help\") {\n  run_function(\"huntstats_help\", [], \"huntstats\");\n} else if (hsSub === \"areas\") {\n  var areas = {};\n  try { areas = JSON.parse(get_variable(\"huntstats_areas\")) || {}; } catch (e) { areas = {}; }\n  var arr = [];\n  for (var k in areas) {\n    if (areas.hasOwnProperty(k)) {\n      var a = areas[k]; var hrs = a.ms / 3600000;\n      arr.push({ area: k, xpHr: hrs > 0 ? Math.round(a.xp / hrs) : 0, goldHr: hrs > 0 ? Math.round(a.gold / hrs) : 0, sessions: a.sessions, ms: a.ms, dps: HS.rate(a.dmgIn, a.combatMs), maxHit: a.maxHit || 0 });\n    }\n  }\n  if (arr.length === 0) { hsSay(\"no area history yet\", \"cyan\"); }\n  else {\n    arr.sort(function (x, y) { return y.ms - x.ms; });\n    hsSay(\"areas by total time (lifetime):\", \"cyan\");\n    // Damage taken per combat second and the biggest hit (#59), coloured\n    // against HUNTSTATS TANK when the page can print coloured lines and\n    // your max health is known.\n    var arHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\n    function arEsc(t) { return String(t).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\n    for (var j = 0; j < arr.length; j++) {\n      var r = arr[j];\n      var arLine = \"  \" + r.area + \" - \" + r.xpHr.toLocaleString() + \" xp/hr, \" + r.goldHr.toLocaleString() + \" gold/hr (\" + r.sessions + \" hunt\" + (r.sessions === 1 ? \"\" : \"s\") + \", \" + HS.dur(r.ms) + \")\";\n      var arDmg = r.dps !== null ? \"takes \" + Math.round(r.dps).toLocaleString() + \"/s, max hit \" + r.maxHit.toLocaleString() : \"\";\n      var arTone = HS.tankTone(r.dps);\n      if (arHtml && arDmg) nexusclient.add_html_line('<span style=\"color:#c0c0c0\">' + arEsc(arLine) + ', </span><span style=\"color:' + (arTone ? arTone.colour : \"#c0c0c0\") + '\">' + arEsc(arDmg) + '</span>');\n      else display_notice(arLine + (arDmg ? \", \" + arDmg : \"\"));\n    }\n  }\n} else if (hsSub === \"tank\") {\n  // HUNTSTATS TANK [percent] (#59): how much of your max health per second\n  // you can heal back. Areas that hit harder than half of it show yellow,\n  // harder than all of it red.\n  var tkCap = function () { return HS.maxhp ? \" (\" + Math.round(HS.tank / 100 * HS.maxhp).toLocaleString() + \" health/s at your \" + HS.maxhp.toLocaleString() + \" max health)\" : \"\"; };\n  if (hsP1 === \"\") {\n    hsSay(\"tank: \" + HS.tank + \"% of max health a second\" + tkCap() + \". Areas that hit for under half of it show green, up to it yellow, more red. HUNTSTATS TANK <percent> to change it.\", \"cyan\");\n  } else {\n    var tkV = parseFloat(hsP1);\n    if (isNaN(tkV) || tkV <= 0 || tkV > 100) {\n      hsSay(\"usage: HUNTSTATS TANK <percent>, the share of your max health you can heal back each second (default 3).\", \"orange\");\n    } else {\n      HS.tank = tkV;\n      set_variable(\"huntstats_tank\", String(tkV));\n      hsSay(\"tank set: \" + tkV + \"% of max health a second\" + tkCap() + \".\", \"lime\");\n      run_function(\"huntstats_render\", [], \"huntstats\");\n    }\n  }\n} else if (hsSub === \"suggest\") {\n  // HUNTSTATS SUGGEST [WEIGHTS <xp> <gold> <variety>] (#88): where to hunt\n  // next. Each area's xp/hr and gold/hr are scaled against your best area,\n  // plus a variety bonus that grows to full over 7 days since you last hunted\n  // there (areas from before this was recorded count as long ago). The\n  // weights say how much each counts. xp/hr holds whatever your level, so old\n  // records stay valid and time spent somewhere doesn't count.\n  if (hsP1 === \"weights\") {\n    var hsWa = [parseFloat(hsW[2]), parseFloat(hsW[3]), parseFloat(hsW[4])];\n    if (hsW.length < 3) {\n      hsSay(\"weights: xp \" + HS.weights[0] + \", gold \" + HS.weights[1] + \", variety \" + HS.weights[2] + \". HUNTSTATS SUGGEST WEIGHTS <xp> <gold> <variety> to change them.\", \"cyan\");\n    } else if (isNaN(hsWa[0]) || isNaN(hsWa[1]) || isNaN(hsWa[2]) || hsWa[0] < 0 || hsWa[1] < 0 || hsWa[2] < 0 || hsWa[0] + hsWa[1] + hsWa[2] <= 0) {\n      hsSay(\"usage: HUNTSTATS SUGGEST WEIGHTS <xp> <gold> <variety>, three numbers not all zero (default 70 25 5)\", \"orange\");\n    } else {\n      HS.weights = hsWa;\n      set_variable(\"huntstats_weights\", hsWa.join(\" \"));\n      hsSay(\"weights set: xp \" + hsWa[0] + \", gold \" + hsWa[1] + \", variety \" + hsWa[2] + \".\", \"lime\");\n    }\n  } else {\n    var sgA = {};\n    try { sgA = JSON.parse(get_variable(\"huntstats_areas\")) || {}; } catch (e) { sgA = {}; }\n    var sgL = [], sgBx = 0, sgBg = 0;\n    for (var sgK in sgA) {\n      if (!sgA.hasOwnProperty(sgK)) continue;\n      var sgR = sgA[sgK], sgH = sgR.ms / 3600000;\n      if (!(sgH > 0)) continue;\n      var sgE = { area: sgK, xp: sgR.xp / sgH, gold: sgR.gold / sgH, last: sgR.last || 0 };\n      sgL.push(sgE);\n      if (sgE.xp > sgBx) sgBx = sgE.xp;\n      if (sgE.gold > sgBg) sgBg = sgE.gold;\n    }\n    if (!sgL.length) {\n      hsSay(\"no area history yet: hunt a few areas first.\", \"cyan\");\n    } else {\n      var sgW = HS.weights, sgT = sgW[0] + sgW[1] + sgW[2];\n      for (var sgI = 0; sgI < sgL.length; sgI++) {\n        var sgX = sgL[sgI];\n        var sgDays = sgX.last ? (Date.now() - sgX.last) / 86400000 : 7;\n        sgX.days = sgX.last ? sgDays : null;\n        sgX.score = 100 * (sgW[0] * (sgBx > 0 ? sgX.xp / sgBx : 0) + sgW[1] * (sgBg > 0 ? sgX.gold / sgBg : 0) + sgW[2] * Math.min(sgDays, 7) / 7) / sgT;\n      }\n      sgL.sort(function (p, q) { return q.score - p.score; });\n      var sgN = Math.min(10, sgL.length);\n      hsSay(\"where to hunt next (xp \" + sgW[0] + \", gold \" + sgW[1] + \", variety \" + sgW[2] + \"):\", \"cyan\");\n      var sgHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\n      var sgRows = [];\n      var sgWid = 0;\n      for (var sgM = 0; sgM < sgN; sgM++) sgWid = Math.max(sgWid, sgL[sgM].area.length);\n      for (var sgJ = 0; sgJ < sgN; sgJ++) {\n        var sgY = sgL[sgJ];\n        var sgWhen = sgY.days === null ? \"\" : (sgY.days < 1 ? \"today\" : Math.floor(sgY.days) + \"d ago\");\n        var sgName = sgY.area + new Array(sgWid - sgY.area.length + 3).join(\" \");\n        var sgTxt = (\"   \" + (sgJ + 1) + \". \").slice(-5) + sgName + (\"   \" + Math.round(sgY.score)).slice(-3) + \"   \" + (HS.n(sgY.xp) + \" xp/hr\").padStart(14) + \"  \" + (HS.n(sgY.gold) + \" gold/hr\").padStart(15) + (sgWhen ? \"  last \" + sgWhen : \"\");\n        if (sgHtml) sgRows.push('<span style=\"color:' + (sgJ === 0 ? \"#00ffff\" : \"#9fc9c9\") + '\">' + sgTxt.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\") + '</span>');\n        else display_notice(sgTxt, \"cyan\");\n      }\n      if (sgHtml) nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + sgRows.join(\"\\n\") + '</span>');\n    }\n  }\n} else if (hsSub === \"log\") {\n  var log = [];\n  try { log = JSON.parse(get_variable(\"huntstats_log\")) || []; } catch (e) { log = []; }\n  if (log.length === 0) { hsSay(\"no hunts logged yet\", \"cyan\"); }\n  else {\n    hsSay(\"last \" + log.length + \" hunt\" + (log.length === 1 ? \"\" : \"s\") + \":\", \"cyan\");\n    for (var i = 0; i < log.length; i++) {\n      var s = log[i];\n      var pl = (s.players && s.players.length) ? (\"  party: \" + s.players.join(\", \")) : \"\";\n      var dg = (s.dGain !== null && s.dGain !== undefined && s.dGain !== 0) ? (\"  \" + (s.dGain < 0 ? \"\" : \"+\") + s.dGain.toFixed(3) + \"% dragon\") : \"\";\n      display_notice(\"  \" + s.area + \" - \" + HS.dur(s.ms) + \", \" + s.xp.toLocaleString() + \" xp (\" + s.xpHr.toLocaleString() + \"/hr), \" + s.gold.toLocaleString() + \" gold, \" + s.kills + \" kills\" + (s.combatMs ? \", took \" + Math.round(HS.rate(s.dmgIn, s.combatMs)).toLocaleString() + \"/s (max hit \" + s.maxHit.toLocaleString() + \")\" : \"\") + dg + pl);\n    }\n  }\n} else if (hsSub === \"flush\") {\n  var hsHad = HS.cur && HS.cur.firstXpAt && HS.cur.xp > 0;\n  var hsLong = hsHad && (HS.cur.lastXpAt - HS.cur.firstXpAt) >= 60000;\n  run_function(\"huntstats_finalize\", [], \"huntstats\");\n  if (hsLong) hsSay(\"hunt filed\", \"lime\");\n  else if (hsHad) hsSay(\"under a minute of experience, so nothing was filed; counters reset.\", \"cyan\");\n  else hsSay(\"no hunt under way.\", \"orange\");\n} else if (hsSub === \"wipe\") {\n  if (hsP1 === \"confirm\") {\n    set_variable(\"huntstats_areas\", \"{}\");\n    set_variable(\"huntstats_log\", \"[]\");\n    run_function(\"huntstats_render\", [], \"huntstats\");\n    hsSay(\"all area records and the log wiped\", \"orange\");\n  } else {\n    hsSay(\"this clears ALL area records and the hunt log. HUNTSTATS WIPE CONFIRM to proceed.\", \"orange\");\n  }\n} else if (hsSub === \"split\") {\n  // HUNTSTATS SPLIT [REPORT | TELL ON|OFF] (#89): the gold split of the hunt\n  // under way; REPORT sends it to party tell now.\n  if (hsP1 === \"report\") {\n    if (!HS.split(true)) hsSay(\"nothing to report: no party or no gold this hunt.\", \"orange\");\n    else if (!HS.tellSplit()) hsSay(\"not sent: outgoing commands are paused.\", \"orange\");\n    else hsSay(\"split sent to party tell.\", \"lime\");\n  } else if (hsP1 === \"tell\") {\n    var hsT = hsW[2] || \"\";\n    if (hsT === \"on\" || hsT === \"off\") {\n      HS.splitTell = (hsT === \"on\");\n      set_variable(\"huntstats_splittell\", hsT);\n      hsSay(\"the split at the end of a party hunt \" + (HS.splitTell ? \"also goes to party tell\" : \"stays in your window\") + \".\", \"lime\");\n    } else {\n      hsSay(\"the split \" + (HS.splitTell ? \"goes to party tell too\" : \"stays in your window\") + \". HUNTSTATS SPLIT TELL ON or OFF to change it.\", \"cyan\");\n    }\n  } else {\n    var hsSp = HS.split();\n    if (!hsSp) hsSay(HS.cur && HS.cur.players && Object.keys(HS.cur.players).length ? \"no gold picked up by the party this hunt yet.\" : \"no party this hunt: HUNTSTATS PARTY ADD <name> first.\", \"cyan\");\n    else for (var hsSI = 0; hsSI < hsSp.length; hsSI++) hsSay(hsSp[hsSI], \"cyan\");\n  }\n} else if (hsSub === \"party\") {\n  // HUNTSTATS PARTY [ADD <names> | DEL <names> | CLEAR] (#87): who you're\n  // hunting with, by hand. Names take a capital letter whatever was typed.\n  var hsNames = [];\n  for (var hsK = 2; hsK < hsW.length; hsK++) {\n    var hsNm = hsW[hsK].replace(/,/g, \"\");\n    if (hsNm) hsNames.push(hsNm.charAt(0).toUpperCase() + hsNm.slice(1));\n  }\n  var hsBad = [];\n  for (var hsB = 0; hsB < hsNames.length; hsB++) { if (!/^[A-Z][a-z]+$/.test(hsNames[hsB])) hsBad.push(hsNames[hsB]); }\n  if (hsP1 === \"\" || hsP1 === \"list\") {\n    hsSay(HS.party.length ? \"party: \" + HS.party.join(\", \") + \". HUNTSTATS PARTY ADD/DEL <name> or CLEAR to change it.\" : \"no party: you're hunting alone. HUNTSTATS PARTY ADD <name> to add someone.\", \"cyan\");\n  } else if ((hsP1 === \"add\" || hsP1 === \"del\" || hsP1 === \"remove\") && hsNames.length === 0) {\n    hsSay(\"usage: HUNTSTATS PARTY \" + (hsP1 === \"add\" ? \"ADD\" : \"DEL\") + \" <name> [<name> ...]\", \"orange\");\n  } else if ((hsP1 === \"add\" || hsP1 === \"del\" || hsP1 === \"remove\") && hsBad.length) {\n    hsSay(\"not a name: \" + hsBad.join(\", \") + \" (letters only)\", \"orange\");\n  } else if (hsP1 === \"add\") {\n    var hsAdded = [];\n    for (var hsA1 = 0; hsA1 < hsNames.length; hsA1++) {\n      if (HS.party.indexOf(hsNames[hsA1]) < 0) { HS.party.push(hsNames[hsA1]); hsAdded.push(hsNames[hsA1]); }\n      if (HS.cur) { if (!HS.cur.players) HS.cur.players = {}; HS.cur.players[hsNames[hsA1]] = 1; }\n    }\n    HS.saveParty();\n    if (HS.cur) HS.save(true);\n    hsSay(hsAdded.length ? \"added \" + hsAdded.join(\", \") + \". Party: \" + HS.party.join(\", \") + \".\" : \"already in the party: \" + hsNames.join(\", \") + \".\", hsAdded.length ? \"lime\" : \"cyan\");\n  } else if (hsP1 === \"del\" || hsP1 === \"remove\") {\n    var hsGone = [], hsMissing = [];\n    for (var hsD = 0; hsD < hsNames.length; hsD++) {\n      var hsAt = HS.party.indexOf(hsNames[hsD]);\n      if (hsAt >= 0) { HS.party.splice(hsAt, 1); hsGone.push(hsNames[hsD]); } else { hsMissing.push(hsNames[hsD]); }\n      if (HS.cur && HS.cur.players) delete HS.cur.players[hsNames[hsD]];\n    }\n    HS.saveParty();\n    if (HS.cur) HS.save(true);\n    if (hsGone.length) hsSay(\"removed \" + hsGone.join(\", \") + \". \" + (HS.party.length ? \"Party: \" + HS.party.join(\", \") + \".\" : \"No party now.\"), \"lime\");\n    if (hsMissing.length) hsSay(\"not in the party: \" + hsMissing.join(\", \") + \".\", \"orange\");\n  } else if (hsP1 === \"clear\") {\n    HS.party = [];\n    HS.saveParty();\n    if (HS.cur) { HS.cur.players = {}; HS.save(true); }\n    hsSay(\"party cleared: you're hunting alone.\", \"lime\");\n  } else {\n    hsSay(\"usage: HUNTSTATS PARTY [ADD <name> | DEL <name> | CLEAR]\", \"orange\");\n  }\n  if (hsP1 !== \"\" && hsP1 !== \"list\") run_function(\"huntstats_render\", [], \"huntstats\");\n} else if (hsSub === \"debug\") {\n  var T = HS.cur || {};\n  hsSay(\"level=\" + HS.level + \" nl=\" + HS.nl + \" dragon=\" + (HS.dragon() === null ? \"?\" : HS.dragon().toFixed(3)) + \" resumed=\" + !!HS.resumed);\n  hsSay(\"area=\" + T.area + \" xp=\" + T.xp + \" gold=\" + T.gold + \" kills=\" + T.kills + \" firstXpAt=\" + T.firstXpAt + \" lastXpAt=\" + T.lastXpAt + \" players=\" + Object.keys(T.players || {}).join(\",\") + \" party=\" + HS.party.join(\",\") + \" me=\" + (HS.me || \"?\"));\n} else {\n  hsSay(\"unknown command '\" + hsSub + \"'. HUNTSTATS HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^huntstats(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"You have gained <n> experience.\" -- the hunt starts with the first one.\nvar HS = client.loom && client.loom.huntstats;\nif (HS && HS.cur && HS.cur.area !== undefined) {\n  var hsG = parseInt(args[1], 10);\n  if (!isNaN(hsG)) {\n    if (!HS.cur.firstXpAt) {\n      HS.cur.firstXpAt = Date.now();\n      HS.cur.startDragonPct = HS.dragon();\n      // A hunt has started: tell loom (#39, a gold goal to beat).\n      if (client.loom.notify) client.loom.notify(\"huntstats\");\n    }\n    HS.cur.xp += hsG;\n    HS.cur.lastXpAt = Date.now();\n    HS.save(false);\n    // The hunt under way heads the Stats tab (#90).\n    run_function(\"huntstats_render\", [], \"huntstats\");\n  }\n}\n"
    }
   ],
   "text": "^You have gained (\\d+) experience\\.",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"You pick up <n> gold sovereigns.\" Counts for the hunt's gold an hour, and\n// as gold in your hands for the party split (#89).\nvar HS = client.loom && client.loom.huntstats;\nif (HS && HS.cur && HS.cur.area !== undefined) {\n  var hsG = parseInt(String(args[1]).replace(/,/g, \"\"), 10);\n  if (!isNaN(hsG)) {\n    HS.cur.gold += hsG;\n    if (HS.held) HS.held(\"you\", hsG);\n    run_function(\"huntstats_render\", [], \"huntstats\");\n  }\n}\n"
    }
   ],
   "text": "^You pick up ([\\d,]+) gold sovereigns?\\.",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "huntstats party gold",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Gold changing hands, for the party split (#89):\n//   \"Xylarys picks up 50 gold sovereigns.\"         -> pick\n//   \"You drop 50 gold sovereigns.\" / \"X drops ...\" -> drop\n//   \"Grulk gives 20 gold sovereigns to you.\"       -> give (also \"You give N\n//   ... to X\"; between two others the game says \"some\", with no amount)\n// Only the hunt's own people count (you and the party).\nif (!client.loom || !client.loom.huntstats || !client.loom.huntstats.xpTable) run_function(\"huntstats_setup\", [], \"huntstats\");\nvar HS = client.loom.huntstats;\nvar gpLine = String(args[0]);\nvar gpM;\nfunction gpWho(w) { return w === \"You\" || w === \"you\" ? \"you\" : w; }\nfunction gpAmt(a) { return parseInt(String(a).replace(/,/g, \"\"), 10); }\nif ((gpM = gpLine.match(/^([A-Z][a-z]+) picks up ([\\d,]+) gold sovereigns?\\.$/))) {\n  HS.held(gpWho(gpM[1]), gpAmt(gpM[2]));\n} else if ((gpM = gpLine.match(/^(You|[A-Z][a-z]+) drops? ([\\d,]+) gold sovereigns?\\.$/))) {\n  HS.held(gpWho(gpM[1]), -gpAmt(gpM[2]));\n} else if ((gpM = gpLine.match(/^(You|[A-Z][a-z]+) gives? ([\\d,]+|some) gold sovereigns? to (you|[A-Z][a-z]+)\\.$/))) {\n  var gpFrom = gpWho(gpM[1]), gpTo = gpWho(gpM[3]);\n  if (gpM[2] === \"some\") {\n    if (HS.cur && HS.cur.area !== undefined && HS.inHunt(gpFrom) && HS.inHunt(gpTo)) {\n      if (!HS.cur.unknown) HS.cur.unknown = [];\n      HS.cur.unknown.push(gpFrom + \" to \" + gpTo);\n      HS.save();\n    }\n  } else {\n    HS.held(gpFrom, -gpAmt(gpM[2]));\n    HS.held(gpTo, gpAmt(gpM[2]));\n  }\n}\n"
    }
   ],
   "text": "^(?:[A-Z][a-z]+ picks up|You drop|[A-Z][a-z]+ drops|You give|[A-Z][a-z]+ gives) (?:[\\d,]+|some) gold sovereigns?(?: to (?:you|[A-Z][a-z]+))?\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"You have slain ...\"\nvar HS = client.loom && client.loom.huntstats;\nif (HS && HS.cur && HS.cur.area !== undefined) {\n  HS.cur.kills = (HS.cur.kills || 0) + 1;\n  HS.cur.lastXpAt = Date.now();\n}\n"
    }
   ],
   "text": "^You have slain ",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"Level: <n> (<p>%)\" in game output, such as SCORE: the precise figure,\n// between the whole-percent GMCP updates.\nif (!client.loom || !client.loom.huntstats || !client.loom.huntstats.xpTable) run_function(\"huntstats_setup\", [], \"huntstats\");\nvar HS = client.loom.huntstats;\nvar hsL = parseInt(args[1], 10);\nvar hsP = parseFloat(args[2]);\nif (!isNaN(hsL)) HS.level = hsL;\nif (!isNaN(hsP)) HS.nl = hsP;\n"
    }
   ],
   "text": "Level\\s*:\\s*(\\d+)\\s*\\(([\\d.]+)%\\)",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  }
 ],
 "description": "Per-area hunting records: xp, gold and kills an hour, Dragonhood"
}