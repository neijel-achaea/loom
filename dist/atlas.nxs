{
 "type": "group",
 "name": "atlas",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"atlas_setup\", [], \"atlas\");\nclient.loom.atlas.load(false);\ndisplay_notice(\"[atlas] installed. Create a UI tab named 'Atlas'; the community map downloads once and then comes from this browser's cache. ATLAS HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// The atlas_* variables and the map cached in this browser are left intact.\n// Leave LOOM and the integrations at once, not at the next load (#137).\nif (client.loom && client.loom.atlas && client.loom.atlas.drawT) { clearTimeout(client.loom.atlas.drawT); client.loom.atlas.drawT = null; }\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"atlas\");\n  else delete client.loom.registry.atlas;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it. A folded map.\nvar tiTabs = [[\"Atlas\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\"><path d=\"M1.5 3.2 L5.5 1.8 L10.5 3.6 L14.5 2.2 V12.8 L10.5 14.2 L5.5 12.4 L1.5 13.8 Z\" fill=\"#2b2620\" stroke=\"#c8bfae\" stroke-width=\"1\" stroke-linejoin=\"round\"/><path d=\"M5.5 1.8 V12.4 M10.5 3.6 V14.2\" stroke=\"#7a5f33\" stroke-width=\"0.9\"/><circle cx=\"8\" cy=\"7.6\" r=\"1.6\" fill=\"none\" stroke=\"#e0b46c\" stroke-width=\"1\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\nrun_function(\"atlas_setup\", [], \"atlas\");\nif (!client.loom.atlas.map) client.loom.atlas.load(false);\nrun_function(\"atlas_render\", { full: true }, \"atlas\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Atlas follows the room you're in, and reads the explored rooms the game\n// sends with Room.Info when you enter an area.\nif (!client.loom || !client.loom.atlas || !client.loom.atlas.look) run_function(\"atlas_setup\", [], \"atlas\");\nif (args.gmcp_method == \"Room.Info\") {\n  var atG = (args.gmcp_args && typeof args.gmcp_args == \"object\") ? args.gmcp_args : {};\n  client.loom.atlas.roomInfo(atG);\n}\n"
  },
  {
   "type": "function",
   "name": "atlas_setup",
   "enabled": true,
   "code": "// atlas_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Atlas (#451): a map of our own, drawn from the\n// community-maintained Achaea crowdmap (the map Mudlet's IRE mapper uses),\n// with the game's own record of the rooms you've explored as fog of war.\n//\n// Where things come from:\n//   - the map: https://ire-mudlet-mapping.github.io/AchaeaCrowdmap/Map/\n//     (mapExport.json, colors.json, version.txt). Downloaded only, never\n//     sent anything; kept in this browser's IndexedDB and downloaded again\n//     only when version.txt changes (or ATLAS RELOAD).\n//   - where you are: GMCP Room.Info (num; coords \"areaid,x,y,z\").\n//   - what you've explored: Room.Info's `explored`, the ids of every room\n//     you've explored in an area, sent when you enter the area; Nexus keeps\n//     the same lists in GMCP.Explored, read once at load for the areas\n//     entered before Atlas was.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.atlas) client.loom.atlas = {};\nclient.loom.registry.atlas = { version: \"0.1.1\", keyword: \"ATLAS\", desc: \"A map tab from the community crowdmap, with the rooms you've explored as fog\",\n  redraw: function () { run_function(\"atlas_render\", { full: true }, \"atlas\"); } };\nvar AT = client.loom.atlas;\n\nAT.base = \"https://ire-mudlet-mapping.github.io/AchaeaCrowdmap/Map/\";\n// Saved: atlas_fog = \"off\" while fog of war is off (absent: on).\nAT.fog = get_variable(\"atlas_fog\") !== \"off\";\n// Kept across a rerun of setup (a reimport): the map in memory, where you\n// are, the explored lists, the view.\nif (AT.map === undefined) AT.map = null;\nif (!AT.state) AT.state = \"idle\";          // idle | loading | ready | failed\nif (AT.note === undefined) AT.note = \"\";\nif (AT.here === undefined) AT.here = null;\nif (!AT.explored || typeof AT.explored != \"object\") AT.explored = {};\nif (!AT.view || typeof AT.view != \"object\") AT.view = { area: null, z: 0, cx: 0, cy: 0, span: 18 };\nAT.spanMin = 6;\nAT.spanMax = 160;\n\nfunction atNum(v) { var n = parseInt(v, 10); return isFinite(n) ? n : 0; }\nfunction atFloat(v) { var n = Number(v); return isFinite(n) ? n : 0; }\n\n// ---- The map ---------------------------------------------------------\n// In memory and in the cache, the crowdmap is kept compact:\n//   { v: version, at: ms, areas: { id: name },\n//     rooms: { id: [area, x, y, z, name, env, exits, specials] },\n//     env: { envId: [r, g, b] } }\n// exits = { direction: room id }; specials = { command: room id } or 0.\n// Everything from the download is treated as data and checked as it's\n// copied: ids are positive whole numbers, names are strings, capped.\nAT.compact = function (src, colors, v) {\n  if (!Array.isArray(src)) return null;\n  var out = { v: String(v || \"\"), at: Date.now(), areas: {}, rooms: {}, env: {}, n: 0 };\n  for (var i = 0; i < src.length; i++) {\n    var A = src[i];\n    if (!A || typeof A != \"object\") continue;\n    var aid = atNum(A.areaId);\n    if (!(aid > 0)) continue;\n    out.areas[aid] = String(A.areaName || (\"area \" + aid)).slice(0, 80);\n    var rs = Array.isArray(A.rooms) ? A.rooms : [];\n    for (var j = 0; j < rs.length; j++) {\n      var r = rs[j];\n      if (!r || typeof r != \"object\") continue;\n      var id = atNum(r.id);\n      if (!(id > 0)) continue;\n      var ex = {}, sp = 0, d, t;\n      if (r.exits && typeof r.exits == \"object\") for (d in r.exits) {\n        if (!r.exits.hasOwnProperty(d)) continue;\n        t = atNum(r.exits[d]);\n        if (t > 0 && /^[a-z]{1,10}$/.test(d)) ex[d] = t;\n      }\n      if (r.specialExits && typeof r.specialExits == \"object\") for (d in r.specialExits) {\n        if (!r.specialExits.hasOwnProperty(d)) continue;\n        t = atNum(r.specialExits[d]);\n        if (t > 0) { if (!sp) sp = {}; sp[String(d).slice(0, 60)] = t; }\n      }\n      out.rooms[id] = [aid, atFloat(r.x), atFloat(r.y), atFloat(r.z), String(r.name || \"\").slice(0, 120), atNum(r.env), ex, sp];\n      out.n++;\n    }\n  }\n  if (Array.isArray(colors)) for (var k = 0; k < colors.length; k++) {\n    var c = colors[k];\n    if (!c || !Array.isArray(c.colors) || c.colors.length < 3) continue;\n    var e = atNum(c.envId);\n    out.env[e] = [0, 1, 2].map(function (q) { var x = atNum(c.colors[q]); return x < 0 ? 0 : (x > 255 ? 255 : x); });\n  }\n  return out.n ? out : null;\n};\n\n// A room by number: { id, a, x, y, z, n, e, ex, sp } or null.\nAT.room = function (id) {\n  var R = AT.map && AT.map.rooms[id];\n  if (!R) return null;\n  return { id: atNum(id), a: R[0], x: R[1], y: R[2], z: R[3], n: R[4], e: R[5], ex: R[6] || {}, sp: R[7] || {} };\n};\n// The room numbers of an area, built once per map.\nAT.areaRooms = function (aid) {\n  if (!AT.map) return [];\n  if (!AT.map.byArea) {\n    var by = {};\n    for (var id in AT.map.rooms) {\n      if (!AT.map.rooms.hasOwnProperty(id)) continue;\n      var a = AT.map.rooms[id][0];\n      (by[a] || (by[a] = [])).push(atNum(id));\n    }\n    AT.map.byArea = by;\n  }\n  return AT.map.byArea[aid] || [];\n};\nAT.areaName = function (aid) { return (AT.map && AT.map.areas[aid]) || (AT.here && AT.here.area === aid && AT.here.areaName) || (\"area \" + aid); };\n\n// ---- Loading ---------------------------------------------------------\nAT.fetchText = function (url) {\n  return fetch(url, { cache: \"no-cache\" }).then(function (r) { if (!r.ok) throw new Error(\"HTTP \" + r.status); return r.text(); });\n};\nAT.fetchJson = function (url) {\n  return fetch(url, { cache: \"no-cache\" }).then(function (r) { if (!r.ok) throw new Error(\"HTTP \" + r.status); return r.json(); });\n};\n// The cache: one IndexedDB database of this page's (play.achaea.com's),\n// shared by every character on this browser (the map is the same for all).\n// Any failure reads as \"no cache\": the map is then downloaded.\nAT.idb = function (mode, key, value) {\n  return new Promise(function (resolve) {\n    var done = false;\n    function end(v) { if (!done) { done = true; resolve(v); } }\n    try {\n      if (typeof indexedDB == \"undefined\" || !indexedDB) return end(null);\n      setTimeout(function () { end(null); }, 8000);\n      var req = indexedDB.open(\"loom-atlas\", 1);\n      req.onupgradeneeded = function () { try { req.result.createObjectStore(\"kv\"); } catch (e) {} };\n      req.onerror = function () { end(null); };\n      req.onsuccess = function () {\n        try {\n          var db = req.result, tx = db.transaction(\"kv\", mode), st = tx.objectStore(\"kv\");\n          if (mode == \"readonly\") {\n            var g = st.get(key);\n            g.onsuccess = function () { var v = g.result; end(v && typeof v == \"object\" ? v : null); };\n            g.onerror = function () { end(null); };\n            tx.oncomplete = function () { try { db.close(); } catch (e) {} };\n          } else {\n            st.put(value, key);\n            tx.oncomplete = function () { try { db.close(); } catch (e) {} end(true); };\n            tx.onerror = function () { end(false); };\n          }\n        } catch (e) { end(null); }\n      };\n    } catch (e) { end(null); }\n  });\n};\nAT.useMap = function (m, source) {\n  m.byArea = null;\n  AT.map = m;\n  AT.source = source;\n  AT.state = \"ready\";\n  AT.note = \"\";\n  if (AT.here) AT.placeView();\n  if (client.loom.notify) client.loom.notify(\"atlas\");\n  run_function(\"atlas_render\", { full: true }, \"atlas\");\n};\n// Load the map: from the cache when its version is the latest (or the\n// latest can't be read), else downloaded. `force` downloads anyway.\nAT.load = function (force) {\n  if (AT.state == \"loading\") return;\n  if (typeof fetch != \"function\") { AT.state = \"failed\"; AT.note = \"this browser can't download\"; return; }\n  AT.state = \"loading\";\n  AT.note = force ? \"downloading the community map…\" : \"loading the community map…\";\n  var gen = AT.gen = (AT.gen || 0) + 1;\n  run_function(\"atlas_render\", { full: true }, \"atlas\");\n  AT.idb(\"readonly\", \"crowdmap\").then(function (cached) {\n    if (cached && !(cached.rooms && cached.areas && typeof cached.rooms == \"object\")) cached = null;\n    return AT.fetchText(AT.base + \"version.txt\").then(function (t) { return String(t).trim().slice(0, 20); }, function () { return null; }).then(function (v) {\n      if (gen !== AT.gen) return;\n      if (cached && !force && (v === null || v === cached.v)) {\n        AT.useMap(cached, v === null ? \"cache (the community map couldn't be checked for updates)\" : \"cache\");\n        return;\n      }\n      if (v === null) throw new Error(\"the community map can't be reached\");\n      return Promise.all([AT.fetchJson(AT.base + \"mapExport.json\"), AT.fetchJson(AT.base + \"colors.json\").catch(function () { return null; })]).then(function (r) {\n        if (gen !== AT.gen) return;\n        var m = AT.compact(r[0], r[1], v);\n        if (!m) throw new Error(\"the community map came in a shape Atlas doesn't know\");\n        AT.idb(\"readwrite\", \"crowdmap\", m);\n        var was = cached ? cached.v : \"\";\n        AT.useMap(m, \"download\");\n        display_notice(\"[atlas] community map \" + (was && was !== m.v ? \"updated to version \" + m.v + \" (was \" + was + \")\" : \"version \" + m.v + \" loaded\") + \": \" + m.n.toLocaleString(\"en-US\") + \" rooms in \" + Object.keys(m.areas).length + \" areas.\", \"lime\");\n      });\n    });\n  }).catch(function (e) {\n    if (gen !== AT.gen) return;\n    AT.state = AT.map ? \"ready\" : \"failed\";\n    AT.note = String((e && e.message) || e);\n    display_notice(\"[atlas] couldn't load the community map: \" + AT.note + \". ATLAS RELOAD to try again.\", \"orange\");\n    run_function(\"atlas_render\", { full: true }, \"atlas\");\n  });\n};\n\n// ---- Environments: the game's names and colours ------------------------------\n// Each area's official map file (the one the stock map fetches when you\n// enter an area, the same for everyone) ends with the environments used in\n// it: <environment id=\"9\" name=\"Hills\" ... htmlcolor=\"#2d7720\" />. Atlas\n// reads it once per area per session and keeps what it learns in the\n// browser (key \"envs\"): { id: { n: name, c: \"#rrggbb\" } }.\nAT.envUrl = \"https://www.achaea.com/maps/v2/\";\nif (!AT.envs || typeof AT.envs != \"object\") AT.envs = {};\nif (!AT.envAsked) AT.envAsked = {};\nAT.envRead = function (xml) {\n  var re = /<environment\\b([^>]*)>/gi, m, got = 0;\n  while ((m = re.exec(String(xml))) !== null) {\n    var at = m[1], id = /\\bid=\"(\\d+)\"/.exec(at), n = /\\bname=\"([^\"]{1,60})\"/.exec(at), c = /\\bhtmlcolor=\"(#[0-9a-fA-F]{6})\"/.exec(at);\n    if (!id) continue;\n    var e = { n: n ? n[1].replace(/&amp;/g, \"&\").replace(/&[a-z#0-9]+;/gi, \"\") : \"\", c: c ? c[1].toLowerCase() : \"\" };\n    var was = AT.envs[id[1]];\n    if (!was || was.n !== e.n || was.c !== e.c) { AT.envs[id[1]] = e; got++; }\n  }\n  return got;\n};\nAT.envFetch = function (aid) {\n  if (!(aid > 0) || AT.envAsked[aid] || typeof fetch != \"function\") return;\n  AT.envAsked[aid] = true;\n  fetch(AT.envUrl + aid + \".xml\").then(function (r) { if (!r.ok) throw new Error(\"HTTP \" + r.status); return r.text(); }).then(function (t) {\n    if (AT.envRead(t)) {\n      AT.idb(\"readwrite\", \"envs\", AT.envs);\n      run_function(\"atlas_render\", { full: true }, \"atlas\");\n    }\n  }).catch(function () {});\n};\nAT.envLoad = function () {\n  AT.idb(\"readonly\", \"envs\").then(function (v) {\n    if (!v) return;\n    var n = 0;\n    for (var id in v) if (v.hasOwnProperty(id) && /^\\d+$/.test(id) && v[id] && typeof v[id] == \"object\" && !AT.envs[id]) {\n      AT.envs[id] = { n: String(v[id].n || \"\").slice(0, 60), c: /^#[0-9a-f]{6}$/.test(v[id].c) ? v[id].c : \"\" };\n      n++;\n    }\n    if (n) run_function(\"atlas_render\", { full: true }, \"atlas\");\n  });\n};\n\n// ---- Where you are, what you've explored ------------------------------\n// Explored lists Nexus already holds (areas entered before Atlas loaded).\nAT.seedExplored = function () {\n  try {\n    var NC = (typeof nexusclient != \"undefined\" && nexusclient) ? nexusclient : client;\n    var E = NC && NC._datahandler && NC._datahandler.GMCP && NC._datahandler.GMCP.Explored;\n    if (!E || typeof E != \"object\") return;\n    for (var a in E) {\n      if (!E.hasOwnProperty(a) || !E[a] || typeof E[a] != \"object\" || !(atNum(a) > 0)) continue;\n      var s = AT.explored[atNum(a)] || (AT.explored[atNum(a)] = {});\n      for (var r in E[a]) if (E[a].hasOwnProperty(r) && atNum(r) > 0) s[atNum(r)] = true;\n    }\n  } catch (e) {}\n};\nAT.exploredCount = function (aid) {\n  var s = AT.explored[aid];\n  return s ? Object.keys(s).length : -1;\n};\n// Room.Info: where you are; an area's explored list when it comes with it.\nAT.roomInfo = function (g) {\n  var id = atNum(g.num);\n  if (!(id > 0)) return;\n  var co = String(g.coords || \"\").split(\",\");\n  var aid = atNum(co[0]);\n  var R = AT.room(id);\n  if (R) aid = R.a;\n  AT.here = { id: id, area: aid > 0 ? aid : null, name: String(g.name || \"\").replace(/\\s*\\((?:indoors|outdoors|road)\\)\\s*$/i, \"\").slice(0, 120),\n    areaName: String(g.area || \"\").slice(0, 80), onMap: !!R };\n  if (Array.isArray(g.explored) && AT.here.area) {\n    var s = {};\n    for (var i = 0; i < g.explored.length; i++) { var x = atNum(g.explored[i]); if (x > 0) s[x] = true; }\n    AT.explored[AT.here.area] = s;\n  }\n  // As Nexus does: the room you're in is explored (once the area's list is known).\n  if (AT.here.area && AT.explored[AT.here.area]) AT.explored[AT.here.area][id] = true;\n  if (AT.here.area) AT.envFetch(AT.here.area);\n  AT.placeView();\n  run_function(\"atlas_render\", {}, \"atlas\");\n};\n// The view follows you: your area, your level, centred on your room.\n// (SVG coordinates: x east, y south, so the map's y is turned over.)\nAT.placeView = function () {\n  var H = AT.here;\n  if (!H) return;\n  var R = AT.room(H.id);\n  if (R) { AT.view.area = R.a; AT.view.z = R.z; AT.view.cx = R.x; AT.view.cy = -R.y; }\n  else if (H.area) { AT.view.area = H.area; }\n};\n\n// ---- Walking ---------------------------------------------------------\nAT.go = function (id) {\n  id = atNum(id);\n  if (!(id > 0)) return;\n  if (get_variable(\"pauseTriggers\") == \"on\") { display_notice(\"[atlas] Loom is paused (LOOM PAUSE OFF to walk).\", \"orange\"); return; }\n  var R = AT.room(id), label = (R && R.n ? R.n + \" \" : \"\") + \"(\" + id + \")\";\n  if (AT.here && AT.here.id === id) { display_notice(\"[atlas] you're in \" + label + \" already.\", \"cyan\"); return; }\n  send_command(\"path find \" + id, 1);\n  display_notice(\"[atlas] walking to \" + label + \".\", \"cyan\");\n};\n\nAT.setFog = function (on) {\n  AT.fog = !!on;\n  if (AT.fog) delete_variable(\"atlas_fog\"); else set_variable(\"atlas_fog\", \"off\");\n  run_function(\"atlas_render\", { full: true }, \"atlas\");\n};\n\n// ---- The view: zoom, pan, levels ----------------------------------------\n// Pan and zoom change the drawn map's viewBox in place; the next full draw\n// takes them from AT.view.\nAT.viewBox = function () {\n  var v = AT.view;\n  return (v.cx - v.span / 2).toFixed(2) + \" \" + (v.cy - v.span / 2).toFixed(2) + \" \" + v.span.toFixed(2) + \" \" + v.span.toFixed(2);\n};\nAT.svgs = function () {\n  try { return Array.prototype.slice.call(document.querySelectorAll(\"svg.loom-atlas-svg\")); } catch (e) { return []; }\n};\n// Zoom and the end of a drag draw the tab again: Nexus shows a tab's HTML\n// as given, and changes made in place may not show until the next draw.\nAT.drawSoon = function () {\n  if (AT.drawT) return;\n  AT.drawT = setTimeout(function () { AT.drawT = null; run_function(\"atlas_render\", { full: true }, \"atlas\"); }, 30);\n};\nAT.zoom = function (f) {\n  var s = AT.view.span * f;\n  AT.view.span = s < AT.spanMin ? AT.spanMin : (s > AT.spanMax ? AT.spanMax : s);\n  AT.drawSoon();\n};\nAT.centre = function () {\n  AT.placeView();\n  run_function(\"atlas_render\", { full: true }, \"atlas\");\n};\nAT.level = function (dir) {\n  var zs = AT.levels(AT.view.area);\n  var i = zs.indexOf(AT.view.z);\n  var j = i < 0 ? 0 : i + dir;\n  if (j < 0 || j >= zs.length) return;\n  AT.view.z = zs[j];\n  run_function(\"atlas_render\", { full: true }, \"atlas\");\n};\n// The levels (z) an area has rooms on, lowest first.\nAT.levels = function (aid) {\n  var ids = AT.areaRooms(aid), seen = {}, out = [];\n  for (var i = 0; i < ids.length; i++) { var z = AT.map.rooms[ids[i]][3]; if (!seen[z]) { seen[z] = 1; out.push(z); } }\n  return out.sort(function (a, b) { return a - b; });\n};\n\n// Dragging pans; a press that moved isn't a click.\nAT.drag = null;\nAT.dragged = false;\nAT.down = function (ev) {\n  if (ev.button !== undefined && ev.button !== 0) return;\n  var el = ev.currentTarget, r = el.getBoundingClientRect();\n  AT.drag = { x: ev.clientX, y: ev.clientY, cx: AT.view.cx, cy: AT.view.cy, upp: AT.view.span / Math.max(r.width, r.height, 1), moved: false };\n};\nAT.move = function (ev) {\n  var D = AT.drag;\n  if (!D) return;\n  var dx = ev.clientX - D.x, dy = ev.clientY - D.y;\n  if (!D.moved && Math.abs(dx) + Math.abs(dy) < 5) return;\n  D.moved = true;\n  AT.view.cx = D.cx - dx * D.upp;\n  AT.view.cy = D.cy - dy * D.upp;\n  var vb = AT.viewBox(), s = AT.svgs();\n  for (var i = 0; i < s.length; i++) s[i].setAttribute(\"viewBox\", vb);\n};\nAT.up = function () {\n  var D = AT.drag;\n  AT.drag = null;\n  if (D && D.moved) {\n    AT.dragged = true;\n    setTimeout(function () { AT.dragged = false; }, 0);\n    run_function(\"atlas_render\", { full: true }, \"atlas\");\n  }\n};\nAT.wheel = function (ev) {\n  try { ev.preventDefault(); } catch (e) {}\n  AT.zoom(ev.deltaY > 0 ? 1.15 : 1 / 1.15);\n};\n\n// ---- What other packages see ----------------------------------------------\n//   look.room(id) -> { id, area, areaName, x, y, z, name } or undefined\n//   look.here()   -> { id, area, name } or undefined\n//   look.explored(area) -> { explored, mapped } or undefined (list not seen)\nAT.look = {\n  room: function (id) { var R = AT.room(id); return R ? { id: R.id, area: R.a, areaName: AT.areaName(R.a), x: R.x, y: R.y, z: R.z, name: R.n } : undefined; },\n  here: function () { return AT.here ? { id: AT.here.id, area: AT.here.area, name: AT.here.name } : undefined; },\n  explored: function (aid) { var n = AT.exploredCount(aid); return n < 0 ? undefined : { explored: n, mapped: AT.areaRooms(aid).length }; }\n};\n\n// The tab's clicks: its page shares window with the scripts.\ntry {\n  window.loomAtlas = {\n    go: function (id) { if (!client.loom.atlas.dragged) client.loom.atlas.go(id); },\n    zoom: function (f) { client.loom.atlas.zoom(f); },\n    centre: function () { client.loom.atlas.centre(); },\n    level: function (d) { client.loom.atlas.level(d); },\n    fog: function () { client.loom.atlas.setFog(!client.loom.atlas.fog); },\n    reload: function () { client.loom.atlas.load(true); },\n    down: function (ev) { client.loom.atlas.down(ev); },\n    move: function (ev) { client.loom.atlas.move(ev); },\n    up: function (ev) { client.loom.atlas.up(ev); },\n    wheel: function (ev) { client.loom.atlas.wheel(ev); }\n  };\n} catch (e) {}\n\nAT.seedExplored();\nif (!AT.envLoaded) { AT.envLoaded = true; AT.envLoad(); }\nif (client.loom.notify) client.loom.notify(\"atlas\");\n"
  },
  {
   "type": "function",
   "name": "atlas_render",
   "enabled": true,
   "code": "// atlas_render -- the Atlas tab (#451), in the house style shared with Here:\n// ink panel, serif small-caps headings, monospace lines.\n//   - title: Atlas, the area's name, zoom − +, ⌖ (back to you), FOG\n//   - line 2: the room you're in · its number · level (▲▼ to look at the\n//     area's other levels) · explored N · M on the map\n//   - the area's rooms on that level as squares in their environment's\n//     colour, exits as lines; with fog of war, only the rooms you've\n//     explored (and stubs where an exit leads somewhere you haven't been);\n//     without it, unexplored rooms faint; exits to other areas dashed; ▲▼\n//     in a room for up/down; the room you're in ringed\n//   - drag to pan, wheel or − + to zoom, click a room to walk there\n// Every draw is whole (0.1.1): Nexus shows a tab's HTML as given, and a ring\n// moved in place showed only at the next draw.\nif (!client.loom || !client.loom.atlas || !client.loom.atlas.look) run_function(\"atlas_setup\", [], \"atlas\");\nvar AT = client.loom.atlas;\nvar TH = (client.loom && client.loom.theme) || {};\nvar AMBER = TH.acc || \"#e0b46c\";\nvar DEEP = TH.deep || \"#7a5f33\";\nvar TXT = TH.txt || \"#e8e2d6\";\nvar MUTED = TH.muted || \"#8f877a\";\nvar DIM = TH.dim || \"#6d665b\";\nvar RULE = TH.rule || \"#2b2620\";\nvar BG = TH.bg || \"#13110e\";\nvar HI = TH.hi || \"#f0cc8c\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\"); }\nfunction chip(label, fn, tip, on) {\n  return '<span onclick=\"window.loomAtlas&&window.loomAtlas.' + fn + '\" title=\"' + esc(tip) + '\" style=\"flex:none;cursor:pointer;padding:0 5px;border:1px solid ' + (on ? AMBER : DEEP) + ';color:' + (on ? AMBER : MUTED) + ';letter-spacing:0.08em;white-space:nowrap;user-select:none;\">' + label + '</span>';\n}\nfunction lvl(z) { return z === 0 ? \"ground\" : (z > 0 ? \"+\" + z : String(z)); }\nfunction arrow(sym, d, on, tip) {\n  return on ? '<span onclick=\"window.loomAtlas&&window.loomAtlas.level(' + d + ')\" title=\"' + tip + '\" style=\"cursor:pointer;color:' + AMBER + ';padding:0 2px;user-select:none;\">' + sym + '</span>'\n    : '<span style=\"color:' + RULE + ';padding:0 2px;\">' + sym + '</span>';\n}\n// Environment colours: the community map's (Mudlet's bright ones), muted to\n// sit on the ink panel: the same hue, far less saturation, a narrow band of\n// lightness so every room reads and none glares.\nvar envCol = {};\nfunction col(e) {\n  if (envCol[e]) return envCol[e];\n  var o = AT.envs && AT.envs[e];\n  if (o && o.c) return (envCol[e] = o.c);\n  var c = AT.map && AT.map.env[e];\n  if (!c) return (envCol[e] = \"rgb(96,90,80)\");\n  var r = c[0] / 255, g = c[1] / 255, b = c[2] / 255;\n  var mx = Math.max(r, g, b), mn = Math.min(r, g, b), l = (mx + mn) / 2, h = 0, sa = 0, d = mx - mn;\n  if (d) {\n    sa = d / (1 - Math.abs(2 * l - 1));\n    h = mx === r ? ((g - b) / d) % 6 : (mx === g ? (b - r) / d + 2 : (r - g) / d + 4);\n    h *= 60; if (h < 0) h += 360;\n  }\n  return (envCol[e] = \"hsl(\" + Math.round(h) + \",\" + Math.round(sa * 38) + \"%,\" + Math.round(30 + l * 18) + \"%)\");\n}\n// The community map names areas \"Delos, the Isle of\"; the game says\n// \"the Isle of Delos\".\nfunction areaTitle(aid) {\n  if (AT.here && AT.here.area === aid && AT.here.areaName) return AT.here.areaName;\n  var n = AT.areaName(aid), m = /^(.+?), (the(?: .+)?)$/i.exec(n);\n  return m ? m[2] + \" \" + m[1] : n;\n}\n\nvar H = AT.here, V = AT.view, M = AT.map;\nvar aid = V.area;\nvar here = H ? AT.room(H.id) : null;\nvar expl = aid ? AT.explored[aid] : null;\nvar fogOn = AT.fog && !!expl;\nvar nExpl = expl ? Object.keys(expl).length : -1;\nvar roomLine = H ? esc(H.name || \"?\") + ' &middot; ' + H.id : \"\";\n\n{\n  if (AT.drawT) { clearTimeout(AT.drawT); AT.drawT = null; }\n  var html = '<div id=\"loom-atlas\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + BG + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;height:100%;min-height:300px;box-sizing:border-box;display:flex;flex-direction:column;\">';\n\n  // Title: Atlas, the area, the controls.\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\n  html += '<span style=\"display:flex;align-items:baseline;gap:8px;min-width:0;\"><span style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:2px;font-size:15px;color:' + AMBER + ';flex:none;\">Atlas</span>';\n  if (aid) html += '<span style=\"font-family:' + SERIF + ';font-size:13px;color:' + TXT + ';overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">' + esc(areaTitle(aid)) + '</span>';\n  html += '</span><span style=\"display:flex;align-items:baseline;gap:4px;flex:none;\">';\n  if (M) {\n    html += chip('&minus;', 'zoom(1.25)', 'zoom out (or the mouse wheel)') + chip('+', 'zoom(0.8)', 'zoom in (or the mouse wheel)');\n    html += chip('&#8982;', 'centre()', 'back to the room you\\'re in');\n    html += chip('FOG', 'fog()', AT.fog ? 'fog of war on: only the rooms you\\'ve explored (click to show every room)' : 'fog of war off: every room on the map, unexplored ones faint (click to hide them)', AT.fog);\n  }\n  html += '</span></div>';\n\n  // Line 2: the room, its level, explored.\n  if (M && aid) {\n    var zs = AT.levels(aid), zi = zs.indexOf(V.z);\n    var up = zi >= 0 && zi < zs.length - 1, dn = zi > 0;\n    var hereLvl = here && here.a === aid ? here.z : null;\n    html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;padding:3px 0 2px;color:' + MUTED + ';\">';\n    html += '<span class=\"loom-atlas-room\" style=\"min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:' + SERIF + ';font-size:12px;color:' + TXT + ';\">' + roomLine + '</span>';\n    html += '<span style=\"flex:none;white-space:nowrap;\">';\n    if (zs.length > 1) html += arrow('&#9660;', -1, dn, 'the level below') + '<span title=\"the level shown' + (hereLvl !== null && hereLvl !== V.z ? ' (you\\'re on ' + lvl(hereLvl) + ')' : '') + '\" style=\"color:' + (hereLvl !== null && hereLvl !== V.z ? AMBER : MUTED) + ';\">level ' + lvl(V.z) + '</span>' + arrow('&#9650;', 1, up, 'the level above') + ' &middot; ';\n    var mapped = AT.areaRooms(aid).length;\n    html += nExpl >= 0 ? '<span title=\"rooms you\\'ve explored here (the game\\'s count) of the rooms in this area on the community map\">' + nExpl + ' of ' + mapped + ' explored</span>'\n      : '<span title=\"the game tells which rooms you\\'ve explored when you enter an area\">' + mapped + ' rooms on the map</span>';\n    html += '</span></div>';\n  }\n\n  // The map.\n  html += '<div style=\"flex:1 1 auto;position:relative;min-height:240px;margin-top:4px;border:1px solid ' + RULE + ';overflow:hidden;\">';\n  if (!M) {\n    var msg = AT.state == \"loading\" ? AT.note || \"loading the community map…\"\n      : (AT.state == \"failed\" ? \"Couldn't load the community map: \" + AT.note + \".\" : \"The community map isn't loaded yet.\");\n    html += '<div style=\"padding:12px;font-family:' + SERIF + ';font-style:italic;font-size:12px;color:' + MUTED + ';\">' + esc(msg);\n    if (AT.state != \"loading\") html += ' <span onclick=\"window.loomAtlas&&window.loomAtlas.reload()\" style=\"cursor:pointer;font-style:normal;font-family:' + MONO + ';font-size:10px;color:' + AMBER + ';border:1px solid ' + DEEP + ';padding:0 5px;letter-spacing:0.08em;\">RELOAD</span>';\n    html += '</div>';\n  } else if (!aid) {\n    html += '<div style=\"padding:12px;font-family:' + SERIF + ';font-style:italic;font-size:12px;color:' + MUTED + ';\">Move or LOOK, and the map follows you.</div>';\n  } else {\n    var DIR = { north: [0, -1], south: [0, 1], east: [1, 0], west: [-1, 0], northeast: [1, -1], northwest: [-1, -1], southeast: [1, 1], southwest: [-1, 1] };\n    var ids = AT.areaRooms(aid), shown = {}, list = [];\n    for (var i = 0; i < ids.length; i++) {\n      var R = AT.room(ids[i]);\n      if (R.z !== V.z) continue;\n      var known = !expl || !!expl[R.id] || (here && here.id === R.id);\n      if (fogOn && !known) continue;\n      shown[R.id] = known ? 1 : 2;           // 2: unexplored, shown faint (fog off)\n      list.push(R);\n    }\n    var lines = '', stubs = '', rooms = '', marks = '';\n    for (var k = 0; k < list.length; k++) {\n      var Q = list[k], qx = Q.x, qy = -Q.y;\n      for (var d in Q.ex) {\n        if (!Q.ex.hasOwnProperty(d)) continue;\n        var to = Q.ex[d], T = AT.room(to), v = DIR[d];\n        if (T && T.a === aid && T.z === V.z && shown[to]) {\n          if (Q.id < to || !(T.ex && Object.keys(T.ex).some(function (kk) { return T.ex[kk] === Q.id; })))\n            lines += '<line x1=\"' + qx + '\" y1=\"' + qy + '\" x2=\"' + T.x + '\" y2=\"' + (-T.y) + '\"' + (shown[to] === 2 || shown[Q.id] === 2 ? ' opacity=\"0.4\"' : '') + '/>';\n        } else if (v) {\n          var len = 0.62, other = T && T.a !== aid;\n          var ex2 = qx + v[0] * len, ey2 = qy + v[1] * len;\n          stubs += '<line x1=\"' + qx + '\" y1=\"' + qy + '\" x2=\"' + ex2.toFixed(2) + '\" y2=\"' + ey2.toFixed(2) + '\" stroke=\"' + (other ? AMBER : DIM) + '\" stroke-dasharray=\"' + (other ? '0.12 0.08' : '0.06 0.08') + '\">' +\n            '<title>' + esc(d + (other ? ' to ' + areaTitle(T.a) : (T && T.z !== V.z ? ' (another level)' : ' (somewhere you haven\\'t explored)'))) + '</title></line>';\n        }\n      }\n      var faint = shown[Q.id] === 2;\n      rooms += '<rect class=\"loom-atlas-r\" x=\"' + (qx - 0.3) + '\" y=\"' + (qy - 0.3) + '\" width=\"0.6\" height=\"0.6\" rx=\"0.08\" fill=\"' + col(Q.e) + '\"' + (faint ? ' opacity=\"0.35\"' : '') +\n        ' onclick=\"window.loomAtlas&&window.loomAtlas.go(' + Q.id + ')\"><title>' + esc((Q.n || \"?\") + \" (\" + Q.id + \")\" + (AT.envs && AT.envs[Q.e] && AT.envs[Q.e].n ? \" · \" + AT.envs[Q.e].n : \"\") + (faint ? \" · not explored\" : \"\") + \" · click to walk here\") + '</title></rect>';\n      // Up and down: small marks inside the room.\n      var upx = false, dnx = false;\n      for (var e2 in Q.ex) {\n        if (!Q.ex.hasOwnProperty(e2)) continue;\n        if (e2 === \"up\") upx = true; else if (e2 === \"down\") dnx = true;\n        else if (!DIR[e2]) { var T2 = AT.room(Q.ex[e2]); if (T2 && T2.z > V.z) upx = true; else if (T2 && T2.z < V.z) dnx = true; }\n      }\n      if (upx) marks += '<path d=\"M' + (qx - 0.12) + ' ' + (qy - 0.05) + ' l0.12 -0.16 l0.12 0.16 z\"/>';\n      if (dnx) marks += '<path d=\"M' + (qx - 0.12) + ' ' + (qy + 0.05) + ' l0.12 0.16 l0.12 -0.16 z\"/>';\n    }\n    var ring = '';\n    if (here && here.a === aid) {\n      ring = '<g class=\"loom-atlas-me\" transform=\"translate(' + here.x + ' ' + (-here.y) + ')\"' + (here.z !== V.z ? ' opacity=\"0.35\"' : '') + ' pointer-events=\"none\">' +\n        '<circle r=\"0.48\" fill=\"none\" stroke=\"' + AMBER + '\" stroke-width=\"0.09\"/><circle r=\"0.12\" fill=\"' + HI + '\"/></g>';\n    }\n    html += '<svg class=\"loom-atlas-svg\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"' + AT.viewBox() + '\" preserveAspectRatio=\"xMidYMid slice\" style=\"position:absolute;inset:0;width:100%;height:100%;display:block;cursor:grab;touch-action:none;\"' +\n      ' onpointerdown=\"window.loomAtlas&&window.loomAtlas.down(event)\" onpointermove=\"window.loomAtlas&&window.loomAtlas.move(event)\" onpointerup=\"window.loomAtlas&&window.loomAtlas.up(event)\" onpointerleave=\"window.loomAtlas&&window.loomAtlas.up(event)\" onwheel=\"window.loomAtlas&&window.loomAtlas.wheel(event)\">';\n    html += '<g stroke=\"' + MUTED + '\" stroke-width=\"0.07\" stroke-linecap=\"round\">' + lines + '</g>';\n    html += '<g stroke-width=\"0.07\" stroke-linecap=\"round\">' + stubs + '</g>';\n    html += '<g stroke=\"' + BG + '\" stroke-width=\"0.04\">' + rooms + '</g>';\n    html += '<g fill=\"' + TXT + '\" opacity=\"0.85\" pointer-events=\"none\">' + marks + '</g>';\n    html += ring + '</svg>';\n    if (!list.length) html += '<div style=\"position:absolute;left:12px;top:12px;font-family:' + SERIF + ';font-style:italic;font-size:12px;color:' + MUTED + ';\">' + (ids.length ? \"Nothing explored on this level yet.\" : \"This area isn't on the community map.\") + '</div>';\n  }\n  html += '</div>';\n\n  // Footer: what's missing, where the map comes from.\n  var foot = [];\n  if (H && !here) foot.push(\"This room (\" + H.id + \") isn't on the community map\" + (aid ? \"; showing its area.\" : \".\"));\n  if (M && aid && !expl) foot.push(\"Fog of war starts once you enter an area: the game sends its explored rooms then.\");\n  if (AT.state == \"loading\" && M) foot.push(AT.note);\n  if (M) foot.push(\"Community map version \" + M.v + \". Drag to pan, click a room to walk there.\");\n  html += '<div style=\"margin-top:5px;font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + MUTED + ';\">' + foot.map(esc).join(\" \") + '</div>';\n  html += '</div>';\n\n  // The whole tab in the panel's colour (#355); rooms light up under the mouse.\n  try {\n    var atSt = document.getElementById(\"loom-atlas-style\");\n    if (!atSt) { atSt = document.createElement(\"style\"); atSt.id = \"loom-atlas-style\"; document.head.appendChild(atSt); }\n    var atCss = '.flexlayout__tab:has(#loom-atlas) { background: ' + BG + ' !important; } .flexlayout__tab:has(#loom-atlas) > * { min-height: 100%; height: 100%; } ' +\n      '#loom-atlas .loom-atlas-r { cursor: pointer; } #loom-atlas .loom-atlas-r:hover { stroke: ' + HI + '; stroke-width: 0.08; } #loom-atlas svg:active { cursor: grabbing; }';\n    if (atSt.textContent !== atCss) atSt.textContent = atCss;\n  } catch (e) {}\n  try { set_custom_tab_html(\"Atlas\", html); } catch (e) {}\n}\n"
  },
  {
   "type": "function",
   "name": "atlas_help",
   "enabled": true,
   "code": "// atlas_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[atlas] the community map in the Atlas tab, with the rooms you've explored. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"ATLAS\", \"status: the map's version, fog of war, where you are and how much of the area you've explored\"],\n  [\"ATLAS FOG [ON|OFF]\", \"fog of war: only the rooms you've explored (default ON); OFF shows every room, unexplored ones faint\"],\n  [\"ATLAS GO <room number>\", \"walk there (PATH FIND), as a click on a room in the tab\"],\n  [\"ATLAS RELOAD\", \"download the community map again (it's otherwise kept in this browser and updated when it changes)\"],\n  [\"ATLAS DEBUG\", \"internal state\"],\n  [\"The tab is a custom tab named Atlas. Drag to pan, mouse wheel or - + to zoom, the arrows by 'level' look up and down.\"],\n  [\"The map is the Achaea crowdmap, kept by players at github.com/IRE-Mudlet-Mapping/AchaeaCrowdmap.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "Atlas control",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// ATLAS [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.atlas || !client.loom.atlas.look) run_function(\"atlas_setup\", [], \"atlas\");\nvar AT = client.loom.atlas;\nvar atRaw = String(args[1] || \"\").trim();\nvar atSp = atRaw.search(/\\s/);\nvar atCmd = (atSp < 0 ? atRaw : atRaw.substring(0, atSp)).toLowerCase();\nvar atRest = atSp < 0 ? \"\" : atRaw.substring(atSp).trim();\nif (atCmd === \"\" || atCmd === \"status\") {\n  var atMap = AT.map ? \"community map version \" + AT.map.v + \" (\" + AT.map.n.toLocaleString(\"en-US\") + \" rooms, \" + Object.keys(AT.map.areas).length + \" areas, from \" + AT.source + \")\"\n    : (AT.state == \"loading\" ? \"the community map is loading\" : \"no map loaded\" + (AT.note ? \" (\" + AT.note + \")\" : \"\") + \": ATLAS RELOAD\");\n  var atHere = \"\";\n  if (AT.here) {\n    var atE = AT.here.area ? AT.look.explored(AT.here.area) : undefined;\n    atHere = \" Here: \" + (AT.here.name || \"?\") + \" (\" + AT.here.id + \")\" + (AT.here.area ? \" in \" + AT.areaName(AT.here.area) : \"\") + (AT.here.onMap ? \"\" : \", not on the community map\") +\n      (atE ? \"; explored \" + atE.explored + \" of the \" + atE.mapped + \" rooms mapped there.\" : \".\");\n  }\n  display_notice(\"[atlas] \" + atMap + \". Fog of war \" + (AT.fog ? \"on\" : \"off\") + \".\" + atHere, \"cyan\");\n} else if (atCmd === \"help\") {\n  run_function(\"atlas_help\", [], \"atlas\");\n} else if (atCmd === \"reload\") {\n  if (AT.state == \"loading\") display_notice(\"[atlas] the community map is loading already.\", \"cyan\");\n  else { display_notice(\"[atlas] downloading the community map again.\", \"cyan\"); AT.load(true); }\n} else if (atCmd === \"fog\") {\n  var atF = atRest.toLowerCase();\n  if (atF === \"on\" || atF === \"off\") { AT.setFog(atF === \"on\"); display_notice(\"[atlas] fog of war \" + atF + (atF === \"on\" ? \": only the rooms you've explored.\" : \": every room on the map, unexplored ones faint.\"), \"lime\"); }\n  else if (!atF) display_notice(\"[atlas] fog of war is \" + (AT.fog ? \"on\" : \"off\") + \". ATLAS FOG ON|OFF.\", \"cyan\");\n  else display_notice(\"[atlas] ATLAS FOG ON|OFF.\", \"orange\");\n} else if (atCmd === \"go\") {\n  if (/^\\d+$/.test(atRest)) AT.go(atRest);\n  else display_notice(\"[atlas] ATLAS GO <room number>.\", \"orange\");\n} else if (atCmd === \"debug\") {\n  var atEx = [];\n  for (var atA in AT.explored) if (AT.explored.hasOwnProperty(atA)) atEx.push(atA + \":\" + Object.keys(AT.explored[atA]).length);\n  display_notice(\"[atlas] state=\" + AT.state + \" source=\" + (AT.source || \"-\") + \" note=\" + (AT.note || \"-\") + \" here=\" + JSON.stringify(AT.here) + \" view=\" + JSON.stringify(AT.view) + \" explored={\" + atEx.join(\", \") + \"} tabs=\" + AT.svgs().length, \"cyan\");\n} else {\n  display_notice(\"[atlas] unknown command '\" + atCmd + \"'. ATLAS HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^atlas(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  }
 ],
 "description": "A map tab from the community crowdmap, with the rooms you've explored as fog"
}