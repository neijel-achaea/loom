{
 "type": "group",
 "name": "atlas",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"atlas_setup\", [], \"atlas\");\nclient.loom.atlas.load(false);\ndisplay_notice(\"[atlas] installed. Create UI tabs named 'Atlas' (the map) and 'Areas' (exploration per area); the community map downloads once and then comes from this browser's cache. ATLAS HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// The atlas_* variables and the map cached in this browser are left intact.\n// Leave LOOM and the integrations at once, not at the next load (#137).\nif (client.loom && client.loom.atlas && client.loom.atlas.drawT) { clearTimeout(client.loom.atlas.drawT); client.loom.atlas.drawT = null; }\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"atlas\");\n  else delete client.loom.registry.atlas;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it. A folded map.\nvar tiTabs = [[\"Atlas\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\"><path d=\"M1.5 3.2 L5.5 1.8 L10.5 3.6 L14.5 2.2 V12.8 L10.5 14.2 L5.5 12.4 L1.5 13.8 Z\" fill=\"#2b2620\" stroke=\"#c8bfae\" stroke-width=\"1\" stroke-linejoin=\"round\"/><path d=\"M5.5 1.8 V12.4 M10.5 3.6 V14.2\" stroke=\"#7a5f33\" stroke-width=\"0.9\"/><circle cx=\"8\" cy=\"7.6\" r=\"1.6\" fill=\"none\" stroke=\"#e0b46c\" stroke-width=\"1\"/></svg>'], [\"Areas\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\"><rect x=\"1.5\" y=\"2\" width=\"13\" height=\"2.4\" rx=\"0.6\" fill=\"#2b2620\" stroke=\"#c8bfae\" stroke-width=\"0.8\"/><rect x=\"1.9\" y=\"2.4\" width=\"9\" height=\"1.6\" fill=\"#e0b46c\"/><rect x=\"1.5\" y=\"6.8\" width=\"13\" height=\"2.4\" rx=\"0.6\" fill=\"#2b2620\" stroke=\"#c8bfae\" stroke-width=\"0.8\"/><rect x=\"1.9\" y=\"7.2\" width=\"5\" height=\"1.6\" fill=\"#e0b46c\"/><rect x=\"1.5\" y=\"11.6\" width=\"13\" height=\"2.4\" rx=\"0.6\" fill=\"#2b2620\" stroke=\"#c8bfae\" stroke-width=\"0.8\"/><rect x=\"1.9\" y=\"12\" width=\"11.6\" height=\"1.6\" fill=\"#e0b46c\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\nrun_function(\"atlas_setup\", [], \"atlas\");\nif (!client.loom.atlas.map) client.loom.atlas.load(false);\nrun_function(\"atlas_render\", { full: true }, \"atlas\");\nrun_function(\"atlas_areas_render\", [], \"atlas\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Atlas follows the room you're in, and reads the explored rooms the game\n// sends with Room.Info when you enter an area.\nif (!client.loom || !client.loom.atlas || !client.loom.atlas.look) run_function(\"atlas_setup\", [], \"atlas\");\nif (args.gmcp_method == \"Room.Info\") {\n  var atG = (args.gmcp_args && typeof args.gmcp_args == \"object\") ? args.gmcp_args : {};\n  client.loom.atlas.roomInfo(atG);\n}\n"
  },
  {
   "type": "function",
   "name": "atlas_setup",
   "enabled": true,
   "code": "// atlas_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Atlas (#451): a map of our own, drawn from the\n// community-maintained Achaea crowdmap (the map Mudlet's IRE mapper uses),\n// with the game's own record of the rooms you've explored as fog of war.\n//\n// Where things come from:\n//   - the map: https://ire-mudlet-mapping.github.io/AchaeaCrowdmap/Map/\n//     (mapExport.json, colors.json, version.txt). Downloaded only, never\n//     sent anything; kept in this browser's IndexedDB and downloaded again\n//     only when version.txt changes (or ATLAS RELOAD).\n//   - where you are: GMCP Room.Info (num; coords \"areaid,x,y,z\").\n//   - what you've explored: Room.Info's `explored`, the ids of every room\n//     you've explored in an area, sent when you enter the area; Nexus keeps\n//     the same lists in GMCP.Explored, read once at load for the areas\n//     entered before Atlas was.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.atlas) client.loom.atlas = {};\nclient.loom.registry.atlas = { version: \"0.3.0\", keyword: \"ATLAS\", desc: \"A map tab from the community crowdmap, with the rooms you've explored as fog\",\n  redraw: function () { run_function(\"atlas_render\", { full: true }, \"atlas\"); run_function(\"atlas_areas_render\", [], \"atlas\"); } };\nvar AT = client.loom.atlas;\n\nAT.base = \"https://ire-mudlet-mapping.github.io/AchaeaCrowdmap/Map/\";\n// Saved (per character, as every Nexus variable):\n//   atlas_fog = \"off\" while fog of war is off (absent: on);\n//   atlas_counts = { area: rooms explored there that are on the map },\n//     updated whenever the game sends an area's list or you explore a room;\n//   atlas_tags = { area: [tag, …] }, your own groups for the Areas tab;\n//   atlas_hidden = [area, …], areas kept out of the Areas tab and totals;\n//   atlas_folded = { group key: true|false }, Areas tab folding (absent:\n//     open, except \"unvisited\", \"uncounted\" and \"hidden\", folded);\n//   atlas_uncounted = [area, …], areas you walked into whose room\n//     information came without an explored list: the game keeps no record of\n//     exploring them (inns and the like), so they stay out of the totals.\n// A variable that isn't readable starts afresh (#135).\nAT.fog = get_variable(\"atlas_fog\") !== \"off\";\nAT.readJson = function (name) {\n  var v = get_variable(name);\n  if (typeof v == \"string\") { try { v = JSON.parse(v); } catch (e) { v = null; } }\n  return v;\n};\nAT.counts = {};\nvar atC = AT.readJson(\"atlas_counts\");\nif (atC && typeof atC == \"object\" && !Array.isArray(atC)) for (var atK in atC) if (atC.hasOwnProperty(atK) && atNum(atK) > 0 && atNum(atC[atK]) >= 0) AT.counts[atNum(atK)] = atNum(atC[atK]);\nAT.tags = {};\nvar atT = AT.readJson(\"atlas_tags\");\nif (atT && typeof atT == \"object\" && !Array.isArray(atT)) for (var atA in atT) {\n  if (!atT.hasOwnProperty(atA) || !(atNum(atA) > 0) || !Array.isArray(atT[atA])) continue;\n  var atL = [];\n  for (var atI = 0; atI < atT[atA].length; atI++) { var atW = String(atT[atA][atI] || \"\").toLowerCase(); if (/^[a-z0-9][a-z0-9_-]*$/.test(atW) && atL.indexOf(atW) < 0) atL.push(atW); }\n  if (atL.length) AT.tags[atNum(atA)] = atL;\n}\nAT.hidden = {};\nvar atH = AT.readJson(\"atlas_hidden\");\nif (Array.isArray(atH)) for (var atJ = 0; atJ < atH.length; atJ++) if (atNum(atH[atJ]) > 0) AT.hidden[atNum(atH[atJ])] = true;\nAT.uncounted = {};\nvar atU = AT.readJson(\"atlas_uncounted\");\nif (Array.isArray(atU)) for (var atV = 0; atV < atU.length; atV++) if (atNum(atU[atV]) > 0) AT.uncounted[atNum(atU[atV])] = true;\nAT.saveUncounted = function () {\n  var out = [];\n  for (var a in AT.uncounted) if (AT.uncounted.hasOwnProperty(a)) out.push(atNum(a));\n  if (out.length) set_variable(\"atlas_uncounted\", JSON.stringify(out)); else delete_variable(\"atlas_uncounted\");\n};\nAT.folded = {};\nvar atF = AT.readJson(\"atlas_folded\");\nif (atF && typeof atF == \"object\" && !Array.isArray(atF)) for (var atG in atF) if (atF.hasOwnProperty(atG) && typeof atF[atG] == \"boolean\") AT.folded[atG] = atF[atG];\n// Kept across a rerun of setup (a reimport): the map in memory, where you\n// are, the explored lists, the view.\nif (AT.map === undefined) AT.map = null;\nif (!AT.state) AT.state = \"idle\";          // idle | loading | ready | failed\nif (AT.note === undefined) AT.note = \"\";\nif (AT.here === undefined) AT.here = null;\n// Explored lists as the game sends them, keyed by the GAME's area number\n// (Room.Info's coords). The crowdmap groups rooms into its own areas, which\n// don't always match the game's (Pash Valley (East) holds rooms the game\n// files elsewhere, Ricardo), so lists are merged into AT.exAll (every room\n// explored, from any list) and a crowdmap area is \"known\" (AT.known) once a\n// list has covered any of its rooms.\nif (!AT.explored || typeof AT.explored != \"object\") AT.explored = {};\nif (!AT.exAll || typeof AT.exAll != \"object\") AT.exAll = {};\nif (!AT.known || typeof AT.known != \"object\") AT.known = {};\nif (!AT.view || typeof AT.view != \"object\") AT.view = { area: null, z: 0, cx: 0, cy: 0, span: 18 };\nAT.spanMin = 6;\nAT.spanMax = 160;\n\nfunction atNum(v) { var n = parseInt(v, 10); return isFinite(n) ? n : 0; }\nfunction atFloat(v) { var n = Number(v); return isFinite(n) ? n : 0; }\n\n// ---- The map ---------------------------------------------------------\n// In memory and in the cache, the crowdmap is kept compact:\n//   { v: version, at: ms, areas: { id: name },\n//     rooms: { id: [area, x, y, z, name, env, exits, specials, fromGame] },\n//     (fromGame 1: a room the game's own map added, see \"The game's own map\")\n//     env: { envId: [r, g, b] } }\n// exits = { direction: room id }; specials = { command: room id } or 0.\n// Everything from the download is treated as data and checked as it's\n// copied: ids are positive whole numbers, names are strings, capped.\nAT.compact = function (src, colors, v) {\n  if (!Array.isArray(src)) return null;\n  var out = { v: String(v || \"\"), at: Date.now(), areas: {}, rooms: {}, env: {}, n: 0 };\n  for (var i = 0; i < src.length; i++) {\n    var A = src[i];\n    if (!A || typeof A != \"object\") continue;\n    var aid = atNum(A.areaId);\n    if (!(aid > 0)) continue;\n    out.areas[aid] = String(A.areaName || (\"area \" + aid)).slice(0, 80);\n    var rs = Array.isArray(A.rooms) ? A.rooms : [];\n    for (var j = 0; j < rs.length; j++) {\n      var r = rs[j];\n      if (!r || typeof r != \"object\") continue;\n      var id = atNum(r.id);\n      if (!(id > 0)) continue;\n      var ex = {}, sp = 0, d, t;\n      if (r.exits && typeof r.exits == \"object\") for (d in r.exits) {\n        if (!r.exits.hasOwnProperty(d)) continue;\n        t = atNum(r.exits[d]);\n        if (t > 0 && /^[a-z]{1,10}$/.test(d)) ex[d] = t;\n      }\n      if (r.specialExits && typeof r.specialExits == \"object\") for (d in r.specialExits) {\n        if (!r.specialExits.hasOwnProperty(d)) continue;\n        t = atNum(r.specialExits[d]);\n        if (t > 0) { if (!sp) sp = {}; sp[String(d).slice(0, 60)] = t; }\n      }\n      out.rooms[id] = [aid, atFloat(r.x), atFloat(r.y), atFloat(r.z), String(r.name || \"\").slice(0, 120), atNum(r.env), ex, sp];\n      out.n++;\n    }\n  }\n  if (Array.isArray(colors)) for (var k = 0; k < colors.length; k++) {\n    var c = colors[k];\n    if (!c || !Array.isArray(c.colors) || c.colors.length < 3) continue;\n    var e = atNum(c.envId);\n    out.env[e] = [0, 1, 2].map(function (q) { var x = atNum(c.colors[q]); return x < 0 ? 0 : (x > 255 ? 255 : x); });\n  }\n  return out.n ? out : null;\n};\n\n// A room by number: { id, a, x, y, z, n, e, ex, sp } or null.\nAT.room = function (id) {\n  var R = AT.map && AT.map.rooms[id];\n  if (!R) return null;\n  return { id: atNum(id), a: R[0], x: R[1], y: R[2], z: R[3], n: R[4], e: R[5], ex: R[6] || {}, sp: R[7] || {} };\n};\n// The room numbers of an area, built once per map.\nAT.areaRooms = function (aid) {\n  if (!AT.map) return [];\n  if (!AT.map.byArea) {\n    var by = {};\n    for (var id in AT.map.rooms) {\n      if (!AT.map.rooms.hasOwnProperty(id)) continue;\n      var a = AT.map.rooms[id][0];\n      (by[a] || (by[a] = [])).push(atNum(id));\n    }\n    AT.map.byArea = by;\n  }\n  return AT.map.byArea[aid] || [];\n};\nAT.areaName = function (aid) { return (AT.map && AT.map.areas[aid]) || (AT.here && AT.here.area === aid && AT.here.areaName) || (\"area \" + aid); };\n\n// ---- Loading ---------------------------------------------------------\nAT.fetchText = function (url) {\n  return fetch(url, { cache: \"no-cache\" }).then(function (r) { if (!r.ok) throw new Error(\"HTTP \" + r.status); return r.text(); });\n};\nAT.fetchJson = function (url) {\n  return fetch(url, { cache: \"no-cache\" }).then(function (r) { if (!r.ok) throw new Error(\"HTTP \" + r.status); return r.json(); });\n};\n// The cache: one IndexedDB database of this page's (play.achaea.com's),\n// shared by every character on this browser (the map is the same for all).\n// Any failure reads as \"no cache\": the map is then downloaded.\nAT.idb = function (mode, key, value) {\n  return new Promise(function (resolve) {\n    var done = false;\n    function end(v) { if (!done) { done = true; resolve(v); } }\n    try {\n      if (typeof indexedDB == \"undefined\" || !indexedDB) return end(null);\n      setTimeout(function () { end(null); }, 8000);\n      var req = indexedDB.open(\"loom-atlas\", 1);\n      req.onupgradeneeded = function () { try { req.result.createObjectStore(\"kv\"); } catch (e) {} };\n      req.onerror = function () { end(null); };\n      req.onsuccess = function () {\n        try {\n          var db = req.result, tx = db.transaction(\"kv\", mode), st = tx.objectStore(\"kv\");\n          if (mode == \"readonly\") {\n            var g = st.get(key);\n            g.onsuccess = function () { var v = g.result; end(v && typeof v == \"object\" ? v : null); };\n            g.onerror = function () { end(null); };\n            tx.oncomplete = function () { try { db.close(); } catch (e) {} };\n          } else {\n            st.put(value, key);\n            tx.oncomplete = function () { try { db.close(); } catch (e) {} end(true); };\n            tx.onerror = function () { end(false); };\n          }\n        } catch (e) { end(null); }\n      };\n    } catch (e) { end(null); }\n  });\n};\nAT.useMap = function (m, source) {\n  m.byArea = null;\n  AT.map = m;\n  for (var og in AT.official) if (AT.official.hasOwnProperty(og)) AT.officialApply(atNum(og));\n  AT.source = source;\n  AT.state = \"ready\";\n  AT.note = \"\";\n  if (AT.here) AT.placeView();\n  AT.rebuildKnown();\n  for (var a in AT.known) if (AT.known.hasOwnProperty(a)) AT.recount(atNum(a));\n  if (client.loom.notify) client.loom.notify(\"atlas\");\n  run_function(\"atlas_render\", { full: true }, \"atlas\");\n  run_function(\"atlas_areas_render\", [], \"atlas\");\n};\n// Load the map: from the cache when its version is the latest (or the\n// latest can't be read), else downloaded. `force` downloads anyway.\nAT.load = function (force) {\n  if (AT.state == \"loading\") return;\n  if (typeof fetch != \"function\") { AT.state = \"failed\"; AT.note = \"this browser can't download\"; return; }\n  AT.state = \"loading\";\n  AT.note = force ? \"downloading the community map…\" : \"loading the community map…\";\n  var gen = AT.gen = (AT.gen || 0) + 1;\n  run_function(\"atlas_render\", { full: true }, \"atlas\");\n  AT.idb(\"readonly\", \"crowdmap\").then(function (cached) {\n    if (cached && !(cached.rooms && cached.areas && typeof cached.rooms == \"object\")) cached = null;\n    return AT.fetchText(AT.base + \"version.txt\").then(function (t) { return String(t).trim().slice(0, 20); }, function () { return null; }).then(function (v) {\n      if (gen !== AT.gen) return;\n      if (cached && !force && (v === null || v === cached.v)) {\n        AT.useMap(cached, v === null ? \"cache (the community map couldn't be checked for updates)\" : \"cache\");\n        return;\n      }\n      if (v === null) throw new Error(\"the community map can't be reached\");\n      return Promise.all([AT.fetchJson(AT.base + \"mapExport.json\"), AT.fetchJson(AT.base + \"colors.json\").catch(function () { return null; })]).then(function (r) {\n        if (gen !== AT.gen) return;\n        var m = AT.compact(r[0], r[1], v);\n        if (!m) throw new Error(\"the community map came in a shape Atlas doesn't know\");\n        AT.idb(\"readwrite\", \"crowdmap\", m);\n        var was = cached ? cached.v : \"\";\n        AT.useMap(m, \"download\");\n        display_notice(\"[atlas] community map \" + (was && was !== m.v ? \"updated to version \" + m.v + \" (was \" + was + \")\" : \"version \" + m.v + \" loaded\") + \": \" + m.n.toLocaleString(\"en-US\") + \" rooms in \" + Object.keys(m.areas).length + \" areas.\", \"lime\");\n      });\n    });\n  }).catch(function (e) {\n    if (gen !== AT.gen) return;\n    AT.state = AT.map ? \"ready\" : \"failed\";\n    AT.note = String((e && e.message) || e);\n    display_notice(\"[atlas] couldn't load the community map: \" + AT.note + \". ATLAS RELOAD to try again.\", \"orange\");\n    run_function(\"atlas_render\", { full: true }, \"atlas\");\n  });\n};\n\n// ---- Environments: the game's names and colours ------------------------------\n// Each area's official map file (the one the stock map fetches when you\n// enter an area, the same for everyone) ends with the environments used in\n// it: <environment id=\"9\" name=\"Hills\" ... htmlcolor=\"#2d7720\" />. Atlas\n// reads it once per area per session and keeps what it learns in the\n// browser (key \"envs\"): { id: { n: name, c: \"#rrggbb\" } }.\nAT.envUrl = \"https://www.achaea.com/maps/v2/\";\nif (!AT.envs || typeof AT.envs != \"object\") AT.envs = {};\nif (!AT.envAsked) AT.envAsked = {};\nAT.envRead = function (xml) {\n  var re = /<environment\\b([^>]*)>/gi, m, got = 0;\n  while ((m = re.exec(String(xml))) !== null) {\n    var at = m[1], id = /\\bid=\"(\\d+)\"/.exec(at), n = /\\bname=\"([^\"]{1,60})\"/.exec(at), c = /\\bhtmlcolor=\"(#[0-9a-fA-F]{6})\"/.exec(at);\n    if (!id) continue;\n    var e = { n: n ? n[1].replace(/&amp;/g, \"&\").replace(/&[a-z#0-9]+;/gi, \"\") : \"\", c: c ? c[1].toLowerCase() : \"\" };\n    var was = AT.envs[id[1]];\n    if (!was || was.n !== e.n || was.c !== e.c) { AT.envs[id[1]] = e; got++; }\n  }\n  return got;\n};\nAT.envFetch = function (aid) {\n  if (!(aid > 0) || AT.envAsked[aid] || typeof fetch != \"function\") return;\n  AT.envAsked[aid] = true;\n  fetch(AT.envUrl + aid + \".xml\").then(function (r) { if (!r.ok) throw new Error(\"HTTP \" + r.status); return r.text(); }).then(function (t) {\n    var envs = AT.envRead(t);\n    if (envs) AT.idb(\"readwrite\", \"envs\", AT.envs);\n    var rooms = AT.officialRead(aid, t);\n    if (rooms) {\n      AT.official[aid] = { at: Date.now(), rooms: rooms };\n      AT.idb(\"readwrite\", \"official\", AT.official);\n    }\n    var changed = rooms && AT.map ? AT.officialApply(aid) : false;\n    if (envs || changed) {\n      run_function(\"atlas_render\", { full: true }, \"atlas\");\n      if (changed) run_function(\"atlas_areas_render\", [], \"atlas\");\n    }\n  }).catch(function () {});\n};\n\n// ---- The game's own map fills the crowdmap's gaps ------------------------------\n// The same file lists every room of the game area, with coordinates and\n// exits. It's always current but has no hidden exits or special paths; the\n// crowdmap has those but can lag behind changes to the game (Delos: room\n// 13927 missing, 14001 east leading past it, Ricardo). So, for each game area\n// you enter:\n//   - a room the crowdmap lacks is added, placed with the offset between the\n//     two maps' coordinates for that area (rooms in both tell it);\n//   - an exit the game lists replaces the crowdmap's in that direction (the\n//     game's is the current one); exits only the crowdmap has are kept.\n// Kept in the browser (key \"official\": { game area: { at, rooms } }) and laid\n// over the map again at each load.\nif (!AT.official || typeof AT.official != \"object\") AT.official = {};\n// rooms: { id: [x, y, z, name, env, exits] } from the file, checked as read.\nAT.officialRead = function (gaid, xml) {\n  var out = {}, n = 0, re = /<room\\b([^>]*)>([\\s\\S]*?)<\\/room>/gi, m;\n  function attr(a, k) { var x = new RegExp(\"\\\\b\" + k + \"=\\\"([^\\\"]*)\\\"\").exec(a); return x ? x[1] : \"\"; }\n  function txt(v) { return String(v).replace(/&amp;/g, \"&\").replace(/&apos;|&#0*39;/g, \"'\").replace(/&quot;/g, '\"').replace(/&lt;/g, \"<\").replace(/&gt;/g, \">\").replace(/&[a-z#0-9]+;/gi, \"\").slice(0, 120); }\n  while ((m = re.exec(String(xml))) !== null) {\n    var id = atNum(attr(m[1], \"id\"));\n    if (!(id > 0)) continue;\n    var c = /<coord\\b([^>]*)\\/?>/i.exec(m[2]);\n    if (!c) continue;\n    var ex = {}, er = /<exit\\b([^>]*)\\/?>/gi, e;\n    while ((e = er.exec(m[2])) !== null) {\n      var d = attr(e[1], \"direction\").toLowerCase(), t = atNum(attr(e[1], \"target\"));\n      if (t > 0 && /^[a-z]{1,10}$/.test(d)) ex[d] = t;\n    }\n    out[id] = [atFloat(attr(c[1], \"x\")), atFloat(attr(c[1], \"y\")), atFloat(attr(c[1], \"z\")), txt(attr(m[1], \"title\")), atNum(attr(m[1], \"environment\")), ex];\n    n++;\n  }\n  return n ? out : null;\n};\n// Lay one game area's rooms over the map. True when anything changed.\nAT.officialApply = function (gaid) {\n  var O = AT.official[gaid], M = AT.map;\n  if (!O || !O.rooms || !M) return false;\n  var rooms = O.rooms, id, dx = [], dy = [], dz = [], added = 0, exits = 0;\n  // The offset between the two maps, per crowdmap area, from rooms in both.\n  var off = {};\n  for (id in rooms) {\n    if (!rooms.hasOwnProperty(id) || !M.rooms[id]) continue;\n    var C = M.rooms[id], G = rooms[id], k = C[0];\n    var o = off[k] || (off[k] = { x: [], y: [], z: [] });\n    o.x.push(C[1] - G[0]); o.y.push(C[2] - G[1]); o.z.push(C[3] - G[2]);\n  }\n  function median(a) { if (!a.length) return 0; a = a.slice().sort(function (p, q) { return p - q; }); return a[Math.floor(a.length / 2)]; }\n  for (var ka in off) if (off.hasOwnProperty(ka)) off[ka] = { x: median(off[ka].x), y: median(off[ka].y), z: median(off[ka].z), n: off[ka].x.length };\n  for (id in rooms) {\n    if (!rooms.hasOwnProperty(id)) continue;\n    var G2 = rooms[id], C2 = M.rooms[id];\n    if (C2) {\n      // Exits: the game's win in their direction.\n      var ex = C2[6] || (C2[6] = {});\n      for (var d in G2[5]) if (G2[5].hasOwnProperty(d) && ex[d] !== G2[5][d]) { ex[d] = G2[5][d]; exits++; }\n      continue;\n    }\n    // A room the crowdmap lacks: in the crowdmap area of its neighbours\n    // (the one most of them are in), else the game's area number.\n    var votes = {}, best = 0, area = M.areas[gaid] ? gaid : 0;\n    for (var d2 in G2[5]) if (G2[5].hasOwnProperty(d2)) { var N = M.rooms[G2[5][d2]]; if (N) votes[N[0]] = (votes[N[0]] || 0) + 1; }\n    for (var va in votes) if (votes.hasOwnProperty(va) && votes[va] > best) { best = votes[va]; area = atNum(va); }\n    if (!area) continue;\n    var o2 = off[area] || { x: 0, y: 0, z: 0 };\n    M.rooms[id] = [area, G2[0] + o2.x, G2[1] + o2.y, G2[2] + o2.z, G2[3], G2[4], JSON.parse(JSON.stringify(G2[5])), 0, 1];\n    added++;\n  }\n  if (added || exits) {\n    M.byArea = null;\n    M.patched = M.patched || {};\n    M.patched[gaid] = { rooms: added, exits: exits };\n    if (added) AT.rebuildKnown();\n  }\n  return !!(added || exits);\n};\nAT.officialLoad = function () {\n  AT.idb(\"readonly\", \"official\").then(function (v) {\n    if (!v || typeof v != \"object\") return;\n    var any = false;\n    for (var g in v) {\n      if (!v.hasOwnProperty(g) || !(atNum(g) > 0) || !v[g] || typeof v[g].rooms != \"object\" || AT.official[g]) continue;\n      AT.official[g] = { at: atNum(v[g].at), rooms: v[g].rooms };\n      if (AT.map && AT.officialApply(atNum(g))) any = true;\n    }\n    if (any) { run_function(\"atlas_render\", { full: true }, \"atlas\"); run_function(\"atlas_areas_render\", [], \"atlas\"); }\n  });\n};\nAT.envLoad = function () {\n  AT.idb(\"readonly\", \"envs\").then(function (v) {\n    if (!v) return;\n    var n = 0;\n    for (var id in v) if (v.hasOwnProperty(id) && /^\\d+$/.test(id) && v[id] && typeof v[id] == \"object\" && !AT.envs[id]) {\n      AT.envs[id] = { n: String(v[id].n || \"\").slice(0, 60), c: /^#[0-9a-f]{6}$/.test(v[id].c) ? v[id].c : \"\" };\n      n++;\n    }\n    if (n) run_function(\"atlas_render\", { full: true }, \"atlas\");\n  });\n};\n\n// ---- Where you are, what you've explored ------------------------------\n// Explored lists Nexus already holds (areas entered before Atlas loaded).\nAT.seedExplored = function () {\n  try {\n    var NC = (typeof nexusclient != \"undefined\" && nexusclient) ? nexusclient : client;\n    var E = NC && NC._datahandler && NC._datahandler.GMCP && NC._datahandler.GMCP.Explored;\n    if (!E || typeof E != \"object\") return;\n    for (var a in E) {\n      if (!E.hasOwnProperty(a) || !E[a] || typeof E[a] != \"object\" || !(atNum(a) > 0)) continue;\n      var ids = [];\n      for (var r in E[a]) if (E[a].hasOwnProperty(r) && atNum(r) > 0) ids.push(atNum(r));\n      AT.addList(atNum(a), ids);\n    }\n  } catch (e) {}\n};\n// One game area's explored list: kept, merged, and the crowdmap areas it\n// covers become known (a list arriving for one marked \"no exploration\n// record\" takes the mark off).\nAT.addList = function (gaid, ids) {\n  var s = AT.explored[gaid] || (AT.explored[gaid] = {});\n  for (var i = 0; i < ids.length; i++) { s[ids[i]] = true; AT.exAll[ids[i]] = true; }\n  AT.markKnown(ids);\n};\nAT.markKnown = function (ids) {\n  if (!AT.map) return;\n  var gone = false;\n  for (var i = 0; i < ids.length; i++) {\n    var R = AT.map.rooms[ids[i]];\n    if (!R || AT.known[R[0]]) continue;\n    AT.known[R[0]] = true;\n    if (AT.uncounted[R[0]]) { delete AT.uncounted[R[0]]; gone = true; }\n  }\n  if (gone) AT.saveUncounted();\n};\n// After the map loads: what the lists cover.\nAT.rebuildKnown = function () {\n  AT.known = {};\n  AT.markKnown(Object.keys(AT.exAll).map(atNum));\n};\n// Room.Info: where you are; an area's explored list when it comes with it.\nAT.roomInfo = function (g) {\n  var id = atNum(g.num);\n  if (!(id > 0)) return;\n  var co = String(g.coords || \"\").split(\",\");\n  var aid = atNum(co[0]);\n  var R = AT.room(id);\n  var gaid = aid > 0 ? aid : (R ? R.a : 0);      // the game's area: whose list this is\n  if (R) aid = R.a;                             // the crowdmap's area: what's drawn\n  var wasG = AT.hereGame || null;\n  AT.hereGame = gaid || null;\n  AT.here = { id: id, area: aid > 0 ? aid : null, name: String(g.name || \"\").replace(/\\s*\\((?:indoors|outdoors|road)\\)\\s*$/i, \"\").slice(0, 120),\n    areaName: String(g.area || \"\").slice(0, 80), onMap: !!R, exits: {} };\n  // The exits the game shows for this room: { destination: true }.\n  if (g.exits && typeof g.exits == \"object\") for (var ex in g.exits) if (g.exits.hasOwnProperty(ex) && atNum(g.exits[ex]) > 0) AT.here.exits[atNum(g.exits[ex])] = true;\n  if (Array.isArray(g.explored) && gaid) {\n    var ids = [];\n    for (var i = 0; i < g.explored.length; i++) { var x = atNum(g.explored[i]); if (x > 0) ids.push(x); }\n    AT.addList(gaid, ids);\n  } else if (gaid && wasG && wasG !== gaid && !AT.explored[gaid] && AT.here.area && !AT.known[AT.here.area] && !AT.counts.hasOwnProperty(AT.here.area) && !AT.uncounted[AT.here.area]) {\n    // Walked into a game area, and no explored list came with it, nor ever\n    // has: the game keeps no record of exploring it.\n    AT.uncounted[AT.here.area] = true;\n    AT.saveUncounted();\n    AT.areasHere = null;\n  }\n  // As Nexus does: the room you're in is explored (once its area's list is known).\n  if (gaid && AT.explored[gaid]) AT.addList(gaid, [id]);\n  if (gaid) AT.envFetch(gaid);          // the official file is per game area\n  AT.placeView();\n  run_function(\"atlas_render\", {}, \"atlas\");\n  // The Areas tab: when a count changed, or you crossed into another area.\n  var counted = AT.here.area ? AT.recount(AT.here.area) : false;\n  if (counted || AT.areasHere !== AT.here.area) { AT.areasHere = AT.here.area; run_function(\"atlas_areas_render\", [], \"atlas\"); }\n};\n\n// ---- Exploration per area (the Areas tab) -------------------------------\n// The rooms you've explored in an area that are on the community map (so a\n// percentage never passes 100%), from the game's list. Saved when it changes.\nAT.countLive = function (aid) {\n  if (!AT.map || !AT.known[aid]) return -1;\n  var ids = AT.areaRooms(aid), n = 0;\n  for (var i = 0; i < ids.length; i++) if (AT.exAll[ids[i]]) n++;\n  return n;\n};\nAT.recount = function (aid) {\n  var n = AT.countLive(aid);\n  if (n < 0 || AT.counts[aid] === n) return false;\n  AT.counts[aid] = n;\n  set_variable(\"atlas_counts\", JSON.stringify(AT.counts));\n  return true;\n};\n// Explored in an area: live when its list came this session, else saved; -1 unknown.\nAT.count = function (aid) {\n  var n = AT.countLive(aid);\n  if (n >= 0) return n;\n  return AT.counts.hasOwnProperty(aid) ? AT.counts[aid] : -1;\n};\n// The game's word order: the crowdmap's \"Delos, the Isle of\" reads \"the Isle of Delos\".\nAT.title = function (aid) {\n  // One name per area, always the community map's (the game's name for the\n  // area you're in made the same area read two ways, Ricardo).\n  // \"Delos, the Isle of (Scarlattan Theatre)\" -> \"the Isle of Delos (Scarlattan\n  // Theatre)\", \"Gheladan, Mount\" -> \"Mount Gheladan\"; a name that isn't one of\n  // these (\"Bataoac, the Northern Giant\") stays as it is.\n  var n = AT.areaName(aid), m = /^(.+?), ((?:the|mount)\\b(?:.*?\\bof)?)(\\s*\\([^)]*\\))?$/i.exec(n);\n  return m ? (m[2] + \" \" + m[1] + (m[3] || \"\")).replace(/\\s+/g, \" \").trim() : n;\n};\n// Sorting by name ignores a leading \"the\".\nAT.sortKey = function (aid) { return AT.title(aid).toLowerCase().replace(/^the\\s+/, \"\"); };\n// An area named at the start of a command's text: \"here\", its number, or its\n// name (the community map's or the game's, \"the\" optional, any case; the\n// longest name that fits). Returns { aid, rest } or null.\nAT.findArea = function (text) {\n  var t = String(text || \"\").trim(), tl = t.toLowerCase().replace(/\\s+/g, \" \");\n  var m = /^here(?:\\s+(.*))?$/i.exec(t);\n  if (m) return AT.here && AT.here.area ? { aid: AT.here.area, rest: (m[1] || \"\").trim() } : null;\n  m = /^(\\d+)(?:\\s+(.*))?$/.exec(t);\n  if (m && AT.map && AT.map.areas[atNum(m[1])]) return { aid: atNum(m[1]), rest: (m[2] || \"\").trim() };\n  if (!AT.map) return null;\n  var best = null, bestLen = 0;\n  for (var a in AT.map.areas) {\n    if (!AT.map.areas.hasOwnProperty(a)) continue;\n    var names = [AT.map.areas[a].toLowerCase(), AT.title(atNum(a)).toLowerCase()];\n    names.push(names[1].replace(/^the /, \"\"));\n    for (var i = 0; i < names.length; i++) {\n      var n = names[i].replace(/\\s+/g, \" \");\n      if (n.length > bestLen && (tl === n || tl.indexOf(n + \" \") === 0)) { best = atNum(a); bestLen = n.length; }\n    }\n  }\n  return best ? { aid: best, rest: t.substring(bestLen).trim() } : null;\n};\nAT.saveTags = function () {\n  var any = false;\n  for (var a in AT.tags) if (AT.tags.hasOwnProperty(a)) { any = true; break; }\n  if (any) set_variable(\"atlas_tags\", JSON.stringify(AT.tags)); else delete_variable(\"atlas_tags\");\n  run_function(\"atlas_areas_render\", [], \"atlas\");\n};\nAT.tag = function (aid, words) {\n  var have = AT.tags[aid] || [], added = [], bad = [];\n  for (var i = 0; i < words.length; i++) {\n    var w = String(words[i] || \"\").toLowerCase();\n    if (!/^[a-z0-9][a-z0-9_-]*$/.test(w)) { bad.push(words[i]); continue; }\n    if (have.indexOf(w) < 0) { have.push(w); added.push(w); }\n  }\n  if (added.length) { AT.tags[aid] = have; AT.saveTags(); display_notice(\"[atlas] \" + AT.title(aid) + \" tagged \" + added.join(\", \") + \".\", \"lime\"); }\n  if (bad.length) display_notice(\"[atlas] not a tag: \" + bad.join(\", \") + \" (one word each: letters, digits, - and _).\", \"orange\");\n  if (!added.length && !bad.length) display_notice(\"[atlas] \" + AT.title(aid) + \" has those tags already.\", \"cyan\");\n};\nAT.untag = function (aid, words) {\n  var have = AT.tags[aid] || [], gone = [];\n  if (words.length === 1 && words[0].toLowerCase() === \"all\") { gone = have.slice(); have = []; }\n  else for (var i = 0; i < words.length; i++) { var k = have.indexOf(String(words[i]).toLowerCase()); if (k >= 0) { gone.push(have[k]); have.splice(k, 1); } }\n  if (!gone.length) { display_notice(\"[atlas] \" + AT.title(aid) + \" has no such tag\" + (have.length ? \" (its tags: \" + have.join(\", \") + \")\" : \"\") + \".\", \"orange\"); return; }\n  if (have.length) AT.tags[aid] = have; else delete AT.tags[aid];\n  AT.saveTags();\n  display_notice(\"[atlas] \" + AT.title(aid) + \": removed tag \" + gone.join(\", \") + \".\", \"lime\");\n};\nAT.setHidden = function (aid, on) {\n  if (on) AT.hidden[aid] = true; else delete AT.hidden[aid];\n  var out = [];\n  for (var a in AT.hidden) if (AT.hidden.hasOwnProperty(a)) out.push(atNum(a));\n  if (out.length) set_variable(\"atlas_hidden\", JSON.stringify(out)); else delete_variable(\"atlas_hidden\");\n  run_function(\"atlas_areas_render\", [], \"atlas\");\n};\nAT.isFolded = function (key) {\n  if (AT.folded.hasOwnProperty(key)) return AT.folded[key];\n  return key === \"unvisited\" || key === \"uncounted\" || key === \"hidden\";\n};\nAT.fold = function (key) {\n  AT.folded[key] = !AT.isFolded(key);\n  set_variable(\"atlas_folded\", JSON.stringify(AT.folded));\n  run_function(\"atlas_areas_render\", [], \"atlas\");\n};\n// Show an area in the Atlas tab without going there: its level with most\n// rooms, centred on them. The next move brings the view back to you.\nAT.showArea = function (aid) {\n  var ids = AT.areaRooms(aid);\n  if (!ids.length) return;\n  var byZ = {}, z = 0, most = -1;\n  for (var i = 0; i < ids.length; i++) { var R = AT.map.rooms[ids[i]]; byZ[R[3]] = (byZ[R[3]] || 0) + 1; }\n  for (var k in byZ) if (byZ.hasOwnProperty(k) && byZ[k] > most) { most = byZ[k]; z = Number(k); }\n  var x0 = Infinity, x1 = -Infinity, y0 = Infinity, y1 = -Infinity;\n  for (var j = 0; j < ids.length; j++) {\n    var Q = AT.map.rooms[ids[j]];\n    if (Q[3] !== z) continue;\n    if (Q[1] < x0) x0 = Q[1]; if (Q[1] > x1) x1 = Q[1];\n    if (-Q[2] < y0) y0 = -Q[2]; if (-Q[2] > y1) y1 = -Q[2];\n  }\n  AT.view.area = aid; AT.view.z = z;\n  AT.view.cx = (x0 + x1) / 2; AT.view.cy = (y0 + y1) / 2;\n  var span = Math.max(x1 - x0, y1 - y0) + 3;\n  AT.view.span = span < AT.spanMin ? AT.spanMin : (span > AT.spanMax ? AT.spanMax : span);\n  run_function(\"atlas_render\", { full: true }, \"atlas\");\n  display_notice(\"[atlas] showing \" + AT.title(aid) + \" in the Atlas tab (⌖ or your next step brings you back).\", \"cyan\");\n};\n// The view follows you: your area, your level, centred on your room.\n// (SVG coordinates: x east, y south, so the map's y is turned over.)\nAT.placeView = function () {\n  var H = AT.here;\n  if (!H) return;\n  var R = AT.room(H.id);\n  if (R) { AT.view.area = R.a; AT.view.z = R.z; AT.view.cx = R.x; AT.view.cy = -R.y; }\n  else if (H.area) { AT.view.area = H.area; }\n};\n\n// ---- Walking ---------------------------------------------------------\nAT.go = function (id) {\n  id = atNum(id);\n  if (!(id > 0)) return;\n  if (get_variable(\"pauseTriggers\") == \"on\") { display_notice(\"[atlas] Loom is paused (LOOM PAUSE OFF to walk).\", \"orange\"); return; }\n  var R = AT.room(id), label = (R && R.n ? R.n + \" \" : \"\") + \"(\" + id + \")\";\n  if (AT.here && AT.here.id === id) { display_notice(\"[atlas] you're in \" + label + \" already.\", \"cyan\"); return; }\n  send_command(\"path find \" + id, 1);\n  display_notice(\"[atlas] walking to \" + label + \".\", \"cyan\");\n};\n\nAT.setFog = function (on) {\n  AT.fog = !!on;\n  if (AT.fog) delete_variable(\"atlas_fog\"); else set_variable(\"atlas_fog\", \"off\");\n  run_function(\"atlas_render\", { full: true }, \"atlas\");\n};\n\n// ---- The view: zoom, pan, levels ----------------------------------------\n// Pan and zoom change the drawn map's viewBox in place; the next full draw\n// takes them from AT.view.\nAT.viewBox = function () {\n  var v = AT.view;\n  return (v.cx - v.span / 2).toFixed(2) + \" \" + (v.cy - v.span / 2).toFixed(2) + \" \" + v.span.toFixed(2) + \" \" + v.span.toFixed(2);\n};\nAT.svgs = function () {\n  try { return Array.prototype.slice.call(document.querySelectorAll(\"svg.loom-atlas-svg\")); } catch (e) { return []; }\n};\n// Zoom and the end of a drag draw the tab again: Nexus shows a tab's HTML\n// as given, and changes made in place may not show until the next draw.\nAT.drawSoon = function () {\n  if (AT.drawT) return;\n  AT.drawT = setTimeout(function () { AT.drawT = null; run_function(\"atlas_render\", { full: true }, \"atlas\"); }, 30);\n};\nAT.zoom = function (f) {\n  var s = AT.view.span * f;\n  AT.view.span = s < AT.spanMin ? AT.spanMin : (s > AT.spanMax ? AT.spanMax : s);\n  AT.drawSoon();\n};\nAT.centre = function () {\n  AT.placeView();\n  run_function(\"atlas_render\", { full: true }, \"atlas\");\n};\nAT.level = function (dir) {\n  var zs = AT.levels(AT.view.area);\n  var i = zs.indexOf(AT.view.z);\n  var j = i < 0 ? 0 : i + dir;\n  if (j < 0 || j >= zs.length) return;\n  AT.view.z = zs[j];\n  run_function(\"atlas_render\", { full: true }, \"atlas\");\n};\n// The levels (z) an area has rooms on, lowest first.\nAT.levels = function (aid) {\n  var ids = AT.areaRooms(aid), seen = {}, out = [];\n  for (var i = 0; i < ids.length; i++) { var z = AT.map.rooms[ids[i]][3]; if (!seen[z]) { seen[z] = 1; out.push(z); } }\n  return out.sort(function (a, b) { return a - b; });\n};\n\n// Dragging pans; a press that moved isn't a click.\nAT.drag = null;\nAT.dragged = false;\nAT.down = function (ev) {\n  if (ev.button !== undefined && ev.button !== 0) return;\n  var el = ev.currentTarget, r = el.getBoundingClientRect();\n  AT.drag = { x: ev.clientX, y: ev.clientY, cx: AT.view.cx, cy: AT.view.cy, upp: AT.view.span / Math.max(r.width, r.height, 1), moved: false };\n};\nAT.move = function (ev) {\n  var D = AT.drag;\n  if (!D) return;\n  var dx = ev.clientX - D.x, dy = ev.clientY - D.y;\n  if (!D.moved && Math.abs(dx) + Math.abs(dy) < 5) return;\n  D.moved = true;\n  AT.view.cx = D.cx - dx * D.upp;\n  AT.view.cy = D.cy - dy * D.upp;\n  var vb = AT.viewBox(), s = AT.svgs();\n  for (var i = 0; i < s.length; i++) s[i].setAttribute(\"viewBox\", vb);\n};\nAT.up = function () {\n  var D = AT.drag;\n  AT.drag = null;\n  if (D && D.moved) {\n    AT.dragged = true;\n    setTimeout(function () { AT.dragged = false; }, 0);\n    run_function(\"atlas_render\", { full: true }, \"atlas\");\n  }\n};\nAT.wheel = function (ev) {\n  try { ev.preventDefault(); } catch (e) {}\n  AT.zoom(ev.deltaY > 0 ? 1.15 : 1 / 1.15);\n};\n\n// ---- What other packages see ----------------------------------------------\n//   look.room(id) -> { id, area, areaName, x, y, z, name } or undefined\n//   look.here()   -> { id, area, name } or undefined\n//   look.explored(area) -> { explored, mapped } or undefined (list not seen)\nAT.look = {\n  room: function (id) { var R = AT.room(id); return R ? { id: R.id, area: R.a, areaName: AT.areaName(R.a), x: R.x, y: R.y, z: R.z, name: R.n } : undefined; },\n  here: function () { return AT.here ? { id: AT.here.id, area: AT.here.area, name: AT.here.name } : undefined; },\n  explored: function (aid) { var n = AT.count(aid); return n < 0 ? undefined : { explored: n, mapped: AT.areaRooms(aid).length }; },\n  tags: function (aid) { return (AT.tags[aid] || []).slice(); }\n};\n\n// The tab's clicks: its page shares window with the scripts.\ntry {\n  window.loomAtlas = {\n    go: function (id) { if (!client.loom.atlas.dragged) client.loom.atlas.go(id); },\n    zoom: function (f) { client.loom.atlas.zoom(f); },\n    centre: function () { client.loom.atlas.centre(); },\n    level: function (d) { client.loom.atlas.level(d); },\n    fog: function () { client.loom.atlas.setFog(!client.loom.atlas.fog); },\n    reload: function () { client.loom.atlas.load(true); },\n    fold: function (i) { var g = client.loom.atlas.groupsDrawn || []; if (g[i] !== undefined) client.loom.atlas.fold(g[i]); },\n    show: function (aid) { client.loom.atlas.showArea(aid); },\n    down: function (ev) { client.loom.atlas.down(ev); },\n    move: function (ev) { client.loom.atlas.move(ev); },\n    up: function (ev) { client.loom.atlas.up(ev); },\n    wheel: function (ev) { client.loom.atlas.wheel(ev); }\n  };\n} catch (e) {}\n\nAT.seedExplored();\nif (AT.map) { AT.rebuildKnown(); for (var atS in AT.known) if (AT.known.hasOwnProperty(atS)) AT.recount(atNum(atS)); }\nif (!AT.envLoaded) { AT.envLoaded = true; AT.envLoad(); AT.officialLoad(); }\nif (client.loom.notify) client.loom.notify(\"atlas\");\n"
  },
  {
   "type": "function",
   "name": "atlas_render",
   "enabled": true,
   "code": "// atlas_render -- the Atlas tab (#451), in the house style shared with Here:\n// ink panel, serif small-caps headings, monospace lines.\n//   - title: Atlas, the area's name, zoom − +, ⌖ (back to you), FOG\n//   - line 2: the room you're in · its number · level (▲▼ to look at the\n//     area's other levels) · explored N · M on the map\n//   - the area's rooms on that level as squares in their environment's\n//     colour, exits as lines; with fog of war, only the rooms you've\n//     explored (and stubs where an exit leads somewhere you haven't been);\n//     without it, unexplored rooms faint; exits to other areas dashed; ▲▼\n//     in a room for up/down; the room you're in ringed\n//   - drag to pan, wheel or − + to zoom, click a room to walk there\n// Every draw is whole (0.1.1): Nexus shows a tab's HTML as given, and a ring\n// moved in place showed only at the next draw.\nif (!client.loom || !client.loom.atlas || !client.loom.atlas.look) run_function(\"atlas_setup\", [], \"atlas\");\nvar AT = client.loom.atlas;\nvar TH = (client.loom && client.loom.theme) || {};\nvar AMBER = TH.acc || \"#e0b46c\";\nvar DEEP = TH.deep || \"#7a5f33\";\nvar TXT = TH.txt || \"#e8e2d6\";\nvar MUTED = TH.muted || \"#8f877a\";\nvar DIM = TH.dim || \"#6d665b\";\nvar RULE = TH.rule || \"#2b2620\";\nvar BG = TH.bg || \"#13110e\";\nvar HI = TH.hi || \"#f0cc8c\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\"); }\nfunction chip(label, fn, tip, on) {\n  return '<span onclick=\"window.loomAtlas&&window.loomAtlas.' + fn + '\" title=\"' + esc(tip) + '\" style=\"flex:none;cursor:pointer;padding:0 5px;border:1px solid ' + (on ? AMBER : DEEP) + ';color:' + (on ? AMBER : MUTED) + ';letter-spacing:0.08em;white-space:nowrap;user-select:none;\">' + label + '</span>';\n}\nfunction lvl(z) { return z === 0 ? \"ground\" : (z > 0 ? \"+\" + z : String(z)); }\nfunction arrow(sym, d, on, tip) {\n  return on ? '<span onclick=\"window.loomAtlas&&window.loomAtlas.level(' + d + ')\" title=\"' + tip + '\" style=\"cursor:pointer;color:' + AMBER + ';padding:0 2px;user-select:none;\">' + sym + '</span>'\n    : '<span style=\"color:' + RULE + ';padding:0 2px;\">' + sym + '</span>';\n}\n// Environment colours: the community map's (Mudlet's bright ones), muted to\n// sit on the ink panel: the same hue, far less saturation, a narrow band of\n// lightness so every room reads and none glares.\nvar envCol = {};\nfunction col(e) {\n  if (envCol[e]) return envCol[e];\n  var o = AT.envs && AT.envs[e];\n  if (o && o.c) return (envCol[e] = o.c);\n  var c = AT.map && AT.map.env[e];\n  if (!c) return (envCol[e] = \"rgb(96,90,80)\");\n  var r = c[0] / 255, g = c[1] / 255, b = c[2] / 255;\n  var mx = Math.max(r, g, b), mn = Math.min(r, g, b), l = (mx + mn) / 2, h = 0, sa = 0, d = mx - mn;\n  if (d) {\n    sa = d / (1 - Math.abs(2 * l - 1));\n    h = mx === r ? ((g - b) / d) % 6 : (mx === g ? (b - r) / d + 2 : (r - g) / d + 4);\n    h *= 60; if (h < 0) h += 360;\n  }\n  return (envCol[e] = \"hsl(\" + Math.round(h) + \",\" + Math.round(sa * 38) + \"%,\" + Math.round(30 + l * 18) + \"%)\");\n}\nfunction areaTitle(aid) { return AT.title(aid); }\n\nvar H = AT.here, V = AT.view, M = AT.map;\nvar aid = V.area;\nvar here = H ? AT.room(H.id) : null;\nvar expl = aid && AT.known[aid] ? AT.exAll : null;   // every explored room, once a list covers this area\nvar fogOn = AT.fog && !!expl;\nvar nExpl = aid ? AT.count(aid) : -1;\nvar roomLine = H ? esc(H.name || \"?\") + ' &middot; ' + H.id : \"\";\n\n{\n  if (AT.drawT) { clearTimeout(AT.drawT); AT.drawT = null; }\n  var html = '<div id=\"loom-atlas\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + BG + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;height:100%;min-height:300px;box-sizing:border-box;display:flex;flex-direction:column;\">';\n\n  // Title: Atlas, the area, the controls.\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\n  html += '<span style=\"display:flex;align-items:baseline;gap:8px;min-width:0;\"><span style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:2px;font-size:15px;color:' + AMBER + ';flex:none;\">Atlas</span>';\n  if (aid) html += '<span style=\"font-family:' + SERIF + ';font-size:13px;color:' + TXT + ';overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">' + esc(areaTitle(aid)) + '</span>';\n  html += '</span><span style=\"display:flex;align-items:baseline;gap:4px;flex:none;\">';\n  if (M) {\n    html += chip('&minus;', 'zoom(1.25)', 'zoom out (or the mouse wheel)') + chip('+', 'zoom(0.8)', 'zoom in (or the mouse wheel)');\n    html += chip('&#8982;', 'centre()', 'back to the room you\\'re in');\n    html += chip('FOG', 'fog()', AT.fog ? 'fog of war on: only the rooms you\\'ve explored (click to show every room)' : 'fog of war off: every room on the map, unexplored ones faint (click to hide them)', AT.fog);\n  }\n  html += '</span></div>';\n\n  // Line 2: the room, its level, explored.\n  if (M && aid) {\n    var zs = AT.levels(aid), zi = zs.indexOf(V.z);\n    var up = zi >= 0 && zi < zs.length - 1, dn = zi > 0;\n    var hereLvl = here && here.a === aid ? here.z : null;\n    html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;padding:3px 0 2px;color:' + MUTED + ';\">';\n    html += '<span class=\"loom-atlas-room\" style=\"min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:' + SERIF + ';font-size:12px;color:' + TXT + ';\">' + roomLine + '</span>';\n    html += '<span style=\"flex:none;white-space:nowrap;\">';\n    if (zs.length > 1) html += arrow('&#9660;', -1, dn, 'the level below') + '<span title=\"the level shown' + (hereLvl !== null && hereLvl !== V.z ? ' (you\\'re on ' + lvl(hereLvl) + ')' : '') + '\" style=\"color:' + (hereLvl !== null && hereLvl !== V.z ? AMBER : MUTED) + ';\">level ' + lvl(V.z) + '</span>' + arrow('&#9650;', 1, up, 'the level above') + ' &middot; ';\n    var mapped = AT.areaRooms(aid).length;\n    html += nExpl >= 0 ? '<span title=\"rooms on the community map you\\'ve explored here (from the game\\'s record), of all the rooms it has in this area\">' + nExpl + ' of ' + mapped + ' explored</span>'\n      : (AT.uncounted[aid] ? '<span title=\"the game sent no explored rooms when you walked in: it keeps no record of exploring this area\">' + mapped + ' rooms &middot; no exploration record</span>'\n      : '<span title=\"the game tells which rooms you\\'ve explored when you enter an area\">' + mapped + ' rooms on the map</span>');\n    html += '</span></div>';\n  }\n\n  // The map.\n  html += '<div style=\"flex:1 1 auto;position:relative;min-height:240px;margin-top:4px;border:1px solid ' + RULE + ';overflow:hidden;\">';\n  if (!M) {\n    var msg = AT.state == \"loading\" ? AT.note || \"loading the community map…\"\n      : (AT.state == \"failed\" ? \"Couldn't load the community map: \" + AT.note + \".\" : \"The community map isn't loaded yet.\");\n    html += '<div style=\"padding:12px;font-family:' + SERIF + ';font-style:italic;font-size:12px;color:' + MUTED + ';\">' + esc(msg);\n    if (AT.state != \"loading\") html += ' <span onclick=\"window.loomAtlas&&window.loomAtlas.reload()\" style=\"cursor:pointer;font-style:normal;font-family:' + MONO + ';font-size:10px;color:' + AMBER + ';border:1px solid ' + DEEP + ';padding:0 5px;letter-spacing:0.08em;\">RELOAD</span>';\n    html += '</div>';\n  } else if (!aid) {\n    html += '<div style=\"padding:12px;font-family:' + SERIF + ';font-style:italic;font-size:12px;color:' + MUTED + ';\">Move or LOOK, and the map follows you.</div>';\n  } else {\n    var DIR = { north: [0, -1], south: [0, 1], east: [1, 0], west: [-1, 0], northeast: [1, -1], northwest: [-1, -1], southeast: [1, 1], southwest: [-1, 1] };\n    var ids = AT.areaRooms(aid), shown = {}, list = [];\n    for (var i = 0; i < ids.length; i++) {\n      var R = AT.room(ids[i]);\n      if (R.z !== V.z) continue;\n      var known = !expl || !!expl[R.id] || (here && here.id === R.id);\n      if (fogOn && !known) continue;\n      shown[R.id] = known ? 1 : 2;           // 2: unexplored, shown faint (fog off)\n      list.push(R);\n    }\n    var lines = '', stubs = '', rooms = '', marks = '';\n    for (var k = 0; k < list.length; k++) {\n      var Q = list[k], qx = Q.x, qy = -Q.y;\n      // Lines only for the eight compass directions: up, down, in and out are\n      // marks inside the room (a line for them read as a compass exit).\n      var ins = { up: 0, down: 0, \"in\": 0, out: 0 }, exl = [];\n      for (var d in Q.ex) {\n        if (!Q.ex.hasOwnProperty(d)) continue;\n        // With fog, an exit shows only when it leads somewhere explored (the\n        // crowdmap has hidden exits too, Ricardo), or it's one the game lists\n        // for the room you're in.\n        if (fogOn && !AT.exAll[Q.ex[d]] && !(here && Q.id === here.id && H.exits && H.exits[Q.ex[d]])) continue;\n        exl.push(d);\n        if (ins.hasOwnProperty(d)) { ins[d] = 1; continue; }\n        var v = DIR[d];\n        if (!v) continue;\n        var to = Q.ex[d], T = AT.room(to);\n        if (T && T.a === aid && T.z === V.z && shown[to]) {\n          if (Q.id < to || !(T.ex && Object.keys(T.ex).some(function (kk) { return DIR[kk] && T.ex[kk] === Q.id; })))\n            lines += '<line x1=\"' + qx + '\" y1=\"' + qy + '\" x2=\"' + T.x + '\" y2=\"' + (-T.y) + '\"' + (shown[to] === 2 || shown[Q.id] === 2 ? ' opacity=\"0.4\"' : '') + '/>';\n        } else {\n          var other = T && T.a !== aid;\n          var nv = Math.sqrt(v[0] * v[0] + v[1] * v[1]), ux = v[0] / nv, uy = v[1] / nv;\n          var len = other ? 0.78 : 0.6;\n          var tx = qx + ux * len, ty = qy + uy * len;\n          var tip = '<title>' + esc(d + (other ? ' to ' + areaTitle(T.a) : (T && T.z !== V.z ? ' (another level)' : ' (somewhere you haven\\'t explored)'))) + '</title>';\n          if (other) {\n            // Into another area: a line ending in an arrowhead, as on the stock map.\n            var bx = tx - ux * 0.2, by = ty - uy * 0.2;\n            stubs += '<g stroke=\"' + AMBER + '\" fill=\"' + AMBER + '\">' + tip +\n              '<line x1=\"' + qx + '\" y1=\"' + qy + '\" x2=\"' + bx.toFixed(2) + '\" y2=\"' + by.toFixed(2) + '\"/>' +\n              '<path stroke-width=\"0.02\" d=\"M' + tx.toFixed(2) + ' ' + ty.toFixed(2) + ' L' + (bx - uy * 0.12).toFixed(2) + ' ' + (by + ux * 0.12).toFixed(2) + ' L' + (bx + uy * 0.12).toFixed(2) + ' ' + (by - ux * 0.12).toFixed(2) + ' Z\"/></g>';\n          } else {\n            stubs += '<line x1=\"' + qx + '\" y1=\"' + qy + '\" x2=\"' + tx.toFixed(2) + '\" y2=\"' + ty.toFixed(2) + '\" stroke=\"' + DIM + '\" stroke-dasharray=\"0.06 0.08\">' + tip + '</line>';\n          }\n        }\n      }\n      var faint = shown[Q.id] === 2;\n      rooms += '<rect class=\"loom-atlas-r\" x=\"' + (qx - 0.3) + '\" y=\"' + (qy - 0.3) + '\" width=\"0.6\" height=\"0.6\" rx=\"0.08\" fill=\"' + col(Q.e) + '\"' + (faint ? ' opacity=\"0.35\"' : '') +\n        ' onclick=\"window.loomAtlas&&window.loomAtlas.go(' + Q.id + ')\"><title>' + esc((Q.n || \"?\") + \" (\" + Q.id + \")\" + (AT.envs && AT.envs[Q.e] && AT.envs[Q.e].n ? \" · \" + AT.envs[Q.e].n : \"\") + (exl.length ? \" · exits: \" + exl.join(\", \") : \"\") + (faint ? \" · not explored\" : \"\") + \" · click to walk here\") + '</title></rect>';\n      // As the stock map: one arrow in the middle of the room (▲ up, ▼ down,\n      // ◀ in, ▶ out); up and down together an hourglass (▼ over ▲, tips\n      // meeting), in and out together the same on its side. With both pairs,\n      // up/down keep the middle and in/out sit small at the sides.\n      var vU = ins.up, vD = ins.down, hI = ins[\"in\"], hO = ins.out, both = (vU || vD) && (hI || hO);\n      function tri(cx, cy, dir, w, h) {\n        // dir: 0 up, 1 down, 2 left, 3 right; (cx, cy) the middle of the triangle's box.\n        var a = w / 2, b = h / 2, P;\n        if (dir === 0) P = [[cx - a, cy + b], [cx, cy - b], [cx + a, cy + b]];\n        else if (dir === 1) P = [[cx - a, cy - b], [cx, cy + b], [cx + a, cy - b]];\n        else if (dir === 2) P = [[cx + b, cy - a], [cx - b, cy], [cx + b, cy + a]];\n        else P = [[cx - b, cy - a], [cx + b, cy], [cx - b, cy + a]];\n        return '<path d=\"M' + P.map(function (p) { return p[0].toFixed(3) + ' ' + p[1].toFixed(3); }).join(' L') + ' Z\"/>';\n      }\n      if (vU && vD) marks += tri(qx, qy - 0.075, 1, 0.3, 0.15) + tri(qx, qy + 0.075, 0, 0.3, 0.15);\n      else if (vU) marks += tri(qx, qy, 0, 0.32, 0.26);\n      else if (vD) marks += tri(qx, qy, 1, 0.32, 0.26);\n      if (both) {\n        if (hI) marks += tri(qx - 0.21, qy, 2, 0.18, 0.1);\n        if (hO) marks += tri(qx + 0.21, qy, 3, 0.18, 0.1);\n      } else if (hI && hO) marks += tri(qx - 0.075, qy, 3, 0.3, 0.15) + tri(qx + 0.075, qy, 2, 0.3, 0.15);\n      else if (hI) marks += tri(qx, qy, 2, 0.32, 0.26);\n      else if (hO) marks += tri(qx, qy, 3, 0.32, 0.26);\n    }\n    var ring = '';\n    if (here && here.a === aid) {\n      ring = '<g class=\"loom-atlas-me\" transform=\"translate(' + here.x + ' ' + (-here.y) + ')\"' + (here.z !== V.z ? ' opacity=\"0.35\"' : '') + ' pointer-events=\"none\">' +\n        '<circle r=\"0.48\" fill=\"none\" stroke=\"' + AMBER + '\" stroke-width=\"0.09\"/></g>';\n    }\n    html += '<svg class=\"loom-atlas-svg\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"' + AT.viewBox() + '\" preserveAspectRatio=\"xMidYMid slice\" style=\"position:absolute;inset:0;width:100%;height:100%;display:block;cursor:grab;touch-action:none;\"' +\n      ' onpointerdown=\"window.loomAtlas&&window.loomAtlas.down(event)\" onpointermove=\"window.loomAtlas&&window.loomAtlas.move(event)\" onpointerup=\"window.loomAtlas&&window.loomAtlas.up(event)\" onpointerleave=\"window.loomAtlas&&window.loomAtlas.up(event)\" onwheel=\"window.loomAtlas&&window.loomAtlas.wheel(event)\">';\n    html += '<g stroke=\"' + MUTED + '\" stroke-width=\"0.07\" stroke-linecap=\"round\">' + lines + '</g>';\n    html += '<g stroke-width=\"0.07\" stroke-linecap=\"round\">' + stubs + '</g>';\n    html += '<g stroke=\"' + BG + '\" stroke-width=\"0.04\">' + rooms + '</g>';\n    // The arrows outlined in black so they read on light rooms too (Ricardo).\n    html += '<g fill=\"' + TXT + '\" stroke=\"#000\" stroke-width=\"0.06\" stroke-linejoin=\"round\" paint-order=\"stroke\" pointer-events=\"none\">' + marks + '</g>';\n    html += ring + '</svg>';\n    if (!list.length) html += '<div style=\"position:absolute;left:12px;top:12px;font-family:' + SERIF + ';font-style:italic;font-size:12px;color:' + MUTED + ';\">' + (ids.length ? \"Nothing explored on this level yet.\" : \"This area isn't on the community map.\") + '</div>';\n  }\n  html += '</div>';\n\n  // Footer: what's missing, where the map comes from.\n  var foot = [];\n  if (H && !here) foot.push(\"This room (\" + H.id + \") isn't on the community map\" + (aid ? \"; showing its area.\" : \".\"));\n  if (M && aid && !expl && !AT.uncounted[aid]) foot.push(\"Fog of war starts once you enter an area: the game sends its explored rooms then.\");\n  if (AT.state == \"loading\" && M) foot.push(AT.note);\n  if (M) foot.push(\"Community map version \" + M.v + \". Drag to pan, click a room to walk there.\");\n  html += '<div style=\"margin-top:5px;font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + MUTED + ';\">' + foot.map(esc).join(\" \") + '</div>';\n  html += '</div>';\n\n  // The whole tab in the panel's colour (#355); rooms light up under the mouse.\n  try {\n    var atSt = document.getElementById(\"loom-atlas-style\");\n    if (!atSt) { atSt = document.createElement(\"style\"); atSt.id = \"loom-atlas-style\"; document.head.appendChild(atSt); }\n    var atCss = '.flexlayout__tab:has(#loom-atlas) { background: ' + BG + ' !important; } .flexlayout__tab:has(#loom-atlas) > * { min-height: 100%; height: 100%; } ' +\n      '#loom-atlas .loom-atlas-r { cursor: pointer; } #loom-atlas .loom-atlas-r:hover { stroke: ' + HI + '; stroke-width: 0.08; } #loom-atlas svg:active { cursor: grabbing; }';\n    if (atSt.textContent !== atCss) atSt.textContent = atCss;\n  } catch (e) {}\n  try { set_custom_tab_html(\"Atlas\", html); } catch (e) {}\n}\n"
  },
  {
   "type": "function",
   "name": "atlas_areas_render",
   "enabled": true,
   "code": "// atlas_areas_render -- the Areas tab (#451), in the house style:\n//   - title: Areas, and how many you've visited of the areas on the map\n//   - totals: rooms explored of rooms mapped in the areas you've visited,\n//     and of every room on the map, each with a bar\n//   - your tags as groups (an area under each of its tags), then untagged,\n//     then \"not visited yet\" and \"hidden\" (both folded at first); a heading\n//     folds its group and gives its own totals\n//   - a row: the area's name, explored / mapped and the percentage, a thin\n//     bar under it; the area you're in marked HERE; a click shows the area\n//     in the Atlas tab\n// An area is \"visited\" once Atlas has seen its explored rooms (the game\n// sends them when you enter it); counts are kept per character.\nif (!client.loom || !client.loom.atlas || !client.loom.atlas.look) run_function(\"atlas_setup\", [], \"atlas\");\nvar AT = client.loom.atlas;\nvar TH = (client.loom && client.loom.theme) || {};\nvar AMBER = TH.acc || \"#e0b46c\";\nvar DEEP = TH.deep || \"#7a5f33\";\nvar TXT = TH.txt || \"#e8e2d6\";\nvar MUTED = TH.muted || \"#8f877a\";\nvar DIM = TH.dim || \"#6d665b\";\nvar RULE = TH.rule || \"#2b2620\";\nvar BG = TH.bg || \"#13110e\";\nvar TRACK = TH.track || \"#2b2620\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\"); }\nfunction fmt(n) { return Number(n).toLocaleString(\"en-US\"); }\n// Whole percentages, rounded down (100% only when complete); the totals,\n// small for a long time, get a decimal below 10%.\nfunction pct(a, b, dec) {\n  if (!b) return \"—\";\n  var p = a / b * 100;\n  if (dec && p > 0 && p < 10) return (Math.floor(p * 10) / 10).toFixed(1) + \"%\";\n  return (p > 0 && p < 1 ? \"&lt;1\" : Math.floor(p)) + \"%\";\n}\n// No exploration record: a folded map crossed out in red, after the name.\nvar NOREC = ' <span title=\"no exploration record: the game sent no explored rooms when you walked in, so this area counts for no total\" style=\"display:inline-block;vertical-align:-2px;margin-left:3px;\">' +\n  '<svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\"><path d=\"M1.5 3.2 L5.5 1.8 L10.5 3.6 L14.5 2.2 V12.8 L10.5 14.2 L5.5 12.4 L1.5 13.8 Z\" fill=\"none\" stroke=\"' + MUTED + '\" stroke-width=\"1.1\" stroke-linejoin=\"round\"/>' +\n  '<path d=\"M5.5 1.8 V12.4 M10.5 3.6 V14.2\" stroke=\"' + MUTED + '\" stroke-width=\"0.9\"/><path d=\"M3 3.5 L13 12.5 M13 3.5 L3 12.5\" stroke=\"#d9534f\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg></span>';\nfunction bar(a, b, h) {\n  var w = b ? Math.min(100, a / b * 100) : 0;\n  return '<div style=\"height:' + h + 'px;background:' + TRACK + ';margin-top:2px;\"><div style=\"height:100%;width:' + w.toFixed(1) + '%;background:' + (w >= 100 ? AMBER : DEEP) + ';\"></div></div>';\n}\n\nvar M = AT.map;\nvar html = '<div id=\"loom-atlas-areas\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + BG + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;min-height:100%;box-sizing:border-box;display:flex;flex-direction:column;\">';\n\nif (!M) {\n  html += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:2px;font-size:15px;color:' + AMBER + ';border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">Areas</div>';\n  html += '<div style=\"margin-top:8px;font-family:' + SERIF + ';font-style:italic;font-size:12px;color:' + MUTED + ';\">' + (AT.state == \"loading\" ? \"Loading the community map…\" : \"The community map isn't loaded: ATLAS RELOAD.\") + '</div>';\n} else {\n  // Every area with rooms, sorted by name; visited, unvisited, hidden.\n  var all = [], vis = [], unv = [], hid = [];\n  for (var a in M.areas) {\n    if (!M.areas.hasOwnProperty(a)) continue;\n    var aid = Number(a), mapped = AT.areaRooms(aid).length;\n    if (!mapped) continue;\n    var e = { aid: aid, mapped: mapped, n: AT.count(aid), key: AT.sortKey(aid) };\n    all.push(e);\n  }\n  all.sort(function (x, y) { return x.key < y.key ? -1 : (x.key > y.key ? 1 : 0); });\n  var tot = { n: 0, m: 0, mAll: 0 };\n  for (var i = 0; i < all.length; i++) {\n    var E = all[i];\n    if (AT.hidden[E.aid]) { hid.push(E); continue; }\n    // An area without an exploration record sits in its groups like any\n    // visited one, with no figures, and counts for no total (Ricardo).\n    if (AT.uncounted[E.aid] && E.n < 0) { E.unc = true; vis.push(E); continue; }\n    tot.mAll += E.mapped;\n    if (E.n >= 0) { vis.push(E); tot.n += Math.min(E.n, E.mapped); tot.m += E.mapped; }\n    else unv.push(E);\n  }\n\n  // Title.\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\n  html += '<span style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:2px;font-size:15px;color:' + AMBER + ';\">Areas</span>';\n  html += '<span style=\"color:' + MUTED + ';\">' + vis.length + ' of ' + (vis.length + unv.length) + ' visited</span></div>';\n\n  // Totals.\n  html += '<div style=\"margin:6px 0 4px;padding:5px 6px;border:1px solid ' + RULE + ';\">';\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;\" title=\"rooms you\\'ve explored in the areas you\\'ve visited, of the rooms the community map has there\">' +\n    '<span style=\"font-family:' + SERIF + ';font-size:13px;\">In the areas you\\'ve visited</span><span><span style=\"color:' + MUTED + ';\">' + fmt(tot.n) + ' / ' + fmt(tot.m) + '</span> <span style=\"color:' + AMBER + ';\">' + pct(tot.n, tot.m, true) + '</span></span></div>' + bar(tot.n, tot.m, 4);\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-top:5px;\" title=\"rooms you\\'ve explored, of every room on the community map (hidden areas left out)\">' +\n    '<span style=\"font-family:' + SERIF + ';font-size:13px;\">Of the whole map</span><span><span style=\"color:' + MUTED + ';\">' + fmt(tot.n) + ' / ' + fmt(tot.mAll) + '</span> <span style=\"color:' + AMBER + ';\">' + pct(tot.n, tot.mAll, true) + '</span></span></div>' + bar(tot.n, tot.mAll, 4);\n  html += '</div>';\n\n  // Groups: each tag (alphabetical), then untagged; then not visited, hidden.\n  var groups = {}, order = [];\n  var put = function (key, E) { if (!groups[key]) { groups[key] = []; order.push(key); } groups[key].push(E); };\n  for (var v = 0; v < vis.length; v++) {\n    var tg = AT.tags[vis[v].aid];\n    if (!tg || !tg.length) put(\"tag:\", vis[v]);\n    else for (var t = 0; t < tg.length; t++) put(\"tag:\" + tg[t], vis[v]);\n  }\n  order.sort(function (x, y) { if (x === \"tag:\") return 1; if (y === \"tag:\") return -1; return x < y ? -1 : (x > y ? 1 : 0); });\n  if (unv.length) { groups.unvisited = unv; order.push(\"unvisited\"); }\n  if (hid.length) { groups.hidden = hid; order.push(\"hidden\"); }\n  AT.groupsDrawn = order.slice();\n  var hereA = AT.here && AT.here.area;\n  var anyTag = order.some(function (k) { return k.indexOf(\"tag:\") === 0 && k !== \"tag:\"; });\n\n  for (var g = 0; g < order.length; g++) {\n    var key = order[g], rows = groups[key], folded = AT.isFolded(key);\n    var label = key === \"unvisited\" ? \"not visited yet\" : key === \"hidden\" ? \"hidden\"\n      : key === \"tag:\" ? (anyTag ? \"untagged\" : \"visited\") : key.substring(4);\n    var gn = 0, gm = 0, hasHere = false;\n    for (var r = 0; r < rows.length; r++) { if (!rows[r].unc) gm += rows[r].mapped; if (rows[r].n > 0) gn += Math.min(rows[r].n, rows[r].mapped); if (rows[r].aid === hereA) hasHere = true; }\n    var stat = key === \"unvisited\" || key === \"hidden\" ? rows.length + (rows.length === 1 ? ' area' : ' areas') + ' &middot; ' + fmt(gm) + ' rooms'\n      : rows.length + (rows.length === 1 ? ' area' : ' areas') + ' &middot; ' + fmt(gn) + ' / ' + fmt(gm) + ' &middot; <span style=\"color:' + AMBER + ';\">' + pct(gn, gm) + '</span>';\n    html += '<div onclick=\"window.loomAtlas&&window.loomAtlas.fold(' + g + ')\" title=\"click to ' + (folded ? 'open' : 'fold') + '\" style=\"cursor:pointer;user-select:none;display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-top:7px;padding:2px 0;border-bottom:1px solid ' + RULE + ';\">';\n    html += '<span style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:1.5px;font-size:13px;color:' + (hasHere ? AMBER : TXT) + ';\">' + (folded ? '&#9656; ' : '&#9662; ') + esc(label) + (hasHere ? ' <span style=\"font-family:' + MONO + ';font-variant:normal;font-size:9px;letter-spacing:0.08em;\">&#9673; HERE</span>' : '') + '</span>';\n    html += '<span style=\"flex:none;color:' + MUTED + ';\">' + stat + '</span></div>';\n    if (folded) continue;\n    for (var q = 0; q < rows.length; q++) {\n      var R = rows[q], isHere = R.aid === hereA, seen = R.n >= 0 || R.unc;\n      var tags = AT.tags[R.aid] || [];\n      var tip = AT.title(R.aid) + ' (area ' + R.aid + ')' + (tags.length ? ' · tags: ' + tags.join(', ') : '') + ' · click to show it in Atlas · ATLAS TAG ' + R.aid + ' <tag> to group it';\n      html += '<div onclick=\"window.loomAtlas&&window.loomAtlas.show(' + R.aid + ')\" title=\"' + esc(tip) + '\" class=\"loom-atlas-arow\" style=\"cursor:pointer;padding:3px 4px 2px;' + (isHere ? 'background:rgba(224,180,108,0.08);' : '') + '\">';\n      html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;\">';\n      html += '<span style=\"min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:' + SERIF + ';font-size:13px;color:' + (isHere ? AMBER : (seen ? TXT : MUTED)) + ';\">' + esc(AT.title(R.aid)) + (R.unc ? NOREC : '') + '</span>';\n      html += '<span style=\"flex:none;white-space:nowrap;color:' + MUTED + ';\">' + (isHere ? '<span style=\"color:' + AMBER + ';letter-spacing:0.08em;\">HERE &middot; </span>' : '') +\n        (R.unc ? fmt(R.mapped) + ' rooms' : seen ? fmt(Math.min(R.n, R.mapped)) + ' / ' + fmt(R.mapped) + ' <span style=\"display:inline-block;min-width:4ch;text-align:right;color:' + (R.n >= R.mapped ? AMBER : TXT) + ';\">' + pct(R.n, R.mapped) + '</span>' : fmt(R.mapped) + ' rooms') + '</span></div>';\n      if (seen && !R.unc) html += bar(R.n, R.mapped, 2);\n      html += '</div>';\n    }\n  }\n  if (!vis.length) html += '<div style=\"margin-top:8px;font-family:' + SERIF + ';font-style:italic;font-size:12px;color:' + MUTED + ';\">No area visited yet: the game tells which rooms you\\'ve explored when you enter an area.</div>';\n  html += '<div style=\"margin-top:auto;padding-top:6px;font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + MUTED + ';\">Click a heading to fold it, an area to see it in Atlas. ATLAS TAG HERE &lt;tag&gt; groups the area you\\'re in; ATLAS HIDE keeps an area out of the totals.</div>';\n}\nhtml += '</div>';\n\n// The whole tab in the panel's colour (#355); rows light up under the mouse.\ntry {\n  var aaSt = document.getElementById(\"loom-atlas-areas-style\");\n  if (!aaSt) { aaSt = document.createElement(\"style\"); aaSt.id = \"loom-atlas-areas-style\"; document.head.appendChild(aaSt); }\n  var aaCss = '.flexlayout__tab:has(#loom-atlas-areas) { background: ' + BG + ' !important; } .flexlayout__tab:has(#loom-atlas-areas) > * { min-height: 100%; } ' +\n    '#loom-atlas-areas .loom-atlas-arow:hover { background: rgba(224,180,108,0.05); }';\n  if (aaSt.textContent !== aaCss) aaSt.textContent = aaCss;\n} catch (e) {}\ntry { set_custom_tab_html(\"Areas\", html); } catch (e) {}\n"
  },
  {
   "type": "function",
   "name": "atlas_help",
   "enabled": true,
   "code": "// atlas_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[atlas] the community map in the Atlas tab, with the rooms you've explored. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"ATLAS\", \"status: the map's version, fog of war, where you are and how much of the area you've explored\"],\n  [\"ATLAS FOG [ON|OFF]\", \"fog of war: only the rooms you've explored (default ON); OFF shows every room, unexplored ones faint\"],\n  [\"ATLAS GO <room number>\", \"walk there (PATH FIND), as a click on a room in the tab\"],\n  [\"ATLAS AREAS\", \"how many areas you've visited and how much of them you've explored (the Areas tab lists them)\"],\n  [\"ATLAS TAG <area|number|HERE> <tag> [tag…]\", \"group an area under your own tags in the Areas tab (one word each; e.g. sapience, meropis)\"],\n  [\"ATLAS UNTAG <area|number|HERE> <tag>|ALL\", \"take a tag off an area, or all of them\"],\n  [\"ATLAS TAGS\", \"every tag in use, with how many areas carry it\"],\n  [\"ATLAS HIDE <area|number|HERE>\", \"keep an area out of the Areas list and the totals (houses, manses…); UNHIDE brings it back\"],\n  [\"ATLAS SHOW <area|number>\", \"show an area in the Atlas tab without going there (as a click in the Areas tab)\"],\n  [\"ATLAS RELOAD\", \"download the community map again (it's otherwise kept in this browser and updated when it changes)\"],\n  [\"ATLAS DEBUG\", \"internal state\"],\n  [\"The tabs are custom tabs named Atlas (the map) and Areas (exploration per area). Atlas: drag to pan, mouse wheel or - + to zoom, the arrows by 'level' look up and down.\"],\n  [\"An area's name can be the community map's or the game's, with or without 'the', in any case: ATLAS TAG granite hills sapience.\"],\n  [\"The map is the Achaea crowdmap, kept by players at github.com/IRE-Mudlet-Mapping/AchaeaCrowdmap.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "Atlas control",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// ATLAS [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.atlas || !client.loom.atlas.look) run_function(\"atlas_setup\", [], \"atlas\");\nvar AT = client.loom.atlas;\nvar atRaw = String(args[1] || \"\").trim();\nvar atSp = atRaw.search(/\\s/);\nvar atCmd = (atSp < 0 ? atRaw : atRaw.substring(0, atSp)).toLowerCase();\nvar atRest = atSp < 0 ? \"\" : atRaw.substring(atSp).trim();\nif (atCmd === \"\" || atCmd === \"status\") {\n  var atMap = AT.map ? \"community map version \" + AT.map.v + \" (\" + AT.map.n.toLocaleString(\"en-US\") + \" rooms, \" + Object.keys(AT.map.areas).length + \" areas, from \" + AT.source + \")\"\n    : (AT.state == \"loading\" ? \"the community map is loading\" : \"no map loaded\" + (AT.note ? \" (\" + AT.note + \")\" : \"\") + \": ATLAS RELOAD\");\n  var atHere = \"\";\n  if (AT.here) {\n    var atE = AT.here.area ? AT.look.explored(AT.here.area) : undefined;\n    atHere = \" Here: \" + (AT.here.name || \"?\") + \" (\" + AT.here.id + \")\" + (AT.here.area ? \" in \" + AT.areaName(AT.here.area) : \"\") + (AT.here.onMap ? \"\" : \", not on the community map\") +\n      (atE ? \"; explored \" + atE.explored + \" of the \" + atE.mapped + \" rooms mapped there.\" : \".\");\n  }\n  display_notice(\"[atlas] \" + atMap + \". Fog of war \" + (AT.fog ? \"on\" : \"off\") + \".\" + atHere, \"cyan\");\n} else if (atCmd === \"help\") {\n  run_function(\"atlas_help\", [], \"atlas\");\n} else if (atCmd === \"reload\") {\n  if (AT.state == \"loading\") display_notice(\"[atlas] the community map is loading already.\", \"cyan\");\n  else { display_notice(\"[atlas] downloading the community map again.\", \"cyan\"); AT.load(true); }\n} else if (atCmd === \"fog\") {\n  var atF = atRest.toLowerCase();\n  if (atF === \"on\" || atF === \"off\") { AT.setFog(atF === \"on\"); display_notice(\"[atlas] fog of war \" + atF + (atF === \"on\" ? \": only the rooms you've explored.\" : \": every room on the map, unexplored ones faint.\"), \"lime\"); }\n  else if (!atF) display_notice(\"[atlas] fog of war is \" + (AT.fog ? \"on\" : \"off\") + \". ATLAS FOG ON|OFF.\", \"cyan\");\n  else display_notice(\"[atlas] ATLAS FOG ON|OFF.\", \"orange\");\n} else if (atCmd === \"go\") {\n  if (/^\\d+$/.test(atRest)) AT.go(atRest);\n  else display_notice(\"[atlas] ATLAS GO <room number>.\", \"orange\");\n} else if (atCmd === \"tag\" || atCmd === \"untag\") {\n  var atTa = AT.findArea(atRest);\n  if (!atTa || !atTa.rest) display_notice(\"[atlas] ATLAS \" + atCmd.toUpperCase() + \" <area|number|HERE> <tag> [tag…]\" + (atCmd === \"untag\" ? \", or ALL\" : \"\") + (AT.map ? \"\" : \" (the map isn't loaded)\") + \".\", \"orange\");\n  else if (atCmd === \"tag\") AT.tag(atTa.aid, atTa.rest.split(/\\s+/));\n  else AT.untag(atTa.aid, atTa.rest.split(/\\s+/));\n} else if (atCmd === \"tags\") {\n  var atTc = {}, atTn = [];\n  for (var atTk in AT.tags) if (AT.tags.hasOwnProperty(atTk)) for (var atTi = 0; atTi < AT.tags[atTk].length; atTi++) { var atTw = AT.tags[atTk][atTi]; if (!atTc[atTw]) { atTc[atTw] = 0; atTn.push(atTw); } atTc[atTw]++; }\n  atTn.sort();\n  display_notice(atTn.length ? \"[atlas] tags: \" + atTn.map(function (t) { return t + \" (\" + atTc[t] + \")\"; }).join(\", \") + \".\" : \"[atlas] no tags yet: ATLAS TAG HERE <tag> tags the area you're in.\", \"cyan\");\n} else if (atCmd === \"hide\" || atCmd === \"unhide\") {\n  var atHa = AT.findArea(atRest);\n  if (!atHa || atHa.rest) display_notice(\"[atlas] ATLAS \" + atCmd.toUpperCase() + \" <area|number|HERE>\" + (atHa && atHa.rest ? \": '\" + atHa.rest + \"' isn't part of an area's name\" : \"\") + \".\", \"orange\");\n  else if (!!AT.hidden[atHa.aid] === (atCmd === \"hide\")) display_notice(\"[atlas] \" + AT.title(atHa.aid) + \" is \" + (atCmd === \"hide\" ? \"hidden\" : \"shown\") + \" already.\", \"cyan\");\n  else { AT.setHidden(atHa.aid, atCmd === \"hide\"); display_notice(\"[atlas] \" + AT.title(atHa.aid) + (atCmd === \"hide\" ? \" hidden: out of the Areas list and the totals.\" : \" shown again in the Areas tab.\"), \"lime\"); }\n} else if (atCmd === \"show\") {\n  var atSa = AT.findArea(atRest);\n  if (!atSa || atSa.rest) display_notice(\"[atlas] ATLAS SHOW <area|number>.\", \"orange\");\n  else AT.showArea(atSa.aid);\n} else if (atCmd === \"areas\") {\n  var atVn = 0, atN = 0, atM = 0, atAll = 0, atU = 0;\n  for (var atAa in AT.map ? AT.map.areas : {}) {\n    if (!AT.map.areas.hasOwnProperty(atAa) || AT.hidden[atAa]) continue;\n    var atMp = AT.areaRooms(Number(atAa)).length, atCn = AT.count(Number(atAa));\n    if (!atMp) continue;\n    atAll += atMp;\n    if (atCn >= 0) { atVn++; atN += Math.min(atCn, atMp); atM += atMp; } else atU++;\n  }\n  if (!AT.map) display_notice(\"[atlas] the community map isn't loaded: ATLAS RELOAD.\", \"orange\");\n  else display_notice(\"[atlas] visited \" + atVn + \" of \" + (atVn + atU) + \" areas; explored \" + atN.toLocaleString(\"en-US\") + \" of their \" + atM.toLocaleString(\"en-US\") + \" rooms (\" + (atM ? Math.floor(atN / atM * 100) : 0) + \"%), \" + (atAll ? (atN / atAll * 100).toFixed(1) : 0) + \"% of the whole map. The Areas tab lists them.\", \"cyan\");\n} else if (atCmd === \"debug\") {\n  var atEx = [];\n  for (var atA in AT.explored) if (AT.explored.hasOwnProperty(atA)) atEx.push(atA + \":\" + Object.keys(AT.explored[atA]).length);\n  atEx.push(\"game area here \" + AT.hereGame + \", known crowdmap areas \" + Object.keys(AT.known).join(\"/\"));\n  display_notice(\"[atlas] state=\" + AT.state + \" source=\" + (AT.source || \"-\") + \" note=\" + (AT.note || \"-\") + \" here=\" + JSON.stringify(AT.here) + \" view=\" + JSON.stringify(AT.view) + \" explored={\" + atEx.join(\", \") + \"} tabs=\" + AT.svgs().length, \"cyan\");\n} else {\n  display_notice(\"[atlas] unknown command '\" + atCmd + \"'. ATLAS HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^atlas(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  }
 ],
 "description": "A map tab from the community crowdmap, with the rooms you've explored as fog"
}