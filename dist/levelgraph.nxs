{
 "type": "group",
 "name": "levelgraph",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"levelgraph_setup\", [], \"levelgraph\");\ndisplay_notice(\"[levelgraph] installed. Create a UI tab named 'Level' for the panel. LEVELGRAPH HELP for commands.\", \"lime\");\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"levelgraph_gmcp\", [], \"levelgraph\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; the levelgraph_* variables are left intact.\n// Leave LOOM and the integrations at once, not at the next load (#137):\n// loom takes the entry out and redraws the tabs that showed this package's answers.\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"levelgraph\");\n  else delete client.loom.registry.levelgraph;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"Level\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 18 16\"><rect x=\"1\" y=\"11\" width=\"4\" height=\"4\" fill=\"#4d6f86\"/><rect x=\"7\" y=\"7\" width=\"4\" height=\"8\" fill=\"#8fbfe0\" fill-opacity=\"0.7\"/><rect x=\"13\" y=\"2\" width=\"4\" height=\"13\" fill=\"#8fbfe0\"/><path d=\"M13 1.5 L15 0 L17 1.5\" fill=\"none\" stroke=\"#e8f3fb\" stroke-width=\"0.8\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\nrun_function(\"levelgraph_setup\", [], \"levelgraph\");\nrun_function(\"levelgraph_render\", [], \"levelgraph\");\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"levelgraph_gmcp\", [], \"levelgraph\");\n"
  },
  {
   "type": "function",
   "name": "levelgraph_gmcp",
   "enabled": true,
   "code": "// levelgraph_gmcp -- the work behind onGMCP, as a function made once per load\n// (client.loom.hooks.levelgraph.gmcp). Nexus compiles a script afresh every time it\n// runs, and long ones cost on every GMCP message, so the script itself stays two\n// lines and calls this (#136). Run from onLoad and onInstall, so a reimport\n// replaces it.\nif (!client.loom) client.loom = {};\nif (!client.loom.hooks) client.loom.hooks = {};\nif (!client.loom.hooks.levelgraph) client.loom.hooks.levelgraph = {};\nclient.loom.hooks.levelgraph.gmcp = function (args) {\n  // Level and percent to the next level come from GMCP: Char.Vitals carries\n  // nl (a whole percent) on every prompt, and its charstats line\n  // \"Level: 54 (23.45%)\" the precise figure when present; Char.Status carries\n  // the level. A sample is taken on each Char.Vitals, so once per prompt,\n  // whatever the prompt looks like.\n  var lgM = \"\";\n  var lgA = null;\n  try { lgM = args.gmcp_method; lgA = args.gmcp_args; } catch (e) { lgM = \"\"; }\n  if ((lgM === \"Char.Vitals\" || lgM === \"Char.Status\") && lgA) {\n    if (typeof lgA === \"string\") { try { lgA = JSON.parse(lgA); } catch (e) { lgA = null; } }\n    if (lgA) {\n      if (!client.loom || !client.loom.levelgraph || !client.loom.levelgraph.day) run_function(\"levelgraph_setup\", [], \"levelgraph\");\n      var LG = client.loom.levelgraph;\n      if (lgM === \"Char.Status\" && lgA.level !== undefined) {\n        var lgS = String(lgA.level).match(/(\\d+)(?:\\s*\\(([\\d.]+)%\\))?/);\n        if (lgS) {\n          LG.level = parseInt(lgS[1], 10);\n          if (lgS[2] !== undefined) LG.nl = parseFloat(lgS[2]);\n        }\n      }\n      if (lgM === \"Char.Vitals\") {\n        var lgP = null;\n        if (lgA.charstats) {\n          for (var lgI = 0; lgI < lgA.charstats.length; lgI++) {\n            var lgC = String(lgA.charstats[lgI]).match(/Level:\\s*(\\d+)\\s*\\(([\\d.]+)%\\)/);\n            if (lgC) { lgP = lgC; break; }\n          }\n        }\n        if (lgP) {\n          LG.level = parseInt(lgP[1], 10);\n          LG.nl = parseFloat(lgP[2]);\n        } else if (lgA.nl !== undefined) {\n          // Whole percent only: keep a precise figure already held for it.\n          var lgN = parseFloat(lgA.nl);\n          if (!isNaN(lgN) && (LG.nl === undefined || Math.floor(LG.nl) !== lgN)) LG.nl = lgN;\n        }\n        run_function(\"levelgraph_sample\", [], \"levelgraph\");\n      }\n    }\n  }\n};\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// onGMCP: the work is in levelgraph_gmcp (#136: this runs on every GMCP message, so it stays short).\nvar lkH = client.loom && client.loom.hooks && client.loom.hooks.levelgraph;\nif (!lkH || !lkH.gmcp) { run_function(\"levelgraph_gmcp\", [], \"levelgraph\"); lkH = client.loom.hooks.levelgraph; }\nlkH.gmcp(args);\n"
  },
  {
   "type": "function",
   "name": "levelgraph_setup",
   "enabled": true,
   "code": "// levelgraph_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, one-time migration of the\n// lvl_* variables, then the two buffers and settings, each built if missing.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.levelgraph) client.loom.levelgraph = {};\nclient.loom.registry.levelgraph = { version: \"1.0.1\", keyword: \"LEVELGRAPH\", desc: \"Level progress graphs per minute and per day, time to next level\",\n  // Redrawn by loom when the tab theme changes (#310).\n  redraw: function () { run_function(\"levelgraph_render\", [], \"levelgraph\"); } };\nvar LG = client.loom.levelgraph;\n\n// One-time migration: lvl_* -> levelgraph_*. A new variable that already\n// holds data wins; the old one is deleted either way. The older lvl_hist is\n// folded into the day buffer below, then deleted too.\nvar lgMoves = [\"min\", \"day\", \"graph_long\", \"graph_sess\", \"graph_h\", \"span_days\", \"span_mins\"];\nfor (var lgI = 0; lgI < lgMoves.length; lgI++) {\n  var lgOld;\n  try { lgOld = get_variable(\"lvl_\" + lgMoves[lgI]); } catch (e) { lgOld = undefined; }\n  if (lgOld !== undefined && lgOld !== null) {\n    var lgNew;\n    try { lgNew = get_variable(\"levelgraph_\" + lgMoves[lgI]); } catch (e) { lgNew = undefined; }\n    if (lgNew === undefined || lgNew === null || lgNew === \"\" || lgNew === \"[]\") set_variable(\"levelgraph_\" + lgMoves[lgI], lgOld);\n    delete_variable(\"lvl_\" + lgMoves[lgI]);\n  }\n}\n// The old package kept its state in nine loose client.lvl* keys; drop them so\n// a reimport without a page reload doesn't leave two copies around. Buffers\n// still in memory carry over.\nif (client.lvlMin && !LG.min) LG.min = client.lvlMin;\nif (client.lvlDay && !LG.day) LG.day = client.lvlDay;\nvar lgOldKeys = [\"lvlChartH\", \"lvlDay\", \"lvlDays\", \"lvlForceMark\", \"lvlGraphLong\", \"lvlGraphSess\", \"lvlLastWrite\", \"lvlMin\", \"lvlMins\"];\nfor (var lgJ = 0; lgJ < lgOldKeys.length; lgJ++) {\n  if (client[lgOldKeys[lgJ]] !== undefined) delete client[lgOldKeys[lgJ]];\n}\n\n// Two independent ring buffers, each bounded by construction:\n//   levelgraph_day  one point per calendar day, trailing 100 days  (long-term trend)\n//   levelgraph_min  one point per wall-clock minute, trailing 120  (current session)\n// Both store [unixSeconds, level, nl]. Progress is level + nl/100.\nfunction lvlDayKey(t) {\n  var d = new Date(t * 1000);\n  return d.getFullYear() * 10000 + d.getMonth() * 100 + d.getDate();\n}\nfunction lvlLoadArr(name) {\n  var a = [];\n  try { a = JSON.parse(get_variable(name)) || []; } catch (e) { a = []; }\n  if (Object.prototype.toString.call(a) !== \"[object Array]\") { a = []; }\n  return a;\n}\nfunction lvlNum(name, def, lo, hi) {\n  var v = def;\n  try { if (get_variable(name) !== undefined) { v = parseInt(get_variable(name), 10); } } catch (e) { v = def; }\n  if (!v || isNaN(v) || v < lo) { v = def; }\n  if (v > hi) { v = hi; }\n  return v;\n}\n\nif (!LG.min) { LG.min = lvlLoadArr(\"levelgraph_min\"); }\n\nif (!LG.day) {\n  var day = lvlLoadArr(\"levelgraph_day\");\n  if (day.length === 0) {\n    // One-time migration: fold any legacy lvl_hist down to one point per day\n    // so previously collected history is not thrown away.\n    var old = lvlLoadArr(\"lvl_hist\");\n    var lastKey = \"\";\n    for (var mi = 0; mi < old.length; mi++) {\n      var k = lvlDayKey(old[mi][0]);\n      if (k === lastKey && day.length > 0) { day[day.length - 1] = old[mi]; }\n      else { day.push(old[mi]); lastKey = k; }\n    }\n    if (day.length > 0) {\n      try { set_variable(\"levelgraph_day\", JSON.stringify(day)); } catch (e) {}\n    }\n  }\n  try { if (get_variable(\"lvl_hist\") !== undefined && get_variable(\"lvl_hist\") !== null) delete_variable(\"lvl_hist\"); } catch (e) {}\n  LG.day = day;\n}\n\nif (LG.graphLong === undefined) {\n  var gl = \"1\";\n  try { if (get_variable(\"levelgraph_graph_long\") !== undefined) { gl = String(get_variable(\"levelgraph_graph_long\")); } } catch (e) { gl = \"1\"; }\n  LG.graphLong = (gl !== \"0\");\n}\nif (LG.graphSess === undefined) {\n  var gs = \"1\";\n  try { if (get_variable(\"levelgraph_graph_sess\") !== undefined) { gs = String(get_variable(\"levelgraph_graph_sess\")); } } catch (e) { gs = \"1\"; }\n  LG.graphSess = (gs !== \"0\");\n}\nif (LG.chartH === undefined) { LG.chartH = lvlNum(\"levelgraph_graph_h\", 105, 40, 400); }\nif (LG.days === undefined) { LG.days = lvlNum(\"levelgraph_span_days\", 100, 7, 365); }\nif (LG.mins === undefined) { LG.mins = lvlNum(\"levelgraph_span_mins\", 120, 15, 720); }\n\n// The session (#335, Ricardo: as COFFERS does, independent of the graph's\n// span): opened by the first sample, closed by LEVELGRAPH NEW or by a silence\n// longer than the gap (LEVELGRAPH GAP, levelgraph_gap, default 30 minutes).\n// Its gain, rate and time to the next level count from its start.\n//   LG.sess  {s, last, p0}: start and last sample (unix seconds), progress at\n//            the start (level + percent/100); saved as levelgraph_sess\nif (LG.gap === undefined) { LG.gap = lvlNum(\"levelgraph_gap\", 30, 5, 240); }\nif (LG.sess === undefined) {\n  var lgSs = null;\n  try { lgSs = JSON.parse(get_variable(\"levelgraph_sess\") || \"null\"); } catch (e) { lgSs = null; }\n  if (!lgSs || typeof lgSs !== \"object\" || !(lgSs.s > 0) || !(lgSs.last >= lgSs.s) || typeof lgSs.p0 !== \"number\" || isNaN(lgSs.p0)) lgSs = null;\n  LG.sess = lgSs;\n}\nLG.saveSess = function () {\n  try { if (LG.sess) set_variable(\"levelgraph_sess\", JSON.stringify(LG.sess)); else delete_variable(\"levelgraph_sess\"); } catch (e) {}\n  LG.sessSaved = Math.floor(Date.now() / 1000);\n};\n// Deaths (#336): [[unix seconds, killer], ...], newest last, saved as\n// levelgraph_deaths. Kept as long as the minute graph can show them (its span),\n// at most LG.deathCap.\nLG.deathCap = 50;\nif (!Array.isArray(LG.deaths)) {\n  var lgDs = null;\n  try { lgDs = JSON.parse(get_variable(\"levelgraph_deaths\") || \"[]\"); } catch (e) { lgDs = null; }\n  LG.deaths = Array.isArray(lgDs) ? lgDs.filter(function (d) { return Array.isArray(d) && d[0] > 0 && typeof d[1] == \"string\"; }) : [];\n}\nLG.addDeath = function (by) {\n  var now = Math.floor(Date.now() / 1000), keep = now - LG.mins * 60;\n  LG.deaths.push([now, by || \"?\"]);\n  LG.deaths = LG.deaths.filter(function (d) { return d[0] >= keep; }).slice(-LG.deathCap);\n  try { set_variable(\"levelgraph_deaths\", JSON.stringify(LG.deaths)); } catch (e) {}\n};\n// The open session's figures, or null: {span (s), gain (levels), perHour, togo (s, -1 unknown), p0, s}.\nLG.sessFigures = function (cur) {\n  var S = LG.sess;\n  if (!S || !cur) return null;\n  var span = S.last - S.s;\n  var gain = (cur[1] + cur[2] / 100) - S.p0;\n  var perHour = span >= 60 ? gain / (span / 3600) : 0;\n  var togo = perHour > 0 ? (1 - cur[2] / 100) / perHour * 3600 : -1;\n  return { span: span, gain: gain, perHour: perHour, togo: togo, p0: S.p0, s: S.s };\n};"
  },
  {
   "type": "function",
   "name": "levelgraph_sample",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.levelgraph || !client.loom.levelgraph.day) run_function(\"levelgraph_setup\", [], \"levelgraph\");\nvar LG = client.loom.levelgraph;\n// Level and percent to next level, as the onGMCP handler last read them.\nvar lv = parseFloat(LG.level);\nvar nl = parseFloat(LG.nl);\nif (isNaN(lv)) { lv = 0; }\nif (isNaN(nl)) { nl = 0; }\nif (nl < 0) { nl = 0; }\nif (nl > 100) { nl = 100; }\n\nif (lv > 0) {\n  var now = Math.floor(new Date().getTime() / 1000);\n  var nlr = Math.round(nl * 100) / 100;\n  var force = LG.forceMark ? true : false;\n  LG.forceMark = false;\n  var wrote = false;\n\n  // Absolute buckets rather than elapsed time. Sliding a point's timestamp\n  // within its own bucket cannot move it to another bucket, so no separate\n  // anchor is needed to decide when a new point begins.\n  function minKey(t) { return Math.floor(t / 60); }\n  function dayKey(t) {\n    var d = new Date(t * 1000);\n    return d.getFullYear() * 10000 + d.getMonth() * 100 + d.getDate();\n  }\n\n  function dayStart(t) {\n    var d = new Date(t * 1000);\n    d.setHours(0, 0, 0, 0);\n    return Math.floor(d.getTime() / 1000);\n  }\n\n  // Session buffer ticks once a minute whether or not experience moved, so\n  // the pane reads as a clock over the trailing window. Idle time is a flat\n  // segment rather than a gap.\n  function feedMin() {\n    var arr = LG.min;\n    if (arr.length === 0) { arr.push([now, lv, nlr]); return true; }\n    var last = arr[arr.length - 1];\n    if (minKey(last[0]) !== minKey(now)) { arr.push([now, lv, nlr]); return true; }\n    if (last[1] !== lv || last[2] !== nlr) {\n      last[0] = now; last[1] = lv; last[2] = nlr;\n      return true;\n    }\n    return false;\n  }\n\n  // Day buffer carries the last known value across days that were never\n  // played, so a week away shows as a week of flat line rather than a jump.\n  function feedDay() {\n    var arr = LG.day;\n    if (arr.length === 0) { arr.push([now, lv, nlr]); return true; }\n    var last = arr[arr.length - 1];\n    if (dayKey(last[0]) === dayKey(now)) {\n      if (last[1] !== lv || last[2] !== nlr) {\n        last[0] = now; last[1] = lv; last[2] = nlr;\n        return true;\n      }\n      return false;\n    }\n    var carryLv = last[1];\n    var carryNl = last[2];\n    var cut = now - LG.days * 86400;\n    var todayStart = dayStart(now);\n    // Step by calendar date rather than by 86400 so daylight saving does not\n    // drift the cursor off midnight.\n    var cur = new Date(dayStart(last[0]) * 1000);\n    cur.setDate(cur.getDate() + 1);\n    var guard = 0;\n    while (Math.floor(cur.getTime() / 1000) < todayStart && guard < 400) {\n      var noon = Math.floor(cur.getTime() / 1000) + 43200;\n      if (noon >= cut) { arr.push([noon, carryLv, carryNl]); }\n      cur.setDate(cur.getDate() + 1);\n      guard++;\n    }\n    arr.push([now, lv, nlr]);\n    return true;\n  }\n\n  // The session: a silence longer than the gap closes it; the next sample\n  // opens a new one (#335).\n  var prg = lv + nlr / 100;\n  if (LG.sess && now - LG.sess.last > LG.gap * 60) { LG.sess = null; }\n  if (!LG.sess) { LG.sess = { s: now, last: now, p0: prg }; LG.saveSess(); }\n  else {\n    LG.sess.last = now;\n    if (now - (LG.sessSaved || 0) >= 60) { LG.saveSess(); }\n  }\n\n  if (feedMin()) { wrote = true; }\n  if (feedDay()) { wrote = true; }\n\n  // Trailing windows: anything older than the span simply falls off the front.\n  var minCut = now - LG.mins * 60;\n  while (LG.min.length > 0 && LG.min[0][0] < minCut) { LG.min.shift(); }\n  var dayCut = now - LG.days * 86400;\n  while (LG.day.length > 0 && LG.day[0][0] < dayCut) { LG.day.shift(); }\n\n  var lastWrite = LG.lastWrite || 0;\n  if (wrote && (force || (now - lastWrite) >= 5)) {\n    LG.lastWrite = now;\n    try { set_variable(\"levelgraph_min\", JSON.stringify(LG.min)); } catch (e) {}\n    try { set_variable(\"levelgraph_day\", JSON.stringify(LG.day)); } catch (e) {}\n    run_function(\"levelgraph_render\", [], \"levelgraph\");\n  }\n}"
  },
  {
   "type": "function",
   "name": "levelgraph_render",
   "enabled": true,
   "code": "// Draws the Level tab in the house style shared with Coffers: ink panel,\n// serif small-caps headings, one large figure, monospace ledger rows.\n// Nexus tabs will not run injected <script>, so charts are static inline SVG,\n// redrawn whenever a new sample lands.\nif (!client.loom || !client.loom.levelgraph || !client.loom.levelgraph.day) run_function(\"levelgraph_setup\", [], \"levelgraph\");\nvar LG = client.loom.levelgraph;\nvar MN = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"];\n// Tab theme (#310): loom's city palette when one is on, else this tab's own colours.\nvar TH = (client.loom && client.loom.theme) || {};\nvar ACC = TH.acc || \"#8fbfe0\";\nvar ACC2 = \"#c8a2d8\";\nvar DEEP = TH.deep || \"#4d6f86\";\nvar BRIGHT = TH.hi || \"#e8f3fb\";\nvar TXT = TH.txt || \"#dde8ee\";\nvar MUTED = TH.muted || \"#7d8c96\";\nvar RULE = TH.rule || \"#26353e\";\nvar TRACK = TH.track || \"#1a252c\";\nvar BG = TH.bg || \"#0f1418\";\nvar UP = \"#8fe0c8\";\nvar DEATH = \"#d9534f\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\n\nfunction n1(n) { return Math.round(n * 10) / 10; }\nfunction pad2(n) { return (n < 10 ? \"0\" : \"\") + n; }\nfunction prog(p) { return p[1] + p[2] / 100; }\nfunction dur(secs) {\n  if (secs < 3600) { return Math.max(0, Math.round(secs / 60)) + \"m\"; }\n  if (secs >= 86400) { return Math.round(secs / 86400 * 10) / 10 + \"d\"; }\n  var h = Math.floor(secs / 3600);\n  var m = Math.round((secs - h * 3600) / 60);\n  return h + \"h\" + (m > 0 ? \" \" + m + \"m\" : \"\");\n}\n// dayScale is set by the pane, not inferred from the data span: the long-term\n// pane must read as dates even on its first day, when it holds only hours.\nfunction fmtT(sec, span, dayScale) {\n  var d = new Date(sec * 1000);\n  if (dayScale) {\n    if (span < 300 * 86400) { return d.getDate() + \" \" + MN[d.getMonth()]; }\n    return MN[d.getMonth()] + \" \" + d.getFullYear();\n  }\n  return d.getHours() + \":\" + pad2(d.getMinutes());\n}\n\nfunction lvlChart(hs, W, H, accent, dayScale, deaths) {\n  var fs = Math.max(7, Math.min(10, Math.round(H * 0.085)));\n  var y0 = Math.round(fs * 0.9);\n  var y1 = H - Math.round(fs * 1.9);\n  var first = hs[0];\n  var last = hs[hs.length - 1];\n  var tmin = first[0];\n  var tmax = last[0];\n  if (tmax <= tmin) { tmax = tmin + 60; }\n  var span = tmax - tmin;\n\n  var vmin = 1e9, vmax = -1e9, i, v;\n  for (i = 0; i < hs.length; i++) { v = prog(hs[i]); if (v < vmin) { vmin = v; } if (v > vmax) { vmax = v; } }\n  if ((vmax - vmin) < 0.0005) { vmin -= 0.01; vmax += 0.01; }\n  var padV = (vmax - vmin) * 0.12;\n  vmin = Math.max(0, vmin - padV);\n  vmax += padV;\n\n  var steps = [0.001, 0.002, 0.005, 0.01, 0.02, 0.05, 0.1, 0.25, 0.5, 1, 2, 5, 10, 25, 50, 100];\n  var stepv = steps[steps.length - 1];\n  for (i = 0; i < steps.length; i++) { if ((vmax - vmin) / steps[i] <= 5) { stepv = steps[i]; break; } }\n  var dp = stepv < 0.01 ? 3 : (stepv < 1 ? 2 : 0);\n\n  var widest = 2;\n  var probe = Math.ceil(vmin / stepv) * stepv;\n  while (probe <= vmax) { widest = Math.max(widest, (dp === 0 ? String(Math.round(probe)) : probe.toFixed(dp)).length); probe += stepv; }\n  var x0 = Math.round(widest * fs * 0.62) + 6;\n  var x1 = W - 6;\n\n  var svg = '<svg viewBox=\"0 0 ' + W + ' ' + H + '\" width=\"100%\" style=\"display:block;height:auto;overflow:visible;\" xmlns=\"http://www.w3.org/2000/svg\">';\n  // Whole-level gridlines are drawn stronger: they are the boundaries crossed.\n  var gv = Math.ceil(vmin / stepv) * stepv;\n  while (gv <= vmax) {\n    var gy = n1(y1 - ((gv - vmin) / (vmax - vmin)) * (y1 - y0));\n    var whole = (Math.abs(gv - Math.round(gv)) < 0.0005);\n    svg += '<line x1=\"' + x0 + '\" y1=\"' + gy + '\" x2=\"' + x1 + '\" y2=\"' + gy + '\" stroke=\"' + (whole ? DEEP : RULE) + '\" stroke-width=\"' + (whole ? 0.9 : 0.6) + '\"/>';\n    svg += '<text x=\"' + (x0 - 3) + '\" y=\"' + n1(gy + fs * 0.35) + '\" text-anchor=\"end\" font-family=\"' + MONO + '\" font-size=\"' + fs + '\" fill=\"' + MUTED + '\">' + (dp === 0 ? String(Math.round(gv)) : gv.toFixed(dp)) + '</text>';\n    gv += stepv;\n  }\n  var stride = Math.ceil(hs.length / 320);\n  var line = \"\";\n  var k = 0;\n  for (i = 0; i < hs.length; i += stride) {\n    line += (k === 0 ? \"M\" : \"L\") + n1(x0 + ((hs[i][0] - tmin) / (tmax - tmin)) * (x1 - x0)) + \",\" + n1(y1 - ((prog(hs[i]) - vmin) / (vmax - vmin)) * (y1 - y0));\n    k++;\n  }\n  var lx = n1(x0 + ((last[0] - tmin) / (tmax - tmin)) * (x1 - x0));\n  var ly = n1(y1 - ((prog(last) - vmin) / (vmax - vmin)) * (y1 - y0));\n  line += \"L\" + lx + \",\" + ly;\n  var area = line + \"L\" + lx + \",\" + y1 + \"L\" + x0 + \",\" + y1 + \"Z\";\n  svg += '<path d=\"' + area + '\" fill=\"' + accent + '\" fill-opacity=\"0.13\" stroke=\"none\"/>';\n  svg += '<path d=\"' + line + '\" fill=\"none\" stroke=\"' + accent + '\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/>';\n  svg += '<circle cx=\"' + lx + '\" cy=\"' + ly + '\" r=\"2.4\" fill=\"' + BRIGHT + '\"/>';\n  // Deaths (#336): a thin red rule and a skull at the top, the killer on hover.\n  for (var di = 0; deaths && di < deaths.length; di++) {\n    var dt = deaths[di][0];\n    if (dt < tmin || dt > tmax + 60) continue;\n    var dx = n1(x0 + ((Math.min(dt, tmax) - tmin) / (tmax - tmin)) * (x1 - x0));\n    var dTip = \"Slain by \" + String(deaths[di][1]).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\") + \" at \" + fmtT(dt, 0, false);\n    svg += '<g style=\"cursor:default;\"><title>' + dTip + '</title>';\n    svg += '<line x1=\"' + dx + '\" y1=\"' + (y0 + 7) + '\" x2=\"' + dx + '\" y2=\"' + y1 + '\" stroke=\"' + DEATH + '\" stroke-width=\"0.8\" stroke-dasharray=\"2,2\"/>';\n    svg += '<g transform=\"translate(' + n1(dx - 4.5) + ',' + (y0 - 4) + ')\"><path d=\"M4.5 0C2 0 0 1.8 0 4.2c0 1.5.7 2.6 1.8 3.2V9h5.4V7.4C8.3 6.8 9 5.7 9 4.2 9 1.8 7 0 4.5 0Z\" fill=\"' + DEATH + '\"/>';\n    svg += '<circle cx=\"3\" cy=\"4.3\" r=\"1.1\" fill=\"' + BG + '\"/><circle cx=\"6\" cy=\"4.3\" r=\"1.1\" fill=\"' + BG + '\"/><rect x=\"3.4\" y=\"7.4\" width=\"0.7\" height=\"1.6\" fill=\"' + BG + '\"/><rect x=\"4.9\" y=\"7.4\" width=\"0.7\" height=\"1.6\" fill=\"' + BG + '\"/></g>';\n    svg += '<rect x=\"' + n1(dx - 6) + '\" y=\"' + (y0 - 5) + '\" width=\"12\" height=\"' + n1(y1 - y0 + 5) + '\" fill=\"transparent\"/></g>';\n  }\n  svg += '<text x=\"' + x0 + '\" y=\"' + (H - 3) + '\" font-family=\"' + MONO + '\" font-size=\"' + fs + '\" fill=\"' + MUTED + '\">' + fmtT(first[0], span, dayScale) + '</text>';\n  svg += '<text x=\"' + x1 + '\" y=\"' + (H - 3) + '\" text-anchor=\"end\" font-family=\"' + MONO + '\" font-size=\"' + fs + '\" fill=\"' + MUTED + '\">' + fmtT(last[0], span, dayScale) + '</text>';\n  return svg + '</svg>';\n}\n\n// Ledger typography, matching Coffers.\nfunction caps(t, col) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (col || DEEP) + ';font-size:11px;margin:0 0 2px;\">' + t + '</div>'; }\nfunction row(label, value, col) {\n  return '<div style=\"display:flex;justify-content:space-between;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"color:' + MUTED + ';white-space:nowrap;\">' + label + '</span><span style=\"color:' + (col || TXT) + ';white-space:nowrap;\">' + value + '</span></div>';\n}\nfunction box(inner, col) { return '<div style=\"flex:1 1 150px;min-width:150px;border-top:2px solid ' + (col || DEEP) + ';padding:3px 2px 0;\">' + inner + '</div>'; }\nfunction big(t, col) { return '<div style=\"font-family:' + SERIF + ';font-size:16px;color:' + col + ';\">' + t + '</div>'; }\nfunction section(title, inner, col) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title, col) + inner + '</div>'; }\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';\">' + t + '</div>'; }\n\n// A small rising-stair glyph for the title, the level-up counterpart of the coin stack.\nvar glyph = '<svg width=\"18\" height=\"16\" viewBox=\"0 0 18 16\" style=\"vertical-align:-2px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<rect x=\"1\" y=\"11\" width=\"4\" height=\"4\" fill=\"' + DEEP + '\"/><rect x=\"7\" y=\"7\" width=\"4\" height=\"8\" fill=\"' + ACC + '\" fill-opacity=\"0.7\"/>' +\n  '<rect x=\"13\" y=\"2\" width=\"4\" height=\"13\" fill=\"' + ACC + '\"/><path d=\"M13 1.5 L15 0 L17 1.5\" fill=\"none\" stroke=\"' + BRIGHT + '\" stroke-width=\"0.8\"/></svg>';\n\nvar mins = LG.min || [];\nvar days = LG.day || [];\nvar cur = null;\nif (mins.length > 0) { cur = mins[mins.length - 1]; }\nelse if (days.length > 0) { cur = days[days.length - 1]; }\n\nvar html = '<div id=\"loom-levelgraph\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + BG + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;min-height:100%;box-sizing:border-box;\">';\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\nhtml += '<div style=\"font-family:' + SERIF + ';color:' + ACC + ';font-size:14px;letter-spacing:0.22em;\">' + glyph + 'LEVEL</div>';\n\nif (!cur) {\n  html += '</div><div style=\"color:' + MUTED + ';margin-top:8px;font-family:' + SERIF + ';font-style:italic;\">No samples yet. Play a little, or use LEVELGRAPH MARK.</div></div>';\n} else {\n  // Session figures (#335): gain since the session started, rate, and time\n  // to level; the graph below keeps its own span.\n  var sF = LG.sessFigures ? LG.sessFigures(cur) : null;\n  var sSpan = sF ? sF.span : 0, sGain = sF ? sF.gain : 0, perHour = sF ? sF.perHour : 0, togo = sF ? sF.togo : -1;\n  // Long-term figures: gain across the daily buffer.\n  var lSpan = 0, lGain = 0, perDay = 0;\n  if (days.length >= 2) {\n    lSpan = days[days.length - 1][0] - days[0][0];\n    lGain = prog(days[days.length - 1]) - prog(days[0]);\n    if (lSpan > 0) { perDay = lGain / (lSpan / 86400); }\n  }\n\n  html += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + DEEP + ';font-size:11px;\">' + (togo > 0 ? 'next in ~' + dur(togo) : 'onward') + '</div></div>';\n\n  html += '<div style=\"margin:6px 0 1px;\"><span style=\"font-family:' + SERIF + ';font-size:26px;color:' + ACC + ';\">' + cur[1] + '</span>';\n  // Days at this level: walk the day buffer back while the level matches. If\n  // the walk reaches the start of the buffer, the true figure may be longer.\n  var atLvl = \"\";\n  if (days.length > 0) {\n    var dj = days.length - 1;\n    while (dj > 0 && days[dj - 1][1] === cur[1]) { dj--; }\n    var dFrom = new Date(days[dj][0] * 1000);\n    dFrom.setHours(0, 0, 0, 0);\n    var dNow = new Date();\n    dNow.setHours(0, 0, 0, 0);\n    var nDays = Math.round((dNow.getTime() - dFrom.getTime()) / 86400000);\n    var known = (dj > 0 && days[dj - 1][1] < cur[1]);\n    if (known) { atLvl = nDays === 0 ? \"reached today\" : (nDays + (nDays === 1 ? \" day\" : \" days\") + \" at this level\"); }\n    else { atLvl = nDays > 0 ? (nDays + \"+ days at this level\") : \"at this level since tracking began\"; }\n  }\n  html += ' <span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">' + atLvl + '</span></div>';\n  html += '<div style=\"background:' + TRACK + ';height:6px;width:100%;margin:2px 0 1px;\"><div style=\"background:' + ACC + ';height:6px;width:' + n1(cur[2]) + '%;\"></div></div>';\n  html += '<div style=\"display:flex;justify-content:space-between;color:' + MUTED + ';\"><span>' + cur[2].toFixed(2) + '% done</span><span>' + (100 - cur[2]).toFixed(2) + '% to go</span></div>';\n\n  var cols = '<div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;\">';\n  var sb = caps(\"This session\", ACC);\n  if (sF && sSpan >= 60) {\n    sb += big((sGain >= 0 ? \"+\" : \"\") + (Math.round(sGain * 10000) / 100) + \"%\", sGain > 0 ? UP : MUTED);\n    sb += row(\"length\", dur(sSpan));\n    sb += row(\"per hour\", perHour > 0 ? (Math.round(perHour * 10000) / 100) + \"%\" : \"&hellip;\", perHour > 0 ? UP : MUTED);\n    sb += row(\"started at\", sF.p0.toFixed(2));\n  } else {\n    sb += quiet(\"Just started; figures after a minute. LEVELGRAPH NEW starts a new session.\");\n  }\n  cols += box(sb, ACC);\n\n  var lb = caps(\"Long term\", ACC2);\n  if (lSpan > 0) {\n    lb += big((lGain >= 0 ? \"+\" : \"\") + (Math.round(lGain * 100) / 100) + \" lv\", lGain > 0 ? ACC2 : MUTED);\n    lb += row(\"window\", dur(lSpan));\n    lb += row(\"per day\", perDay > 0 ? (Math.round(perDay * 100) / 100) + \" lv\" : \"&hellip;\", perDay > 0 ? ACC2 : MUTED);\n    lb += row(\"started at\", prog(days[0]).toFixed(2));\n  } else {\n    lb += quiet(\"Collecting; one point is kept per day.\");\n  }\n  cols += box(lb, ACC2);\n  html += cols + '</div>';\n\n  if (LG.graphSess) {\n    html += section(\"Last \" + LG.mins + \" minutes\", mins.length < 2 ? quiet(\"Collecting. A point lands every minute that your experience moves.\") : lvlChart(mins, 640, LG.chartH, ACC, false, LG.deaths), ACC);\n  }\n  if (LG.graphLong) {\n    html += section(\"Last \" + LG.days + \" days\", days.length < 2 ? quiet(\"Collecting. One point is kept per day.\") : lvlChart(days, 640, LG.chartH, ACC2, true), ACC2);\n  }\n  html += '</div>';\n}\n\n// The whole tab in the panel's colour (#355), as Self and Comms do: the\n// panel fills the tab, and the tab itself takes the colour while it resizes.\ntry {\n  var lvSt = document.getElementById(\"loom-levelgraph-style\");\n  if (!lvSt) { lvSt = document.createElement(\"style\"); lvSt.id = \"loom-levelgraph-style\"; document.head.appendChild(lvSt); }\n  var lvCss = '.flexlayout__tab:has(#loom-levelgraph) { background: ' + BG + ' !important; } .flexlayout__tab:has(#loom-levelgraph) > * { min-height: 100%; }';\n  if (lvSt.textContent !== lvCss) lvSt.textContent = lvCss;\n} catch (e) {}\ntry { set_custom_tab_html(\"Level\", html); } catch (e) {}"
  },
  {
   "type": "function",
   "name": "levelgraph_rate",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.levelgraph || !client.loom.levelgraph.day) run_function(\"levelgraph_setup\", [], \"levelgraph\");\nvar LG = client.loom.levelgraph;\nvar mins = LG.min || [];\nvar days = LG.day || [];\nvar MN = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"];\nfunction fl(sec) {\n  var d = new Date(sec * 1000);\n  var mi = d.getMinutes();\n  return d.getDate() + \" \" + MN[d.getMonth()] + \" \" + d.getFullYear() + \" \" + d.getHours() + \":\" + (mi < 10 ? \"0\" : \"\") + mi;\n}\nfunction prog(p) { return p[1] + p[2] / 100; }\n\nvar cur = null;\nif (mins.length > 0) { cur = mins[mins.length - 1]; }\nelse if (days.length > 0) { cur = days[days.length - 1]; }\n\nif (!cur) {\n  display_notice(\"[levelgraph] no samples recorded yet. Use LEVELGRAPH MARK to store the first point.\", \"cyan\");\n} else {\n  display_notice(\"[levelgraph] level \" + cur[1] + \", \" + cur[2].toFixed(2) + \"% to next\", \"cyan\");\n\n  // The session (#335): from its start, whatever the graph's span.\n  var sF = LG.sessFigures ? LG.sessFigures(cur) : null;\n  if (sF && sF.span >= 60) {\n    display_notice(\"[levelgraph] session (since \" + fl(sF.s) + \", \" + Math.round(sF.span / 60) + \" min): \" + (sF.gain >= 0 ? \"+\" : \"\") +\n      (Math.round(sF.gain * 10000) / 100) + \"% = \" + (Math.round(sF.perHour * 10000) / 100) + \"%/hr\", \"cyan\");\n    if (sF.perHour > 0) {\n      var togo = sF.togo / 3600;\n      var hh = Math.floor(togo);\n      var mm = Math.round((togo - hh) * 60);\n      display_notice(\"[levelgraph] at that rate, level \" + (cur[1] + 1) + \" in about \" + (hh > 0 ? hh + \"h \" : \"\") + mm + \"m\", \"cyan\");\n    }\n  } else {\n    display_notice(\"[levelgraph] the session has just started; a rate after a minute.\", \"orange\");\n  }\n\n  if (days.length >= 2) {\n    var lSpan = (days[days.length - 1][0] - days[0][0]) / 86400;\n    var lGain = prog(days[days.length - 1]) - prog(days[0]);\n    display_notice(\"[levelgraph] long term (\" + days.length + \" days stored, first \" + fl(days[0][0]) + \"): +\" +\n      (Math.round(lGain * 100) / 100) + \" levels over \" + (Math.round(lSpan * 10) / 10) + \"d\", \"cyan\");\n    if (lSpan > 0) {\n      display_notice(\"[levelgraph] average \" + (Math.round((lGain / lSpan) * 100) / 100) + \" levels/day\", \"cyan\");\n    }\n  } else {\n    display_notice(\"[levelgraph] long-term buffer has \" + days.length + \" day(s); needs two for a rate.\", \"orange\");\n  }\n  display_notice(\"[levelgraph] graphs: last \" + LG.mins + \" min, last \" + LG.days + \" days; a session closes after \" + LG.gap + \" silent minutes. LEVELGRAPH HELP for commands.\", \"cyan\");\n}"
  },
  {
   "type": "function",
   "name": "levelgraph_help",
   "enabled": true,
   "code": "// levelgraph_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[levelgraph] your progress through the levels, per minute and per day. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"LEVELGRAPH\", \"level, session and long-term rates, time to the next level\"],\n  [\"LEVELGRAPH MARK\", \"record a sample now\"],\n  [\"LEVELGRAPH NEW\", \"close this session and start a new one now\"],\n  [\"LEVELGRAPH GAP <5-240>\", \"minutes without a prompt that close a session (default 30)\"],\n  [\"LEVELGRAPH GRAPH [SESSION|LONG] [ON|OFF]\", \"show or hide the graphs in the Level tab\"],\n  [\"LEVELGRAPH SIZE <40-400>\", \"graph height (default 105)\"],\n  [\"LEVELGRAPH SPAN SESSION <15-720>\", \"minutes the minute-by-minute graph covers (the session's figures don't depend on it)\"],\n  [\"LEVELGRAPH SPAN LONG <7-365>\", \"days the long-term graph covers\"],\n  [\"LEVELGRAPH CSV [SESSION|LONG]\", \"a buffer as CSV lines\"],\n  [\"LEVELGRAPH WIPE CONFIRM\", \"clear both buffers and the session\"],\n  [\"LEVELGRAPH DEBUG\", \"internal state\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// LEVELGRAPH [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.levelgraph || !client.loom.levelgraph.day) run_function(\"levelgraph_setup\", [], \"levelgraph\");\nvar LG = client.loom.levelgraph;\nvar lgW = String(args[1] || \"\").trim().toLowerCase().split(/\\s+/);\nvar lgSub = lgW[0];\nvar lgP1 = lgW[1] || \"\";\nvar lgP2 = lgW[2] || \"\";\nvar C = \"cyan\";\nfunction lgSay(t, col) { display_notice(\"[levelgraph] \" + t, col || C); }\n\nif (lgSub === \"\" || lgSub === \"status\" || lgSub === \"rate\") {\n  run_function(\"levelgraph_rate\", [], \"levelgraph\");\n} else if (lgSub === \"help\") {\n  run_function(\"levelgraph_help\", [], \"levelgraph\");\n} else if (lgSub === \"mark\") {\n  LG.forceMark = true;\n  run_function(\"levelgraph_sample\", [], \"levelgraph\");\n  if (!(LG.level > 0)) lgSay(\"no level reading yet, so nothing was recorded. It arrives with the next prompt.\", \"orange\");\n  else lgSay(\"sample recorded. Session buffer \" + LG.min.length + \" point(s), long term \" + LG.day.length + \" day(s).\", \"lime\");\n} else if (lgSub === \"new\") {\n  // Close this session and open a new one now (#335), as COFFERS NEW.\n  var lgNow = Math.floor(Date.now() / 1000);\n  var lgLv = parseFloat(LG.level), lgNl = parseFloat(LG.nl);\n  if (lgLv > 0) {\n    if (isNaN(lgNl) || lgNl < 0) lgNl = 0;\n    if (lgNl > 100) lgNl = 100;\n    LG.sess = { s: lgNow, last: lgNow, p0: lgLv + Math.round(lgNl * 100) / 10000 };\n  } else {\n    LG.sess = null;\n  }\n  LG.saveSess();\n  run_function(\"levelgraph_render\", [], \"levelgraph\");\n  lgSay(\"new session started\" + (lgLv > 0 ? \" at \" + LG.sess.p0.toFixed(2) + \".\" : \"; it opens with the next prompt.\"), \"lime\");\n} else if (lgSub === \"gap\") {\n  var lgG = parseInt(lgP1, 10) || 0;\n  if (!lgG) { lgSay(\"a session closes after \" + LG.gap + \" minutes without a prompt. LEVELGRAPH GAP 5-240 to change it; LEVELGRAPH NEW starts one now.\"); }\n  else if (lgG < 5 || lgG > 240) { lgSay(\"gap must be 5-240 minutes.\", \"orange\"); }\n  else { LG.gap = lgG; set_variable(\"levelgraph_gap\", String(lgG)); lgSay(\"sessions now close after \" + lgG + \" silent minutes.\", \"lime\"); }\n} else if (lgSub === \"graph\") {\n  var which = lgP1;\n  var mode = lgP2;\n  if (which === \"on\" || which === \"off\") { mode = which; which = \"\"; }\n  if (which === \"\" || which === \"session\") {\n    LG.graphSess = mode === \"on\" ? true : (mode === \"off\" ? false : !LG.graphSess);\n    set_variable(\"levelgraph_graph_sess\", LG.graphSess ? \"1\" : \"0\");\n  }\n  if (which === \"\" || which === \"long\") {\n    LG.graphLong = mode === \"on\" ? true : (mode === \"off\" ? false : !LG.graphLong);\n    set_variable(\"levelgraph_graph_long\", LG.graphLong ? \"1\" : \"0\");\n  }\n  run_function(\"levelgraph_render\", [], \"levelgraph\");\n  lgSay(\"session graph \" + (LG.graphSess ? \"shown\" : \"hidden\") + \", long-term graph \" + (LG.graphLong ? \"shown\" : \"hidden\") + \".\", \"lime\");\n} else if (lgSub === \"size\") {\n  var lgV = parseInt(lgP1, 10) || 0;\n  if (!lgV) { lgSay(\"graph height is \" + LG.chartH + \". LEVELGRAPH SIZE 40-400 (default 105), applies to both graphs.\"); }\n  else if (lgV < 40 || lgV > 400) { lgSay(\"pick a height between 40 and 400.\", \"orange\"); }\n  else {\n    LG.chartH = lgV;\n    set_variable(\"levelgraph_graph_h\", String(lgV));\n    run_function(\"levelgraph_render\", [], \"levelgraph\");\n    lgSay(\"graph height set to \" + lgV + \".\", \"lime\");\n  }\n} else if (lgSub === \"span\") {\n  var lgS = parseInt(lgP2, 10) || 0;\n  if (lgP1 !== \"session\" && lgP1 !== \"long\") { lgSay(\"windows: session \" + LG.mins + \" min, long \" + LG.days + \" days. LEVELGRAPH SPAN SESSION 15-720 | LEVELGRAPH SPAN LONG 7-365.\"); }\n  else if (!lgS) { lgSay(lgP1 + \" window is \" + (lgP1 === \"session\" ? LG.mins + \" minutes\" : LG.days + \" days\") + \".\"); }\n  else if (lgP1 === \"session\" && (lgS < 15 || lgS > 720)) { lgSay(\"session window must be 15-720 minutes.\", \"orange\"); }\n  else if (lgP1 === \"long\" && (lgS < 7 || lgS > 365)) { lgSay(\"long window must be 7-365 days.\", \"orange\"); }\n  else {\n    if (lgP1 === \"session\") { LG.mins = lgS; set_variable(\"levelgraph_span_mins\", String(lgS)); }\n    else { LG.days = lgS; set_variable(\"levelgraph_span_days\", String(lgS)); }\n    run_function(\"levelgraph_render\", [], \"levelgraph\");\n    lgSay(lgP1 + \" window set to \" + lgS + (lgP1 === \"session\" ? \" minutes.\" : \" days.\") + \" Points beyond it drop off at the next sample.\", \"lime\");\n  }\n} else if (lgSub === \"csv\") {\n  var lgWhich = lgP1 === \"session\" ? \"session\" : \"long\";\n  var hs = (lgWhich === \"session\") ? (LG.min || []) : (LG.day || []);\n  lgSay(lgWhich + \" buffer, \" + hs.length + \" point(s):\");\n  display_notice(\"datetime,unix,level,nl,progress\", \"white\");\n  for (var i = 0; i < hs.length; i++) {\n    var d = new Date(hs[i][0] * 1000);\n    var mm = d.getMonth() + 1, dd = d.getDate(), hh = d.getHours(), mi = d.getMinutes();\n    var iso = d.getFullYear() + \"-\" + (mm < 10 ? \"0\" : \"\") + mm + \"-\" + (dd < 10 ? \"0\" : \"\") + dd + \" \" + (hh < 10 ? \"0\" : \"\") + hh + \":\" + (mi < 10 ? \"0\" : \"\") + mi;\n    display_notice(iso + \",\" + hs[i][0] + \",\" + hs[i][1] + \",\" + hs[i][2] + \",\" + (Math.round((hs[i][1] + hs[i][2] / 100) * 100) / 100), \"white\");\n  }\n} else if (lgSub === \"wipe\") {\n  if (lgP1 === \"confirm\") {\n    LG.min = [];\n    LG.day = [];\n    LG.sess = null;\n    LG.saveSess();\n    LG.deaths = [];\n    try { delete_variable(\"levelgraph_deaths\"); } catch (e) {}\n    set_variable(\"levelgraph_min\", \"[]\");\n    set_variable(\"levelgraph_day\", \"[]\");\n    run_function(\"levelgraph_render\", [], \"levelgraph\");\n    lgSay(\"both level buffers and the session cleared.\", \"orange\");\n  } else {\n    lgSay(\"this clears BOTH the minute and long-term buffers, the session and the deaths marked. LEVELGRAPH WIPE CONFIRM to proceed.\", \"orange\");\n  }\n} else if (lgSub === \"debug\") {\n  lgSay(\"level=\" + LG.level + \" nl=\" + LG.nl + \" min=\" + LG.min.length + \" day=\" + LG.day.length + \" graphs \" + LG.graphSess + \"/\" + LG.graphLong + \" height \" + LG.chartH + \" spans \" + LG.mins + \"m/\" + LG.days + \"d gap \" + LG.gap + \"m session \" + JSON.stringify(LG.sess) + \" deaths \" + JSON.stringify(LG.deaths));\n} else {\n  lgSay(\"unknown command '\" + lgSub + \"'. LEVELGRAPH HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^levelgraph(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "levelgraph death",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"You have been slain by X.\" (#336): a skull on the session graph where you\n// died, X on hover. The line is the usual one; send the real wording if a\n// death goes unmarked.\nif (!client.loom || !client.loom.levelgraph || !client.loom.levelgraph.day) run_function(\"levelgraph_setup\", [], \"levelgraph\");\nvar LG = client.loom.levelgraph;\nLG.addDeath(String(args[1] || \"\").trim());\nrun_function(\"levelgraph_render\", [], \"levelgraph\");\n"
    }
   ],
   "text": "^You have been slain by (.+?)\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  }
 ],
 "description": "Level progress graphs per minute and per day, time to next level"
}