{
 "type": "group",
 "name": "roleplay",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"roleplay_setup\", [], \"roleplay\");\nrun_function(\"roleplay_gmcp\", [], \"roleplay\");\ndisplay_notice(\"[roleplay] installed. ROLEPLAY AEM ON for ambient emotes, ROLEPLAY AEM LIST to see them. ROLEPLAY HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Stop the ambient emotes; the roleplay_* variables are left intact.\nif (client.loom && client.loom.roleplay) {\n  try { clearTimeout(client.loom.roleplay.timer); } catch (e) {}\n  client.loom.roleplay.on = false;\n}\n// Leave LOOM and the integrations at once, not at the next load (#137).\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"roleplay\");\n  else delete client.loom.registry.roleplay;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"roleplay_setup\", [], \"roleplay\");\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"roleplay_gmcp\", [], \"roleplay\");\nif (client.loom.roleplay && client.loom.roleplay.on) display_notice(\"[roleplay] ambient emotes ON, as you left them. ROLEPLAY AEM OFF to stop.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// onGMCP: the work is in roleplay_gmcp (#136: this runs on every GMCP message, so it stays short).\nvar lkH = client.loom && client.loom.hooks && client.loom.hooks.roleplay;\nif (!lkH || !lkH.gmcp) { run_function(\"roleplay_gmcp\", [], \"roleplay\"); lkH = client.loom.hooks.roleplay; }\nlkH.gmcp(args);\n"
  },
  {
   "type": "function",
   "name": "roleplay_setup",
   "enabled": true,
   "code": "// roleplay_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, your emote lists and\n// settings, and the helpers of the ambient emote engine (rebuilt every run;\n// the data is kept).\n//\n// Ambient emotes (#262): while ROLEPLAY AEM is ON, one emote from the active\n// set every <min>-<max> minutes. Lists are kept per kind:\n//   \"general\"        any body, used by every normal class\n//   \"race:<Race>\"    your race's own, skipped in a form\n//   \"class:<Class>\"  one per class; dragons and elemental lords are classes too\n// A normal class draws from general + race + class; a form (a dragon or an\n// elemental lord) only from its own class list. Each list is filled once from\n// the seeds (roleplay_seeds) the first time it's in use; after that it's yours.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.roleplay) client.loom.roleplay = {};\nclient.loom.registry.roleplay = { version: \"0.2.10\", keyword: \"ROLEPLAY\", desc: \"Ambient emotes in your own voice, per race and class\" };\nvar RP = client.loom.roleplay;\n\nfunction rpGet(n) { var v; try { v = get_variable(n); } catch (e) { v = undefined; } return (v === undefined || v === null || (\"\" + v) === \"undefined\") ? \"\" : \"\" + v; }\nfunction rpJson(n, isList) {\n  var raw = rpGet(n), v = null;\n  if (raw === \"\") return null;\n  try { v = JSON.parse(raw); } catch (e) { v = null; }\n  if (isList) return Array.isArray(v) ? v : null;\n  return (v && typeof v == \"object\" && !Array.isArray(v)) ? v : null;\n}\n\n// The switch is remembered from the last session (Ricardo: easy to forget\n// it's off), as roleplay_aem_on \"1\"/\"0\", the name Loom's old roleplay used\n// too; aem_on, older still, is migrated once.\nif (rpGet(\"aem_on\") !== \"\") {\n  if (rpGet(\"roleplay_aem_on\") === \"\") set_variable(\"roleplay_aem_on\", rpGet(\"aem_on\"));\n  delete_variable(\"aem_on\");\n}\nif (typeof window !== \"undefined\" && window.AEM) { try { clearTimeout(window.AEM.timer); } catch (e) {} window.AEM = null; }\n\n// ---- Data (kept across a rerun) ----------------------------------------\n// roleplay_emotes: { key: [{ w: weight, t: text }] }. Text is what follows\n// \"emote \", with {he} {him} {his} filled from your gender.\nif (!RP.lists) {\n  RP.lists = {};\n  var rpL = rpJson(\"roleplay_emotes\");\n  if (rpL) {\n    for (var rpK in rpL) {\n      if (!rpL.hasOwnProperty(rpK) || !Array.isArray(rpL[rpK])) continue;\n      var rpOut = [];\n      for (var rpI = 0; rpI < rpL[rpK].length; rpI++) {\n        var rpE = rpL[rpK][rpI];\n        if (rpE && typeof rpE.t == \"string\" && rpE.t !== \"\") rpOut.push({ w: (typeof rpE.w == \"number\" && rpE.w >= 0 && rpE.w <= 1000) ? rpE.w : 1, t: rpE.t });\n      }\n      RP.lists[rpK] = rpOut;\n    }\n  }\n}\n// roleplay_seeded: { key: 1 } for lists the seeds (or you) have filled, so an\n// emptied list stays empty.\nif (!RP.seeded) RP.seeded = rpJson(\"roleplay_seeded\") || {};\n// Who you are: from GMCP, which sends it only at login, so it's kept.\nif (RP.cls === undefined) RP.cls = rpGet(\"roleplay_class\");\nif (RP.race === undefined) RP.race = rpGet(\"roleplay_race\");\nif (RP.me === undefined) RP.me = rpGet(\"roleplay_name\");\n// Your gender as the game states it: SCORE's \"Gender : male\" line (GMCP\n// doesn't send it), kept since SCORE isn't typed every session.\nif (RP.gameGender === undefined) RP.gameGender = rpGet(\"roleplay_game_gender\");\nif (!/^(he|she|fae)$/.test(RP.gameGender)) RP.gameGender = \"\";\n// A gender word as pronouns: male he, female she, anything else fae.\nRP.genderOf = function (w) {\n  w = String(w || \"\").toLowerCase();\n  if (!w) return \"\";\n  return w === \"male\" ? \"he\" : (w === \"female\" ? \"she\" : \"fae\");\n};\nRP.learnGender = function (w) {\n  var g = RP.genderOf(w);\n  if (!g || g === RP.gameGender) return;\n  RP.gameGender = g;\n  set_variable(\"roleplay_game_gender\", g);\n};\n\n// Settings.\nRP.gender = rpGet(\"roleplay_gender\");\nif (!/^(he|she|fae)$/.test(RP.gender)) RP.gender = \"\";\nvar rpTime = rpGet(\"roleplay_aem_time\").split(/\\s+/);\nRP.min = Number(rpTime[0]);\nRP.max = Number(rpTime[1]);\nif (!(RP.min >= 1 && RP.max >= RP.min && RP.max <= 600)) { RP.min = 15; RP.max = 19; }\n// What holds the emotes back: defences and afflictions by their GMCP name.\nRP.quietDefault = [\"shroud\", \"hiding\", \"cloak\", \"phased\", \"asleep\", \"prone\", \"stun\", \"aeon\"];\nRP.quiet = rpJson(\"roleplay_quiet\", true) || RP.quietDefault.slice(0);\n\n// ---- Runtime (kept across a rerun) ----------------------------------------\nif (RP.on === undefined) RP.on = rpGet(\"roleplay_aem_on\") === \"1\";\nif (!RP.defs) RP.defs = {};\nif (!RP.affs) RP.affs = {};\nif (RP.hurtAt === undefined) RP.hurtAt = 0;\nif (RP.sentAt === undefined) RP.sentAt = 0;\nif (RP.last === undefined) RP.last = \"\";\nif (RP.sent === undefined) RP.sent = 0;\nif (RP.held === undefined) RP.held = \"\";\n\nRP.retryMs = 60000;     // held back: look again in a minute\nRP.fightMs = 30000;     // health lost this recently counts as a fight\nRP.bumpMs = 60000;      // your own say or emote pushes the next one back this much\nRP.echoMs = 5000;       // your emote's echo right after sending isn't \"you\"\n\n// ---- Helpers (rebuilt every run) ----------------------------------------\nRP.save = function () {\n  set_variable(\"roleplay_emotes\", JSON.stringify(RP.lists));\n  set_variable(\"roleplay_seeded\", JSON.stringify(RP.seeded));\n};\n// The class's list: an elder dragon shares its colour's (\"Elder Golden\n// Dragon\" -> \"Golden Dragon\").\nRP.clsKey = function () { return String(RP.cls || \"\").replace(/^Elder\\s+/i, \"\"); };\nRP.setOn = function (on) {\n  RP.on = !!on;\n  set_variable(\"roleplay_aem_on\", on ? \"1\" : \"0\");\n};\nRP.isForm = function () {\n  return /dragon$/i.test(RP.cls || \"\") || /\\blord$/i.test(RP.cls || \"\");\n};\n// The list a word names: GENERAL, RACE, CLASS (yours now), or RACE:<name> /\n// CLASS:<name> for any other (underscores for spaces). \"\" when it can't.\nRP.keyFor = function (word) {\n  var w = String(word || \"\");\n  var m = /^(race|class):(.+)$/i.exec(w);\n  if (m) {\n    var want = m[1].toLowerCase() + \":\" + m[2].replace(/_/g, \" \").toLowerCase();\n    // The spelling already in use (GMCP's), whatever case you typed.\n    var mine = [\"race:\" + RP.race, \"class:\" + RP.clsKey()];\n    for (var k in RP.lists) if (RP.lists.hasOwnProperty(k)) mine.push(k);\n    for (var j = 0; j < mine.length; j++) if (mine[j].toLowerCase() === want) return mine[j];\n    return want.replace(/(:|\\s)([a-z])/g, function (a, s, c) { return s + c.toUpperCase(); });\n  }\n  w = w.toLowerCase();\n  if (w === \"general\") return \"general\";\n  if (w === \"race\") return RP.race ? \"race:\" + RP.race : \"\";\n  if (w === \"class\") return RP.cls ? \"class:\" + RP.clsKey() : \"\";\n  return \"\";\n};\nRP.label = function (key) {\n  if (key === \"general\") return \"general\";\n  var m = /^(race|class):(.+)$/.exec(key);\n  return m ? m[2] + (m[1] === \"race\" ? \" (race)\" : \"\") : key;\n};\n// What you use now: a form only its own list, a normal class general + race + class.\nRP.activeKeys = function () {\n  if (RP.isForm()) return RP.cls ? [\"class:\" + RP.clsKey()] : [];\n  var k = [\"general\"];\n  if (RP.race) k.push(\"race:\" + RP.race);\n  if (RP.cls) k.push(\"class:\" + RP.clsKey());\n  return k;\n};\n// A list in use for the first time takes its seeds (once).\nRP.seedKey = function (key) {\n  if (RP.seeded[key]) return false;\n  var sd = RP.seedFor(key);\n  if (!sd.length) return false;\n  if (!RP.lists[key]) RP.lists[key] = [];\n  // A random handful of a long pool, kept in the pool's order.\n  var plan = (RP.seedPlan || {})[key === \"general\" ? \"general\" : key.split(\":\")[0]] || {};\n  var n = plan.n || 10, idx = [], i;\n  for (i = 0; i < sd.length; i++) idx.push(i);\n  for (i = idx.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)), t = idx[i]; idx[i] = idx[j]; idx[j] = t; }\n  idx = idx.slice(0, n).sort(function (a, b) { return a - b; });\n  for (i = 0; i < idx.length; i++) {\n    var row = sd[idx[i]];\n    var txt = typeof row == \"string\" ? row : row[1];\n    RP.lists[key].push({ w: plan.w || (typeof row == \"string\" ? 2 : row[0]), t: txt });\n  }\n  RP.seeded[key] = 1;\n  return true;\n};\nRP.seedFor = function (key) {\n  var S = RP.seeds || {};\n  if (key === \"general\") return S.general || [];\n  var m = /^(race|class):(.+)$/.exec(key);\n  var tab = m ? (m[1] === \"race\" ? S.race : S[\"class\"]) || {} : {};\n  return m ? tab[m[2]] || [] : [];\n};\nRP.seedActive = function () {\n  var k = RP.activeKeys(), any = false;\n  for (var i = 0; i < k.length; i++) if (RP.seedKey(k[i])) any = true;\n  if (any) RP.save();\n};\n// The rows a LIST shows and numbers: [{ key, i, e }], the active set or one list.\nRP.rows = function (keys) {\n  keys = keys || RP.activeKeys();\n  var out = [];\n  for (var a = 0; a < keys.length; a++) {\n    var l = RP.lists[keys[a]] || [];\n    for (var b = 0; b < l.length; b++) out.push({ key: keys[a], i: b, e: l[b] });\n  }\n  return out;\n};\n// Pronouns: {he} {him} {his}, capitalised as written ({His}).\nRP.pron = { he: { he: \"he\", him: \"him\", his: \"his\" }, she: { he: \"she\", him: \"her\", his: \"her\" }, fae: { he: \"fae\", him: \"faen\", his: \"faes\" } };\nRP.genderNow = function () { return RP.gender || RP.gameGender || \"\"; };\nRP.hasTokens = function (t) { return /\\{(he|him|his)\\}/i.test(t); };\nRP.fill = function (t) {\n  var p = RP.pron[RP.genderNow()];\n  return String(t).replace(/\\{(he|him|his)\\}/gi, function (all, w) {\n    if (!p) return all;\n    var r = p[w.toLowerCase()];\n    return w.charAt(0) === w.charAt(0).toUpperCase() ? r.charAt(0).toUpperCase() + r.slice(1) : r;\n  });\n};\n// Weighted pick from the active set; never the one sent last when there's\n// another; emotes with pronouns wait until your gender is known.\nRP.pick = function () {\n  var rows = RP.rows(), c = [], tot = 0, i;\n  var g = !!RP.genderNow();\n  for (i = 0; i < rows.length; i++) {\n    if (rows[i].e.w > 0 && (g || !RP.hasTokens(rows[i].e.t))) c.push(rows[i].e);\n  }\n  if (c.length > 1) {\n    var keep = [];\n    for (i = 0; i < c.length; i++) if (c[i].t !== RP.last) keep.push(c[i]);\n    if (keep.length) c = keep;\n  }\n  for (i = 0; i < c.length; i++) tot += c[i].w;\n  if (!tot) return null;\n  var r = Math.random() * tot;\n  for (i = 0; i < c.length; i++) { r -= c[i].w; if (r <= 0) return c[i]; }\n  return c[c.length - 1];\n};\n// Why an emote can't go now, or \"\".\nRP.holdWhy = function () {\n  if (get_variable(\"pauseTriggers\") === \"on\") return \"triggers paused\";\n  for (var i = 0; i < RP.quiet.length; i++) {\n    var q = RP.quiet[i];\n    if (RP.defs[q]) return q;\n    if (RP.affs[q]) return q;\n  }\n  if (RP.hurtAt && Date.now() - RP.hurtAt < RP.fightMs) return \"fighting\";\n  return \"\";\n};\nRP.send = function (e) {\n  RP.last = e.t;\n  RP.sentAt = Date.now();\n  RP.sent++;\n  send_command(\"emote \" + RP.fill(e.t));\n};\n// The timer. Always calls the current helpers, so a reimport takes over.\nRP.at = function (ms) {\n  clearTimeout(RP.timer);\n  RP.due = Date.now() + ms;\n  RP.timer = setTimeout(function () { var R = client.loom.roleplay; R.timer = null; R.tick(); }, ms);\n};\nRP.schedule = function () {\n  RP.at(Math.round((RP.min + Math.random() * (RP.max - RP.min)) * 60000));\n};\nRP.stop = function () { clearTimeout(RP.timer); RP.timer = null; RP.due = 0; };\nRP.tick = function () {\n  if (!RP.on) return;\n  var why = RP.holdWhy();\n  if (why) { RP.held = why; RP.at(RP.retryMs); return; }\n  RP.held = \"\";\n  var e = RP.pick();\n  if (!e) {\n    if (!RP.emptyTold) display_notice(\"[roleplay] no ambient emote to send for \" + (RP.cls || \"you\") + \". ROLEPLAY AEM ADD to write some.\", \"orange\");\n    RP.emptyTold = true;\n  } else {\n    RP.emptyTold = false;\n    RP.send(e);\n  }\n  RP.schedule();\n};\n// You spoke or emoted yourself: the next ambient emote waits a minute longer,\n// at most the longest wait from now.\nRP.bump = function (why) {\n  if (!RP.on || !RP.timer) return;\n  var now = Date.now();\n  if (now - RP.sentAt < RP.echoMs) return;\n  var due = Math.min(RP.due + RP.bumpMs, now + RP.max * 60000);\n  RP.lastBump = { at: now, why: why || \"\", by: Math.round((due - RP.due) / 1000) };\n  if (due > RP.due) RP.at(due - now);\n};\nRP.mmss = function (ms) {\n  var s = Math.max(0, Math.round(ms / 1000));\n  return Math.floor(s / 60) + \":\" + (\"0\" + (s % 60)).slice(-2);\n};\n\nrun_function(\"roleplay_seeds\", [], \"roleplay\");\nRP.seedActive();\n// On from the last session: running again (a reimport keeps the timer it has).\nif (RP.on && !RP.timer) RP.schedule();\n"
  },
  {
   "type": "function",
   "name": "roleplay_seeds",
   "enabled": true,
   "code": "// roleplay_seeds -- the starting emotes, run by roleplay_setup. A list takes\n// its seeds once, the first time it's in use, and is the player's after that;\n// ROLEPLAY AEM RESET deals a fresh set. Each player gets a random handful of\n// each pool (RP.seedPlan), so two characters seldom share the same set:\n//   general  50 in the pool, 10 dealt, at the row's weight (2, clumsy ones 1)\n//   race     20 per race,     5 dealt, weight 3\n//   class    10 per class,    5 dealt, weight 4 (the class defines a character best)\n// Twenty emotes in all for a normal class. Rows are [weight, text], or just\n// the text where the plan sets the weight; the text follows \"emote \", with\n// {he} {him} {his} for your pronouns.\n//\n//   general        any race, any normal class (never a dragon or elemental lord)\n//   race[<Race>]   that race's body and habits, as GMCP names the race\n//   class[<Class>] that class; dragons and elemental lords are classes here,\n//                  and theirs is the whole voice of the form\n//\n// Rules for every seed (Ricardo, 2026-10-25): only what others can see (no\n// \"as if\", nothing that tells the room what you think); nothing that invites\n// a question (no reaction to something unseen); nothing that depends on the\n// room or the moment; nothing that states something about you (hungry, cold);\n// nothing rude or grating. Clumsy ones weigh 1, the rest 2.\n// Race pools assume no homeland, city or faith (any race lives anywhere):\n// nature and the like belong in class pools.\nif (!client.loom || !client.loom.roleplay) { if (!client.loom) client.loom = {}; client.loom.roleplay = {}; }\nclient.loom.roleplay.seedPlan = { general: { n: 10 }, race: { n: 5, w: 3 }, \"class\": { n: 5, w: 4 } };\nclient.loom.roleplay.seeds = {\n  general: [\n    [2, \"glances around, taking quiet stock of the room.\"],\n    [2, \"watches the room for a while without saying anything.\"],\n    [2, \"follows the path of a passing insect with idle interest.\"],\n    [2, \"tilts {his} head, listening to something at the edge of hearing.\"],\n    [2, \"lets {his} gaze wander, then brings it back with a small shake of {his} head.\"],\n    [2, \"narrows {his} eyes at nothing in particular, then lets it go.\"],\n    [2, \"shifts {his} weight and settles into a more comfortable stance.\"],\n    [2, \"rolls {his} shoulders until something gives a small, satisfying pop.\"],\n    [2, \"stretches {his} arms overhead and lets them drop with a contented sigh.\"],\n    [2, \"flexes {his} fingers one at a time, working out a stiffness.\"],\n    [2, \"rubs at the back of {his} neck.\"],\n    [2, \"folds {his} arms and leans back a little.\"],\n    [2, \"lets {his} arms fall loose at {his} sides.\"],\n    [2, \"rocks back on {his} heels, then forward again, restless.\"],\n    [2, \"lets out a slow breath, {his} shoulders easing.\"],\n    [2, \"draws a deep breath and holds it a moment before letting it go.\"],\n    [2, \"sighs quietly, to no one in particular.\"],\n    [2, \"hums a few bars of some half-forgotten tune.\"],\n    [2, \"purses {his} lips, considering something.\"],\n    [2, \"drums {his} fingers idly against {his} side.\"],\n    [2, \"taps out a slow rhythm against {his} leg.\"],\n    [2, \"turns a small coin over and over between {his} fingers.\"],\n    [2, \"picks at a loose thread on {his} sleeve.\"],\n    [2, \"brushes a bit of dust from {his} clothes.\"],\n    [2, \"checks the fastenings of {his} pack with an absent tug.\"],\n    [2, \"pats at {his} pockets, making sure everything is still there.\"],\n    [2, \"straightens {his} clothes with a quick tug.\"],\n    [2, \"examines {his} fingernails for a moment.\"],\n    [2, \"rubs {his} hands together briskly.\"],\n    [2, \"scratches absently at {his} jaw.\"],\n    [2, \"stares into the middle distance, lost in thought.\"],\n    [2, \"raises an eyebrow, then lets it settle.\"],\n    [1, \"nearly trips over nothing, recovers, and pretends it never happened.\"],\n    [1, \"sneezes into {his} hand.\"],\n    [1, \"reaches for an itch between {his} shoulder blades, with mixed success.\"],\n    [2, \"swats at an insect only {he} seems to have noticed.\"],\n    [2, \"wipes {his} brow with the back of {his} hand.\"],\n    [2, \"clasps {his} hands loosely behind {his} back.\"],\n    [2, \"links {his} fingers together and stretches {his} arms out in front of {him}.\"],\n    [2, \"stretches one arm across {his} chest, then the other.\"],\n    [2, \"turns {his} head slowly from side to side, loosening {his} neck.\"],\n    [2, \"massages one wrist, then the other.\"],\n    [2, \"rubs {his} thumb slowly across the knuckles of {his} other hand.\"],\n    [2, \"presses {his} palms together and bends {his} fingers back gently.\"],\n    [2, \"tugs {his} sleeves back into place.\"],\n    [2, \"flicks a speck of lint from {his} shoulder.\"],\n    [2, \"adjusts the way {his} pack sits on {his} shoulders.\"],\n    [2, \"crouches briefly to adjust a strap, then straightens.\"],\n    [2, \"taps a finger lightly against {his} chin.\"],\n    [2, \"rests {his} hands on {his} hips.\"]\n  ],\n  race: {\n    // The plain human body and a traveller's habits: humans have no unusual features.\n    Human: [\n      \"runs a hand back through {his} hair.\",\n      \"tucks a loose strand of hair behind {his} ear.\",\n      \"pushes {his} hair back from {his} forehead with the back of {his} wrist.\",\n      \"rubs one eye with a knuckle.\",\n      \"tugs lightly at an earlobe.\",\n      \"rubs a thumb over the calluses on {his} palm.\",\n      \"turns {his} hands over and looks at them for a moment.\",\n      \"kneads the muscle at the base of {his} thumb.\",\n      \"rubs {his} palms down the front of {his} legs.\",\n      \"presses a hand to the small of {his} back and stretches.\",\n      \"rises briefly onto {his} toes, then settles back down.\",\n      \"stands with {his} weight on one leg, one hip cocked.\",\n      \"kneads {his} shoulder with one hand.\",\n      \"pushes {his} sleeves up to the elbow.\",\n      \"hooks {his} thumbs into {his} belt.\",\n      \"knocks the dust from {his} boots, one against the other.\",\n      \"settles {his} clothes more comfortably about {his} shoulders.\",\n      \"touches the pouch at {his} belt, then lets {his} hand fall.\",\n      \"bites lightly at {his} lower lip.\",\n      \"scuffs the toe of one boot against the ground.\"\n    ],\n    // Stocky and grounded, proud of their beards (many women dwarves remove theirs: easy to drop).\n    \"Dwarf\": [\n      \"strokes {his} beard slowly from chin to tip.\",\n      \"combs {his} fingers through {his} beard, working loose a tangle.\",\n      \"tucks the end of {his} beard into {his} belt.\",\n      \"smooths {his} beard down with both hands.\",\n      \"plants {his} feet a little wider, settling {his} weight low.\",\n      \"stands square and solid, like a boulder set in the ground.\",\n      \"rolls {his} broad shoulders, slow and heavy.\",\n      \"crosses {his} thick arms over {his} chest.\",\n      \"flexes {his} heavy forearms.\",\n      \"stamps one booted foot, then the other, firmly down.\",\n      \"presses a heel into the ground, testing how firm it is.\",\n      \"hitches up {his} belt with both hands.\",\n      \"rubs the end of {his} nose with a thick finger.\",\n      \"pushes a tangle of thick curls out of {his} eyes.\",\n      \"checks the knots of {his} pack straps with a practised eye.\",\n      \"turns a small pebble over in {his} fingers, studying the grain.\",\n      \"inspects the stitching on {his} sleeve with a critical eye.\",\n      \"hums a low, rumbling work song under {his} breath.\",\n      \"drums {his} thick fingers on {his} belt buckle.\",\n      \"gives a short, decisive nod.\"\n    ],\n    // Slim, sinewy and light on their feet; dark eyes, watchful stillness (no light assumed).\n    \"Mhun\": [\n      \"shifts {his} weight onto the balls of {his} feet.\",\n      \"tests {his} footing with a light, quick step.\",\n      \"moves with a soft, restless step, then stills again.\",\n      \"flexes {his} long, wiry fingers.\",\n      \"rolls {his} lean shoulders with a quick, loose shrug.\",\n      \"stretches {his} wiry frame, joints loose and easy.\",\n      \"rubs a thumb along {his} sharp jaw.\",\n      \"sweeps the hair back from {his} angular face.\",\n      \"blinks slowly, {his} dark eyes giving nothing away.\",\n      \"glances upward, studying the space overhead.\",\n      \"stands very still, only {his} eyes moving.\",\n      \"tucks {his} chin down, watching from under {his} brows.\",\n      \"slips {his} hands into {his} sleeves.\",\n      \"picks absently at the grit under {his} fingernails.\",\n      \"bounces lightly on the balls of {his} feet.\",\n      \"shakes out {his} hands and wrists, loose and quick.\",\n      \"steps lightly to one side and back again, without a sound.\",\n      \"balances easily on one foot, the other ankle hooked behind it.\",\n      \"smooths {his} dark hair flat with one palm.\",\n      \"tilts {his} head, {his} dark eyes half-lidded.\"\n    ],\n    // Winged humans: grooming, folding and stretching the wings; never airborne.\n    \"Atavian\": [\n      \"runs a hand along the edge of one wing, smoothing the feathers.\",\n      \"preens a stray feather back into place.\",\n      \"smooths the feathers at the base of {his} wings with careful fingers.\",\n      \"combs {his} fingers through the long flight feathers of one wing.\",\n      \"turns to check a ruffled patch of feathers over {his} shoulder.\",\n      \"plucks a loose feather from {his} wing and lets it drift down.\",\n      \"reaches back to straighten a bent feather.\",\n      \"shakes out {his} wings, then folds them neatly against {his} back.\",\n      \"tucks {his} wings in a little tighter.\",\n      \"resettles {his} wings with a soft rustle of feathers.\",\n      \"ruffles {his} feathers briefly, then lets them settle.\",\n      \"lets {his} wings droop loosely behind {him}.\",\n      \"stretches one wing out to its full length, then the other.\",\n      \"half-spreads {his} wings, then draws them back in.\",\n      \"rolls {his} shoulders, the movement rippling down through {his} wings.\",\n      \"gives {his} wings a single slow beat, stirring the air around {him}.\",\n      \"flicks the tips of {his} wings, shaking off a little dust.\",\n      \"holds {his} wings a little apart, balanced lightly on {his} feet.\",\n      \"shifts {his} wings to keep them clear of {his} surroundings.\",\n      \"scratches at an itch where {his} wings meet {his} back.\"\n    ],\n    // Lithe, elegant and unhurried, long hair. No forest: that belongs to classes (Tsol'aa live in every city).\n    \"Tsol'aa\": [\n      \"gathers {his} long hair over one shoulder.\",\n      \"combs {his} fingers slowly through the length of {his} hair.\",\n      \"tucks a long strand of hair back with an unhurried hand.\",\n      \"stands in a quiet, lithe stillness, {his} weight perfectly balanced.\",\n      \"moves with slow, deliberate grace, then settles again.\",\n      \"stretches {his} lithe frame with slow, easy grace.\",\n      \"inclines {his} head slightly, a slow and measured movement.\",\n      \"waits, perfectly patient, without a trace of hurry.\",\n      \"regards the room with a long, patient look.\",\n      \"blinks slowly, {his} gaze steady and calm.\",\n      \"folds {his} slender hands together before {him}.\",\n      \"smooths a crease from {his} clothes with long, elegant fingers.\",\n      \"runs a fingertip along the curve of {his} ear.\",\n      \"draws {his} long hair back from {his} face with both hands.\",\n      \"smooths {his} long hair down over {his} back.\",\n      \"straightens with quiet poise, chin lifted slightly.\",\n      \"lowers {his} eyes for a long moment, then raises them again.\",\n      \"lets {his} hands rest lightly at {his} sides, perfectly still.\",\n      \"rests a fingertip against {his} lips for a moment.\",\n      \"shifts {his} weight with light, easy balance.\"\n    ],\n    // Tiger-like: tail, whiskers, fur and mane, feline ears, the great cat's ease.\n    \"Rajamala\": [\n      \"flicks the tip of {his} tail lazily.\",\n      \"curls {his} tail around {his} legs.\",\n      \"lets {his} tail sway slowly from side to side.\",\n      \"lashes {his} tail once, then stills it.\",\n      \"smooths the fur along {his} tail with one hand.\",\n      \"twitches {his} whiskers.\",\n      \"smooths {his} whiskers back with the side of a finger.\",\n      \"lifts {his} nose and scents the air, whiskers twitching.\",\n      \"licks the back of {his} hand and smooths down a ruffled patch of fur.\",\n      \"ruffles the fur at {his} neck, then smooths it flat.\",\n      \"gives a full-body shake that ripples through {his} fur.\",\n      \"flicks one ear, then the other.\",\n      \"flattens {his} ears briefly, then lets them rise.\",\n      \"arches {his} back in a long, slow stretch.\",\n      \"flexes {his} fingers, spreading them wide, then curls them in again.\",\n      \"rolls {his} powerful shoulders, muscles shifting beneath {his} coat.\",\n      \"pads a slow step on broad, silent feet.\",\n      \"settles into a loose stillness, only {his} tail moving.\",\n      \"rumbles softly, deep in {his} chest.\",\n      \"kneads the air briefly with flexing fingers.\"\n    ],\n    // Horns, hooves and goat legs, shaped beards; jovial through movement and tunes, not smiles.\n    \"Satyr\": [\n      \"runs a hand over the curve of one horn.\",\n      \"traces the ridges of one horn with a fingertip.\",\n      \"scratches at the base of {his} horns.\",\n      \"tips {his} head to one side, horns and all.\",\n      \"taps a cloven hoof against the ground in a quick little rhythm.\",\n      \"stamps one hoof, then the other.\",\n      \"shifts from hoof to hoof with a soft clatter.\",\n      \"kicks out one goat leg in a lazy stretch.\",\n      \"scratches the coarse fur of one leg with the other hoof.\",\n      \"brushes a few tangles out of the coarse fur on {his} legs.\",\n      \"balances on one hoof, then the other.\",\n      \"strokes {his} carefully shaped beard.\",\n      \"twirls the end of {his} beard around a finger.\",\n      \"smooths {his} beard into a neat point.\",\n      \"does a light, skipping half-step, hooves clicking.\",\n      \"whistles a few bright notes of a jaunty tune.\",\n      \"hums a lively tune, tapping a hoof in time.\",\n      \"leans back with an easy, careless air.\",\n      \"claps {his} hands together once, briskly.\",\n      \"rubs {his} palms together, then dusts them off.\"\n    ]\n  },\n  \"class\": {}\n};\n"
  },
  {
   "type": "function",
   "name": "roleplay_gmcp",
   "enabled": true,
   "code": "// roleplay_gmcp -- the work behind onGMCP and the line trigger, as functions\n// made once per load (client.loom.hooks.roleplay.gmcp / .line), so the scripts\n// that run on every message and line stay two lines (#136). Run from onLoad\n// and onInstall, so a reimport replaces them.\nif (!client.loom) client.loom = {};\nif (!client.loom.hooks) client.loom.hooks = {};\nif (!client.loom.hooks.roleplay) client.loom.hooks.roleplay = {};\n\n// Who you are (name, race, class, gender), your health (a fight holds the\n// emotes back), and the defences and afflictions in ROLEPLAY QUIET.\nclient.loom.hooks.roleplay.gmcp = function (args) {\n  var rpM = String((args && args.gmcp_method) || \"\");\n  if (!/^Char\\.|^Comm\\.Channel\\.Text$/.test(rpM)) return;\n  var rpA = args.gmcp_args;\n  if (typeof rpA === \"string\") { try { rpA = JSON.parse(rpA); } catch (e) { rpA = null; } }\n  if (!rpA || typeof rpA != \"object\") return;\n  if (!client.loom || !client.loom.roleplay || !client.loom.roleplay.lists) run_function(\"roleplay_setup\", [], \"roleplay\");\n  var RP = client.loom.roleplay;\n  var i;\n  if (rpM === \"Comm.Channel.Text\") {\n    // Your own say or yell, in any voice or accent: the talker is you, or the\n    // text starts \"You ...\" / \"Your ...\".\n    if (RP.on && /^(says?|yells?)$/i.test(String(rpA.channel || \"\"))) {\n      var plain = String(rpA.text || \"\").replace(/\\u001b\\[[0-9;]*m/g, \"\").replace(/^\\([^)]*\\):?\\s*/, \"\");\n      if ((RP.me && String(rpA.talker || \"\").toLowerCase() === RP.me.toLowerCase()) || /^Your?\\b/.test(plain)) RP.bump(\"you spoke\");\n    }\n  } else if (rpM === \"Char.Vitals\") {\n    var hp = Number(rpA.hp);\n    if (!isNaN(hp)) {\n      if (RP.lastHp !== undefined && hp < RP.lastHp) RP.hurtAt = Date.now();\n      RP.lastHp = hp;\n    }\n  } else if (rpM === \"Char.Name\" || rpM === \"Char.Status\") {\n    if (rpA.name && String(rpA.name) !== RP.me) { RP.me = String(rpA.name); set_variable(\"roleplay_name\", RP.me); }\n    // Not sent by Achaea today (SCORE's line is read instead), kept in case it is.\n    if (rpA.gender) RP.learnGender(rpA.gender);\n    var changed = false;\n    // A form's race (a dragon's) isn't your race: keep the one you had.\n    if (rpA.race && !/dragon|lord/i.test(String(rpA.race)) && String(rpA.race) !== RP.race) {\n      RP.race = String(rpA.race); set_variable(\"roleplay_race\", RP.race); changed = true;\n    }\n    if (rpA[\"class\"] && String(rpA[\"class\"]) !== RP.cls) {\n      RP.cls = String(rpA[\"class\"]); set_variable(\"roleplay_class\", RP.cls); changed = true;\n    }\n    if (changed) { RP.emptyTold = false; RP.seedActive(); }\n  } else if (rpM === \"Char.Defences.List\" || rpM === \"Char.Afflictions.List\") {\n    var set = {};\n    if (Array.isArray(rpA)) for (i = 0; i < rpA.length; i++) if (rpA[i] && rpA[i].name) set[rpA[i].name] = 1;\n    if (rpM === \"Char.Defences.List\") RP.defs = set; else RP.affs = set;\n  } else if (rpM === \"Char.Defences.Add\" || rpM === \"Char.Afflictions.Add\") {\n    if (rpA.name) (rpM === \"Char.Defences.Add\" ? RP.defs : RP.affs)[rpA.name] = 1;\n  } else if (rpM === \"Char.Defences.Remove\" || rpM === \"Char.Afflictions.Remove\") {\n    var tab = rpM === \"Char.Defences.Remove\" ? RP.defs : RP.affs;\n    if (Array.isArray(rpA)) for (i = 0; i < rpA.length; i++) delete tab[rpA[i] && rpA[i].name ? rpA[i].name : rpA[i]];\n  }\n};\n\n// Your own emote: a line starting with your name (after an optional\n// parenthesis), its echo. Pushes the next ambient emote back. Says come\n// through GMCP above, whatever the voice.\nclient.loom.hooks.roleplay.line = function (args) {\n  var RP = client.loom && client.loom.roleplay;\n  if (!RP || !RP.on || !RP.bump || !RP.me) return;\n  if (String((args && args[1]) || \"\") === RP.me) RP.bump(\"you emoted\");\n};\n"
  },
  {
   "type": "function",
   "name": "roleplay_help",
   "enabled": true,
   "code": "// roleplay_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[roleplay] ambient emotes in your own voice. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"ROLEPLAY\", \"who the emotes follow (race, class, gender) and the ambient emotes' state\"],\n  [\"ROLEPLAY GENDER [HE|SHE|FAE|AUTO]\", \"the pronouns {he} {him} {his} become (AUTO: your gender in SCORE)\"],\n  [\"ROLEPLAY QUIET [ADD|REMOVE <name>|RESET]\", \"defences and afflictions that hold the emotes back\"],\n  [\"ROLEPLAY AEM [ON|OFF]\", \"an ambient emote every few minutes, or none; remembered across sessions (default OFF)\"],\n  [\"ROLEPLAY AEM NOW\", \"one ambient emote now\"],\n  [\"ROLEPLAY AEM LIST [GENERAL|RACE|CLASS|ALL]\", \"the emotes in use, numbered, with weight and chance\"],\n  [\"ROLEPLAY AEM ADD <list> [weight] <text>\", \"add an emote: list GENERAL, RACE, CLASS, or CLASS:<name>\"],\n  [\"ROLEPLAY AEM EDIT <n> <text>\", \"reword emote n\"],\n  [\"ROLEPLAY AEM WEIGHT <n> <weight>\", \"how often emote n comes up (0 keeps it but never sends it)\"],\n  [\"ROLEPLAY AEM REMOVE <n>\", \"remove emote n (its text is shown, to add back)\"],\n  [\"ROLEPLAY AEM TEST <n>\", \"show emote n as it would be sent, without sending it\"],\n  [\"ROLEPLAY AEM TIME [<min> <max>]\", \"minutes between ambient emotes (default 15 19)\"],\n  [\"ROLEPLAY AEM EXPORT [ALL]\", \"your emotes as ADD commands, to keep or paste back\"],\n  [\"ROLEPLAY AEM RESET [GENERAL|RACE|CLASS|ALL] CONFIRM\", \"a fresh set of starting emotes (yours in that list are lost)\"],\n  [\"ROLEPLAY DEBUG\", \"internal state\"],\n  [\"A normal class uses general + race + class lists; a dragon or elemental lord only its own class list.\"],\n  [\"Numbers are those of the last LIST. Nothing is sent while triggers are paused, while hidden or asleep, or in a fight.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "roleplay",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// ROLEPLAY [subcommand ...]: your pronouns, what holds the emotes back, and\n// the ambient emotes (AEM): switch, lists, timing, seeds.\nif (!client.loom || !client.loom.roleplay || !client.loom.roleplay.lists) run_function(\"roleplay_setup\", [], \"roleplay\");\nvar RP = client.loom.roleplay;\n// Words in lowercase for matching; the raw line keeps an emote's own case.\nvar rpRaw = String(args[1] || \"\").trim();\nvar rpW = rpRaw.toLowerCase().split(/\\s+/);\nvar rpSub = rpW[0];\nvar rpS2 = rpW[1] || \"\";\nfunction rpSay(t, c) { display_notice(\"[roleplay] \" + t, c || \"cyan\"); }\n// The rest of the raw line after the first n words.\nfunction rpRest(n) {\n  var s = rpRaw;\n  for (var i = 0; i < n; i++) s = s.replace(/^\\S+\\s*/, \"\");\n  return s;\n}\nfunction rpEsc(t) { return String(t).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\nfunction rpHtml() { return typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\"; }\n// Monospace rows: [[text, colour], ...] per line.\nfunction rpBlock(lines) {\n  if (!rpHtml()) { for (var i = 0; i < lines.length; i++) { var p = \"\"; for (var j = 0; j < lines[i].length; j++) p += lines[i][j][0]; display_notice(p, \"cyan\"); } return; }\n  var out = [];\n  for (var a = 0; a < lines.length; a++) {\n    var h = \"\";\n    for (var b = 0; b < lines[a].length; b++) h += '<span style=\"color:' + lines[a][b][1] + '\">' + rpEsc(lines[a][b][0]) + \"</span>\";\n    out.push(h);\n  }\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre-wrap\">' + out.join(\"\\n\") + \"</span>\");\n}\n// The keys a LIST view shows: the active set, one list, or every list.\nfunction rpViewKeys() { return RP.viewKeys || RP.activeKeys(); }\nfunction rpRow(n) {\n  var rows = RP.rows(rpViewKeys());\n  var k = parseInt(n, 10);\n  return (k >= 1 && k <= rows.length) ? rows[k - 1] : null;\n}\nfunction rpWho() { return (RP.cls || \"your class\") + (RP.isForm() ? \" (a form: its own list only)\" : \"\"); }\n\nif (rpSub === \"\" || rpSub === \"status\") {\n  var g = RP.genderNow();\n  rpSay((RP.me || \"you\") + \": \" + (RP.race || \"race unknown\") + \", \" + (RP.cls || \"class unknown\") + (RP.isForm() ? \" (a form)\" : \"\") + \"; pronouns \" + (g ? RP.pron[g].he + \"/\" + RP.pron[g].him + \"/\" + RP.pron[g].his + (RP.gender ? \"\" : \" (from SCORE)\") : \"unknown: type SCORE, or ROLEPLAY GENDER HE|SHE|FAE\") + \".\", (RP.cls && g) ? \"cyan\" : \"orange\");\n  var act = RP.rows(RP.activeKeys());\n  var bits = [];\n  var ak = RP.activeKeys();\n  for (var i = 0; i < ak.length; i++) bits.push(RP.label(ak[i]) + \" \" + (RP.lists[ak[i]] || []).length);\n  rpSay(\"ambient emotes \" + (RP.on ? \"ON\" : \"OFF\") + \", every \" + RP.min + \"-\" + RP.max + \" minutes; \" + act.length + \" in use (\" + (bits.join(\", \") || \"no lists yet\") + \").\" + (RP.on && RP.timer ? \" Next in \" + RP.mmss(RP.due - Date.now()) + (RP.held ? \", held: \" + RP.held : \"\") + \".\" : \"\") + \" ROLEPLAY HELP for commands.\");\n} else if (rpSub === \"help\") {\n  run_function(\"roleplay_help\", [], \"roleplay\");\n} else if (rpSub === \"gender\") {\n  if (rpS2 === \"\") {\n    var g2 = RP.genderNow();\n    rpSay(\"pronouns: \" + (g2 ? RP.pron[g2].he + \"/\" + RP.pron[g2].him + \"/\" + RP.pron[g2].his + (RP.gender ? \" (set by you)\" : \" (from SCORE)\") : \"unknown: type SCORE\") + \". ROLEPLAY GENDER HE, SHE, FAE or AUTO.\");\n  } else if (/^(he|she|fae)$/.test(rpS2)) {\n    RP.gender = rpS2;\n    set_variable(\"roleplay_gender\", rpS2);\n    rpSay(\"pronouns: \" + RP.pron[rpS2].he + \"/\" + RP.pron[rpS2].him + \"/\" + RP.pron[rpS2].his + \".\", \"lime\");\n  } else if (rpS2 === \"auto\") {\n    RP.gender = \"\";\n    delete_variable(\"roleplay_gender\");\n    rpSay(\"pronouns follow the game\" + (RP.gameGender ? \": \" + RP.pron[RP.gameGender].he + \".\" : \" (not known yet: type SCORE once).\") , \"lime\");\n  } else {\n    rpSay(\"ROLEPLAY GENDER HE, SHE, FAE or AUTO.\", \"orange\");\n  }\n} else if (rpSub === \"quiet\") {\n  var qn = (rpW[2] || \"\").toLowerCase();\n  if (rpS2 === \"add\" && qn) {\n    if (RP.quiet.indexOf(qn) < 0) RP.quiet.push(qn);\n    set_variable(\"roleplay_quiet\", JSON.stringify(RP.quiet));\n    rpSay(\"held back by: \" + RP.quiet.join(\", \") + \".\", \"lime\");\n  } else if (rpS2 === \"remove\" && qn) {\n    var qi = RP.quiet.indexOf(qn);\n    if (qi < 0) rpSay(\"'\" + qn + \"' isn't in the list: \" + RP.quiet.join(\", \") + \".\", \"orange\");\n    else { RP.quiet.splice(qi, 1); set_variable(\"roleplay_quiet\", JSON.stringify(RP.quiet)); rpSay(\"held back by: \" + (RP.quiet.join(\", \") || \"nothing but the pause and fights\") + \".\", \"lime\"); }\n  } else if (rpS2 === \"reset\") {\n    RP.quiet = RP.quietDefault.slice(0);\n    delete_variable(\"roleplay_quiet\");\n    rpSay(\"held back by the defaults: \" + RP.quiet.join(\", \") + \".\", \"lime\");\n  } else if (rpS2 === \"\") {\n    var now = [];\n    for (var qj = 0; qj < RP.quiet.length; qj++) if (RP.defs[RP.quiet[qj]] || RP.affs[RP.quiet[qj]]) now.push(RP.quiet[qj]);\n    rpSay(\"held back by these defences and afflictions (GMCP names): \" + (RP.quiet.join(\", \") || \"none\") + \". Up now: \" + (now.join(\", \") || \"none\") + \". Also by the pause and by a fight (health lost in the last 30 s).\");\n  } else {\n    rpSay(\"ROLEPLAY QUIET, QUIET ADD <name>, QUIET REMOVE <name> or QUIET RESET.\", \"orange\");\n  }\n} else if (rpSub === \"aem\") {\n  var a3 = rpW[2] || \"\";\n  if (rpS2 === \"\" || rpS2 === \"status\") {\n    rpSay(\"ambient emotes \" + (RP.on ? \"ON\" : \"OFF\") + \", every \" + RP.min + \"-\" + RP.max + \" minutes, \" + RP.rows(RP.activeKeys()).length + \" in use for \" + rpWho() + \".\" + (RP.on && RP.timer ? \" Next in \" + RP.mmss(RP.due - Date.now()) + (RP.held ? \", held: \" + RP.held : \"\") + \".\" : \"\") + \" ROLEPLAY AEM ON|OFF|NOW|LIST.\");\n  } else if (rpS2 === \"on\" && RP.on && RP.timer) {\n    // Already running: keep the time it has (your own talk may have pushed it).\n    rpSay(\"ambient emotes already ON; the next in \" + RP.mmss(RP.due - Date.now()) + (RP.held ? \", held: \" + RP.held : \"\") + \".\");\n  } else if (rpS2 === \"on\") {\n    RP.setOn(true);\n    RP.emptyTold = false;\n    RP.seedActive();\n    RP.schedule();\n    var n1 = RP.rows(RP.activeKeys()).length;\n    rpSay(\"ambient emotes ON: one every \" + RP.min + \"-\" + RP.max + \" minutes, the first in \" + RP.mmss(RP.due - Date.now()) + \".\" + (n1 ? \"\" : \" None are written for \" + rpWho() + \" yet: ROLEPLAY AEM ADD.\"), n1 ? \"lime\" : \"orange\");\n  } else if (rpS2 === \"off\") {\n    RP.setOn(false);\n    RP.stop();\n    rpSay(\"ambient emotes OFF.\", \"lime\");\n  } else if (rpS2 === \"now\") {\n    var e1 = RP.pick();\n    if (get_variable(\"pauseTriggers\") === \"on\") rpSay(\"triggers are paused, so nothing was sent.\", \"orange\");\n    else if (!e1) rpSay(\"no ambient emote to send for \" + rpWho() + (RP.genderNow() ? \"\" : \" (those with pronouns wait for your gender: type SCORE, or ROLEPLAY GENDER)\") + \".\", \"orange\");\n    else { RP.send(e1); if (RP.on) RP.schedule(); }\n  } else if (rpS2 === \"list\") {\n    var vk;\n    if (a3 === \"\" ) vk = null;\n    else if (a3 === \"all\") {\n      vk = [];\n      for (var lk in RP.lists) if (RP.lists.hasOwnProperty(lk) && RP.lists[lk].length) vk.push(lk);\n      vk.sort(function (x, y) { return (x === \"general\" ? \"0\" : x).localeCompare(y === \"general\" ? \"0\" : y); });\n    } else {\n      var k1 = RP.keyFor(rpRest(2));\n      vk = k1 ? [k1] : undefined;\n    }\n    if (vk === undefined) {\n      rpSay(\"ROLEPLAY AEM LIST, LIST GENERAL, RACE, CLASS, ALL, or RACE:<name> / CLASS:<name>\" + (RP.cls ? \"\" : \" (your race and class come from the game at login)\") + \".\", \"orange\");\n    } else {\n      RP.viewKeys = vk;\n      var rows = RP.rows(rpViewKeys());\n      var act2 = vk === null;\n      if (!rows.length) {\n        rpSay((act2 ? \"no emotes in use for \" + rpWho() : \"no emotes in \" + RP.label(vk[0])) + \". ROLEPLAY AEM ADD <list> [weight] <text>.\", \"orange\");\n      } else {\n        // Chances within the set the LIST shows; a non-active list's are its own.\n        var tot = 0, ri;\n        for (ri = 0; ri < rows.length; ri++) tot += rows[ri].e.w;\n        rpSay(act2 ? \"ambient emotes in use for \" + rpWho() + \" (\" + rows.length + \"):\" : (vk.length > 1 ? \"every list\" : RP.label(vk[0])) + \" (\" + rows.length + \"):\");\n        var lines = [], lastKey = \"\";\n        var nw = String(rows.length).length;\n        for (ri = 0; ri < rows.length; ri++) {\n          var r = rows[ri];\n          if (r.key !== lastKey) { lines.push([[\"  \" + RP.label(r.key) + (RP.activeKeys().indexOf(r.key) < 0 ? \" (not in use now)\" : \"\"), \"#e0b46c\"]]); lastKey = r.key; }\n          var pct = tot ? (r.e.w * 100 / tot) : 0;\n          var ps = r.e.w ? (pct < 9.95 ? \" \" : \"\") + pct.toFixed(1) + \"%\" : \"  --  \";\n          lines.push([\n            [\"  \" + (\"     \" + (ri + 1)).slice(-nw) + \"  \", \"#00ffff\"],\n            [(\"   \" + r.e.w).slice(-3) + \"  \" + ps + \"  \", \"#9fc9c9\"],\n            [r.e.t, r.e.w ? \"#c8bfae\" : \"#7a7a7a\"]\n          ]);\n        }\n        rpBlock(lines);\n        if (!RP.genderNow()) rpSay(\"pronouns unknown: emotes with {he} {him} {his} wait until you type SCORE once, or set ROLEPLAY GENDER.\", \"orange\");\n      }\n    }\n  } else if (rpS2 === \"add\") {\n    var key = RP.keyFor(rpW[2] || \"\");\n    var txt = rpRest(3);\n    var wt = 1;\n    var wm = /^(\\d+)\\s+([\\s\\S]+)$/.exec(txt);\n    if (wm) { wt = Math.min(1000, parseInt(wm[1], 10)); txt = wm[2]; }\n    txt = txt.replace(/^emote\\s+/i, \"\").trim();\n    if (!key) {\n      rpSay(\"ROLEPLAY AEM ADD <GENERAL|RACE|CLASS|CLASS:<name>|RACE:<name>> [weight] <text>\" + (RP.cls ? \"\" : \" (your race and class come from the game at login)\") + \".\", \"orange\");\n    } else if (!txt) {\n      rpSay(\"the emote's text is missing.\", \"orange\");\n    } else {\n      if (!RP.lists[key]) RP.lists[key] = [];\n      // A list you write in keeps its seeds out from now on.\n      if (!RP.seeded[key]) { RP.seedKey(key); RP.seeded[key] = 1; }\n      RP.lists[key].push({ w: wt, t: txt });\n      RP.save();\n      rpSay(\"added to \" + RP.label(key) + \" (weight \" + wt + \"): \" + txt, \"lime\");\n    }\n  } else if (rpS2 === \"edit\" || rpS2 === \"weight\" || rpS2 === \"remove\" || rpS2 === \"test\") {\n    var row = rpRow(a3);\n    if (!row) {\n      rpSay(\"no emote \" + (a3 || \"?\") + \" in the last LIST. ROLEPLAY AEM LIST numbers them.\", \"orange\");\n    } else if (rpS2 === \"test\") {\n      rpSay(\"would send: emote \" + RP.fill(row.e.t) + (RP.hasTokens(row.e.t) && !RP.genderNow() ? \"  (pronouns unknown: type SCORE, or ROLEPLAY GENDER)\" : \"\"));\n    } else if (rpS2 === \"remove\") {\n      RP.lists[row.key].splice(row.i, 1);\n      RP.seeded[row.key] = 1;\n      RP.save();\n      rpSay(\"removed from \" + RP.label(row.key) + \": \" + row.e.t, \"lime\");\n      rpSay(\"to add it back: ROLEPLAY AEM ADD \" + (row.key === \"general\" ? \"GENERAL\" : row.key.replace(/ /g, \"_\").toUpperCase()) + \" \" + row.e.w + \" \" + row.e.t);\n    } else if (rpS2 === \"weight\") {\n      var nwt = parseInt(rpW[3], 10);\n      if (!(nwt >= 0 && nwt <= 1000)) rpSay(\"ROLEPLAY AEM WEIGHT <n> <0-1000>.\", \"orange\");\n      else { row.e.w = nwt; RP.save(); rpSay(\"emote \" + a3 + \" now weighs \" + nwt + (nwt ? \".\" : \": kept, never sent.\"), \"lime\"); }\n    } else {\n      var nt = rpRest(3).replace(/^emote\\s+/i, \"\").trim();\n      if (!nt) rpSay(\"ROLEPLAY AEM EDIT <n> <text>.\", \"orange\");\n      else { var was = row.e.t; row.e.t = nt; RP.save(); rpSay(\"emote \" + a3 + \" reworded. It was: \" + was, \"lime\"); }\n    }\n  } else if (rpS2 === \"time\") {\n    var mn = Number(rpW[2]), mx = Number(rpW[3]);\n    if (a3 === \"\") rpSay(\"an ambient emote every \" + RP.min + \"-\" + RP.max + \" minutes. ROLEPLAY AEM TIME <min> <max>.\");\n    else if (!(mn >= 1 && mx >= mn && mx <= 600)) rpSay(\"ROLEPLAY AEM TIME <min> <max>, in minutes: at least 1, max not below min, at most 600.\", \"orange\");\n    else {\n      RP.min = mn; RP.max = mx;\n      set_variable(\"roleplay_aem_time\", mn + \" \" + mx);\n      if (RP.on) RP.schedule();\n      rpSay(\"an ambient emote every \" + mn + \"-\" + mx + \" minutes\" + (RP.on ? \"; the next in \" + RP.mmss(RP.due - Date.now()) : \"\") + \".\", \"lime\");\n    }\n  } else if (rpS2 === \"export\") {\n    var ek = [];\n    if (a3 === \"all\") { for (var xk in RP.lists) if (RP.lists.hasOwnProperty(xk) && RP.lists[xk].length) ek.push(xk); ek.sort(); }\n    else ek = RP.activeKeys();\n    var xl = [];\n    for (var xi = 0; xi < ek.length; xi++) {\n      var l2 = RP.lists[ek[xi]] || [];\n      var nm = ek[xi] === \"general\" ? \"GENERAL\" : ek[xi].replace(/ /g, \"_\").replace(/^(race|class)/, function (m) { return m.toUpperCase(); });\n      for (var xj = 0; xj < l2.length; xj++) xl.push([[\"ROLEPLAY AEM ADD \" + nm + \" \" + l2[xj].w + \" \" + l2[xj].t, \"#c8bfae\"]]);\n    }\n    if (!xl.length) rpSay(\"nothing to export\" + (a3 === \"all\" ? \".\" : \" in the lists in use. ROLEPLAY AEM EXPORT ALL for every list.\"), \"orange\");\n    else { rpSay(xl.length + \" emote\" + (xl.length === 1 ? \"\" : \"s\") + (a3 === \"all\" ? \", every list\" : \", the lists in use\") + \", as commands:\"); rpBlock(xl); }\n  } else if (rpS2 === \"reset\") {\n    var which = a3 === \"confirm\" ? \"\" : a3;\n    var conf = rpW[rpW.length - 1] === \"confirm\";\n    var rk;\n    if (which === \"\" || which === \"all\") {\n      rk = [];\n      for (var zk in RP.lists) if (RP.lists.hasOwnProperty(zk)) rk.push(zk);\n    } else {\n      var k2 = RP.keyFor(rpW[2]);\n      rk = k2 ? [k2] : null;\n    }\n    if (!rk) {\n      rpSay(\"ROLEPLAY AEM RESET [GENERAL|RACE|CLASS|ALL] CONFIRM.\", \"orange\");\n    } else {\n      var lost = 0;\n      for (var zi = 0; zi < rk.length; zi++) lost += (RP.lists[rk[zi]] || []).length;\n      if (!conf) {\n        rpSay(\"this replaces \" + (which && which !== \"all\" ? RP.label(rk[0]) : \"every list\") + \" with the starting emotes: \" + lost + \" emote\" + (lost === 1 ? \"\" : \"s\") + \" now there would be lost (ROLEPLAY AEM EXPORT keeps a copy). Add CONFIRM to do it.\", \"orange\");\n      } else {\n        for (var zj = 0; zj < rk.length; zj++) { delete RP.lists[rk[zj]]; delete RP.seeded[rk[zj]]; }\n        // A named list not in use now is refilled too; the rest when they're next used.\n        for (var zl = 0; zl < rk.length; zl++) RP.seedKey(rk[zl]);\n        RP.seedActive();\n        RP.save();\n        rpSay((which && which !== \"all\" ? RP.label(rk[0]) : \"every list\") + \" back to the starting emotes (\" + lost + \" removed). ROLEPLAY AEM LIST shows them.\", \"orange\");\n      }\n    }\n  } else {\n    rpSay(\"unknown command 'aem \" + rpS2 + \"'. ROLEPLAY HELP for commands.\", \"orange\");\n  }\n} else if (rpSub === \"debug\") {\n  var dk = [];\n  for (var dl in RP.lists) if (RP.lists.hasOwnProperty(dl)) dk.push(dl + \"=\" + RP.lists[dl].length);\n  rpSay(\"me=\" + RP.me + \" race=\" + RP.race + \" cls=\" + RP.cls + \" form=\" + RP.isForm() + \" gender=\" + (RP.gender || \"-\") + \"/game \" + (RP.gameGender || \"-\") + \" on=\" + RP.on + \" timer=\" + !!RP.timer + \" due=\" + (RP.timer ? RP.mmss(RP.due - Date.now()) : \"-\") + \" held=\" + (RP.held || \"-\") + \" hold now=\" + (RP.holdWhy() || \"-\") + \" sent=\" + RP.sent + \" lastBump=\" + (RP.lastBump ? RP.mmss(Date.now() - RP.lastBump.at) + \" ago, \" + RP.lastBump.why + \" +\" + RP.lastBump.by + \"s\" : \"-\") + \" lists={\" + dk.join(\", \") + \"} seeded=\" + JSON.stringify(RP.seeded) + \" view=\" + JSON.stringify(RP.viewKeys || \"active\") + \" defs=\" + Object.keys(RP.defs).length + \" affs=\" + Object.keys(RP.affs).join(\",\") + \" pause=\" + (get_variable(\"pauseTriggers\") || \"unset\"));\n} else {\n  rpSay(\"unknown command '\" + rpSub + \"'. ROLEPLAY HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^roleplay(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "roleplay score gender",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// SCORE's gender line (\"| Gender : male  Race : Tsol'aa ...\"): GMCP doesn't\n// send your gender, so the pronouns for AUTO come from here.\nif (!client.loom || !client.loom.roleplay || !client.loom.roleplay.learnGender) run_function(\"roleplay_setup\", [], \"roleplay\");\nclient.loom.roleplay.learnGender(args[1]);\n"
    }
   ],
   "text": "^\\W*Gender\\s*:\\s*([A-Za-z]+)\\s+Race\\s*:",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "roleplay own line",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Your own say or emote: the work is in roleplay_gmcp (#136: this runs on most lines, so it stays short).\nvar lkH = client.loom && client.loom.hooks && client.loom.hooks.roleplay;\nif (!lkH || !lkH.line) { run_function(\"roleplay_gmcp\", [], \"roleplay\"); lkH = client.loom.hooks.roleplay; }\nlkH.line(args);\n"
    }
   ],
   "text": "^(?:\\([^)]*\\)\\s*)?([A-Z][a-z]+)\\b",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  }
 ],
 "description": "Ambient emotes in your own voice, per race and class"
}