       "type": "script",
       "enabled": true,
       "script": "var target = args[1];\nvar step = args[2];\nvar textStep = \"\";\n\nswitch (step) {\n  case \"1\":\n    textStep = \"draws $\" + target + \"'s foot up into his lap and cradles it in both hands, in no hurry, letting the warmth of his palms settle in first.\";\n    break;\n\n  case \"2\":\n    textStep = \"presses both thumbs slow along the arch of $\" + target + \"'s foot, from heel toward toe, sinking them gently in the skin.\";\n    break;\n\n  case \"3\":\n    textStep = \"works a firm, patient circle into the heel of $\" + target + \"'s foot, where the whole day's walking has come to rest.\";\n    break;\n\n  case \"4\":\n    textStep = \"leans an even weight up the sole of $\" + target + \"'s foot, one small press after another, coaxing the tightness loose.\";\n    break;\n\n  case \"5\":\n    textStep = \"rolls his thumbs across the ball of $\" + target + \"'s foot, just beneath the toes, easing out the ache of standing.\";\n    break;\n\n  case \"6\":\n    textStep = \"draws each of $\" + target + \"'s toes gently through his fingers in turn, unhurried, wringing the last of the tension out.\";\n    break;\n\n  case \"7\":\n    textStep = \"circles $\" + target + \"'s ankle slowly in one hand, loosening the joint, while the other steadies the foot.\";\n    break;\n\n  case \"8\":\n    textStep = \"smooths both thumbs up the top of $\" + target + \"'s foot in long strokes, following the line of each tendon out to the toes.\";\n    break;\n\n  case \"9\":\n    textStep = \"presses the whole warm flat of both hands around $\" + target + \"'s foot and simply holds it there, letting it rest heavy and easy.\";\n    break;\n\n  case \"10\":\n    textStep = \"sets $\" + target + \"'s foot down softly and smiles at $\" + target + \"_him.\";\n    break;   \n}\n\nif (textStep != \"\") {\n  send_command(\"emote \" + textStep);\n  display_notice(\"Step \" + step + \" out of 10.\", \"cyan\");\n} else {\n  display_notice (\"Wrong step: \" + args[1]);\n}"
      }
     ],
     "text": "^foot_massage (\\w+) (\\d+)$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var target = args[1];\nvar step = args[2];\nvar textStep = \"\";\n\nswitch (step) {\n  case \"1\":\n    textStep = \"loosens the tie from $\" + target + \"'s hair and lets the loose curls fall free through his fingers, unhurried.\";\n    break;\n\n  case \"2\":\n    textStep = \"picks a stray twig loose from $\" + target + \"'s curls, then a caught leaf, setting each aside without a word, the forest still clinging to $\" + target + \"_him.\";\n    break;\n\n  case \"3\":\n    textStep = \"combs slow through $\" + target + \"'s hair with his fingers, feeling for what else the day has left tangled there, and works it gently free.\";\n    break;\n\n  case \"4\":\n    textStep = \"tips the bucket and pours a slow fall of water through $\" + target + \"'s hair, darkening the blue of it, until every curl hangs heavy and streaming.\";\n    break;\n\n  case \"5\":\n    textStep = \"works the water down through $\" + target + \"'s hair with both hands, root to end, until it runs clean between his fingers.\";\n    break;\n\n  case \"6\":\n    textStep = \"presses small circles across $\" + target + \"'s scalp with his fingertips, patient, coaxing the day's tension up and out along with the water.\";\n    break;\n\n  case \"7\":\n    textStep = \"cups water in both hands and pours it careful over $\" + target + \"'s hair a last time, rinsing the green streaks and the blue until they gleam.\";\n    break;\n\n  case \"8\":\n    textStep = \"gathers the length of $\" + target + \"'s hair in both hands and eases the water from it with a slow, gentle press, careful of every shell and pearl.\";\n    break;\n\n  case \"9\":\n    textStep = \"lifts his staff and calls a soft warmth to its head, a small caught sun, and holds it near $\" + target + \"'s hair until the light settles gold across the wet curls.\";\n    break;\n\n  case \"10\":\n    textStep = \"passes the staff's warmth slow along the length of $\" + target + \"'s hair, and the water lifts from it in a faint haze, each curl drawing back into its own soft spring.\";\n    break;   \n\n  case \"11\":\n    textStep = \"turns one of the bright shells twined in $\" + target + \"'s hair between finger and thumb, dry and warm now, and leaves it where it lies to chime.\";\n    break;   \n\n  case \"12\":\n    textStep = \"draws his fingers slow through $\" + target + \"'s curls, following each wave where it wants to go rather than pulling it straight, the last of the damp gone from them.\";\n    break;   \n\n  case \"13\":\n    textStep = \"smooths both hands down the warm, dry length of $\" + target + \"'s hair, settling every curl and shell back into its place with the whole warm flat of his palms.\";\n    break;   \n\n  case \"14\":\n    textStep = \"lets the light of his staff fade, draws a curl of $\" + target + \"'s hair forward over $\" + target + \"_his shoulder, and kisses it gently.\";\n    break;   \n}\n\nif (textStep != \"\") {\n  send_command(\"emote \" + textStep);\n  display_notice(\"Step \" + step + \" out of 14.\", \"cyan\");\n} else {\n  display_notice (\"Wrong step: \" + args[1]);\n}"
      }
     ],
     "text": "^wash_hair (\\w+) (\\d+)$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var target = args[1];\nvar step = args[2];\nvar textStep = \"\";\n\nswitch (step) {\n  case \"1\":\n    textStep = \"emote steps onto the stone floor, waiting amongst the roots until the murmuring of the gathered falls still.\";\n    break;\n\n  case \"2\":\n    textStep = \"cast illusion The drifting wisps slow in their wandering and gather overhead, their green light pooling softly upon the floor.\";\n    break;\n\n  case \"3\":\n    textStep = \"say Welcome, everyone. We gather here beneath the roots of Eleusis, amongst those who rest within these walls, to mark the moment a seed breaks the soil and turns towards the light.\";\n    display_notice(\"[roleplay] Skip to step 6 if Lady Gaia is not present.\", \"cyan\");\n    break;\n\n  case \"4\":\n    textStep = \"emote turns towards Lady Gaia and bows deeply, holding the bow for a long breath before rising.\";\n    break;\n\n  case \"5\":\n    textStep = \"say Earthmother, we are honoured beyond words by Your presence. With Your leave, we begin.\";\n    break;\n\n  case \"6\":\n    textStep = \"emote extends an open hand towards $\" + target + \", inviting $\" + target + \"_him to stand in the center of the room.\";\n    break;\n\n  case \"7\":\n    textStep = \"say Gather around \" + target + \", please.\";\n    break;\n\n  case \"8\":\n    textStep = \"say \" + target + \" came to us as a Uaithne, and has walked the paths of the Saiha since.\";\n    break;\n\n  case \"9\":\n    textStep = \"cast illusion A single wisp drifts down from amongst the roots and hovers at the heart of the gathering, casting a pale green light over all.\";\n    break;\n\n  case \"10\":\n    textStep = \"say \" + target + \", each of us is bound to some corner of Nature's vast body. Tell us, which environment calls to you?\";\n    display_notice(\"[roleplay] Use feel_environment optional after the reply.\", \"cyan\");\n\n    break;   \n\n  case \"11\":\n    textStep = \"say Then let it know you as its own, and may you never walk there as a stranger.\";\n    break;\n\n  case \"12\":\n    textStep = \"say Before we proceed, the floor belongs to those who have walked beside \" + target + \". Is there any here who would offer words?\";\n    break;\n\n  case \"13\":\n    textStep = \"emote lets his gaze travel slowly across every face in the gathering.\";\n    break;\n\n  case \"14\":\n    textStep = \"say It is our custom that none join us unwelcomed. If any here holds a true objection to the graduation of \" + target + \", let them speak it now, openly and before all.\";\n    break;\n    \n  case \"15\":\n    textStep = \"say \" + target + \", you will now speak the Oath. Repeat after me, and let each word be your own.\";\n    display_notice(\"[roleplay] Oath 1: I, \" + target + \", of (environment),\", \"cyan\");\n    display_notice(\"[roleplay] Oath 2: Do hereby submit to the Wildwood Queen, Lady Gaia, She Who is Nature.\", \"cyan\");\n    display_notice(\"[roleplay] Oath 3: In life, I shall seek to serve Nature, to defend Her realm, and to strike back against those who would trespass upon Her until my final breath.\", \"cyan\");\n    display_notice(\"[roleplay] Oath 4: In death, I shall return to Her, my infested body a feast as my flesh is reclaimed down to the bone.\", \"cyan\");\n    display_notice(\"[roleplay] Oath 5: That which is borrowed from the earth shall be inevitably returned; in life, growth, death, and decay, I am one with Nature.\", \"cyan\");\n    break;\n    \n  case \"16\":\n    textStep = \"say Now come, \" + target + \", and lay your hand upon the roots. They reach down from every tree of Eleusis, and they hold all of us together.\";\n    break;\n\n  case \"17\":\n    textStep = \"cast illusion One by one, the wisps abandon their wandering and gather about the roots until their green light thickens and the gnarled wood seems to breathe.\";\n    break;\n\n  case \"18\":\n    textStep = \"t \" + target + \" TOUCH ROOTS\";\n    break;\n    \n  case \"19\":\n    textStep = \"cast illusion The wisps lift from the roots in a joyful spiral, dancing along the vines before drifting slowly back to their quiet wandering amongs the roots and earth.\";\n    break;\n    \n  case \"20\":\n    textStep = \"say Congratulations, \" + target + \", and welcome to our family :)\";\n    break;\n}\n\nif (textStep != \"\") {\n  send_command(textStep);\n  display_notice(\"Step \" + step + \" out of 20.\", \"cyan\");\n} else {\n  display_notice (\"Wrong step: \" + args[1]);\n}"
      }
     ],
     "text": "^graduation (\\w+) (\\d+)$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    }
   ]
  },
