{
 "type": "group",
 "name": "roleplay",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"roleplay_setup\", [], \"roleplay\");\ndisplay_notice(\"[roleplay] installed. ROLEPLAY HELP for the emotes, rituals and ambient emotes.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Stop the ambient emotes; the roleplay_* variables are left intact.\nif (client.loom && client.loom.roleplay && client.loom.roleplay.aem) { try { clearTimeout(client.loom.roleplay.aem.timer); } catch (e) {} client.loom.roleplay.aem = null; }\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"roleplay_setup\", [], \"roleplay\");\n// Ambient emotes that were on keep running after a reload.\nif (get_variable(\"roleplay_aem_on\") === \"1\") run_function(\"roleplay_aem\", [], \"roleplay\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// The class the emotes and ambient emotes follow, from Char.Status. On a\n// change (dragonform included) it's kept, and a built ambient emote engine\n// is rebuilt with that class's pool.\nvar rpM = \"\";\nvar rpA = null;\ntry { rpM = args.gmcp_method; rpA = args.gmcp_args; } catch (e) { rpM = \"\"; }\nif (rpM === \"Char.Status\" && rpA) {\n  if (typeof rpA === \"string\") { try { rpA = JSON.parse(rpA); } catch (e) { rpA = null; } }\n  if (rpA && rpA[\"class\"]) {\n    if (!client.loom || !client.loom.roleplay || client.loom.roleplay.cls === undefined) run_function(\"roleplay_setup\", [], \"roleplay\");\n    var RP = client.loom.roleplay;\n    if (String(rpA[\"class\"]) !== RP.cls) {\n      RP.cls = String(rpA[\"class\"]);\n      set_variable(\"roleplay_class\", RP.cls);\n      if (RP.aem) run_function(\"roleplay_aem\", [], \"roleplay\");\n    }\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "roleplay_setup",
   "enabled": true,
   "code": "// roleplay_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, one-time migration of\n// aem_on, and the class the emotes follow.\n//\n// The emotes choose their wording by class (a dragon's are different), from\n// client.loom.roleplay.cls: Char.Status's class, kept in roleplay_class\n// because the game sends it only at login and when it changes.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.roleplay) client.loom.roleplay = {};\nclient.loom.registry.roleplay = { version: \"0.2.2\", keyword: \"ROLEPLAY\", desc: \"Class-aware emotes, rituals, cairn verses and ambient emotes\" };\nvar RP = client.loom.roleplay;\nfunction rpGet(n) { var v; try { v = get_variable(n); } catch (e) { v = undefined; } return (v === undefined || v === null || (\"\" + v) === \"undefined\") ? \"\" : \"\" + v; }\n\n// One-time migration: aem_on -> roleplay_aem_on.\nvar rpOld = rpGet(\"aem_on\");\nif (rpOld !== \"\") {\n  if (rpGet(\"roleplay_aem_on\") === \"\") set_variable(\"roleplay_aem_on\", rpOld);\n  delete_variable(\"aem_on\");\n}\n// The class: the one kept, or loom's activeClass the first time (read only).\nif (RP.cls === undefined) {\n  RP.cls = rpGet(\"roleplay_class\") || rpGet(\"activeClass\");\n  if (RP.cls) set_variable(\"roleplay_class\", RP.cls);\n}\n// The old engine lived at window.AEM; stop it so it doesn't keep emoting\n// alongside the new one after a reimport.\nif (typeof window !== \"undefined\" && window.AEM) {\n  try { clearTimeout(window.AEM.timer); } catch (e) {}\n  window.AEM = null;\n}\n"
  },
  {
   "type": "function",
   "name": "roleplay_aem",
   "enabled": true,
   "code": "// roleplay_aem -- builds the ambient emote engine for the current class at\n// client.loom.roleplay.aem: a weighted pool of emotes, one sent every 15-19\n// minutes while it's on (roleplay_aem_on). Run by ROLEPLAY AEM, on load when\n// it was on, and again when the class changes (the pool is per class).\n// Nothing is sent while triggers are paused.\nif (!client.loom || !client.loom.roleplay || client.loom.roleplay.cls === undefined) run_function(\"roleplay_setup\", [], \"roleplay\");\nvar RP = client.loom.roleplay;\nif (RP.aem) { try { clearTimeout(RP.aem.timer); } catch (e) {} }\nvar AEM = { cls: RP.cls, emotes: null };\n\n  switch (RP.cls) {\n    case \"Magi\":\n      AEM.emotes = [\n  // Nostalgic: the old sleeper, now with new tools in his hands\n  { weight: 3, text: \"emote runs his thumb along his staff, a small private smile surfacing and fading.\" },\n  { weight: 5, text: \"emote turns a small crystal over in his fingers, watching the light fold within it.\" },\n  { weight: 1, text: \"emote goes still, one hand lifted, like a man who has just remembered someone long gone.\" },\n  { weight: 2, text: \"emote pauses, head canted, as though listening for a resonance he has not heard in centuries.\" },\n\n  // Attuned: nature is now read through the elements\n  { weight: 3, text: \"emote draws a slow breath, and the air about him cools a shade before warming again.\" },\n  { weight: 3, text: \"emote turns his palm upward as though testing for rain, and a single bead of water gathers there before he lets it fall.\" },\n  { weight: 3, text: \"emote lets a thread of static crawl between two fingertips before closing his hand gently upon it.\" },\n  { weight: 1, text: \"emote follows the path of some small creature with quiet, unhurried attention.\" },\n  { weight: 1, text: \"emote calls forth a shimmering treaty with a murmured word, runs his eyes down its binding clauses, and dismisses it with a small satisfied nod.\" },\n\n  // Contemplative: the scholar-artificer's idle habits\n  { weight: 2, text: \"emote rolls a glittering pearl between finger and thumb, holds it to the light, and tucks it away unsatisfied.\" },\n  { weight: 5, text: \"emote sets a small crystal spinning in the air before him without looking at it, catches it, and sets it spinning again.\" },\n  { weight: 3, text: \"emote breathes on one of the gems set in his staff and polishes it on his sleeve, turning it to the light to judge the result.\" },\n  { weight: 5, text: \"emote rolls a fragment of dried leaf between finger and thumb until it crumbles away.\" },\n  { weight: 3, text: \"emote settles his weight against his staff and simply observes, patient as old stone.\" },\n  { weight: 2, text: \"emote lets his eyes rest on nothing at all, lips moving on some silent calculation.\" },\n  { weight: 1, text: \"emote arches a brow at something no one else can see, one corner of his mouth twitching.\" }\n];\n      break;\n    case \"Druid\":\n  AEM.emotes = [{ weight: 2, text: \"emote pauses mid-step, his gaze drifting to some middle distance, as though a memory had briefly overtaken the present.\" }, { weight: 5, text: \"emote runs his thumb along the grain of his staff, a small private smile surfacing and fading.\" }, { weight: 1, text: \"emote goes still, one hand half-raised, like a man who has just remembered someone long gone.\" }, { weight: 2, text: \"emote turns his head toward some sound only he seems to have caught, holding still until it passes.\" }, { weight: 2, text: \"emote lets his gaze travel unhurriedly around the room, marking each way out without seeming to.\" }, { weight: 2, text: \"emote glances over his shoulder, then eases, as if reassuring himself the quiet held nothing.\" }, { weight: 2, text: \"emote narrows his eyes at a flicker of movement at the edge of his vision, watching until it resolves into nothing.\" }, { weight: 1, text: \"emote tilts his head, going briefly motionless, as though the air had carried him something.\" }, { weight: 1, text: \"emote draws a slow breath through his nose, reading the air the way another might read a page.\" }, { weight: 1, text: \"emote lowers a hand toward the ground, fingers spread, and holds it there a moment as if listening through his skin.\" }, { weight: 5, text: \"emote follows the path of some small creature with quiet, unhurried attention.\" }, { weight: 10, text: \"emote brushes something unseen from his palm and watches it fall.\" }, { weight: 5, text: \"emote settles his weight against his staff and simply observes, patient as old stone.\" }, { weight: 10, text: \"emote rolls a fragment of dried leaf between finger and thumb until it crumbles away.\" }, { weight: 1, text: \"emote lets his eyes rest on nothing at all, his thoughts plainly elsewhere.\" }, { weight: 2, text: \"emote arches a brow at something no one else can see, one corner of his mouth twitching.\" }];\n      break;\n\n    case \"Black Dragon\":\nAEM.emotes = [{ weight: 2, text: \"emote goes still, his great head lifting slightly, eyes fixed on some middle distance as though a memory had surfaced from a long way down.\" }, { weight: 10, text: \"emote (A single dark drop gathers at the edge of)'s jaw and falls, hissing into a thread of smoke that is gone before it lands.\" }, { weight: 1, text: \"emote holds one vast clawed forelimb half-raised, motionless, like something recalling a shape it has not held in a very long time.\" }, { weight: 2, text: \"emote turns his flattened snout toward a sound no one else has caught, the long neck still, until whatever it was has passed.\" }, { weight: 2, text: \"emote lets his gaze travel the room without haste, the dark eyes marking each way out and giving no sign of having done so.\" }, { weight: 10, text: \"emote (A slow breath leaves)'s snout, and for a moment the air before it shimmers with a heat that smells of scorched stone.\" }, { weight: 2, text: \"emote narrows his eyes at a flicker at the edge of sight, the whole immense form utterly still until it resolves into nothing.\" }, { weight: 5, text: \"emote drags the tip of one claw a slow inch across the ground, leaving a thin dark line that smokes faintly and fades.\" }, { weight: 1, text: \"emote tilts the great head, going briefly motionless, as though the air had carried him something worth keeping.\" }, { weight: 1, text: \"emote draws a long breath through his nostrils, reading the air the way another might read a page.\" }, { weight: 1, text: \"emote settles the massive dark weight of himself and simply watches, patiently.\" }, { weight: 5, text: \"emote follows the path of some small creature across the floor with quiet, unhurried attention, making no move toward it.\" }, { weight: 10, text: \"emote (A bead of something dark wells at the tip of) 's talon, drips, and sizzles into a thread of smoke before it reaches the ground.\" }, { weight: 1, text: \"emote lets the saucer eyes rest on nothing at all, the vast head lowered, his thoughts plainly a long way off.\" }, { weight: 2, text: \"emote lowers his head near the ground and holds it there, nostrils wide, as if listening to the earth through the heat of his own breath.\" }, { weight: 2, text: \"emote curls one corner of his lip from a razor-edged tooth at something no one else can see, the nearest thing to a private smile.\" }, { weight: 10, text: \"emote shifts his weight, and the ground notices.\" }\n];      \n      break;\n  }\n\n  AEM.minMinutes = 15;\n  AEM.maxMinutes = 19;\n\nfunction aemPick() {\n  var total = 0;\n  for (var t = 0; t < AEM.emotes.length; t++) total += AEM.emotes[t].weight;\n  var r = Math.random() * total;\n  for (var i = 0; i < AEM.emotes.length; i++) {\n    r -= AEM.emotes[i].weight;\n    if (r <= 0) return AEM.emotes[i].text;\n  }\n  return AEM.emotes[AEM.emotes.length - 1].text;\n}\nfunction aemSchedule() {\n  clearTimeout(AEM.timer);\n  var span = (AEM.maxMinutes - AEM.minMinutes) * 60000;\n  AEM.timer = setTimeout(aemFire, AEM.minMinutes * 60000 + Math.random() * span);\n}\nfunction aemFire() {\n  // The engine in use may have been replaced (a class change): only the\n  // current one sends.\n  if (client.loom.roleplay.aem !== AEM) return;\n  if (get_variable(\"roleplay_aem_on\") === \"1\" && get_variable(\"pauseTriggers\") !== \"on\") send_command(aemPick());\n  aemSchedule();\n}\nAEM.pick = aemPick;\nAEM.schedule = aemSchedule;\nAEM.has = !!(AEM.emotes && AEM.emotes.length);\nRP.aem = AEM;\nif (AEM.has && get_variable(\"roleplay_aem_on\") === \"1\") aemSchedule();\n"
  },
  {
   "type": "function",
   "name": "roleplay_help",
   "enabled": true,
   "code": "// roleplay_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[roleplay] emotes, rituals and ambient emotes. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"ROLEPLAY\", \"the class the emotes follow, and the ambient emotes\"],\n  [\"ROLEPLAY AEM ON / OFF\", \"an ambient emote every 15-19 minutes, or none\"],\n  [\"ROLEPLAY AEM NOW\", \"one ambient emote now\"],\n  [\"ROLEPLAY AEM RELOAD\", \"rebuild the ambient emotes (after editing them)\"],\n  [\"ROLEPLAY DEBUG\", \"internal state\"],\n  [\"custom_emotes\", \"the emotes, each worded for your class (a dragon's differ)\"],\n  [\"shoulder_massage, foot_massage, wash_hair <name> <step>\", \"rituals, one step at a time\"],\n  [\"graduation <name> <step>\", \"the Saiha graduation ceremony\"],\n  [\"cairnearth, cairnfire, cairnair, cairnwater\", \"the cairn verses\"],\n  [\"The emotes, rituals and verses are typed in lowercase.\"],\n  [\"Ambient emotes send nothing while triggers are paused.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "group",
   "name": "Emotes",
   "enabled": true,
   "items": [
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "display_notice(\"[roleplay] List of custom emotes: applaud, aww, bearhug, blink, blush, boo, bow, brb, bye, cackle, caress, cheer, chuckle, clap, comfort, contentsigh, crackneck, cuddle, dance, drawclose, drool, duh, earnibble, eek, eep, embrace, eww, exhale, flex, frown, fume, gasp, glare, grab, grin, growl, grunt, guard, hi, highfive, hug, hugbehind, innocent, jaw, kiss, lacehand, layback, laugh, love, lovetoo, massage, neckkiss, nibblekiss, nice, np, nudge, nuzzle, ohh, oops, ouch, peck, pff, phew, pinch, point, poke, raisehand, rolleyes, rufflehair, shake, shrug, sigh, sit, smile, snuggle, softsmile, stiffle, strand, suck, thank, think, tiptoe, waist, windy, yawn, yum.\");"
      }
     ],
     "text": "^custom_emotes$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var activeClass = (client.loom && client.loom.roleplay && client.loom.roleplay.cls) || get_variable(\"roleplay_class\") || \"\";\n\nif (activeClass == \"Black Dragon\") {\n  send_command(\"emote x\");\n} else {\n  send_command(\"y\", 1);\n}"
      }
     ],
     "text": "^_emote$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var activeClass = (client.loom && client.loom.roleplay && client.loom.roleplay.cls) || get_variable(\"roleplay_class\") || \"\";\nvar targetEmote = args[1];\n\nif (activeClass == \"Black Dragon\") {\n  send_command(\"emote x\");\n} else {\n  send_command(\"y \" + targetEmote, 1);\n}"
      }
     ],
     "text": "^_emote (\\w+)$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var activeClass = (client.loom && client.loom.roleplay && client.loom.roleplay.cls) || get_variable(\"roleplay_class\") || \"\";\n\nif (activeClass == \"Black Dragon\") {\n  send_command(\"emote beats his wings once, slow and deliberate, in approval.\");\n} else {\n  send_command(\"applaud\", 1);\n}"
      }
     ],
     "text": "^applaud$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var activeClass = (client.loom && client.loom.roleplay && client.loom.roleplay.cls) || get_variable(\"roleplay_class\") || \"\";\n\nif (activeClass == \"Black Dragon\") {\n  send_command(\"emote lets out a low, warm rumble deep in his chest.\");\n} else {\n  send_command(\"aww\", 1);\n}"
      }
     ],
     "text": "^aww$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var activeClass = (client.loom && client.loom.roleplay && client.loom.roleplay.cls) || get_variable(\"roleplay_class\") || \"\";\nvar targetEmote = args[1];\n\nif (activeClass == \"Black Dragon\") {\n  send_command(\"emote lowers his great head toward $\" + targetEmote + \" and rumbles, low and warm.\");\n} else {\n  send_command(\"aww \" + targetEmote, 1);\n}"
      }
     ],
     "text": "^aww (\\w+)$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var activeClass = (client.loom && client.loom.roleplay && client.loom.roleplay.cls) || get_variable(\"roleplay_class\") || \"\";\nvar targetEmote = args[1];\n\nif (activeClass == \"Black Dragon\") {\n  send_command(\"emote crosses to $\" + targetEmote + \" in two great strides and folds a wing around $\" + targetEmote + \"_him.\");\n} else {\n  send_command(\"bearhug \" + targetEmote, 1);\n}"
      }
     ],
     "text": "^bearhug (\\w+)$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var activeClass = (client.loom && client.loom.roleplay && client.loom.roleplay.cls) || get_variable(\"roleplay_class\") || \"\";\n\nif (activeClass == \"Black Dragon\") {\n  send_command(\"emote blinks, thin membranes sliding once across his eyes.\");\n} else {\n  send_command(\"blink\", 1);\n}"
      }
     ],
     "text": "^blink$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var activeClass = (client.loom && client.loom.roleplay && client.loom.roleplay.cls) || get_variable(\"roleplay_class\") || \"\";\n\nif (activeClass == \"Black Dragon\") {\n  send_command(\"emote (Vapour hissing thin between his teeth,) draws his wings in tight and turns his head away.\");\n} else {\n  send_command(\"blush\", 1);\n}"
      }
     ],
     "text": "^blush$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var activeClass = (client.loom && client.loom.roleplay && client.loom.roleplay.cls) || get_variable(\"roleplay_class\") || \"\";\n\nif (activeClass == \"Black Dragon\") {\n  send_command(\"emote snaps his jaws shut with a crack and rumbles in delight.\");\n} else {\n  send_command(\"boo\", 1);\n}"
      }
     ],
     "text": "^boo$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var activeClass = (client.loom && client.loom.roleplay && client.loom.roleplay.cls) || get_variable(\"roleplay_class\") || \"\";\nvar targetEmote = args[1];\n\nif (activeClass == \"Black Dragon\") {\n  send_command(\"emote looms suddenly over $\" + targetEmote + \", then rumbles loudly with delight.\");\n} else {\n  send_command(\"boo \" + targetEmote, 1);\n}"
      }
     ],
     "text": "^boo (\\w+)$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var activeClass = (client.loom && client.loom.roleplay && client.loom.roleplay.cls) || get_variable(\"roleplay_class\") || \"\";\n\nif (activeClass == \"Black Dragon\") {\n  send_command(\"emote sweeps one wing wide and lowers his forequarters to the ground.\");\n} else {\n  send_command(\"bow\", 1);\n}"
      }
     ],
     "text": "^bow$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var activeClass = (client.loom && client.loom.roleplay && client.loom.roleplay.cls) || get_variable(\"roleplay_class\") || \"\";\nvar targetEmote = args[1];\n\nif (activeClass == \"Black Dragon\") {\n  send_command(\"emote bows low before $\" + targetEmote + \", wings folded and head held down a moment.\");\n} else {\n  send_command(\"bow \" + targetEmote, 1);\n}"
      }
     ],
     "text": "^bow (\\w+)$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
