{
 "type": "group",
 "name": "coffers",
 "enabled": true,
 "description": "Gold tracker: fortune, income and spending by session and day, goals",
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"coffers_setup\", [], \"coffers\");\ndisplay_notice(\"[coffers] installed. Create a UI tab named 'Coffers' for the panel. COFFERS HELP lists the commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; every coffers_* variable is left intact.\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"Coffers\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 17\"><ellipse cx=\"10\" cy=\"13.5\" rx=\"8.5\" ry=\"2.8\" fill=\"#9c7330\"/><ellipse cx=\"10\" cy=\"12\" rx=\"8.5\" ry=\"2.8\" fill=\"#e2bd5a\" stroke=\"#9c7330\" stroke-width=\"0.6\"/><ellipse cx=\"10\" cy=\"9\" rx=\"8.5\" ry=\"2.8\" fill=\"#9c7330\"/><ellipse cx=\"10\" cy=\"7.5\" rx=\"8.5\" ry=\"2.8\" fill=\"#e2bd5a\" stroke=\"#9c7330\" stroke-width=\"0.6\"/><ellipse cx=\"10\" cy=\"4.5\" rx=\"8.5\" ry=\"2.8\" fill=\"#9c7330\"/><ellipse cx=\"10\" cy=\"3\" rx=\"8.5\" ry=\"2.8\" fill=\"#f3d781\" stroke=\"#9c7330\" stroke-width=\"0.6\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\n\nrun_function(\"coffers_setup\", [], \"coffers\");\nrun_function(\"coffers_render\", [], \"coffers\");"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Char.Status carries gold and bank: in full on login, then only the fields\n// that changed. Just remember the latest values. Char.Vitals comes once per\n// prompt, whatever the prompt looks like, and does the accounting, but not\n// on the one right after a gold or bank change: waiting a prompt makes sure\n// a deposit's gold and bank halves have both landed, so it counts as neither\n// income nor spending.\nvar gcM = \"\";\nvar gcA = null;\ntry { gcM = args.gmcp_method; gcA = args.gmcp_args; } catch (e) { gcM = \"\"; }\nif (gcM === \"Char.Status\" && gcA) {\n  if (typeof gcA === \"string\") { try { gcA = JSON.parse(gcA); } catch (e) { gcA = null; } }\n  if (gcA) {\n    if (!client.loom || !client.loom.coffers || !client.loom.coffers.f) run_function(\"coffers_setup\", [], \"coffers\");\n    var CO = client.loom.coffers;\n    if (!CO.live) { CO.live = {}; }\n    if (gcA.gold !== undefined) { var gcG = parseInt(String(gcA.gold).replace(/[^0-9\\-]/g, \"\"), 10); if (!isNaN(gcG)) { CO.live.gold = gcG; } }\n    if (gcA.bank !== undefined) { var gcB = parseInt(String(gcA.bank).replace(/[^0-9\\-]/g, \"\"), 10); if (!isNaN(gcB)) { CO.live.bank = gcB; } }\n    CO.live.at = Math.floor(new Date().getTime() / 1000);\n    if (gcA.gold !== undefined || gcA.bank !== undefined) CO.moneyMoved = true;\n  }\n}\nif (gcM === \"Char.Vitals\") {\n  if (!client.loom || !client.loom.coffers || !client.loom.coffers.f) run_function(\"coffers_setup\", [], \"coffers\");\n  if (client.loom.coffers.moneyMoved) client.loom.coffers.moneyMoved = false;\n  else { try { run_function(\"coffers_tick\", [], \"coffers\"); } catch (e) {} }\n}"
  },
  {
   "type": "function",
   "name": "coffers_setup",
   "enabled": true,
   "code": "// coffers_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, one-time migration of the\n// gc_* variables, then every piece of client.loom.coffers built from stored\n// variables, once: each piece is only built when missing. COFFERS REBUILD\n// drops the helpers so edits to them take effect without a page reload.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.coffers) client.loom.coffers = {};\nclient.loom.registry.coffers = { version: \"0.3.2\", keyword: \"COFFERS\", desc: \"Gold tracker: fortune, income and spending by session and day, goals\" };\nvar CO = client.loom.coffers;\n\n// One-time migration: gc_* -> coffers_*. A new variable that already holds\n// data wins; the old one is deleted either way.\nvar coMoves = [\"min\", \"days\", \"sessions\", \"rec\", \"sess\", \"graph_sess\", \"graph_long\", \"graph_h\", \"span_mins\", \"span_days\", \"gap\", \"bigcoin\", \"goal\", \"goal_base\", \"goal_t\", \"goal_done\"];\nfor (var coI = 0; coI < coMoves.length; coI++) {\n  var coOld;\n  try { coOld = get_variable(\"gc_\" + coMoves[coI]); } catch (e) { coOld = undefined; }\n  if (coOld !== undefined && coOld !== null) {\n    var coNew;\n    try { coNew = get_variable(\"coffers_\" + coMoves[coI]); } catch (e) { coNew = undefined; }\n    if (coNew === undefined || coNew === null || coNew === \"\") set_variable(\"coffers_\" + coMoves[coI], coOld);\n    delete_variable(\"gc_\" + coMoves[coI]);\n  }\n}\n// The old package kept its state in 23 loose client.gc* keys; drop them so a\n// reimport without a page reload doesn't leave two copies around. Data still\n// in memory (it can be a few seconds fresher than the saved copy) carries over.\nvar coOldKeys = [\"gc\", \"gcArgs\", \"gcBig\", \"gcChartH\", \"gcDaySpan\", \"gcDays\", \"gcF\", \"gcForce\", \"gcGap\", \"gcGoal\", \"gcGoalBase\", \"gcGoalDone\", \"gcGoalT\", \"gcGraphLong\", \"gcGraphSess\", \"gcLastWrite\", \"gcLive\", \"gcMin\", \"gcMins\", \"gcRec\", \"gcSess\", \"gcSessions\", \"gcTiers\"];\nvar coCarry = { gcLive: \"live\", gcMin: \"min\", gcDays: \"days\", gcSessions: \"sessions\", gcRec: \"rec\", gcSess: \"sess\" };\nfor (var coK in coCarry) {\n  if (coCarry.hasOwnProperty(coK) && client[coK] !== undefined && CO[coCarry[coK]] === undefined) CO[coCarry[coK]] = client[coK];\n}\nfor (var coJ = 0; coJ < coOldKeys.length; coJ++) {\n  if (client[coOldKeys[coJ]] !== undefined) delete client[coOldKeys[coJ]];\n}\n\nfunction gcRaw(name) {\n  var raw;\n  try { raw = get_variable(name); } catch (e) { raw = undefined; }\n  return raw;\n}\nfunction gcJSON(name, def) {\n  var raw = gcRaw(name);\n  if (raw === undefined || raw === null || raw === \"\") { return def; }\n  if (typeof raw === \"object\") { return raw; }\n  try { return JSON.parse(raw); } catch (e) { return def; }\n}\nfunction gcArr(name) {\n  var a = gcJSON(name, []);\n  if (Object.prototype.toString.call(a) !== \"[object Array]\") { a = []; }\n  return a;\n}\nfunction gcNum(name, def, lo, hi) {\n  var raw = gcRaw(name);\n  var v = def;\n  if (raw !== undefined && raw !== null && raw !== \"\") { v = parseInt(String(raw), 10); }\n  if (isNaN(v) || v < lo) { v = def; }\n  if (v > hi) { v = hi; }\n  return v;\n}\nfunction gcFlag(name) {\n  var raw = gcRaw(name);\n  return !(raw !== undefined && raw !== null && String(raw) === \"0\");\n}\n\n// Shared formatting helpers, stored on the namespace so every function can use them.\nfunction gcN(n) {\n  var neg = n < 0;\n  var s = String(Math.round(Math.abs(n)));\n  var out = \"\";\n  while (s.length > 3) { out = \",\" + s.slice(-3) + out; s = s.slice(0, -3); }\n  return (neg ? \"-\" : \"\") + s + out;\n}\nfunction gcS(n) { return (n > 0 ? \"+\" : \"\") + gcN(n); }\nfunction gcK(n) {\n  var a = Math.abs(n);\n  var sg = n < 0 ? \"-\" : \"\";\n  if (a < 1000) { return sg + String(Math.round(a)); }\n  if (a < 1000000) { return sg + (a < 10000 ? Math.round(a / 100) / 10 : Math.round(a / 1000)) + \"k\"; }\n  return sg + (a < 10000000 ? Math.round(a / 100000) / 10 : Math.round(a / 1000000)) + \"M\";\n}\nfunction gcDur(secs) {\n  if (secs < 3600) { return Math.max(0, Math.round(secs / 60)) + \"m\"; }\n  if (secs >= 86400) { return Math.round(secs / 86400 * 10) / 10 + \"d\"; }\n  var h = Math.floor(secs / 3600);\n  var m = Math.round((secs - h * 3600) / 60);\n  return h + \"h\" + (m > 0 ? \" \" + m + \"m\" : \"\");\n}\nfunction gcDayKey(t) {\n  var d = new Date(t * 1000);\n  return d.getFullYear() * 10000 + d.getMonth() * 100 + d.getDate();\n}\nfunction gcDayStart(t) {\n  var d = new Date(t * 1000);\n  d.setHours(0, 0, 0, 0);\n  return Math.floor(d.getTime() / 1000);\n}\nfunction gcDate(t) {\n  var MN = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"];\n  var d = new Date(t * 1000);\n  return d.getDate() + \" \" + MN[d.getMonth()];\n}\nfunction gcHM(t) {\n  var d = new Date(t * 1000);\n  var m = d.getMinutes();\n  return d.getHours() + \":\" + (m < 10 ? \"0\" : \"\") + m;\n}\nfunction gcTier(w) {\n  var T = client.loom.coffers.tiers;\n  var idx = 0;\n  for (var i = 0; i < T.length; i++) { if (w >= T[i][0]) { idx = i; } }\n  return idx;\n}\n\n// Wealth tiers, lowest first: [threshold, title]. Data, not branching.\nif (!CO.tiers) {\n  CO.tiers = [[0, \"Empty Pockets\"], [10000, \"Coin Purse\"], [100000, \"Strongbox\"], [500000, \"Coffer\"], [1000000, \"Counting House\"], [2500000, \"Vault\"], [5000000, \"Treasury\"], [10000000, \"Hoard\"], [50000000, \"Dragon's Hoard\"], [250000000, \"Mountain of Gold\"]];\n}\nif (!CO.f) {\n  CO.f = { n: gcN, s: gcS, k: gcK, dur: gcDur, dayKey: gcDayKey, dayStart: gcDayStart, date: gcDate, hm: gcHM, tier: gcTier };\n}\n\nif (!CO.live) { CO.live = {}; }\nif (!CO.min) { CO.min = gcArr(\"coffers_min\"); }\nif (!CO.days) { CO.days = gcArr(\"coffers_days\"); }\nif (!CO.sessions) { CO.sessions = gcArr(\"coffers_sessions\"); }\nif (!CO.rec) {\n  var rec = gcJSON(\"coffers_rec\", {});\n  if (!rec || typeof rec !== \"object\") { rec = {}; }\n  CO.rec = rec;\n}\nif (CO.sess === undefined) {\n  var ss = gcJSON(\"coffers_sess\", null);\n  if (!ss || typeof ss !== \"object\" || ss.s === undefined) { ss = null; }\n  CO.sess = ss;\n}\nif (CO.graphSess === undefined) { CO.graphSess = gcFlag(\"coffers_graph_sess\"); }\nif (CO.graphLong === undefined) { CO.graphLong = gcFlag(\"coffers_graph_long\"); }\nif (CO.chartH === undefined) { CO.chartH = gcNum(\"coffers_graph_h\", 105, 40, 400); }\nif (CO.mins === undefined) { CO.mins = gcNum(\"coffers_span_mins\", 180, 15, 720); }\nif (CO.daySpan === undefined) { CO.daySpan = gcNum(\"coffers_span_days\", 100, 7, 365); }\nif (CO.gap === undefined) { CO.gap = gcNum(\"coffers_gap\", 30, 5, 240); }\nif (CO.big === undefined) { CO.big = gcNum(\"coffers_bigcoin\", 1000, 0, 1000000000); }\n// The goal is an amount to earn, measured from the fortune held when it was\n// set (coffers_goal_base). A base of -1 means \"not yet taken\": the next prompt fills it.\nif (CO.goal === undefined) { CO.goal = gcNum(\"coffers_goal\", 0, 0, 2000000000); }\nif (CO.goalBase === undefined) { CO.goalBase = gcNum(\"coffers_goal_base\", -1, -1, 2000000000000); }\nif (CO.goalT === undefined) { CO.goalT = gcNum(\"coffers_goal_t\", 0, 0, 4000000000); }\nif (CO.goalDone === undefined) { CO.goalDone = String(gcRaw(\"coffers_goal_done\")) === \"1\"; }\n// Where an accepted goal came from (a package's proposal, #35); \"\" when set by hand.\nif (CO.goalSrc === undefined) { var gsRaw = gcRaw(\"coffers_goal_src\"); CO.goalSrc = (gsRaw === undefined || gsRaw === null) ? \"\" : String(gsRaw); }\n\n// The entry point other packages feed (#35), through loom's integrations: a\n// proposed goal waits as a suggestion, tagged with its source, until the\n// player accepts it (COFFERS ACCEPT: it becomes the goal) or dismisses it.\n// Defined on every run, so a reimport replaces it.\n//   entry.propose({ source, key, amount, why }) -> true when queued or\n//     updated. One proposal per source and key: a newer one replaces the\n//     older quietly. A dismissed one stays away until its source withdraws\n//     it (its condition cleared); then it can come back.\n//   entry.withdraw(source[, key]) -> how many proposals were taken back.\nif (!CO.proposals) { CO.proposals = gcArr(\"coffers_proposals\"); }\nif (!CO.dismissed) { var cdRaw = gcJSON(\"coffers_dismissed\", {}); CO.dismissed = (cdRaw && typeof cdRaw === \"object\") ? cdRaw : {}; }\nCO.saveProposals = function () {\n  try { set_variable(\"coffers_proposals\", JSON.stringify(CO.proposals)); } catch (e) {}\n  var any = false;\n  for (var k in CO.dismissed) { if (CO.dismissed.hasOwnProperty(k)) { any = true; break; } }\n  try { if (any) set_variable(\"coffers_dismissed\", JSON.stringify(CO.dismissed)); else delete_variable(\"coffers_dismissed\"); } catch (e) {}\n};\nCO.entry = {\n  propose: function (pr) {\n    if (!pr || !pr.source || pr.key === undefined || pr.key === null) return false;\n    var amount = Math.round(Number(pr.amount));\n    if (!(amount > 0)) return false;\n    var src = String(pr.source), key = String(pr.key);\n    if (CO.dismissed[src + \"|\" + key]) return false;\n    var why = String(pr.why || \"\");\n    var t = Math.floor(new Date().getTime() / 1000);\n    var P = CO.proposals;\n    for (var i = 0; i < P.length; i++) {\n      if (P[i].src === src && P[i].key === key) {\n        P[i].amount = amount; P[i].why = why; P[i].t = t;\n        CO.saveProposals();\n        run_function(\"coffers_render\", [], \"coffers\");\n        return true;\n      }\n    }\n    P.push({ src: src, key: key, amount: amount, why: why, t: t });\n    while (P.length > 10) { P.shift(); }\n    CO.saveProposals();\n    display_notice(\"[coffers] \" + src + \" proposes a goal: earn \" + CO.f.n(amount) + \" gold\" + (why ? \" \\u2014 \" + why : \"\") + \". COFFERS ACCEPT to take it, COFFERS DISMISS to drop it.\", \"cyan\");\n    run_function(\"coffers_render\", [], \"coffers\");\n    return true;\n  },\n  withdraw: function (source, key) {\n    if (!source) return 0;\n    var src = String(source), k = (key === undefined || key === null) ? null : String(key);\n    var P = CO.proposals, n = 0;\n    for (var i = P.length - 1; i >= 0; i--) {\n      if (P[i].src === src && (k === null || P[i].key === k)) { P.splice(i, 1); n++; }\n    }\n    var dropped = false;\n    for (var dk in CO.dismissed) {\n      if (CO.dismissed.hasOwnProperty(dk) && (k === null ? dk.indexOf(src + \"|\") === 0 : dk === src + \"|\" + k)) { delete CO.dismissed[dk]; dropped = true; }\n    }\n    if (n || dropped) CO.saveProposals();\n    if (n) run_function(\"coffers_render\", [], \"coffers\");\n    return n;\n  }\n};\n\n// Gold given to you (#53): \"Grulk gives 5,000 gold sovereigns to you.\"\n// Kept in memory only, newest last, the last 30: { who, amount, t }.\nif (!CO.gifts) CO.gifts = [];\n// The read-only look other packages see through loom: never its variables.\n//   look.gifts(since) -> copies of the gifts received after time `since`\n//     (all of this page load's with no argument), oldest first.\nCO.look = {\n  gifts: function (since) {\n    var out = [];\n    for (var i = 0; i < CO.gifts.length; i++) { if (!since || CO.gifts[i].t > since) out.push({ who: CO.gifts[i].who, amount: CO.gifts[i].amount, t: CO.gifts[i].t }); }\n    return out;\n  }\n};\n"
  },
  {
   "type": "function",
   "name": "coffers_tick",
   "enabled": true,
   "code": "// Runs once per prompt, from Char.Vitals (see onGMCP). Wealth is gold on hand + bank, so a deposit or a\n// withdrawal moves nothing; only money that enters or leaves the character\n// counts as income or spending.\nif (!client.loom || !client.loom.coffers || !client.loom.coffers.f) run_function(\"coffers_setup\", [], \"coffers\");\nvar CO = client.loom.coffers;\nvar F = CO.f;\nvar L = CO.live;\nvar g = L.gold;\nvar b = L.bank;\nvar now = Math.floor(new Date().getTime() / 1000);\n\n// Session buffer: one point per wall-clock minute, flat while idle.\nfunction feedMin() {\n  var arr = CO.min;\n  if (arr.length === 0) { arr.push([now, g, b]); return true; }\n  var last = arr[arr.length - 1];\n  if (Math.floor(last[0] / 60) !== Math.floor(now / 60)) { arr.push([now, g, b]); return true; }\n  if (last[1] !== g || last[2] !== b) { last[0] = now; last[1] = g; last[2] = b; return true; }\n  return false;\n}\n\n// Day buffer: [t, gold, bank, in, out]. Days never played are carried\n// forward flat with no flow. When a day closes it is checked for a record.\nfunction feedDay() {\n  var arr = CO.days;\n  if (arr.length === 0) { arr.push([now, g, b, 0, 0]); return true; }\n  var last = arr[arr.length - 1];\n  if (last[3] === undefined) { last[3] = 0; }\n  if (last[4] === undefined) { last[4] = 0; }\n  if (F.dayKey(last[0]) === F.dayKey(now)) {\n    if (last[1] !== g || last[2] !== b) { last[0] = now; last[1] = g; last[2] = b; return true; }\n    return false;\n  }\n  var R = CO.rec;\n  var closedNet = last[3] - last[4];\n  if (closedNet > 0 && (!R.bestDay || closedNet > R.bestDay.net)) {\n    R.bestDay = { net: closedNet, t: last[0] };\n    display_notice(\"[coffers] yesterday's books are closed: \" + F.s(closedNet) + \" gold. A new best day!\", \"lime\");\n  }\n  var cut = now - CO.daySpan * 86400;\n  var todayStart = F.dayStart(now);\n  var cur = new Date(F.dayStart(last[0]) * 1000);\n  cur.setDate(cur.getDate() + 1);\n  var guard = 0;\n  while (Math.floor(cur.getTime() / 1000) < todayStart && guard < 400) {\n    var noon = Math.floor(cur.getTime() / 1000) + 43200;\n    if (noon >= cut) { arr.push([noon, last[1], last[2], 0, 0]); }\n    cur.setDate(cur.getDate() + 1);\n    guard++;\n  }\n  arr.push([now, g, b, 0, 0]);\n  return true;\n}\n\nif (g !== undefined && b !== undefined) {\n  var W = g + b;\n  var R = CO.rec;\n  var changed = false;\n  var force = CO.force ? true : false;\n  CO.force = false;\n\n  // A silence longer than the gap closes the old session before this one opens.\n  if (CO.sess && (now - CO.sess.last) > CO.gap * 60) {\n    run_function(\"coffers_close\", [], \"coffers\");\n  }\n  if (!CO.sess) {\n    CO.sess = { s: now, last: now, w0: W, w1: W, inn: 0, out: 0, peak: W, low: W, big: 0 };\n    changed = true;\n    force = true;\n    display_notice(\"[coffers] the books are open: \" + F.n(W) + \" gold (\" + F.n(g) + \" in the purse, \" + F.n(b) + \" in the bank).\", \"cyan\");\n  }\n  var S = CO.sess;\n  S.last = now;\n\n  if (feedMin()) { changed = true; }\n  if (feedDay()) { changed = true; }\n  var T = CO.days[CO.days.length - 1];\n\n  // S.w1 is the last wealth this session accounted for. It is persisted with\n  // the day row, so a reload mid-session neither loses nor double counts.\n  var d = W - S.w1;\n  if (d !== 0) {\n    if (d > 0) {\n      S.inn += d;\n      T[3] += d;\n      if (d > S.big) { S.big = d; }\n    } else {\n      S.out -= d;\n      T[4] -= d;\n    }\n    S.w1 = W;\n    if (W > S.peak) { S.peak = W; }\n    if (W < S.low) { S.low = W; }\n    changed = true;\n    force = true;\n    if (CO.big > 0 && d >= CO.big) {\n      display_notice(\"[coffers] Ka-ching! \" + F.s(d) + \" gold. Session \" + F.s(S.inn - S.out) + \", fortune \" + F.n(W) + \".\", \"lime\");\n    } else if (CO.big > 0 && -d >= CO.big) {\n      display_notice(\"[coffers] \" + F.n(-d) + \" gold just left the purse. Session \" + F.s(S.inn - S.out) + \".\", \"orange\");\n    }\n  }\n\n  if (!R.peak || W > R.peak.w) { R.peak = { w: W, t: now }; }\n  // The ratchet stores the threshold reached, not the table index, so the\n  // tier table can be edited without confusing it.\n  var ti = F.tier(W);\n  var tAt = CO.tiers[ti][0];\n  if (R.tierAt === undefined) { R.tierAt = tAt; force = true; }\n  else if (tAt > R.tierAt) {\n    R.tierAt = tAt;\n    force = true;\n    display_notice(\"[coffers] *** MILESTONE *** your fortune passes \" + F.n(CO.tiers[ti][0]) + \" gold. Welcome to the \" + CO.tiers[ti][1] + \".\", \"lime\");\n  }\n\n  // Goal: take the base on the first reading after it was set, and announce\n  // once when the earnings since then reach the target.\n  if (CO.goal > 0) {\n    if (CO.goalBase < 0) {\n      CO.goalBase = W;\n      CO.goalT = now;\n      try { set_variable(\"coffers_goal_base\", String(W)); set_variable(\"coffers_goal_t\", String(now)); } catch (e) {}\n    } else if (!CO.goalDone && W - CO.goalBase >= CO.goal) {\n      CO.goalDone = true;\n      try { set_variable(\"coffers_goal_done\", \"1\"); } catch (e) {}\n      display_notice(\"[coffers] *** GOAL REACHED *** \" + F.s(CO.goal) + \" gold earned since \" + F.date(CO.goalT) + \". Set the next one with COFFERS GOAL.\", \"lime\");\n    }\n  }\n\n  // Trailing windows: anything older than the span falls off the front.\n  var minCut = now - CO.mins * 60;\n  while (CO.min.length > 0 && CO.min[0][0] < minCut) { CO.min.shift(); }\n  var dayCut = now - CO.daySpan * 86400;\n  while (CO.days.length > 1 && CO.days[0][0] < dayCut) { CO.days.shift(); }\n\n  var lw = CO.lastWrite || 0;\n  if (changed && (force || (now - lw) >= 5)) {\n    CO.lastWrite = now;\n    try { set_variable(\"coffers_min\", JSON.stringify(CO.min)); } catch (e) {}\n    try { set_variable(\"coffers_days\", JSON.stringify(CO.days)); } catch (e) {}\n    try { set_variable(\"coffers_sess\", JSON.stringify(CO.sess)); } catch (e) {}\n    try { set_variable(\"coffers_rec\", JSON.stringify(CO.rec)); } catch (e) {}\n  }\n  if (changed) { run_function(\"coffers_render\", [], \"coffers\"); }\n}"
  },
  {
   "type": "function",
   "name": "coffers_close",
   "enabled": true,
   "code": "// Closes the open session: archives it, checks it for a record, prints the\n// digest. Called by the tick after a long silence, and by COFFERS NEW.\nif (!client.loom || !client.loom.coffers || !client.loom.coffers.f) run_function(\"coffers_setup\", [], \"coffers\");\nvar CO = client.loom.coffers;\nvar F = CO.f;\nvar S = CO.sess;\nif (S) {\n  var dur = S.last - S.s;\n  var net = S.inn - S.out;\n  if (dur >= 60 || S.inn > 0 || S.out > 0) {\n    CO.sessions.push({ s: S.s, e: S.last, w0: S.w0, w1: S.w1, inn: S.inn, out: S.out, peak: S.peak, low: S.low, big: S.big });\n    while (CO.sessions.length > 50) { CO.sessions.shift(); }\n    var R = CO.rec;\n    var isRec = false;\n    if (net > 0 && (!R.bestSess || net > R.bestSess.net)) { R.bestSess = { net: net, s: S.s, dur: dur }; isRec = true; }\n    var line = \"[coffers] session of \" + F.date(S.s) + \" \" + F.hm(S.s) + \" closed after \" + F.dur(dur) + \": net \" + F.s(net) + \" gold (in \" + F.n(S.inn) + \", out \" + F.n(S.out) + \")\";\n    if (dur >= 600) { line += \", \" + F.s(Math.round(net / (dur / 3600))) + \"/hr\"; }\n    display_notice(line + \".\", net >= 0 ? \"lime\" : \"orange\");\n    if (isRec) { display_notice(\"[coffers] *** that was your most profitable session yet ***\", \"lime\"); }\n    try { set_variable(\"coffers_sessions\", JSON.stringify(CO.sessions)); } catch (e) {}\n    try { set_variable(\"coffers_rec\", JSON.stringify(CO.rec)); } catch (e) {}\n  }\n  CO.sess = null;\n  try { set_variable(\"coffers_sess\", \"\"); } catch (e) {}\n}"
  },
  {
   "type": "function",
   "name": "coffers_render",
   "enabled": true,
   "code": "// Draws the Coffers tab. Nexus tabs will not run injected <script>, so every\n// chart is static inline SVG, redrawn whenever the tick changes something.\nif (!client.loom || !client.loom.coffers || !client.loom.coffers.f) run_function(\"coffers_setup\", [], \"coffers\");\nvar CO = client.loom.coffers;\nvar F = CO.f;\nvar GOLD = \"#e2bd5a\";\nvar BRONZE = \"#9c7330\";\nvar TXT = \"#e9dfc6\";\nvar MUTED = \"#8c8170\";\nvar RULE = \"#3a3122\";\nvar UP = \"#93cf8a\";\nvar DOWN = \"#de8a72\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nvar now = Math.floor(new Date().getTime() / 1000);\n\nfunction n1(n) { return Math.round(n * 10) / 10; }\nfunction niceStep(range) {\n  var raw = range / 4;\n  if (raw <= 0) { raw = 1; }\n  var mag = Math.pow(10, Math.floor(Math.log(raw) / Math.LN10));\n  var m = [1, 2, 2.5, 5, 10];\n  for (var i = 0; i < m.length; i++) { if (mag * m[i] >= raw) { return Math.max(1, mag * m[i]); } }\n  return Math.max(1, mag * 10);\n}\nfunction axisLbl(v, step) {\n  if (Math.abs(v) >= 1000000) { return (v / 1000000).toFixed(step >= 1000000 ? 0 : (step >= 100000 ? 1 : 2)) + \"M\"; }\n  return F.n(v);\n}\nfunction wealth(p) { return p[1] + p[2]; }\nfunction color(v) { return v > 0 ? UP : (v < 0 ? DOWN : MUTED); }\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/'/g, \"&#39;\"); }\n\n// A chart frame is plain data; sy/sx take it as their first argument.\nfunction frame(W, H, vmin, vmax, step, tmin, tmax) {\n  var fs = Math.max(7, Math.min(10, Math.round(H * 0.085)));\n  var widest = 2;\n  var probe = Math.ceil(vmin / step) * step;\n  while (probe <= vmax) { widest = Math.max(widest, axisLbl(probe, step).length); probe += step; }\n  if (tmax <= tmin) { tmax = tmin + 60; }\n  return { W: W, H: H, fs: fs, x0: Math.round(widest * fs * 0.62) + 6, x1: W - 6, y0: Math.round(fs * 0.9), y1: H - Math.round(fs * 1.9), vmin: vmin, vmax: vmax, step: step, tmin: tmin, tmax: tmax };\n}\nfunction sy(fr, v) { return fr.y1 - ((v - fr.vmin) / (fr.vmax - fr.vmin)) * (fr.y1 - fr.y0); }\nfunction sx(fr, t) { return fr.x0 + ((t - fr.tmin) / (fr.tmax - fr.tmin)) * (fr.x1 - fr.x0); }\nfunction grid(fr) {\n  var out = \"\";\n  var gv = Math.ceil(fr.vmin / fr.step) * fr.step;\n  while (gv <= fr.vmax) {\n    var gy = n1(sy(fr, gv));\n    out += '<line x1=\"' + fr.x0 + '\" y1=\"' + gy + '\" x2=\"' + fr.x1 + '\" y2=\"' + gy + '\" stroke=\"' + (gv === 0 ? BRONZE : RULE) + '\" stroke-width=\"' + (gv === 0 ? 0.9 : 0.6) + '\"/>';\n    out += '<text x=\"' + (fr.x0 - 3) + '\" y=\"' + n1(gy + fr.fs * 0.35) + '\" text-anchor=\"end\" font-family=\"' + MONO + '\" font-size=\"' + fr.fs + '\" fill=\"' + MUTED + '\">' + axisLbl(gv, fr.step) + '</text>';\n    gv += fr.step;\n  }\n  return out;\n}\nfunction xLabels(fr, a, b) {\n  var y = fr.H - 3;\n  return '<text x=\"' + fr.x0 + '\" y=\"' + y + '\" font-family=\"' + MONO + '\" font-size=\"' + fr.fs + '\" fill=\"' + MUTED + '\">' + a + '</text>' +\n    '<text x=\"' + fr.x1 + '\" y=\"' + y + '\" text-anchor=\"end\" font-family=\"' + MONO + '\" font-size=\"' + fr.fs + '\" fill=\"' + MUTED + '\">' + b + '</text>';\n}\nfunction svgOpen(W, H) { return '<svg viewBox=\"0 0 ' + W + ' ' + H + '\" width=\"100%\" style=\"display:block;height:auto;overflow:visible;\" xmlns=\"http://www.w3.org/2000/svg\">'; }\n\n// Wealth line (gold + bank) with a soft gold fill; optional dashed marker,\n// used to show where the current session began.\nfunction wealthChart(hs, W, H, dayScale, markT) {\n  var first = hs[0];\n  var last = hs[hs.length - 1];\n  var vmin = 1e15, vmax = -1e15, i, v;\n  for (i = 0; i < hs.length; i++) { v = wealth(hs[i]); if (v < vmin) { vmin = v; } if (v > vmax) { vmax = v; } }\n  if (vmax - vmin < 20) { vmin -= 10; vmax += 10; }\n  var pad = (vmax - vmin) * 0.12;\n  vmin = Math.max(0, vmin - pad);\n  vmax += pad;\n  var fr = frame(W, H, vmin, vmax, niceStep(vmax - vmin), first[0], last[0]);\n  var stride = Math.ceil(hs.length / 320);\n  var line = \"\";\n  var k = 0;\n  for (i = 0; i < hs.length; i += stride) { line += (k === 0 ? \"M\" : \"L\") + n1(sx(fr, hs[i][0])) + \",\" + n1(sy(fr, wealth(hs[i]))); k++; }\n  line += \"L\" + n1(sx(fr, last[0])) + \",\" + n1(sy(fr, wealth(last)));\n  var area = line + \"L\" + n1(sx(fr, last[0])) + \",\" + fr.y1 + \"L\" + n1(sx(fr, first[0])) + \",\" + fr.y1 + \"Z\";\n  var out = svgOpen(W, H) + grid(fr);\n  out += '<path d=\"' + area + '\" fill=\"' + GOLD + '\" fill-opacity=\"0.13\" stroke=\"none\"/>';\n  if (markT && markT > fr.tmin && markT < fr.tmax) {\n    var mx = n1(sx(fr, markT));\n    out += '<line x1=\"' + mx + '\" y1=\"' + fr.y0 + '\" x2=\"' + mx + '\" y2=\"' + fr.y1 + '\" stroke=\"' + BRONZE + '\" stroke-width=\"0.8\" stroke-dasharray=\"2,2\"/>';\n  }\n  out += '<path d=\"' + line + '\" fill=\"none\" stroke=\"' + GOLD + '\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/>';\n  out += '<circle cx=\"' + n1(sx(fr, last[0])) + '\" cy=\"' + n1(sy(fr, wealth(last))) + '\" r=\"2.4\" fill=\"#fff1b8\"/>';\n  out += xLabels(fr, dayScale ? F.date(first[0]) : F.hm(first[0]), dayScale ? F.date(last[0]) : F.hm(last[0]));\n  return out + '</svg>';\n}\n\n// Small typographic helpers for the ledger blocks.\nfunction caps(t, col) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (col || BRONZE) + ';font-size:11px;margin:0 0 2px;\">' + t + '</div>'; }\nfunction row(label, value, col) {\n  return '<div style=\"display:flex;justify-content:space-between;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"color:' + MUTED + ';white-space:nowrap;\">' + label + '</span><span style=\"color:' + (col || TXT) + ';white-space:nowrap;\">' + value + '</span></div>';\n}\nfunction bar(pct, col, h) {\n  pct = Math.max(0, Math.min(100, pct));\n  return '<div style=\"background:#2a2318;height:' + h + 'px;width:100%;margin:2px 0;\"><div style=\"background:' + col + ';height:' + h + 'px;width:' + n1(pct) + '%;\"></div></div>';\n}\nfunction box(inner) { return '<div style=\"flex:1 1 130px;min-width:130px;border-top:2px solid ' + BRONZE + ';padding:3px 2px 0;\">' + inner + '</div>'; }\nfunction section(title, inner) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title) + inner + '</div>'; }\n\nvar coins = '<svg width=\"20\" height=\"17\" viewBox=\"0 0 20 17\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<ellipse cx=\"10\" cy=\"13.5\" rx=\"8.5\" ry=\"2.8\" fill=\"' + BRONZE + '\"/><ellipse cx=\"10\" cy=\"12\" rx=\"8.5\" ry=\"2.8\" fill=\"' + GOLD + '\" stroke=\"' + BRONZE + '\" stroke-width=\"0.6\"/>' +\n  '<ellipse cx=\"10\" cy=\"9\" rx=\"8.5\" ry=\"2.8\" fill=\"' + BRONZE + '\"/><ellipse cx=\"10\" cy=\"7.5\" rx=\"8.5\" ry=\"2.8\" fill=\"' + GOLD + '\" stroke=\"' + BRONZE + '\" stroke-width=\"0.6\"/>' +\n  '<ellipse cx=\"10\" cy=\"4.5\" rx=\"8.5\" ry=\"2.8\" fill=\"' + BRONZE + '\"/><ellipse cx=\"10\" cy=\"3\" rx=\"8.5\" ry=\"2.8\" fill=\"#f3d781\" stroke=\"' + BRONZE + '\" stroke-width=\"0.6\"/></svg>';\n\nvar mins = CO.min || [];\nvar days = CO.days || [];\nvar L = CO.live || {};\nvar g, b;\nif (L.gold !== undefined && L.bank !== undefined) { g = L.gold; b = L.bank; }\nelse if (mins.length > 0) { g = mins[mins.length - 1][1]; b = mins[mins.length - 1][2]; }\nelse if (days.length > 0) { g = days[days.length - 1][1]; b = days[days.length - 1][2]; }\n\nvar html = '<div style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:#16120b;border:1px solid ' + RULE + ';padding:7px 8px 8px;\">';\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + BRONZE + ';padding-bottom:3px;\">';\nhtml += '<div style=\"font-family:' + SERIF + ';color:' + GOLD + ';font-size:14px;letter-spacing:0.22em;\">' + coins + 'COFFERS</div>';\n\nif (g === undefined) {\n  html += '</div><div style=\"color:' + MUTED + ';margin-top:8px;font-family:' + SERIF + ';font-style:italic;\">The ledger is empty. It fills itself the moment the game reports your purse; try SCORE or a quick deposit if nothing appears.</div></div>';\n} else {\n  var W = g + b;\n  var T = CO.tiers;\n  var ti = F.tier(W);\n  html += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + BRONZE + ';font-size:11px;\">' + esc(T[ti][1]) + '</div></div>';\n\n  // The fortune itself, set large in the serif: this is the number that matters.\n  html += '<div style=\"margin:6px 0 1px;\"><span style=\"font-family:' + SERIF + ';font-size:26px;color:' + GOLD + ';letter-spacing:0.02em;\">' + F.n(W) + '</span>';\n  html += ' <span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">gold sovereigns</span></div>';\n  var handPct = W > 0 ? g / W * 100 : 0;\n  html += '<div style=\"display:flex;height:6px;width:100%;margin:2px 0 1px;background:#2a2318;\"><div style=\"background:' + GOLD + ';width:' + n1(handPct) + '%;\"></div><div style=\"background:' + BRONZE + ';width:' + n1(100 - handPct) + '%;\"></div></div>';\n  html += '<div style=\"display:flex;justify-content:space-between;color:' + MUTED + ';\"><span><span style=\"color:' + GOLD + ';\">&#9632;</span> ' + F.n(g) + ' in the purse</span><span>' + F.n(b) + ' in the bank <span style=\"color:' + BRONZE + ';\">&#9632;</span></span></div>';\n\n  // Next tier, and the personal goal if one is set.\n  if (ti < T.length - 1) {\n    var lo = T[ti][0], hi = T[ti + 1][0];\n    var tp = (W - lo) / (hi - lo) * 100;\n    html += '<div style=\"margin-top:6px;display:flex;justify-content:space-between;\"><span style=\"color:' + MUTED + ';\">next: <span style=\"font-family:' + SERIF + ';color:' + TXT + ';\">' + esc(T[ti + 1][1]) + '</span> at ' + F.k(hi) + '</span><span style=\"color:' + TXT + ';\">' + F.n(hi - W) + ' to go</span></div>';\n    html += bar(tp, BRONZE, 3);\n  }\n  if (CO.goal > 0 && CO.goalBase >= 0) {\n    var gEarn = W - CO.goalBase;\n    var gp = gEarn / CO.goal * 100;\n    html += '<div style=\"margin-top:3px;display:flex;justify-content:space-between;\"><span style=\"color:' + MUTED + ';\">goal ' + F.s(CO.goal) + ' since ' + F.date(CO.goalT) + (CO.goalSrc ? ' &middot; ' + esc(CO.goalSrc) : '') + '</span><span style=\"color:' + (gp >= 100 ? UP : color(gEarn)) + ';\">' + (gp >= 100 ? \"reached! \" + F.s(gEarn) : F.s(gEarn) + \" &middot; \" + Math.max(0, Math.floor(gp)) + \"%\") + '</span></div>';\n    html += bar(gp, gp >= 100 ? UP : GOLD, 3);\n  }\n  // Goals other packages proposed (#35), waiting for ACCEPT or DISMISS.\n  var PR = CO.proposals || [];\n  if (PR.length) {\n    var pin = \"\";\n    for (var pq = 0; pq < PR.length; pq++) {\n      pin += '<div style=\"display:flex;gap:6px;align-items:baseline;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"color:' + MUTED + ';min-width:1.4em;\">' + (pq + 1) + '.</span>' +\n        '<span style=\"flex:1 1 auto;min-width:0;color:' + TXT + ';\">earn <span style=\"color:' + GOLD + ';\">' + F.n(PR[pq].amount) + '</span>' + (PR[pq].why ? ' &mdash; ' + esc(PR[pq].why) : '') + ' <span style=\"color:' + MUTED + ';\">&middot; ' + esc(PR[pq].src) + '</span></span></div>';\n    }\n    pin += '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;margin-top:2px;\">COFFERS ACCEPT makes the first your goal, COFFERS DISMISS drops it.</div>';\n    html += section(\"Proposed goals\", pin);\n  }\n\n  // Three ledger columns: this session, today, and the all-time records.\n  var S = CO.sess;\n  var R = CO.rec || {};\n  var cols = '<div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;\">';\n  var sb = caps(\"This session\");\n  if (S) {\n    var sDur = Math.max(0, S.last - S.s);\n    var sNet = S.inn - S.out;\n    sb += '<div style=\"font-family:' + SERIF + ';font-size:16px;color:' + color(sNet) + ';\">' + F.s(sNet) + '</div>';\n    sb += row(\"since\", F.hm(S.s) + \" &middot; \" + F.dur(sDur));\n    sb += row(\"in\", F.n(S.inn), S.inn > 0 ? UP : TXT);\n    sb += row(\"out\", F.n(S.out), S.out > 0 ? DOWN : TXT);\n    sb += row(\"per hour\", sDur >= 600 ? F.s(Math.round(sNet / (sDur / 3600))) : \"&hellip;\", sDur >= 600 ? color(sNet) : MUTED);\n    if (S.big > 0) { sb += row(\"best haul\", F.s(S.big), GOLD); }\n  } else {\n    sb += '<div style=\"color:' + MUTED + ';\">No session open.</div>';\n  }\n  cols += box(sb);\n\n  var today = (days.length > 0 && F.dayKey(days[days.length - 1][0]) === F.dayKey(now)) ? days[days.length - 1] : null;\n  var tb = caps(\"Today\");\n  var tIn = today ? (today[3] || 0) : 0;\n  var tOut = today ? (today[4] || 0) : 0;\n  var tNet = tIn - tOut;\n  tb += '<div style=\"font-family:' + SERIF + ';font-size:16px;color:' + color(tNet) + ';\">' + F.s(tNet) + '</div>';\n  tb += row(\"date\", F.date(now));\n  tb += row(\"in\", F.n(tIn), tIn > 0 ? UP : TXT);\n  tb += row(\"out\", F.n(tOut), tOut > 0 ? DOWN : TXT);\n  if (R.bestDay && R.bestDay.net > 0) {\n    if (tNet > R.bestDay.net) { tb += '<div style=\"color:' + GOLD + ';font-family:' + SERIF + ';font-style:italic;margin-top:2px;\">&#9733; record day in the making</div>'; }\n    else { tb += row(\"to beat\", F.n(R.bestDay.net), MUTED); }\n  }\n  cols += box(tb);\n\n  var rb = caps(\"Records\");\n  if (R.peak) { rb += row(\"peak fortune\", F.n(R.peak.w), GOLD); }\n  rb += row(\"best day\", R.bestDay ? \"<span title='\" + F.date(R.bestDay.t) + \"'>\" + F.s(R.bestDay.net) + \"</span>\" : \"&mdash;\", R.bestDay ? UP : MUTED);\n  rb += row(\"best session\", R.bestSess ? \"<span title='\" + F.date(R.bestSess.s) + \", \" + F.dur(R.bestSess.dur) + \"'>\" + F.s(R.bestSess.net) + \"</span>\" : \"&mdash;\", R.bestSess ? UP : MUTED);\n  rb += row(\"sessions kept\", String((CO.sessions || []).length));\n  cols += box(rb);\n  html += cols + '</div>';\n\n  if (CO.graphSess) {\n    if (mins.length < 2) {\n      html += section(\"Last \" + CO.mins + \" minutes\", '<div style=\"color:' + MUTED + ';\">Collecting; a point lands every minute.</div>');\n    } else {\n      html += section(\"Last \" + CO.mins + \" minutes\", wealthChart(mins, 640, CO.chartH, false, S ? S.s : 0));\n    }\n  }\n  if (CO.graphLong) {\n    if (days.length < 2) {\n      html += section(\"Day by day\", '<div style=\"color:' + MUTED + ';\">Collecting; one entry per day. The graph appears from the second day.</div>');\n    } else {\n      var lSpan = (days[days.length - 1][0] - days[0][0]) / 86400;\n      var lGain = wealth(days[days.length - 1]) - wealth(days[0]);\n      var note = '<div style=\"color:' + MUTED + ';margin:2px 0 4px;\">fortune over ' + Math.max(1, Math.round(lSpan)) + 'd: <span style=\"color:' + color(lGain) + ';\">' + F.s(lGain) + '</span>' + (lSpan >= 1 ? ' &middot; ' + F.s(Math.round(lGain / lSpan)) + '/day' : '') + '</div>';\n      html += section(\"Day by day\", note + wealthChart(days, 640, CO.chartH, true, 0));\n    }\n  }\n  html += '</div>';\n}\n\ntry { set_custom_tab_html(\"Coffers\", html); } catch (e) {}"
  },
  {
   "type": "function",
   "name": "coffers_cmd",
   "enabled": true,
   "code": "// COFFERS <sub> <p1> <p2>. The alias stores the words in CO.args,\n// since run_function cannot pass parameters.\nif (!client.loom || !client.loom.coffers || !client.loom.coffers.f) run_function(\"coffers_setup\", [], \"coffers\");\nvar CO = client.loom.coffers;\nvar F = CO.f;\nvar A = CO.args || [];\nvar c = A[0] || \"\";\nvar p1 = A[1] || \"\";\nvar p2 = A[2] || \"\";\nvar now = Math.floor(new Date().getTime() / 1000);\n\nfunction say(t, col) { display_notice(\"[coffers] \" + t, col || \"cyan\"); }\nfunction plain(t) { display_notice(t, \"white\"); }\nfunction save(name, val) { try { set_variable(name, val); } catch (e) {} }\nfunction amt(s) {\n  var m = /^(\\d+(?:\\.\\d+)?)([km]?)$/.exec(s);\n  if (!m) { return -1; }\n  var v = parseFloat(m[1]);\n  if (m[2] === \"k\") { v *= 1000; }\n  if (m[2] === \"m\") { v *= 1000000; }\n  return Math.round(v);\n}\nfunction lpad(s, n) { s = String(s); while (s.length < n) { s = \" \" + s; } return s; }\nfunction rpad(s, n) { s = String(s); while (s.length < n) { s = s + \" \"; } return s; }\nfunction render() { run_function(\"coffers_render\", [], \"coffers\"); }\n// Set the goal: earn ga from the current fortune. src is the package that\n// proposed it (\"\" when set by hand); replaced, the goal it replaces.\nfunction setGoal(ga, src, replaced) {\n  var gw = curWealth();\n  if (!gw) { say(\"no reading of your purse yet, so there is nothing to count from. Try again after the next prompt.\", \"orange\"); return false; }\n  CO.goal = ga;\n  CO.goalBase = gw[0] + gw[1];\n  CO.goalT = now;\n  CO.goalDone = false;\n  CO.goalSrc = src || \"\";\n  save(\"coffers_goal\", String(ga)); save(\"coffers_goal_base\", String(CO.goalBase)); save(\"coffers_goal_t\", String(now)); save(\"coffers_goal_done\", \"0\"); save(\"coffers_goal_src\", CO.goalSrc);\n  say(\"goal set: earn \" + F.n(ga) + \" gold, counting from your current \" + F.n(CO.goalBase) + (src ? \" (proposed by \" + src + \")\" : \"\") + (replaced ? \"; it replaces your goal of \" + F.n(replaced) : \"\") + \".\", \"lime\");\n  render();\n  return true;\n}\nfunction curWealth() {\n  var L = CO.live || {};\n  if (L.gold !== undefined && L.bank !== undefined) { return [L.gold, L.bank]; }\n  var m = CO.min;\n  if (m.length > 0) { return [m[m.length - 1][1], m[m.length - 1][2]]; }\n  return null;\n}\nfunction sessLine(o, open) {\n  var dur = Math.max(0, o.e - o.s);\n  var net = o.inn - o.out;\n  var ph = dur >= 600 ? F.s(Math.round(net / (dur / 3600))) : \"-\";\n  return rpad(F.date(o.s), 7) + rpad(F.hm(o.s), 6) + lpad(F.dur(dur), 8) + lpad(F.s(net), 11) + lpad(F.n(o.inn), 10) + lpad(F.n(o.out), 10) + lpad(ph, 10) + (open ? \"  (open)\" : \"\");\n}\nfunction csvTime(t) {\n  var d = new Date(t * 1000);\n  var mm = d.getMonth() + 1, dd = d.getDate(), hh = d.getHours(), mi = d.getMinutes();\n  return d.getFullYear() + \"-\" + (mm < 10 ? \"0\" : \"\") + mm + \"-\" + (dd < 10 ? \"0\" : \"\") + dd + \" \" + (hh < 10 ? \"0\" : \"\") + hh + \":\" + (mi < 10 ? \"0\" : \"\") + mi;\n}\n\nif (c === \"\" || c === \"status\") {\n  var cw = curWealth();\n  if (!cw) { say(\"no reading of your purse yet. COFFERS DEBUG shows what has arrived.\", \"orange\"); }\n  else {\n    var W = cw[0] + cw[1];\n    var T = CO.tiers;\n    var ti = F.tier(W);\n    say(\"fortune \" + F.n(W) + \" gold: \" + F.n(cw[0]) + \" in the purse, \" + F.n(cw[1]) + \" in the bank. Rank: \" + T[ti][1] + \".\");\n    if (ti < T.length - 1) { say(\"next rank, \" + T[ti + 1][1] + \", at \" + F.n(T[ti + 1][0]) + \": \" + F.n(T[ti + 1][0] - W) + \" to go.\"); }\n    if (CO.goal > 0 && CO.goalBase >= 0) {\n      var ge = W - CO.goalBase;\n      say(\"goal \" + F.s(CO.goal) + \" since \" + F.date(CO.goalT) + \": earned \" + F.s(ge) + (ge >= CO.goal ? \", reached!\" : \" (\" + Math.max(0, Math.floor(ge / CO.goal * 100)) + \"%), \" + F.n(CO.goal - ge) + \" to go.\"));\n    }\n    var S = CO.sess;\n    if (S) {\n      var sd = Math.max(0, S.last - S.s);\n      var sn = S.inn - S.out;\n      say(\"session since \" + F.hm(S.s) + \" (\" + F.dur(sd) + \"): net \" + F.s(sn) + \", in \" + F.n(S.inn) + \", out \" + F.n(S.out) + (sd >= 600 ? \", \" + F.s(Math.round(sn / (sd / 3600))) + \"/hr\" : \"\") + \".\");\n    }\n    var D = CO.days;\n    var td = (D.length > 0 && F.dayKey(D[D.length - 1][0]) === F.dayKey(now)) ? D[D.length - 1] : null;\n    if (td) { say(\"today: net \" + F.s((td[3] || 0) - (td[4] || 0)) + \", in \" + F.n(td[3] || 0) + \", out \" + F.n(td[4] || 0) + \".\"); }\n    var R = CO.rec;\n    var rl = [];\n    if (R.peak) { rl.push(\"peak \" + F.n(R.peak.w) + \" (\" + F.date(R.peak.t) + \")\"); }\n    if (R.bestDay) { rl.push(\"best day \" + F.s(R.bestDay.net) + \" (\" + F.date(R.bestDay.t) + \")\"); }\n    if (R.bestSess) { rl.push(\"best session \" + F.s(R.bestSess.net) + \" (\" + F.date(R.bestSess.s) + \", \" + F.dur(R.bestSess.dur) + \")\"); }\n    if (rl.length > 0) { say(\"records: \" + rl.join(\", \") + \".\"); }\n  }\n}\nelse if (c === \"sessions\") {\n  var ns = Math.max(1, Math.min(50, parseInt(p1, 10) || 10));\n  var list = CO.sessions.slice(-ns);\n  say(\"last \" + list.length + \" closed session(s)\" + (CO.sess ? \", plus the open one\" : \"\") + \":\");\n  plain(rpad(\"date\", 7) + rpad(\"start\", 6) + lpad(\"length\", 8) + lpad(\"net\", 11) + lpad(\"in\", 10) + lpad(\"out\", 10) + lpad(\"per hr\", 10));\n  for (var si = 0; si < list.length; si++) { plain(sessLine(list[si], false)); }\n  if (CO.sess) { var o = CO.sess; plain(sessLine({ s: o.s, e: o.last, inn: o.inn, out: o.out }, true)); }\n}\nelse if (c === \"days\") {\n  var nd = Math.max(1, Math.min(365, parseInt(p1, 10) || 14));\n  var dl = CO.days.slice(-nd);\n  say(\"last \" + dl.length + \" day(s), newest last:\");\n  plain(rpad(\"date\", 8) + lpad(\"net\", 11) + lpad(\"in\", 10) + lpad(\"out\", 10) + lpad(\"fortune\", 12));\n  for (var di = 0; di < dl.length; di++) {\n    var r = dl[di];\n    plain(rpad(F.date(r[0]), 8) + lpad(F.s((r[3] || 0) - (r[4] || 0)), 11) + lpad(F.n(r[3] || 0), 10) + lpad(F.n(r[4] || 0), 10) + lpad(F.n(r[1] + r[2]), 12));\n  }\n}\nelse if (c === \"new\") {\n  run_function(\"coffers_close\", [], \"coffers\");\n  CO.force = true;\n  say(\"session closed. The next prompt opens fresh books.\", \"lime\");\n  render();\n}\nelse if (c === \"goal\") {\n  if (p1 === \"\") { say(CO.goal > 0 ? \"goal is to earn \" + F.n(CO.goal) + \" gold, counted from \" + F.date(CO.goalT) + (CO.goalSrc ? \" (proposed by \" + CO.goalSrc + \")\" : \"\") + \". COFFERS GOAL OFF clears it.\" : \"no goal set. Usage: COFFERS GOAL 50000 (or 50k, 1.5m): an amount to earn from now.\"); }\n  else if (p1 === \"off\" || p1 === \"0\") { CO.goal = 0; CO.goalBase = -1; CO.goalSrc = \"\"; save(\"coffers_goal\", \"0\"); save(\"coffers_goal_base\", \"-1\"); save(\"coffers_goal_src\", \"\"); say(\"goal cleared.\", \"lime\"); render(); }\n  else {\n    var ga = amt(p1);\n    if (ga <= 0) { say(\"could not read '\" + p1 + \"' as an amount. Try 50000, 50k or 1.5m.\", \"orange\"); }\n    else { setGoal(ga, \"\"); }\n  }\n}\nelse if (c === \"proposed\" || c === \"proposals\") {\n  // Goals other packages proposed (#35), oldest first; the first is the one\n  // ACCEPT and DISMISS act on unless a number is given.\n  var PL = CO.proposals || [];\n  if (PL.length === 0) { say(\"no proposed goals.\"); }\n  for (var pi = 0; pi < PL.length; pi++) { say((pi + 1) + \". earn \" + F.n(PL[pi].amount) + \" gold\" + (PL[pi].why ? \" \\u2014 \" + PL[pi].why : \"\") + \" (from \" + PL[pi].src + \")\"); }\n  if (PL.length) { say(\"COFFERS ACCEPT [n] makes one your goal, COFFERS DISMISS [n] drops it.\"); }\n}\nelse if (c === \"accept\" || c === \"dismiss\") {\n  var PA = CO.proposals || [];\n  var pn = p1 === \"\" ? 1 : parseInt(p1, 10);\n  if (PA.length === 0) { say(\"no proposed goals.\", \"orange\"); }\n  else if (isNaN(pn) || pn < 1 || pn > PA.length) { say(\"no proposal \" + p1 + \". COFFERS PROPOSED lists them.\", \"orange\"); }\n  else {\n    var pp = PA[pn - 1];\n    if (c === \"accept\") {\n      var had = CO.goal > 0 ? CO.goal : 0;\n      if (setGoal(pp.amount, pp.src, had)) { PA.splice(pn - 1, 1); CO.saveProposals(); render(); }\n    } else {\n      PA.splice(pn - 1, 1);\n      // Stays away until its source withdraws it, i.e. its condition clears.\n      CO.dismissed[pp.src + \"|\" + pp.key] = true;\n      CO.saveProposals();\n      say(\"dismissed: earn \" + F.n(pp.amount) + \" gold (from \" + pp.src + \").\", \"lime\");\n      render();\n    }\n  }\n}\nelse if (c === \"graph\") {\n  var which = p1;\n  var mode = p2;\n  if (which === \"on\" || which === \"off\") { mode = which; which = \"\"; }\n  if (which === \"\" || which === \"session\") {\n    CO.graphSess = mode === \"on\" ? true : (mode === \"off\" ? false : !CO.graphSess);\n    save(\"coffers_graph_sess\", CO.graphSess ? \"1\" : \"0\");\n  }\n  if (which === \"\" || which === \"long\") {\n    CO.graphLong = mode === \"on\" ? true : (mode === \"off\" ? false : !CO.graphLong);\n    save(\"coffers_graph_long\", CO.graphLong ? \"1\" : \"0\");\n  }\n  say(\"session graph \" + (CO.graphSess ? \"shown\" : \"hidden\") + \", day-by-day graph \" + (CO.graphLong ? \"shown\" : \"hidden\") + \".\", \"lime\");\n  render();\n}\nelse if (c === \"size\") {\n  var sz = parseInt(p1, 10) || 0;\n  if (!sz) { say(\"graph height is \" + CO.chartH + \". Usage: COFFERS SIZE 40-400 (default 105).\"); }\n  else if (sz < 40 || sz > 400) { say(\"pick a height between 40 and 400.\", \"orange\"); }\n  else { CO.chartH = sz; save(\"coffers_graph_h\", String(sz)); say(\"graph height set to \" + sz + \".\", \"lime\"); render(); }\n}\nelse if (c === \"span\") {\n  var sv = parseInt(p2, 10) || 0;\n  if (p1 !== \"session\" && p1 !== \"long\") { say(\"windows: session \" + CO.mins + \" min, long \" + CO.daySpan + \" days. Usage: COFFERS SPAN SESSION 15-720 | COFFERS SPAN LONG 7-365.\"); }\n  else if (p1 === \"session\" && (sv < 15 || sv > 720)) { say(\"session window must be 15-720 minutes.\", \"orange\"); }\n  else if (p1 === \"long\" && (sv < 7 || sv > 365)) { say(\"long window must be 7-365 days.\", \"orange\"); }\n  else {\n    if (p1 === \"session\") { CO.mins = sv; save(\"coffers_span_mins\", String(sv)); }\n    else { CO.daySpan = sv; save(\"coffers_span_days\", String(sv)); }\n    say(p1 + \" window set to \" + sv + (p1 === \"session\" ? \" minutes.\" : \" days.\") + \" Older points drop off at the next prompt.\", \"lime\");\n    render();\n  }\n}\nelse if (c === \"gap\") {\n  var gv = parseInt(p1, 10) || 0;\n  if (!gv) { say(\"a session closes after \" + CO.gap + \" minutes without a prompt. Usage: COFFERS GAP 5-240.\"); }\n  else if (gv < 5 || gv > 240) { say(\"gap must be 5-240 minutes.\", \"orange\"); }\n  else { CO.gap = gv; save(\"coffers_gap\", String(gv)); say(\"sessions now close after \" + gv + \" silent minutes.\", \"lime\"); }\n}\nelse if (c === \"bigcoin\") {\n  var bv = p1 === \"off\" ? 0 : amt(p1);\n  if (p1 === \"\") { say(CO.big > 0 ? \"single changes of \" + F.n(CO.big) + \"+ gold are announced. COFFERS BIGCOIN OFF silences them.\" : \"big-coin announcements are off. Usage: COFFERS BIGCOIN 1000 (or 1k).\"); }\n  else if (bv < 0) { say(\"could not read '\" + p1 + \"' as an amount.\", \"orange\"); }\n  else { CO.big = bv; save(\"coffers_bigcoin\", String(bv)); say(bv > 0 ? \"announcing single changes of \" + F.n(bv) + \"+ gold.\" : \"big-coin announcements off.\", \"lime\"); }\n}\nelse if (c === \"csv\") {\n  var cw2 = p1 || \"days\";\n  if (cw2 === \"session\") {\n    plain(\"datetime,unix,gold,bank,wealth\");\n    for (var ci = 0; ci < CO.min.length; ci++) { var mp = CO.min[ci]; plain(csvTime(mp[0]) + \",\" + mp[0] + \",\" + mp[1] + \",\" + mp[2] + \",\" + (mp[1] + mp[2])); }\n  } else if (cw2 === \"sessions\") {\n    plain(\"start,end,seconds,wealth_start,wealth_end,in,out,net,biggest_gain\");\n    for (var cj = 0; cj < CO.sessions.length; cj++) { var so = CO.sessions[cj]; plain(csvTime(so.s) + \",\" + csvTime(so.e) + \",\" + (so.e - so.s) + \",\" + so.w0 + \",\" + so.w1 + \",\" + so.inn + \",\" + so.out + \",\" + (so.inn - so.out) + \",\" + (so.big || 0)); }\n  } else {\n    plain(\"date,unix,gold,bank,wealth,in,out,net\");\n    for (var ck = 0; ck < CO.days.length; ck++) { var dp = CO.days[ck]; plain(csvTime(dp[0]).slice(0, 10) + \",\" + dp[0] + \",\" + dp[1] + \",\" + dp[2] + \",\" + (dp[1] + dp[2]) + \",\" + (dp[3] || 0) + \",\" + (dp[4] || 0) + \",\" + ((dp[3] || 0) - (dp[4] || 0))); }\n  }\n}\nelse if (c === \"wipe\") {\n  if (p1 !== \"confirm\") { say(\"this burns the whole ledger: buffers, sessions, records, the goal and every proposal. Type COFFERS WIPE CONFIRM to proceed.\", \"orange\"); }\n  else {\n    CO.min = []; CO.days = []; CO.sessions = []; CO.rec = {}; CO.sess = null;\n    save(\"coffers_min\", \"[]\"); save(\"coffers_days\", \"[]\"); save(\"coffers_sessions\", \"[]\"); save(\"coffers_rec\", \"{}\"); save(\"coffers_sess\", \"\");\n    // Everything goes: the goal, pending proposals and dismissals. A source\n    // whose reason still holds may propose again later.\n    CO.goal = 0; CO.goalBase = -1; CO.goalT = 0; CO.goalDone = false; CO.goalSrc = \"\";\n    save(\"coffers_goal\", \"0\"); save(\"coffers_goal_base\", \"-1\"); save(\"coffers_goal_t\", \"0\"); save(\"coffers_goal_done\", \"0\"); save(\"coffers_goal_src\", \"\");\n    CO.proposals = []; CO.dismissed = {}; CO.saveProposals();\n    CO.force = true;\n    say(\"ledger burned. Fresh books open at the next prompt.\", \"orange\");\n    render();\n  }\n}\nelse if (c === \"rebuild\") {\n  CO.f = undefined;\n  CO.tiers = undefined;\n  if (!client.loom || !client.loom.coffers || !client.loom.coffers.f) run_function(\"coffers_setup\", [], \"coffers\");\nvar CO = client.loom.coffers;\n  say(\"helpers and rank table rebuilt.\", \"lime\");\n  render();\n}\nelse if (c === \"debug\") {\n  say(\"live: \" + JSON.stringify(CO.live));\n  say(\"open session: \" + JSON.stringify(CO.sess));\n  say(\"buffers: \" + CO.min.length + \" minute point(s), \" + CO.days.length + \" day(s), \" + CO.sessions.length + \" closed session(s).\");\n  say(\"settings: span \" + CO.mins + \"m/\" + CO.daySpan + \"d, gap \" + CO.gap + \"m, bigcoin \" + CO.big + \", goal \" + CO.goal + \" from \" + CO.goalBase + \", height \" + CO.chartH + \".\");\n}\nelse if (c === \"help\") { run_function(\"coffers_help\", [], \"coffers\"); }\nelse { say(\"unknown subcommand '\" + c + \"'. COFFERS HELP lists them.\", \"orange\"); }"
  },
  {
   "type": "function",
   "name": "coffers_help",
   "enabled": true,
   "code": "// coffers_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[coffers] gold tracker: purse and bank, income and spending. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"COFFERS\", \"fortune, rank, goal, session, today and records\"],\n  [\"COFFERS SESSIONS [n] / DAYS [n]\", \"the books, as tables\"],\n  [\"COFFERS NEW\", \"close this session now\"],\n  [\"COFFERS GAP <5-240>\", \"minutes without a prompt that close a session\"],\n  [\"COFFERS GOAL <amount|OFF>\", \"earn this much from now (50000, 50k, 1.5m)\"],\n  [\"COFFERS PROPOSED\", \"goals other packages proposed, numbered\"],\n  [\"COFFERS ACCEPT [n]\", \"make a proposed goal yours (the first by default)\"],\n  [\"COFFERS DISMISS [n]\", \"drop it; it stays away until its reason clears\"],\n  [\"COFFERS BIGCOIN <amount|OFF>\", \"announce single gains or losses this large\"],\n  [\"COFFERS GRAPH [SESSION|LONG] [ON|OFF]\", \"show or hide the graphs\"],\n  [\"COFFERS SIZE <40-400>\", \"graph height (default 105)\"],\n  [\"COFFERS SPAN SESSION <15-720>\", \"minutes the session graph covers\"],\n  [\"COFFERS SPAN LONG <7-365>\", \"days the day-by-day graph covers\"],\n  [\"COFFERS CSV [DAYS|SESSION|SESSIONS]\", \"the books as CSV lines\"],\n  [\"COFFERS WIPE CONFIRM\", \"burn the whole ledger, goal and proposals too\"],\n  [\"COFFERS REBUILD / DEBUG\", \"rebuild helpers and rank table / internal state\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "trigger",
   "name": "coffers gift",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"Grulk gives 5,000 gold sovereigns to you.\" -- gold given to you (#53),\n// for loom's link coffers-standings. The balance itself comes from GMCP as\n// before; this only notes who gave and how much.\nif (!client.loom || !client.loom.coffers || !client.loom.coffers.gifts) run_function(\"coffers_setup\", [], \"coffers\");\nvar CO = client.loom.coffers;\nvar cgAmt = parseInt(String(args[2]).replace(/,/g, \"\"), 10);\nif (!isNaN(cgAmt) && cgAmt > 0) {\n  CO.gifts.push({ who: String(args[1]), amount: cgAmt, t: Date.now() });\n  if (CO.gifts.length > 30) CO.gifts.splice(0, CO.gifts.length - 30);\n  if (client.loom.notify) client.loom.notify(\"coffers\");\n}\n"
    }
   ],
   "text": "^([A-Z][a-z]+) gives ([\\d,]+) gold sovereigns? to you\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// COFFERS [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.coffers || !client.loom.coffers.f) run_function(\"coffers_setup\", [], \"coffers\");\nvar CO = client.loom.coffers;\nvar coW = String(args[1] || \"\").trim().toLowerCase().split(/\\s+/);\nCO.args = [coW[0] || \"\", coW[1] || \"\", coW[2] || \"\"];\nrun_function(\"coffers_cmd\", [], \"coffers\");\n"
    }
   ],
   "text": "^coffers(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  }
 ]
}