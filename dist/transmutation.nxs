{
 "type": "group",
 "name": "transmutation",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"transmutation_setup\", [], \"transmutation\");\ndisplay_notice(\"[transmutation] installed. TRANSMUTATION ON to start, TRANSMUTATION HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// The transmutation_* variables are left intact.\n// Leave LOOM and the integrations at once, not at the next load (#137).\nif (client.loom && client.loom.transmutation) { client.loom.transmutation.on = false; client.loom.transmutation.want = null; client.loom.transmutation.current = null; client.loom.transmutation.probing = null; }\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"transmutation\");\n  else delete client.loom.registry.transmutation;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"transmutation_setup\", [], \"transmutation\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Transmutation follows the room and the prompt itself.\nif (!client.loom || !client.loom.transmutation || !client.loom.transmutation.envs) run_function(\"transmutation_setup\", [], \"transmutation\");\nvar TR = client.loom.transmutation;\nvar trG = (args.gmcp_args && typeof args.gmcp_args == \"object\") ? args.gmcp_args : {};\nif (args.gmcp_method == \"Room.Info\") TR.enter(trG);\nelse if (args.gmcp_method == \"Char.Vitals\") {\n  TR.bal = trG.bal != \"0\";\n  TR.eq = trG.eq != \"0\";\n  // After the packet's own lines, so MINERALS and \"You store\" are seen first.\n  setTimeout(TR.prompt, 0);\n}\n"
  },
  {
   "type": "function",
   "name": "transmutation_setup",
   "enabled": true,
   "code": "// transmutation_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, saved state, helpers.\n// Transmutation is the Transmutation trade skill's package (#373). For now it\n// does extraction only: on entering a mountain or natural underground room it\n// extracts the area's mineral when your rift is short of it, and stores it.\n// Every area gives one mineral and it never changes (Ricardo), so the package\n// keeps a map of area -> mineral, learnt from MINERALS: it sends MINERALS\n// itself once in an area it doesn't know yet, and learns from yours too.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.transmutation) client.loom.transmutation = {};\nvar TR = client.loom.transmutation;\n// busy (#318): true only while something it sent is out (an EXTRACT with\n// its INR, a MINERALS, the rift reading), so Here's probe, harvesting and\n// gathering wait for it, and it for them, without both waiting on each other.\nclient.loom.registry.transmutation = { version: \"0.1.0\", keyword: \"TRANSMUTATION\", desc: \"Extracts the minerals your rift is short of as you walk the mountains\", busy: function () {\n  var t = client.loom.transmutation;\n  return !!(t && t.on && (t.current || t.probing || t.reading) && Date.now() - (t.sentAt || 0) < 15000);\n} };\n\n// Environments (GMCP Room.Info environment, lower case) minerals can be\n// extracted in.\nTR.envs = { mountain: true, mountains: true, \"natural underground\": true };\n// Every mineral (HELP MINERALS): what MIN accepts.\nTR.minerals = [\"antimony\", \"argentum\", \"arsenic\", \"aurum\", \"azurite\", \"bisemutum\", \"calamine\", \"calcite\", \"cinnabar\", \"cuprum\",\n  \"dolomite\", \"ferrum\", \"gypsum\", \"magnesium\", \"malachite\", \"plumbum\", \"potash\", \"quartz\", \"quicksilver\", \"realgar\", \"stannum\"];\nTR.known = function (m) { return TR.minerals.indexOf(String(m || \"\").toLowerCase()) >= 0; };\n// A room can't be extracted from again for a while (the game says \"that\n// day\"): rooms extracted this session are skipped for an hour.\nTR.againMs = 3600000;\n// An area is only taken to have no minerals after this many of its rooms\n// (mountain or underground) showed none.\nTR.noneAfter = 3;\n\n// Saved state. A variable that isn't a readable table starts afresh (#135).\nTR.readTable = function (name, dflt) {\n  var v = get_variable(name);\n  if (typeof v == \"string\") { try { v = JSON.parse(v); } catch (e) { v = null; } }\n  return (v && typeof v == \"object\" && !Array.isArray(v)) ? v : dflt;\n};\nTR.min = TR.readTable(\"transmutation_min\", {});\nTR.stock = TR.readTable(\"transmutation_stock\", {});\n// Area (GMCP Room.Info area) -> its mineral, \"\" for an area with none.\nTR.areas = TR.readTable(\"transmutation_areas\", {});\nif (!to_number(get_variable(\"transmutation_default_min\"))) set_variable(\"transmutation_default_min\", 500);\nTR.defMin = to_number(get_variable(\"transmutation_default_min\"));\n\n// Runtime state. The switch is never remembered: transmutation loads off.\nif (TR.on === undefined) TR.on = false;\nif (TR.here === undefined) TR.here = \"\";\nif (TR.area === undefined) TR.area = \"\";\nif (TR.room === undefined) TR.room = \"\";\nif (!TR.done) TR.done = {};\nif (!TR.noneSeen) TR.noneSeen = {};\nif (!TR.asked) TR.asked = {};\nif (TR.want === undefined) TR.want = null;\nif (TR.current === undefined) TR.current = null;\nif (TR.probing === undefined) TR.probing = null;\nif (TR.reading === undefined) TR.reading = false;\nif (TR.wantRead === undefined) TR.wantRead = false;\nTR.inRift = false;\nTR.ownRift = false;\nTR.dashes = 0;\nTR.spot = null;\nTR.bal = true;\nTR.eq = true;\nTR.timeoutMs = 15000;\n\nTR.minOf = function (m) { return TR.min[m] != null ? TR.min[m] : TR.defMin; };\nTR.have = function (m) { var s = TR.stock[m]; return (s === undefined || s === null) ? null : s; };\nTR.paused = function () { return get_variable(\"pauseTriggers\") == \"on\"; };\nTR.say = function (text, colour) { display_notice(\"[transmutation] \" + text, colour || \"cyan\"); };\nTR.save = function () {\n  set_variable(\"transmutation_min\", TR.min);\n  set_variable(\"transmutation_stock\", TR.stock);\n  set_variable(\"transmutation_areas\", TR.areas);\n  if (client.loom.notify) client.loom.notify(\"transmutation\");\n};\n// Is any other package waiting for an answer to something it sent (#318)?\nTR.othersBusy = function () {\n  var r = client.loom.registry || {};\n  for (var k in r) {\n    if (!r.hasOwnProperty(k) || k == \"transmutation\" || !r[k] || typeof r[k].busy != \"function\") continue;\n    try { if (r[k].busy()) return k; } catch (e) {}\n  }\n  return \"\";\n};\n\n// What this room wants: a MINERALS for an area not known yet, an EXTRACT\n// when the area's mineral is short and this room hasn't been extracted\n// lately, or nothing.\nTR.decide = function () {\n  TR.want = null;\n  if (!TR.on || TR.paused() || !TR.envs[TR.here] || !TR.area) return;\n  var m = TR.areas[TR.area];\n  // One MINERALS per room: an answer that never came isn't asked again.\n  if (m === undefined) { if (!TR.asked[TR.room || TR.area]) TR.want = { probe: true }; return; }\n  if (!m) return;\n  if ((TR.have(m) || 0) >= TR.minOf(m)) return;\n  if (TR.room && TR.done[TR.room] && Date.now() - TR.done[TR.room] < TR.againMs) return;\n  TR.want = { m: m };\n};\n// A new room (Room.Info).\nTR.enter = function (g) {\n  TR.here = String(g.environment || \"\").toLowerCase();\n  TR.area = String(g.area || \"\");\n  TR.room = (g.num === undefined || g.num === null) ? \"\" : String(g.num);\n  TR.probing = null;\n  TR.spot = null;\n  if (TR.on && !TR.started) { TR.started = true; TR.wantRead = true; }\n  TR.decide();\n};\n\n// At each prompt (after its packet's lines): settle what's out, then send the\n// next thing when balance, equilibrium and every other package allow it.\nTR.prompt = function () {\n  var now = Date.now();\n  // A MINERALS you typed ends with its packet.\n  if (!TR.probing) TR.spot = null;\n  if (!TR.on) return;\n  // A rift reading whose listing never came stops waiting.\n  if (TR.reading && now - TR.sentAt > TR.timeoutMs) { TR.reading = false; TR.ownRift = false; }\n  if (TR.probing) {\n    TR.probing.prompts++;\n    // The MINERALS header came with this packet (or never will).\n    if (TR.probing.answered || TR.probing.prompts >= 3 || now - TR.probing.at > TR.timeoutMs) TR.probed();\n    else return;\n  }\n  if (TR.current) {\n    var c = TR.current;\n    c.prompts++;\n    if (!TR.bal || !TR.eq) c.lost = true;\n    else if (c.lost) c.back++;\n    // Stored: the \"You store\" line cleared it. Otherwise: balance came back\n    // and the queued INR had two prompts to answer; or it never went (an\n    // extract that failed without balance, INR answered at once); or too long.\n    if (c.back >= 2 || (!c.lost && c.prompts >= 3) || now - c.at > TR.timeoutMs) TR.current = null;\n    else return;\n  }\n  TR.pump();\n};\nTR.pump = function () {\n  if (!TR.on || TR.paused() || TR.current || TR.probing || TR.reading) return;\n  if (!TR.wantRead && !TR.want) return;\n  if (!TR.bal || !TR.eq || TR.othersBusy()) return;\n  TR.sentAt = Date.now();\n  if (TR.wantRead) {\n    TR.wantRead = false;\n    TR.reading = true;\n    send_command(\"ir minerals\");\n    return;\n  }\n  var w = TR.want;\n  TR.want = null;\n  if (w.probe) {\n    TR.probing = { area: TR.area, room: TR.room, at: TR.sentAt, prompts: 0, answered: false };\n    TR.asked[TR.room || TR.area] = true;\n    TR.spot = null;\n    send_command(\"minerals\");\n    return;\n  }\n  // The INR waits in the game's queue for the balance EXTRACT takes. No\n  // success line is needed: what's stored shows in \"You store …\".\n  TR.current = { m: w.m, at: TR.sentAt, prompts: 0, lost: false, back: 0 };\n  if (TR.room) TR.done[TR.room] = TR.sentAt;\n  send_command(\"extract \" + w.m);\n  send_command(\"queue add be inr \" + w.m);\n};\n\n// MINERALS output: \"You spot the following minerals here:\", then one row per\n// mineral (\"Calamine Abundant\"), or nothing when there are none. Ours or one\n// you typed: either way what's seen is the area's mineral.\nTR.spotStart = function () {\n  TR.spot = [];\n  if (TR.probing) TR.probing.answered = true;\n};\nTR.spotRow = function (name, amount) {\n  if (!TR.spot) return false;\n  var m = String(name || \"\").toLowerCase();\n  if (!TR.known(m)) return false;\n  TR.spot.push({ m: m, amount: String(amount || \"\").trim().toLowerCase() });\n  if (!TR.probing && TR.area) TR.learn(TR.area, m);\n  return true;\n};\n// Our MINERALS has been answered (or given up on): learn the area, or count\n// a room without minerals.\nTR.probed = function () {\n  var p = TR.probing;\n  TR.probing = null;\n  if (!p) return;\n  if (TR.spot && TR.spot.length) {\n    TR.learn(p.area, TR.spot[0].m);\n  } else if (p.answered) {\n    TR.noneSeen[p.area] = (TR.noneSeen[p.area] || 0) + 1;\n    if (TR.noneSeen[p.area] >= TR.noneAfter) {\n      TR.areas[p.area] = \"\";\n      TR.save();\n      TR.say(p.area + \": no minerals in \" + TR.noneAfter + \" rooms, so none to extract there (TRANSMUTATION FORGET HERE to look again).\");\n    }\n  }\n  TR.spot = null;\n  // Still in the room probed: extract now if short.\n  if (TR.area == p.area && TR.room == p.room) TR.decide();\n};\nTR.learn = function (area, m) {\n  if (TR.areas[area] === m) return;\n  var was = TR.areas[area];\n  TR.areas[area] = m;\n  delete TR.noneSeen[area];\n  TR.save();\n  TR.say(area + \" gives \" + m + (was ? \" (was \" + was + \")\" : \"\") + \".\", \"lime\");\n};\n\n// \"You store N malachite, bringing the total in the rift to M.\" (and remove)\nTR.stored = function (name, total, storing) {\n  var m = String(name || \"\").toLowerCase();\n  if (!TR.known(m)) return;\n  TR.stock[m] = total;\n  if (storing && TR.current && TR.current.m == m) TR.current = null;\n  TR.save();\n};\n\n// The read-only look other packages see through loom (#159), the same shape\n// as harvesting's and gathering's: look.plant(name) -> { stock, min, tracked },\n// look.levels() -> [{ plant, rift, stock, min }] for minerals seen in the rift,\n// and look.areas() -> { area: mineral } (\"\" for none).\nTR.look = {\n  plant: function (name) {\n    var m = String(name || \"\").trim().toLowerCase();\n    return { stock: TR.have(m), min: TR.minOf(m), tracked: TR.known(m) };\n  },\n  levels: function () {\n    var out = [];\n    for (var i = 0; i < TR.minerals.length; i++) {\n      var h = TR.have(TR.minerals[i]);\n      if (h !== null) out.push({ plant: TR.minerals[i], rift: TR.minerals[i], stock: h, min: TR.minOf(TR.minerals[i]) });\n    }\n    return out;\n  },\n  areas: function () {\n    var out = {};\n    for (var a in TR.areas) if (TR.areas.hasOwnProperty(a)) out[a] = TR.areas[a];\n    return out;\n  }\n};\nif (client.loom.notify) client.loom.notify(\"transmutation\");\n"
  },
  {
   "type": "function",
   "name": "transmutation_status",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.transmutation || !client.loom.transmutation.envs) run_function(\"transmutation_setup\", [], \"transmutation\");\nvar TR = client.loom.transmutation;\nvar trHere = TR.areas[TR.area];\nvar trWhere = !TR.area ? \"?\" : TR.area + (trHere === undefined ? \" (mineral not known yet)\" : trHere ? \" (\" + trHere + \")\" : \" (no minerals)\");\nTR.say((TR.on ? \"ON\" : \"OFF\") + \", default minimum \" + TR.defMin + \", area here: \" + trWhere + (TR.envs[TR.here] ? \"\" : \", not a place to extract\") + \". TRANSMUTATION HELP for commands.\");\n// Short: the minerals of areas you know, and any with a minimum of its own.\nvar trOut = [], trSeen = {};\nfor (var trA in TR.areas) { if (TR.areas.hasOwnProperty(trA) && TR.areas[trA]) trSeen[TR.areas[trA]] = true; }\nfor (var trK in TR.min) { if (TR.min.hasOwnProperty(trK)) trSeen[trK] = true; }\nfor (var trI = 0; trI < TR.minerals.length; trI++) {\n  var trM = TR.minerals[trI];\n  if (!trSeen[trM]) continue;\n  var trH = TR.have(trM);\n  if (trH == null || trH < TR.minOf(trM)) trOut.push(trM + \" \" + (trH == null ? \"?\" : trH) + \"/\" + TR.minOf(trM));\n}\nTR.say(trOut.length ? \"below minimum: \" + trOut.join(\", \") : \"every mineral of the areas you know is at or above its minimum.\");\n"
  },
  {
   "type": "function",
   "name": "transmutation_areas",
   "enabled": true,
   "code": "// TRANSMUTATION AREAS [mineral]: the areas known, by mineral.\nif (!client.loom || !client.loom.transmutation || !client.loom.transmutation.envs) run_function(\"transmutation_setup\", [], \"transmutation\");\nvar TR = client.loom.transmutation;\nvar trWant = String(get_variable(\"transmutation_arg\") || \"\").toLowerCase();\nvar trBy = {}, trNone = [], trN = 0;\nfor (var trA in TR.areas) {\n  if (!TR.areas.hasOwnProperty(trA)) continue;\n  var trM = TR.areas[trA];\n  if (!trM) { trNone.push(trA); continue; }\n  if (trWant && trM != trWant) continue;\n  if (!trBy[trM]) trBy[trM] = [];\n  trBy[trM].push(trA);\n  trN++;\n}\nif (!trN && !(trNone.length && !trWant)) {\n  TR.say(trWant ? \"no area known for \" + trWant + \" yet.\" : \"no areas known yet: walk a mountain or underground room with TRANSMUTATION ON, or type MINERALS.\");\n} else {\n  for (var trI = 0; trI < TR.minerals.length; trI++) {\n    var trK = TR.minerals[trI];\n    if (trBy[trK]) TR.say(trK + \" (\" + (TR.have(trK) == null ? \"?\" : TR.have(trK)) + \"/\" + TR.minOf(trK) + \"): \" + trBy[trK].sort().join(\", \"));\n  }\n  if (trNone.length && !trWant) TR.say(\"no minerals: \" + trNone.sort().join(\", \"));\n}\n"
  },
  {
   "type": "function",
   "name": "transmutation_help",
   "enabled": true,
   "code": "// transmutation_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[transmutation] extracts the minerals your rift is short of as you walk. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"TRANSMUTATION\", \"status: the area here and what is below its minimum\"],\n  [\"TRANSMUTATION ON|OFF\", \"ON also reads your rift (IR MINERALS); loads OFF\"],\n  [\"TRANSMUTATION MIN <n>\", \"default minimum for every mineral (default 500)\"],\n  [\"TRANSMUTATION MIN <mineral> <n>\", \"minimum for one mineral (DEFAULT to go back to the default)\"],\n  [\"TRANSMUTATION AREAS [mineral]\", \"the areas known, by mineral (or where to find one)\"],\n  [\"TRANSMUTATION FORGET HERE|<area>\", \"look the area's mineral up again (CONFIRM)\"],\n  [\"TRANSMUTATION STOCK\", \"re-read your rift now\"],\n  [\"TRANSMUTATION RESET\", \"clear what's out and the rooms extracted this session, reload saved state\"],\n  [\"TRANSMUTATION DEBUG\", \"internal state\"],\n  [\"Extracts in mountain and natural underground rooms. Each area gives one mineral: it sends MINERALS once in an area it doesn't know (yours count too) and remembers it.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "Transmutation control",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// TRANSMUTATION [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.transmutation || !client.loom.transmutation.envs) run_function(\"transmutation_setup\", [], \"transmutation\");\nvar TR = client.loom.transmutation;\nvar trRaw = String(args[1] || \"\").trim();\nvar trA = trRaw.toLowerCase().split(/\\s+/);\nif (trA[0] === \"\" || trA[0] === \"status\") {\n  run_function(\"transmutation_status\", [], \"transmutation\");\n} else if (trA[0] === \"help\") {\n  run_function(\"transmutation_help\", [], \"transmutation\");\n} else if (trA[0] === \"on\") {\n  TR.on = true;\n  TR.started = true;\n  TR.wantRead = true;\n  TR.decide();\n  TR.say(\"ON: reading your rift (IR MINERALS), then extracting what's short in each mountain or underground room you enter.\", \"lime\");\n} else if (trA[0] === \"off\") {\n  TR.on = false;\n  TR.want = null;\n  TR.current = null;\n  TR.probing = null;\n  TR.reading = false;\n  TR.wantRead = false;\n  TR.say(\"OFF.\", \"lime\");\n} else if (trA[0] === \"stock\") {\n  TR.reading = true;\n  TR.sentAt = Date.now();\n  send_command(\"ir minerals\");\n} else if (trA[0] === \"min\" && trA.length == 2 && /^\\d+$/.test(trA[1])) {\n  TR.defMin = parseInt(trA[1], 10);\n  set_variable(\"transmutation_default_min\", TR.defMin);\n  if (client.loom.notify) client.loom.notify(\"transmutation\");\n  TR.say(\"default minimum: \" + TR.defMin + \".\", \"lime\");\n} else if (trA[0] === \"min\" && trA.length == 3 && (trA[2] === \"default\" || /^\\d+$/.test(trA[2])) && TR.known(trA[1])) {\n  if (trA[2] === \"default\") delete TR.min[trA[1]];\n  else TR.min[trA[1]] = parseInt(trA[2], 10);\n  TR.save();\n  TR.decide();\n  TR.say(\"minimum for \" + trA[1] + \": \" + (TR.min[trA[1]] != null ? TR.min[trA[1]] : TR.defMin + \" (default)\") + \".\", \"lime\");\n} else if (trA[0] === \"min\" && trA.length == 3) {\n  TR.say(\"'\" + trA[1] + \"' isn't a mineral (HELP MINERALS lists them).\", \"orange\");\n} else if (trA[0] === \"min\") {\n  TR.say(\"TRANSMUTATION MIN <n>, or TRANSMUTATION MIN <mineral> <n|DEFAULT>.\", \"orange\");\n} else if (trA[0] === \"areas\") {\n  set_variable(\"transmutation_arg\", trA[1] || \"\");\n  run_function(\"transmutation_areas\", [], \"transmutation\");\n  delete_variable(\"transmutation_arg\");\n} else if (trA[0] === \"forget\") {\n  // FORGET HERE | <area> [CONFIRM]: the area's mineral is looked up again.\n  var trConfirm = trA[trA.length - 1] === \"confirm\";\n  var trName = trRaw.replace(/^\\S+\\s*/, \"\").replace(/\\s*confirm$/i, \"\").trim();\n  var trArea = \"\";\n  if (trName.toLowerCase() === \"here\") trArea = TR.area;\n  else for (var trK in TR.areas) { if (TR.areas.hasOwnProperty(trK) && trK.toLowerCase() === trName.toLowerCase()) trArea = trK; }\n  if (!trName) {\n    TR.say(\"TRANSMUTATION FORGET HERE, or FORGET <area>, then CONFIRM.\", \"orange\");\n  } else if (!trArea || TR.areas[trArea] === undefined) {\n    TR.say(\"no mineral known for '\" + (trArea || trName) + \"'. TRANSMUTATION AREAS lists the areas known.\", \"orange\");\n  } else if (!trConfirm) {\n    TR.say(\"this forgets that \" + trArea + \" gives \" + (TR.areas[trArea] || \"no minerals\") + \"; it is looked up again with MINERALS. TRANSMUTATION FORGET \" + trName.toUpperCase() + \" CONFIRM to do it.\", \"orange\");\n  } else {\n    delete TR.areas[trArea];\n    delete TR.noneSeen[trArea];\n    for (var trR in TR.asked) { if (TR.asked.hasOwnProperty(trR)) delete TR.asked[trR]; }\n    TR.save();\n    if (trArea == TR.area) TR.decide();\n    TR.say(\"forgot \" + trArea + \".\", \"lime\");\n  }\n} else if (trA[0] === \"reset\") {\n  TR.want = null;\n  TR.current = null;\n  TR.probing = null;\n  TR.reading = false;\n  TR.wantRead = false;\n  TR.done = {};\n  TR.asked = {};\n  TR.noneSeen = {};\n  run_function(\"transmutation_setup\", [], \"transmutation\");\n  TR.decide();\n  TR.say(\"reset: what's out cleared, rooms extracted this session forgotten, state reloaded from saved variables.\", \"lime\");\n} else if (trA[0] === \"debug\") {\n  TR.say(\"on=\" + TR.on + \" here=\" + TR.here + \" area=\" + TR.area + \" room=\" + TR.room + \" want=\" + JSON.stringify(TR.want) + \" current=\" + JSON.stringify(TR.current) + \" probing=\" + JSON.stringify(TR.probing) + \" reading=\" + TR.reading + \" wantRead=\" + TR.wantRead + \" bal=\" + TR.bal + \" eq=\" + TR.eq + \" waitingOn=\" + (TR.othersBusy() || \"-\") + \" noneSeen=\" + JSON.stringify(TR.noneSeen) + \" done=\" + Object.keys(TR.done).length + \" rooms\");\n} else {\n  TR.say(\"unknown command '\" + trA[0] + \"'. TRANSMUTATION HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^transmutation(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "Minerals spotted",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"You spot the following minerals here:\" (MINERALS): the rows follow.\nif (client.loom && client.loom.transmutation && client.loom.transmutation.spotStart) client.loom.transmutation.spotStart();\n"
    }
   ],
   "text": "^You spot the following minerals here:$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Minerals row",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// A row of MINERALS: \"Malachite      Abundant\". Only after the header.\nif (client.loom && client.loom.transmutation && client.loom.transmutation.spotRow) client.loom.transmutation.spotRow(args[1], args[2]);\n"
    }
   ],
   "text": "^([A-Z][a-z]+)\\s+([A-Z][a-z]+(?: [a-z]+)*)\\s*$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Rift store",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (client.loom && client.loom.transmutation && client.loom.transmutation.stored) client.loom.transmutation.stored(args[2], parseInt(args[3].replace(/,/g, \"\"), 10), true);\n"
    }
   ],
   "text": "^You store ([\\d,]+) (.+), bringing the total in the rift to ([\\d,]+)\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Rift remove",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (client.loom && client.loom.transmutation && client.loom.transmutation.stored) client.loom.transmutation.stored(args[2], parseInt(args[3].replace(/,/g, \"\"), 10), false);\n"
    }
   ],
   "text": "^You remove ([\\d,]+) (.+), bringing the total in the rift to ([\\d,]+)\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Rift header",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (client.loom && client.loom.transmutation && client.loom.transmutation.envs) {\n  var TR = client.loom.transmutation;\n  TR.inRift = true;\n  TR.ownRift = TR.reading;\n  TR.dashes = 0;\n  if (TR.ownRift) gag_current_line();\n}\n"
    }
   ],
   "text": "^Glancing into your rift, you see:$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Rift title",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// The category line of our own IR MINERALS.\nif (client.loom && client.loom.transmutation && client.loom.transmutation.ownRift && client.loom.transmutation.inRift) gag_current_line();\n"
    }
   ],
   "text": "^Minerals$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Rift rule",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (client.loom && client.loom.transmutation && client.loom.transmutation.inRift) {\n  var TR = client.loom.transmutation;\n  if (TR.ownRift) gag_current_line();\n  TR.dashes++;\n  if (TR.dashes >= 2) {\n    TR.inRift = false;\n    if (TR.ownRift) { TR.ownRift = false; TR.reading = false; TR.decide(); }\n  }\n}\n"
    }
   ],
   "text": "^-{20,}$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Rift rows",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Rift rows: minerals only, from our own reading or one you typed.\nif (client.loom && client.loom.transmutation && client.loom.transmutation.inRift) {\n  var TR = client.loom.transmutation;\n  if (TR.ownRift) gag_current_line();\n  var trRe = /\\[\\s*([\\d,]+)\\]\\s+(.+?)(?=\\s+\\[|\\s*$)/g, trM, trAny = false;\n  while ((trM = trRe.exec(args[0])) !== null) {\n    if (TR.known(trM[2])) { TR.stock[trM[2].toLowerCase()] = parseInt(trM[1].replace(/,/g, \"\"), 10); trAny = true; }\n  }\n  if (trAny) TR.save();\n}\n"
    }
   ],
   "text": "^\\s*\\[\\s*[\\d,]+\\]\\s.*$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  }
 ],
 "description": "Extracts the minerals your rift is short of as you walk the mountains"
}