{
 "type": "group",
 "name": "comms",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"comms_setup\", [], \"comms\");\nrun_function(\"comms_render\", [], \"comms\");\ndisplay_notice(\"[comms] installed. Create a custom tab named Comms; channel lines fill it as they come. COMMS HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; comms_name, comms_cap, comms_muted and comms_saved are left intact.\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon (Comms, #157): a speech bubble: pure CSS keyed on the tab button's title, so Nexus's\n// own redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"Comms\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 17 17\"><path d=\"M3 2.5h11a1.5 1.5 0 0 1 1.5 1.5v6.5a1.5 1.5 0 0 1-1.5 1.5H8l-3.5 3v-3H3a1.5 1.5 0 0 1-1.5-1.5V4A1.5 1.5 0 0 1 3 2.5z\" fill=\"#b9a4e6\"/><circle cx=\"5.5\" cy=\"7.2\" r=\"1\" fill=\"#121016\"/><circle cx=\"8.5\" cy=\"7.2\" r=\"1\" fill=\"#121016\"/><circle cx=\"11.5\" cy=\"7.2\" r=\"1\" fill=\"#121016\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\n\nrun_function(\"comms_setup\", [], \"comms\");\nrun_function(\"comms_render\", [], \"comms\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Channel traffic for the Comms tab (#157), from GMCP only:\n//   Comm.Channel.Text {channel, talker, text}: one line (text is the whole game\n//     line with its ANSI colours: \"\\u001b[0;1;33mDol tells you, ...\")\n//   Comm.Channel.List [{name, caption, command}]: the channels' own names\n//   Char.Name / Char.Status: your name, so your own lines can be told apart\nvar cmM = \"\";\nvar cmA = null;\ntry { cmM = args.gmcp_method; cmA = args.gmcp_args; } catch (e) { cmM = \"\"; }\nif (cmM === \"Comm.Channel.Text\" || cmM === \"Comm.Channel.List\" || cmM === \"Char.Name\" || cmM === \"Char.Status\") {\n  if (typeof cmA === \"string\") { try { cmA = JSON.parse(cmA); } catch (e) { } }\n  if (!client.loom || !client.loom.comms || !client.loom.comms.chans) run_function(\"comms_setup\", [], \"comms\");\n  var CM = client.loom.comms;\n  if (cmM !== \"Char.Status\") CM.raw[cmM] = cmA;\n  if (cmM === \"Comm.Channel.Text\" && cmA && cmA.channel) {\n    run_function(\"comms_add\", cmA, \"comms\");\n  } else if (cmM === \"Comm.Channel.List\" && cmA && cmA.length) {\n    for (var cmI = 0; cmI < cmA.length; cmI++) {\n      if (cmA[cmI] && cmA[cmI].name && cmA[cmI].caption) CM.captions[String(cmA[cmI].name)] = String(cmA[cmI].caption);\n    }\n    run_function(\"comms_render\", [], \"comms\");\n  } else if ((cmM === \"Char.Name\" || cmM === \"Char.Status\") && cmA && cmA.name) {\n    var cmN = String(cmA.name).split(/\\s+/)[0];\n    if (cmN && cmN !== CM.me) { CM.me = cmN; set_variable(\"comms_name\", cmN); }\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "comms_setup",
   "enabled": true,
   "code": "// comms_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Namespace, registry and state for the Comms tab\n// (#157), a replacement for the stock communication window fed only by GMCP\n// Comm.Channel.Text {channel, talker, text}:\n//   C.chans   key -> {key, cap, lines, unread, first}; key is the GMCP channel\n//             (\"says\", \"party\", \"ct\"...), except tells, all kept under \"tells\"\n//   C.convs   tells by person: name -> {name, unread, last}\n//   C.view    what the tab shows: \"all\", a channel key, \"tells\" (the\n//             conversations) or \"tell:<name>\" (one conversation)\n//   C.muted   key -> true; muted channels are kept but left out of All and\n//             count no unread (comms_muted)\n//   C.cap     lines kept per channel (comms_cap, default 300)\n//   C.me      your name (Char.Name / Char.Status, kept as comms_name)\n//   C.raw     the last payload of each method, for COMMS DEBUG\n// A few of the latest lines are saved (comms_saved) so a reload starts with them.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.comms) client.loom.comms = {};\nclient.loom.registry.comms = { version: \"0.1.0\", keyword: \"COMMS\", desc: \"A Comms tab replacing the stock comm window: channels, tells, unread, mute\" };\nvar C = client.loom.comms;\nC.tab = \"Comms\";\nif (!C.chans) C.chans = {};\nif (!C.convs) C.convs = {};\nif (!C.raw) C.raw = {};\nif (!C.captions) C.captions = {};   // from Comm.Channel.List: \"the Clan of Bartho Designs\"\nif (!C.short) C.short = {};         // from the lines' own prefix: \"Bartho Designs\"\nif (!C.view) C.view = \"all\";\nif (!C.seq) C.seq = 0;\nif (!C.me) { try { C.me = String(get_variable(\"comms_name\") || \"\"); } catch (e) { C.me = \"\"; } }\nvar csCap = parseInt(get_variable(\"comms_cap\"), 10);\nC.cap = (csCap >= 50 && csCap <= 2000) ? csCap : 300;\nC.muted = {};\nvar csMu = get_variable(\"comms_muted\");\nif (csMu) {\n  var csMl = String(csMu).split(\",\");\n  for (var csI = 0; csI < csMl.length; csI++) { if (csMl[csI]) C.muted[csMl[csI]] = true; }\n}\n\n// A channel's name for the tab and notices: the lines' own prefix (\"Bartho\n// Designs\") first, then Comm.Channel.List's caption without \"the\" / \"the Clan\n// of\", then the key itself.\nC.name = function (k) {\n  var cc = client.loom.comms;\n  k = String(k || \"\");\n  if (k === \"tells\") return \"Tells\";\n  if (k === \"says\") return \"Say\";\n  if (cc.short[k]) return cc.short[k];\n  if (cc.captions[k]) return cc.captions[k].replace(/^the\\s+(?:clan\\s+of\\s+)?/i, \"\");\n  return k.charAt(0).toUpperCase() + k.slice(1);\n};\n\n// The latest lines from before the reload, when nothing has come in yet.\nif (!C.restored) {\n  C.restored = true;\n  var csSv = get_variable(\"comms_saved\");\n  if (typeof csSv === \"string\") { try { csSv = JSON.parse(csSv); } catch (e) { csSv = null; } }\n  if (csSv && csSv.lines && csSv.lines.length) {\n    if (csSv.short) { for (var csK in csSv.short) { if (csSv.short.hasOwnProperty(csK) && !C.short[csK]) C.short[csK] = csSv.short[csK]; } }\n    for (var csJ = 0; csJ < csSv.lines.length; csJ++) {\n      var csL = csSv.lines[csJ];\n      if (!csL || !csL.ch) continue;\n      if (!C.chans[csL.ch]) C.chans[csL.ch] = { key: csL.ch, lines: [], unread: 0, first: ++C.seq };\n      csL.s = ++C.seq;\n      csL.old = true;\n      C.chans[csL.ch].lines.push(csL);\n      if (csL.conv) {\n        var csCk = csL.conv.toLowerCase();\n        if (!C.convs[csCk]) C.convs[csCk] = { name: csL.conv, unread: 0, last: 0 };\n        C.convs[csCk].last = Math.max(C.convs[csCk].last, csL.t || 0);\n      }\n    }\n  }\n}\n\n// What the tab's clicks call: the tab's page can't reach client, but it shares\n// this window, so these closures do the work on its behalf.\ntry {\n  window.loomComms = {\n    view: function (k) { run_function(\"comms_view\", { key: String(k) }, \"comms\"); },\n    chip: function (i) {\n      var cc = client.loom.comms;\n      if (cc.chips && cc.chips[i] !== undefined) run_function(\"comms_view\", { key: cc.chips[i] }, \"comms\");\n    },\n    mute: function () {\n      var cc = client.loom.comms;\n      if (cc.view && cc.chans[cc.view]) run_function(\"comms_mute\", { key: cc.view, on: !cc.muted[cc.view] }, \"comms\");\n    },\n    tell: function (name) {\n      // Put \"tell <name> \" in the input line. Nexus's input is a React field, so\n      // the value goes in through the native setter and an input event.\n      var n = String(name).replace(/[^A-Za-z]/g, \"\");\n      if (!n) return;\n      var inp = window.loomComms.input();\n      if (!inp) { display_notice(\"[comms] couldn't find the input line to put the tell in. COMMS DEBUG shows what was looked for.\", \"orange\"); return; }\n      var v = \"tell \" + n + \" \";\n      try {\n        var proto = Object.getPrototypeOf(inp);\n        var desc = Object.getOwnPropertyDescriptor(proto, \"value\");\n        if (desc && desc.set) desc.set.call(inp, v); else inp.value = v;\n      } catch (e) { inp.value = v; }\n      try { inp.dispatchEvent(new Event(\"input\", { bubbles: true })); } catch (e) {}\n      try { inp.focus(); inp.setSelectionRange(v.length, v.length); } catch (e) {}\n    },\n    input: function () {\n      var ids = [\"userinput\", \"user_input\", \"input\", \"command_input\"];\n      for (var i = 0; i < ids.length; i++) {\n        var e = document.getElementById(ids[i]);\n        if (e && (e.tagName === \"TEXTAREA\" || e.tagName === \"INPUT\")) return e;\n      }\n      // Otherwise the text field last typed into (the input line, almost\n      // always), or the first visible textarea, then the first text input.\n      var li = window.loomCommsLastInput;\n      if (li && li.isConnected && li.offsetParent !== null) return li;\n      var sels = [\"textarea\", \"input[type=text], input:not([type])\"];\n      for (var s = 0; s < sels.length; s++) {\n        var all = document.querySelectorAll(sels[s]);\n        for (var j = 0; j < all.length; j++) { if (all[j].offsetParent !== null) return all[j]; }\n      }\n      return null;\n    }\n  };\n  if (!window.loomCommsFocus) {\n    window.loomCommsFocus = true;\n    document.addEventListener(\"focusin\", function (ev) {\n      var t = ev.target;\n      if (t && (t.tagName === \"TEXTAREA\" || (t.tagName === \"INPUT\" && (!t.type || t.type === \"text\")))) window.loomCommsLastInput = t;\n    }, true);\n  }\n} catch (e) {}\n"
  },
  {
   "type": "function",
   "name": "comms_add",
   "enabled": true,
   "code": "// comms_add -- args: one Comm.Channel.Text payload {channel, talker, text}.\n// Turns the game's line into a stored line for the Comms tab:\n//   {s, t, ch, conv, talker, segs: [[text, colour]...], me, mention}\n// The ANSI colours become segments in the game's own colours (so your CONFIG\n// COLOUR choices carry over), and the \"(Party): \" style prefix is dropped (the\n// tab shows the channel itself), learning the channel's name from it.\n// Tells (\"tell Dol\") are all kept under \"tells\", by person.\nvar C = client.loom.comms;\nvar caCh = String(args.channel || \"\");\nvar caTalker = String(args.talker || \"\");\nvar caRaw = String(args.text || \"\");\n\n// ANSI -> segments. Bold (1) or the 90s give the bright shade.\nvar caPal = {\n  n: { 30: \"#6d6d6d\", 31: \"#d0504a\", 32: \"#3fae4a\", 33: \"#c8a63a\", 34: \"#5a78d8\", 35: \"#b45ab4\", 36: \"#3fb2b2\", 37: \"#c8c8c8\" },\n  b: { 30: \"#9a9a9a\", 31: \"#ff6b62\", 32: \"#6fe07a\", 33: \"#f2e15e\", 34: \"#7d9cff\", 35: \"#f07af0\", 36: \"#62e6e6\", 37: \"#f4f4f4\" }\n};\nvar caSegs = [];\nvar caBold = false, caFg = null;\nvar caParts = caRaw.split(/\\u001b\\[([0-9;]*)m/);\nfor (var caI = 0; caI < caParts.length; caI++) {\n  if (caI % 2 === 1) {\n    var caCodes = caParts[caI] === \"\" ? [\"0\"] : caParts[caI].split(\";\");\n    for (var caJ = 0; caJ < caCodes.length; caJ++) {\n      var caC = parseInt(caCodes[caJ], 10);\n      if (caC === 0) { caBold = false; caFg = null; }\n      else if (caC === 1) caBold = true;\n      else if (caC === 22) caBold = false;\n      else if (caC >= 30 && caC <= 37) caFg = { c: caC, br: false };\n      else if (caC >= 90 && caC <= 97) caFg = { c: caC - 60, br: true };\n      else if (caC === 39) caFg = null;\n    }\n  } else if (caParts[caI] !== \"\") {\n    var caCol = caFg ? caPal[(caBold || caFg.br) ? \"b\" : \"n\"][caFg.c] : \"\";\n    var caLast = caSegs[caSegs.length - 1];\n    if (caLast && caLast[1] === caCol) caLast[0] += caParts[caI];\n    else caSegs.push([caParts[caI], caCol]);\n  }\n}\n// Any stray control characters left out; trailing spaces trimmed.\nfor (var caK = 0; caK < caSegs.length; caK++) caSegs[caK][0] = caSegs[caK][0].replace(/[\\u0000-\\u001f]/g, \"\");\nif (caSegs.length) caSegs[caSegs.length - 1][0] = caSegs[caSegs.length - 1][0].replace(/\\s+$/, \"\");\n\n// \"(Party): \" / \"(Eleusis): \" -> dropped, and remembered as the channel's short name.\nvar caPlain = \"\";\nfor (var caP = 0; caP < caSegs.length; caP++) caPlain += caSegs[caP][0];\nvar caPre = /^\\(([^)]{1,40})\\):\\s+/.exec(caPlain);\nif (caPre) {\n  C.short[caCh] = caPre[1];\n  var caDrop = caPre[0].length;\n  while (caDrop > 0 && caSegs.length) {\n    if (caSegs[0][0].length <= caDrop) { caDrop -= caSegs[0][0].length; caSegs.shift(); }\n    else { caSegs[0][0] = caSegs[0][0].slice(caDrop); caDrop = 0; }\n  }\n}\n\nvar caKey = caCh;\nvar caConv = null;\nvar caTell = /^tell\\s+(\\S+)/i.exec(caCh);\nif (caTell) { caKey = \"tells\"; caConv = caTell[1].charAt(0).toUpperCase() + caTell[1].slice(1).toLowerCase(); }\n\nvar caMeN = String(C.me || \"\").toLowerCase();\nvar caMe = (caMeN && caTalker.toLowerCase() === caMeN) || /^You\\b/.test(caPlain.replace(/^\\([^)]*\\):\\s+/, \"\"));\nvar caMention = !caMe && caMeN.length > 1 && new RegExp(\"\\\\b\" + caMeN + \"\\\\b\", \"i\").test(caPlain);\n\nvar caNow = Date.now();\nvar caLine = { s: ++C.seq, t: caNow, ch: caKey, conv: caConv, talker: caTalker, segs: caSegs, me: caMe, mention: caMention };\nif (!C.chans[caKey]) C.chans[caKey] = { key: caKey, lines: [], unread: 0, first: C.seq };\nvar caChan = C.chans[caKey];\ncaChan.lines.push(caLine);\nwhile (caChan.lines.length > C.cap) caChan.lines.shift();\nif (caConv) {\n  var caCk = caConv.toLowerCase();\n  if (!C.convs[caCk]) C.convs[caCk] = { name: caConv, unread: 0, last: 0 };\n  C.convs[caCk].last = caNow;\n}\n\n// Unread: a line from someone else that the tab isn't showing right now.\n// Muted channels count nothing.\nvar caSeen = (C.view === \"all\" && !C.muted[caKey]) || C.view === caKey || (caConv && C.view === \"tell:\" + caConv.toLowerCase());\nif (!caMe && !caSeen && !C.muted[caKey]) {\n  if (caConv) C.convs[caConv.toLowerCase()].unread++;\n  else caChan.unread++;\n}\n\n// Saved a little later, so a busy channel writes once rather than per line.\nif (!C.saveT) C.saveT = setTimeout(function () { client.loom.comms.saveT = null; run_function(\"comms_save\", [], \"comms\"); }, 15000);\nif (C.drawT) clearTimeout(C.drawT);\nC.drawT = setTimeout(function () { client.loom.comms.drawT = null; run_function(\"comms_render\", [], \"comms\"); }, 30);\n"
  },
  {
   "type": "function",
   "name": "comms_render",
   "enabled": true,
   "code": "// comms_render -- the Comms tab (#157): channel traffic from GMCP, in the\n// game's own colours, newest at the bottom.\n//   - a row of filters: All, Tells, Say, Party, then every other channel in\n//     the order first heard, each with its unread count; muted ones dimmed\n//   - All: every channel that isn't muted, each line tagged with its channel\n//     (a click on the tag opens that channel)\n//   - Tells: the people you've been telling, newest first; a click opens the\n//     conversation, both sides\n//   - your own lines dimmed, lines that name you marked\n//   - a click on a talker's name puts \"tell <name> \" in the input line\n// Clicks go through window.loomComms (comms_setup): the tab's page can't\n// reach client. House style shared with Stats, Online, Here: ink panel,\n// serif small-caps headings, monospace rows. The accent is a soft violet.\nvar C = client.loom.comms;\nvar ACC = \"#b9a4e6\";\nvar TXT = \"#e6e2ec\";\nvar MUTED = \"#8c8796\";\nvar DIM = \"#5f5a68\";\nvar RULE = \"#26222e\";\nvar INK = \"#121016\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\"); }\nfunction p2(n) { return (n < 10 ? \"0\" : \"\") + n; }\nfunction hm(t) { var d = new Date(t); return p2(d.getHours()) + \":\" + p2(d.getMinutes()); }\nfunction hms(t) { var d = new Date(t); return d.toDateString() + \" \" + hm(t) + \":\" + p2(d.getSeconds()); }\nfunction badge(n) { return n > 0 ? ' <span style=\"color:' + INK + ';background:' + ACC + ';border-radius:6px;padding:0 4px;font-size:9px;\">' + n + '</span>' : ''; }\nfunction ago(t) {\n  var m = Math.floor((Date.now() - t) / 60000);\n  if (m < 1) return \"now\";\n  if (m < 60) return m + \"m\";\n  var h = Math.floor(m / 60);\n  return h < 48 ? h + \"h\" : Math.floor(h / 24) + \"d\";\n}\n// A line's text: its segments in their colours, the talker's name clickable.\nfunction body(l) {\n  var out = \"\";\n  var who = (!l.me && /^[A-Za-z]+$/.test(l.talker || \"\")) ? l.talker : \"\";\n  var whoRe = who ? new RegExp(\"\\\\b\" + who + \"\\\\b\") : null;\n  for (var i = 0; i < l.segs.length; i++) {\n    var tx = l.segs[i][0];\n    var st = l.segs[i][1] ? ' style=\"color:' + l.segs[i][1] + ';\"' : '';\n    var m = whoRe ? whoRe.exec(tx) : null;\n    if (m) {\n      out += '<span' + st + '>' + esc(tx.slice(0, m.index)) +\n        '<span class=\"loom-cm-who\" title=\"tell ' + who + '\" onclick=\"window.loomComms&&window.loomComms.tell(\\'' + who + '\\')\">' + who + '</span>' +\n        esc(tx.slice(m.index + who.length)) + '</span>';\n      whoRe = null;\n    } else {\n      out += '<span' + st + '>' + esc(tx) + '</span>';\n    }\n  }\n  return out;\n}\nfunction firstCol(l) {\n  for (var i = 0; i < l.segs.length; i++) { if (l.segs[i][1]) return l.segs[i][1]; }\n  return MUTED;\n}\nfunction lineRow(l, tag) {\n  var bg = l.mention ? 'background:rgba(185,164,230,0.10);border-left:2px solid ' + ACC + ';padding-left:4px;' : 'border-left:2px solid transparent;padding-left:4px;';\n  var h = '<div style=\"display:flex;gap:6px;align-items:baseline;padding:1px 0;' + bg + (l.me ? 'opacity:0.55;' : '') + '\">';\n  h += '<span title=\"' + esc(hms(l.t)) + '\" style=\"flex:none;width:2.9em;color:' + DIM + ';\">' + hm(l.t) + '</span>';\n  if (tag) {\n    var tk = l.ch;\n    var tn = l.conv ? l.conv : C.name(tk);\n    var tv = l.conv ? \"tell:\" + l.conv.toLowerCase() : tk;\n    h += '<span class=\"loom-cm-tag\" title=\"' + esc(C.name(tk)) + '\" onclick=\"window.loomComms&&window.loomComms.view(\\'' + esc(tv).replace(/'/g, \"\") + '\\')\" style=\"flex:none;width:6.5em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:' + firstCol(l) + ';opacity:0.8;\">' + esc(tn) + '</span>';\n  }\n  h += '<span style=\"flex:1;min-width:0;font-family:' + SERIF + ';font-size:12px;line-height:1.35;\">' + body(l) + '</span></div>';\n  return h;\n}\n\n// The filters: All, Tells, Say, Party, then the rest as first heard.\nvar keys = [];\nfor (var k in C.chans) { if (C.chans.hasOwnProperty(k)) keys.push(k); }\nvar pin = { tells: 1, says: 2, party: 3 };\nkeys.sort(function (a, b) { return (pin[a] || 9) - (pin[b] || 9) || C.chans[a].first - C.chans[b].first; });\nvar tellUnread = 0;\nfor (var cv in C.convs) { if (C.convs.hasOwnProperty(cv)) tellUnread += C.convs[cv].unread; }\nif (C.view !== \"all\" && C.view !== \"tells\" && C.view.indexOf(\"tell:\") !== 0 && !C.chans[C.view]) C.view = \"all\";\nif (C.view.indexOf(\"tell:\") === 0 && !C.convs[C.view.slice(5)]) C.view = \"tells\";\nvar allUnread = 0;\nfor (var ku = 0; ku < keys.length; ku++) { if (!C.muted[keys[ku]]) allUnread += keys[ku] === \"tells\" ? tellUnread : C.chans[keys[ku]].unread; }\nC.chips = [\"all\"].concat(keys);\nfunction chip(i, label, n, on, muted) {\n  return '<span class=\"loom-cm-chip\" onclick=\"window.loomComms&&window.loomComms.chip(' + i + ')\" title=\"' + esc(label) + (muted ? ' (muted)' : '') + '\" style=\"color:' + (on ? ACC : (muted ? DIM : MUTED)) + ';border-bottom:1px solid ' + (on ? ACC : 'transparent') + ';' + (muted ? 'text-decoration:line-through;' : '') + '\">' + esc(label.length > 16 ? label.slice(0, 15) + \"…\" : label) + badge(n) + '</span>';\n}\nvar inTells = C.view === \"tells\" || C.view.indexOf(\"tell:\") === 0;\nvar html = '<div id=\"loom-comms\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + INK + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;min-height:100%;box-sizing:border-box;\">';\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + DIM + ';padding-bottom:3px;\">';\nhtml += '<span style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:2px;font-size:15px;color:' + ACC + ';\">Comms</span>';\nif (C.chans[C.view] && C.view !== \"all\") {\n  html += '<span class=\"loom-cm-chip\" onclick=\"window.loomComms&&window.loomComms.mute()\" style=\"color:' + (C.muted[C.view] ? ACC : MUTED) + ';\">' + (C.muted[C.view] ? 'unmute ' : 'mute ') + esc(C.name(C.view)) + '</span>';\n}\nhtml += '</div>';\nhtml += '<div style=\"display:flex;flex-wrap:wrap;gap:4px 10px;margin:5px 0 4px;\">';\nhtml += chip(0, \"All\", allUnread, C.view === \"all\", false);\nfor (var ci = 0; ci < keys.length; ci++) {\n  var ck = keys[ci];\n  html += chip(ci + 1, C.name(ck), C.muted[ck] ? 0 : (ck === \"tells\" ? tellUnread : C.chans[ck].unread), C.view === ck || (ck === \"tells\" && inTells), !!C.muted[ck]);\n}\nhtml += '</div><div style=\"border-top:1px solid ' + RULE + ';padding-top:4px;\">';\n\nif (C.view === \"tells\") {\n  // The conversations, newest first.\n  var cl = [];\n  for (var cn in C.convs) { if (C.convs.hasOwnProperty(cn)) cl.push(C.convs[cn]); }\n  cl.sort(function (a, b) { return b.last - a.last; });\n  var tl = C.chans.tells ? C.chans.tells.lines : [];\n  if (!cl.length) html += '<div style=\"color:' + MUTED + ';padding:6px 0;\">no tells yet.</div>';\n  for (var cj = 0; cj < cl.length; cj++) {\n    var cc = cl[cj];\n    var lastL = null;\n    for (var tj = tl.length - 1; tj >= 0; tj--) { if (tl[tj].conv && tl[tj].conv.toLowerCase() === cc.name.toLowerCase()) { lastL = tl[tj]; break; } }\n    var prev = \"\";\n    if (lastL) { for (var sj = 0; sj < lastL.segs.length; sj++) prev += lastL.segs[sj][0]; }\n    html += '<div class=\"loom-cm-conv\" onclick=\"window.loomComms&&window.loomComms.view(\\'tell:' + cc.name.toLowerCase().replace(/[^a-z]/g, \"\") + '\\')\" style=\"display:flex;gap:8px;align-items:baseline;padding:3px 0;border-bottom:1px dotted ' + RULE + ';\">';\n    html += '<span style=\"flex:none;width:7em;font-family:' + SERIF + ';font-size:12px;color:' + (cc.unread ? ACC : TXT) + ';\">' + esc(cc.name) + badge(cc.unread) + '</span>';\n    html += '<span style=\"flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:' + MUTED + ';\">' + esc(prev) + '</span>';\n    html += '<span style=\"flex:none;color:' + DIM + ';\">' + (cc.last ? ago(cc.last) : '') + '</span></div>';\n  }\n} else {\n  var rows = [];\n  var tag = false;\n  if (C.view === \"all\") {\n    tag = true;\n    for (var ak = 0; ak < keys.length; ak++) {\n      if (C.muted[keys[ak]]) continue;\n      var al = C.chans[keys[ak]].lines;\n      for (var ai = Math.max(0, al.length - 200); ai < al.length; ai++) rows.push(al[ai]);\n    }\n    rows.sort(function (a, b) { return a.s - b.s; });\n    if (rows.length > 200) rows = rows.slice(rows.length - 200);\n  } else if (C.view.indexOf(\"tell:\") === 0) {\n    var who = C.convs[C.view.slice(5)];\n    html += '<div style=\"margin-bottom:3px;\"><span class=\"loom-cm-chip\" onclick=\"window.loomComms&&window.loomComms.view(\\'tells\\')\" style=\"color:' + MUTED + ';\">&larr; tells</span> <span style=\"font-family:' + SERIF + ';font-size:12px;color:' + ACC + ';\">&middot; ' + esc(who.name) + '</span>' +\n      ' <span class=\"loom-cm-who\" onclick=\"window.loomComms&&window.loomComms.tell(\\'' + who.name.replace(/[^A-Za-z]/g, \"\") + '\\')\" style=\"color:' + MUTED + ';\">(reply)</span></div>';\n    var wl = C.chans.tells ? C.chans.tells.lines : [];\n    for (var wi = 0; wi < wl.length; wi++) { if (wl[wi].conv && wl[wi].conv.toLowerCase() === who.name.toLowerCase()) rows.push(wl[wi]); }\n  } else {\n    rows = C.chans[C.view].lines;\n  }\n  if (!rows.length) html += '<div style=\"color:' + MUTED + ';padding:6px 0;\">' + (keys.length ? 'nothing here yet.' : 'nothing heard yet: channel lines show up here as they come.') + '</div>';\n  var oldSeen = false;\n  for (var ri = 0; ri < rows.length; ri++) {\n    if (rows[ri].old) oldSeen = true;\n    else if (oldSeen) { html += '<div style=\"text-align:center;color:' + DIM + ';margin:3px 0;border-top:1px dotted ' + RULE + ';\">before the reload &uarr;</div>'; oldSeen = false; }\n    html += lineRow(rows[ri], tag);\n  }\n}\nhtml += '</div>';\nvar mutedL = [];\nfor (var mk in C.muted) { if (C.muted.hasOwnProperty(mk)) mutedL.push(C.name(mk)); }\nhtml += '<div style=\"display:flex;justify-content:space-between;margin-top:6px;color:' + DIM + ';\">';\nhtml += '<span>' + (mutedL.length ? 'muted: ' + esc(mutedL.join(\", \")) : '') + '</span><span>keeps ' + C.cap + ' a channel</span></div>';\nhtml += '</div>';\n\n// The page style: the panel filling its tab, and hover on what's clickable.\ntry {\n  var cmSt = document.getElementById(\"loom-comms-style\");\n  if (!cmSt) { cmSt = document.createElement(\"style\"); cmSt.id = \"loom-comms-style\"; document.head.appendChild(cmSt); }\n  var cmCss = '.flexlayout__tab:has(#loom-comms) { background: ' + INK + ' !important; } .flexlayout__tab:has(#loom-comms) > * { min-height: 100%; }' +\n    ' .loom-cm-chip, .loom-cm-tag, .loom-cm-conv, .loom-cm-who { cursor: pointer; } .loom-cm-chip:hover, .loom-cm-tag:hover { color: ' + TXT + ' !important; }' +\n    ' .loom-cm-conv:hover { background: rgba(185,164,230,0.06); } .loom-cm-who { text-decoration: underline dotted rgba(255,255,255,0.35); text-underline-offset: 2px; } .loom-cm-who:hover { text-decoration-color: currentColor; }';\n  if (cmSt.textContent !== cmCss) cmSt.textContent = cmCss;\n} catch (e) {}\n\n// Newest at the bottom: stay there if you were there (or the view changed);\n// leave the scroll alone while you read back.\nvar cmSc = null, cmBottom = true;\ntry {\n  var cmEl = document.getElementById(\"loom-comms\");\n  for (var cmP = cmEl ? cmEl.parentElement : null; cmP; cmP = cmP.parentElement) {\n    if (cmP.scrollHeight > cmP.clientHeight + 2 && /auto|scroll/.test(getComputedStyle(cmP).overflowY)) { cmSc = cmP; break; }\n  }\n  if (cmSc) cmBottom = cmSc.scrollHeight - cmSc.scrollTop - cmSc.clientHeight < 40;\n} catch (e) {}\nvar cmJump = C.jump || cmBottom;\nC.jump = false;\ntry { set_custom_tab_html(C.tab, html); } catch (e) {}\nif (cmJump) {\n  setTimeout(function () {\n    try {\n      var el = document.getElementById(\"loom-comms\");\n      for (var p = el ? el.parentElement : null; p; p = p.parentElement) {\n        if (p.scrollHeight > p.clientHeight + 2 && /auto|scroll/.test(getComputedStyle(p).overflowY)) { p.scrollTop = p.scrollHeight; break; }\n      }\n    } catch (e) {}\n  }, 20);\n}\n"
  },
  {
   "type": "function",
   "name": "comms_view",
   "enabled": true,
   "code": "// comms_view -- args {key}: what the Comms tab shows. \"all\", \"tells\" (the\n// conversations), \"tell:<name>\" (one conversation) or a channel key. What\n// comes into view counts as read; the tab jumps to the newest line.\nvar C = client.loom.comms;\nvar vwK = String(args.key || \"all\");\nvar vwOk = vwK === \"all\" || vwK === \"tells\" || (vwK.indexOf(\"tell:\") === 0 && C.convs[vwK.slice(5)]) || (vwK !== \"tells\" && C.chans[vwK]);\nif (vwOk) {\n  C.view = vwK;\n  if (vwK === \"all\") {\n    for (var vwC in C.chans) { if (C.chans.hasOwnProperty(vwC) && !C.muted[vwC]) C.chans[vwC].unread = 0; }\n    if (!C.muted.tells) { for (var vwV in C.convs) { if (C.convs.hasOwnProperty(vwV)) C.convs[vwV].unread = 0; } }\n  } else if (vwK.indexOf(\"tell:\") === 0) {\n    C.convs[vwK.slice(5)].unread = 0;\n  } else if (vwK !== \"tells\") {\n    C.chans[vwK].unread = 0;\n  }\n  C.jump = true;\n}\nrun_function(\"comms_render\", [], \"comms\");\n"
  },
  {
   "type": "function",
   "name": "comms_mute",
   "enabled": true,
   "code": "// comms_mute -- args {key, on}: mute or unmute a channel. A muted channel is\n// still kept (its own filter shows it) but is left out of All and counts no\n// unread. Saved in comms_muted.\nvar C = client.loom.comms;\nvar muK = String(args.key || \"\");\nif (args.on) { C.muted[muK] = true; if (C.chans[muK]) C.chans[muK].unread = 0; if (muK === \"tells\") { for (var muV in C.convs) { if (C.convs.hasOwnProperty(muV)) C.convs[muV].unread = 0; } } }\nelse delete C.muted[muK];\nset_variable(\"comms_muted\", Object.keys(C.muted).join(\",\"));\ndisplay_notice(\"[comms] \" + C.name(muK) + (args.on ? \" muted: kept, but left out of All.\" : \" unmuted.\"), \"lime\");\nrun_function(\"comms_render\", [], \"comms\");\n"
  },
  {
   "type": "function",
   "name": "comms_save",
   "enabled": true,
   "code": "// comms_save -- keeps the latest lines in comms_saved, so a reload starts with\n// them: at most 40 per channel and 300 in all, the newest. Run 15s after a new\n// line (once per burst) and by COMMS CLEAR.\nvar C = client.loom.comms;\nvar svAll = [];\nfor (var svK in C.chans) {\n  if (!C.chans.hasOwnProperty(svK)) continue;\n  var svL = C.chans[svK].lines;\n  for (var svI = Math.max(0, svL.length - 40); svI < svL.length; svI++) svAll.push(svL[svI]);\n}\nsvAll.sort(function (a, b) { return a.s - b.s; });\nif (svAll.length > 300) svAll = svAll.slice(svAll.length - 300);\nvar svOut = [];\nfor (var svJ = 0; svJ < svAll.length; svJ++) {\n  var svX = svAll[svJ];\n  svOut.push({ t: svX.t, ch: svX.ch, conv: svX.conv, talker: svX.talker, segs: svX.segs, me: svX.me, mention: svX.mention });\n}\ntry { set_variable(\"comms_saved\", JSON.stringify({ short: C.short, lines: svOut })); } catch (e) {}\n"
  },
  {
   "type": "function",
   "name": "comms_help",
   "enabled": true,
   "code": "// comms_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[comms] the Comms tab: every channel, tell and say, in the game's own colours. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"COMMS\", \"the channels heard, what's muted, how many lines are kept\"],\n  [\"COMMS VIEW <channel|name|ALL>\", \"what the tab shows: a channel (TELLS, SAY, PARTY...), a tell conversation, or All\"],\n  [\"COMMS MUTE|UNMUTE <channel>\", \"leave a channel out of All and its unread count (still kept); the tab's mute link too\"],\n  [\"COMMS CAP <50-2000>\", \"lines kept per channel (default 300)\"],\n  [\"COMMS CLEAR [channel]\", \"forget every line, or one channel's\"],\n  [\"COMMS DEBUG\", \"the last comms GMCP payloads, and the input line tells go to\"],\n  [\"In the tab: click a filter to show it, a line's channel tag to open that channel, a name to start a tell to them.\"],\n  [\"The Comms tab replaces the stock communication window: create a custom tab named Comms, then close the stock one from the layout if you like.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "comms",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// COMMS [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.comms || !client.loom.comms.chans) run_function(\"comms_setup\", [], \"comms\");\nvar C = client.loom.comms;\nvar cmArg = String(args[1] || \"\").trim();\nvar cmW = cmArg.toLowerCase().split(/\\s+/);\nvar cmSub = cmW[0];\nvar cmRest = cmArg.replace(/^\\S+\\s*/, \"\");\nfunction cmSay(t, c) { display_notice(\"[comms] \" + t, c || \"cyan\"); }\n// A channel from what was typed: its key, or the start of its name.\nfunction cmFind(w) {\n  w = String(w || \"\").toLowerCase().trim();\n  if (!w) return \"\";\n  if (w === \"tell\" || w === \"tells\") return \"tells\";\n  if (w === \"say\" || w === \"says\") return \"says\";\n  if (C.chans[w]) return w;\n  for (var k in C.chans) { if (C.chans.hasOwnProperty(k) && C.name(k).toLowerCase().indexOf(w) === 0) return k; }\n  for (var k2 in C.chans) { if (C.chans.hasOwnProperty(k2) && C.name(k2).toLowerCase().indexOf(w) >= 0) return k2; }\n  return \"\";\n}\nvar cmDraw = true;\nif (cmSub === \"\" || cmSub === \"status\") {\n  var cmL = [];\n  for (var k in C.chans) {\n    if (!C.chans.hasOwnProperty(k)) continue;\n    cmL.push(C.name(k) + \" \" + C.chans[k].lines.length + (C.muted[k] ? \" (muted)\" : \"\"));\n  }\n  cmSay(cmL.length ? \"heard: \" + cmL.join(\", \") + \".\" : \"nothing heard yet.\");\n  cmSay(\"keeps \" + C.cap + \" lines a channel; showing \" + (C.view === \"all\" ? \"All\" : C.view.indexOf(\"tell:\") === 0 ? \"tells with \" + C.convs[C.view.slice(5)].name : C.name(C.view)) + \". COMMS HELP for commands.\");\n  cmDraw = false;\n} else if (cmSub === \"help\") {\n  run_function(\"comms_help\", [], \"comms\");\n  cmDraw = false;\n} else if (cmSub === \"mute\" || cmSub === \"unmute\") {\n  var cmK = cmFind(cmRest);\n  if (!cmRest) {\n    var cmMl = Object.keys(C.muted).map(function (x) { return C.name(x); });\n    cmSay(cmMl.length ? \"muted: \" + cmMl.join(\", \") + \".\" : \"nothing muted. COMMS MUTE <channel> to mute one.\");\n    cmDraw = false;\n  } else if (!cmK) {\n    cmSay(\"no channel heard yet matches '\" + cmRest + \"'. COMMS lists the ones heard.\", \"orange\");\n    cmDraw = false;\n  } else {\n    run_function(\"comms_mute\", { key: cmK, on: cmSub === \"mute\" }, \"comms\");\n    cmDraw = false;\n  }\n} else if (cmSub === \"view\" || cmSub === \"show\") {\n  var cmV = cmW[1] || \"all\";\n  var cmT = cmV === \"all\" ? \"all\" : (C.convs[cmV] ? \"tell:\" + cmV : cmFind(cmRest));\n  if (!cmT) { cmSay(\"no channel or tell matches '\" + cmRest + \"'.\", \"orange\"); cmDraw = false; }\n  else { run_function(\"comms_view\", { key: cmT }, \"comms\"); cmDraw = false; }\n} else if (cmSub === \"cap\") {\n  var cmN = parseInt(cmW[1], 10);\n  if (cmN >= 50 && cmN <= 2000) {\n    C.cap = cmN;\n    set_variable(\"comms_cap\", String(cmN));\n    for (var kc in C.chans) { if (C.chans.hasOwnProperty(kc)) { while (C.chans[kc].lines.length > cmN) C.chans[kc].lines.shift(); } }\n    cmSay(\"keeping \" + cmN + \" lines a channel now.\", \"lime\");\n  } else {\n    cmSay(\"keeps \" + C.cap + \" lines a channel. COMMS CAP <50-2000> to change it.\");\n    cmDraw = false;\n  }\n} else if (cmSub === \"clear\") {\n  if (!cmRest) {\n    C.chans = {}; C.convs = {}; C.view = \"all\";\n    cmSay(\"all lines cleared.\", \"lime\");\n  } else {\n    var cmC = cmFind(cmRest);\n    if (!cmC) { cmSay(\"no channel heard yet matches '\" + cmRest + \"'.\", \"orange\"); cmDraw = false; }\n    else {\n      delete C.chans[cmC];\n      if (cmC === \"tells\") C.convs = {};\n      cmSay(C.name(cmC) + \" cleared.\", \"lime\");\n    }\n  }\n  if (cmDraw) run_function(\"comms_save\", [], \"comms\");\n} else if (cmSub === \"debug\") {\n  var cmRk = Object.keys(C.raw);\n  if (!cmRk.length) cmSay(\"no comms GMCP seen yet.\");\n  for (var cmX = 0; cmX < cmRk.length; cmX++) {\n    var cmS = JSON.stringify(C.raw[cmRk[cmX]]);\n    cmSay(cmRk[cmX] + \" \" + (cmS.length > 600 ? cmS.slice(0, 600) + \"…\" : cmS), \"orange\");\n  }\n  cmSay(\"channels: \" + (Object.keys(C.chans).join(\", \") || \"none\") + \"; me=\" + (C.me || \"?\"), \"orange\");\n  var cmIn = null;\n  try { cmIn = window.loomComms && window.loomComms.input(); } catch (e) {}\n  cmSay(\"input line for tells: \" + (cmIn ? cmIn.tagName.toLowerCase() + (cmIn.id ? \"#\" + cmIn.id : \"\") + (cmIn.className ? \".\" + String(cmIn.className).split(\" \").join(\".\") : \"\") : \"not found\"), \"orange\");\n  cmDraw = false;\n} else {\n  cmSay(\"unknown command '\" + cmSub + \"'. COMMS HELP for commands.\", \"orange\");\n  cmDraw = false;\n}\nif (cmDraw) run_function(\"comms_render\", [], \"comms\");\n"
    }
   ],
   "text": "^comms(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false
  }
 ],
 "description": "A Comms tab replacing the stock comm window: channels, tells, unread, mute"
}