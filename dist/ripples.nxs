{
 "type": "group",
 "name": "ripples",
 "enabled": true,
 "description": "The Mnemosyne's wades: ripples, boons, affixes and runs in the Ripples tab",
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"ripples_setup\", [], \"ripples\");\ndisplay_notice(\"[ripples] installed. Create a UI tab named 'Ripples' for the panel. RIPPLES HELP lists the commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// The ripples_* variables are left intact; a run under way stays saved.\nif (client.loom && client.loom.ripples) {\n  var ruR = client.loom.ripples;\n  if (ruR.drawT) clearTimeout(ruR.drawT);\n  ruR.cap = null; ruR.ccap = null; ruR.scr = null;\n}\n// Leave LOOM and the integrations at once, not at the next load (#137).\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"ripples\");\n  else delete client.loom.registry.ripples;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"Ripples\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 18 16\"><path d=\"M1 9 Q5 5 9 9 T17 9\" fill=\"none\" stroke=\"#8fd0c4\" stroke-width=\"1.5\"/><path d=\"M3 13 Q6 10.5 9 13 T15 13\" fill=\"none\" stroke=\"#3f6f6a\" stroke-width=\"1.4\"/><circle cx=\"9\" cy=\"4\" r=\"2.2\" fill=\"#e8f1ee\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\n\nrun_function(\"ripples_setup\", [], \"ripples\");\nrun_function(\"ripples_render\", [], \"ripples\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// onGMCP: only the prompt matters (Char.Vitals): its health at once, the rest\n// after the packet's own lines.\nif (args.gmcp_method == \"Char.Vitals\") {\n  if (!client.loom || !client.loom.ripples || !client.loom.ripples.prompt) run_function(\"ripples_setup\", [], \"ripples\");\n  var rgV = (args.gmcp_args && typeof args.gmcp_args == \"object\") ? args.gmcp_args : {};\n  if (client.loom.ripples.run) client.loom.ripples.vitals(rgV);\n  setTimeout(client.loom.ripples.prompt, 0);\n}\n"
  },
  {
   "type": "function",
   "name": "ripples_setup",
   "enabled": true,
   "code": "// ripples_setup -- the Mnemosyne's wades, ripple by ripple. Run from onLoad,\n// onInstall, RIPPLES RESET and any reflex that finds the namespace missing.\n// Data is kept across a rerun; helpers are rebuilt.\n//\n// What it follows (Ricardo's wade log, 2026-11-14/15):\n//   run start    \"You silently slip beneath the water and the world is as it once was.\"\n//   boon screen  \"As the Mnemosyne stretches ever on ... flickers of power ...\" (ends a\n//                ripple), a rule, one \"Name:   description\" line per option, a rule,\n//                \"BOON CLAIM <boon name> ...\", maybe \"BOON REROLL ... (N remaining).\"\n//   claim        \"A fulgent eddy falls still.\" (no name: BOON CLAIMED is asked, quietly)\n//   ripple start countdown 5..0, one line naming the place, \"GO!\"\n//   WADE STATUS  \"You wade N ripples deep into the tides of memory:\" ... asked\n//                quietly after GO!, after kills and every RIPPLES POLL seconds\n//   run end      \"The Mnemosyne relinquishes memory's grip upon you.\"\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.ripples) client.loom.ripples = {};\nvar R = client.loom.ripples;\nclient.loom.registry.ripples = { version: \"0.1.0\", keyword: \"RIPPLES\", desc: \"The Mnemosyne's wades: ripples, boons, affixes and runs in the Ripples tab\",\n  redraw: function () { run_function(\"ripples_render\", [], \"ripples\"); },\n  // Busy only while a quiet question it sent is unanswered.\n  busy: function () { var X = client.loom && client.loom.ripples; return !!(X && (X.cap && X.cap.ours || X.ccap)); } };\nR.tab = \"Ripples\";\n\nfunction rpParse(name, want) {\n  var v;\n  try { v = get_variable(name); if (typeof v == \"string\") v = v.length ? JSON.parse(v) : null; } catch (e) { v = null; }\n  if (want === \"array\") return Array.isArray(v) ? v : [];\n  return (v && typeof v == \"object\" && !Array.isArray(v)) ? v : null;\n}\n\n// ---- Saved data ----------------------------------------------------------\n// A saved run of any other shape is dropped; missing parts are filled in.\nfunction rpRun(r) {\n  if (!r || typeof r != \"object\" || Array.isArray(r) || !Array.isArray(r.ripples) || !Array.isArray(r.screens)) return null;\n  if (!Array.isArray(r.held)) r.held = [];\n  r.t0 = Number(r.t0) || 0; r.t1 = Number(r.t1) || 0; r.renown = Number(r.renown) || 0;\n  if (r.lives === undefined) r.lives = null;\n  if (r.rerolls === undefined) r.rerolls = null;\n  r.ripples = r.ripples.filter(function (c) { return c && typeof c == \"object\" && !Array.isArray(c); });\n  for (var i = 0; i < r.ripples.length; i++) {\n    var c = r.ripples[i];\n    c.n = Number(c.n) || i + 1; c.t0 = Number(c.t0) || r.t0; c.t1 = Number(c.t1) || 0;\n    c.kills = Number(c.kills) || 0; c.xp = Number(c.xp) || 0; c.gold = Number(c.gold) || 0; c.lost = Number(c.lost) || 0;\n    if (!c.dmg || typeof c.dmg != \"object\" || Array.isArray(c.dmg)) c.dmg = {};\n    if (!Array.isArray(c.aff)) c.aff = [];\n    if (c.wave === undefined) c.wave = null;\n    if (c.lvl === undefined) c.lvl = null;\n    if (c.spd === undefined) c.spd = null;\n    if (c.minHp === undefined) c.minHp = null;\n    if (c.minPct === undefined) c.minPct = null;\n    c.flees = Number(c.flees) || 0;\n  }\n  r.screens = r.screens.filter(function (x) { return x && typeof x == \"object\" && Array.isArray(x.opts); });\n  return r;\n}\nif (!R.runs) R.runs = rpParse(\"ripples_runs\", \"array\").map(rpRun).filter(function (r) { return r; });\nif (R.run === undefined) R.run = rpRun(rpParse(\"ripples_run\"));\nif (!R.codex) {\n  R.codex = rpParse(\"ripples_codex\") || {};\n  if (!R.codex.boons || typeof R.codex.boons != \"object\") R.codex.boons = {};\n  if (!R.codex.affixes || typeof R.codex.affixes != \"object\") R.codex.affixes = {};\n}\nif (!R.names) R.names = rpParse(\"ripples_names\") || {};\nif (R.poll === undefined) {\n  var rpPoll = String(get_variable(\"ripples_poll\") || \"\").trim().toLowerCase();\n  R.poll = rpPoll === \"off\" ? 0 : parseInt(rpPoll, 10);\n  if (isNaN(R.poll) || R.poll < 0) R.poll = 30;\n}\nif (!R.view) R.view = \"wade\";\nif (!R.sort) R.sort = \"taken\";\nif (R.cap === undefined) R.cap = null;      // a WADE STATUS being read\nif (R.ccap === undefined) R.ccap = null;    // a BOON CLAIMED being read\nif (R.scr === undefined) R.scr = null;      // a boon screen being read\nif (!R.asked) R.asked = 0;                  // when we last sent WADE STATUS\nif (!R.due) R.due = 0;                      // when the next one is due\nif (!R.ready) R.ready = 0;                  // when \"You may once more wade\" came\nR.maxRuns = 60;\n\n// The places, by the line the game prints just before GO!. Names for the\n// ones met so far; another line shows as itself until RIPPLES NAME.\nR.places = [\n  [/halls of Judgement Mountain/, \"Judgement Mountain\"],\n  [/streets of Lost Kasmarkin/, \"Lost Kasmarkin\"],\n  [/fey creatures from the enchanted water/, \"the fey lake\"],\n  [/in defence of the Duchy/, \"the Duchy\"],\n  [/secur\\w+ the city streets/, \"Arcadia\"],\n  [/minstrels of Tirfo Thuinn/, \"Tirfo Thuinn\"],\n  [/drowned pirates/, \"the pirate ship\"]\n];\n\nR.paused = function () { return get_variable(\"pauseTriggers\") == \"on\"; };\nR.say = function (t, c) { display_notice(\"[ripples] \" + t, c || \"cyan\"); };\nR.n = function (v) { v = Math.round(Number(v) || 0); var s = String(Math.abs(v)), o = \"\"; while (s.length > 3) { o = \",\" + s.slice(-3) + o; s = s.slice(0, -3); } return (v < 0 ? \"-\" : \"\") + s + o; };\nR.k = function (v) { v = Number(v) || 0; return Math.abs(v) >= 1000 ? (Math.round(v / 100) / 10) + \"k\" : String(Math.round(v)); };\nR.dur = function (ms) { var s = Math.max(0, Math.round((Number(ms) || 0) / 1000)); var m = Math.floor(s / 60); return m >= 60 ? Math.floor(m / 60) + \"h \" + (m % 60) + \"m\" : m + \":\" + (\"0\" + (s % 60)).slice(-2); };\nR.place = function (rip) {\n  if (!rip) return \"?\";\n  var intro = rip.intro || \"\";\n  if (R.names[intro]) return R.names[intro];\n  for (var i = 0; i < R.places.length; i++) if (R.places[i][0].test(intro)) return R.places[i][1];\n  return intro ? intro.replace(/[.!]$/, \"\").slice(0, 32) : \"ripple \" + rip.n;\n};\nR.cur = function () {\n  var r = R.run;\n  if (!r || !r.ripples.length) return null;\n  var c = r.ripples[r.ripples.length - 1];\n  return c.t1 ? null : c;\n};\nR.save = function () {\n  try { if (R.run) set_variable(\"ripples_run\", JSON.stringify(R.run)); else delete_variable(\"ripples_run\"); } catch (e) {}\n  R.saveAt = Date.now();\n};\nR.saveAll = function () {\n  R.save();\n  try { set_variable(\"ripples_runs\", JSON.stringify(R.runs)); } catch (e) {}\n  try { set_variable(\"ripples_codex\", JSON.stringify(R.codex)); } catch (e) {}\n};\nR.draw = function () {\n  if (R.drawT) return;\n  R.drawT = setTimeout(function () { R.drawT = null; run_function(\"ripples_render\", [], \"ripples\"); }, 60);\n};\n\n// ---- Runs and ripples ----------------------------------------------------\nR.startRun = function () {\n  if (R.run) R.endRun(\"?\");\n  var now = Date.now();\n  R.run = { id: now, t0: now, t1: 0, end: \"\", lives: null, rerolls: null, renown: 0, threads: null, ripples: [], screens: [], held: [] };\n  R.ready = 0;\n  R.save();\n  R.draw();\n};\nR.endRun = function (why) {\n  var r = R.run;\n  if (!r) return;\n  var now = Date.now();\n  var c = R.cur();\n  if (c) { c.flees = R.fleesIn(c); c.t1 = now; c.done = false; }\n  r.t1 = now;\n  r.end = why || (r.lives === 0 ? \"died\" : \"left\");\n  r.depth = 0;\n  for (var i = 0; i < r.ripples.length; i++) if (r.ripples[i].n > r.depth) r.depth = r.ripples[i].n;\n  R.runs.push(r);\n  while (R.runs.length > R.maxRuns) R.runs.shift();\n  R.run = null;\n  R.cap = null; R.ccap = null; R.scr = null;\n  R.saveAll();\n  R.say(\"run over: ripple \" + r.depth + \" in \" + R.dur(r.t1 - r.t0) + (r.renown ? \", \" + R.n(r.renown) + \" renown\" : \"\") + \".\", \"cyan\");\n  if (client.loom.notify) client.loom.notify(\"ripples\");\n  R.draw();\n};\nR.startRipple = function () {\n  if (!R.run) R.startRun();\n  var r = R.run, now = Date.now();\n  var c = R.cur();\n  if (c) { c.flees = R.fleesIn(c); c.t1 = now; c.done = false; }\n  var last = r.ripples.length ? r.ripples[r.ripples.length - 1].n : 0;\n  r.ripples.push({ n: last + 1, t0: now, t1: 0, done: false, intro: R.intro || \"\", kills: 0, xp: 0, gold: 0, dmg: {}, lost: 0, aff: [], obj: \"\", wave: null, lvl: null, spd: null, reroll: false, renown: 0, lives: r.lives, minHp: null, minPct: null, flees: 0, fleeBase: R.fleesNow() });\n  R.intro = \"\";\n  R.due = now + 1500;\n  R.save();\n  if (client.loom.notify) client.loom.notify(\"ripples\");\n  R.draw();\n};\nR.endRipple = function () {\n  var c = R.cur();\n  if (!c) return;\n  c.flees = R.fleesIn(c);\n  c.t1 = Date.now();\n  c.done = true;\n  R.save();\n  if (client.loom.notify) client.loom.notify(\"ripples\");\n};\n\n// ---- Boon screens ----------------------------------------------------------\nR.openScreen = function () {\n  if (!R.run) R.startRun();\n  var r = R.run;\n  if (R.cur()) R.endRipple();\n  var after = r.ripples.length ? r.ripples[r.ripples.length - 1].n : 0;\n  // Kept aside until its options are read: it may be the same screen again.\n  R.scr = { after: after, t: Date.now(), opts: [], took: \"\", rerolled: false, rule: 0 };\n};\n// A screen read whole. The same options again with nothing claimed since is\n// the same screen shown again (BOON OPTIONS); other options mean a reroll.\nR.finishScreen = function (s) {\n  var r = R.run;\n  if (!r || s.done) return;\n  s.done = true;\n  var prev = r.screens.length ? r.screens[r.screens.length - 1] : null;\n  if (prev && !prev.took && prev.after === s.after) {\n    if (prev.opts.join(\"|\") === s.opts.join(\"|\")) { R.scr = prev; prev.done = true; return; }\n    prev.rerolled = true;\n  }\n  delete s.rule;\n  r.screens.push(s);\n  R.save();\n  R.annotate(s);\n};\n// True when the line belonged to the screen; anything after its last line\n// closes it and is read as usual.\nR.screenLine = function (t) {\n  var s = R.scr;\n  if (s.rule >= 2 || s.closing) {\n    var m0 = /^BOON REROLL to discard these options and see new ones \\((\\d+) remaining\\)\\.$/.exec(t);\n    if (m0) { R.run.rerolls = parseInt(m0[1], 10); R.finishScreen(s); R.scr = null; R.save(); return true; }\n    if (/^BOON CLAIM <boon name>/.test(t)) { s.closing = true; R.finishScreen(s); return true; }\n    if (t === \"\") return true;\n    R.finishScreen(s);\n    R.scr = null;\n    return false;\n  }\n  if (/^-{20,}$/.test(t)) { s.rule++; return true; }\n  if (s.rule === 1) {\n    var m = /^(\\S[^:]{1,45}):\\s{2,}(\\S.*)$/.exec(t);\n    if (m) {\n      var nm = m[1].trim();\n      if (s.opts.indexOf(nm) < 0) s.opts.push(nm);\n      var cb = R.codex.boons[nm] || (R.codex.boons[nm] = {});\n      cb.d = m[2].trim();\n      return true;\n    }\n    return false;\n  }\n  return t === \"\" || t === \"Wading the Mnemosyne.\" || t === \"There are no obvious exits.\";\n};\n// What you've done with each option before, in the main window.\nR.annotate = function (s) {\n  var st = R.boonStats();\n  var lines = [];\n  for (var i = 0; i < s.opts.length; i++) {\n    var nm = s.opts[i];\n    if (nm === \"Restoration\") continue;\n    var b = st[nm];\n    var held = R.run && R.run.held.indexOf(nm) >= 0;\n    var txt;\n    if (!b || !b.offered) txt = \"new: never offered before\";\n    else txt = \"taken \" + b.taken + \" of \" + b.offered + (b.reach !== null ? \", runs with it reached \" + b.reach : \"\") + (held ? \" (held: taking it again echoes it)\" : \"\");\n    lines.push(\"  \" + nm + \": \" + txt);\n  }\n  if (lines.length) { R.say(\"these offers, from your past runs:\", \"cyan\"); for (var j = 0; j < lines.length; j++) display_notice(lines[j], \"cyan\"); }\n  R.draw();\n};\nR.claimed = function () {\n  var r = R.run;\n  if (!r) return;\n  var s = null;\n  for (var i = r.screens.length - 1; i >= 0; i--) if (!r.screens[i].took) { s = r.screens[i]; break; }\n  if (!s) return;\n  s.took = \"?\";\n  R.scr = null;\n  // The claim line names nothing: BOON CLAIMED tells which, quietly.\n  if (!R.paused()) {\n    R.ccap = { s: s, text: [], at: Date.now(), before: r.held.slice() };\n    send_command(\"boon claimed\");\n  }\n  R.save();\n  R.draw();\n};\nR.claimDone = function () {\n  var q = R.ccap;\n  R.ccap = null;\n  if (!q || !R.run) return;\n  var txt = q.text.join(\"\\n\").toLowerCase();\n  var found = [], fresh = [];\n  for (var i = 0; i < q.s.opts.length; i++) {\n    var nm = q.s.opts[i];\n    if (nm === \"Restoration\") continue;\n    if (txt.indexOf(nm.toLowerCase()) >= 0) { found.push(nm); if (q.before.indexOf(nm) < 0) fresh.push(nm); }\n  }\n  var took = \"?\";\n  if (fresh.length === 1) took = fresh[0];\n  else if (fresh.length === 0 && found.length === 1) took = found[0];\n  else if (fresh.length === 0 && q.text.length && q.s.opts.indexOf(\"Restoration\") >= 0) took = \"Restoration\";\n  q.s.took = took;\n  if (took !== \"?\" && took !== \"Restoration\" && R.run.held.indexOf(took) < 0) R.run.held.push(took);\n  if (took === \"?\") R.say(\"couldn't tell which boon you claimed (RIPPLES TOOK <boon> sets it).\", \"orange\");\n  R.save();\n  R.draw();\n};\n\n// ---- WADE STATUS ------------------------------------------------------------\nR.statusStart = function (n) {\n  var ours = R.asked && Date.now() - R.asked < 5000;\n  R.asked = 0;\n  R.cap = { n: n, ours: ours, f: {}, aff: [], fx: false, rules: 0, last: \"\" };\n};\nR.statusLine = function (t) {\n  var q = R.cap;\n  if (/^-{20,}$/.test(t)) {\n    q.rules++;\n    if (q.fx && q.last === \"rule\") { R.statusDone(); return true; }\n    q.last = \"rule\";\n    return true;\n  }\n  q.last = \"\";\n  if (t === \"\") return true;\n  if (/^Ongoing effects:/.test(t)) { q.fx = true; return true; }\n  var m = /^(\\S[^:]{1,45}):\\s+(\\S.*)$/.exec(t);\n  if (m && q.fx) {\n    var nm = m[1].trim();\n    if (q.aff.indexOf(nm) < 0) q.aff.push(nm);\n    R.codex.affixes[nm] = m[2].trim();\n    return true;\n  }\n  if (m) { q.f[m[1].trim().toLowerCase()] = m[2].trim(); return true; }\n  // Anything else isn't the status: stop reading, show it.\n  R.statusDone();\n  return false;\n};\nR.statusDone = function () {\n  var q = R.cap;\n  R.cap = null;\n  if (!q) return;\n  if (!R.run) R.startRun();\n  var r = R.run, f = q.f;\n  var c = R.cur();\n  if (!c && r.ripples.length === 0) { R.intro = \"\"; R.startRipple(); c = R.cur(); }\n  var lives = parseInt(f[\"remaining lives\"], 10);\n  if (!isNaN(lives)) {\n    if (c && r.lives !== null && lives < r.lives) c.lost += r.lives - lives;\n    r.lives = lives;\n  }\n  var rr = parseInt(f[\"rerolls\"], 10);\n  if (!isNaN(rr)) r.rerolls = rr;\n  if (c) {\n    if (q.n && c.n !== q.n) c.n = q.n;\n    var w = parseInt(f[\"wave progress\"], 10);\n    if (!isNaN(w)) { c.wave = w; c.wKills = c.kills; }\n    if (f[\"objective\"]) c.obj = f[\"objective\"];\n    if (f[\"reward\"]) c.reward = f[\"reward\"];\n    var lv = parseInt(f[\"denizen levels increased by\"], 10);\n    if (!isNaN(lv)) c.lvl = lv;\n    var sp = parseInt(f[\"denizen speed increased by\"], 10);\n    if (!isNaN(sp)) c.spd = sp;\n    for (var i = 0; i < q.aff.length; i++) if (c.aff.indexOf(q.aff[i]) < 0) c.aff.push(q.aff[i]);\n  }\n  R.due = Date.now() + (R.poll > 0 ? R.poll * 1000 : 1e12);\n  R.save();\n  R.draw();\n};\n\n// ---- Every line -------------------------------------------------------------\n// Returns true when the line should be hidden (only output it asked for).\nR.line = function (raw) {\n  var t = String(raw === undefined || raw === null ? \"\" : raw).replace(/\\u00a0/g, \" \").replace(/\\s+$/, \"\");\n  if (/^\\d+h, \\d+m\\b/.test(t)) return false;                 // a prompt\n  if (R.ccap) { if (t !== \"\" && !/^(?:A fulgent eddy|You |Health lost|Damage dealt)/.test(t)) { R.ccap.text.push(t); return true; } }\n  var m;\n  if (/^You wade (\\d+) ripples? deep into the tides of memory:$/.test(t)) {\n    m = /^You wade (\\d+)/.exec(t);\n    R.statusStart(parseInt(m[1], 10));\n    return R.cap.ours;\n  }\n  if (t.indexOf(\"flickers of power that may aide you\") >= 0) { R.openScreen(); return false; }\n  if (R.scr && R.screenLine(t)) return false;\n  if (t === \"You silently slip beneath the water and the world is as it once was.\") { R.startRun(); return false; }\n  if (!R.run) {\n    if (t === \"You may once more wade the depths of the Mnemosyne.\") { R.ready = Date.now(); R.draw(); }\n    return false;\n  }\n  var c = R.cur();\n  var ch = t.charAt(0);\n  if (ch === \"H\" && (m = /^Health lost: (\\d+) \\(([^)]+)\\)\\.$/.exec(t))) {\n    if (c) { var ty = m[2].replace(/^physical /, \"\"); c.dmg[ty] = (c.dmg[ty] || 0) + parseInt(m[1], 10); R.draw(); }\n    return false;\n  }\n  if (ch === \"Y\") {\n    if ((m = /^You have gained (\\d+) experience/.exec(t))) { if (c) { c.xp += parseInt(m[1], 10); R.draw(); } return false; }\n    if ((m = /^You pick up ([\\d,]+) gold sovereigns?\\.$/.exec(t))) { if (c) { c.gold += parseInt(m[1].replace(/,/g, \"\"), 10); R.draw(); } return false; }\n    if (/^You have slain /.test(t)) {\n      if (c) { c.kills++; if (R.due - Date.now() > 10000 && Date.now() - (c.lastPoll || 0) > 10000) R.due = Date.now() + 800; R.draw(); }\n      return false;\n    }\n    if ((m = /^You have been slain by (.+?)\\.$/.exec(t))) { if (c) c.killer = m[1]; R.run.killer = m[1]; R.due = Date.now() + 1500; return false; }\n    if (t === \"You may once more wade the depths of the Mnemosyne.\") { R.ready = Date.now(); R.draw(); return false; }\n    if (/^You begin to seek a path free of the Mnemosyne's depths/.test(t)) { R.run.leaving = Date.now(); return false; }\n    return false;\n  }\n  if (t === \"A fulgent eddy falls still.\") { R.claimed(); return false; }\n  if (t === \"Claim another boon.\") {\n    // A second pick from the same screen (a boss's reward).\n    var ls = R.run.screens[R.run.screens.length - 1];\n    if (ls && ls.took) { R.run.screens.push({ after: ls.after, t: Date.now(), opts: ls.opts.slice(), took: \"\", rerolled: false, extra: true, done: true }); R.save(); R.draw(); }\n    return false;\n  }\n  if (t === \"A fresh eddy of possibility coalesces - you have gained a boon reroll.\") { var lr = R.run.ripples[R.run.ripples.length - 1]; if (lr) lr.reroll = true; return false; }\n  if ((m = /\\(You gain ([\\d,]+) Renown\\.\\)$/.exec(t))) {\n    var ren = parseInt(m[1].replace(/,/g, \"\"), 10);\n    R.run.renown += ren;\n    var lr2 = R.run.ripples[R.run.ripples.length - 1];\n    if (lr2) lr2.renown = (lr2.renown || 0) + ren;\n    R.save(); R.draw();\n    return false;\n  }\n  if (t === \"The Mnemosyne relinquishes memory's grip upon you.\") { R.endRun(); return false; }\n  // The countdown, the place, GO!\n  if (/^[0-5]$/.test(t)) { R.count = t; R.intro = \"\"; return false; }\n  if (t === \"GO!\") { R.count = null; R.startRipple(); return false; }\n  if (R.count === \"0\") { R.intro = t; R.count = null; return false; }\n  return false;\n};\n// A WADE STATUS being read comes first: its lines are hidden only when it\n// was ours. A line that isn't part of it ends it and is read as usual.\nR.lineRest = R.line;\nR.line = function (raw) {\n  if (R.cap) {\n    var ours = R.cap.ours;\n    var t = String(raw === undefined || raw === null ? \"\" : raw).replace(/\\u00a0/g, \" \").replace(/\\s+$/, \"\");\n    if (/^\\d+h, \\d+m\\b/.test(t)) return false;\n    if (R.statusLine(t)) return ours;\n  }\n  return R.lineRest(raw);\n};\n\n// ---- The prompt ---------------------------------------------------------------\n// After each prompt's lines: close what the prompt ends, ask WADE STATUS when due.\nR.prompt = function () {\n  if (R.ccap && R.ccap.text.length) R.claimDone();\n  else if (R.ccap && Date.now() - R.ccap.at > 8000) R.claimDone();\n  if (R.cap) R.statusDone();\n  if (R.count === \"0\") R.count = null;\n  var c = R.cur();\n  var now = Date.now();\n  if (c && R.poll > 0 && !R.cap && !R.ccap && !R.scr && now >= R.due && !R.paused() && !(R.run && R.run.leaving)) {\n    R.asked = now;\n    c.lastPoll = now;\n    R.due = now + R.poll * 1000;\n    send_command(\"wade status\");\n  }\n  if (R.run && now - (R.saveAt || 0) > 30000) R.save();\n};\n\n// ---- Health, flees, damage colour ---------------------------------------------\n// The lowest health in each ripple: how close you came to dying.\nR.vitals = function (g) {\n  var hp = parseInt(g.hp, 10), mx = parseInt(g.maxhp, 10);\n  if (isNaN(hp) || isNaN(mx) || mx <= 0) return;\n  R.maxhp = mx;\n  var c = R.cur();\n  if (!c) return;\n  var p = Math.round(hp / mx * 100);\n  if (c.minHp === null || c.minHp === undefined || hp < c.minHp) { c.minHp = hp; c.minPct = p; c.minAt = Date.now(); }\n};\n// The basher's flees, through loom (link basher-ripples): a running count,\n// so a ripple's flees are the count now less the count when it began.\nR.fleesNow = function () {\n  var LL = client.loom.loom;\n  var v = (LL && LL.answer) ? LL.answer(\"ripples\", \"basher.flees\") : undefined;\n  return typeof v == \"number\" ? v : null;\n};\nR.fleesIn = function (c) {\n  if (!c) return 0;\n  if (c.t1) return c.flees || 0;\n  var now = R.fleesNow();\n  if (now === null) return c.flees || 0;\n  if (c.fleeBase === null || c.fleeBase === undefined || now < c.fleeBase) c.fleeBase = 0;   // a reload since\n  return now - c.fleeBase;\n};\nR.hasFlees = function () { return R.fleesNow() !== null; };\n// Damage taken per second, coloured as huntstats colours it (link\n// huntstats-ripples, HUNTSTATS TANK); without it, the same rule at its\n// default of 3% of your max health a second.\nR.tone = function (dps) {\n  var LL = client.loom.loom;\n  var t = (LL && LL.answer) ? LL.answer(\"ripples\", \"damage.tone\", dps) : undefined;\n  if (t && t.colour) return t;\n  if (!R.maxhp) return null;\n  var cap = 0.03 * R.maxhp;\n  if (dps < cap / 2) return { colour: \"#8fd694\", word: \"under half of what you heal (3% of max health a second)\", cap: cap };\n  if (dps <= cap) return { colour: \"#e8c65a\", word: \"up to what you heal (3% of max health a second)\", cap: cap };\n  return { colour: \"#ff6a5e\", word: \"more than you heal (3% of max health a second)\", cap: cap };\n};\n// Denizens left, guessed from the wave's progress at the last WADE STATUS\n// and the kills by then: null when there's nothing to go on.\nR.left = function (c) {\n  if (!c || !c.wave || c.wave >= 100 || !c.wKills) return null;\n  return Math.max(0, Math.round(c.wKills / (c.wave / 100) - c.kills));\n};\n// Renaming a place everywhere it shows: every place line now shown under\n// that name gets the new one, kept for the ripples to come.\nR.rename = function (from, to) {\n  var intros = {}, all = R.ripplesAll(true), n = 0;\n  for (var i = 0; i < all.length; i++) if (all[i].intro && R.place(all[i]).toLowerCase() === String(from).toLowerCase()) intros[all[i].intro] = 1;\n  for (var k in intros) if (intros.hasOwnProperty(k)) {\n    if (to) R.names[k] = String(to).slice(0, 40); else delete R.names[k];\n    n++;\n  }\n  if (n) { try { set_variable(\"ripples_names\", JSON.stringify(R.names)); } catch (e) {} R.draw(); }\n  return n;\n};\n\n// ---- Numbers for the tab and the notices ------------------------------------\nR.allRuns = function () { return R.run ? R.runs.concat([R.run]) : R.runs.slice(); };\nR.secs = function (c) { return Math.max(1, ((c.t1 || Date.now()) - c.t0) / 1000); };\nR.dmgTotal = function (c) { var s = 0; for (var k in c.dmg) if (c.dmg.hasOwnProperty(k)) s += c.dmg[k]; return s; };\nR.median = function (a) {\n  if (!a.length) return null;\n  var b = a.slice().sort(function (x, y) { return x - y; });\n  var h = Math.floor(b.length / 2);\n  return b.length % 2 ? b[h] : Math.round((b[h - 1] + b[h]) / 2 * 10) / 10;\n};\nR.depthOf = function (run) { var d = 0; for (var i = 0; i < run.ripples.length; i++) if (run.ripples[i].n > d) d = run.ripples[i].n; return d; };\nR.boonStats = function () {\n  var out = {}, runs = R.allRuns();\n  for (var i = 0; i < runs.length; i++) {\n    var run = runs[i], seen = {};\n    for (var j = 0; j < run.screens.length; j++) {\n      var s = run.screens[j];\n      for (var k = 0; k < s.opts.length; k++) {\n        var nm = s.opts[k];\n        if (s.extra && s.took !== nm) continue;   // a second pick: the screen was counted once\n        var b = out[nm] || (out[nm] = { offered: 0, taken: 0, depths: [], last: 0 });\n        if (!s.extra) b.offered++;\n        if (s.t > b.last) b.last = s.t;\n        if (s.took === nm) { b.taken++; if (!seen[nm] && run !== R.run) { seen[nm] = 1; b.depths.push(R.depthOf(run)); } }\n      }\n    }\n  }\n  for (var n in out) if (out.hasOwnProperty(n)) out[n].reach = out[n].depths.length ? R.median(out[n].depths) : null;\n  return out;\n};\n// Every finished ripple at its depth: survived means no life lost there.\nR.ripplesAll = function (withLive) {\n  var out = [], runs = R.allRuns();\n  for (var i = 0; i < runs.length; i++) {\n    for (var j = 0; j < runs[i].ripples.length; j++) {\n      var c = runs[i].ripples[j];\n      if (c.t1 || withLive) out.push(c);\n    }\n  }\n  return out;\n};\nR.affixStats = function () {\n  var all = R.ripplesAll(false), byDepth = {}, out = {};\n  for (var i = 0; i < all.length; i++) {\n    var c = all[i], d = byDepth[c.n] || (byDepth[c.n] = { n: 0, ok: 0, dps: 0 });\n    d.n++; if (!c.lost) d.ok++; d.dps += R.dmgTotal(c) / R.secs(c);\n  }\n  for (var j = 0; j < all.length; j++) {\n    var cc = all[j];\n    for (var k = 0; k < (cc.aff || []).length; k++) {\n      var nm = cc.aff[k];\n      var a = out[nm] || (out[nm] = { seen: 0, ok: 0, first: 99, base: 0, dps: 0, bdps: 0, lost: 0 });\n      var bd = byDepth[cc.n];\n      a.seen++; if (!cc.lost) a.ok++; a.lost += cc.lost || 0;\n      if (cc.n < a.first) a.first = cc.n;\n      a.base += bd.ok / bd.n;\n      a.dps += R.dmgTotal(cc) / R.secs(cc);\n      a.bdps += bd.dps / bd.n;\n    }\n  }\n  for (var n in out) if (out.hasOwnProperty(n)) {\n    var o = out[n];\n    o.vs = Math.round((o.ok / o.seen - o.base / o.seen) * 100);\n    o.dpsPct = o.bdps > 0 ? Math.round((o.dps / o.bdps - 1) * 100) : 0;\n  }\n  return out;\n};\nR.best = function () {\n  var b = null;\n  for (var i = 0; i < R.runs.length; i++) {\n    var r = R.runs[i], d = R.depthOf(r), t = r.t1 - r.t0;\n    if (!b || d > b.d || (d === b.d && t < b.t)) b = { run: r, d: d, t: t };\n  }\n  return b;\n};\n\n// ---- The tab's clicks ------------------------------------------------------------\nif (!window.loomRipplesSx) window.loomRipplesSx = {};\nwindow.loomRipples = {\n  view: function (v) { var X = client.loom && client.loom.ripples; if (X) { X.view = v; run_function(\"ripples_render\", [], \"ripples\"); } },\n  rename: function (from) {\n    var X = client.loom && client.loom.ripples, to;\n    if (!X) return;\n    try { to = window.prompt(\"New name for \" + from + \" (empty: the default):\", from); } catch (e) { to = null; }\n    if (to === null || to === undefined) return;\n    to = String(to).trim();\n    if (X.rename(from, to)) X.say(to ? from + \" is now \" + to + \".\" : from + \" is back to its default name.\", \"lime\");\n  },\n  sort: function (k) { var X = client.loom && client.loom.ripples; if (X) { X.sort = k; run_function(\"ripples_render\", [], \"ripples\"); } },\n  keep: function (el) { try { window.loomRipplesSx[el.getAttribute(\"data-rp-sx\")] = el.scrollLeft; } catch (e) {} }\n};\n// Wide tables scroll sideways; a redraw puts each back where you left it.\nR.restoreScroll = function () {\n  try {\n    var els = document.querySelectorAll(\"[data-rp-sx]\");\n    for (var i = 0; i < els.length; i++) {\n      var v = window.loomRipplesSx[els[i].getAttribute(\"data-rp-sx\")];\n      if (v && els[i].scrollLeft !== v) els[i].scrollLeft = v;\n    }\n  } catch (e) {}\n};\n"
  },
  {
   "type": "function",
   "name": "ripples_render",
   "enabled": true,
   "code": "// ripples_render -- the Ripples tab: five views of your wades in the\n// Mnemosyne (Wade, Ripples, Boons, Affixes, Runs), in the house style of\n// Coffers and Stats: ink panel, serif small-caps headings, monospace rows.\n// The accent is the Mnemosyne's nacre teal. Wide tables scroll sideways, and\n// keep their place through redraws.\nif (!client.loom || !client.loom.ripples || !client.loom.ripples.line) run_function(\"ripples_setup\", [], \"ripples\");\nvar R = client.loom.ripples;\nvar TH = (client.loom && client.loom.theme) || {};\nvar ACC = TH.acc || \"#8fd0c4\";\nvar DEEP = TH.deep || \"#3f8f86\";\nvar EDGE = \"#3f6f6a\";\nvar GOLD = \"#e2bd5a\";\nvar AIM = \"#e0b45a\";\nvar TXT = TH.txt || \"#e2e8e4\";\nvar MUTED = TH.muted || \"#86918d\";\nvar DIM = \"#4f5a57\";\nvar RULE = TH.rule || \"#22302e\";\nvar TRACK = TH.track || \"#172120\";\nvar BG = TH.bg || \"#0d1213\";\nvar UP = \"#93cf8a\";\nvar DOWN = \"#de8a72\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nvar TYPES = { cutting: \"#de8a72\", blunt: \"#7fb2d6\", magical: \"#c9a0dc\", psychic: \"#e0b45a\", fire: \"#f0883e\", cold: \"#5bc0de\", poison: \"#93cf8a\", unblockable: \"#d8d8d8\", raw: \"#8c8c8c\", electricity: \"#f2d43d\", asphyxiation: \"#7f8fa6\" };\n\nfunction esc(s) { return String(s === undefined || s === null ? \"\" : s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\"); }\nfunction caps(t, c) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (c || DEEP) + ';font-size:11px;margin:0 0 3px;\">' + t + '</div>'; }\nfunction row(l, v, c, tip) { return '<div style=\"display:flex;justify-content:space-between;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"' + (tip ? ' title=\"' + esc(tip) + '\"' : '') + '><span style=\"color:' + MUTED + ';white-space:nowrap;\">' + l + '</span><span style=\"color:' + (c || TXT) + ';white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">' + v + '</span></div>'; }\nfunction box(inner) { return '<div style=\"flex:1 1 140px;min-width:140px;border-top:2px solid ' + EDGE + ';padding:3px 2px 0;\">' + inner + '</div>'; }\nfunction section(t, inner, first) { return '<div style=\"' + (first ? '' : 'border-top:1px solid ' + RULE + ';') + 'margin-top:8px;padding-top:5px;\">' + caps(t) + inner + '</div>'; }\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;margin-top:4px;\">' + t + '</div>'; }\nfunction note(t) { return '<div style=\"color:' + MUTED + ';margin-top:3px;\">' + t + '</div>'; }\nfunction bar(pct, col, h) { pct = Math.max(0, Math.min(100, pct)); return '<div style=\"background:' + TRACK + ';height:' + h + 'px;margin:2px 0;\"><div style=\"background:' + col + ';height:' + h + 'px;width:' + Math.round(pct * 10) / 10 + '%;\"></div></div>'; }\n// A table that scrolls sideways when the tab is narrow; key keeps its place.\nfunction scroller(key, inner) { return '<div data-rp-sx=\"' + key + '\" onscroll=\"window.loomRipples&&window.loomRipples.keep(this)\" style=\"overflow-x:auto;\">' + inner + '</div>'; }\nfunction th(t, left, tip) { return '<th style=\"padding:1px 4px;font-weight:normal;color:' + MUTED + ';text-align:' + (left ? 'left' : 'right') + ';white-space:nowrap;border-bottom:1px solid ' + RULE + ';\"' + (tip ? ' title=\"' + esc(tip) + '\"' : '') + '>' + t + '</th>'; }\nfunction td(t, c, left, tip) { return '<td style=\"padding:1px 4px;text-align:' + (left ? 'left' : 'right') + ';white-space:nowrap;border-bottom:1px dotted ' + RULE + ';color:' + (c || TXT) + ';\"' + (tip ? ' title=\"' + esc(tip) + '\"' : '') + '>' + t + '</td>'; }\nfunction table(head, rows) { return '<table style=\"border-collapse:collapse;width:100%;font-family:' + MONO + ';font-size:10px;\">' + '<tr>' + head + '</tr>' + rows + '</table>'; }\nfunction perH(v, secs) { return secs > 0 ? v / secs * 3600 : 0; }\nfunction pct(a, b) { return b > 0 ? Math.round(a / b * 100) : 0; }\nfunction survCol(p, n) { return n < 3 ? DIM : (p >= 80 ? UP : (p >= 50 ? AIM : DOWN)); }\nfunction topTypes(c) {\n  var tot = R.dmgTotal(c), out = [];\n  for (var k in c.dmg) if (c.dmg.hasOwnProperty(k)) out.push([k, c.dmg[k]]);\n  out.sort(function (a, b) { return b[1] - a[1]; });\n  return { tot: tot, list: out };\n}\nfunction dmgBar(c) {\n  var tt = topTypes(c);\n  if (!tt.tot) return quiet(\"No damage taken yet.\");\n  var segs = \"\", leg = \"\", other = 0;\n  for (var i = 0; i < tt.list.length; i++) {\n    var p = tt.list[i][1] / tt.tot * 100;\n    var col = TYPES[tt.list[i][0]] || \"#5a6663\";\n    if (i < 4 && p >= 3) {\n      segs += '<div style=\"width:' + Math.round(p * 10) / 10 + '%;background:' + col + ';\"></div>';\n      leg += '<span style=\"white-space:nowrap;\"><span style=\"color:' + col + ';\">&#9632;</span> ' + esc(tt.list[i][0]) + ' ' + Math.round(p) + '%</span>';\n    } else other += p;\n  }\n  if (other > 0) { segs += '<div style=\"width:' + Math.round(other * 10) / 10 + '%;background:#5a6663;\"></div>'; leg += '<span>other ' + Math.round(other) + '%</span>'; }\n  return '<div style=\"display:flex;height:8px;background:' + TRACK + ';\">' + segs + '</div><div style=\"display:flex;flex-wrap:wrap;gap:2px 12px;margin-top:3px;color:' + MUTED + ';\">' + leg + '</div>';\n}\nfunction dps(v, bare) {\n  var t = R.tone(v);\n  return '<span style=\"color:' + (t ? t.colour : DOWN) + ';\"' + (t ? ' title=\"' + esc(R.n(v) + \"/s taken, \" + t.word) + '\"' : '') + '>' + R.n(v) + (bare ? '' : '/s') + '</span>';\n}\nfunction hpCol(p) { return p === null || p === undefined ? MUTED : (p < 25 ? DOWN : (p < 50 ? AIM : TXT)); }\nfunction lowTxt(c) { return c && c.minHp !== null && c.minHp !== undefined ? '<span style=\"color:' + hpCol(c.minPct) + ';\">' + R.n(c.minHp) + ' &middot; ' + c.minPct + '%</span>' : '<span style=\"color:' + MUTED + ';\">&ndash;</span>'; }\nfunction hearts(n) {\n  if (n === null || n === undefined) return '<span style=\"color:' + DIM + ';\" title=\"lives: WADE STATUS not read yet\">&#9829; ?</span>';\n  var s = \"\";\n  for (var i = 0; i < Math.max(n, 3); i++) s += '<span style=\"color:' + (i < n ? DOWN : \"#2a3634\") + ';\">&#9829;</span>';\n  return '<span style=\"font-size:13px;letter-spacing:2px;\" title=\"' + n + ' lives left\">' + s + '</span>';\n}\n\nvar AF = R.affixStats();\nvar html = '<div id=\"loom-ripples\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + BG + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;min-height:100%;box-sizing:border-box;\">';\nvar glyph = '<svg width=\"18\" height=\"16\" viewBox=\"0 0 18 16\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M1 9 Q5 5 9 9 T17 9\" fill=\"none\" stroke=\"' + ACC + '\" stroke-width=\"1.3\"/><path d=\"M3 13 Q6 10.5 9 13 T15 13\" fill=\"none\" stroke=\"' + EDGE + '\" stroke-width=\"1.2\"/><circle cx=\"9\" cy=\"4\" r=\"2\" fill=\"#e8f1ee\"/></svg>';\nvar right;\nif (R.run) right = \"wading &middot; \" + R.dur(Date.now() - R.run.t0);\nelse if (R.ready) right = \"ready to wade\";\nelse if (R.runs.length) {\n  var lastEnd = R.runs[R.runs.length - 1].t1, wait = lastEnd + 600000 - Date.now();\n  right = wait > 0 ? \"next wade in ~\" + R.dur(wait) : \"ready to wade\";\n} else right = \"no wades yet\";\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + EDGE + ';padding-bottom:3px;\">';\nhtml += '<div style=\"font-family:' + SERIF + ';color:' + ACC + ';font-size:14px;letter-spacing:0.22em;\">' + glyph + 'MNEMOSYNE</div>';\nhtml += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + DEEP + ';font-size:11px;\">' + right + '</div></div>';\nvar VW = [[\"wade\", \"Wade\"], [\"ripples\", \"Ripples\"], [\"boons\", \"Boons\"], [\"affixes\", \"Affixes\"], [\"runs\", \"Runs\"]];\nhtml += '<div style=\"display:flex;flex-wrap:wrap;gap:4px 14px;margin:5px 0 0;border-bottom:1px solid ' + RULE + ';\">';\nfor (var vi = 0; vi < VW.length; vi++) {\n  var on = R.view === VW[vi][0];\n  html += '<span onclick=\"window.loomRipples&&window.loomRipples.view(\\'' + VW[vi][0] + '\\')\" style=\"cursor:pointer;user-select:none;font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;font-size:12px;padding:0 1px 2px;color:' + (on ? ACC : MUTED) + ';border-bottom:2px solid ' + (on ? DEEP : \"transparent\") + ';margin-bottom:-1px;\">' + VW[vi][1] + '</span>';\n}\nhtml += '</div>';\n\n// ---- Wade: the run under way ------------------------------------------------------\nif (R.view === \"wade\") {\n  var run = R.run;\n  if (!run) {\n    html += quiet(\"Not wading. The view fills itself when you next WADE MNEMOSYNE; the other views keep your past runs.\");\n    var b0 = R.best();\n    if (b0) html += section(\"Your best\", row(\"deepest\", \"ripple \" + b0.d) + row(\"in\", R.dur(b0.t)) + row(\"ended\", esc(b0.run.end || \"?\")));\n  } else {\n    var cur = R.cur();\n    var last = run.ripples.length ? run.ripples[run.ripples.length - 1] : null;\n    var shown = cur || last;\n    html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;margin:6px 0 0;\"><div>';\n    html += '<span style=\"font-family:' + SERIF + ';font-size:26px;color:' + ACC + ';\">' + (shown ? \"Ripple \" + shown.n : \"Entering\") + '</span> ';\n    html += '<span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">' + (shown ? esc(R.place(shown)) : \"choose a boon\") + (shown && !cur ? \" &middot; cleared\" : \"\") + '</span></div>' + hearts(run.lives) + '</div>';\n    if (cur) {\n      var bst = R.best();\n      var pace = \"\";\n      if (bst && bst.run !== run) {\n        var mine = 0, theirs = 0, ok = true;\n        for (var pi = 0; pi < run.ripples.length; pi++) {\n          var bx = null;\n          for (var pj = 0; pj < bst.run.ripples.length; pj++) if (bst.run.ripples[pj].n === run.ripples[pi].n) bx = bst.run.ripples[pj];\n          if (!bx) { ok = false; break; }\n          mine += R.secs(run.ripples[pi]); theirs += R.secs(bx);\n        }\n        if (ok) { var dd = Math.round(mine - theirs); pace = 'best pace <span style=\"color:' + (dd > 0 ? DOWN : UP) + ';\">' + (dd > 0 ? \"+\" : \"-\") + R.dur(Math.abs(dd) * 1000) + '</span>'; }\n      }\n      html += '<div style=\"display:flex;justify-content:space-between;color:' + MUTED + ';gap:8px;\"><span>objective: <span style=\"color:' + TXT + ';\">' + (cur.obj ? esc(cur.obj) : \"&hellip;\") + '</span></span><span style=\"white-space:nowrap;\">' + pace + '</span></div>';\n      html += bar(cur.wave || 0, ACC, 6);\n      var left = R.left(cur);\n      html += '<div style=\"display:flex;justify-content:space-between;color:' + MUTED + ';\"><span>' + (cur.wave !== null ? \"wave \" + cur.wave + \"%\" : \"wave ?\") + (left !== null ? ' &middot; <span style=\"color:' + TXT + ';\" title=\"guessed from the wave\\'s progress and your kills at the last WADE STATUS\">~' + left + ' left</span>' : \"\") + (cur.reward ? \" &middot; reward: \" + esc(cur.reward) : \"\") + '</span><span>' + (cur.lastPoll ? \"status \" + Math.max(0, Math.round((Date.now() - cur.lastPoll) / 1000)) + \"s ago\" : (R.poll ? \"\" : \"RIPPLES POLL is off\")) + '</span></div>';\n      if (cur.lvl !== null || cur.spd !== null) html += '<div style=\"color:' + MUTED + ';\">denizens <span style=\"color:' + TXT + ';\">+' + (cur.lvl || 0) + ' levels</span>, <span style=\"color:' + TXT + ';\">+' + (cur.spd || 0) + ' speed</span></div>';\n      if (cur.aff.length) {\n        html += '<div style=\"display:flex;flex-wrap:wrap;gap:4px;margin-top:5px;\">';\n        for (var ai = 0; ai < cur.aff.length; ai++) {\n          var an = cur.aff[ai], as = AF[an];\n          var ap = as ? pct(as.ok, as.seen) : null;\n          var tip = (R.codex.affixes[an] || \"\") + (as ? \" — seen \" + as.seen + \", survived \" + as.ok : \" — first time\");\n          html += '<span title=\"' + esc(tip) + '\" style=\"border:1px solid ' + (as && as.seen >= 3 && ap < 50 ? \"#8a4a3a\" : EDGE) + ';padding:1px 5px;white-space:nowrap;\">' + esc(an) + ' <span style=\"color:' + (as ? survCol(ap, as.seen) : ACC) + ';\">' + (as ? ap + \"%\" : \"new\") + '</span></span>';\n        }\n        html += '</div>';\n      }\n    } else if (run.screens.length && !run.screens[run.screens.length - 1].took) {\n      html += quiet(\"Between ripples: choose a boon (Boons shows what each did for you before).\");\n    }\n    var sec = shown ? R.secs(shown) : 0;\n    var rb = shown ? row(\"time\", R.dur(sec * 1000)) + row(\"kills\", shown.kills) + row(\"xp/h\", R.n(perH(shown.xp, sec)), GOLD) + row(\"gold/h\", R.n(perH(shown.gold, sec)), GOLD) + row(\"taken\", dps(R.dmgTotal(shown) / sec)) : quiet(\"&hellip;\");\n    var rt = { kills: 0, xp: 0, gold: 0, lost: 0, flees: 0, low: null };\n    for (var ri = 0; ri < run.ripples.length; ri++) {\n      var rr = run.ripples[ri]; rt.kills += rr.kills; rt.xp += rr.xp; rt.gold += rr.gold; rt.lost += rr.lost || 0; rt.flees += R.fleesIn(rr);\n      if (rr.minHp !== null && rr.minHp !== undefined && (!rt.low || rr.minHp < rt.low.minHp)) rt.low = rr;\n    }\n    var rs = (Date.now() - run.t0) / 1000;\n    var rbx = row(\"kills\", rt.kills) + row(\"xp\", R.n(rt.xp), GOLD) + row(\"xp/h\", R.n(perH(rt.xp, rs)), GOLD) + row(\"renown\", run.renown ? R.n(run.renown) : \"0\") + row(\"rerolls\", run.rerolls === null ? \"?\" : run.rerolls);\n    html += '<div style=\"display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;\">' + box(caps(cur ? \"This ripple\" : \"Last ripple\") + rb) + box(caps(\"This run\") + rbx) + '</div>';\n    if (shown) html += section(\"Incoming damage &middot; \" + (cur ? \"this\" : \"last\") + \" ripple\", dmgBar(shown));\n    // Boons claimed, beside the close calls.\n    var held = \"\";\n    for (var si = 0; si < run.screens.length; si++) {\n      var sc = run.screens[si];\n      if (!sc.took) continue;\n      var bd = R.codex.boons[sc.took];\n      held += row(esc(sc.took === \"?\" ? \"? (\" + sc.opts.length + \" offered)\" : sc.took), sc.after ? \"R\" + sc.after : \"in\", MUTED, bd && bd.d ? bd.d : (sc.took === \"?\" ? \"offered: \" + sc.opts.join(\", \") : \"\"));\n    }\n    var fl = R.hasFlees();\n    var close = row(\"lowest here\", lowTxt(shown), TXT, \"the lowest health in \" + (cur ? \"this\" : \"the last\") + \" ripple\") +\n      row(\"lowest in run\", rt.low ? lowTxt(rt.low) + ' <span style=\"color:' + MUTED + ';\">R' + rt.low.n + '</span>' : lowTxt(null), TXT) +\n      row(\"flees\", fl ? (shown ? R.fleesIn(shown) : 0) + ' <span style=\"color:' + MUTED + ';\">/ ' + rt.flees + ' run</span>' : '<span style=\"color:' + DIM + ';\">no basher</span>', TXT, fl ? \"the basher's flees, this ripple / this run\" : \"counted when the basher (and loom) are installed\") +\n      row(\"lives lost\", (shown ? shown.lost || 0 : 0) + ' <span style=\"color:' + MUTED + ';\">/ ' + rt.lost + ' run</span>', rt.lost ? DOWN : TXT);\n    html += '<div style=\"display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;\">' + box(caps(\"Boons claimed\") + (held || quiet(\"None yet.\"))) + box(caps(\"Close calls\") + close) + '</div>';\n    // Splits against the best run\n    var best = R.best();\n    if (run.ripples.length) {\n      var cells = \"\", maxS = 1;\n      for (var mi = 0; mi < run.ripples.length; mi++) maxS = Math.max(maxS, R.secs(run.ripples[mi]));\n      for (var ci = 0; ci < run.ripples.length; ci++) {\n        var rp = run.ripples[ci], s1 = R.secs(rp), hb = Math.max(3, Math.round(s1 / maxS * 18));\n        var bm = null;\n        if (best && best.run !== run) for (var bj = 0; bj < best.run.ripples.length; bj++) if (best.run.ripples[bj].n === rp.n) bm = best.run.ripples[bj];\n        var dlt = bm && rp.t1 ? Math.round(s1 - R.secs(bm)) : null;\n        var colr = !rp.t1 ? ACC : (rp.lost ? DOWN : \"#2c4a46\");\n        cells += '<div style=\"flex:1 1 0;min-width:30px;text-align:center;\" title=\"' + esc(R.place(rp)) + '\"><div style=\"height:18px;display:flex;align-items:flex-end;\"><div style=\"width:100%;height:' + hb + 'px;background:' + colr + ';\"></div></div>' + R.dur(s1 * 1000) + '<br><span style=\"color:' + (dlt === null ? MUTED : (dlt > 0 ? DOWN : UP)) + ';\">' + (!rp.t1 ? \"live\" : (dlt === null ? \"R\" + rp.n : (dlt > 0 ? \"+\" : \"-\") + R.dur(Math.abs(dlt) * 1000))) + '</span></div>';\n      }\n      html += section(\"Splits &middot; this run\" + (best && best.run !== run ? \" vs your best\" : \"\"), '<div style=\"display:flex;gap:3px;\">' + cells + '</div>' + note(\"one bar per ripple; orange: a life lost there\"));\n    }\n  }\n}\n\n// ---- Ripples: the last run, places, depths -----------------------------------------\nif (R.view === \"ripples\") {\n  var lr = R.run && R.run.ripples.length ? R.run : (R.runs.length ? R.runs[R.runs.length - 1] : null);\n  if (!lr) html += quiet(\"No ripples yet.\");\n  else {\n    var rows = \"\";\n    for (var li = 0; li < lr.ripples.length; li++) {\n      var c = lr.ripples[li], s2 = R.secs(c), tt = topTypes(c);\n      var top = tt.list.length ? tt.list[0][0] + \" \" + pct(tt.list[0][1], tt.tot) + \"%\" : \"-\";\n      rows += '<tr>' + td(c.n, (c.lost ? DOWN : TXT)) + td(esc(R.place(c)) + (c.reroll ? \" &#9733;\" : \"\"), TXT, true, c.intro) + td(R.dur(s2 * 1000)) + td(c.kills) + td(R.k(perH(c.xp, s2)), GOLD) + td(R.k(perH(c.gold, s2))) + td(dps(tt.tot / s2, true)) + td(c.minPct === null || c.minPct === undefined ? \"-\" : c.minPct + \"%\", hpCol(c.minPct), false, c.minHp !== null && c.minHp !== undefined ? \"lowest health \" + R.n(c.minHp) : \"\") + td(R.fleesIn(c) || \"-\", R.fleesIn(c) ? AIM : MUTED) + td(esc(top), MUTED, true) + td(c.lvl === null ? \"-\" : \"+\" + c.lvl, MUTED) + td(esc((c.aff || []).join(\", \") || \"-\"), MUTED, true) + '</tr>';\n    }\n    html += section((lr === R.run ? \"This run\" : \"Last run\") + \", ripple by ripple\", scroller(\"last\", table(th(\"#\") + th(\"place\", true) + th(\"time\") + th(\"kills\") + th(\"xp/h\") + th(\"gold/h\") + th(\"in/s\", false, \"damage taken per second, coloured as the Stats tab colours it\") + th(\"low\", false, \"lowest health in the ripple\") + th(\"fled\", false, \"the basher's flees\") + th(\"top dmg\", true) + th(\"lvl\", false, \"denizen levels added\") + th(\"affixes\", true), rows)) + note(\"&#9733; boss ripple (it gave a reroll) &middot; hover a place for the game's line\"), true);\n  }\n  // Places, every run\n  var PL = {}, allR = R.ripplesAll(true);\n  for (var ai2 = 0; ai2 < allR.length; ai2++) {\n    var cr = allR[ai2], key = R.place(cr), p = PL[key] || (PL[key] = { seen: 0, ok: 0, done: 0, xp: 0, s: 0, lo: 99, hi: 0 });\n    p.seen++; if (cr.t1) { p.done++; if (!cr.lost) p.ok++; } p.xp += cr.xp; p.s += R.secs(cr); if (cr.n < p.lo) p.lo = cr.n; if (cr.n > p.hi) p.hi = cr.n;\n  }\n  var pk = Object.keys(PL).sort(function (a, b) { return PL[b].seen - PL[a].seen; });\n  var pr = \"\";\n  for (var pq = 0; pq < pk.length; pq++) {\n    var pp = PL[pk[pq]], sp2 = pp.done ? pct(pp.ok, pp.done) : null;\n    pr += '<tr>' + td('<span onclick=\"window.loomRipples&&window.loomRipples.rename(\\'' + esc(pk[pq]).replace(/'/g, \"\\\\'\") + '\\')\" style=\"cursor:pointer;border-bottom:1px dotted ' + EDGE + ';\">' + esc(pk[pq]) + '</span>', TXT, true, \"click to rename\") + td(pp.lo === pp.hi ? pp.lo : pp.lo + \"&ndash;\" + pp.hi, MUTED) + td(pp.seen) + td(sp2 === null ? \"-\" : sp2 + \"%\", sp2 === null ? MUTED : survCol(sp2, pp.done)) + td(R.k(perH(pp.xp, pp.s)), GOLD) + '</tr>';\n  }\n  if (pr) html += section(\"Places &middot; every run\", scroller(\"places\", table(th(\"place\", true) + th(\"depths\") + th(\"seen\") + th(\"survived\", false, \"ripples finished without losing a life\") + th(\"xp/h\"), pr)) + note(\"Click a place to rename it, for every ripple there from now on (or RIPPLES NAME &lt;place&gt; = &lt;name&gt;).\"));\n  // By depth: median minutes and damage per second\n  var DP = {};\n  for (var dq = 0; dq < allR.length; dq++) {\n    var cd = allR[dq];\n    if (!cd.t1) continue;\n    var dd2 = DP[cd.n] || (DP[cd.n] = { m: [], d: [] });\n    dd2.m.push(R.secs(cd) / 60); dd2.d.push(R.dmgTotal(cd) / R.secs(cd));\n  }\n  var dk = Object.keys(DP).map(Number).sort(function (a, b) { return a - b; });\n  if (dk.length) {\n    var Wd = 380, Hd = 92, x0 = 26, y0 = 12, y1 = 76, mMax = 1, dMax = 1;\n    for (var dz = 0; dz < dk.length; dz++) { mMax = Math.max(mMax, R.median(DP[dk[dz]].m)); dMax = Math.max(dMax, R.median(DP[dk[dz]].d)); }\n    var bw = (Wd - x0 - 4) / dk.length, svg = '<svg viewBox=\"0 0 ' + Wd + ' ' + Hd + '\" width=\"100%\" style=\"display:block;height:auto;\" xmlns=\"http://www.w3.org/2000/svg\">';\n    svg += '<line x1=\"' + x0 + '\" y1=\"' + y1 + '\" x2=\"' + Wd + '\" y2=\"' + y1 + '\" stroke=\"' + EDGE + '\" stroke-width=\"0.8\"/><line x1=\"' + x0 + '\" y1=\"' + y0 + '\" x2=\"' + Wd + '\" y2=\"' + y0 + '\" stroke=\"' + RULE + '\" stroke-width=\"0.6\"/>';\n    svg += '<text x=\"' + (x0 - 3) + '\" y=\"' + (y0 + 3) + '\" text-anchor=\"end\" font-family=\"' + MONO + '\" font-size=\"8\" fill=\"' + MUTED + '\">' + Math.ceil(mMax) + 'm</text>';\n    var path = \"\";\n    for (var dx = 0; dx < dk.length; dx++) {\n      var md = R.median(DP[dk[dx]].m), mdps = R.median(DP[dk[dx]].d);\n      var bh = md / mMax * (y1 - y0), bx2 = x0 + dx * bw + bw * 0.18;\n      svg += '<rect x=\"' + Math.round(bx2) + '\" y=\"' + Math.round(y1 - bh) + '\" width=\"' + Math.round(bw * 0.64) + '\" height=\"' + Math.round(bh) + '\" fill=\"#2c4a46\"><title>ripple ' + dk[dx] + ': ' + Math.round(md * 10) / 10 + ' min, ' + Math.round(mdps) + '/s taken (' + DP[dk[dx]].m.length + ' seen)</title></rect>';\n      path += (dx ? \"L\" : \"M\") + Math.round(x0 + dx * bw + bw / 2) + \",\" + Math.round(y1 - mdps / dMax * (y1 - y0));\n      svg += '<text x=\"' + Math.round(x0 + dx * bw + bw / 2) + '\" y=\"' + (Hd - 3) + '\" text-anchor=\"middle\" font-family=\"' + MONO + '\" font-size=\"8\" fill=\"' + MUTED + '\">' + dk[dx] + '</text>';\n    }\n    svg += '<path d=\"' + path + '\" fill=\"none\" stroke=\"' + DOWN + '\" stroke-width=\"1.4\"/></svg>';\n    html += section(\"By depth &middot; every run\", svg + note('<span style=\"color:#2c4a46;\">&#9632;</span> median minutes &middot; <span style=\"color:' + DOWN + ';\">&#9632;</span> damage taken/s (median ' + R.n(dMax) + '/s at most)'));\n  }\n}\n\n// ---- Boons ---------------------------------------------------------------------------\nif (R.view === \"boons\") {\n  var BS = R.boonStats();\n  var live = R.run && R.run.screens.length ? R.run.screens[R.run.screens.length - 1] : null;\n  if (live && !live.took && live.opts.length) {\n    var off = \"\";\n    for (var oi = 0; oi < live.opts.length; oi++) {\n      var on2 = live.opts[oi], ob = BS[on2];\n      if (on2 === \"Restoration\") continue;\n      var hist = (!ob || ob.offered <= 1) ? '<span style=\"color:' + ACC + ';\">new &middot; never offered</span>' : 'taken ' + ob.taken + ' of ' + (ob.offered - 1) + (ob.reach !== null ? ' &middot; runs reach <span style=\"color:' + TXT + ';\">R' + ob.reach + '</span>' : '');\n      off += '<div title=\"' + esc((R.codex.boons[on2] || {}).d || \"\") + '\" style=\"display:flex;justify-content:space-between;gap:8px;border-bottom:1px dotted ' + RULE + ';padding:2px 0;\"><span>' + esc(on2) + (R.run.held.indexOf(on2) >= 0 ? ' <span style=\"color:' + MUTED + ';\">(held)</span>' : '') + '</span><span style=\"color:' + MUTED + ';white-space:nowrap;\">' + hist + '</span></div>';\n    }\n    html += '<div style=\"border:1px solid ' + EDGE + ';background:#111b1b;margin-top:7px;padding:5px 6px;\">' + caps(\"On offer now\", ACC) + off + '</div>';\n  }\n  var names = Object.keys(BS).filter(function (n) { return n !== \"Restoration\"; });\n  var S = R.sort;\n  names.sort(function (a, b) {\n    if (S === \"az\") return a < b ? -1 : 1;\n    if (S === \"offered\") return BS[b].offered - BS[a].offered || BS[b].taken - BS[a].taken;\n    if (S === \"reach\") return (BS[b].reach || 0) - (BS[a].reach || 0) || BS[b].taken - BS[a].taken;\n    return BS[b].taken - BS[a].taken || BS[b].offered - BS[a].offered;\n  });\n  var SO = [[\"taken\", \"taken\"], [\"offered\", \"offered\"], [\"reach\", \"depth\"], [\"az\", \"a&ndash;z\"]];\n  var sl = '<div style=\"display:flex;gap:12px;margin-top:7px;font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;font-size:11px;color:' + MUTED + ';\"><span>sort:</span>';\n  for (var so = 0; so < SO.length; so++) sl += '<span onclick=\"window.loomRipples&&window.loomRipples.sort(\\'' + SO[so][0] + '\\')\" style=\"cursor:pointer;user-select:none;color:' + (S === SO[so][0] ? ACC : MUTED) + ';\">' + SO[so][1] + '</span>';\n  html += sl + '</div>';\n  if (!names.length) html += quiet(\"No boons offered yet: they're noted from each boon screen you see.\");\n  else {\n    var br = \"\";\n    for (var bi = 0; bi < names.length; bi++) {\n      var bn = names[bi], b = BS[bn], cdx = R.codex.boons[bn] || {};\n      br += '<tr>' + td(esc(bn), b.taken ? TXT : MUTED, true, cdx.d) + td(b.offered) + td(b.taken) + td(b.offered - b.taken, MUTED) + td(b.reach === null ? \"&ndash;\" : b.reach, b.depths.length < 3 ? DIM : TXT, false, b.depths.length + \" finished runs held it\") + '</tr>';\n    }\n    html += section(\"Every boon offered\", scroller(\"boons\", table(th(\"boon\", true) + th(\"offered\") + th(\"taken\") + th(\"passed\") + th(\"reach\", false, \"median depth of finished runs that held it\"), br)) + note(\"reach is greyed under 3 runs. It shows how far runs went, not what the boon did: early picks ride along in every run.\"), true);\n    var takenOnce = 0;\n    for (var tq = 0; tq < names.length; tq++) if (BS[names[tq]].taken) takenOnce++;\n    html += section(\"Codex\", '<div style=\"display:flex;justify-content:space-between;color:' + MUTED + ';\"><span>met <span style=\"color:' + TXT + ';\">' + names.length + '</span> &middot; taken at least once <span style=\"color:' + TXT + ';\">' + takenOnce + '</span></span></div>' + bar(pct(takenOnce, names.length), ACC, 6));\n  }\n}\n\n// ---- Affixes -------------------------------------------------------------------------\nif (R.view === \"affixes\") {\n  var an2 = Object.keys(AF);\n  for (var ak in R.codex.affixes) if (R.codex.affixes.hasOwnProperty(ak) && an2.indexOf(ak) < 0) an2.push(ak);\n  an2.sort(function (a, b) { var A = AF[a], B = AF[b]; if (!A || !B) return A ? -1 : (B ? 1 : 0); var a3 = A.seen >= 3, b3 = B.seen >= 3; if (a3 !== b3) return a3 ? -1 : 1; return A.vs - B.vs; });\n  if (!an2.length) html += quiet(\"No affixes yet. They show from ripple 5, and are read from WADE STATUS (RIPPLES POLL asks it for you).\");\n  else {\n    var ar = \"\";\n    for (var aj = 0; aj < an2.length; aj++) {\n      var nm = an2[aj], a = AF[nm], few = !a || a.seen < 3;\n      var vs = a ? (a.vs > 0 ? \"&#9650; \" + a.vs : (a.vs < 0 ? \"&#9660; \" + (-a.vs) : \"0\")) : \"&ndash;\";\n      ar += '<tr>' + td(esc(nm), few ? MUTED : TXT, true, R.codex.affixes[nm]) + td(a ? a.seen : 0) + td(a ? \"R\" + a.first : \"&ndash;\", MUTED) + td(a ? a.ok + \"/\" + a.seen : \"&ndash;\") + td(few ? \"too few\" : vs, few ? DIM : (a.vs <= -10 ? DOWN : (a.vs >= 10 ? UP : MUTED))) + td(few ? \"&ndash;\" : (a.dpsPct > 0 ? \"+\" : \"\") + a.dpsPct + \"%\", few ? DIM : (a.dpsPct >= 10 ? DOWN : (a.dpsPct <= -10 ? UP : TXT))) + '</tr>';\n    }\n    html += section(\"Affixes, against the depth they came at\", scroller(\"affixes\", table(th(\"affix\", true) + th(\"seen\") + th(\"from\") + th(\"survived\") + th(\"vs depth\", false, \"points of survival above or below other ripples at the same depths\") + th(\"in/s\", false, \"damage taken per second against other ripples at the same depths\"), ar)) + note(\"vs depth compares with every ripple at the same depths, so a deep affix isn't blamed for the depth. Greyed under 3 sightings; hover a name for what it does.\"), true);\n  }\n}\n\n// ---- Runs ----------------------------------------------------------------------------\nif (R.view === \"runs\") {\n  var B = R.best();\n  if (!R.runs.length) html += quiet(\"No finished runs yet.\" + (R.run ? \" One is under way.\" : \"\"));\n  else {\n    html += '<div style=\"margin:6px 0 1px;\"><span style=\"font-family:' + SERIF + ';font-size:26px;color:' + ACC + ';\">Ripple ' + B.d + '</span> <span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">your deepest, ' + new Date(B.run.t0).toLocaleDateString(undefined, { day: \"numeric\", month: \"short\" }) + '</span></div>';\n    var depths = [], tw = 0, lost = 0, xp = 0, ren = 0;\n    for (var rq = 0; rq < R.runs.length; rq++) {\n      var ru = R.runs[rq];\n      depths.push(R.depthOf(ru)); tw += ru.t1 - ru.t0; ren += ru.renown || 0;\n      for (var rz = 0; rz < ru.ripples.length; rz++) { lost += ru.ripples[rz].lost || 0; xp += ru.ripples[rz].xp; }\n    }\n    html += '<div style=\"display:flex;flex-wrap:wrap;gap:10px;margin-top:7px;\">' + box(caps(\"All runs\") + row(\"runs\", R.runs.length) + row(\"median depth\", R.median(depths)) + row(\"time wading\", R.dur(tw)) + row(\"lives lost\", lost, lost ? DOWN : TXT)) + box(caps(\"Rewards\") + row(\"renown\", R.n(ren)) + row(\"renown/h\", R.n(perH(ren, tw / 1000))) + row(\"xp/h\", R.n(perH(xp, tw / 1000)), GOLD) + row(\"threads\", \"not read yet\", MUTED)) + '</div>';\n    // How far runs get: share reaching each depth\n    var maxD = 0;\n    for (var md2 = 0; md2 < depths.length; md2++) if (depths[md2] > maxD) maxD = depths[md2];\n    if (maxD > 0) {\n      var Wc = 380, Hc = 84, cx0 = 28, cy0 = 12, cy1 = 70, step = (Wc - cx0 - 4) / maxD, pth = \"\", wall = { n: 0, at: 0 };\n      for (var dn = 1; dn <= maxD; dn++) {\n        var reach = 0, endHere = 0;\n        for (var dr = 0; dr < depths.length; dr++) { if (depths[dr] >= dn) reach++; if (depths[dr] === dn) endHere++; }\n        var yy = cy1 - reach / depths.length * (cy1 - cy0);\n        pth += (dn === 1 ? \"M\" + cx0 + \",\" + Math.round(yy) : \"V\" + Math.round(yy)) + \"H\" + Math.round(cx0 + dn * step);\n        if (endHere > wall.n && dn < maxD) wall = { n: endHere, at: dn };\n      }\n      var sv = '<svg viewBox=\"0 0 ' + Wc + ' ' + Hc + '\" width=\"100%\" style=\"display:block;height:auto;\" xmlns=\"http://www.w3.org/2000/svg\">';\n      sv += '<line x1=\"' + cx0 + '\" y1=\"' + cy1 + '\" x2=\"' + Wc + '\" y2=\"' + cy1 + '\" stroke=\"' + EDGE + '\" stroke-width=\"0.8\"/><line x1=\"' + cx0 + '\" y1=\"' + cy0 + '\" x2=\"' + Wc + '\" y2=\"' + cy0 + '\" stroke=\"' + RULE + '\" stroke-width=\"0.6\"/>';\n      sv += '<text x=\"' + (cx0 - 3) + '\" y=\"' + (cy0 + 3) + '\" text-anchor=\"end\" font-family=\"' + MONO + '\" font-size=\"8\" fill=\"' + MUTED + '\">100%</text><text x=\"' + (cx0 - 3) + '\" y=\"' + (cy1 + 2) + '\" text-anchor=\"end\" font-family=\"' + MONO + '\" font-size=\"8\" fill=\"' + MUTED + '\">0</text>';\n      sv += '<path d=\"' + pth + 'V' + cy1 + 'H' + cx0 + 'Z\" fill=\"' + ACC + '\" fill-opacity=\"0.12\"/><path d=\"' + pth + '\" fill=\"none\" stroke=\"' + ACC + '\" stroke-width=\"1.5\"/>';\n      for (var dl = 1; dl <= maxD; dl++) sv += '<text x=\"' + Math.round(cx0 + (dl - 0.5) * step) + '\" y=\"' + (Hc - 3) + '\" text-anchor=\"middle\" font-family=\"' + MONO + '\" font-size=\"8\" fill=\"' + MUTED + '\">' + dl + '</text>';\n      sv += '</svg>';\n      html += section(\"How far runs get\", sv + (wall.n > 1 ? note(\"the wall: \" + wall.n + \" of \" + depths.length + \" runs ended at ripple \" + wall.at) : \"\"));\n    }\n    var rl = \"\";\n    for (var rk = R.runs.length - 1; rk >= 0 && rk >= R.runs.length - 15; rk--) {\n      var rn = R.runs[rk], lastRip = rn.ripples.length ? rn.ripples[rn.ripples.length - 1] : null;\n      var why = rn.end === \"died\" ? \"died\" + (rn.killer ? \" &middot; \" + esc(rn.killer) : \"\") : (rn.end === \"left\" ? \"left\" + (lastRip ? \" &middot; \" + esc(R.place(lastRip)) : \"\") : \"?\");\n      rl += '<tr>' + td(new Date(rn.t0).toLocaleDateString(undefined, { day: \"numeric\", month: \"short\" }), MUTED, true) + td(R.depthOf(rn), rn === B.run ? ACC : TXT) + td(R.dur(rn.t1 - rn.t0)) + td(rn.lives === null || rn.lives === undefined ? \"?\" : rn.lives) + td(R.n(rn.renown || 0)) + td(why, rn.end === \"died\" ? DOWN : MUTED, true) + '</tr>';\n    }\n    html += section(\"Runs\", scroller(\"runs\", table(th(\"date\", true) + th(\"depth\") + th(\"time\") + th(\"lives\") + th(\"renown\") + th(\"ended\", true), rl)));\n  }\n}\n\nhtml += '</div>';\ntry {\n  var rpSt = document.getElementById(\"loom-ripples-style\");\n  if (!rpSt) { rpSt = document.createElement(\"style\"); rpSt.id = \"loom-ripples-style\"; document.head.appendChild(rpSt); }\n  var rpCss = '.flexlayout__tab:has(#loom-ripples) { background: ' + BG + ' !important; } .flexlayout__tab:has(#loom-ripples) > * { min-height: 100%; }';\n  if (rpSt.textContent !== rpCss) rpSt.textContent = rpCss;\n} catch (e) {}\ntry { set_custom_tab_html(R.tab, html); } catch (e) {}\nR.restoreScroll();\nsetTimeout(R.restoreScroll, 20);\n"
  },
  {
   "type": "function",
   "name": "ripples_status",
   "enabled": true,
   "code": "// ripples_status -- the bare RIPPLES: the run under way, or the last one.\nif (!client.loom || !client.loom.ripples || !client.loom.ripples.line) run_function(\"ripples_setup\", [], \"ripples\");\nvar R = client.loom.ripples;\nif (R.run) {\n  var rsC = R.cur();\n  var rsL = R.run.ripples.length ? R.run.ripples[R.run.ripples.length - 1] : null;\n  R.say(\"wading for \" + R.dur(Date.now() - R.run.t0) + \": \" + (rsC ? \"ripple \" + rsC.n + \" (\" + R.place(rsC) + \")\" + (rsC.wave !== null ? \", wave \" + rsC.wave + \"%\" : \"\") : (rsL ? \"ripple \" + rsL.n + \" cleared, choosing a boon\" : \"choosing your first boon\")) + \", lives \" + (R.run.lives === null ? \"?\" : R.run.lives) + \", renown \" + R.n(R.run.renown) + \".\", \"cyan\");\n  if (rsC && rsC.aff.length) R.say(\"affixes: \" + rsC.aff.join(\", \") + \".\", \"cyan\");\n} else if (R.runs.length) {\n  var rsR = R.runs[R.runs.length - 1], rsB = R.best();\n  R.say(\"not wading. Last run: ripple \" + R.depthOf(rsR) + \" in \" + R.dur(rsR.t1 - rsR.t0) + \" (\" + (rsR.end || \"?\") + \"). Deepest: ripple \" + rsB.d + \". \" + R.runs.length + \" runs kept.\", \"cyan\");\n} else {\n  R.say(\"not wading, and no runs yet. Wade the Mnemosyne and the Ripples tab fills itself.\", \"cyan\");\n}\nR.say(\"WADE STATUS is asked \" + (R.poll ? \"every \" + R.poll + \"s in a ripple (RIPPLES POLL)\" : \"never: POLL is OFF\") + \". RIPPLES HELP for commands.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "ripples_help",
   "enabled": true,
   "code": "// ripples_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[ripples] your wades in the Mnemosyne, ripple by ripple, in the Ripples tab. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"RIPPLES\", \"status: the run under way, or the last one\"],\n  [\"RIPPLES VIEW <view>\", \"WADE, RIPPLES, BOONS, AFFIXES or RUNS in the tab (or click them)\"],\n  [\"RIPPLES POLL <seconds>|OFF\", \"how often WADE STATUS is asked quietly in a ripple (default 30)\"],\n  [\"RIPPLES NAME <name>|DEFAULT\", \"name the place of this ripple (or the last one)\"],\n  [\"RIPPLES NAME <place> = <name>\", \"rename any place, for every ripple there (or click it in Ripples)\"],\n  [\"RIPPLES TOOK <boon>\", \"set the last boon claimed, when it couldn't tell\"],\n  [\"RIPPLES END [DIED]\", \"close the run under way by hand\"],\n  [\"RIPPLES WIPE\", \"forget every run, boon and affix (CONFIRM)\"],\n  [\"RIPPLES RESET\", \"clear what it's reading, reload runs from saved variables\"],\n  [\"RIPPLES DEBUG\", \"internal state\"],\n  [\"Create a UI tab named 'Ripples'. While you wade it asks WADE STATUS after GO!, after kills and every POLL seconds, and BOON CLAIMED after each claim, and hides only those answers. It sends nothing while Loom is paused.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "trigger",
   "name": "ripples every line",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Every line: the work is in ripples_setup's R.line (#136: this runs on every game line, so it stays short).\nif (!client.loom || !client.loom.ripples || !client.loom.ripples.line) run_function(\"ripples_setup\", [], \"ripples\");\nif (client.loom.ripples.line(args[0])) gag_current_line();\n"
    }
   ],
   "text": "^(.*)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// RIPPLES [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.ripples || !client.loom.ripples.line) run_function(\"ripples_setup\", [], \"ripples\");\nvar R = client.loom.ripples;\nvar rpRaw = String(args[1] || \"\").trim();\nvar rpA = rpRaw.toLowerCase().split(/\\s+/);\nvar rpRest = rpRaw.replace(/^\\S+\\s*/, \"\");\nif (rpA[0] === \"\" || rpA[0] === \"status\") {\n  run_function(\"ripples_status\", [], \"ripples\");\n} else if (rpA[0] === \"help\") {\n  run_function(\"ripples_help\", [], \"ripples\");\n} else if (rpA[0] === \"poll\" && rpA[1] === \"off\") {\n  R.poll = 0;\n  set_variable(\"ripples_poll\", \"off\");\n  R.say(\"POLL OFF: WADE STATUS is read only when you type it (no wave progress, lives or affixes otherwise).\", \"lime\");\n} else if (rpA[0] === \"poll\" && /^\\d+$/.test(rpA[1] || \"\") && parseInt(rpA[1], 10) >= 10) {\n  R.poll = parseInt(rpA[1], 10);\n  set_variable(\"ripples_poll\", String(R.poll));\n  R.due = Math.min(R.due, Date.now() + R.poll * 1000);\n  R.say(\"POLL \" + R.poll + \": WADE STATUS is asked quietly every \" + R.poll + \"s in a ripple, after GO! and after kills.\", \"lime\");\n} else if (rpA[0] === \"poll\") {\n  R.say(\"RIPPLES POLL <seconds, 10 or more>|OFF (now \" + (R.poll ? R.poll + \"s\" : \"OFF\") + \").\", \"orange\");\n} else if (rpA[0] === \"view\" && /^(wade|ripples|boons|affixes|runs)$/.test(rpA[1] || \"\")) {\n  R.view = rpA[1];\n  run_function(\"ripples_render\", [], \"ripples\");\n} else if (rpA[0] === \"view\") {\n  R.say(\"RIPPLES VIEW WADE|RIPPLES|BOONS|AFFIXES|RUNS.\", \"orange\");\n} else if (rpA[0] === \"name\" && rpRest.indexOf(\"=\") > 0) {\n  // NAME <place as shown> = <new name>|DEFAULT: any place, for good.\n  var rpFrom = rpRest.slice(0, rpRest.indexOf(\"=\")).trim(), rpTo = rpRest.slice(rpRest.indexOf(\"=\") + 1).trim();\n  if (/^default$/i.test(rpTo)) rpTo = \"\";\n  var rpN = rpFrom ? R.rename(rpFrom, rpTo) : 0;\n  if (!rpN) R.say(\"no place shown as '\" + rpFrom + \"'. The Ripples view lists them (click one to rename it).\", \"orange\");\n  else R.say(rpTo ? rpFrom + \" is now \" + rpTo + \".\" : rpFrom + \" is back to its default name.\", \"lime\");\n} else if (rpA[0] === \"name\") {\n  // Names the place of the ripple you're in, or the last one.\n  var rpSrc = R.run && R.run.ripples.length ? R.run : (R.runs.length ? R.runs[R.runs.length - 1] : null);\n  var rpRip = rpSrc && rpSrc.ripples.length ? rpSrc.ripples[rpSrc.ripples.length - 1] : null;\n  if (!rpRip || !rpRip.intro) R.say(\"no ripple with a place line to name yet.\", \"orange\");\n  else if (!rpRest) R.say(\"RIPPLES NAME <name>: names \\\"\" + rpRip.intro + \"\\\" (now \" + R.place(rpRip) + \").\", \"orange\");\n  else if (rpA[1] === \"default\") { delete R.names[rpRip.intro]; set_variable(\"ripples_names\", JSON.stringify(R.names)); R.say(\"that place is \" + R.place(rpRip) + \" again.\", \"lime\"); run_function(\"ripples_render\", [], \"ripples\"); }\n  else { R.names[rpRip.intro] = rpRest.slice(0, 40); set_variable(\"ripples_names\", JSON.stringify(R.names)); R.say(\"that place is now \" + R.names[rpRip.intro] + \".\", \"lime\"); run_function(\"ripples_render\", [], \"ripples\"); }\n} else if (rpA[0] === \"took\") {\n  // Sets the boon of the last claim it couldn't tell.\n  var rpS = null;\n  if (R.run) for (var rpI = R.run.screens.length - 1; rpI >= 0; rpI--) if (R.run.screens[rpI].took) { rpS = R.run.screens[rpI]; break; }\n  var rpPick = \"\";\n  if (rpS) for (var rpJ = 0; rpJ < rpS.opts.length; rpJ++) if (rpS.opts[rpJ].toLowerCase() === rpRest.toLowerCase()) rpPick = rpS.opts[rpJ];\n  if (!rpS) R.say(\"no claim in this run to set.\", \"orange\");\n  else if (!rpPick) R.say(\"the last screen offered: \" + rpS.opts.join(\", \") + \". RIPPLES TOOK <one of them>.\", \"orange\");\n  else {\n    if (rpS.took && rpS.took !== \"?\" && rpS.took !== rpPick) { var rpH = R.run.held.indexOf(rpS.took); if (rpH >= 0) R.run.held.splice(rpH, 1); }\n    rpS.took = rpPick;\n    if (rpPick !== \"Restoration\" && R.run.held.indexOf(rpPick) < 0) R.run.held.push(rpPick);\n    R.save();\n    R.say(\"last claim: \" + rpPick + \".\", \"lime\");\n    run_function(\"ripples_render\", [], \"ripples\");\n  }\n} else if (rpA[0] === \"end\") {\n  if (!R.run) R.say(\"no run under way.\", \"orange\");\n  else R.endRun(rpA[1] === \"died\" ? \"died\" : \"left\");\n} else if (rpA[0] === \"wipe\") {\n  if (rpA[rpA.length - 1] !== \"confirm\") R.say(\"WIPE forgets \" + R.runs.length + \" runs, every boon and affix seen, and the run under way. RIPPLES WIPE CONFIRM to do it.\", \"orange\");\n  else {\n    R.runs = []; R.run = null; R.codex = { boons: {}, affixes: {} }; R.cap = null; R.ccap = null; R.scr = null;\n    R.saveAll();\n    R.say(\"wiped.\", \"lime\");\n    run_function(\"ripples_render\", [], \"ripples\");\n  }\n} else if (rpA[0] === \"reset\") {\n  R.save();\n  R.cap = null; R.ccap = null; R.scr = null; R.count = null; R.intro = \"\"; R.asked = 0; R.due = 0;\n  R.runs = null; R.run = undefined; R.codex = null; R.names = null;\n  run_function(\"ripples_setup\", [], \"ripples\");\n  R.say(\"reset: captures cleared, runs and codex reloaded from saved variables.\", \"lime\");\n  run_function(\"ripples_render\", [], \"ripples\");\n} else if (rpA[0] === \"debug\") {\n  var rpC = R.cur();\n  R.say(\"run=\" + (R.run ? \"open, \" + R.run.ripples.length + \" ripples, \" + R.run.screens.length + \" screens, lives \" + R.run.lives : \"none\") + \" cur=\" + (rpC ? JSON.stringify(rpC) : \"-\") + \" cap=\" + (R.cap ? JSON.stringify(R.cap) : \"-\") + \" ccap=\" + (R.ccap ? R.ccap.text.length + \" lines\" : \"-\") + \" scr=\" + (R.scr ? JSON.stringify(R.scr) : \"-\") + \" count=\" + R.count + \" poll=\" + R.poll + \" due in \" + Math.round((R.due - Date.now()) / 1000) + \"s runs=\" + R.runs.length + \" boons=\" + Object.keys(R.codex.boons).length + \" affixes=\" + Object.keys(R.codex.affixes).length, \"cyan\");\n} else {\n  R.say(\"unknown command '\" + rpA[0] + \"'. RIPPLES HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^ripples(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  }
 ]
}