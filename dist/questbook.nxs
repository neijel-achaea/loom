{
 "type": "group",
 "name": "questbook",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"questbook_setup\", [], \"questbook\");\nrun_function(\"questbook_render\", [], \"questbook\");\ndisplay_notice(\"[questbook] installed. Create a UI tab named 'Quests'; QUESTBOOK NEW <name> starts writing a quest down. QUESTBOOK HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// The quests_* variables are left intact; the tab's minute clock stops.\nif (client.loom && client.loom.questbook && client.loom.questbook.clock) { clearInterval(client.loom.questbook.clock); client.loom.questbook.clock = null; }\n// Leave LOOM and the integrations at once, not at the next load (#137).\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"questbook\");\n  else delete client.loom.registry.questbook;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it. A scroll.\nvar tiTabs = [[\"Quests\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\"><path d=\"M4 2.5 H12.5 V12.5 Q12.5 14 11 14 H3.5\" fill=\"#c8bfae\" stroke=\"#7a5f33\" stroke-width=\"0.8\"/><path d=\"M4 2.5 Q2.5 2.5 2.5 4 Q2.5 5.2 4 5.2 V12.5 Q4 14 3.5 14 Q2 14 2 12.6\" fill=\"none\" stroke=\"#7a5f33\" stroke-width=\"0.8\"/><path d=\"M6 6 H10.5 M6 8 H10.5 M6 10 H9\" stroke=\"#7a5f33\" stroke-width=\"0.8\" stroke-linecap=\"round\"/><circle cx=\"11\" cy=\"12.3\" r=\"1.3\" fill=\"#e0b46c\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\nrun_function(\"questbook_setup\", [], \"questbook\");\nrun_function(\"questbook_render\", [], \"questbook\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Questbook follows the room itself: arriving ticks a GO step.\nif (!client.loom || !client.loom.questbook || !client.loom.questbook.list) run_function(\"questbook_setup\", [], \"questbook\");\nvar QU = client.loom.questbook;\nvar quG = (args.gmcp_args && typeof args.gmcp_args == \"object\") ? args.gmcp_args : {};\nvar quM = args.gmcp_method;\nif (quM == \"Room.Info\") {\n  var quWas = QU.here ? QU.here.id : \"\";\n  QU.here = quG.num ? { id: String(quG.num), name: QU.roomName(quG.name), area: String(quG.area || \"\") } : null;\n  if (QU.here && QU.here.id !== quWas) { QU.onArrive(); run_function(\"questbook_render\", [], \"questbook\"); }\n}\n"
  },
  {
   "type": "function",
   "name": "questbook_setup",
   "enabled": true,
   "code": "// questbook_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Questing Companion (#376): quests you write down\n// yourself as lists of steps, which then walk you through them every time\n// you do them again. A guide, never a bot: a step can be one click (walk\n// there, send the line), but nothing runs by itself.\n//\n// Step 1 (Ricardo, 2026-10-26): the list and following a quest, with steps\n// added by command (recording as you play was dropped, Ricardo 2026-10-31).\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.questbook) client.loom.questbook = {};\nclient.loom.registry.questbook = { version: \"0.5.2\", keyword: \"QUESTBOOK\", desc: \"Your own repeatable quests as steps in a tab, ticked as you play\",\n  redraw: function () { run_function(\"questbook_render\", [], \"questbook\"); } };\nvar QU = client.loom.questbook;\n\n// Saved (per character, as every Nexus variable):\n//   questbook_list   = [{ id, name, area, repeat, at, rewards: { renown, xp, gold,\n//                     items: [] }, steps: [{ k, … }] }], the quests as written;\n//   questbook_state  = { id: { step, started, kills, last, done } }: where you\n//                   are in each, when it was last done and how often;\n//   questbook_folded = [area, …], the areas folded in the tab;\n//   questbook_filter = \"ready\" | \"waiting\" (absent: all);\n//   questbook_midnight = \"hh:mm\", the game's midnight on your own clock, when\n//                   monthly quests reset (absent: 02:00, Ricardo's);\n//   questbook_year   = when an Achaean year began (ms), learnt from the game's\n//                   date line, so yearly quests reset on 1st Sarapin.\n// A variable that isn't readable starts afresh (#135).\nQU.read = function (name, arr) {\n  var v = get_variable(name);\n  if (typeof v == \"string\") { try { v = JSON.parse(v); } catch (e) { v = null; } }\n  if (arr) return Array.isArray(v) ? v : [];\n  return (v && typeof v == \"object\" && !Array.isArray(v)) ? v : {};\n};\n\n// Step kinds: what a step holds and when it ticks (the issue's table).\n//   go    { room, name, area }        you arrive (click: PATH FIND)\n//   do    { cmd }                     any command (GREET, ASK, GIVE, PULL…):\n//                                     its button sends it, and that ticks it\n//   kill  { what, n }                 that many \"You have slain …\" lines\n//   note  { text }                    by hand\n// Steps saved by 0.1–0.3 as greet/talk/ask/say/get/buy/give/drop become\n// commands when read (Ricardo: one kind, so every one has a button).\nQU.repeats = [\"none\", \"daily\", \"monthly\", \"yearly\"];\nQU.kinds = [\"go\", \"do\", \"kill\", \"note\"];\nQU.cleanStep = function (s) {\n  if (!s || typeof s != \"object\") return null;\n  var k = String(s.k), o = { k: k };\n  // Older kinds, read as the command they stood for.\n  if (k === \"greet\" && String(s.who || \"\").trim()) return { k: \"do\", cmd: \"greet \" + String(s.who).trim() };\n  if ((k === \"talk\" || k === \"ask\" || k === \"say\") && String(s.cmd || \"\").trim()) {\n    var c = String(s.cmd).trim();\n    return { k: \"do\", cmd: c.toLowerCase().indexOf(k + \" \") === 0 ? c : k + \" \" + c };\n  }\n  if ((k === \"get\" || k === \"buy\" || k === \"give\" || k === \"drop\") && String(s.what || s.cmd || \"\").trim()) {\n    return { k: \"do\", cmd: String(s.cmd || \"\").trim() || k + \" \" + String(s.what).trim() };\n  }\n  if (QU.kinds.indexOf(k) < 0) return null;\n  if (k === \"go\") {\n    if (!/^\\d+$/.test(String(s.room || \"\"))) return null;\n    o.room = String(s.room); o.name = String(s.name || \"\"); o.area = String(s.area || \"\");\n  } else if (k === \"do\") {\n    if (!String(s.cmd || \"\").trim()) return null;\n    o.cmd = String(s.cmd).trim();\n  } else if (k === \"kill\") {\n    if (!String(s.what || \"\").trim()) return null;\n    o.what = String(s.what).trim(); o.n = Math.max(1, Math.min(99, Math.floor(Number(s.n) || 1)));\n  } else {\n    if (!String(s.text || \"\").trim()) return null;\n    o.text = String(s.text).trim();\n  }\n  return o;\n};\n\nQU.list = [];\nvar quRaw = QU.read(\"questbook_list\", true);\nfor (var quI = 0; quI < quRaw.length; quI++) {\n  var quE = quRaw[quI];\n  if (!quE || typeof quE != \"object\" || !/^\\d+$/.test(String(quE.id || \"\")) || !String(quE.name || \"\").trim()) continue;\n  var quSt = [];\n  if (Array.isArray(quE.steps)) for (var quJ = 0; quJ < quE.steps.length; quJ++) { var quS = QU.cleanStep(quE.steps[quJ]); if (quS) quSt.push(quS); }\n  var quR = (quE.rewards && typeof quE.rewards == \"object\") ? quE.rewards : {};\n  var quItems = [];\n  if (Array.isArray(quR.items)) for (var quK = 0; quK < quR.items.length; quK++) if (String(quR.items[quK] || \"\").trim()) quItems.push(String(quR.items[quK]).trim());\n  QU.list.push({ id: String(quE.id), name: String(quE.name).trim(), area: String(quE.area || \"\"),\n    repeat: QU.repeats.indexOf(quE.repeat) >= 0 ? quE.repeat : \"daily\", at: Number(quE.at) || 0,\n    rewards: { renown: Math.max(0, Math.floor(Number(quR.renown) || 0)), xp: Math.max(0, Math.floor(Number(quR.xp) || 0)), gold: Math.max(0, Math.floor(Number(quR.gold) || 0)), items: quItems },\n    steps: quSt });\n}\nQU.state = {};\nvar quStRaw = QU.read(\"questbook_state\", false);\nfor (var quId in quStRaw) {\n  if (!quStRaw.hasOwnProperty(quId) || !/^\\d+$/.test(quId)) continue;\n  var quX = quStRaw[quId];\n  if (!quX || typeof quX != \"object\") continue;\n  QU.state[quId] = { step: Math.max(0, Math.floor(Number(quX.step) || 0)), started: Number(quX.started) || 0,\n    kills: Math.max(0, Math.floor(Number(quX.kills) || 0)), last: Number(quX.last) || 0, done: Math.max(0, Math.floor(Number(quX.done) || 0)) };\n}\nQU.folded = {};\nvar quF = QU.read(\"questbook_folded\", true);\nfor (var quL = 0; quL < quF.length; quL++) if (typeof quF[quL] == \"string\") QU.folded[quF[quL]] = true;\nvar quFl = get_variable(\"questbook_filter\");\nQU.filter = (quFl === \"ready\" || quFl === \"waiting\") ? quFl : \"all\";\nQU.midnight = /^([01]\\d|2[0-3]):[0-5]\\d$/.test(String(get_variable(\"questbook_midnight\") || \"\")) ? String(get_variable(\"questbook_midnight\")) : \"02:00\";\nQU.year = Number(get_variable(\"questbook_year\")) || 0;\n// Runtime only: the room you're in, your inventory (id -> name), the quest\n// shown in the tab (open), the one being followed (ticks go to it), and\n// steps struck through while editing.\nif (QU.here === undefined) QU.here = null;\nif (QU.open === undefined) QU.open = null;\nif (QU.follow === undefined) QU.follow = null;\nQU.edit = false;\nQU.struck = {};\n\nQU.save = function () {\n  if (QU.list.length) set_variable(\"questbook_list\", JSON.stringify(QU.list)); else delete_variable(\"questbook_list\");\n  QU.saveState();\n};\nQU.saveState = function () {\n  var out = {}, any = false;\n  for (var i = 0; i < QU.list.length; i++) {\n    var s = QU.state[QU.list[i].id];\n    if (s && (s.step || s.started || s.kills || s.last || s.done)) { out[QU.list[i].id] = s; any = true; }\n  }\n  if (any) set_variable(\"questbook_state\", JSON.stringify(out)); else delete_variable(\"questbook_state\");\n  if (client.loom.notify) client.loom.notify(\"questbook\");\n  run_function(\"questbook_render\", [], \"questbook\");\n};\nQU.saveFolded = function () {\n  var out = [];\n  for (var a in QU.folded) if (QU.folded.hasOwnProperty(a) && QU.folded[a]) out.push(a);\n  if (out.length) set_variable(\"questbook_folded\", JSON.stringify(out)); else delete_variable(\"questbook_folded\");\n};\nQU.st = function (q) {\n  if (!QU.state[q.id]) QU.state[q.id] = { step: 0, started: 0, kills: 0, last: 0, done: 0 };\n  return QU.state[q.id];\n};\nQU.byId = function (id) {\n  for (var i = 0; i < QU.list.length; i++) if (QU.list[i].id === String(id)) return QU.list[i];\n  return null;\n};\nQU.byName = function (name) {\n  var n = String(name || \"\").trim().toLowerCase();\n  for (var i = 0; i < QU.list.length; i++) if (QU.list[i].name.toLowerCase() === n) return QU.list[i];\n  return null;\n};\n// A quest by its name or its number.\nQU.find = function (q) {\n  q = String(q || \"\").trim();\n  return (/^\\d+$/.test(q) && QU.byId(q)) || QU.byName(q);\n};\nQU.nextId = function () {\n  var n = 0;\n  for (var i = 0; i < QU.list.length; i++) n = Math.max(n, Number(QU.list[i].id) || 0);\n  return String(n + 1);\n};\nQU.roomName = function (n) { return String(n || \"\").replace(/\\s*\\((?:indoors|outdoors)\\)\\s*$/i, \"\"); };\nQU.times = function (n) { return n === 1 ? \"once\" : (n === 2 ? \"twice\" : n + \" times\"); };\nQU.say = function (text, colour) { display_notice(\"[questbook] \" + text, colour || \"cyan\"); };\n\n// --- Repeats --------------------------------------------------------------\n// In Achaean time (Ricardo): an Achaean day is a real hour, a month a real day\n// and a year 12 real days. Each resets at a set moment:\n//   daily    at the top of every hour;\n//   monthly  every day at the game's midnight (QU.midnight on your clock);\n//   yearly   on 1st Sarapin: every 12 days from QU.year, the start of a year\n//            learnt from the game's date line (until then, 12 days after you\n//            last did it);\n//   none     done once, never again.\nQU.hourMs = 3600000;\nQU.dayMs = 24 * QU.hourMs;\nQU.yearMs = 12 * QU.dayMs;\n// The latest monthly reset (the game's midnight) at or before now.\nQU.lastMidnight = function (now) {\n  var hm = QU.midnight.split(\":\"), d = new Date(now);\n  d.setHours(Number(hm[0]), Number(hm[1]), 0, 0);\n  if (d.getTime() > now) d.setDate(d.getDate() - 1);\n  return d.getTime();\n};\n// A moment n calendar days later, at the same time on the clock.\nQU.addDays = function (t, n) { var d = new Date(t); d.setDate(d.getDate() + n); return d.getTime(); };\n// The latest reset of a repeat at or before now (0: none known).\nQU.lastReset = function (repeat, now) {\n  if (repeat === \"daily\") { var d = new Date(now); d.setMinutes(0, 0, 0); return d.getTime(); }\n  if (repeat === \"monthly\") return QU.lastMidnight(now);\n  if (repeat === \"yearly\" && QU.year) {\n    // Whole calendar days, so a clock change doesn't shift the reset an hour.\n    var days = Math.round((QU.lastMidnight(now) - QU.year) / QU.dayMs);\n    return QU.addDays(QU.year, Math.floor(days / 12) * 12);\n  }\n  return 0;\n};\nQU.nextReset = function (repeat, now) {\n  if (repeat === \"daily\") return QU.lastReset(repeat, now) + QU.hourMs;\n  if (repeat === \"monthly\") return QU.addDays(QU.lastMidnight(now), 1);\n  if (repeat === \"yearly\" && QU.year) return QU.addDays(QU.lastReset(repeat, now), 12);\n  return 0;\n};\n// The game's date line (\"Today is the 5th of Valnuary, …\", or the new day's\n// \"It is now the …\"): the month began at the last midnight, so the year\n// began that many days before it.\nQU.months = [\"sarapin\", \"daedalan\", \"aeguary\", \"miraman\", \"scarlatan\", \"ero\", \"valnuary\", \"lupar\", \"phaestian\", \"chronos\", \"glacian\", \"mayan\"];\nQU.seeDate = function (month) {\n  var m = QU.months.indexOf(String(month || \"\").toLowerCase());\n  if (m < 0) return;\n  var start = QU.addDays(QU.lastMidnight(Date.now()), -m);\n  if (start === QU.year) return;\n  QU.year = start;\n  set_variable(\"questbook_year\", String(start));\n  run_function(\"questbook_render\", [], \"questbook\");\n};\n// When a quest is ready again (0 = now: never done, or its reset has passed\n// since); Infinity for a quest that doesn't repeat, once done.\nQU.readyAt = function (q) {\n  var s = QU.state[q.id], last = s ? s.last : 0;\n  if (!last) return 0;\n  if (q.repeat === \"none\") return Infinity;\n  var now = Date.now();\n  if (q.repeat === \"yearly\" && !QU.year) { var after = QU.addDays(last, 12); return after > now ? after : 0; }\n  return last < QU.lastReset(q.repeat, now) ? 0 : QU.nextReset(q.repeat, now);\n};\n// \"going\" (in progress), \"ready\", \"waiting\" or \"done\" (doesn't repeat).\nQU.status = function (q) {\n  var s = QU.state[q.id];\n  if (s && (s.step > 0 || s.started) && s.step < q.steps.length) return \"going\";\n  var r = QU.readyAt(q);\n  return r === Infinity ? \"done\" : (r ? \"waiting\" : \"ready\");\n};\nQU.repeatText = function (r) { return r === \"none\" ? \"once\" : r; };\nQU.span = function (ms) {\n  var m = Math.max(1, Math.ceil(ms / 60000));\n  if (m < 60) return m + \" MIN\";\n  var h = Math.round(m / 60);\n  if (h < 48) return h + \" H\";\n  return Math.round(h / 24) + \" D\";\n};\nQU.ago = function (t) {\n  if (!t) return \"never\";\n  var now = new Date(Date.now()), then = new Date(t);\n  var day = function (d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime(); };\n  var dd = Math.round((day(now) - day(then)) / 86400000);\n  if (dd <= 0) return \"today\";\n  if (dd === 1) return \"yesterday\";\n  return dd + \" days ago\";\n};\nQU.rewardText = function (q) {\n  var r = q.rewards, out = [];\n  if (r.renown) out.push(\"renown \" + r.renown);\n  if (r.xp) out.push(r.xp.toLocaleString() + \" xp\");\n  if (r.gold) out.push(r.gold.toLocaleString() + \" gold\");\n  for (var i = 0; i < r.items.length; i++) out.push(r.items[i]);\n  return out;\n};\n\n// --- Steps ----------------------------------------------------------------\n// What a step does, in a few words (HELP's verbs, for notices and the tab).\nQU.stepWhat = function (s) {\n  if (s.k === \"go\") return s.name || (\"room \" + s.room);\n  if (s.k === \"do\") return s.cmd;\n  if (s.k === \"kill\") return (s.n > 1 ? s.n + \" × \" : \"\") + s.what;\n  if (s.k === \"note\") return s.text;\n  return s.what;\n};\n// The command a step's button sends, if it has one.\nQU.stepCmd = function (s) {\n  if (s.k === \"go\") return \"path find \" + s.room;\n  if (s.cmd) return s.cmd;\n  return \"\";\n};\n// The name of a step's room when it's a waypoint (link waypoints-questbook).\nQU.waypoint = function (id) {\n  var L = client.loom.loom;\n  var w = (L && L.answer) ? L.answer(\"questbook\", \"questbook.waypoint\", { id: String(id) }) : undefined;\n  return (w && w.name) ? w : undefined;\n};\n// A step from what's typed after STEP (or STEP EDIT <n> / INSERT <n>):\n//   GO [room number]                  this room (or that number)\n//   KILL [count] <mob>\n//   NOTE <text>\n//   any other command, as typed       GREET miller, GIVE sack to miller, PULL lever\n//   DO <command>                      a command starting with a step word\n// `was`: the step being edited (a GO to the same room keeps its name).\n// -> { step } or { err }.\nQU.parseStep = function (text, was) {\n  text = String(text || \"\").trim();\n  var sp = text.search(/\\s/);\n  var k = (sp < 0 ? text : text.substring(0, sp)).toLowerCase();\n  var rest = sp < 0 ? \"\" : text.substring(sp).trim();\n  if (!text) return { err: \"QUESTBOOK STEP <any command> | GO [room] | KILL [count] <mob> | NOTE <text> | DO <command> (also STEP EDIT <n> …, STEP INSERT <n> …, STEP REMOVE <n>).\" };\n  if (k === \"go\") {\n    if (rest && !/^\\d+$/.test(rest)) return { err: \"QUESTBOOK STEP GO [room number]: no number saves the room you're in (DO go north for the game's GO).\" };\n    if (!rest) {\n      if (!QU.here || !QU.here.id) return { err: \"no room yet: move or LOOK first (or give the room's number).\" };\n      return { step: { k: \"go\", room: QU.here.id, name: QU.here.name, area: QU.here.area } };\n    }\n    if (QU.here && QU.here.id === rest) return { step: { k: \"go\", room: rest, name: QU.here.name, area: QU.here.area } };\n    if (was && was.k === \"go\" && was.room === rest) return { step: { k: \"go\", room: rest, name: was.name, area: was.area } };\n    var w = QU.waypoint(rest);\n    return { step: { k: \"go\", room: rest, name: w ? w.name : \"\", area: \"\" } };\n  }\n  if (k === \"do\") {\n    if (!rest) return { err: \"QUESTBOOK STEP DO <command>, for a command that starts with a step word (DO kill rat).\" };\n    return { step: { k: \"do\", cmd: rest } };\n  }\n  if (k === \"kill\") {\n    var m = /^(?:(\\d+)\\s+)?(.+)$/.exec(rest);\n    if (!m) return { err: \"QUESTBOOK STEP KILL [count] <mob>.\" };\n    return { step: { k: \"kill\", n: Number(m[1] || 1), what: m[2] } };\n  }\n  if (k === \"note\") {\n    if (!rest) return { err: \"QUESTBOOK STEP NOTE <text>.\" };\n    return { step: { k: \"note\", text: rest } };\n  }\n  // Anything else is a command, sent as typed (Ricardo: GREET, GIVE, PULL,\n  // TURN, PUT… without a list of kinds, and every one with its button).\n  return { step: { k: \"do\", cmd: text } };\n};\n// A step written back as it would be typed (✎ in EDIT STEPS puts it in the\n// input line after STEP EDIT <n>).\n// Words STEP reads as a kind (or EDIT/INSERT/REMOVE): a command starting with\n// one of these needs DO in front.\nQU.stepWords = [\"go\", \"do\", \"kill\", \"note\", \"edit\", \"insert\", \"remove\", \"del\"];\nQU.stepSpec = function (s) {\n  if (s.k === \"go\") return \"GO \" + s.room;\n  if (s.k === \"do\") return (QU.stepWords.indexOf(s.cmd.split(/\\s+/)[0].toLowerCase()) >= 0 ? \"DO \" : \"\") + s.cmd;\n  if (s.k === \"kill\") return \"KILL \" + (s.n > 1 ? s.n + \" \" : \"\") + s.what;\n  return \"NOTE \" + s.text;\n};\n// Replace step i (edit), or put a new one before it (insert). Where you are\n// in the quest stays on the same step.\nQU.putStep = function (q, i, s, insert) {\n  s = QU.cleanStep(s);\n  if (!s) return false;\n  var st = QU.state[q.id];\n  if (insert) { q.steps.splice(i, 0, s); if (st && st.step > i) st.step++; }\n  else { q.steps[i] = s; if (st && st.step === i) st.kills = 0; }\n  QU.save();\n  QU.say(q.name + \": step \" + (i + 1) + (insert ? \" inserted: \" : \" is now \") + s.k.toUpperCase() + \" \" + QU.stepWhat(s) + \".\", \"lime\");\n  return true;\n};\n// What a repeat means, for notices.\nQU.repeatWhen = function (r) {\n  if (r === \"daily\") return \"an Achaean day: at the top of every hour\";\n  if (r === \"monthly\") return \"an Achaean month: every day at the game's midnight, \" + QU.midnight + \" on your clock\";\n  if (r === \"yearly\") return \"an Achaean year: every 12 days, on 1st Sarapin\" + (QU.year ? \"\" : \"; type DATE once so Questbook knows when that is\");\n  return \"once\";\n};\nQU.addStep = function (q, s) {\n  s = QU.cleanStep(s);\n  if (!s) return false;\n  q.steps.push(s);\n  QU.save();\n  QU.say(q.name + \": step \" + q.steps.length + \" \" + s.k.toUpperCase() + \" \" + QU.stepWhat(s) + \".\", \"lime\");\n  return true;\n};\nQU.removeStep = function (q, i) {\n  var s = q.steps.splice(i, 1)[0];\n  var st = QU.state[q.id];\n  if (st && st.step > i) st.step--;\n  if (st && st.step === i) st.kills = 0;\n  QU.save();\n  QU.say(q.name + \": removed step \" + (i + 1) + \" \" + s.k.toUpperCase() + \" \" + QU.stepWhat(s) + \".\", \"lime\");\n};\n\n// --- Following ------------------------------------------------------------\n// Open a quest in the tab; one you can do now is followed: its steps tick as\n// you play. A waiting quest is only shown, and so is one you're writing\n// (QUESTBOOK NEW): adding GO steps where you stand mustn't tick them. START\n// OVER or FOLLOW THIS follows it.\nQU.openQuest = function (q, writing) {\n  QU.open = q ? q.id : null;\n  QU.edit = false; QU.struck = {};\n  if (q && !writing && q.steps.length && (QU.status(q) === \"ready\" || QU.status(q) === \"going\")) QU.follow = q.id;\n  QU.check();\n  run_function(\"questbook_render\", [], \"questbook\");\n};\nQU.followed = function () { return QU.follow ? QU.byId(QU.follow) : null; };\nQU.current = function (q) {\n  var s = QU.state[q.id], i = s ? s.step : 0;\n  return i < q.steps.length ? q.steps[i] : null;\n};\n// The current step of the followed quest is done: on to the next, and the\n// quest is done after its last.\nQU.tick = function (why) {\n  var q = QU.followed();\n  if (!q) return;\n  var st = QU.st(q), s = q.steps[st.step];\n  if (!s) return;\n  if (!st.started) st.started = Date.now();\n  st.step++; st.kills = 0;\n  if (st.step >= q.steps.length) { QU.finish(q); return; }\n  QU.say(q.name + \": \" + (why ? why + \". \" : \"\") + \"Step \" + (st.step + 1) + \" of \" + q.steps.length + \": \" + q.steps[st.step].k.toUpperCase() + \" \" + QU.stepWhat(q.steps[st.step]) + \".\", \"lime\");\n  QU.saveState();\n  QU.check();\n};\nQU.finish = function (q) {\n  var st = QU.st(q);\n  st.step = 0; st.started = 0; st.kills = 0; st.last = Date.now(); st.done++;\n  if (QU.follow === q.id) QU.follow = null;\n  var ra = QU.readyAt(q);\n  QU.say(q.name + \" done (\" + QU.times(st.done) + \").\" + (ra === Infinity ? \" It doesn't repeat.\" : (ra ? \" Again in \" + QU.span(ra - Date.now()).toLowerCase() + \".\" : \"\")), \"lime\");\n  QU.saveState();\n};\nQU.back = function (q) {\n  var st = QU.st(q);\n  if (st.step > 0) { st.step--; st.kills = 0; QU.saveState(); return true; }\n  return false;\n};\nQU.restart = function (q) {\n  var st = QU.st(q);\n  st.step = 0; st.started = 0; st.kills = 0;\n  QU.follow = q.id;\n  QU.saveState();\n};\n// Jump to a step (a click on its number): the steps before it count as done.\nQU.jump = function (q, i) {\n  if (i < 0 || i >= q.steps.length) return;\n  var st = QU.st(q);\n  st.step = i; st.kills = 0;\n  if (!st.started && i > 0) st.started = Date.now();\n  QU.follow = q.id;\n  QU.saveState();\n  QU.check();\n};\n// A GO step whose room you're already in ticks at once (after any tick, an\n// added step or opening the quest, and on every arrival).\nQU.check = function () {\n  for (var guard = 0; guard < 50; guard++) {\n    var q = QU.followed();\n    if (!q) return;\n    var s = QU.current(q);\n    if (!s || s.k !== \"go\" || !QU.here || QU.here.id !== s.room) return;\n    QU.tick(\"You're at \" + (s.name || s.room));\n  }\n};\n// The current step's button: walk, or send its line (which ticks it).\nQU.act = function () {\n  var q = QU.followed();\n  if (!q) return;\n  var s = QU.current(q);\n  if (!s) return;\n  if (s.k === \"note\" || s.k === \"kill\") { QU.tick(\"Ticked by hand\"); return; }\n  if (get_variable(\"pauseTriggers\") == \"on\") { QU.say(\"Loom is paused (LOOM PAUSE OFF to send).\", \"orange\"); return; }\n  var cmd = QU.stepCmd(s);\n  if (s.k === \"go\" && QU.here && QU.here.id === s.room) { QU.check(); return; }\n  // A command goes through your aliases (and the command separator), as if\n  // typed (Ricardo); PATH FIND skips them, so nothing can turn a walk into\n  // something else.\n  send_command(cmd, s.k === \"go\" ? 1 : 0);\n  if (s.k === \"do\") QU.tick(\"Sent\");\n  else if (s.k === \"go\") QU.say(\"walking to \" + (s.name || s.room) + \" (\" + s.room + \").\", \"cyan\");\n};\n\n// Game events, for the followed quest's current step.\nQU.onArrive = function () { QU.check(); };\nQU.norm = function (t) { return String(t || \"\").toLowerCase().replace(/\\s+/g, \" \").trim(); };\n// A slain mob matches a KILL step when its name holds the step's words.\nQU.itemMatch = function (name, what) {\n  var n = QU.norm(name), w = QU.norm(what);\n  return !!w && n.indexOf(w) >= 0;\n};\nQU.onSlain = function (what) {\n  var q = QU.followed(), s = q && QU.current(q);\n  if (!s || s.k !== \"kill\" || !QU.itemMatch(what, s.what)) return;\n  var st = QU.st(q);\n  st.kills++;\n  if (st.kills >= s.n) { QU.tick(\"Killed \" + s.n); return; }\n  if (!st.started) st.started = Date.now();\n  QU.say(q.name + \": \" + st.kills + \" of \" + s.n + \" \" + s.what + \".\", \"lime\");\n  QU.saveState();\n};\n\n// --- Backup: one quest as a code ------------------------------------------\n// A backup tool (Ricardo, 2026-10-27): EXPORT turns one quest into a short\n// code, IMPORT adds a quest from one. Who gets a code and what they do with\n// it is up to them, so every import ends with a warning to check its steps.\n// The code: \"QB1\", \"z\" (compressed) or \"p\" (plain), then base64url of the\n// payload and a 4-byte checksum of it. Letters, digits, - and _ only, so\n// quotes, accents, | and line breaks inside the quest can't break it; the\n// checksum catches a code cut short or mangled on the way.\n// The payload is the quest written small (QU.pack): { n name, a area, r\n// repeat (absent: daily), w rewards { r, x, g, i }, s steps }, a step as\n// \"a command\" | [\"g\", room, name, area if not the quest's] | [\"k\", mob, n]\n// | [\"n\", text]. Progress, record, folds and filters never travel.\nQU.codeVersion = 1;\nQU.capSteps = 200; QU.capText = 300; QU.capName = 80; QU.capItems = 20;\nQU.pack = function (q) {\n  var o = { n: q.name };\n  if (q.area) o.a = q.area;\n  if (q.repeat !== \"daily\") o.r = q.repeat.charAt(0);\n  var r = q.rewards, w = {};\n  if (r.renown) w.r = r.renown;\n  if (r.xp) w.x = r.xp;\n  if (r.gold) w.g = r.gold;\n  if (r.items.length) w.i = r.items.slice();\n  for (var k in w) if (w.hasOwnProperty(k)) { o.w = w; break; }\n  o.s = [];\n  for (var i = 0; i < q.steps.length; i++) {\n    var s = q.steps[i];\n    if (s.k === \"do\") o.s.push(s.cmd);\n    else if (s.k === \"go\") {\n      var g = [\"g\", Number(s.room)];\n      if (s.name || s.area !== q.area) g.push(s.name || \"\");\n      if (s.area !== q.area) g.push(s.area || \"\");\n      o.s.push(g);\n    }\n    else if (s.k === \"kill\") o.s.push(s.n > 1 ? [\"k\", s.what, s.n] : [\"k\", s.what]);\n    else o.s.push([\"n\", s.text]);\n  }\n  return o;\n};\n// The payload back into a quest, through the same checks as a saved one,\n// with lengths capped. -> { q } or { err }.\nQU.unpack = function (o) {\n  if (!o || typeof o != \"object\" || Array.isArray(o)) return { err: \"the code holds no quest.\" };\n  var cut = function (v, n) { return String(v == null ? \"\" : v).replace(/[\\r\\n\\t]+/g, \" \").trim().substring(0, n); };\n  var name = cut(o.n, QU.capName);\n  if (!name) return { err: \"the quest in the code has no name.\" };\n  var area = cut(o.a, QU.capName);\n  var rep = { d: \"daily\", m: \"monthly\", y: \"yearly\", n: \"none\" }[String(o.r || \"d\")] || \"daily\";\n  var w = (o.w && typeof o.w == \"object\") ? o.w : {}, items = [];\n  if (Array.isArray(w.i)) for (var i = 0; i < w.i.length && items.length < QU.capItems; i++) { var it = cut(w.i[i], QU.capName); if (it) items.push(it); }\n  var num = function (v) { return Math.max(0, Math.min(1e9, Math.floor(Number(v) || 0))); };\n  if (!Array.isArray(o.s)) return { err: \"the quest in the code has no steps.\" };\n  if (o.s.length > QU.capSteps) return { err: \"the quest in the code has more than \" + QU.capSteps + \" steps.\" };\n  var steps = [], dropped = 0;\n  for (var j = 0; j < o.s.length; j++) {\n    var e = o.s[j], s = null;\n    if (typeof e == \"string\") s = { k: \"do\", cmd: cut(e, QU.capText) };\n    else if (Array.isArray(e) && e[0] === \"g\") s = { k: \"go\", room: String(Math.floor(Number(e[1]) || 0) || \"\"), name: cut(e[2], QU.capName), area: e.length > 3 ? cut(e[3], QU.capName) : area };\n    else if (Array.isArray(e) && e[0] === \"k\") s = { k: \"kill\", what: cut(e[1], QU.capText), n: e[2] };\n    else if (Array.isArray(e) && e[0] === \"n\") s = { k: \"note\", text: cut(e[1], QU.capText) };\n    s = QU.cleanStep(s);\n    if (s) steps.push(s); else dropped++;\n  }\n  return { dropped: dropped, q: { name: name, area: area, repeat: rep,\n    rewards: { renown: num(w.r), xp: num(w.x), gold: num(w.g), items: items }, steps: steps } };\n};\nQU.b64 = function (bytes) {\n  var bin = \"\";\n  for (var i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);\n  return btoa(bin).replace(/\\+/g, \"-\").replace(/\\//g, \"_\").replace(/=+$/, \"\");\n};\nQU.unb64 = function (t) {\n  var b = t.replace(/-/g, \"+\").replace(/_/g, \"/\");\n  while (b.length % 4) b += \"=\";\n  var bin = atob(b), out = new Uint8Array(bin.length);\n  for (var i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);\n  return out;\n};\n// FNV-1a, 32 bits, as 4 bytes.\nQU.sum = function (bytes) {\n  var h = 0x811c9dc5;\n  for (var i = 0; i < bytes.length; i++) { h ^= bytes[i]; h = Math.imul(h, 0x01000193) >>> 0; }\n  return [h >>> 24, (h >>> 16) & 255, (h >>> 8) & 255, h & 255];\n};\n// The browser's own deflate (CompressionStream), when it has one.\nQU.canZip = function () {\n  try { new CompressionStream(\"deflate-raw\"); new DecompressionStream(\"deflate-raw\"); return typeof Response == \"function\" && typeof Blob == \"function\"; }\n  catch (e) { return false; }\n};\nQU.zip = function (bytes, undo) {\n  var st = undo ? new DecompressionStream(\"deflate-raw\") : new CompressionStream(\"deflate-raw\");\n  return new Response(new Blob([bytes]).stream().pipeThrough(st)).arrayBuffer().then(function (b) { return new Uint8Array(b); });\n};\n// A quest -> Promise of its code (the shorter of compressed and plain).\nQU.encode = function (q) {\n  var plain = new TextEncoder().encode(JSON.stringify(QU.pack(q)));\n  var finish = function (mode, body) {\n    var all = new Uint8Array(body.length + 4);\n    all.set(body); all.set(QU.sum(body), body.length);\n    return \"QB\" + QU.codeVersion + mode + QU.b64(all);\n  };\n  if (!QU.canZip()) return Promise.resolve(finish(\"p\", plain));\n  return QU.zip(plain).then(function (z) { return z.length < plain.length ? finish(\"z\", z) : finish(\"p\", plain); },\n    function () { return finish(\"p\", plain); });\n};\n// A code -> Promise of { q, dropped } or { err }. Spaces and line breaks\n// inside it (a wrapped paste) are ignored.\nQU.decode = function (text) {\n  var t = String(text || \"\").replace(/\\s+/g, \"\");\n  var m = /^QB(\\d+)([zp])([A-Za-z0-9_-]+)$/.exec(t);\n  if (!m) return Promise.resolve({ err: /^QB\\d/.test(t) ? \"that code has characters a quest code never has: copy it again.\" : \"that isn't a quest code (they start with QB1).\" });\n  if (Number(m[1]) > QU.codeVersion) return Promise.resolve({ err: \"that code was made by a newer Questbook: update questbook first.\" });\n  var all;\n  try { all = QU.unb64(m[3]); } catch (e) { all = null; }\n  if (!all || all.length < 5) return Promise.resolve({ err: \"that code is cut short: copy all of it.\" });\n  var body = all.subarray(0, all.length - 4), sum = QU.sum(body);\n  for (var i = 0; i < 4; i++) if (all[all.length - 4 + i] !== sum[i]) return Promise.resolve({ err: \"that code is incomplete or changed on the way: copy all of it again (or use IMPORT in the Quests tab, if your command separator is - or _).\" });\n  var read = function (bytes) {\n    var o;\n    try { o = JSON.parse(new TextDecoder().decode(bytes)); } catch (e) { return { err: \"the code's quest can't be read.\" }; }\n    return QU.unpack(o);\n  };\n  if (m[2] === \"p\") return Promise.resolve(read(body));\n  if (!QU.canZip()) return Promise.resolve({ err: \"this browser can't unpack compressed codes.\" });\n  return QU.zip(body, true).then(read, function () { return { err: \"the code's quest can't be unpacked.\" }; });\n};\n// EXPORT: the code as a line you select with one click, and on the clipboard\n// when the browser allows it.\nQU.exportQuest = function (q) {\n  return QU.encode(q).then(function (code) {\n    QU.lastCode = code;\n    QU.say(\"backup of \" + q.name + \" (\" + q.steps.length + (q.steps.length === 1 ? \" step\" : \" steps\") + \", \" + code.length + \" characters). QUESTBOOK IMPORT <code> adds it back, here or on another character:\", \"cyan\");\n    var hasHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\n    if (hasHtml) nexusclient.add_html_line('<span title=\"click once to select all of it\" style=\"font-family:\\'Courier New\\',monospace;color:#e0b46c;word-break:break-all;user-select:all;-webkit-user-select:all;cursor:text;\">' + code + '</span>');\n    else display_notice(code, \"#e0b46c\");\n    var copied = function () { QU.say(\"copied to your clipboard.\", \"lime\"); };\n    var noCopy = function () { QU.say(\"not copied (the browser didn't allow it): click the code once to select it, then copy it.\", \"cyan\"); };\n    try {\n      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(code).then(copied, noCopy);\n      else noCopy();\n    } catch (e) { noCopy(); }\n    return code;\n  }, function () { QU.say(\"couldn't make a code for \" + q.name + \".\", \"orange\"); });\n};\n// IMPORT: added at once as a new quest (Ricardo), opened in the tab without\n// following it, with a warning to check its steps before sending them.\nQU.importCode = function (text) {\n  return QU.decode(text).then(function (r) {\n    if (r.err) { QU.say(\"not imported: \" + r.err, \"orange\"); return null; }\n    var q = r.q, base = q.name, n = 2;\n    while (QU.byName(q.name)) q.name = base + \" \" + (n++);\n    q.id = QU.nextId(); q.at = Date.now();\n    if (!q.area && QU.here && QU.here.area) q.area = QU.here.area;\n    QU.list.push(q);\n    QU.save();\n    QU.openQuest(q, true);\n    var cmds = 0;\n    for (var i = 0; i < q.steps.length; i++) if (q.steps[i].k === \"do\") cmds++;\n    QU.say(\"imported \" + q.name + \" (\" + q.id + (q.area ? \", \" + q.area : \"\") + \", \" + q.steps.length + (q.steps.length === 1 ? \" step\" : \" steps\") +\n      (base !== q.name ? \"; \" + base + \" was taken\" : \"\") + (r.dropped ? \"; \" + r.dropped + \" unreadable step\" + (r.dropped === 1 ? \"\" : \"s\") + \" left out\" : \"\") + \"). It's open in the Quests tab, not followed.\", \"lime\");\n    QU.say(\"Be mindful: a quest from a code may not be what it says. Read every step before you click it\" + (cmds ? \": its \" + cmds + \" command step\" + (cmds === 1 ? \" is\" : \"s are\") + \" sent exactly as written, through your aliases\" : \"\") + \". EDIT STEPS fixes or drops any you don't want.\", \"orange\");\n    return q;\n  }, function () { QU.say(\"not imported: the code couldn't be read.\", \"orange\"); return null; });\n};\n\n// --- Tab helpers ----------------------------------------------------------\nQU.setFilter = function (f) {\n  QU.filter = (f === \"ready\" || f === \"waiting\") ? f : \"all\";\n  if (QU.filter === \"all\") delete_variable(\"questbook_filter\"); else set_variable(\"questbook_filter\", QU.filter);\n  run_function(\"questbook_render\", [], \"questbook\");\n};\nQU.fold = function (area) {\n  QU.folded[area] = !QU.folded[area];\n  QU.saveFolded();\n  run_function(\"questbook_render\", [], \"questbook\");\n};\n// EDIT STEPS: × strikes a step through (click again brings it back); DONE\n// EDITING drops the struck steps.\nQU.editDone = function () {\n  var q = QU.open ? QU.byId(QU.open) : null;\n  if (q) {\n    var idx = [];\n    for (var k in QU.struck) if (QU.struck.hasOwnProperty(k) && QU.struck[k]) idx.push(Number(k));\n    idx.sort(function (a, b) { return b - a; });\n    for (var i = 0; i < idx.length; i++) if (idx[i] < q.steps.length) QU.removeStep(q, idx[i]);\n  }\n  QU.edit = false; QU.struck = {};\n  run_function(\"questbook_render\", [], \"questbook\");\n};\n\n// The read-only look other packages see through loom: never its variables.\n//   look.quest(id) -> { name, area, status, step, steps } or undefined;\n//   look.following() -> the followed quest's { id, name, step, steps, kind }.\nQU.look = {\n  quest: function (id) {\n    var q = QU.byId(id);\n    if (!q) return undefined;\n    var s = QU.state[q.id];\n    return { name: q.name, area: q.area, status: QU.status(q), step: s ? s.step : 0, steps: q.steps.length };\n  },\n  following: function () {\n    var q = QU.followed();\n    if (!q) return undefined;\n    var c = QU.current(q);\n    return { id: q.id, name: q.name, step: QU.st(q).step, steps: q.steps.length, kind: c ? c.k : \"\" };\n  }\n};\n\n// The tab's clicks. Its page shares window with the scripts but can't reach\n// client.loom in every Nexus, so these closures carry them.\ntry {\n  window.loomQuestbook = {\n    open: function (id) { var Q = client.loom.questbook; Q.openQuest(id ? Q.byId(id) : null); },\n    filter: function (f) { client.loom.questbook.setFilter(f); },\n    fold: function (i) { var Q = client.loom.questbook, g = Q.areasDrawn || []; if (g[i] !== undefined) Q.fold(g[i]); },\n    act: function () { client.loom.questbook.act(); },\n    next: function () { client.loom.questbook.tick(\"Ticked by hand\"); },\n    jump: function (i) { var Q = client.loom.questbook, q = Q.open ? Q.byId(Q.open) : null; if (q && !Q.edit) Q.jump(q, i); },\n    restart: function () { var Q = client.loom.questbook, q = Q.open ? Q.byId(Q.open) : null; if (q) { Q.restart(q); Q.say(q.name + \": started over.\", \"lime\"); Q.check(); } },\n    follow: function () { var Q = client.loom.questbook, q = Q.open ? Q.byId(Q.open) : null; if (q) { Q.follow = q.id; Q.check(); run_function(\"questbook_render\", [], \"questbook\"); } },\n    edit: function () { var Q = client.loom.questbook; if (Q.edit) Q.editDone(); else { Q.edit = true; Q.struck = {}; run_function(\"questbook_render\", [], \"questbook\"); } },\n    // ✎: \"questbook step edit <n> <the step as typed>\" into the input line,\n    // to fix and send (Nexus's input is a React field, so the value goes in\n    // through the native setter and an input event, as comms does).\n    pen: function (i) {\n      var Q = client.loom.questbook, q = Q.open ? Q.byId(Q.open) : null;\n      if (!q || !q.steps[i]) return;\n      window.loomQuestbook.put(\"questbook step edit \" + (i + 1) + \" \" + Q.stepSpec(q.steps[i]));\n    },\n    // + NEW: \"questbook new \" into the input line, for the quest's name.\n    newAsk: function () { window.loomQuestbook.put(\"questbook new \"); },\n    put: function (v) {\n      var inp = window.loomQuestbook.input();\n      if (!inp) { client.loom.questbook.say(\"couldn't find the input line. Type: \" + v, \"orange\"); return; }\n      try {\n        var desc = Object.getOwnPropertyDescriptor(Object.getPrototypeOf(inp), \"value\");\n        if (desc && desc.set) desc.set.call(inp, v); else inp.value = v;\n      } catch (e) { inp.value = v; }\n      try { inp.dispatchEvent(new Event(\"input\", { bubbles: true })); } catch (e) {}\n      try { inp.focus(); inp.setSelectionRange(v.length, v.length); } catch (e) {}\n    },\n    input: function () {\n      var ids = [\"userinput\", \"user_input\", \"input\", \"command_input\"];\n      for (var i = 0; i < ids.length; i++) {\n        var e = document.getElementById(ids[i]);\n        if (e && (e.tagName === \"TEXTAREA\" || e.tagName === \"INPUT\")) return e;\n      }\n      var li = window.loomCommsLastInput || window.loomQuestbookLastInput;\n      if (li && li.isConnected && li.offsetParent !== null) return li;\n      var sels = [\"textarea\", \"input[type=text], input:not([type])\"];\n      for (var s = 0; s < sels.length; s++) {\n        var all = document.querySelectorAll(sels[s]);\n        for (var j = 0; j < all.length; j++) { if (all[j].offsetParent !== null) return all[j]; }\n      }\n      return null;\n    },\n    // EXPORT (one quest's view) and IMPORT (the list): the paste goes through\n    // the browser's own box, never the input line, so the command separator\n    // can't cut it.\n    exportOpen: function () { var Q = client.loom.questbook, q = Q.open ? Q.byId(Q.open) : null; if (q) Q.exportQuest(q); },\n    importAsk: function () {\n      var Q = client.loom.questbook, t = null, ok = typeof window.prompt == \"function\";\n      if (ok) { try { t = window.prompt(\"Paste a quest code (it starts with QB1). Check its steps before you use them.\"); } catch (e) { ok = false; } }\n      if (!ok) { Q.say(\"no box for pasting here: use QUESTBOOK IMPORT <code>.\", \"cyan\"); return; }\n      if (t !== null && String(t).trim()) Q.importCode(t);\n    },\n    strike: function (i) { var Q = client.loom.questbook; Q.struck[i] = !Q.struck[i]; run_function(\"questbook_render\", [], \"questbook\"); }\n  };\n  if (!window.loomQuestbookFocus) {\n    window.loomQuestbookFocus = true;\n    document.addEventListener(\"focusin\", function (ev) {\n      var tg = ev.target;\n      if (tg && (tg.tagName === \"TEXTAREA\" || (tg.tagName === \"INPUT\" && (!tg.type || tg.type === \"text\")))) window.loomQuestbookLastInput = tg;\n    }, true);\n  }\n} catch (e) {}\n// \"AGAIN IN 5 H\" counts down, and a quest turns ready at its reset with no\n// game event to say so: the tab redraws once a minute (it sends nothing).\n// Replaced on each setup, stopped at uninstall.\nif (QU.clock) clearInterval(QU.clock);\nQU.clock = setInterval(function () { run_function(\"questbook_render\", [], \"questbook\"); }, 60000);\nif (client.loom.notify) client.loom.notify(\"questbook\");\n"
  },
  {
   "type": "function",
   "name": "questbook_render",
   "enabled": true,
   "code": "// questbook_render -- the Quests tab (#376), in the house style shared with Here\n// and Waypoints: ink panel, serif small-caps headings, monospace rows.\n// Two views (mockup boards 1 and 2):\n//   - the list, by area (the area you're in first; areas fold, remembered):\n//     two lines a quest, its name and a status chip (STEP 3 OF 7, READY,\n//     AGAIN IN 5 H), then its rewards, repeat and record; filters All ·\n//     Ready · Waiting; IMPORT (a backup code) and + NEW (puts QUESTBOOK NEW\n//     in the input line);\n//   - one quest: rewards, a progress bar, its steps two lines each with the\n//     current one highlighted and its button (WALK, the line to send, DONE),\n//     START OVER, EDIT STEPS and EXPORT, when it was last done.\nif (!client.loom || !client.loom.questbook || !client.loom.questbook.list) run_function(\"questbook_setup\", [], \"questbook\");\nvar QU = client.loom.questbook;\nvar TH = (client.loom && client.loom.theme) || {};\nvar AMBER = TH.acc || \"#e0b46c\";\nvar DEEP = TH.deep || \"#7a5f33\";\nvar TXT = TH.txt || \"#e8e2d6\";\nvar MUTED = TH.muted || \"#8f877a\";\nvar DIM = TH.dim || \"#6d665b\";\nvar RULE = TH.rule || \"#2b2620\";\nvar BG = TH.bg || \"#13110e\";\nvar HI = TH.hi || \"#f0cc8c\";\nvar TRACK = TH.track || \"#2b2620\";\nvar GREEN = \"#8fd694\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nvar SYM = \"'Segoe UI Symbol','DejaVu Sans',sans-serif\";\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\"); }\nfunction js(s) { return esc(String(s).replace(/\\\\/g, \"\\\\\\\\\").replace(/'/g, \"\\\\'\")); }\nfunction click(fn) { return 'window.loomQuestbook&&window.loomQuestbook.' + fn; }\nfunction chip(label, fn, col, border, tip, bg) {\n  return '<span onclick=\"event.stopPropagation();' + click(fn) + '\" title=\"' + esc(tip) + '\" style=\"flex:none;cursor:pointer;padding:0 5px;border:1px solid ' + border + ';color:' + col + ';' + (bg ? 'background:' + bg + ';' : '') + 'letter-spacing:0.08em;white-space:nowrap;\">' + label + '</span>';\n}\nfunction tag(label, col, border) {\n  return '<span style=\"flex:none;padding:0 5px;border:1px solid ' + border + ';color:' + col + ';letter-spacing:0.08em;white-space:nowrap;\">' + label + '</span>';\n}\nvar here = QU.here || {};\nvar open = QU.open ? QU.byId(QU.open) : null;\nvar html = '<div id=\"loom-quests\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + BG + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;min-height:100%;box-sizing:border-box;display:flex;flex-direction:column;\">';\n\nfunction statusChip(q) {\n  var s = QU.status(q), st = QU.state[q.id] || {};\n  if (s === \"going\") return tag('STEP ' + ((st.step || 0) + 1) + ' OF ' + q.steps.length, HI, AMBER);\n  if (s === \"ready\") return tag('READY', GREEN, GREEN);\n  if (s === \"done\") return tag('<span style=\"font-family:' + SYM + ';\">&#10003;</span> DONE', DIM, RULE);\n  return tag('<span style=\"font-family:' + SYM + ';\">&#10003;</span> AGAIN IN ' + QU.span(QU.readyAt(q) - Date.now()), DIM, RULE);\n}\nfunction record(q) {\n  var st = QU.state[q.id] || {};\n  return st.done ? 'done ' + QU.times(st.done) : 'not done yet';\n}\n\nif (!open) {\n  // --- The list, by area ---------------------------------------------------\n  var counts = { going: 0, ready: 0, waiting: 0, done: 0 };\n  var groups = {}, order = [];\n  for (var i = 0; i < QU.list.length; i++) {\n    var qi = QU.list[i], si = QU.status(qi);\n    counts[si]++;\n    var a = qi.area || \"unknown area\";\n    if (!groups[a]) { groups[a] = []; order.push(a); }\n    groups[a].push(qi);\n  }\n  order.sort(function (x, y) {\n    if (x === here.area) return -1; if (y === here.area) return 1;\n    return x.toLowerCase() < y.toLowerCase() ? -1 : (x.toLowerCase() > y.toLowerCase() ? 1 : 0);\n  });\n  // In an area: under way first, then ready, then waiting (soonest first),\n  // each by name.\n  var rank = { going: 0, ready: 1, waiting: 2, done: 3 };\n  for (var so = 0; so < order.length; so++) groups[order[so]].sort(function (x, y) {\n    var a2 = QU.status(x), b2 = QU.status(y);\n    if (a2 !== b2) return rank[a2] - rank[b2];\n    if (a2 === \"waiting\") return QU.readyAt(x) - QU.readyAt(y);\n    return x.name.toLowerCase() < y.name.toLowerCase() ? -1 : 1;\n  });\n  QU.areasDrawn = order.slice();\n\n  var head = QU.list.length + (QU.list.length === 1 ? ' quest' : ' quests') + (QU.list.length ? ' &middot; ' + (counts.ready + counts.going) + ' ready &middot; ' + order.length + (order.length === 1 ? ' area' : ' areas') : '');\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\n  html += '<span style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:2px;font-size:15px;color:' + AMBER + ';\">Quests</span>';\n  html += '<span style=\"color:' + MUTED + ';\">' + head + '</span></div>';\n\n  // Filters, IMPORT and + NEW.\n  function seg(v, lbl) {\n    var on = QU.filter === v;\n    return '<span onclick=\"' + click(\"filter('\" + v + \"')\") + '\" title=\"show ' + (v === \"all\" ? \"every quest\" : v) + '\" style=\"cursor:pointer;padding:0 4px;' + (on ? 'background:' + DEEP + ';color:' + TXT + ';' : 'color:' + MUTED + ';') + '\">' + lbl + '</span>';\n  }\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:5px;\">';\n  html += '<span style=\"display:flex;align-items:baseline;gap:6px;\"><span style=\"font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + MUTED + ';\">show</span>';\n  html += '<span style=\"border:1px solid ' + DEEP + ';letter-spacing:0.08em;white-space:nowrap;font-size:9px;\">' + seg(\"all\", \"ALL\") + seg(\"ready\", \"READY\") + seg(\"waiting\", \"WAITING\") + '</span></span>';\n  html += '<span style=\"display:flex;gap:6px;\">' + chip('IMPORT', 'importAsk()', MUTED, DEEP, 'add a quest from a backup code (QUESTBOOK IMPORT <code>)') + chip('+ NEW', 'newAsk()', MUTED, DEEP, 'a new quest: QUESTBOOK NEW <name> in the input line, then add its steps') + '</span>';\n  html += '</div>';\n\n  function shown(q) {\n    var s = QU.status(q);\n    if (QU.filter === \"ready\") return s === \"ready\" || s === \"going\";\n    if (QU.filter === \"waiting\") return s === \"waiting\" || s === \"done\";\n    return true;\n  }\n  var any = false;\n  for (var g = 0; g < order.length; g++) {\n    var area = order[g], qs = groups[area], folded = !!QU.folded[area], vis = [];\n    for (var v = 0; v < qs.length; v++) if (shown(qs[v])) vis.push(qs[v]);\n    if (!vis.length) continue;\n    any = true;\n    var sub = \"\";\n    if (folded) {\n      var nr = 0, nw = 0;\n      for (var c = 0; c < vis.length; c++) { var sc = QU.status(vis[c]); if (sc === \"waiting\" || sc === \"done\") nw++; else nr++; }\n      var parts = [];\n      if (nr) parts.push(nr + ' ready');\n      if (nw) parts.push(nw + ' waiting');\n      sub = ' <span style=\"color:' + DIM + ';font-variant:normal;letter-spacing:0;font-style:italic;\">&middot; ' + parts.join(', ') + '</span>';\n    }\n    html += '<div onclick=\"' + click('fold(' + g + ')') + '\" title=\"click to ' + (folded ? 'unfold' : 'fold') + '\" style=\"cursor:pointer;font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;font-size:11px;color:' + AMBER + ';margin:8px 0 2px;border-top:1px solid ' + RULE + ';padding-top:5px;\">';\n    html += '<span style=\"font-family:' + SYM + ';display:inline-block;width:12px;color:' + MUTED + ';\">' + (folded ? '&#9656;' : '&#9662;') + '</span>' + esc(area.toLowerCase()) + ' <span style=\"color:' + MUTED + ';\">' + vis.length + '</span>' + sub + '</div>';\n    if (folded) continue;\n    for (var k = 0; k < vis.length; k++) {\n      var q = vis[k], s = QU.status(q), waiting = s === \"waiting\" || s === \"done\", going = s === \"going\";\n      html += '<div onclick=\"' + click(\"open('\" + js(q.id) + \"')\") + '\" title=\"open ' + esc(q.name) + '\" style=\"cursor:pointer;padding:3px 4px;border-bottom:1px dotted ' + RULE + ';' + (going ? 'background:rgba(224,180,108,0.08);' : '') + '\">';\n      html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;\">';\n      html += '<span style=\"min-width:0;font-family:' + SERIF + ';font-size:14px;color:' + (waiting ? MUTED : (going ? HI : TXT)) + ';\">' + esc(q.name) + '</span>' + statusChip(q) + '</div>';\n      var line2 = QU.rewardText(q).concat([QU.repeatText(q.repeat), record(q)]);\n      html += '<div style=\"font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + (waiting ? DIM : MUTED) + ';\">' + line2.map(esc).join(' &middot; ') + '</div>';\n      html += '</div>';\n    }\n  }\n  if (!QU.list.length) html += '<div style=\"margin-top:8px;font-family:' + SERIF + ';font-style:italic;font-size:12px;color:' + MUTED + ';\">No quests yet. QUESTBOOK NEW &lt;name&gt; starts writing one down.</div>';\n  else if (!any) html += '<div style=\"margin-top:8px;font-family:' + SERIF + ';font-style:italic;font-size:12px;color:' + MUTED + ';\">No ' + (QU.filter === \"ready\" ? 'quest is ready' : 'quest is waiting') + ' right now.</div>';\n  html += '<div style=\"margin-top:auto;padding-top:6px;font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + MUTED + ';\">Click a quest to follow it; click a heading to fold it. Resets: daily on the hour, monthly at ' + esc(QU.midnight) + ', yearly on 1st Sarapin' + (QU.year ? '' : ' (type DATE once so Questbook knows when that is)') + '.</div>';\n} else {\n  // --- One quest, following it ---------------------------------------------\n  var q1 = open, st = QU.state[q1.id] || { step: 0, kills: 0, last: 0, done: 0 };\n  var s1 = QU.status(q1), following = QU.follow === q1.id;\n  var cur = Math.min(st.step || 0, q1.steps.length);\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\n  html += '<span onclick=\"' + click(\"open('')\") + '\" title=\"back to every quest\" style=\"cursor:pointer;font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:2px;font-size:13px;color:' + AMBER + ';\"><span style=\"font-family:' + SYM + ';\">&#8592;</span> quests</span>';\n  html += '<span style=\"color:' + MUTED + ';\">' + esc([q1.area, QU.repeatText(q1.repeat)].filter(function (x) { return x; }).join(' · ')) + '</span></div>';\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-top:5px;\">';\n  html += '<span style=\"min-width:0;font-family:' + SERIF + ';font-size:16px;color:' + TXT + ';\">' + esc(q1.name) + '</span>' + statusChip(q1) + '</div>';\n  var rw = QU.rewardText(q1);\n  html += '<div style=\"font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + MUTED + ';\">' + (rw.length ? rw.map(esc).join(' &middot; ') : 'no rewards written down (QUESTBOOK REWARD)') + '</div>';\n\n  // Progress.\n  var n = q1.steps.length, pct = n ? Math.round(100 * cur / n) : 0;\n  html += '<div style=\"display:flex;align-items:center;gap:8px;margin:6px 0 4px;\">';\n  html += '<div style=\"flex:1 1 auto;height:6px;background:' + TRACK + ';border:1px solid ' + RULE + ';\"><div style=\"height:100%;width:' + pct + '%;background:' + AMBER + ';\"></div></div>';\n  html += '<span style=\"flex:none;color:' + MUTED + ';\">' + cur + ' of ' + n + ' done</span></div>';\n  if (s1 === \"done\" && !following) {\n    html += '<div style=\"font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + DIM + ';margin-bottom:2px;\">Done; it doesn\\'t repeat. START OVER follows it anyway.</div>';\n  } else if (s1 === \"waiting\" && !following) {\n    html += '<div style=\"font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + DIM + ';margin-bottom:2px;\">Done for now: ready again in ' + QU.span(QU.readyAt(q1) - Date.now()).toLowerCase() + '. START OVER follows it anyway.</div>';\n  } else if (!following && n) {\n    var other = QU.followed();\n    html += '<div style=\"display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:2px;\"><span style=\"font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + MUTED + ';\">' + (other ? 'You\\'re following ' + esc(other.name) + '.' : 'Not followed: its steps don\\'t tick yet.') + '</span>' + chip('FOLLOW THIS', 'follow()', AMBER, AMBER, 'tick this quest\\'s steps as you play') + '</div>';\n  }\n\n  // Steps.\n  // Each kind as a small drawn icon (Ricardo), its name and what ticks it on\n  // hover. Drawn in SVG so every font shows the same thing.\n  var ICON = {\n    go: ['<path d=\"M1.5 6 H9.5 M6.5 3 L9.5 6 L6.5 9\"/>', \"GO: walk to the room; ticks when you arrive\"],\n    do: ['<path d=\"M1.8 3.2 L4.6 6 L1.8 8.8 M6 9 H10.2\"/>', \"a command; ticks when you send it\"],\n    greet: ['<path d=\"M3.6 6.6 V3.2 M5.4 6 V1.9 M7.2 6 V2.2 M9 6.6 V3.7 M3.6 6.6 Q2.4 5.6 1.8 6.6 Q1.5 7.2 2.3 8.2 L3.4 9.7 Q4.4 11 6.2 11 Q9 11 9 8.2 V6.6\"/>', \"GREET: greet a denizen: a command; ticks when you send it\"],\n    talk: ['<path d=\"M2 2 H10 Q11 2 11 3 V7 Q11 8 10 8 H5.5 L3 10.2 V8 H2 Q1 8 1 7 V3 Q1 2 2 2 Z\"/><path d=\"M3.8 5 h0.01 M6 5 h0.01 M8.2 5 h0.01\" stroke-width=\"1.6\"/>', \"TALK: a command; ticks when you send it\"],\n    ask: ['<path d=\"M2 2 H10 Q11 2 11 3 V7 Q11 8 10 8 H5.5 L3 10.2 V8 H2 Q1 8 1 7 V3 Q1 2 2 2 Z\"/><path d=\"M4.8 4 Q4.8 3 6 3 Q7.2 3 7.2 4 Q7.2 4.8 6 5.2 V5.8 M6 6.9 v0.01\"/>', \"ASK: a command; ticks when you send it\"],\n    say: ['<path d=\"M2 2 H10 Q11 2 11 3 V7 Q11 8 10 8 H5.5 L3 10.2 V8 H2 Q1 8 1 7 V3 Q1 2 2 2 Z\"/><path d=\"M3.3 4 H8.7 M3.3 6 H7\"/>', \"SAY: a command; ticks when you send it\"],\n    get: ['<path d=\"M6 1 V6.5 M3.6 4.2 L6 6.6 L8.4 4.2 M1.5 7.5 V10.5 H10.5 V7.5\"/>', \"GET: a command; ticks when you send it\"],\n    buy: ['<circle cx=\"6\" cy=\"6\" r=\"4.6\"/><path d=\"M7.4 4.3 Q6.9 3.7 6 3.7 Q4.8 3.7 4.8 4.7 Q4.8 5.6 6 6 Q7.3 6.4 7.3 7.3 Q7.3 8.3 6 8.3 Q5 8.3 4.6 7.7 M6 2.8 V9.2\"/>', \"BUY: a command; ticks when you send it\"],\n    give: ['<path d=\"M6 7 V1.5 M3.6 3.8 L6 1.4 L8.4 3.8 M1.5 7.5 V10.5 H10.5 V7.5\"/>', \"GIVE: a command; ticks when you send it\"],\n    drop: ['<path d=\"M6 1.2 V8 M3.6 5.6 L6 8 L8.4 5.6 M1.5 10.6 H10.5\"/>', \"DROP: a command; ticks when you send it\"],\n    kill: ['<path d=\"M10.5 1.5 L4.6 7.4 L4 8 L5.2 9.2 L5.8 8.6 L11 2.2 Z M2.6 6.6 L6.6 10.6 M1.3 10.7 L3.4 8.6\"/>', \"KILL: ticks after that many kills\"],\n    note: ['<path d=\"M1.8 10.2 L2.6 7.6 L8.4 1.8 L10.2 3.6 L4.4 9.4 Z M7.4 2.8 L9.2 4.6\"/>', \"NOTE: a reminder; tick it by hand\"]\n  };\n  // A command step takes the icon of its first word when it has one (GREET,\n  // ASK, GIVE…), and its button says that word.\n  function verb(cmd) { return String(cmd).split(/\\s+/)[0].toUpperCase(); }\n  function iconKey(sp) {\n    if (sp.k !== \"do\") return sp.k;\n    var v = verb(sp.cmd).toLowerCase();\n    return (ICON[v] && v !== \"go\" && v !== \"kill\" && v !== \"note\") ? v : \"do\";\n  }\n  function icon(k, col) {\n    var ic = ICON[k];\n    return '<span title=\"' + esc(ic[1]) + '\" style=\"flex:none;display:inline-flex;width:14px;justify-content:center;align-self:center;color:' + col + ';\"><svg viewBox=\"0 0 12 12\" width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"display:block;\">' + ic[0] + '</svg></span>';\n  }\n  for (var j = 0; j < n; j++) {\n    var sp = q1.steps[j], done = j < cur, isCur = j === cur && following, struck = QU.edit && QU.struck[j];\n    var mark = done ? '<span style=\"font-family:' + SYM + ';color:' + GREEN + ';\">&#10003;</span>' : (isCur ? '<span style=\"font-family:' + SYM + ';color:' + AMBER + ';\">&#9654;</span>' : String(j + 1));\n    var what = QU.stepWhat(sp), d2 = \"\", btn = \"\";\n    if (sp.k === \"go\") {\n      var wpt = QU.waypoint(sp.room);\n      d2 = esc(sp.room) + ' &middot; ' + (wpt ? '<span style=\"font-family:' + SYM + ';color:' + AMBER + ';\">&#9873;</span> ' + esc(wpt.name) : esc(sp.area || \"\")) + (here.id === sp.room ? ' &middot; you\\'re here' : '');\n      if (isCur && here.id !== sp.room) btn = chip('WALK', 'act()', AMBER, AMBER, 'walk there (PATH FIND ' + sp.room + ')');\n    } else if (sp.k === \"do\") {\n      d2 = 'ticks when you send it from here';\n      if (isCur) btn = chip(esc(verb(sp.cmd)), 'act()', AMBER, AMBER, 'send: ' + sp.cmd);\n    } else if (sp.k === \"kill\") {\n      d2 = isCur ? (st.kills || 0) + ' of ' + sp.n + ' killed' : 'ticks after ' + sp.n + (sp.n === 1 ? ' kill' : ' kills');\n      if (isCur) btn = chip('DONE', 'act()', MUTED, DEEP, 'tick it by hand');\n    } else {\n      d2 = 'tick it by hand';\n      if (isCur) btn = chip('DONE', 'act()', MUTED, DEEP, 'tick it by hand');\n    }\n    // Done steps keep their details, not what would tick them.\n    if (done && sp.k === \"do\") d2 = \"sent\";\n    else if (done && sp.k === \"note\") d2 = \"\";\n    else if (done && sp.k === \"kill\") d2 = sp.n + (sp.n === 1 ? ' kill' : ' kills');\n    if (QU.edit) btn = '<span style=\"flex:none;display:flex;gap:2px;\">' + (struck ? '' : '<span onclick=\"event.stopPropagation();' + click('pen(' + j + ')') + '\" title=\"fix this step: puts QUESTBOOK STEP EDIT ' + (j + 1) + ' in your input line\" style=\"flex:none;cursor:pointer;color:' + AMBER + ';padding:0 4px;font-family:' + SYM + ';\">&#9998;</span>') + '<span onclick=\"event.stopPropagation();' + click('strike(' + j + ')') + '\" title=\"' + (struck ? 'keep this step' : 'drop this step') + '\" style=\"flex:none;cursor:pointer;color:' + (struck ? MUTED : '#ff9a4c') + ';padding:0 4px;display:inline-block;text-decoration:none;\">' + (struck ? 'keep' : '&times;') + '</span>' + '</span>';\n    var rowTip = QU.edit ? '' : 'make this the current step';\n    html += '<div' + (QU.edit ? '' : ' onclick=\"' + click('jump(' + j + ')') + '\"') + ' title=\"' + rowTip + '\" style=\"' + (QU.edit ? '' : 'cursor:pointer;') + 'padding:3px 4px;border-bottom:1px dotted ' + RULE + ';' + (isCur ? 'background:rgba(224,180,108,0.10);border-left:2px solid ' + AMBER + ';' : 'border-left:2px solid transparent;') + (struck ? 'text-decoration:line-through;opacity:0.5;' : '') + '\">';\n    html += '<div style=\"display:flex;justify-content:space-between;align-items:center;gap:8px;\">';\n    html += '<span style=\"min-width:0;display:flex;align-items:baseline;gap:6px;\"><span style=\"flex:none;width:12px;text-align:right;color:' + (done ? GREEN : (isCur ? AMBER : MUTED)) + ';\">' + mark + '</span>';\n    html += icon(iconKey(sp), isCur ? AMBER : (done ? DIM : MUTED));\n    html += '<span style=\"min-width:0;font-family:' + SERIF + ';font-size:13px;color:' + (done ? MUTED : (isCur ? HI : TXT)) + ';\">' + esc(what) + '</span></span>' + btn + '</div>';\n    html += '<div style=\"font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + (done ? DIM : MUTED) + ';padding-left:38px;\">' + d2 + '</div>';\n    html += '</div>';\n  }\n  if (!n) html += '<div style=\"margin-top:6px;font-family:' + SERIF + ';font-style:italic;font-size:12px;color:' + MUTED + ';\">No steps yet. QUESTBOOK STEP GO saves the room you\\'re in; QUESTBOOK HELP lists the other kinds.</div>';\n  if (QU.edit) html += '<div style=\"margin-top:5px;font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + MUTED + ';\">&#9998; puts a step\\'s QUESTBOOK STEP EDIT in your input line to fix it; &times; strikes a step through, and DONE EDITING drops the struck ones. QUESTBOOK STEP INSERT &lt;n&gt; adds one in between.</div>';\n\n  // Footer.\n  html += '<div style=\"margin-top:auto;padding-top:8px;display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;\">';\n  html += '<span style=\"display:flex;gap:6px;\">' + chip('START OVER', 'restart()', MUTED, DEEP, 'back to step 1, and follow this quest') + chip(QU.edit ? 'DONE EDITING' : 'EDIT STEPS', 'edit()', QU.edit ? AMBER : MUTED, QU.edit ? AMBER : DEEP, QU.edit ? 'drop the struck steps' : 'strike steps out') + (QU.edit ? '' : chip('EXPORT', 'exportOpen()', MUTED, DEEP, 'this quest as a backup code, copied to your clipboard (QUESTBOOK EXPORT)')) + '</span>';\n  html += '<span style=\"font-family:' + SERIF + ';font-style:italic;font-size:11px;color:' + MUTED + ';\">' + (st.last ? 'last done ' + QU.ago(st.last) + ' &middot; ' : '') + record(q1) + '</span></div>';\n}\nhtml += '</div>';\n\n// The whole tab in the panel's colour (#355).\ntry {\n  var quSt = document.getElementById(\"loom-quests-style\");\n  if (!quSt) { quSt = document.createElement(\"style\"); quSt.id = \"loom-quests-style\"; document.head.appendChild(quSt); }\n  var quCss = '.flexlayout__tab:has(#loom-quests) { background: ' + BG + ' !important; } .flexlayout__tab:has(#loom-quests) > * { min-height: 100%; }';\n  if (quSt.textContent !== quCss) quSt.textContent = quCss;\n} catch (e) {}\ntry { set_custom_tab_html(\"Quests\", html); } catch (e) {}\n"
  },
  {
   "type": "function",
   "name": "questbook_help",
   "enabled": true,
   "code": "// questbook_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[questbook] your own repeatable quests, written down as steps and followed in the Quests tab. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"QUESTBOOK\", \"status: how many under way, ready and waiting, and the one you follow\"],\n  [\"QUESTBOOK LIST\", \"every quest, with where you are in it or when it's ready again\"],\n  [\"QUESTBOOK NEW <name>\", \"start writing a quest down (in this area, repeating daily); it opens in the tab\"],\n  [\"QUESTBOOK OPEN <name|number>\", \"show a quest in the tab; one you can do now is followed\"],\n  [\"QUESTBOOK CLOSE\", \"back to the list (also \\u2190 quests in the tab)\"],\n  [\"Writing steps (on the quest open in the tab):\"],\n  [\"QUESTBOOK STEP GO [room]\", \"go to the room you're in, or that room number (ticks when you arrive; click walks)\"],\n  [\"QUESTBOOK STEP <any command>\", \"a command, as you'd type it: GREET miller, ASK miller about sack, GIVE sack to miller, PULL lever (its button sends it, which ticks it)\"],\n  [\"QUESTBOOK STEP DO <command>\", \"the same, for a command starting with a step word (DO kill rat)\"],\n  [\"QUESTBOOK STEP KILL [count] <mob>\", \"ticks after that many \\\"You have slain\\\" lines naming it\"],\n  [\"QUESTBOOK STEP NOTE <text>\", \"a reminder, ticked by hand\"],\n  [\"QUESTBOOK STEP EDIT <n> <step> …\", \"rewrite step n, as you'd add it (\\u270e in EDIT STEPS puts it in your input line)\"],\n  [\"QUESTBOOK STEP INSERT <n> <step> …\", \"a new step before step n\"],\n  [\"QUESTBOOK STEP REMOVE <n>\", \"drop a step (also \\u00d7 in EDIT STEPS)\"],\n  [\"QUESTBOOK REPEAT DAILY|MONTHLY|YEARLY|NONE\", \"in Achaean time: daily on the hour, monthly at the game's midnight, yearly on 1st Sarapin; NONE: once\"],\n  [\"QUESTBOOK REWARD\", \"the open quest's rewards\"],\n  [\"QUESTBOOK REWARD RENOWN|XP|GOLD <n>\", \"what it gives (0 takes it off)\"],\n  [\"QUESTBOOK REWARD ITEM <text> | CLEAR\", \"an item it gives, or clear the rewards\"],\n  [\"QUESTBOOK RENAME <new name>\", \"rename the open quest\"],\n  [\"QUESTBOOK AREA [name]\", \"move the open quest to the area you're in, or to that area\"],\n  [\"QUESTBOOK REMOVE <name|number> CONFIRM\", \"forget a quest and its record\"],\n  [\"Backup (one quest at a time):\"],\n  [\"QUESTBOOK EXPORT [name|number]\", \"a quest (the open one if none named) as a short code, copied to your clipboard when the browser allows (also EXPORT in the tab)\"],\n  [\"QUESTBOOK IMPORT <code>\", \"add a quest back from its code, as a new quest, not followed (also IMPORT in the tab, which takes a paste in a box). Read every step before you use one from someone else\"],\n  [\"Following:\"],\n  [\"QUESTBOOK NEXT\", \"tick the current step by hand\"],\n  [\"QUESTBOOK BACK\", \"one step back\"],\n  [\"QUESTBOOK RESTART\", \"start the open quest over (also START OVER in the tab)\"],\n  [\"QUESTBOOK DONE\", \"mark the open quest done now\"],\n  [\"Settings:\"],\n  [\"QUESTBOOK SHOW [ALL|READY|WAITING]\", \"which quests the tab lists (also in the tab; kept)\"],\n  [\"QUESTBOOK MIDNIGHT [hh:mm]\", \"the game's midnight on your clock, when monthly quests reset (default 02:00)\"],\n  [\"Yearly quests learn 1st Sarapin from the game's date: type DATE once.\"],\n  [\"QUESTBOOK RESET\", \"reload saved quests, redraw the tab\"],\n  [\"QUESTBOOK DEBUG\", \"internal state\"],\n  [\"The tab is a custom tab named Quests. Nothing runs by itself: a step's button walks or sends only when you click it.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "Questbook control",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// QUESTBOOK [subcommand ...]: the one command for this package. Writing a quest\n// down: QUESTBOOK NEW <name> opens it, then QUESTBOOK STEP … adds steps to the\n// quest open in the tab.\nif (!client.loom || !client.loom.questbook || !client.loom.questbook.list) run_function(\"questbook_setup\", [], \"questbook\");\nvar QU = client.loom.questbook;\nvar quRaw = String(args[1] || \"\").trim();\nvar quSp = quRaw.search(/\\s/);\nvar quCmd = (quSp < 0 ? quRaw : quRaw.substring(0, quSp)).toLowerCase();\nvar quRest = quSp < 0 ? \"\" : quRaw.substring(quSp).trim();\nvar quOpen = QU.open ? QU.byId(QU.open) : null;\nvar quQ;\nfunction quNeedOpen() {\n  if (!quOpen) QU.say(\"no quest open: QUESTBOOK OPEN <name|number>, or QUESTBOOK NEW <name>.\", \"orange\");\n  return !!quOpen;\n}\nif (quCmd === \"\" || quCmd === \"status\") {\n  var quN = { going: 0, ready: 0, waiting: 0, done: 0 };\n  for (var quI = 0; quI < QU.list.length; quI++) quN[QU.status(QU.list[quI])]++;\n  var quF = QU.followed();\n  QU.say(QU.list.length + (QU.list.length === 1 ? \" quest\" : \" quests\") + \": \" + quN.going + \" under way, \" + quN.ready + \" ready, \" + quN.waiting + \" waiting\" + (quN.done ? \", \" + quN.done + \" done for good\" : \"\") + \". \" +\n    (quF ? \"Following \" + quF.name + \" (step \" + (QU.st(quF).step + 1) + \" of \" + quF.steps.length + \"). \" : \"\") + \"Monthly reset at \" + QU.midnight + \"; \" + (QU.year ? \"1st Sarapin known\" : \"1st Sarapin not known yet (type DATE)\") + \". QUESTBOOK LIST, QUESTBOOK HELP.\", \"cyan\");\n} else if (quCmd === \"help\") {\n  run_function(\"questbook_help\", [], \"questbook\");\n} else if (quCmd === \"list\") {\n  if (!QU.list.length) QU.say(\"no quests yet: QUESTBOOK NEW <name> starts one.\", \"cyan\");\n  for (var quJ = 0; quJ < QU.list.length; quJ++) {\n    var quL = QU.list[quJ], quS = QU.status(quL), quRa = QU.readyAt(quL);\n    QU.say(quL.id + \". \" + quL.name + \" (\" + (quL.area || \"?\") + \", \" + QU.repeatText(quL.repeat) + \", \" + quL.steps.length + (quL.steps.length === 1 ? \" step\" : \" steps\") + \"): \" +\n      (quS === \"going\" ? \"step \" + (QU.st(quL).step + 1) + \" of \" + quL.steps.length : (quS === \"ready\" ? \"ready\" : (quS === \"done\" ? \"done, doesn't repeat\" : \"again in \" + QU.span(quRa - Date.now()).toLowerCase()))), \"cyan\");\n  }\n} else if (quCmd === \"new\") {\n  if (!quRest) QU.say(\"QUESTBOOK NEW <name>.\", \"orange\");\n  else if (/^\\d+$/.test(quRest)) QU.say(\"give it a name, not a number: the number is the quest's.\", \"orange\");\n  else if (QU.byName(quRest)) QU.say(QU.byName(quRest).name + \" is taken: pick another name.\", \"orange\");\n  else {\n    quQ = { id: QU.nextId(), name: quRest, area: (QU.here && QU.here.area) || \"\", repeat: \"daily\", at: Date.now(), rewards: { renown: 0, xp: 0, gold: 0, items: [] }, steps: [] };\n    QU.list.push(quQ);\n    QU.save();\n    QU.openQuest(quQ, true);\n    QU.say(\"new quest \" + quQ.name + \" (\" + quQ.id + (quQ.area ? \", \" + quQ.area : \"\") + \", repeats daily: every hour; QUESTBOOK REPEAT to change it). Add its steps with QUESTBOOK STEP …: GO saves this room. Nothing ticks while you write it; START OVER in the tab follows it.\", \"lime\");\n  }\n} else if (quCmd === \"open\") {\n  quQ = QU.find(quRest);\n  if (quQ) QU.openQuest(quQ);\n  else QU.say(\"no quest '\" + quRest + \"'. QUESTBOOK OPEN <name|number>.\", \"orange\");\n} else if (quCmd === \"close\") {\n  QU.openQuest(null);\n} else if (quCmd === \"step\") {\n  if (quNeedOpen()) {\n    // STEP <kind> …, STEP EDIT <n> <kind> …, STEP INSERT <n> <kind> …,\n    // STEP REMOVE <n>.\n    var quSm = /^(edit|insert|remove|del)(?:\\s+(\\d+))?(?:\\s+(.*))?$/i.exec(quRest);\n    var quOp = quSm ? quSm[1].toLowerCase() : \"add\";\n    var quNo = quSm ? Number(quSm[2] || 0) : 0, quMax = quOpen.steps.length;\n    if (quOp === \"del\") quOp = \"remove\";\n    if (quOp !== \"add\" && (!quNo || quNo < 1 || quNo > (quOp === \"insert\" ? quMax + 1 : quMax))) {\n      QU.say(quMax || quOp === \"insert\" ? \"QUESTBOOK STEP \" + quOp.toUpperCase() + \" <1-\" + (quOp === \"insert\" ? quMax + 1 : quMax) + \">\" + (quOp === \"remove\" ? \"\" : \" <kind> …\") + \".\" : quOpen.name + \" has no steps yet.\", \"orange\");\n    } else if (quOp === \"remove\") {\n      QU.removeStep(quOpen, quNo - 1);\n    } else {\n      var quPs = QU.parseStep(quOp === \"add\" ? quRest : (quSm[3] || \"\"), quOp === \"edit\" ? quOpen.steps[quNo - 1] : null);\n      if (quPs.err) QU.say(quPs.err, \"orange\");\n      else if (quOp === \"add\") QU.addStep(quOpen, quPs.step);\n      else QU.putStep(quOpen, quNo - 1, quPs.step, quOp === \"insert\");\n    }\n  }\n} else if (quCmd === \"next\") {\n  var quFn = QU.followed();\n  if (!quFn) QU.say(\"not following a quest: QUESTBOOK OPEN one you can do.\", \"orange\");\n  else if (!QU.current(quFn)) QU.say(quFn.name + \" has no steps yet.\", \"orange\");\n  else QU.tick(\"Ticked by hand\");\n} else if (quCmd === \"back\") {\n  var quFb = QU.followed();\n  if (!quFb || !QU.back(quFb)) QU.say(\"nothing to step back from.\", \"orange\");\n  else QU.say(quFb.name + \": back to step \" + (QU.st(quFb).step + 1) + \".\", \"lime\");\n} else if (quCmd === \"restart\") {\n  if (quNeedOpen()) { QU.restart(quOpen); QU.say(quOpen.name + \": started over.\", \"lime\"); QU.check(); }\n} else if (quCmd === \"done\") {\n  if (quNeedOpen()) QU.finish(quOpen);\n} else if (quCmd === \"repeat\") {\n  var quRp = quRest.toLowerCase();\n  if (quRp === \"off\" || quRp === \"once\") quRp = \"none\";\n  if (!quNeedOpen()) {}\n  else if (QU.repeats.indexOf(quRp) >= 0) { quOpen.repeat = quRp; QU.save(); QU.say(quOpen.name + (quRp === \"none\" ? \" doesn't repeat: once done, it stays done\" : \" repeats \" + quRp + \" (\" + QU.repeatWhen(quRp) + \")\") + \".\", \"lime\"); }\n  else QU.say(quOpen.name + (quOpen.repeat === \"none\" ? \" doesn't repeat\" : \" repeats \" + quOpen.repeat) + \". QUESTBOOK REPEAT DAILY|MONTHLY|YEARLY|NONE.\", quRp ? \"orange\" : \"cyan\");\n} else if (quCmd === \"reward\") {\n  if (quNeedOpen()) {\n    var quRm = /^(renown|xp|gold|item|clear)(?:\\s+(.*))?$/i.exec(quRest);\n    var quRw = quOpen.rewards;\n    if (!quRest) QU.say(quOpen.name + \" rewards \" + (QU.rewardText(quOpen).join(\", \") || \"nothing written down\") + \". QUESTBOOK REWARD RENOWN|XP|GOLD <n> | ITEM <text> | CLEAR.\", \"cyan\");\n    else if (!quRm) QU.say(\"QUESTBOOK REWARD RENOWN <n> | XP <n> | GOLD <n> | ITEM <text> | CLEAR.\", \"orange\");\n    else {\n      var quRk = quRm[1].toLowerCase(), quRv = String(quRm[2] || \"\").trim();\n      if (quRk === \"clear\") { quOpen.rewards = { renown: 0, gold: 0, items: [] }; QU.save(); QU.say(quOpen.name + \": rewards cleared.\", \"lime\"); }\n      else if (quRk === \"item\") {\n        if (!quRv) QU.say(\"QUESTBOOK REWARD ITEM <text>.\", \"orange\");\n        else { quRw.items.push(quRv); QU.save(); QU.say(quOpen.name + \" rewards \" + QU.rewardText(quOpen).join(\", \") + \".\", \"lime\"); }\n      } else {\n        var quNum = Number(quRv.replace(/,/g, \"\"));\n        if (!/^\\d+$/.test(quRv.replace(/,/g, \"\"))) QU.say(\"QUESTBOOK REWARD \" + quRk.toUpperCase() + \" <number> (0 takes it off).\", \"orange\");\n        else { quRw[quRk] = quNum; QU.save(); QU.say(quOpen.name + \" rewards \" + (QU.rewardText(quOpen).join(\", \") || \"nothing written down\") + \".\", \"lime\"); }\n      }\n    }\n  }\n} else if (quCmd === \"area\") {\n  // The open quest's area: the one you're in, or a name (an area you already\n  // have quests in keeps its spelling, so the tab doesn't split it by case).\n  if (quNeedOpen()) {\n    var quAr = quRest.replace(/\\s+/g, \" \").substring(0, QU.capName || 80);\n    if (!quAr) quAr = (QU.here && QU.here.area) || \"\";\n    if (!quAr) QU.say(\"no area yet: move or LOOK first, or QUESTBOOK AREA <name>.\", \"orange\");\n    else {\n      for (var quAi = 0; quAi < QU.list.length; quAi++) if (QU.list[quAi].area && QU.list[quAi].area.toLowerCase() === quAr.toLowerCase()) { quAr = QU.list[quAi].area; break; }\n      if (quAr === quOpen.area) QU.say(quOpen.name + \" is already in \" + quAr + \".\", \"cyan\");\n      else { var quWas = quOpen.area; quOpen.area = quAr; QU.save(); QU.say(quOpen.name + \" moved to \" + quAr + (quWas ? \" (was \" + quWas + \")\" : \"\") + \".\", \"lime\"); }\n    }\n  }\n} else if (quCmd === \"rename\") {\n  if (quNeedOpen()) {\n    if (!quRest) QU.say(\"QUESTBOOK RENAME <new name> (the quest open in the tab).\", \"orange\");\n    else if (/^\\d+$/.test(quRest)) QU.say(\"give it a name, not a number.\", \"orange\");\n    else if (QU.byName(quRest) && QU.byName(quRest) !== quOpen) QU.say(quRest + \" is taken: pick another name.\", \"orange\");\n    else { var quOld = quOpen.name; quOpen.name = quRest; QU.save(); QU.say(quOld + \" is now \" + quOpen.name + \".\", \"lime\"); }\n  }\n} else if (quCmd === \"remove\" || quCmd === \"del\") {\n  var quRc = /^(.*?)(?:\\s+(confirm))?$/i.exec(quRest);\n  quQ = QU.find(quRc[1]);\n  if (!quQ) QU.say(\"no quest '\" + quRc[1] + \"'. QUESTBOOK REMOVE <name|number> CONFIRM.\", \"orange\");\n  else if (!quRc[2]) QU.say(\"this forgets \" + quQ.name + \": its \" + quQ.steps.length + (quQ.steps.length === 1 ? \" step\" : \" steps\") + \" and its record (done \" + QU.times(QU.st(quQ).done) + \"). QUESTBOOK REMOVE \" + quQ.id + \" CONFIRM to go ahead.\", \"orange\");\n  else {\n    QU.list.splice(QU.list.indexOf(quQ), 1);\n    delete QU.state[quQ.id];\n    if (QU.open === quQ.id) QU.open = null;\n    if (QU.follow === quQ.id) QU.follow = null;\n    QU.save();\n    QU.say(\"forgot \" + quQ.name + \".\", \"lime\");\n  }\n} else if (quCmd === \"export\" || quCmd === \"backup\") {\n  // One quest at a time (Ricardo): the named one, else the one open.\n  quQ = quRest ? QU.find(quRest) : quOpen;\n  if (quQ) QU.exportQuest(quQ);\n  else QU.say(quRest ? \"no quest '\" + quRest + \"'. QUESTBOOK EXPORT <name|number>.\" : \"QUESTBOOK EXPORT <name|number> (or open the quest first).\", \"orange\");\n} else if (quCmd === \"import\") {\n  if (!quRest) QU.say(\"QUESTBOOK IMPORT <code>, or IMPORT in the Quests tab to paste it in a box.\", \"orange\");\n  else QU.importCode(quRest);\n} else if (quCmd === \"show\") {\n  var quSh = quRest.toLowerCase();\n  if (quSh === \"all\" || quSh === \"ready\" || quSh === \"waiting\") { QU.setFilter(quSh); QU.say(\"the tab shows \" + (quSh === \"all\" ? \"every quest\" : (quSh === \"ready\" ? \"quests you can do now (and those under way)\" : \"quests waiting for their reset\")) + \".\", \"lime\"); }\n  else if (!quSh) QU.say(\"the tab shows \" + QU.filter + \". QUESTBOOK SHOW ALL|READY|WAITING.\", \"cyan\");\n  else QU.say(\"QUESTBOOK SHOW ALL|READY|WAITING.\", \"orange\");\n} else if (quCmd === \"midnight\") {\n  var quDm = /^(\\d{1,2}):(\\d{2})$/.exec(quRest);\n  if (!quRest) QU.say(\"the game's midnight, when monthly quests reset, is \" + QU.midnight + \" on your clock. QUESTBOOK MIDNIGHT <hh:mm> to change it.\", \"cyan\");\n  else if (!quDm || Number(quDm[1]) > 23 || Number(quDm[2]) > 59) QU.say(\"QUESTBOOK MIDNIGHT <hh:mm>, 00:00 to 23:59, on your own clock.\", \"orange\");\n  else {\n    QU.midnight = (quDm[1].length < 2 ? \"0\" : \"\") + quDm[1] + \":\" + quDm[2];\n    if (QU.midnight === \"02:00\") delete_variable(\"questbook_midnight\"); else set_variable(\"questbook_midnight\", QU.midnight);\n    if (QU.year) { delete_variable(\"questbook_year\"); QU.year = 0; }\n    run_function(\"questbook_render\", [], \"questbook\");\n    QU.say(\"the game's midnight is \" + QU.midnight + \" on your clock: monthly quests reset then. Type DATE once so yearly ones line up with it again.\", \"lime\");\n  }\n} else if (quCmd === \"reset\") {\n  run_function(\"questbook_setup\", [], \"questbook\");\n  run_function(\"questbook_render\", [], \"questbook\");\n  QU.say(\"reset: saved quests reloaded, tab redrawn.\", \"lime\");\n} else if (quCmd === \"debug\") {\n  var quFd = QU.followed();\n  QU.say(\"here=\" + JSON.stringify(QU.here) + \" open=\" + QU.open + \" follow=\" + QU.follow + (quFd ? \" step=\" + JSON.stringify(QU.state[quFd.id] || {}) + \" current=\" + JSON.stringify(QU.current(quFd)) : \"\") +\n    \" quests=\" + QU.list.length + \" filter=\" + QU.filter + \" midnight=\" + QU.midnight + \" year=\" + (QU.year ? new Date(QU.year).toString() : \"unknown\") + \" nextYear=\" + (QU.year ? new Date(QU.nextReset(\"yearly\", Date.now())).toString() : \"?\"), \"cyan\");\n} else {\n  QU.say(\"unknown command '\" + quCmd + \"'. QUESTBOOK HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^questbook(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "Questbook date",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// The game's date (\"Today is the 5th of Valnuary, …\" from DATE, or the new\n// day's \"It is now the …\"): tells Questbook when 1st Sarapin is, for yearly\n// quests.\nif (client.loom && client.loom.questbook && client.loom.questbook.seeDate) client.loom.questbook.seeDate(String(args[2] || \"\"));\n"
    }
   ],
   "text": "^(?:It is now|Today is) the (\\d+)(?:st|nd|rd|th) of (\\w+), (\\d+) years after",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Questbook slain",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"You have slain <mob>.\" ticks a KILL step of the quest you're following.\nif (client.loom && client.loom.questbook && client.loom.questbook.onSlain) client.loom.questbook.onSlain(String(args[1] || \"\"));\n"
    }
   ],
   "text": "^You have slain (.+?)\\.?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  }
 ],
 "description": "Your own repeatable quests as steps in a tab, ticked as you play"
}