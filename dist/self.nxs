{
 "type": "group",
 "name": "self",
 "enabled": true,
 "description": "Character panel: afflictions, defences you watch, and SCORE details",
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"self_setup\", [], \"self\");\nrun_function(\"self_render\", [], \"self\");\ndisplay_notice(\"[self] installed. Create a UI tab named 'Self' for the panel, then DEF, DIAG and SCORE once. SELF HELP for commands.\", \"lime\");\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"self_gmcp\", [], \"self\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; the self_* variables are left intact.\n// Leave LOOM and the integrations at once, not at the next load (#137):\n// loom takes the entry out and redraws the tabs that showed this package's answers.\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"self\");\n  else delete client.loom.registry.self;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"Self\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\"><circle cx=\"8\" cy=\"5\" r=\"3.3\" fill=\"#e0a0a8\"/><path d=\"M1.5 15.5 C2 10.5 5 9.2 8 9.2 C11 9.2 14 10.5 14.5 15.5 Z\" fill=\"#7a4a52\" stroke=\"#e0a0a8\" stroke-width=\"0.8\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\n\nrun_function(\"self_setup\", [], \"self\");\n// The tab fills from GMCP; SCORE and DEF fill in what GMCP doesn't send.\nsend_command(\"score\");\nsend_command(\"def\");\n\nrun_function(\"self_render\", [], \"self\");\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"self_gmcp\", [], \"self\");\n"
  },
  {
   "type": "function",
   "name": "self_gmcp",
   "enabled": true,
   "code": "// self_gmcp -- the work behind onGMCP, as a function made once per load\n// (client.loom.hooks.self.gmcp). Nexus compiles a script afresh every time it\n// runs, and long ones cost on every GMCP message, so the script itself stays two\n// lines and calls this (#136). Run from onLoad and onInstall, so a reimport\n// replaces it.\nif (!client.loom) client.loom = {};\nif (!client.loom.hooks) client.loom.hooks = {};\nif (!client.loom.hooks.self) client.loom.hooks.self = {};\nclient.loom.hooks.self.gmcp = function (args) {\n  // Keeps client.loom.self in step with GMCP. Afflictions and defences arrive as a\n  // full List (on login, DIAGNOSE, DEF) and then as single Add / Remove updates;\n  // the package keeps the running set. Self-contained, so it can be pasted into\n  // the global onGMCP as-is if the package one never fires.\n  var sfM = \"\";\n  var sfA = null;\n  try { sfM = args.gmcp_method; sfA = args.gmcp_args; } catch (e) { sfM = \"\"; }\n  if (typeof sfA === \"string\") { try { sfA = JSON.parse(sfA); } catch (e) { sfA = null; } }\n  if (sfM && sfA !== null && sfA !== undefined) {\n    if (!client.loom || !client.loom.self || !client.loom.self.keep) run_function(\"self_setup\", [], \"self\");\n    var S = client.loom.self;\n    var sfNow = Math.floor(new Date().getTime() / 1000);\n    var sfDirty = false, sfExpl = false;\n    var sfI;\n    if (sfM === \"Char.Afflictions.List\") {\n      S.affs = {};\n      for (sfI = 0; sfI < sfA.length; sfI++) { S.affs[sfA[sfI].name] = { cure: sfA[sfI].cure || \"\", desc: sfA[sfI].desc || \"\", t: sfNow }; }\n      S.seenAffs = true;\n      S.needDiag = false;\n      sfDirty = true;\n    } else if (sfM === \"Char.Afflictions.Add\") {\n      S.affs[sfA.name] = { cure: sfA.cure || \"\", desc: sfA.desc || \"\", t: sfNow };\n      S.seenAffs = true;\n      sfDirty = true;\n    } else if (sfM === \"Char.Afflictions.Remove\") {\n      for (sfI = 0; sfI < sfA.length; sfI++) { delete S.affs[sfA[sfI]]; }\n      sfDirty = true;\n    } else if (sfM === \"Char.Defences.List\") {\n      S.defs = {};\n      for (sfI = 0; sfI < sfA.length; sfI++) { S.defs[sfA[sfI].name] = { desc: sfA[sfI].desc || \"\", t: sfNow }; delete S.lost[sfA[sfI].name]; }\n      S.seenDefs = true;\n      sfDirty = true;\n    } else if (sfM === \"Char.Defences.Add\") {\n      S.defs[sfA.name] = { desc: sfA.desc || \"\", t: sfNow };\n      delete S.lost[sfA.name];\n      S.seenDefs = true;\n      sfDirty = true;\n    } else if (sfM === \"Char.Defences.Remove\") {\n      for (sfI = 0; sfI < sfA.length; sfI++) {\n        if (S.defs[sfA[sfI]]) {\n          S.lost[sfA[sfI]] = sfNow;\n          // A defence you asked to watch: say so out loud, not just in the tab.\n          if (S.want && S.want[sfA[sfI]]) { display_notice(\"[self] lost \" + sfA[sfI] + \"!\", \"orange\"); }\n        }\n        delete S.defs[sfA[sfI]];\n      }\n      sfDirty = true;\n    } else if (sfM === \"Char.Vitals\" && sfA.charstats) {\n      // Vitals arrive with every prompt; redraw only when the stats change.\n      var sfKey = sfA.charstats.join(\"|\");\n      if (sfKey !== S.statsKey) { S.statsKey = sfKey; S.stats = sfA.charstats.slice(0); sfDirty = true; }\n    } else if (sfM === \"Char.Status\") {\n      var sfF = [\"name\", \"fullname\", \"level\", \"class\", \"race\", \"city\", \"house\", \"specialisation\", \"age\", \"xprank\", \"explorerrank\"];\n      for (sfI = 0; sfI < sfF.length; sfI++) { if (sfA[sfF[sfI]] !== undefined && sfA[sfF[sfI]] !== S.info[sfF[sfI]]) { S.info[sfF[sfI]] = sfA[sfF[sfI]]; sfDirty = true; if (sfF[sfI] === \"explorerrank\") sfExpl = true; } }\n    } else if (sfM === \"Char.Name\") {\n      if (sfA.name) { S.info.name = sfA.name; }\n      if (sfA.fullname) { S.info.fullname = sfA.fullname; }\n      sfDirty = true;\n    }\n    // A class change (dragonform included) brings that class's watched list.\n    if (sfM === \"Char.Status\" && String(S.info[\"class\"] || \"any\").toLowerCase().replace(/[^a-z0-9]+/g, \"_\") !== S.wantCls) run_function(\"self_setup\", [], \"self\");\n    // An override that only repeats the game's name (as the old SETNAME usually\n    // did) is dropped, so self_name exists only when it changes something.\n    if ((sfM === \"Char.Name\" || sfM === \"Char.Status\") && S.nameOverride && S.info.name && S.nameOverride.toLowerCase() === String(S.info.name).toLowerCase()) {\n      S.nameOverride = \"\";\n      try { delete_variable(\"self_name\"); } catch (e) {}\n    }\n    if (sfDirty) { try { run_function(\"self_render\", [], \"self\"); } catch (e) {} }\n    // The explorer rank moved (after the render, which takes the page's first\n    // reading as the starting point): tell loom (#47).\n    if (sfExpl && client.loom.notify) client.loom.notify(\"self\");\n  }\n};\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// onGMCP: the work is in self_gmcp (#136: this runs on every GMCP message, so it stays short).\nvar lkH = client.loom && client.loom.hooks && client.loom.hooks.self;\nif (!lkH || !lkH.gmcp) { run_function(\"self_gmcp\", [], \"self\"); lkH = client.loom.hooks.self; }\nlkH.gmcp(args);\n"
  },
  {
   "type": "function",
   "name": "self_setup",
   "enabled": true,
   "code": "// self_setup -- run from onLoad and onInstall, on each Char.Status (the class\n// may have changed), and by any reflex that finds the namespace missing.\n// Namespace, registry, one-time migration of the old client.self* keys and\n// my_name, then the live state, the watched defences for the current class\n// and the afflictions kept on purpose, each built if missing.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.self) client.loom.self = {};\n// redraw: how loom redraws the Self tab when a source changes (#176).\nclient.loom.registry.self = { version: \"1.0.0\", keyword: \"SELF\", desc: \"Character panel: afflictions, defences you watch, and SCORE details\", redraw: function () { run_function(\"self_render\", [], \"self\"); } };\nvar SF = client.loom.self;\n\n// The old package kept its state in client.self, client.selfWant,\n// client.selfWantCls, client.selfKeep and client.selfArgs. On a reimport\n// without a page reload, the live state carries over.\nif (client.self) {\n  for (var sfK in client.self) {\n    if (client.self.hasOwnProperty(sfK) && SF[sfK] === undefined) SF[sfK] = client.self[sfK];\n  }\n  delete client.self;\n}\nif (client.selfWant && !SF.want) { SF.want = client.selfWant; SF.wantCls = client.selfWantCls; }\nif (client.selfKeep && !SF.keep) SF.keep = client.selfKeep;\nvar sfOld = [\"selfWant\", \"selfWantCls\", \"selfKeep\", \"selfArgs\"];\nfor (var sfI = 0; sfI < sfOld.length; sfI++) { if (client[sfOld[sfI]] !== undefined) delete client[sfOld[sfI]]; }\n\n// One-time migration: my_name (set by the old SETNAME) -> self_name, the\n// optional name override for the tab title. Nothing else in Loom reads it.\nvar sfMy;\ntry { sfMy = get_variable(\"my_name\"); } catch (e) { sfMy = undefined; }\nif (sfMy !== undefined && sfMy !== null) {\n  var sfHave;\n  try { sfHave = get_variable(\"self_name\"); } catch (e) { sfHave = undefined; }\n  if ((sfHave === undefined || sfHave === null || sfHave === \"\") && String(sfMy) !== \"\" && String(sfMy) !== \"undefined\") set_variable(\"self_name\", String(sfMy));\n  delete_variable(\"my_name\");\n}\n\n// Live state, filled from GMCP and SCORE.\nif (!SF.affs) SF.affs = {};\nif (!SF.defs) SF.defs = {};\nif (!SF.lost) SF.lost = {};\nif (!SF.stats) SF.stats = [];\nif (SF.statsKey === undefined) SF.statsKey = \"\";\nif (!SF.info) SF.info = {};\nif (!SF.score) SF.score = {};\nif (SF.needDiag === undefined) SF.needDiag = false;\nif (SF.seenAffs === undefined) SF.seenAffs = false;\nif (SF.seenDefs === undefined) SF.seenDefs = false;\n\nfunction sfList(name, def) {\n  var raw;\n  try { raw = get_variable(name); } catch (e) { raw = undefined; }\n  var str = (raw === undefined || raw === null) ? def : String(raw);\n  var out = {};\n  var parts = str.split(\",\");\n  for (var i = 0; i < parts.length; i++) { var n = parts[i].replace(/^\\s+|\\s+$/g, \"\").toLowerCase(); if (n) out[n] = true; }\n  return out;\n}\n// Watched defences are kept per class (dragonform counts as its own class),\n// in self_want_<class>. A class with no list yet starts from the old shared\n// self_want list, so nothing set before per-class lists is lost.\nvar sfCls = String(SF.info[\"class\"] || \"any\").toLowerCase().replace(/[^a-z0-9]+/g, \"_\");\nif (!SF.want || SF.wantCls !== sfCls) {\n  var sfRaw;\n  try { sfRaw = get_variable(\"self_want_\" + sfCls); } catch (e) { sfRaw = undefined; }\n  SF.want = (sfRaw === undefined || sfRaw === null) ? sfList(\"self_want\", \"\") : sfList(\"self_want_\" + sfCls, \"\");\n  SF.wantCls = sfCls;\n}\nif (!SF.keep) SF.keep = sfList(\"self_keep\", \"deafness,blindness,insomnia\");\n\n// The name in the tab title: self_name when set, otherwise the game's.\nvar sfName;\ntry { sfName = get_variable(\"self_name\"); } catch (e) { sfName = undefined; }\nSF.nameOverride = (sfName === undefined || sfName === null || String(sfName) === \"undefined\") ? \"\" : String(sfName);\n\n// The read-only look other packages see through loom (#47).\n//   look.explorer() -> { rank, base, dropped } once a real explorer rank is\n//     known: rank now (GMCP first, then SCORE), base the one at this page\n//     load (as the tab's arrow uses), dropped when rank is now worse (a\n//     higher number). Undefined while unknown.\nSF.look = {\n  explorer: function () {\n    var raws = [SF.info ? SF.info.explorerrank : undefined, SF.score ? SF.score.explorer : undefined], now = NaN;\n    for (var i = 0; i < raws.length; i++) {\n      var v = String(raws[i] === undefined || raws[i] === null ? \"\" : raws[i]);\n      if (/^\\s*\\d+\\s*$/.test(v) && parseInt(v, 10) > 0) { now = parseInt(v, 10); break; }\n    }\n    if (isNaN(now) || !(SF.explorerBase > 0)) return undefined;\n    return { rank: now, base: SF.explorerBase, dropped: now > SF.explorerBase };\n  }\n};\n\n// What DEFCON keeps up (#176, from defcon through loom's link defcon-self):\n// { level, defs: { name: true } }, or null when the link is off, defcon\n// isn't installed or no level is set. A separate layer from SELF WANT: it\n// never writes self_want_<class>, and its losses show only in the tab.\nSF.defconWant = function () {\n  var LL = client.loom.loom;\n  var w = (LL && LL.answer) ? LL.answer(\"self\", \"defences.wanted\") : undefined;\n  if (!w || !w.defs) return null;\n  var set = {};\n  for (var i = 0; i < w.defs.length; i++) set[w.defs[i]] = true;\n  return { level: w.level, defs: set, n: w.defs.length };\n};\n"
  },
  {
   "type": "function",
   "name": "self_render",
   "enabled": true,
   "code": "// self_render -- draws the 'Self' tab in the house style shared with Coffers, Level and the\n// rest: ink panel, serif small-caps headings, one large figure, monospace\n// ledger rows. The large figure is the affliction count, since that is the\n// thing to see first; the accent is a muted rose.\nif (!client.loom || !client.loom.self || !client.loom.self.keep) run_function(\"self_setup\", [], \"self\");\nvar S = client.loom.self;\nvar WANT = S.want;\nvar KEEP = S.keep;\n// Tab theme (#310): loom's city palette when one is on, else this tab's own colours.\nvar TH = (client.loom && client.loom.theme) || {};\nvar WARN = \"#e6c25a\";\nvar ROSE = TH.acc || \"#e0a0a8\";\nvar DEEP = TH.deep || \"#7a4a52\";\nvar TXT = TH.txt || \"#ebe2e3\";\nvar MUTED = TH.muted || \"#8f8587\";\nvar RULE = TH.rule || \"#30262a\";\nvar BG = TH.bg || \"#141012\";\nvar AFF = \"#e07a6e\";\nvar OK = \"#8fd0a0\";\nvar CYAN = \"#7fc8d8\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nvar LOST_SECS = 120;\nvar now = Math.floor(new Date().getTime() / 1000);\n\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\"); }\nfunction caps(t, c) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (c || ROSE) + ';font-size:11px;margin:0 0 3px;\">' + t + '</div>'; }\nfunction section(title, inner) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title) + inner + '</div>'; }\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">' + t + '</div>'; }\nfunction chip(t, fg, border, bg, tip, extra) {\n  return '<span title=\"' + esc(tip || \"\") + '\" style=\"display:inline-block;margin:0 4px 3px 0;padding:0 5px;border:1px solid ' + border + ';color:' + fg + ';' + (bg ? 'background:' + bg + ';' : '') + 'white-space:nowrap;' + (extra || '') + '\">' + esc(t) + '</span>';\n}\nfunction keys(o) { var a = []; for (var k in o) { if (o.hasOwnProperty(k)) { a.push(k); } } a.sort(); return a; }\n\n// A simple bust, the Self tab's counterpart of the coin stack.\nvar glyph = '<svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<circle cx=\"8\" cy=\"5\" r=\"3.3\" fill=\"' + ROSE + '\"/><path d=\"M1.5 15.5 C2 10.5 5 9.2 8 9.2 C11 9.2 14 10.5 14.5 15.5 Z\" fill=\"' + DEEP + '\" stroke=\"' + ROSE + '\" stroke-width=\"0.8\"/></svg>';\n\nvar I = S.info || {};\nvar html = '<div id=\"loom-self\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + BG + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;min-height:100%;box-sizing:border-box;\">';\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\n// The title is the character's name: the game's (Char.Name / Char.Status),\n// unless SELF NAME set another.\nvar myName = S.nameOverride || I.name || \"Self\";\nhtml += '<div style=\"font-family:' + SERIF + ';color:' + ROSE + ';font-size:14px;letter-spacing:0.22em;\">' + glyph + esc(myName.toUpperCase()) + '</div>';\nvar right = [];\nif (I.race) { right.push(esc(I.race)); }\n// In dragonform race and class are both e.g. \"Black Dragon\": show it once.\nif (I[\"class\"] && String(I[\"class\"]).toLowerCase() !== String(I.race || \"\").toLowerCase()) { right.push(esc(I[\"class\"])); }\nif (I.level) { right.push(\"level \" + esc(String(I.level).split(\" \")[0])); }\nhtml += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + MUTED + ';font-size:11px;\">' + right.join(' &middot; ') + '</div></div>';\n\n\n// Compact columns: each column is only as wide as its rows, a label and a\n// right-aligned value with a modest gap; the columns spread across the width\n// so the last one sits against the right margin.\n// The third argument is a colour, or true for the warning colour.\nfunction cell(label, value, warn, extra) {\n  var vc = value ? (typeof warn === \"string\" ? warn : (warn ? WARN : TXT)) : MUTED;\n  return '<span style=\"color:' + MUTED + ';white-space:nowrap;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\">' + label + '</span>' +\n    '<span style=\"color:' + vc + ';text-align:right;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\">' + (value ? esc(value) : '&mdash;') + (extra || '') + '</span>';\n}\nfunction column(cells) { return '<div style=\"display:grid;grid-template-columns:auto auto;column-gap:10px;align-content:start;min-width:0;\">' + cells + '</div>'; }\nfunction columns(cols) {\n  // No wrapping: on a narrow tab the long readings wrap within their cell instead.\n  var out = '<div style=\"display:flex;justify-content:space-between;column-gap:16px;\">';\n  for (var i = 0; i < cols.length; i++) { if (cols[i]) { out += column(cols[i]); } }\n  return out + '</div>';\n}\n\n// Character: ranks on the left, organisations in the middle, the longer\n// SCORE readings on the right. Age, XP rank and explorer rank are live from\n// Char.Status; the rest only as fresh as the last SCORE.\nvar C = S.score || {};\n// Readings by exact wording: the best in green, the worst in red, a few in\n// between in yellow, anything unlisted in plain white. Add phrases as they turn up.\nvar READ = {\n  rest: { green: [\"fully rested\"], yellow: [\"slightly tired\", \"feeling fairly tired\"], red: [\"feeling quite tired\", \"badly in need of sleep\"] },\n  hunger: { green: [\"utterly satiated\"], yellow: [\"feeling a bit peckish\"], red: [\"weak from hunger\"] }\n};\nfunction readCol(kind, v) {\n  var t = READ[kind], k = String(v || \"\").toLowerCase();\n  if (!k) { return \"\"; }\n  if (t.green.indexOf(k) >= 0) { return OK; }\n  if (t.red.indexOf(k) >= 0) { return AFF; }\n  if (t.yellow.indexOf(k) >= 0) { return WARN; }\n  return TXT;\n}\n// Rank change since this page load (XP and explorer): lower is better, so a\n// drop shows as a green up arrow, a rise as a red down arrow (▲3, ▼2).\n// The readings come in order of preference (Char.Status first, then SCORE);\n// the first real rank is used, and one that isn't a number (a rank title,\n// say) or is 0 falls through to the next. With no real rank anywhere (a new\n// character reports 0) it shows \"-\" and isn't taken as the starting point,\n// so the first real rank becomes it instead of a change.\n// Returns [text, html after it].\nfunction rankDelta(raws, baseKey) {\n  var now = NaN;\n  for (var ri = 0; ri < raws.length; ri++) {\n    var rv = String(raws[ri] === undefined || raws[ri] === null ? \"\" : raws[ri]);\n    if (!/^\\s*\\d+\\s*$/.test(rv)) { continue; }\n    now = parseInt(rv, 10);\n    if (now > 0) { break; }\n  }\n  var none = !isNaN(now) && now <= 0;\n  if (none) { now = NaN; }\n  if (!isNaN(now) && (S[baseKey] === undefined || S[baseKey] <= 0)) { S[baseKey] = now; }\n  var html = \"\";\n  if (!isNaN(now) && S[baseKey] !== undefined && now !== S[baseKey]) {\n    var d = now - S[baseKey];\n    // Up the ranking (a lower number) is an up arrow; down is a down arrow.\n    html = '<span style=\"color:' + (d < 0 ? OK : AFF) + ';\">' + (d < 0 ? \"&#9650;\" : \"&#9660;\") + Math.abs(d) + '</span>';\n  }\n  // [value, delta html, delta width in characters]\n  return [none ? \"-\" : (isNaN(now) ? \"\" : String(now)), html, html ? 1 + String(Math.abs(d)).length : 0];\n}\nvar xpR = rankDelta([I.xprank, C.xprank], \"xpBase\");\nvar exR = rankDelta([I.explorerrank, C.explorer], \"explorerBase\");\n// The deltas sit in a slot of the same width after every value of this\n// column, so the numbers stay aligned whether a delta shows or not.\nvar dW = Math.max(xpR[2], exR[2]);\nfunction slot(h) { return dW ? '<span style=\"display:inline-block;width:' + (dW + 1.5) + 'ch;text-align:left;padding-left:0.7ch;box-sizing:border-box;\">' + (h || '') + '</span>' : ''; }\nvar chA = cell(\"age\", I.age || C.age || \"\", false, slot()) + cell(\"xp rank\", xpR[0], false, slot(xpR[1])) + cell(\"explorer\", exR[0], false, slot(exR[1]));\nvar chB = cell(\"city rank\", C.cityRank || \"\") +\n  cell(\"house rank\", C.houseRank || \"\") +\n  cell(\"soldier\", C.soldier ? C.soldier.toLowerCase() : \"\");\nvar chC = cell(\"rest\", C.rest || \"\", readCol(\"rest\", C.rest)) +\n  cell(\"hunger\", C.hunger || \"\", readCol(\"hunger\", C.hunger)) +\n  cell(\"sobriety\", C.sobriety || \"\", C.sobriety && !/completely sober/i.test(C.sobriety));\nvar ch = columns([chA, chB, chC]);\nif (C.t) {\n  var ago = Math.floor((now - C.t) / 60);\n  ch += '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;margin-top:2px;\">from SCORE, ' + (ago < 1 ? 'just now' : ago < 60 ? ago + 'm ago' : Math.floor(ago / 60) + 'h ago') + '</div>';\n} else {\n  ch += '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;margin-top:2px;\">SCORE fills in ranks, rest, hunger and sobriety.</div>';\n}\nhtml += section(\"Character\", ch);\n\n// Condition, from Char.Vitals: every item spread evenly over three columns,\n// filled top to bottom, general stats first and the elemental resistances\n// last (#271; until there's a layout per class).\nif (S.stats && S.stats.length) {\n  var gen = [], res = [];\n  for (var s = 0; s < S.stats.length; s++) {\n    var part = String(S.stats[s]);\n    var ci = part.indexOf(\":\");\n    var lab = ci >= 0 ? part.slice(0, ci) : part;\n    var val = ci >= 0 ? part.slice(ci + 1).replace(/^\\s+|\\s+$/g, \"\") : \"\";\n    var dim = (val === \"\" || val === \"0\" || val.toLowerCase() === \"none\");\n    // Thresholds: bleeding from 50 is red; rage 14-35 yellow, 36+ green.\n    var num = parseInt(val, 10);\n    var vcol = dim ? MUTED : TXT;\n    if (/^bleed$/i.test(lab) && num >= 50) { vcol = AFF; }\n    if (/^rage$/i.test(lab) && num >= 36) { vcol = OK; } else if (/^rage$/i.test(lab) && num >= 14) { vcol = WARN; }\n    var c2 = '<span style=\"color:' + MUTED + ';white-space:nowrap;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\">' + esc(lab) + '</span>' +\n      '<span style=\"color:' + vcol + ';text-align:right;white-space:nowrap;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\">' + esc(val || \"none\") + '</span>';\n    if (/^r(air|earth|fire|water)$/i.test(lab)) { res.push(c2); } else { gen.push(c2); }\n  }\n  var cells = gen.concat(res);\n  var per = Math.ceil(cells.length / 3);\n  var cc = [\"\", \"\", \"\"];\n  for (var k = 0; k < cells.length; k++) cc[Math.floor(k / per)] += cells[k];\n  html += section(\"Condition\", columns(cc));\n}\n\n// Afflictions: only the unwanted ones, as red chips. Ones kept on purpose\n// (deafness, blindness, insomnia) are left out, since they show among the\n// defences anyway. The row is always there, one chip high even when empty,\n// so a new affliction lands in place without pushing the tab down.\nvar affs = keys(S.affs);\nvar af = '<div style=\"min-height:18px;\">';\n// An unknown venom: a yellow \"diag\" chip at the head of the row until DIAG runs.\nif (S.needDiag) { af += chip(\"diag\", \"#1a1608\", WARN, WARN, \"A venom's effects are unknown: run DIAG\", \"font-weight:bold;\"); }\nfor (var a = 0; a < affs.length; a++) {\n  if (!KEEP[affs[a].replace(/\\s*\\(\\d+\\)$/, \"\")]) { af += chip(affs[a], \"#1a1012\", AFF, AFF, S.affs[affs[a]].desc, \"font-weight:bold;\"); }\n}\naf += '</div>';\nhtml += section(\"Afflictions\", af);\n\n// Defences: watched-but-missing first, then what is up, then what fell\n// recently, so a stripped defence is noticed rather than just absent.\n// DEFCON's wanted defences (#176) are watched too, as their own layer: their\n// missing chips are amber, yours (SELF WANT) red.\nvar DW = S.defconWant ? S.defconWant() : null;\nvar DWANT = DW ? DW.defs : {};\nvar defs = keys(S.defs);\nvar missing = [];\nfor (var w in WANT) { if (WANT.hasOwnProperty(w) && !S.defs[w]) { missing.push(w); } }\nvar dmissing = [];\nfor (var w2 in DWANT) { if (DWANT.hasOwnProperty(w2) && !WANT[w2] && !S.defs[w2]) { dmissing.push(w2); } }\nmissing.sort();\ndmissing.sort();\nvar lost = [];\nfor (var l in S.lost) { if (S.lost.hasOwnProperty(l)) { if (now - S.lost[l] <= LOST_SECS && !S.defs[l] && !WANT[l] && !DWANT[l]) { lost.push(l); } else if (now - S.lost[l] > LOST_SECS) { delete S.lost[l]; } } }\nlost.sort();\nvar db = \"\";\nif (missing.length || dmissing.length) {\n  db += '<div style=\"margin-bottom:3px;\"><span style=\"color:' + (missing.length ? AFF : WARN) + ';margin-right:6px;\">missing</span>';\n  for (var m = 0; m < missing.length; m++) { db += chip(missing[m], AFF, AFF, \"\", \"watched, not up\"); }\n  for (var m2 = 0; m2 < dmissing.length; m2++) { db += chip(dmissing[m2], WARN, WARN, \"\", \"DEFCON \" + DW.level + \" wants it, not up\"); }\n  db += '</div>';\n}\nif (defs.length) {\n  db += '<div>';\n  for (var d = 0; d < defs.length; d++) {\n    var wanted = !!WANT[defs[d]] || !!DWANT[defs[d]];\n    db += chip(defs[d], wanted ? \"#101a12\" : CYAN, wanted ? OK : \"#3d6b75\", wanted ? OK : \"\", S.defs[defs[d]].desc);\n  }\n  db += '</div>';\n} else {\n  db += quiet(S.seenDefs ? \"No defences up.\" : \"No defences reported yet. Type DEF to fill this in.\");\n}\nif (lost.length) {\n  db += '<div style=\"margin-top:3px;\"><span style=\"color:' + MUTED + ';margin-right:6px;\">just lost</span>';\n  for (var lo = 0; lo < lost.length; lo++) { db += chip(lost[lo], MUTED, RULE, \"\", \"lost \" + (now - S.lost[lost[lo]]) + \"s ago\", \"text-decoration:line-through;\"); }\n  db += '</div>';\n}\nhtml += section(\"Defences\" + (DW ? ' <span style=\"font-variant:normal;letter-spacing:0;color:' + MUTED + ';\">&middot; DEFCON ' + DW.level + '</span>' : '') + (defs.length ? ' <span style=\"font-variant:normal;letter-spacing:0;color:' + MUTED + ';\">' + (DW ? '&middot; ' : '') + defs.length + ' up</span>' : ''), db);\nhtml += '<div style=\"color:' + MUTED + ';margin-top:6px;font-family:' + SERIF + ';font-style:italic;\">DIAG, DEF and SCORE refresh the lists. SELF WANT &lt;defence&gt; watches a defence; SELF KEEP &lt;affliction&gt; hides one you keep on purpose.</div>';\nhtml += '</div>';\n// The whole tab in the panel's colour (#269), as Comms and Online do: the\n// panel fills the tab, and the tab itself takes the colour while it resizes.\ntry {\n  var sfSt = document.getElementById(\"loom-self-style\");\n  if (!sfSt) { sfSt = document.createElement(\"style\"); sfSt.id = \"loom-self-style\"; document.head.appendChild(sfSt); }\n  var sfCss = '.flexlayout__tab:has(#loom-self) { background: ' + BG + ' !important; } .flexlayout__tab:has(#loom-self) > * { min-height: 100%; }';\n  if (sfSt.textContent !== sfCss) sfSt.textContent = sfCss;\n} catch (e) {}\ntry { set_custom_tab_html(\"Self\", html); } catch (e) {}\n"
  },
  {
   "type": "function",
   "name": "self_cmd",
   "enabled": true,
   "code": "// self_cmd -- SELF and its subcommands; the words arrive in\n// client.loom.self.args (see the alias).\nif (!client.loom || !client.loom.self || !client.loom.self.keep) run_function(\"self_setup\", [], \"self\");\nvar S = client.loom.self;\nvar raw = String(S.args || \"\").replace(/^\\s+|\\s+$/g, \"\");\nvar parts = raw.length ? raw.split(/\\s+/) : [];\nvar verb = (parts[0] || \"\").toLowerCase();\nfunction say(t, c) { display_notice(\"[self] \" + t, c || \"cyan\"); }\nfunction keysOf(o) { var a = []; for (var k in o) { if (o.hasOwnProperty(k)) a.push(k); } a.sort(); return a; }\nfunction clsName() { return String(S.wantCls || \"any\").replace(/_/g, \" \"); }\nfunction saveWant() {\n  var a = keysOf(S.want);\n  try { set_variable(\"self_want_\" + S.wantCls, a.join(\",\")); } catch (e) {}\n  return a;\n}\nfunction saveKeep() {\n  var a = keysOf(S.keep);\n  try { set_variable(\"self_keep\", a.join(\",\")); } catch (e) {}\n  return a;\n}\n\nif (verb === \"\" || verb === \"status\") {\n  var I = S.info || {};\n  var who = S.nameOverride || I.name || \"(name not seen yet)\";\n  var bits = [];\n  if (I.race) bits.push(I.race);\n  if (I[\"class\"] && String(I[\"class\"]).toLowerCase() !== String(I.race || \"\").toLowerCase()) bits.push(I[\"class\"]);\n  if (I.level) bits.push(\"level \" + String(I.level).split(\" \")[0]);\n  say(who + (bits.length ? \" - \" + bits.join(\", \") : \"\") + \".\");\n  var aff = [];\n  for (var an in S.affs) { if (S.affs.hasOwnProperty(an) && !S.keep[an.replace(/\\s*\\(\\d+\\)$/, \"\")]) aff.push(an); }\n  aff.sort();\n  say(S.seenAffs ? (aff.length ? aff.length + \" affliction\" + (aff.length === 1 ? \"\" : \"s\") + \": \" + aff.join(\", \") + \".\" : \"no afflictions.\") : \"afflictions not reported yet; DIAG fills them in.\", aff.length ? \"orange\" : undefined);\n  if (S.needDiag) say(\"a venom's effects are unknown: DIAG!\", \"orange\");\n  var wl = keysOf(S.want);\n  // DEFCON's wanted defences count as watched too (#176).\n  var dw = S.defconWant ? S.defconWant() : null;\n  if (dw) { for (var dk in dw.defs) { if (dw.defs.hasOwnProperty(dk) && !S.want[dk]) wl.push(dk); } wl.sort(); }\n  var miss = [];\n  for (var wi = 0; wi < wl.length; wi++) { if (!S.defs[wl[wi]]) miss.push(wl[wi]); }\n  if (!S.seenDefs) say(\"defences not reported yet; DEF fills them in.\");\n  else say(keysOf(S.defs).length + \" defences up; watching \" + wl.length + \" as \" + clsName() + (dw ? \" at DEFCON \" + dw.level : \"\") + (miss.length ? \", missing: \" + miss.join(\", \") + \".\" : (wl.length ? \", all up.\" : \".\")), miss.length ? \"orange\" : undefined);\n  say(\"SELF HELP for commands.\");\n} else if (verb === \"help\") {\n  run_function(\"self_help\", [], \"self\");\n} else if (verb === \"want\" || verb === \"unwant\") {\n  if (parts.length < 2) { say(\"usage: SELF \" + verb.toUpperCase() + \" <defence> [more defences]\", \"orange\"); }\n  else {\n    for (var i = 1; i < parts.length; i++) { var dn = parts[i].toLowerCase(); if (verb === \"want\") S.want[dn] = true; else delete S.want[dn]; }\n    var list = saveWant();\n    say(\"watching as \" + clsName() + \": \" + (list.length ? list.join(\", \") : \"nothing\") + \".\", \"lime\");\n    run_function(\"self_render\", [], \"self\");\n  }\n} else if (verb === \"wants\") {\n  var l2 = keysOf(S.want);\n  say(\"watching as \" + clsName() + \": \" + (l2.length ? l2.join(\", \") : \"nothing\") + \".\", \"lime\");\n} else if (verb === \"keep\" || verb === \"unkeep\") {\n  if (parts.length < 2) { say(\"usage: SELF \" + verb.toUpperCase() + \" <affliction> [more]\", \"orange\"); }\n  else {\n    for (var j = 1; j < parts.length; j++) { var kn = parts[j].toLowerCase(); if (verb === \"keep\") S.keep[kn] = true; else delete S.keep[kn]; }\n    var kl = saveKeep();\n    say(\"kept on purpose: \" + (kl.length ? kl.join(\", \") : \"nothing\") + \".\", \"lime\");\n    run_function(\"self_render\", [], \"self\");\n  }\n} else if (verb === \"keeps\") {\n  var k2 = keysOf(S.keep);\n  say(\"kept on purpose: \" + (k2.length ? k2.join(\", \") : \"nothing\") + \".\", \"lime\");\n} else if (verb === \"name\") {\n  var nv = parts[1] || \"\";\n  if (!nv) {\n    say(S.nameOverride ? \"the tab says \" + S.nameOverride + \" (set with SELF NAME). SELF NAME CLEAR uses the game's name\" + (S.info.name ? \", \" + S.info.name : \"\") + \".\" : \"the tab uses the game's name\" + (S.info.name ? \", \" + S.info.name : \"\") + \". SELF NAME <name> to show another.\");\n  } else if (nv.toLowerCase() === \"clear\" || nv.toLowerCase() === \"off\") {\n    S.nameOverride = \"\";\n    try { delete_variable(\"self_name\"); } catch (e) {}\n    say(\"the tab uses the game's name\" + (S.info.name ? \", \" + S.info.name : \"\") + \".\", \"lime\");\n    run_function(\"self_render\", [], \"self\");\n  } else if (S.info.name && nv.toLowerCase() === String(S.info.name).toLowerCase()) {\n    S.nameOverride = \"\";\n    try { delete_variable(\"self_name\"); } catch (e) {}\n    say(\"that's the game's name already, so the tab just follows it.\");\n    run_function(\"self_render\", [], \"self\");\n  } else {\n    // Capitalised as the game writes names.\n    S.nameOverride = nv.charAt(0).toUpperCase() + nv.slice(1).toLowerCase();\n    set_variable(\"self_name\", S.nameOverride);\n    say(\"the tab now says \" + S.nameOverride + \".\", \"lime\");\n    run_function(\"self_render\", [], \"self\");\n  }\n} else if (verb === \"debug\") {\n  say(\"info=\" + JSON.stringify(S.info) + \" wantCls=\" + S.wantCls + \" want=\" + keysOf(S.want).join(\",\") + \" keep=\" + keysOf(S.keep).join(\",\"), \"cyan\");\n  say(\"affs=\" + keysOf(S.affs).join(\",\") + \" defs=\" + keysOf(S.defs).length + \" lost=\" + keysOf(S.lost).join(\",\") + \" seen \" + S.seenAffs + \"/\" + S.seenDefs + \" needDiag=\" + S.needDiag + \" score=\" + JSON.stringify(S.score), \"cyan\");\n} else {\n  say(\"unknown command '\" + verb + \"'. SELF HELP for commands.\", \"orange\");\n}\n"
  },
  {
   "type": "function",
   "name": "self_help",
   "enabled": true,
   "code": "// self_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[self] the Self tab follows your afflictions and defences live. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"SELF\", \"name, class, afflictions, and watched defences missing\"],\n  [\"SELF WANT <defence...>\", \"watch defences for your current class\"],\n  [\"SELF UNWANT <defence...>\", \"stop watching them\"],\n  [\"SELF WANTS\", \"the watched defences for this class\"],\n  [\"SELF KEEP <affliction...>\", \"hide afflictions you keep on purpose\"],\n  [\"SELF UNKEEP <affliction...>\", \"show them again\"],\n  [\"SELF KEEPS\", \"the afflictions kept on purpose\"],\n  [\"SELF NAME [<name>|CLEAR]\", \"name in the tab title (default: the game's)\"],\n  [\"SELF DEBUG\", \"internal state\"],\n  [\"Each class, dragonform included, keeps its own watched list; missing ones show in red and losing one is announced.\"],\n  [\"DIAG, DEF and SCORE refresh what the tab shows.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "Self",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// SELF [subcommand ...]: the one command for this package. The words go\n// through client.loom.self.args, since run_function cannot pass parameters.\nif (!client.loom || !client.loom.self || !client.loom.self.keep) run_function(\"self_setup\", [], \"self\");\nclient.loom.self.args = args[1] || \"\";\nrun_function(\"self_cmd\", [], \"self\");\n"
    }
   ],
   "text": "^self(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "Self DIAG needed",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.self || !client.loom.self.keep) run_function(\"self_setup\", [], \"self\");\nclient.loom.self.needDiag = true;\ndisplay_notice(\"[self] a venom's effects are unknown: DIAG!\", \"orange\");\nrun_function(\"self_render\", [], \"self\");"
    }
   ],
   "text": "^You are confused as to the effects of the venom\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Self DIAG done",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.self || !client.loom.self.keep) run_function(\"self_setup\", [], \"self\");\nclient.loom.self.needDiag = false;\nrun_function(\"self_render\", [], \"self\");"
    }
   ],
   "text": "^You are\\:$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Self score age",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.self || !client.loom.self.keep) run_function(\"self_setup\", [], \"self\");\nclient.loom.self.score.age = args[1];\nclient.loom.self.score.t = Math.floor(new Date().getTime() / 1000);\nrun_function(\"self_render\", [], \"self\");"
    }
   ],
   "text": "^\\|?\\s*Age\\s*:\\s*(\\d+)",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
