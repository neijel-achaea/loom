{
 "type": "group",
 "name": "self",
 "enabled": true,
 "description": "Self 0.4 - a 'Self' tab replacing the stock character panel: afflictions grouped by cure, character stats, defences with a watch list (missing ones in red, losses announced) and recently lost defences. Live from GMCP Char.Afflictions / Char.Defences / Char.Vitals / Char.Status.",
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "// Only ask for a name if none is set yet: my_name is shared with other\n// packages (fishstats reads it), so a reimport must not blank it.\nvar oiName = \"\";\ntry { oiName = String(get_variable(\"my_name\") || \"\"); } catch (e) { oiName = \"\"; }\nif (!oiName || oiName === \"undefined\") {\n  set_variable(\"my_name\", \"\");\n  display_notice(\"Use SETNAME <name> to configure your own name.\");\n}"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"Self\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\"><circle cx=\"8\" cy=\"5\" r=\"3.3\" fill=\"#e0a0a8\"/><path d=\"M1.5 15.5 C2 10.5 5 9.2 8 9.2 C11 9.2 14 10.5 14.5 15.5 Z\" fill=\"#7a4a52\" stroke=\"#e0a0a8\" stroke-width=\"0.8\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\n\nrun_function(\"self_render\", [], \"self\");"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Keeps client.self in step with GMCP. Afflictions and defences arrive as a\n// full List (on login, DIAGNOSE, DEF) and then as single Add / Remove updates;\n// the package keeps the running set. Self-contained, so it can be pasted into\n// the global onGMCP as-is if the package one never fires.\nvar sfM = \"\";\nvar sfA = null;\ntry { sfM = args.gmcp_method; sfA = args.gmcp_args; } catch (e) { sfM = \"\"; }\nif (typeof sfA === \"string\") { try { sfA = JSON.parse(sfA); } catch (e) { sfA = null; } }\nif (sfM && sfA !== null && sfA !== undefined) {\n  if (!client.self) { run_function(\"self_init\", [], \"self\"); }\n  var S = client.self;\n  var sfNow = Math.floor(new Date().getTime() / 1000);\n  var sfDirty = false;\n  var sfI;\n  if (sfM === \"Char.Afflictions.List\") {\n    S.affs = {};\n    for (sfI = 0; sfI < sfA.length; sfI++) { S.affs[sfA[sfI].name] = { cure: sfA[sfI].cure || \"\", desc: sfA[sfI].desc || \"\", t: sfNow }; }\n    S.seenAffs = true;\n    S.needDiag = false;\n    sfDirty = true;\n  } else if (sfM === \"Char.Afflictions.Add\") {\n    S.affs[sfA.name] = { cure: sfA.cure || \"\", desc: sfA.desc || \"\", t: sfNow };\n    S.seenAffs = true;\n    sfDirty = true;\n  } else if (sfM === \"Char.Afflictions.Remove\") {\n    for (sfI = 0; sfI < sfA.length; sfI++) { delete S.affs[sfA[sfI]]; }\n    sfDirty = true;\n  } else if (sfM === \"Char.Defences.List\") {\n    S.defs = {};\n    for (sfI = 0; sfI < sfA.length; sfI++) { S.defs[sfA[sfI].name] = { desc: sfA[sfI].desc || \"\", t: sfNow }; delete S.lost[sfA[sfI].name]; }\n    S.seenDefs = true;\n    sfDirty = true;\n  } else if (sfM === \"Char.Defences.Add\") {\n    S.defs[sfA.name] = { desc: sfA.desc || \"\", t: sfNow };\n    delete S.lost[sfA.name];\n    S.seenDefs = true;\n    sfDirty = true;\n  } else if (sfM === \"Char.Defences.Remove\") {\n    for (sfI = 0; sfI < sfA.length; sfI++) {\n      if (S.defs[sfA[sfI]]) {\n        S.lost[sfA[sfI]] = sfNow;\n        // A defence you asked to watch: say so out loud, not just in the tab.\n        if (client.selfWant && client.selfWant[sfA[sfI]]) { display_notice(\"[self] lost \" + sfA[sfI] + \"!\", \"#e08a78\"); }\n      }\n      delete S.defs[sfA[sfI]];\n    }\n    sfDirty = true;\n  } else if (sfM === \"Char.Vitals\" && sfA.charstats) {\n    // Vitals arrive with every prompt; redraw only when the stats change.\n    var sfKey = sfA.charstats.join(\"|\");\n    if (sfKey !== S.statsKey) { S.statsKey = sfKey; S.stats = sfA.charstats.slice(0); sfDirty = true; }\n  } else if (sfM === \"Char.Status\") {\n    var sfF = [\"name\", \"fullname\", \"level\", \"class\", \"race\", \"city\", \"house\", \"specialisation\", \"age\", \"xprank\", \"explorerrank\"];\n    for (sfI = 0; sfI < sfF.length; sfI++) { if (sfA[sfF[sfI]] !== undefined && sfA[sfF[sfI]] !== S.info[sfF[sfI]]) { S.info[sfF[sfI]] = sfA[sfF[sfI]]; sfDirty = true; } }\n  } else if (sfM === \"Char.Name\") {\n    if (sfA.name) { S.info.name = sfA.name; }\n    if (sfA.fullname) { S.info.fullname = sfA.fullname; }\n    sfDirty = true;\n  }\n  if (sfDirty) { try { run_function(\"self_render\", [], \"self\"); } catch (e) {} }\n}"
  },
  {
   "type": "function",
   "name": "self_init",
   "enabled": true,
   "code": "// Builds client.self (live state), client.selfWant (watched defences) and\n// client.selfKeep (afflictions kept on purpose) once; safe to call often.\nfunction siList(name, def) {\n  var raw;\n  try { raw = get_variable(name); } catch (e) { raw = undefined; }\n  var str = (raw === undefined || raw === null) ? def : String(raw);\n  var out = {};\n  var parts = str.split(\",\");\n  for (var i = 0; i < parts.length; i++) { var n = parts[i].replace(/^\\s+|\\s+$/g, \"\").toLowerCase(); if (n) { out[n] = true; } }\n  return out;\n}\nif (!client.self) { client.self = { affs: {}, defs: {}, lost: {}, stats: [], statsKey: \"\", info: {}, score: {}, needDiag: false, seenAffs: false, seenDefs: false }; }\nif (!client.self.score) { client.self.score = {}; }\n// Watched defences are kept per class (dragonform counts as its own class),\n// in self_want_<class>. A class with no list yet starts from the old shared\n// list, so nothing set before this change is lost.\nvar siCls = String((client.self.info && client.self.info[\"class\"]) || \"any\").toLowerCase().replace(/[^a-z0-9]+/g, \"_\");\nif (!client.selfWant || client.selfWantCls !== siCls) {\n  var siRaw;\n  try { siRaw = get_variable(\"self_want_\" + siCls); } catch (e) { siRaw = undefined; }\n  client.selfWant = (siRaw === undefined || siRaw === null) ? siList(\"self_want\", \"\") : siList(\"self_want_\" + siCls, \"\");\n  client.selfWantCls = siCls;\n}\nif (!client.selfKeep) { client.selfKeep = siList(\"self_keep\", \"deafness,blindness,insomnia\"); }"
  },
  {
   "type": "function",
   "name": "self_render",
   "enabled": true,
   "code": "// Draws the 'Self' tab in the house style shared with Coffers, Level and the\n// rest: ink panel, serif small-caps headings, one large figure, monospace\n// ledger rows. The large figure is the affliction count, since that is the\n// thing to see first; the accent is a muted rose.\nrun_function(\"self_init\", [], \"self\");\nvar S = client.self;\nvar WANT = client.selfWant;\nvar KEEP = client.selfKeep;\nvar WARN = \"#e6c25a\";\nvar ROSE = \"#e0a0a8\";\nvar DEEP = \"#7a4a52\";\nvar TXT = \"#ebe2e3\";\nvar MUTED = \"#8f8587\";\nvar RULE = \"#30262a\";\nvar AFF = \"#e07a6e\";\nvar OK = \"#8fd0a0\";\nvar CYAN = \"#7fc8d8\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nvar LOST_SECS = 120;\nvar now = Math.floor(new Date().getTime() / 1000);\n\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\"); }\nfunction caps(t, c) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (c || ROSE) + ';font-size:11px;margin:0 0 3px;\">' + t + '</div>'; }\nfunction section(title, inner) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title) + inner + '</div>'; }\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">' + t + '</div>'; }\nfunction chip(t, fg, border, bg, tip, extra) {\n  return '<span title=\"' + esc(tip || \"\") + '\" style=\"display:inline-block;margin:0 4px 3px 0;padding:0 5px;border:1px solid ' + border + ';color:' + fg + ';' + (bg ? 'background:' + bg + ';' : '') + 'white-space:nowrap;' + (extra || '') + '\">' + esc(t) + '</span>';\n}\nfunction keys(o) { var a = []; for (var k in o) { if (o.hasOwnProperty(k)) { a.push(k); } } a.sort(); return a; }\n\n// A simple bust, the Self tab's counterpart of the coin stack.\nvar glyph = '<svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<circle cx=\"8\" cy=\"5\" r=\"3.3\" fill=\"' + ROSE + '\"/><path d=\"M1.5 15.5 C2 10.5 5 9.2 8 9.2 C11 9.2 14 10.5 14.5 15.5 Z\" fill=\"' + DEEP + '\" stroke=\"' + ROSE + '\" stroke-width=\"0.8\"/></svg>';\n\nvar I = S.info || {};\nvar html = '<div style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:#141012;border:1px solid ' + RULE + ';padding:7px 8px 8px;\">';\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\n// The title is the character's name: my_name barely ever changes.\nvar myName = \"\";\ntry { myName = String(get_variable(\"my_name\") || \"\"); } catch (e) { myName = \"\"; }\nif (!myName || myName === \"undefined\") { myName = I.name || \"Self\"; }\nhtml += '<div style=\"font-family:' + SERIF + ';color:' + ROSE + ';font-size:14px;letter-spacing:0.22em;\">' + glyph + esc(myName.toUpperCase()) + '</div>';\nvar right = [];\nif (I.race) { right.push(esc(I.race)); }\n// In dragonform race and class are both e.g. \"Black Dragon\": show it once.\nif (I[\"class\"] && String(I[\"class\"]).toLowerCase() !== String(I.race || \"\").toLowerCase()) { right.push(esc(I[\"class\"])); }\nif (I.level) { right.push(\"level \" + esc(String(I.level).split(\" \")[0])); }\nhtml += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + MUTED + ';font-size:11px;\">' + right.join(' &middot; ') + '</div></div>';\n\n\n// Compact columns: each column is only as wide as its rows, a label and a\n// right-aligned value with a modest gap; the columns spread across the width\n// so the last one sits against the right margin.\n// The third argument is a colour, or true for the warning colour.\nfunction cell(label, value, warn, extra) {\n  var vc = value ? (typeof warn === \"string\" ? warn : (warn ? WARN : TXT)) : MUTED;\n  return '<span style=\"color:' + MUTED + ';white-space:nowrap;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\">' + label + '</span>' +\n    '<span style=\"color:' + vc + ';text-align:right;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\">' + (value ? esc(value) + (extra || '') : '&mdash;') + '</span>';\n}\nfunction column(cells) { return '<div style=\"display:grid;grid-template-columns:auto auto;column-gap:10px;align-content:start;min-width:0;\">' + cells + '</div>'; }\nfunction columns(cols) {\n  // No wrapping: on a narrow tab the long readings wrap within their cell instead.\n  var out = '<div style=\"display:flex;justify-content:space-between;column-gap:16px;\">';\n  for (var i = 0; i < cols.length; i++) { if (cols[i]) { out += column(cols[i]); } }\n  return out + '</div>';\n}\n\n// Character: ranks on the left, organisations in the middle, the longer\n// SCORE readings on the right. Age and XP rank are live from Char.Status;\n// the rest only as fresh as the last SCORE.\nvar C = S.score || {};\n// Readings by exact wording: the best in green, the worst in red, a few in\n// between in yellow, anything unlisted in plain white. Add phrases as they turn up.\nvar READ = {\n  rest: { green: [\"fully rested\"], yellow: [], red: [\"badly in need of sleep\"] },\n  hunger: { green: [\"utterly satiated\"], yellow: [], red: [\"weak from hunger\"] }\n};\nfunction readCol(kind, v) {\n  var t = READ[kind], k = String(v || \"\").toLowerCase();\n  if (!k) { return \"\"; }\n  if (t.green.indexOf(k) >= 0) { return OK; }\n  if (t.red.indexOf(k) >= 0) { return AFF; }\n  if (t.yellow.indexOf(k) >= 0) { return WARN; }\n  return TXT;\n}\n// XP rank change since this page load: lower is better, so a drop is green.\nvar xpNow = parseInt(I.xprank || C.xprank || \"\", 10);\nif (!isNaN(xpNow) && S.xpBase === undefined) { S.xpBase = xpNow; }\nvar xpTxt = isNaN(xpNow) ? \"\" : String(xpNow);\nvar xpHtml = \"\";\nif (!isNaN(xpNow) && S.xpBase !== undefined && xpNow !== S.xpBase) {\n  var xd = xpNow - S.xpBase;\n  xpHtml = ' <span style=\"color:' + (xd < 0 ? OK : AFF) + ';\">(' + (xd > 0 ? \"+\" : \"\") + xd + ')</span>';\n}\nvar chA = cell(\"age\", I.age || C.age || \"\") + cell(\"xp rank\", xpTxt, false, xpHtml) + cell(\"explorer\", C.explorer || \"\");\nvar chB = cell(\"city rank\", C.cityRank || \"\") +\n  cell(\"house rank\", C.houseRank || \"\") +\n  cell(\"soldier\", C.soldier ? C.soldier.toLowerCase() : \"\");\nvar chC = cell(\"rest\", C.rest || \"\", readCol(\"rest\", C.rest)) +\n  cell(\"hunger\", C.hunger || \"\", readCol(\"hunger\", C.hunger)) +\n  cell(\"sobriety\", C.sobriety || \"\", C.sobriety && !/completely sober/i.test(C.sobriety));\nvar ch = columns([chA, chB, chC]);\nif (C.t) {\n  var ago = Math.floor((now - C.t) / 60);\n  ch += '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;margin-top:2px;\">from SCORE, ' + (ago < 1 ? 'just now' : ago < 60 ? ago + 'm ago' : Math.floor(ago / 60) + 'h ago') + '</div>';\n} else {\n  ch += '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;margin-top:2px;\">SCORE fills in ranks, rest, hunger and sobriety.</div>';\n}\nhtml += section(\"Character\", ch);\n\n// Condition, from Char.Vitals: general stats on the left, the elemental\n// resistances together on the right.\nif (S.stats && S.stats.length) {\n  var gen = \"\", res = \"\";\n  for (var s = 0; s < S.stats.length; s++) {\n    var part = String(S.stats[s]);\n    var ci = part.indexOf(\":\");\n    var lab = ci >= 0 ? part.slice(0, ci) : part;\n    var val = ci >= 0 ? part.slice(ci + 1).replace(/^\\s+|\\s+$/g, \"\") : \"\";\n    var dim = (val === \"\" || val === \"0\" || val.toLowerCase() === \"none\");\n    // Thresholds: bleeding from 50 is red; rage 14-35 yellow, 36+ green.\n    var num = parseInt(val, 10);\n    var vcol = dim ? MUTED : TXT;\n    if (/^bleed$/i.test(lab) && num >= 50) { vcol = AFF; }\n    if (/^rage$/i.test(lab) && num >= 36) { vcol = OK; } else if (/^rage$/i.test(lab) && num >= 14) { vcol = WARN; }\n    var c2 = '<span style=\"color:' + MUTED + ';white-space:nowrap;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\">' + esc(lab) + '</span>' +\n      '<span style=\"color:' + vcol + ';text-align:right;white-space:nowrap;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\">' + esc(val || \"none\") + '</span>';\n    if (/^r(air|earth|fire|water)$/i.test(lab)) { res += c2; } else { gen += c2; }\n  }\n  html += section(\"Condition\", columns([gen, res]));\n}\n\n// Afflictions: only the unwanted ones, as red chips. Ones kept on purpose\n// (deafness, blindness, insomnia) are left out, since they show among the\n// defences anyway. The row is always there, one chip high even when empty,\n// so a new affliction lands in place without pushing the tab down.\nvar affs = keys(S.affs);\nvar af = '<div style=\"min-height:18px;\">';\n// An unknown venom: a yellow \"diag\" chip at the head of the row until DIAG runs.\nif (S.needDiag) { af += chip(\"diag\", \"#1a1608\", WARN, WARN, \"A venom's effects are unknown: run DIAG\", \"font-weight:bold;\"); }\nfor (var a = 0; a < affs.length; a++) {\n  if (!KEEP[affs[a].replace(/\\s*\\(\\d+\\)$/, \"\")]) { af += chip(affs[a], \"#1a1012\", AFF, AFF, S.affs[affs[a]].desc, \"font-weight:bold;\"); }\n}\naf += '</div>';\nhtml += section(\"Afflictions\", af);\n\n// Defences: watched-but-missing first, then what is up, then what fell\n// recently, so a stripped defence is noticed rather than just absent.\nvar defs = keys(S.defs);\nvar missing = [];\nfor (var w in WANT) { if (WANT.hasOwnProperty(w) && !S.defs[w]) { missing.push(w); } }\nmissing.sort();\nvar lost = [];\nfor (var l in S.lost) { if (S.lost.hasOwnProperty(l)) { if (now - S.lost[l] <= LOST_SECS && !S.defs[l] && !WANT[l]) { lost.push(l); } else if (now - S.lost[l] > LOST_SECS) { delete S.lost[l]; } } }\nlost.sort();\nvar db = \"\";\nif (missing.length) {\n  db += '<div style=\"margin-bottom:3px;\"><span style=\"color:' + AFF + ';margin-right:6px;\">missing</span>';\n  for (var m = 0; m < missing.length; m++) { db += chip(missing[m], AFF, AFF, \"\", \"watched, not up\"); }\n  db += '</div>';\n}\nif (defs.length) {\n  db += '<div>';\n  for (var d = 0; d < defs.length; d++) {\n    var wanted = !!WANT[defs[d]];\n    db += chip(defs[d], wanted ? \"#101a12\" : CYAN, wanted ? OK : \"#3d6b75\", wanted ? OK : \"\", S.defs[defs[d]].desc);\n  }\n  db += '</div>';\n} else {\n  db += quiet(S.seenDefs ? \"No defences up.\" : \"No defences reported yet. Type DEF to fill this in.\");\n}\nif (lost.length) {\n  db += '<div style=\"margin-top:3px;\"><span style=\"color:' + MUTED + ';margin-right:6px;\">just lost</span>';\n  for (var lo = 0; lo < lost.length; lo++) { db += chip(lost[lo], MUTED, RULE, \"\", \"lost \" + (now - S.lost[lost[lo]]) + \"s ago\", \"text-decoration:line-through;\"); }\n  db += '</div>';\n}\nhtml += section(\"Defences\" + (defs.length ? ' <span style=\"font-variant:normal;letter-spacing:0;color:' + MUTED + ';\">' + defs.length + ' up</span>' : ''), db);\nhtml += '<div style=\"color:' + MUTED + ';margin-top:6px;font-family:' + SERIF + ';font-style:italic;\">DIAG, DEF and SCORE refresh the lists. SELF WANT &lt;defence&gt; watches a defence; SELF KEEP &lt;affliction&gt; hides one you keep on purpose.</div>';\nhtml += '</div>';\ntry { set_custom_tab_html(\"Self\", html); } catch (e) {}"
  },
  {
   "type": "function",
   "name": "self_cmd",
   "enabled": true,
   "code": "// SELF [WANT|UNWANT <defences...>] | SELF WANTS. The alias stores the words in\n// client.selfArgs, since run_function cannot pass parameters.\nrun_function(\"self_init\", [], \"self\");\nvar W = String(client.selfArgs || \"\").replace(/^\\s+|\\s+$/g, \"\").toLowerCase();\nvar parts = W.length ? W.split(/\\s+/) : [];\nvar verb = parts[0] || \"\";\nfunction say(t, c) { display_notice(\"[self] \" + t, c || \"#e0a0a8\"); }\nfunction saveWant() {\n  var a = [];\n  for (var k in client.selfWant) { if (client.selfWant.hasOwnProperty(k)) { a.push(k); } }\n  a.sort();\n  try { set_variable(\"self_want_\" + client.selfWantCls, a.join(\",\")); } catch (e) {}\n  return a;\n}\nif (verb === \"want\" || verb === \"unwant\") {\n  if (parts.length < 2) { say(\"usage: SELF \" + verb.toUpperCase() + \" <defence> [more defences]\", \"orange\"); }\n  else {\n    for (var i = 1; i < parts.length; i++) { if (verb === \"want\") { client.selfWant[parts[i]] = true; } else { delete client.selfWant[parts[i]]; } }\n    var list = saveWant();\n    say(\"watching as \" + client.selfWantCls.replace(/_/g, \" \") + \": \" + (list.length ? list.join(\", \") : \"nothing\") + \".\");\n    run_function(\"self_render\", [], \"self\");\n  }\n}\nelse if (verb === \"keep\" || verb === \"unkeep\") {\n  if (parts.length < 2) { say(\"usage: SELF \" + verb.toUpperCase() + \" <affliction> [more]\", \"orange\"); }\n  else {\n    for (var j = 1; j < parts.length; j++) { if (verb === \"keep\") { client.selfKeep[parts[j]] = true; } else { delete client.selfKeep[parts[j]]; } }\n    var kl = [];\n    for (var kk in client.selfKeep) { if (client.selfKeep.hasOwnProperty(kk)) { kl.push(kk); } }\n    kl.sort();\n    try { set_variable(\"self_keep\", kl.join(\",\")); } catch (e) {}\n    say(\"kept on purpose: \" + (kl.length ? kl.join(\", \") : \"nothing\") + \".\");\n    run_function(\"self_render\", [], \"self\");\n  }\n}\nelse if (verb === \"wants\") { var l2 = saveWant(); say(\"watching as \" + client.selfWantCls.replace(/_/g, \" \") + \": \" + (l2.length ? l2.join(\", \") : \"nothing\") + \".\"); }\nelse {\n  say(\"the Self tab follows your afflictions and defences live. DIAG and DEF refresh the full lists.\");\n  say(\"SELF WANT <defence...> watches defences for your current class (each class, dragonform included, keeps its own list; missing ones show in red, and losing one is announced). SELF UNWANT <defence...>, SELF WANTS.\");\n  say(\"SELF KEEP <affliction...> hides afflictions you keep on purpose. SELF UNKEEP <affliction...>.\");\n}"
  },
  {
   "type": "alias",
   "name": "Self",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "client.selfArgs = args[1] || \"\";\nrun_function(\"self_cmd\", [], \"self\");"
    }
   ],
   "text": "^self(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "Self DIAG needed",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"self_init\", [], \"self\");\nclient.self.needDiag = true;\ndisplay_notice(\"[self] a venom's effects are unknown: DIAG!\", \"#e6c25a\");\nrun_function(\"self_render\", [], \"self\");"
    }
   ],
