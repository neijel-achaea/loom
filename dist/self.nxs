   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.self || !client.loom.self.keep) run_function(\"self_setup\", [], \"self\");\nclient.loom.self.score.xprank = args[1];\nclient.loom.self.score.explorer = args[2];\nclient.loom.self.score.t = Math.floor(new Date().getTime() / 1000);\nrun_function(\"self_render\", [], \"self\");\nif (client.loom.notify) client.loom.notify(\"self\");\n"
    }
   ],
   "text": "^\\|?\\s*XP Rank:\\s*(\\d+)\\s+Explorer Rank:\\s*(\\d+)",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
