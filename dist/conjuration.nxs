{
 "type": "group",
 "name": "conjuration",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"conjuration_setup\", [], \"conjuration\");\ndisplay_notice(\"[conjuration] installed. CONJURATION OUROBOROS <number> [<number>] once, then CONJURATION <sigil>. CONJURATION HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; conjuration_ouroboros is left intact.\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"conjuration_setup\", [], \"conjuration\");\n"
  },
  {
   "type": "function",
   "name": "conjuration_setup",
   "enabled": true,
   "code": "/*loom-hot conjuration f:conjuration_setup b2206978a3*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"conjuration\"];\nif (!lhH || lhH.v !== \"b2206978a3\") { run_function(\"conjuration__hot\", [], \"conjuration\"); lhH = client.loom.__hot[\"conjuration\"]; }\nlhH.f[\"f:conjuration_setup\"](args);"
  },
  {
   "type": "function",
   "name": "conjuration_help",
   "enabled": true,
   "code": "/*loom-hot conjuration f:conjuration_help b2206978a3*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"conjuration\"];\nif (!lhH || lhH.v !== \"b2206978a3\") { run_function(\"conjuration__hot\", [], \"conjuration\"); lhH = client.loom.__hot[\"conjuration\"]; }\nlhH.f[\"f:conjuration_help\"](args);"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "/*loom-hot conjuration f:onGMCP b2206978a3*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"conjuration\"];\nif (!lhH || lhH.v !== \"b2206978a3\") { run_function(\"conjuration__hot\", [], \"conjuration\"); lhH = client.loom.__hot[\"conjuration\"]; }\nlhH.f[\"f:onGMCP\"](args);"
  },
  {
   "type": "function",
   "name": "conjuration_step",
   "enabled": true,
   "code": "/*loom-hot conjuration f:conjuration_step b2206978a3*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"conjuration\"];\nif (!lhH || lhH.v !== \"b2206978a3\") { run_function(\"conjuration__hot\", [], \"conjuration\"); lhH = client.loom.__hot[\"conjuration\"]; }\nlhH.f[\"f:conjuration_step\"](args);"
  },
  {
   "type": "function",
   "name": "conjuration_next",
   "enabled": true,
   "code": "// conjuration_next -- the current step is done: move to the next one and\n// send it, or finish the ritual after the last.\nvar CJ = client.loom.conjuration;\nvar R = CJ.run;\nif (R) {\n  R.i++;\n  R.tries = 0;\n  if (R.i >= R.steps.length) {\n    display_notice(\"[conjuration] \" + R.sigil + \" sigil made.\", \"lime\");\n    CJ.run = null;\n  } else {\n    R.state = \"send\";\n    run_function(\"conjuration_step\", [], \"conjuration\");\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "conjuration_fail",
   "enabled": true,
   "code": "// conjuration_fail -- stop the ritual under way, saying at which step and why\n// (client.loom.conjuration.failWhy).\nvar CJ = client.loom.conjuration;\nvar R = CJ.run;\nif (R) {\n  display_notice(\"[conjuration] \" + R.sigil + \" ritual stopped at step \" + (R.i + 1) + \" of \" + R.steps.length + \" (\" + R.steps[R.i].cmd + \"): \" + (CJ.failWhy || \"no reply\") + \". Reagents already put in may still be in the ouroboros.\", \"orange\");\n}\nCJ.run = null;\nCJ.failWhy = \"\";\n"
  },
  {
   "type": "trigger",
   "name": "conjuration ritual",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "/*loom-hot conjuration s:1 b2206978a3*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"conjuration\"];\nif (!lhH || lhH.v !== \"b2206978a3\") { run_function(\"conjuration__hot\", [], \"conjuration\"); lhH = client.loom.__hot[\"conjuration\"]; }\nlhH.f[\"s:1\"](args);"
    }
   ],
   "text": "^(?:A somehow toneless yet beautiful sound is heard in the distance, indicating that you may begin\\.|You chant, \".*|A pure, clear tone fills the air as you ring a small silver bell\\.|The ouroboros flashes .*|You take .* sigil from .*|You must regain balance first\\.|You must wait a short while to use a say-like command again\\.|You have recovered balance on all limbs\\.)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "alias",
   "name": "conjuration",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "/*loom-hot conjuration s:2 b2206978a3*/var lhH = client.loom && client.loom.__hot && client.loom.__hot[\"conjuration\"];\nif (!lhH || lhH.v !== \"b2206978a3\") { run_function(\"conjuration__hot\", [], \"conjuration\"); lhH = client.loom.__hot[\"conjuration\"]; }\nlhH.f[\"s:2\"](args);"
    }
   ],
   "text": "^conjuration(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "function",
   "name": "conjuration__hot",
   "enabled": true,
   "code": "// conjuration__hot -- generated by tools/build.py (#136). The bodies of this package's\n// longer scripts, made once per load; each script in the package is a stub\n// that calls its body here. Edit the source in packages/conjuration/, never this.\nif (!client.loom) client.loom = {};\nif (!client.loom.__hot) client.loom.__hot = {};\nvar lhP = client.loom.__hot[\"conjuration\"] = { v: \"b2206978a3\", f: {} };\nlhP.f[\"f:conjuration_setup\"] = function (args) {\n//@hot-begin f:conjuration_setup\n// conjuration_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, the recipes and the\n// ouroboros setting. A ritual under way is client.loom.conjuration.run (see\n// conjuration_step).\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.conjuration) client.loom.conjuration = {};\nclient.loom.registry.conjuration = { version: \"0.2.4\", keyword: \"CONJURATION\", desc: \"Sigil creation rituals, one step at a time as the game is ready\" };\nvar CJ = client.loom.conjuration;\n\n// Every sigil and conjured item, by the word typed. Those with a recipe can\n// be made: reagents taken out of the rift ([count, reagent]) and put in the\n// ouroboros, then the chant, three times. Add a recipe as you learn one.\nCJ.sigils = {\n  bauble: { name: \"a scented bauble\" },\n  brooch: { name: \"a brooch of Thoth\" },\n  comprehension: { name: \"a necklace of comprehension\" },\n  concealment: { name: \"an orb of concealment\" },\n  cube: { name: \"a vibration-dampening cube\" },\n  dreamcatcher: { name: \"a dreamcatcher\" },\n  eye: { name: \"an eye sigil\" },\n  fist: { name: \"a fist sigil\", reagents: [[1, \"silver\"], [2, \"horn\"]], chant: \"fartak ishla spooz tran\" },\n  flame: { name: \"a flame sigil\", reagents: [[1, \"silver\"]], chant: \"flet lhar abe minlo eec\" },\n  key: { name: \"a key sigil\" },\n  monolith: { name: \"a monolith sigil\" },\n  mushroom: { name: \"a mushroom sigil\" },\n  negation: { name: \"a gem of negation\" },\n  orb: { name: \"a chaos-destroying orb\" },\n  pestilence: { name: \"a ring of pestilence\" },\n  star: { name: \"a star sigil\" },\n  stasis: { name: \"a bag of stasis\" },\n  whirlwind: { name: \"a whirlwind of Vastar\" }\n};\n\n// The ouroboros the reagents go into (conjuration_ouroboros), and the one\n// the finished sigil is taken from (conjuration_sigil_from), by number. With\n// no second number, the sigil is taken from the first.\nif (CJ.ouroboros === undefined) {\n  var cjO, cjF;\n  try { cjO = get_variable(\"conjuration_ouroboros\"); } catch (e) { cjO = undefined; }\n  try { cjF = get_variable(\"conjuration_sigil_from\"); } catch (e) { cjF = undefined; }\n  CJ.ouroboros = (cjO && (\"\" + cjO) !== \"undefined\") ? (\"\" + cjO) : \"\";\n  CJ.sigilFrom = (cjF && (\"\" + cjF) !== \"undefined\") ? (\"\" + cjF) : \"\";\n}\n\n//@hot-end f:conjuration_setup\n};\nlhP.f[\"f:conjuration_help\"] = function (args) {\n//@hot-begin f:conjuration_help\n// conjuration_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[conjuration] the creation rituals for the sigils you know. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"CONJURATION\", \"your ouroboros and the recipes known\"],\n  [\"CONJURATION <sigil>\", \"run its creation ritual (also CONJURATION MAKE <sigil>)\"],\n  [\"CONJURATION OUROBOROS <number> [<number>]\", \"the ouroboros the reagents go into, and the one the sigil is taken from if it's another\"],\n  [\"CONJURATION STOP\", \"abandon the ritual under way\"],\n  [\"CONJURATION LIST\", \"every sigil, and which have a recipe\"],\n  [\"CONJURATION DEBUG\", \"internal state\"],\n  [\"The ritual goes one step at a time, each when the game is ready for it; CONJURATION shows how far it has got. Nothing is sent while triggers are paused.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n\n//@hot-end f:conjuration_help\n};\nlhP.f[\"f:onGMCP\"] = function (args) {\n//@hot-begin f:onGMCP\n// Balance from Char.Vitals, for a ritual under way: a step waiting for\n// balance goes once a prompt shows it back after one showing it lost (or,\n// for a say-like bounce with balance kept, two prompts later); a ritual\n// held by paused triggers resumes; a step with no reply after 12 prompts\n// stops the ritual.\nvar cjM = \"\";\nvar cjA = null;\ntry { cjM = args.gmcp_method; cjA = args.gmcp_args; } catch (e) { cjM = \"\"; }\nif (cjM === \"Char.Vitals\" && cjA && client.loom && client.loom.conjuration && client.loom.conjuration.run) {\n  if (typeof cjA === \"string\") { try { cjA = JSON.parse(cjA); } catch (e) { cjA = null; } }\n  var CJ = client.loom.conjuration;\n  var R = CJ.run;\n  var cjB = cjA && String(cjA.bal) === \"1\";\n  R.prompts = (R.prompts || 0) + 1;\n  if (!cjB) R.sawLost = true;\n  if (R.state === \"bal\" && cjB && R.sawLost) {\n    run_function(\"conjuration_next\", [], \"conjuration\");\n  } else if (R.state === \"retry\" && cjB && (R.sawLost || R.prompts >= 2)) {\n    R.state = \"send\";\n    run_function(\"conjuration_step\", [], \"conjuration\");\n  } else if (R.state === \"held\" && get_variable(\"pauseTriggers\") !== \"on\") {\n    run_function(\"conjuration_step\", [], \"conjuration\");\n  } else if (R.state === \"expect\" && R.prompts > 12) {\n    CJ.failWhy = \"no reply from the game\";\n    run_function(\"conjuration_fail\", [], \"conjuration\");\n  }\n}\n\n//@hot-end f:onGMCP\n};\nlhP.f[\"f:conjuration_step\"] = function (args) {\n//@hot-begin f:conjuration_step\n// conjuration_step -- sends the ritual under way (client.loom.conjuration.run)\n// one step at a time. Steps that need nothing back (outr, put) go straight\n// on; a step with an expected reply waits for it (trigger_ritual), and one\n// that takes balance then waits for balance to come back (onGMCP), so the\n// server's queue only ever holds one ritual command. Nothing is sent while\n// triggers are paused; the ritual picks up again when they aren't.\n//\n// run.state: \"send\" (send step i now), \"expect\" (sent, waiting for its line),\n// \"bal\" (confirmed, waiting for balance), \"retry\" (bounced, resend step i\n// once ready), \"held\" (paused).\nvar CJ = client.loom.conjuration;\nvar R = CJ.run;\nwhile (R && (R.state === \"send\" || R.state === \"held\")) {\n  if (get_variable(\"pauseTriggers\") === \"on\") { R.state = \"held\"; break; }\n  var st = R.steps[R.i];\n  send_command(st.cmd);\n  R.prompts = 0;\n  if (st.expect) { R.state = \"expect\"; break; }\n  R.i++;\n  R.state = \"send\";\n}\n\n//@hot-end f:conjuration_step\n};\nlhP.f[\"s:1\"] = function (args) {\n//@hot-begin s:1\n// The ritual's own lines, while one is under way: each step's reply moves it\n// on; a bounce (\"must regain balance\", the say-like wait) has the step sent\n// again once ready; balance recovered lets a waiting step go.\nvar CJ = client.loom && client.loom.conjuration;\nvar R = CJ && CJ.run;\nif (R) {\n  var cjLine = String(args[0] || \"\");\n  var st = R.steps[R.i];\n  var cjBounce = /^You must regain balance first\\.|^You must wait a short while to use a say-like command again\\./.test(cjLine);\n  var cjBal = /^You have recovered balance on all limbs\\./.test(cjLine);\n  if (R.state === \"expect\" && st.expect && new RegExp(st.expect).test(cjLine)) {\n    if (st.bal) { R.state = \"bal\"; R.sawLost = false; R.prompts = 0; }\n    else run_function(\"conjuration_next\", [], \"conjuration\");\n  } else if (R.state === \"expect\" && cjBounce) {\n    R.tries = (R.tries || 0) + 1;\n    if (R.tries > 8) { CJ.failWhy = \"it kept bouncing (\" + cjLine + \")\"; run_function(\"conjuration_fail\", [], \"conjuration\"); }\n    else { R.state = \"retry\"; R.sawLost = /balance/.test(cjLine); R.prompts = 0; }\n  } else if (cjBal && (R.state === \"bal\" || R.state === \"retry\")) {\n    if (R.state === \"bal\") run_function(\"conjuration_next\", [], \"conjuration\");\n    else { R.state = \"send\"; run_function(\"conjuration_step\", [], \"conjuration\"); }\n  }\n}\n\n//@hot-end s:1\n};\nlhP.f[\"s:2\"] = function (args) {\n//@hot-begin s:2\n// CONJURATION [<sigil> | subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.conjuration || !client.loom.conjuration.sigils) run_function(\"conjuration_setup\", [], \"conjuration\");\nvar CJ = client.loom.conjuration;\nvar cjW = String(args[1] || \"\").trim().toLowerCase().split(/\\s+/);\nvar cjSub = cjW[0];\nvar cjP1 = cjW[1] || \"\";\nfunction cjSay(t, c) { display_notice(\"[conjuration] \" + t, c || \"cyan\"); }\nfunction cjKnown() { var a = []; for (var k in CJ.sigils) { if (CJ.sigils.hasOwnProperty(k) && CJ.sigils[k].chant) a.push(k); } return a; }\nfunction cjWhere() {\n  if (!CJ.ouroboros) return \"no ouroboros set: CONJURATION OUROBOROS <number> [<number the sigil is taken from>].\";\n  return \"reagents go into ouroboros \" + CJ.ouroboros + \"; the sigil is taken from \" + (CJ.sigilFrom ? \"ouroboros \" + CJ.sigilFrom : \"the same one\") + \".\";\n}\nfunction cjAll() { var a = []; for (var k in CJ.sigils) { if (CJ.sigils.hasOwnProperty(k)) a.push(k); } return a; }\n// MAKE is optional: CONJURATION FLAME and CONJURATION MAKE FLAME do the same.\nif (cjSub === \"make\") { cjSub = cjP1; cjP1 = \"\"; }\n\nif (cjSub === \"\" || cjSub === \"status\") {\n  cjSay(cjWhere(), CJ.ouroboros ? \"cyan\" : \"orange\");\n  if (CJ.run) {\n    var cjS0 = CJ.run.steps[CJ.run.i];\n    var cjCh = 0, cjChN = 0;\n    for (var cjK = 0; cjK < CJ.run.steps.length; cjK++) { if (/^chant /.test(CJ.run.steps[cjK].cmd)) { cjChN++; if (cjK <= CJ.run.i) cjCh++; } }\n    cjSay(\"making a \" + CJ.run.sigil + \" sigil: step \" + (CJ.run.i + 1) + \" of \" + CJ.run.steps.length + \" (\" + cjS0.cmd + (/^chant /.test(cjS0.cmd) ? \", chant \" + cjCh + \" of \" + cjChN : \"\") + \"), \" + ({ send: \"sending\", expect: \"waiting for the game\", bal: \"waiting for balance\", retry: \"waiting to send it again\", held: \"held while triggers are paused\" })[CJ.run.state] + \". CONJURATION STOP abandons it.\");\n  }\n  cjSay(\"recipes known: \" + cjKnown().join(\", \") + \". CONJURATION <sigil> to make one; CONJURATION HELP for commands.\");\n} else if (cjSub === \"help\") {\n  run_function(\"conjuration_help\", [], \"conjuration\");\n} else if (cjSub === \"ouroboros\") {\n  var cjN = cjP1.replace(/^ouroboros/, \"\");\n  var cjM = (cjW[2] || \"\").replace(/^ouroboros/, \"\");\n  if (!cjN) {\n    cjSay(cjWhere());\n  } else if (!/^\\d+$/.test(cjN) || (cjM && !/^\\d+$/.test(cjM))) {\n    cjSay(\"give the ouroboros numbers, e.g. CONJURATION OUROBOROS 263287, or 263287 275085 if the sigil appears in a second one.\", \"orange\");\n  } else {\n    CJ.ouroboros = cjN;\n    CJ.sigilFrom = (cjM && cjM !== cjN) ? cjM : \"\";\n    set_variable(\"conjuration_ouroboros\", cjN);\n    if (CJ.sigilFrom) set_variable(\"conjuration_sigil_from\", CJ.sigilFrom);\n    else { try { delete_variable(\"conjuration_sigil_from\"); } catch (e) {} }\n    cjSay(cjWhere());\n  }\n} else if (cjSub === \"stop\") {\n  if (!CJ.run) cjSay(\"no ritual under way.\");\n  else { CJ.failWhy = \"stopped by you\"; run_function(\"conjuration_fail\", [], \"conjuration\"); }\n} else if (cjSub === \"list\") {\n  var cjL = cjAll();\n  for (var cjI = 0; cjI < cjL.length; cjI++) {\n    var cjS = CJ.sigils[cjL[cjI]];\n    display_notice(\"  \" + (cjL[cjI] + \"              \").slice(0, 14) + cjS.name + (cjS.chant ? \"\" : \"  (no recipe yet)\"), cjS.chant ? \"cyan\" : \"#889999\");\n  }\n} else if (cjSub === \"debug\") {\n  cjSay(\"ouroboros=\" + CJ.ouroboros + \" sigilFrom=\" + CJ.sigilFrom + \" saved=\" + get_variable(\"conjuration_ouroboros\") + \"/\" + get_variable(\"conjuration_sigil_from\") + \" pause=\" + (get_variable(\"pauseTriggers\") || \"unset\") + \" known=\" + cjKnown().join(\",\") + \" run=\" + (CJ.run ? CJ.run.sigil + \" i=\" + CJ.run.i + \" state=\" + CJ.run.state + \" tries=\" + CJ.run.tries + \" prompts=\" + CJ.run.prompts : \"none\"), \"orange\");\n} else if (CJ.sigils[cjSub]) {\n  var S = CJ.sigils[cjSub];\n  if (!S.chant) {\n    cjSay(\"insufficient skill to create \" + S.name + \".\", \"orange\");\n  } else if (!CJ.ouroboros) {\n    cjSay(\"set your ouroboros first: CONJURATION OUROBOROS <number>.\", \"orange\");\n  } else if (get_variable(\"pauseTriggers\") === \"on\") {\n    cjSay(\"triggers are paused, so nothing was sent.\", \"orange\");\n  } else if (CJ.run) {\n    cjSay(\"a \" + CJ.run.sigil + \" ritual is under way. CONJURATION STOP to abandon it.\", \"orange\");\n  } else {\n    // The ritual as steps: [command, the reply that confirms it (a regular\n    // expression), whether it takes balance].\n    var cjO = \"ouroboros\" + CJ.ouroboros;\n    var cjSteps = [];\n    for (var cjR = 0; cjR < S.reagents.length; cjR++) {\n      cjSteps.push({ cmd: \"outr \" + (S.reagents[cjR][0] > 1 ? S.reagents[cjR][0] + \" \" : \"\") + S.reagents[cjR][1] });\n    }\n    for (var cjP = 0; cjP < S.reagents.length; cjP++) {\n      for (var cjQ = 0; cjQ < S.reagents[cjP][0]; cjQ++) cjSteps.push({ cmd: \"put \" + S.reagents[cjP][1] + \" in \" + cjO });\n    }\n    cjSteps.push({ cmd: \"begin creation of \" + cjSub + \" sigil\", expect: \"indicating that you may begin\" });\n    for (var cjC = 0; cjC < 3; cjC++) cjSteps.push({ cmd: \"chant \" + S.chant, expect: \"^You chant, \\\"\", bal: true });\n    cjSteps.push({ cmd: \"ring bell\", expect: \"as you ring a small silver bell\", bal: true });\n    cjSteps.push({ cmd: \"end ritual\", expect: \"^The ouroboros flashes\" });\n    cjSteps.push({ cmd: \"get sigil from ouroboros\" + (CJ.sigilFrom || CJ.ouroboros), expect: \"^You take .*sigil from\" });\n    CJ.run = { sigil: cjSub, steps: cjSteps, i: 0, state: \"send\", tries: 0, prompts: 0, sawLost: false };\n    cjSay(\"making a \" + cjSub + \" sigil, one step at a time (\" + cjSteps.length + \" steps).\");\n    run_function(\"conjuration_step\", [], \"conjuration\");\n  }\n} else {\n  cjSay(\"unknown sigil or command '\" + cjSub + \"'. Sigils: \" + cjAll().join(\", \") + \". CONJURATION HELP for commands.\", \"orange\");\n}\n\n//@hot-end s:2\n};\n"
  }
 ],
 "description": "Sigil creation rituals, one step at a time as the game is ready"
}