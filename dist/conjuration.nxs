{
 "type": "group",
 "name": "conjuration",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"conjuration_setup\", [], \"conjuration\");\ndisplay_notice(\"[conjuration] installed. CONJURATION OUROBOROS <number> [<number>] once, then CONJURATION <sigil>. CONJURATION HELP for commands.\", \"lime\");\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"conjuration_gmcp\", [], \"conjuration\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; conjuration_ouroboros is left intact.\n// Leave LOOM and the integrations at once, not at the next load (#137):\n// loom takes the entry out and redraws the tabs that showed this package's answers.\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"conjuration\");\n  else delete client.loom.registry.conjuration;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"conjuration_setup\", [], \"conjuration\");\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"conjuration_gmcp\", [], \"conjuration\");\n"
  },
  {
   "type": "function",
   "name": "conjuration_gmcp",
   "enabled": true,
   "code": "// conjuration_gmcp -- the work behind onGMCP, as a function made once per load\n// (client.loom.hooks.conjuration.gmcp). Nexus compiles a script afresh every time it\n// runs, and long ones cost on every GMCP message, so the script itself stays two\n// lines and calls this (#136). Run from onLoad and onInstall, so a reimport\n// replaces it.\nif (!client.loom) client.loom = {};\nif (!client.loom.hooks) client.loom.hooks = {};\nif (!client.loom.hooks.conjuration) client.loom.hooks.conjuration = {};\nclient.loom.hooks.conjuration.gmcp = function (args) {\n  // Balance from Char.Vitals, for a ritual under way: a step waiting for\n  // balance goes once a prompt shows it back after one showing it lost (or,\n  // for a say-like bounce with balance kept, two prompts later); a ritual\n  // held by paused triggers resumes; a step with no reply after 12 prompts\n  // stops the ritual.\n  var cjM = \"\";\n  var cjA = null;\n  try { cjM = args.gmcp_method; cjA = args.gmcp_args; } catch (e) { cjM = \"\"; }\n  if (cjM === \"Char.Defences.List\" || cjM === \"Char.Defences.Add\" || cjM === \"Char.Defences.Remove\") {\n    var cjD = args.gmcp_args;\n    if (typeof cjD === \"string\") { try { cjD = JSON.parse(cjD); } catch (e) { cjD = null; } }\n    if (client.loom && client.loom.conjuration && cjD && typeof cjD == \"object\") {\n      var cjC = client.loom.conjuration;\n      if (cjM === \"Char.Defences.List\" && cjD.length !== undefined) {\n        cjC.selfish = false;\n        for (var cjI = 0; cjI < cjD.length; cjI++) { if (cjD[cjI] && cjD[cjI].name == \"selfishness\") cjC.selfish = true; }\n      } else if (cjM === \"Char.Defences.Add\" && cjD.name == \"selfishness\") {\n        cjC.selfish = true;\n      } else if (cjM === \"Char.Defences.Remove\" && cjD.length !== undefined) {\n        for (var cjJ = 0; cjJ < cjD.length; cjJ++) { if (cjD[cjJ] == \"selfishness\") cjC.selfish = false; }\n      }\n    }\n  }\n  if (cjM === \"Char.Vitals\" && cjA && client.loom && client.loom.conjuration && client.loom.conjuration.run) {\n    if (typeof cjA === \"string\") { try { cjA = JSON.parse(cjA); } catch (e) { cjA = null; } }\n    var CJ = client.loom.conjuration;\n    var R = CJ.run;\n    var cjB = cjA && String(cjA.bal) === \"1\";\n    var cjE = cjA && String(cjA.eq) === \"1\";\n    var cjSt = R.steps[R.i] || {};\n    R.prompts = (R.prompts || 0) + 1;\n    if (!cjB) R.sawLost = true;\n    if (R.state === \"rift\" && R.prompts >= 1) {\n      // The prompt after the rift list (or after a rift with no commodities).\n      run_function(\"conjuration_riftcheck\", [], \"conjuration\");\n    } else if (R.state === \"bal\" && cjSt.eq) {\n      // Generosity and selfishness: on as soon as a prompt shows equilibrium.\n      if (cjE) run_function(\"conjuration_next\", [], \"conjuration\");\n    } else if (R.state === \"bal\" && cjB && (R.sawLost || R.prompts >= 2)) {\n      // Balance back after the action took it, or never taken at all\n      // (two prompts with balance up, for actions that don't use it).\n      run_function(\"conjuration_next\", [], \"conjuration\");\n    } else if (R.state === \"retry\" && cjB && (R.sawLost || R.prompts >= 2)) {\n      R.state = \"send\";\n      run_function(\"conjuration_step\", [], \"conjuration\");\n    } else if (R.state === \"held\" && get_variable(\"pauseTriggers\") !== \"on\") {\n      run_function(\"conjuration_step\", [], \"conjuration\");\n    } else if (R.state === \"expect\" && R.prompts > 12) {\n      CJ.failWhy = \"no reply from the game\";\n      run_function(\"conjuration_fail\", [], \"conjuration\");\n    }\n  }\n};\n"
  },
  {
   "type": "function",
   "name": "conjuration_setup",
   "enabled": true,
   "code": "// conjuration_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, the recipes and the\n// ouroboros setting. A ritual under way is client.loom.conjuration.run (see\n// conjuration_step).\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.conjuration) client.loom.conjuration = {};\nclient.loom.registry.conjuration = { version: \"1.1.0\", keyword: \"CONJURATION\", desc: \"Sigil creation rituals, one step at a time as the game is ready\" };\nvar CJ = client.loom.conjuration;\n\n// Every sigil and conjured item, by the word typed. Those with a recipe can\n// be made: reagents taken out of the rift ([count, reagent]) and put in the\n// ouroboros, then the actions as the AB scroll gives them (CJ.parseActions).\n// begin: what follows BEGIN CREATION OF (default \"<word> sigil\"); take: what\n// is taken from the ouroboros at the end (default \"sigil\"). chant: the phrase\n// for a bare action 2. Add a recipe as you learn one.\nCJ.sigils = {\n  bauble: { name: \"a scented bauble\" },\n  brooch: { name: \"a brooch of Thoth\", begin: \"brooch of thoth\", take: \"brooch\", reagents: [[1, \"ice\"], [2, \"dust\"], [1, \"horn\"], [2, \"silver\"]], actions: 'chant \"mortis troy tenkla\", chant \"mortis troy tenklu\", chant \"mortis troy tenkli\", 3x6' },\n  comprehension: { name: \"a necklace of comprehension\", begin: \"necklace of comprehension\", take: \"necklace\", reagents: [[2, \"ice\"], [3, \"gold\"], [4, \"silver\"], [3, \"horn\"]], actions: \"3x10, 9, 16, 1, 2x13, 4, 9, 15\" },\n  concealment: { name: \"an orb of concealment\" },\n  cube: { name: \"a vibration-dampening cube\" },\n  dreamcatcher: { name: \"a dreamcatcher\" },\n  eye: { name: \"an eye sigil\", reagents: [[1, \"obsidian\"]], actions: \"17, 1\" },\n  fist: { name: \"a fist sigil\", reagents: [[1, \"silver\"], [2, \"horn\"]], chant: \"fartak ishla spooz tran\", actions: \"3x2,1\" },\n  flame: { name: \"a flame sigil\", reagents: [[1, \"silver\"]], chant: \"flet lhar abe minlo eec\", actions: \"3x2,1\" },\n  key: { name: \"a key sigil\", reagents: [[1, \"gold\"]], actions: '3xchant \"krolop escit yall\", 1' },\n  monolith: { name: \"a monolith sigil\" },\n  mushroom: { name: \"a mushroom sigil\", reagents: [[1, \"ice\"]], actions: '3xchant \"mil usra shal hract reed oom oon mez\", 1' },\n  negation: { name: \"a gem of negation\" },\n  orb: { name: \"a chaos-destroying orb\" },\n  pestilence: { name: \"a ring of pestilence\" },\n  star: { name: \"a star sigil\" },\n  stasis: { name: \"a bag of stasis\" },\n  whirlwind: { name: \"a whirlwind of Vastar\" }\n};\n\n// The ritual actions by number (HELP CONJURATION): the command, and the\n// game's line confirming it (a regular expression; null until someone sends\n// it in, and a recipe needing it can't be run yet). Every action takes\n// balance. A new line also goes into the \"conjuration ritual\" trigger.\n// carry: something the action uses from your inventory, one per use (kola\n// for CRUSH KOLA): taken out of the rift with the reagents, never put in.\nCJ.acts = {\n  1: { cmd: \"ring bell\", expect: \"as you ring a small silver bell\" },\n  2: { cmd: \"chant\", expect: \"^You chant, \\\"\" },\n  3: { cmd: \"bang drum\", expect: \"^You strike a drum with a firm hand\" },\n  4: { cmd: \"spin around thrice\", expect: \"^You quickly spin around counter-clockwise, three times\" },\n  5: { cmd: \"light candle\", expect: \"^You light a candle from one of the braziers\" },\n  6: { cmd: \"clap hands\", expect: \"^You clap your hands quickly and suddenly\\\\.\" },\n  7: { cmd: \"burn the polygon\", expect: \"^You pen a seventeen-sided polygon on a piece of paper and burn it\" },\n  8: { cmd: \"point sword\", expect: null },\n  9: { cmd: \"burn incense\", expect: \"^You place some incense in a burner, and light it\" },\n  10: { cmd: \"play horn\", expect: \"^You pick up a horn and blow a resounding blast\" },\n  11: { cmd: \"strum lute\", expect: \"^You strum a lute\" },\n  12: { cmd: \"flipcoin\", expect: null },\n  13: { cmd: \"roll dice\", expect: \"^You roll the dice and as they tumble to a stop\" },\n  14: { cmd: \"wave arms\", expect: \"^You wave your arms frantically\" },\n  15: { cmd: \"crush kola\", expect: \"^You take a kola nut, crush it in your fist\", carry: \"kola\" },\n  16: { cmd: \"wave feather\", expect: \"^Taking an eagle's feather from a nearby table, you wave it over the ouroboros\" },\n  17: { cmd: \"square the circle\", expect: \"^You trace a circle in the air, leaving a trail of fire behind you\" }\n};\n\n// The AB scroll's actions field as steps: comma-separated; \"3x6\" = action 6\n// three times, \"9\" = once, chant \"words\" = chant those words, 3xchant\n// \"words\" = three times. A bare 2 chants\n// the recipe's chant. {steps: [{cmd, expect, bal}], carry: [[count, item]]}\n// or {err: \"why\"}.\nCJ.parseActions = function (text, chant) {\n  var out = [], carry = {};\n  var parts = String(text || \"\").match(/(?:[^,\"]|\"[^\"]*\")+/g) || [];\n  if (!parts.length) return { err: \"no actions\" };\n  for (var i = 0; i < parts.length; i++) {\n    var p = parts[i].replace(/^\\s+|\\s+$/g, \"\");\n    var m;\n    if ((m = /^(?:(\\d+)\\s*x\\s*)?chant\\s+\"([^\"]+)\"$/i.exec(p))) {\n      var nc = m[1] ? +m[1] : 1;\n      if (nc < 1 || nc > 30) return { err: \"action '\" + p + \"' not understood\" };\n      for (var c = 0; c < nc; c++) out.push({ cmd: \"chant \" + m[2].toLowerCase(), expect: CJ.acts[2].expect, bal: true });\n    } else if ((m = /^(?:(\\d+)\\s*x\\s*)?(\\d+)$/i.exec(p))) {\n      var n = m[1] ? +m[1] : 1;\n      var a = CJ.acts[+m[2]];\n      if (!a || n < 1 || n > 30) return { err: \"action '\" + p + \"' not understood\" };\n      if (!a.expect) return { err: \"the game's line for \" + a.cmd.toUpperCase() + \" isn't known yet\" };\n      if (+m[2] === 2 && !chant) return { err: \"action 2 needs the recipe's chant\" };\n      for (var k = 0; k < n; k++) out.push({ cmd: +m[2] === 2 ? \"chant \" + chant : a.cmd, expect: a.expect, bal: true });\n      if (a.carry) carry[a.carry] = (carry[a.carry] || 0) + n;\n    } else {\n      return { err: \"action '\" + p + \"' not understood\" };\n    }\n  }\n  var cl = [];\n  for (var ci in carry) { if (carry.hasOwnProperty(ci)) cl.push([carry[ci], ci]); }\n  return { steps: out, carry: cl };\n};\n\n// The game answers each OUTR and PUT on its own (and with its own prompt),\n// so each waits for its line like any other step.\nCJ.outrLine = \"^You remove [\\\\d,]+ .*, bringing the total in the rift to\";\nCJ.putLine = \"^You put .* into .*ouroboros\";\n\n// Selfishness, from Char.Defences (true/false; null until the game says).\n// Reagents can't go into the ouroboros while it's up, so the ritual sends\n// GENEROSITY first and SELFISHNESS again once they're in.\nif (CJ.selfish === undefined) CJ.selfish = (client.loom.security && typeof client.loom.security.selfish == \"boolean\") ? client.loom.security.selfish : null;\n\n// Have the rift (from IR COMMODITIES, {word: count}) cover the reagents?\n// A reagent matches a rift entry carrying it as a whole word (\"silver\" is\n// \"silver bar\", \"horn\" is \"piece of stag's horn\"). \"\" when it does, else why.\nCJ.riftShort = function (reagents, have) {\n  var miss = [];\n  for (var i = 0; i < reagents.length; i++) {\n    var want = reagents[i][0], word = reagents[i][1].toLowerCase(), got = 0;\n    for (var k in have) {\n      if (have.hasOwnProperty(k) && new RegExp(\"(^|\\\\s)\" + word.replace(/[^a-z' ]/g, \"\") + \"(\\\\s|$)\").test(k)) got += have[k];\n    }\n    if (got < want) miss.push(word + \" (\" + got + \" of \" + want + \")\");\n  }\n  return miss.length ? \"not enough in the rift: \" + miss.join(\", \") : \"\";\n};\n\n// The ouroboros the reagents go into (conjuration_ouroboros), and the one\n// the finished sigil is taken from (conjuration_sigil_from), by number. With\n// no second number, the sigil is taken from the first.\nif (CJ.ouroboros === undefined) {\n  var cjO, cjF;\n  try { cjO = get_variable(\"conjuration_ouroboros\"); } catch (e) { cjO = undefined; }\n  try { cjF = get_variable(\"conjuration_sigil_from\"); } catch (e) { cjF = undefined; }\n  CJ.ouroboros = (cjO && (\"\" + cjO) !== \"undefined\") ? (\"\" + cjO) : \"\";\n  CJ.sigilFrom = (cjF && (\"\" + cjF) !== \"undefined\") ? (\"\" + cjF) : \"\";\n}\n"
  },
  {
   "type": "function",
   "name": "conjuration_help",
   "enabled": true,
   "code": "// conjuration_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[conjuration] the creation rituals for the sigils you know. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"CONJURATION\", \"your ouroboros and the recipes known\"],\n  [\"CONJURATION <sigil>\", \"run its creation ritual (also CONJURATION MAKE <sigil>)\"],\n  [\"CONJURATION OUROBOROS <number> [<number>]\", \"the ouroboros the reagents go into, and the one the sigil is taken from if it's another\"],\n  [\"CONJURATION STOP\", \"abandon the ritual under way\"],\n  [\"CONJURATION LIST\", \"every sigil, and which have a recipe\"],\n  [\"CONJURATION DEBUG\", \"internal state\"],\n  [\"The ritual goes one step at a time, each when the game is ready for it; CONJURATION shows how far it has got. Nothing is sent while triggers are paused.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// onGMCP: the work is in conjuration_gmcp (#136: this runs on every GMCP message, so it stays short).\nvar lkH = client.loom && client.loom.hooks && client.loom.hooks.conjuration;\nif (!lkH || !lkH.gmcp) { run_function(\"conjuration_gmcp\", [], \"conjuration\"); lkH = client.loom.hooks.conjuration; }\nlkH.gmcp(args);\n"
  },
  {
   "type": "function",
   "name": "conjuration_step",
   "enabled": true,
   "code": "// conjuration_step -- sends the ritual under way (client.loom.conjuration.run)\n// one step at a time. Each step waits for its reply (trigger_ritual), and\n// one that takes balance then waits for balance to come back (onGMCP), so\n// the server's queue only ever holds one ritual command. Nothing is sent while\n// triggers are paused; the ritual picks up again when they aren't.\n//\n// run.state: \"send\" (send step i now), \"expect\" (sent, waiting for its line),\n// \"bal\" (confirmed, waiting for balance), \"retry\" (bounced, resend step i\n// once ready), \"held\" (paused).\nvar CJ = client.loom.conjuration;\nvar R = CJ.run;\nwhile (R && (R.state === \"send\" || R.state === \"held\")) {\n  if (get_variable(\"pauseTriggers\") === \"on\") { R.state = \"held\"; break; }\n  var st = R.steps[R.i];\n  send_command(st.cmd);\n  R.prompts = 0;\n  if (st.expect) { R.state = \"expect\"; break; }\n  R.i++;\n  R.state = \"send\";\n}\n"
  },
  {
   "type": "function",
   "name": "conjuration_next",
   "enabled": true,
   "code": "// conjuration_next -- the current step is done: move to the next one and\n// send it, or finish the ritual after the last.\nvar CJ = client.loom.conjuration;\nvar R = CJ.run;\nif (R) {\n  R.i++;\n  R.tries = 0;\n  if (R.i >= R.steps.length) {\n    display_notice(\"[conjuration] \" + (CJ.sigils[R.sigil] ? CJ.sigils[R.sigil].name : R.sigil) + \" made.\", \"lime\");\n    CJ.run = null;\n  } else {\n    R.state = \"send\";\n    run_function(\"conjuration_step\", [], \"conjuration\");\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "conjuration_riftcheck",
   "enabled": true,
   "code": "// conjuration_riftcheck -- a part of the rift has been read into run.have\n// (IR COMMODITIES, then IR PLANTS when the actions use kola). After the\n// last part: go on if the rift holds everything, else stop before anything\n// is taken out.\nvar CJ = client.loom.conjuration;\nvar R = CJ.run;\nif (R && R.state === \"rift\") {\n  if (!R.steps[R.i].riftLast) { run_function(\"conjuration_next\", [], \"conjuration\"); }\n  else {\n    var cjWhy = CJ.riftShort(R.reagents, R.have);\n    if (cjWhy) { CJ.failWhy = cjWhy; run_function(\"conjuration_fail\", [], \"conjuration\"); }\n    else run_function(\"conjuration_next\", [], \"conjuration\");\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "conjuration_fail",
   "enabled": true,
   "code": "// conjuration_fail -- stop the ritual under way, saying at which step and why\n// (client.loom.conjuration.failWhy).\nvar CJ = client.loom.conjuration;\nvar R = CJ.run;\nif (R) {\n  var cjTook = false;\n  for (var cjI = 0; cjI < R.i; cjI++) { if (/^outr /.test(R.steps[cjI].cmd)) cjTook = true; }\n  if (/^outr /.test(R.steps[R.i].cmd)) cjTook = true;\n  display_notice(\"[conjuration] \" + R.sigil + \" ritual stopped at step \" + (R.i + 1) + \" of \" + R.steps.length + \" (\" + R.steps[R.i].cmd + \"): \" + (CJ.failWhy || \"no reply\") + \".\" + (cjTook ? \" Reagents already taken out or put in may still be in your inventory or the ouroboros.\" : \" Nothing was taken from the rift.\"), \"orange\");\n}\nCJ.run = null;\nCJ.failWhy = \"\";\n"
  },
  {
   "type": "trigger",
   "name": "conjuration ritual",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// The ritual's own lines, while one is under way: each step's reply moves it\n// on; a bounce (\"must regain balance\", the say-like wait) has the step sent\n// again once ready; balance recovered lets a waiting step go.\nvar CJ = client.loom && client.loom.conjuration;\nvar R = CJ && CJ.run;\nif (R) {\n  var cjLine = String(args[0] || \"\");\n  var st = R.steps[R.i];\n  var cjBounce = /^You must regain balance first\\.|^You must wait a short while to use a say-like command again\\./.test(cjLine);\n  var cjBal = /^You have recovered balance on all limbs\\./.test(cjLine);\n  if (R.state === \"rift\") {\n    // IR COMMODITIES: rows \"[ 20] coal [ 61] dust\", ended by the rule\n    // after them (or the next prompt, in onGMCP).\n    var cjRow, cjRe = /\\[\\s*([\\d,]+)\\]\\s+([^\\[]+?)\\s*(?=\\[|$)/g, cjAny = false;\n    while ((cjRow = cjRe.exec(cjLine))) { R.have[cjRow[2].toLowerCase()] = +cjRow[1].replace(/,/g, \"\"); cjAny = true; }\n    if (cjAny) R.rows = (R.rows || 0) + 1;\n    else if (/^-{10,}$/.test(cjLine) && R.rows) run_function(\"conjuration_riftcheck\", [], \"conjuration\");\n  } else if (R.state === \"expect\" && st.expect && new RegExp(st.expect).test(cjLine)) {\n    if (st.rift) { R.state = \"rift\"; R.rows = 0; R.prompts = 0; }\n    else if (st.bal || st.eq) { R.state = \"bal\"; R.sawLost = false; R.prompts = 0; }\n    else run_function(\"conjuration_next\", [], \"conjuration\");\n  } else if (R.state === \"expect\" && cjBounce) {\n    R.tries = (R.tries || 0) + 1;\n    if (R.tries > 8) { CJ.failWhy = \"it kept bouncing (\" + cjLine + \")\"; run_function(\"conjuration_fail\", [], \"conjuration\"); }\n    else { R.state = \"retry\"; R.sawLost = /balance/.test(cjLine); R.prompts = 0; }\n  } else if (cjBal && (R.state === \"bal\" || R.state === \"retry\")) {\n    if (R.state === \"bal\") run_function(\"conjuration_next\", [], \"conjuration\");\n    else { R.state = \"send\"; run_function(\"conjuration_step\", [], \"conjuration\"); }\n  }\n}\n"
    }
   ],
   "text": "^(?:A somehow toneless yet beautiful sound is heard in the distance, indicating that you may begin\\.|You chant, \".*|A pure, clear tone fills the air as you ring a small silver bell\\.|The ouroboros flashes .*|You take .* from .*ouroboros.*|You must regain balance first\\.|You must wait a short while to use a say-like command again\\.|You have recovered balance on all limbs\\.|Glancing into your rift, you see:|\\[\\s*[\\d,]+\\] .*|-{10,}|A feeling of generosity spreads throughout you\\.|You rub your hands together greedily\\.|You clap your hands quickly and suddenly\\.|You remove [\\d,]+ .*, bringing the total in the rift to .*|You put .* into .*ouroboros.*|You trace a circle in the air, leaving a trail of fire behind you.*|You strike a drum with a firm hand.*|You quickly spin around counter-clockwise, three times.*|You light a candle from one of the braziers.*|You pen a seventeen-sided polygon on a piece of paper and burn it.*|You place some incense in a burner, and light it.*|You pick up a horn and blow a resounding blast.*|You strum a lute.*|You roll the dice and as they tumble to a stop.*|You wave your arms frantically.*|You take a kola nut, crush it in your fist.*|Taking an eagle's feather from a nearby table, you wave it over the ouroboros.*)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "alias",
   "name": "conjuration",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// CONJURATION [<sigil> | subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.conjuration || !client.loom.conjuration.sigils) run_function(\"conjuration_setup\", [], \"conjuration\");\nvar CJ = client.loom.conjuration;\nvar cjW = String(args[1] || \"\").trim().toLowerCase().split(/\\s+/);\nvar cjSub = cjW[0];\nvar cjP1 = cjW[1] || \"\";\nfunction cjSay(t, c) { display_notice(\"[conjuration] \" + t, c || \"cyan\"); }\nfunction cjKnown() { var a = []; for (var k in CJ.sigils) { if (CJ.sigils.hasOwnProperty(k) && CJ.sigils[k].actions) a.push(k); } return a; }\nfunction cjWhere() {\n  if (!CJ.ouroboros) return \"no ouroboros set: CONJURATION OUROBOROS <number> [<number the sigil is taken from>].\";\n  return \"reagents go into ouroboros \" + CJ.ouroboros + \"; the sigil is taken from \" + (CJ.sigilFrom ? \"ouroboros \" + CJ.sigilFrom : \"the same one\") + \".\";\n}\nfunction cjAll() { var a = []; for (var k in CJ.sigils) { if (CJ.sigils.hasOwnProperty(k)) a.push(k); } return a; }\n// MAKE is optional: CONJURATION FLAME and CONJURATION MAKE FLAME do the same.\nif (cjSub === \"make\") { cjSub = cjP1; cjP1 = \"\"; }\n\nif (cjSub === \"\" || cjSub === \"status\") {\n  cjSay(cjWhere());\n  if (CJ.run) {\n    var cjS0 = CJ.run.steps[CJ.run.i];\n    var cjCh = 0, cjChN = 0;\n    for (var cjK = 0; cjK < CJ.run.steps.length; cjK++) { if (/^chant /.test(CJ.run.steps[cjK].cmd)) { cjChN++; if (cjK <= CJ.run.i) cjCh++; } }\n    cjSay(\"making \" + CJ.sigils[CJ.run.sigil].name + \": step \" + (CJ.run.i + 1) + \" of \" + CJ.run.steps.length + \" (\" + cjS0.cmd + (/^chant /.test(cjS0.cmd) ? \", chant \" + cjCh + \" of \" + cjChN : \"\") + \"), \" + ({ send: \"sending\", expect: \"waiting for the game\", rift: \"reading the rift\", bal: \"waiting for balance\", retry: \"waiting to send it again\", held: \"held while triggers are paused\" })[CJ.run.state] + \". CONJURATION STOP abandons it.\");\n  }\n  cjSay(\"recipes known: \" + cjKnown().join(\", \") + \". CONJURATION <sigil> to make one; CONJURATION HELP for commands.\");\n} else if (cjSub === \"help\") {\n  run_function(\"conjuration_help\", [], \"conjuration\");\n} else if (cjSub === \"ouroboros\") {\n  var cjN = cjP1.replace(/^ouroboros/, \"\");\n  var cjM = (cjW[2] || \"\").replace(/^ouroboros/, \"\");\n  if (!cjN) {\n    cjSay(cjWhere());\n  } else if (!/^\\d+$/.test(cjN) || (cjM && !/^\\d+$/.test(cjM))) {\n    cjSay(\"give the ouroboros numbers, e.g. CONJURATION OUROBOROS 263287, or 263287 275085 if the sigil appears in a second one.\", \"orange\");\n  } else {\n    CJ.ouroboros = cjN;\n    CJ.sigilFrom = (cjM && cjM !== cjN) ? cjM : \"\";\n    set_variable(\"conjuration_ouroboros\", cjN);\n    if (CJ.sigilFrom) set_variable(\"conjuration_sigil_from\", CJ.sigilFrom);\n    else { try { delete_variable(\"conjuration_sigil_from\"); } catch (e) {} }\n    cjSay(cjWhere());\n  }\n} else if (cjSub === \"stop\") {\n  if (!CJ.run) cjSay(\"no ritual under way.\");\n  else { CJ.failWhy = \"stopped by you\"; run_function(\"conjuration_fail\", [], \"conjuration\"); }\n} else if (cjSub === \"list\") {\n  var cjL = cjAll();\n  for (var cjI = 0; cjI < cjL.length; cjI++) {\n    var cjS = CJ.sigils[cjL[cjI]];\n    var cjLe = cjS.actions ? CJ.parseActions(cjS.actions, cjS.chant).err : \"\";\n    display_notice(\"  \" + (cjL[cjI] + \"              \").slice(0, 14) + cjS.name + (!cjS.actions ? \"  (no recipe yet)\" : cjLe ? \"  (\" + cjLe + \")\" : \"\"), cjS.actions && !cjLe ? \"cyan\" : \"#889999\");\n  }\n} else if (cjSub === \"debug\") {\n  cjSay(\"ouroboros=\" + CJ.ouroboros + \" sigilFrom=\" + CJ.sigilFrom + \" saved=\" + get_variable(\"conjuration_ouroboros\") + \"/\" + get_variable(\"conjuration_sigil_from\") + \" pause=\" + (get_variable(\"pauseTriggers\") || \"unset\") + \" known=\" + cjKnown().join(\",\") + \" run=\" + (CJ.run ? CJ.run.sigil + \" i=\" + CJ.run.i + \" state=\" + CJ.run.state + \" tries=\" + CJ.run.tries + \" prompts=\" + CJ.run.prompts : \"none\"), \"orange\");\n} else if (CJ.sigils[cjSub]) {\n  var S = CJ.sigils[cjSub];\n  var cjPa = S.actions ? CJ.parseActions(S.actions, S.chant) : null;\n  if (!S.actions) {\n    cjSay(\"no recipe yet for \" + S.name + \".\", \"orange\");\n  } else if (cjPa.err) {\n    cjSay(\"can't make \" + S.name + \" yet: \" + cjPa.err + \".\", \"orange\");\n  } else if (!CJ.ouroboros) {\n    cjSay(\"set your ouroboros first: CONJURATION OUROBOROS <number>.\", \"orange\");\n  } else if (get_variable(\"pauseTriggers\") === \"on\") {\n    cjSay(\"triggers are paused, so nothing was sent.\", \"orange\");\n  } else if (CJ.run) {\n    cjSay(\"a \" + CJ.run.sigil + \" ritual is under way. CONJURATION STOP to abandon it.\", \"orange\");\n  } else {\n    // The ritual as steps: [command, the reply that confirms it (a regular\n    // expression), whether it takes balance].\n    var cjO = \"ouroboros\" + CJ.ouroboros;\n    var cjSteps = [];\n    // First the rift: nothing is taken out unless every reagent is there.\n    // Kola and other carried things are plants: read that part of the rift\n    // too, and check once the last part has been read.\n    cjSteps.push({ cmd: \"ir commodities\", expect: \"^Glancing into your rift\", rift: true, riftLast: !cjPa.carry.length });\n    if (cjPa.carry.length) cjSteps.push({ cmd: \"ir plants\", expect: \"^Glancing into your rift\", rift: true, riftLast: true });\n    var cjSelf = CJ.selfish === true;\n    if (cjSelf) cjSteps.push({ cmd: \"generosity\", expect: \"^A feeling of generosity spreads throughout you\\\\.$\", eq: true });\n    for (var cjR = 0; cjR < S.reagents.length; cjR++) {\n      cjSteps.push({ cmd: \"outr \" + (S.reagents[cjR][0] > 1 ? S.reagents[cjR][0] + \" \" : \"\") + S.reagents[cjR][1], expect: CJ.outrLine });\n    }\n    // Things the actions use up from your inventory (kola): out, never in.\n    for (var cjK2 = 0; cjK2 < cjPa.carry.length; cjK2++) {\n      cjSteps.push({ cmd: \"outr \" + (cjPa.carry[cjK2][0] > 1 ? cjPa.carry[cjK2][0] + \" \" : \"\") + cjPa.carry[cjK2][1], expect: CJ.outrLine });\n    }\n    for (var cjP = 0; cjP < S.reagents.length; cjP++) {\n      for (var cjQ = 0; cjQ < S.reagents[cjP][0]; cjQ++) cjSteps.push({ cmd: \"put \" + S.reagents[cjP][1] + \" in \" + cjO, expect: CJ.putLine });\n    }\n    if (cjSelf) cjSteps.push({ cmd: \"selfishness\", expect: \"^You rub your hands together greedily\\\\.$\", eq: true });\n    cjSteps.push({ cmd: \"begin creation of \" + (S.begin || cjSub + \" sigil\"), expect: \"indicating that you may begin\" });\n    for (var cjA = 0; cjA < cjPa.steps.length; cjA++) cjSteps.push(cjPa.steps[cjA]);\n    cjSteps.push({ cmd: \"end ritual\", expect: \"^The ouroboros flashes\" });\n    cjSteps.push({ cmd: \"get \" + (S.take || \"sigil\") + \" from ouroboros\" + (CJ.sigilFrom || CJ.ouroboros), expect: \"^You take .* from .*ouroboros\" });\n    CJ.run = { sigil: cjSub, reagents: S.reagents.concat(cjPa.carry), have: {}, steps: cjSteps, i: 0, state: \"send\", tries: 0, prompts: 0, sawLost: false };\n    cjSay(\"making \" + S.name + \", one step at a time (\" + cjSteps.length + \" steps).\");\n    run_function(\"conjuration_step\", [], \"conjuration\");\n  }\n} else {\n  cjSay(\"unknown sigil or command '\" + cjSub + \"'. Sigils: \" + cjAll().join(\", \") + \". CONJURATION HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^conjuration(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  }
 ],
 "description": "Sigil creation rituals, one step at a time as the game is ready"
}