{
 "type": "group",
 "name": "conjuration",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"conjuration_setup\", [], \"conjuration\");\ndisplay_notice(\"[conjuration] installed. CONJURATION OUROBOROS <number> [<number>] once, then CONJURATION <sigil>. CONJURATION HELP for commands.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; conjuration_ouroboros is left intact.\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"conjuration_setup\", [], \"conjuration\");\n"
  },
  {
   "type": "function",
   "name": "conjuration_setup",
   "enabled": true,
   "code": "// conjuration_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, the recipes and the\n// ouroboros setting.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.conjuration) client.loom.conjuration = {};\nclient.loom.registry.conjuration = { version: \"0.2.0\", keyword: \"CONJURATION\" };\nvar CJ = client.loom.conjuration;\n\n// Every sigil and conjured item, by the word typed. Those with a recipe can\n// be made: reagents taken out of the rift ([count, reagent]) and put in the\n// ouroboros, then the chant, three times. Add a recipe as you learn one.\nCJ.sigils = {\n  bauble: { name: \"a scented bauble\" },\n  brooch: { name: \"a brooch of Thoth\" },\n  comprehension: { name: \"a necklace of comprehension\" },\n  concealment: { name: \"an orb of concealment\" },\n  cube: { name: \"a vibration-dampening cube\" },\n  dreamcatcher: { name: \"a dreamcatcher\" },\n  eye: { name: \"an eye sigil\" },\n  fist: { name: \"a fist sigil\", reagents: [[1, \"silver\"], [2, \"horn\"]], chant: \"fartak ishla spooz tran\" },\n  flame: { name: \"a flame sigil\", reagents: [[1, \"silver\"]], chant: \"flet lhar abe minlo eec\" },\n  key: { name: \"a key sigil\" },\n  monolith: { name: \"a monolith sigil\" },\n  mushroom: { name: \"a mushroom sigil\" },\n  negation: { name: \"a gem of negation\" },\n  orb: { name: \"a chaos-destroying orb\" },\n  pestilence: { name: \"a ring of pestilence\" },\n  star: { name: \"a star sigil\" },\n  stasis: { name: \"a bag of stasis\" },\n  whirlwind: { name: \"a whirlwind of Vastar\" }\n};\n\n// The ouroboros the reagents go into (conjuration_ouroboros), and the one\n// the finished sigil is taken from (conjuration_sigil_from), by number. With\n// no second number, the sigil is taken from the first.\nif (CJ.ouroboros === undefined) {\n  var cjO, cjF;\n  try { cjO = get_variable(\"conjuration_ouroboros\"); } catch (e) { cjO = undefined; }\n  try { cjF = get_variable(\"conjuration_sigil_from\"); } catch (e) { cjF = undefined; }\n  CJ.ouroboros = (cjO && (\"\" + cjO) !== \"undefined\") ? (\"\" + cjO) : \"\";\n  CJ.sigilFrom = (cjF && (\"\" + cjF) !== \"undefined\") ? (\"\" + cjF) : \"\";\n}\n"
  },
  {
   "type": "function",
   "name": "conjuration_help",
   "enabled": true,
   "code": "// conjuration_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[conjuration] the creation rituals for the sigils you know. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"CONJURATION\", \"your ouroboros and the recipes known\"],\n  [\"CONJURATION <sigil>\", \"run its creation ritual (also CONJURATION MAKE <sigil>)\"],\n  [\"CONJURATION OUROBOROS <number> [<number>]\", \"the ouroboros the reagents go into, and the one the sigil is taken from if it's another\"],\n  [\"CONJURATION LIST\", \"every sigil, and which have a recipe\"],\n  [\"CONJURATION DEBUG\", \"internal state\"],\n  [\"Reagents come out of the rift. Nothing is sent while triggers are paused.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "conjuration",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// CONJURATION [<sigil> | subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.conjuration || !client.loom.conjuration.sigils) run_function(\"conjuration_setup\", [], \"conjuration\");\nvar CJ = client.loom.conjuration;\nvar cjW = String(args[1] || \"\").trim().toLowerCase().split(/\\s+/);\nvar cjSub = cjW[0];\nvar cjP1 = cjW[1] || \"\";\nfunction cjSay(t, c) { display_notice(\"[conjuration] \" + t, c || \"cyan\"); }\nfunction cjKnown() { var a = []; for (var k in CJ.sigils) { if (CJ.sigils.hasOwnProperty(k) && CJ.sigils[k].chant) a.push(k); } return a; }\nfunction cjWhere() {\n  if (!CJ.ouroboros) return \"no ouroboros set: CONJURATION OUROBOROS <number> [<number the sigil is taken from>].\";\n  return \"reagents go into ouroboros \" + CJ.ouroboros + \"; the sigil is taken from \" + (CJ.sigilFrom ? \"ouroboros \" + CJ.sigilFrom : \"the same one\") + \".\";\n}\nfunction cjAll() { var a = []; for (var k in CJ.sigils) { if (CJ.sigils.hasOwnProperty(k)) a.push(k); } return a; }\n// MAKE is optional: CONJURATION FLAME and CONJURATION MAKE FLAME do the same.\nif (cjSub === \"make\") { cjSub = cjP1; cjP1 = \"\"; }\n\nif (cjSub === \"\" || cjSub === \"status\") {\n  cjSay(cjWhere(), CJ.ouroboros ? \"cyan\" : \"orange\");\n  cjSay(\"recipes known: \" + cjKnown().join(\", \") + \". CONJURATION <sigil> to make one; CONJURATION HELP for commands.\");\n} else if (cjSub === \"help\") {\n  run_function(\"conjuration_help\", [], \"conjuration\");\n} else if (cjSub === \"ouroboros\") {\n  var cjN = cjP1.replace(/^ouroboros/, \"\");\n  var cjM = (cjW[2] || \"\").replace(/^ouroboros/, \"\");\n  if (!cjN) {\n    cjSay(cjWhere());\n  } else if (!/^\\d+$/.test(cjN) || (cjM && !/^\\d+$/.test(cjM))) {\n    cjSay(\"give the ouroboros numbers, e.g. CONJURATION OUROBOROS 263287, or 263287 275085 if the sigil appears in a second one.\", \"orange\");\n  } else {\n    CJ.ouroboros = cjN;\n    CJ.sigilFrom = (cjM && cjM !== cjN) ? cjM : \"\";\n    set_variable(\"conjuration_ouroboros\", cjN);\n    if (CJ.sigilFrom) set_variable(\"conjuration_sigil_from\", CJ.sigilFrom);\n    else { try { delete_variable(\"conjuration_sigil_from\"); } catch (e) {} }\n    cjSay(cjWhere());\n  }\n} else if (cjSub === \"list\") {\n  var cjL = cjAll();\n  for (var cjI = 0; cjI < cjL.length; cjI++) {\n    var cjS = CJ.sigils[cjL[cjI]];\n    display_notice(\"  \" + (cjL[cjI] + \"              \").slice(0, 14) + cjS.name + (cjS.chant ? \"\" : \"  (no recipe yet)\"), cjS.chant ? \"cyan\" : \"#889999\");\n  }\n} else if (cjSub === \"debug\") {\n  cjSay(\"ouroboros=\" + CJ.ouroboros + \" sigilFrom=\" + CJ.sigilFrom + \" saved=\" + get_variable(\"conjuration_ouroboros\") + \"/\" + get_variable(\"conjuration_sigil_from\") + \" pause=\" + (get_variable(\"pauseTriggers\") || \"unset\") + \" known=\" + cjKnown().join(\",\"), \"orange\");\n} else if (CJ.sigils[cjSub]) {\n  var S = CJ.sigils[cjSub];\n  if (!S.chant) {\n    cjSay(\"insufficient skill to create \" + S.name + \".\", \"orange\");\n  } else if (!CJ.ouroboros) {\n    cjSay(\"set your ouroboros first: CONJURATION OUROBOROS <number>.\", \"orange\");\n  } else if (get_variable(\"pauseTriggers\") === \"on\") {\n    cjSay(\"triggers are paused, so nothing was sent.\", \"orange\");\n  } else {\n    var cjO = \"ouroboros\" + CJ.ouroboros;\n    for (var cjR = 0; cjR < S.reagents.length; cjR++) {\n      send_command(\"outr \" + (S.reagents[cjR][0] > 1 ? S.reagents[cjR][0] + \" \" : \"\") + S.reagents[cjR][1]);\n    }\n    for (var cjP = 0; cjP < S.reagents.length; cjP++) {\n      for (var cjQ = 0; cjQ < S.reagents[cjP][0]; cjQ++) send_command(\"put \" + S.reagents[cjP][1] + \" in \" + cjO);\n    }\n    send_command(\"begin creation of \" + cjSub + \" sigil\");\n    for (var cjC = 0; cjC < 3; cjC++) send_command(\"chant \" + S.chant);\n    send_command(\"ring bell\");\n    send_command(\"end ritual\");\n    send_command(\"get sigil from ouroboros\" + (CJ.sigilFrom || CJ.ouroboros));\n  }\n} else {\n  cjSay(\"unknown sigil or command '\" + cjSub + \"'. Sigils: \" + cjAll().join(\", \") + \". CONJURATION HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^conjuration(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  }
 ],
 "description": "Runs the creation ritual for the sigils you have a recipe for, in the ouroboros you set. State in client.loom.conjuration; conjuration_ouroboros. CONJURATION HELP for commands."
}