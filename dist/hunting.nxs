{
 "type": "group",
 "name": "hunting",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"hunting_setup\", [], \"hunting\");\nrun_function(\"hunting_buttons\", [], \"hunting\");\ndisplay_notice(\"[hunting] installed. HUNTING HELP for commands.\", \"cyan\");\n// Nexus shows 7 buttons by default and a script can't change that (#114).\ndisplay_notice(\"[hunting] To see all 12 F-keys: gear icon (bottom right) > Buttons > Button Count slider to 12.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is uninstalled"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Class toggles (Sneak, Weave, Block) start OFF on every load: the game\n// doesn't keep shroud or hide across a login, so a remembered ON would\n// show a defence you don't have.\nset_variable(\"hunting_toggles\", \"{}\");\nif (client.loom && client.loom.hunting) client.loom.hunting.toggles = {};\nrun_function(\"hunting_setup\", [], \"hunting\");\nrun_function(\"hunting_buttons\", [], \"hunting\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\n\n// Class: hunting follows it itself. On a change: that class's keys and costs,\n// and fresh cooldowns, since ability names can repeat across classes.\nif (args.gmcp_method == \"Char.Status\" && args.gmcp_args.class) {\n  if (args.gmcp_args.class != HU.cls) {\n    HU.cls = args.gmcp_args.class;\n    HU.cd = {};\n    set_variable(\"hunting_class\", HU.cls);\n    run_function(\"hunting_buttons\", [], \"hunting\");\n  }\n}\n\n// Your own name, so autogold only treats \"X has been slain by <you>.\" as your kill.\nif ((args.gmcp_method == \"Char.Name\" || args.gmcp_method == \"Char.Status\") && args.gmcp_args.name) {\n  if (String(args.gmcp_args.name) !== HU.name) {\n    HU.name = String(args.gmcp_args.name);\n    set_variable(\"hunting_name\", HU.name);\n  }\n}\n\nif (args.gmcp_method == \"Char.Vitals\") {\n  // A staff attack changed in artificing since the keys were drawn: redraw,\n  // so the staff key casts the new one. Read only, never called into.\n  var huStaffNow = client.loom.artificing && client.loom.artificing.staff;\n  if (huStaffNow && HU.staffDrawn && huStaffNow !== HU.staffDrawn) run_function(\"hunting_buttons\", [], \"hunting\");\n\n  var v = args.gmcp_args;\n  HU.bal = String(v.bal) == \"1\";\n  HU.eq = String(v.eq) == \"1\";\n  HU.ep = to_number(v.ep); HU.maxep = to_number(v.maxep);\n  HU.wp = to_number(v.wp); HU.maxwp = to_number(v.maxwp);\n\n  // Dragonform in auto mode: pick gut or incantation from endurance vs willpower.\n  if (get_variable(\"hunting_dragon_mode\") == \"auto\") {\n    var huBefore = get_variable(\"hunting_dragon_attack\");\n    run_function(\"hunting_dragon_best\", [], \"hunting\");\n    if (get_variable(\"hunting_dragon_attack\") != huBefore) run_function(\"hunting_buttons\", [], \"hunting\");\n  }\n\n  var stats = args.gmcp_args.charstats;\n  var rage = null;\n  if (stats) {\n    for (var i = 0; i < stats.length; i++) {\n      var m = stats[i].match(/^Rage:\\s*(\\d+)/);\n      if (m) { rage = parseInt(m[1], 10); }\n    }\n  }\n  if (rage !== null) {\n    HU.rage = rage;\n  }\n  // Specialisation (Infernal, Paladin, Runewarden): some keys depend on it,\n  // so a change lays the keys out again.\n  // Morph (Sentinel): picks the main attack, like the spec.\n  var huSpec = null, huMorph = null;\n  if (stats) {\n    for (var huS = 0; huS < stats.length; huS++) {\n      var huSm = String(stats[huS]).match(/^Spec:\\s*(.+)$/);\n      if (huSm) huSpec = huSm[1];\n      var huMm = String(stats[huS]).match(/^Morph:\\s*(.+)$/);\n      if (huMm) huMorph = huMm[1];\n    }\n  }\n  var huRedraw = false;\n  if (huSpec !== null && huSpec !== HU.spec) {\n    // A real change (not the first reading after a load) drops the main\n    // attack picked by hand, so the new spec's default takes over.\n    if (HU.spec !== undefined && HU.mains[HU.cls]) { delete HU.mains[HU.cls]; set_variable(\"hunting_mains\", JSON.stringify(HU.mains)); }\n    HU.spec = huSpec;\n    huRedraw = true;\n  }\n  if (huMorph !== null && huMorph !== HU.morph) {\n    if (HU.morph !== undefined && HU.mains[HU.cls]) { delete HU.mains[HU.cls]; set_variable(\"hunting_mains\", JSON.stringify(HU.mains)); }\n    HU.morph = huMorph;\n    huRedraw = true;\n    // The new morph has arrived: whatever paused for it is done.\n    if (HU.paused) { set_variable(\"pauseTriggers\", \"off\"); HU.paused = false; }\n  }\n  if (huRedraw) run_function(\"hunting_buttons\", [], \"hunting\");\n  // Balance and equilibrium arrive on every vitals message, so refresh the\n  // highlights each time (the main attack lights on bal + eq).\n  run_function(\"hunting_highlight\", [], \"hunting\");\n}\n"
  },
  {
   "type": "group",
   "name": "core",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "hunting_setup",
     "enabled": true,
     "code": "// hunting_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Namespace, registry, one-time migration, defaults.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.hunting) client.loom.hunting = {};\nclient.loom.registry.hunting = { version: \"0.4.35\", keyword: \"HUNTING\", desc: \"Class F-keys with battlerage cooldowns, dragon attacks, autogold\" };\n\nvar HU = client.loom.hunting;\n\n// Per-class tables (classes/*.js): F-keys, battlerage costs, attack lines.\n// Session data, rebuilt on every load. HU.costs is the current class's costs,\n// set below and by hunting_buttons on each class change.\nrun_function(\"hunting_classes\", [], \"hunting\");\n// Colour of tagged attack lines.\nHU.lineFg = \"#d8f37e\";\nHU.lineBg = \"#000000\";\n// Rage state: cooldowns per ability (current class only: cleared on every\n// class change), F-key slot per ability, the global battlerage cooldown,\n// current rage.\nif (!HU.cd) HU.cd = {};\nif (!HU.slots) HU.slots = {};\nif (HU.glob === undefined) HU.glob = true;\n// Main attack chosen per class (HUNTING MAIN), and the ones added in game:\n// { \"Psion\": \"overhand\" }, { \"Psion\": { \"deathblow\": \"weave deathblow @tar\" } }.\nif (!HU.mains) {\n  HU.mains = {};\n  try { HU.mains = JSON.parse(get_variable(\"hunting_mains\") || \"{}\") || {}; } catch (e) { HU.mains = {}; }\n}\nif (!HU.mainsAdded) {\n  HU.mainsAdded = {};\n  try { HU.mainsAdded = JSON.parse(get_variable(\"hunting_mains_added\") || \"{}\") || {}; } catch (e) { HU.mainsAdded = {}; }\n}\n// Class toggles' state (sneak, weave...): { name: \"on\" | \"off\" }, kept\n// across HUNTING BUTTONS and RESET; onLoad sets them all OFF.\nif (!HU.toggles) {\n  HU.toggles = {};\n  try { HU.toggles = JSON.parse(get_variable(\"hunting_toggles\") || \"{}\") || {}; } catch (e) { HU.toggles = {}; }\n}\nif (HU.rage === undefined) HU.rage = 0;\n\n// Class: followed from GMCP in onGMCP, and kept in hunting_class because the\n// game sends Char.Status only at login and on a change. The first time,\n// loom's old activeClass seeds it (read only).\nif (!HU.cls) HU.cls = get_variable(\"hunting_class\") || get_variable(\"activeClass\") || \"\";\nif (HU.cls && !get_variable(\"hunting_class\")) set_variable(\"hunting_class\", HU.cls);\nHU.costs = (HU.classes[HU.cls] && HU.classes[HU.cls].rage) || {};\n\n// One-time migration from the pre-0.2 names: copy when the new one is unset,\n// then clear the old one.\nvar huOld = [\"dragonMode\", \"dragonAttack\", \"autogold\"];\nvar huNew = [\"hunting_dragon_mode\", \"hunting_dragon_attack\", \"hunting_autogold\"];\nvar huLegacy = false;\nfor (var huI = 0; huI < huOld.length; huI++) {\n  var huOv = get_variable(huOld[huI]);\n  if (huOv === null || huOv === undefined || huOv === \"\") continue;\n  huLegacy = true;\n  var huNv = get_variable(huNew[huI]);\n  if (huNv === null || huNv === undefined || huNv === \"\") set_variable(huNew[huI], huOv);\n  delete_variable(huOld[huI]);\n}\nvar huGone = [\"rage_costs\", \"rage_slots\", \"rage_cd\", \"rage_global\"];\nfor (var huJ = 0; huJ < huGone.length; huJ++) {\n  var huGv = get_variable(huGone[huJ]);\n  if (huGv !== null && huGv !== undefined) { huLegacy = true; delete_variable(huGone[huJ]); }\n}\n\n// Command sent when dragonform rises or falls. A profile that used hunting\n// before 0.2 always sent INITDEF there, so it keeps doing so; a fresh profile\n// sends nothing until HUNTING AFTERFORM sets one.\nvar huAf = get_variable(\"hunting_after_form\");\nif (huAf === null || huAf === undefined) set_variable(\"hunting_after_form\", huLegacy ? \"initdef\" : \"\");\n\nif (!get_variable(\"hunting_dragon_mode\")) set_variable(\"hunting_dragon_mode\", \"auto\");\nif (!get_variable(\"hunting_dragon_attack\")) set_variable(\"hunting_dragon_attack\", \"gut\");\nif (!get_variable(\"hunting_autogold\")) set_variable(\"hunting_autogold\", \"off\");\nvar huPt = get_variable(\"hunting_party_target\");\nif (huPt === null || huPt === undefined) set_variable(\"hunting_party_target\", \"\");\n"
    },
    {
     "type": "function",
     "name": "hunting_classes",
     "enabled": true,
     "code": "// hunting_classes -- the per-class tables, one file per class in classes/,\n// joined after this header by tools/build.py. Run from hunting_setup on every\n// load, so the tables are session data, never variables.\n// Each class file adds one entry: HU.classes[\"<class as GMCP names it>\"].\nvar HU = client.loom.hunting;\n// Prefix for battlerage keys: queued, so they fire as soon as you can act.\nvar huQ = \"queue add !wu!t!p \";\nHU.classes = {};\n// Lines every class shares (Provoke, level 100, is the same for all), checked\n// after the current class's own lines.\nHU.sharedLines = [\n  [/^Your back snaps straight as you unleash a fierce bellow at (.*)\\.$/, \"PROVOKE\", \"Provoke\"]\n];\n\n// Alchemist: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Miasma 16s,\n// Magnesium 23s, Pathogen 23s, Cadmium 31s, Hypnotic 41s, Provoke 20s.\nHU.classes[\"Alchemist\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    iron: [\"Iron\", \"queue add e!wu!t!p educe iron @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Miasma\", huQ + \"throw miasma at @tar\"],\n    [\"Magnesium\", huQ + \"educe magnesium @tar\"],\n    // Copper: the equilibrium shieldbreak (no rage). Caustic is the rage\n    // one, tracked but without a key.\n    [\"Copper\", \"queue add e!wu!t!p educe copper @tar\"],\n    [\"Pathogen\", huQ + \"throw pathogen at @tar\"],\n    [\"Cadmium\", huQ + \"educe cadmium @tar\"],\n    [\"Hypnotic\", huQ + \"throw hypnotic at @tar\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    // Tin: reflects part of the next two attacks' damage (500 mana). A\n    // panic key, not kept up by DEFCON.\n    [\"Tin\", \"queue add e!wu!t!p educe tin\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Miasma: 14, Magnesium: 36, Caustic: 17, Pathogen: 25, Cadmium: 22, Hypnotic: 28, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Caustic\"],\n  // Still to capture: Copper and Caustic (on a shielded target); and, past\n  // level 35 (#149), Pathogen, plain and PATHOGEN++ (target inhibited or\n  // afraid), Hypnotic.\n  lines: [\n    [/^Directing the energy of iron, you engulf (.*)'s body with ashen flames, which burn (\\w+) skin with their frigid touch\\.$/, \"IRON\"],\n    [/^You quickly mix together several chemical by-products and fling the toxic mixture into (.*)'s face, causing (\\w+) to cough and choke\\.$/, \"MIASMA\", \"Miasma\"],\n    [/^You sketch out the symbol for magnesium and direct the energy to sear (.*)'s flesh\\.$/, \"MAGNESIUM\", \"Magnesium\"],\n    [/^You sketch a bisected triangle in the air and direct the energy of cadmium to pierce (.*)'s skin, weakening (\\w+)\\.$/, \"CADMIUM\", \"Cadmium\"]\n  ]\n};\n\n// Apostate: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Convulsions 16s,\n// Burrow 23s, Bloodlet 23s, Possess 43s, Horrify 34s, Provoke 20s.\n// Class condition (charstats, for self): Essence.\nHU.classes[\"Apostate\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    bleed: [\"Bleed\", \"queue add b!wu!t!p deadeyes @tar bleed bleed\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Convulsions\", huQ + \"stare @tar convulsions\"],\n    [\"Burrow\", huQ + \"daegger burrow @tar\"],\n    [\"Pierce\", huQ + \"daegger pierce @tar\"],\n    [\"Bloodlet\", huQ + \"bloodlet @tar\"],\n    [\"Possess\", huQ + \"possess @tar\"],\n    [\"\", \"\"],\n    [\"{toggle:sneak}\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Horrify\", huQ + \"stare @tar horrify\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  // Sneak: SHROUD / UNSHROUD, shrouding again when the shroud wears off.\n  toggles: {\n    sneak: { label: \"Sneak\", on: [\"shroud\"], off: [\"unshroud\"],\n             renew: [/^Your shroud dissipates and you return to the realm of perception\\.$/, \"shroud\"] }\n  },\n  rage: { Convulsions: 14, Burrow: 36, Pierce: 17, Bloodlet: 25, Possess: 32, Horrify: 29, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Pierce\"],\n  // Past level 35 (#149): Burrow and Pierce (need the daegger, from\n  // Apostasy at level 50), Bloodlet, plain and BLOODLET++ (target sensitive\n  // or stunned), Possess.\n  lines: [\n    [/^You stare at (.*), giving (\\w+) the evil eye\\. Blood begins to flow from (\\w+) pores\\.$/, \"BLEED\"],\n    [/^You stare at (.*), giving (\\w+) the evil eye\\. (\\w+) limbs begin to convulse\\.$/, \"CONVULSIONS\", \"Convulsions\"],\n    [/^You stare at (.*), giving (\\w+) the evil eye\\. Terror floods (.*)'s features as (\\w+) begins to run about in a panic\\.$/, \"HORRIFY\", \"Horrify\"]\n  ]\n};\n\n// Bard: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Moulinet 16s,\n// Howlslash 23s, Cyclone 23s, Trill 41s, Charm 43s, Provoke 20s.\n// Class condition (charstats, for self): Voice (Yes/No).\nHU.classes[\"Bard\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    jab: [\"Jab\", \"queue add b!wu!t!p blade jab @tar torso\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Moulinet\", huQ + \"moulinet @tar\"],\n    [\"Howlslash\", huQ + \"howlslash @tar\"],\n    [\"Resonance\", huQ + \"play resonance at @tar\"],\n    [\"Cyclone\", huQ + \"cyclone @tar\"],\n    [\"Trill\", huQ + \"play trill at @tar\"],\n    [\"Charm\", huQ + \"play charm at @tar\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Moulinet: 14, Howlslash: 36, Resonance: 17, Cyclone: 25, Trill: 28, Charm: 32, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Resonance\"],\n  // Past level 35 (#149): Cyclone, plain and CYCLONE++ (target clumsy or\n  // stunned), Charm.\n  lines: [\n    [/^You dart out (.*) in a lightning-fast jab to the (\\w+) of (.*)\\.$/, \"JAB\"],\n    [/^You twist your wrist swiftly, slicing (.*) with a long slash of your sweeping blade\\.$/, \"MOULINET\", \"Moulinet\"],\n    [/^You use your powerful voice to distract (.*) with a ululating howl before stepping in with a vicious slash\\.$/, \"HOWLSLASH\", \"Howlslash\"],\n    [/^You hum a low note at (.*), causing (\\w+) translucent shield to shatter as it resonates with the power of your voice\\.$/, \"RESONANCE\", \"Resonance\"],\n    [/^You direct your voice in a high-pitched trill at (.*), dazing (\\w+)\\.$/, \"TRILL\", \"Trill\"]\n  ]\n};\n\n// Blademaster: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Leapstrike 16s,\n// Spinslash 23s, Headstrike 23s, Daze 33s, Nerveslash 31s, Provoke 20s.\n// Class conditions (charstats, for self): Shin, Stance.\nHU.classes[\"Blademaster\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    drawslash: [\"Drawslash\", \"queue add b!wu!t!p drawslash @tar sternum\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Leapstrike\", huQ + \"leapstrike @tar\"],\n    [\"Spinslash\", huQ + \"spinslash @tar\"],\n    [\"Shatter\", huQ + \"shin shatter @tar\"],\n    [\"Headstrike\", huQ + \"strike @tar head\"],\n    [\"Daze\", huQ + \"shin daze @tar\"],\n    [\"Nerveslash\", huQ + \"nerveslash @tar\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Leapstrike: 14, Spinslash: 36, Shatter: 17, Headstrike: 25, Daze: 26, Nerveslash: 22, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Shatter\"],\n  // Past level 35 (#149): Headstrike, plain and HEADSTRIKE++ (target\n  // reckless or afraid); Nerveslash.\n  lines: [\n    [/^With expert precision, you draw (.*) from its scabbard and unleash a vicious slash towards (.*)\\.$/, \"DRAWSLASH\"],\n    [/^A Shin-enhanced leap flings you high into the air\\.$/, \"LEAPSTRIKE\", \"Leapstrike\"],\n    [/^You hurl a precise blast of Shin energy at (.*)'s eyes\\.$/, \"DAZE\", \"Daze\"],\n    [/^You unleash a burst of Shin energy at (.*), tearing apart (\\w+) translucent shield\\.$/, \"SHATTER\", \"Shatter\"],\n    [/^You twist in a tight circle, slashing (.*) with each spin\\.$/, \"SPINSLASH\", \"Spinslash\"]\n  ]\n};\n\n// Depthswalker: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Drain 16s,\n// Lash 23s, Erasure 23s, Curse 35s, Boinad 38s, Provoke 20s.\n// Class conditions (charstats, for self): Word (Yes/No), Age.\nHU.classes[\"Depthswalker\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    cull: [\"Cull\", \"queue add b!wu!t!p shadow cull @tar\"]\n  },\n  keys: [\n    // Cull takes balance (checked in game, #31).\n    [\"{main}\", \"\"],\n    [\"Drain\", huQ + \"shadow drain @tar\"],\n    [\"Lash\", huQ + \"shadow lash @tar\"],\n    [\"Nakail\", huQ + \"intone nakail @tar\"],\n    [\"Erasure\", huQ + \"chrono erasure @tar\"],\n    [\"Curse\", huQ + \"chrono curse @tar\"],\n    [\"Boinad\", huQ + \"intone boinad @tar\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    // Kail: a prismatic barrier (word balance and equilibrium). A panic key:\n    // it likely drops when you attack, so DEFCON doesn't keep it (#156).\n    [\"Kail\", \"queue add e!wu!t!p intone kail\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Drain: 14, Lash: 36, Nakail: 17, Erasure: 25, Curse: 24, Boinad: 32, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Nakail\"],\n  // Past level 35 (#149): Nakail (needs Terminus, level 50; on a shielded\n  // target); Erasure, plain and ERASURE++ (target weakened or amnesiac);\n  // Boinad.\n  lines: [\n    [/^You lay into (.*) with a vicious blow from a scythe of shadows\\.$/, \"CULL\"],\n    [/^You command the shadow of (.*) to begin siphoning away the life of its host\\.$/, \"DRAIN\", \"Drain\"],\n    [/^You summon whips of shadow to viciously lash the form of (.*)\\.$/, \"LASH\", \"Lash\"],\n    [/^Bending your formidable will upon (.*), you slow the passage of time about (\\w+) to a crawl\\.$/, \"CURSE\", \"Curse\"]\n  ]\n};\n\n// Black Dragon: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\nHU.classes[\"Black Dragon\"] = {\n  keys: [\n    [\"{DRAGON}\", \"queue add eb!wu!t!p {dragon} @tar\", \"main\"],\n    [\"Dragonspit\", huQ + \"dragonspit @tar\"],\n    [\"Override\", huQ + \"override @tar\"],\n    [\"Blast\", \"queue add eb!wu!t!p blast @tar\", \"main\"],\n    [\"Corrode\", huQ + \"corrode @tar\"],\n    [\"Dragonsting\", huQ + \"dragonsting @tar\"],\n    [\"Dragonfear\", huQ + \"dragonfear @tar\"],\n    [\"{MODE}\", \"hunting dragonmode\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Dragonheal\", \"queue add eq!wu!t!p dragonheal\", \"main\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Dragonspit: 14, Dragonsting: 25, Dissolve: 17, Override: 36, Corrode: 25, Dragonfear: 29, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Dissolve\"],\n  lines: [\n    [/^You rip into (.*) with your massive, deadly claws\\.$/, \"GUT\"],\n    [/^You spit a stream of acidic venom at (.*) who writhes in agony as the spittle seeps into (\\w+) skin\\.$/, \"DRAGONSPIT\", \"Dragonspit\"],\n    [/^Drawing from the well of your puissance, you invoke a dramatic chant in the dragon tongue. Your voice resonates with each word, culminating in a wave of magical energy that you bend to your will and thrust towards (.*), bombarding (\\w+) with the ancient power\\.$/, \"INCANTATION\"],\n    [/^You open your gigantic maw and spew acid on (.*). (\\w+) dodges to the side and is only partially covered by the corrosive slime\\.$/, \"CORRODE\", \"Corrode\"],\n    [/^You open your gigantic maw and spew acid on (.*)\\. (\\w+) is too clumsy to dodge the deluge and is coated in the corrosive slime\\.$/, \"CORRODE++\", \"Corrode\"],\n    [/^You bathe (.*)'s translucent shield in your noxious breath, dissolving it\\.$/, \"DISSOLVE\", \"Dissolve\"],\n    [/^You swing your mighty tail around, stabbing (.+) with an acid-covered spine\\.$/, \"DRAGONSTING\", \"Dragonsting\"],\n    [/^Opening your maw, you force out a tremendous stream of acid, blasting the flesh from the very bones of (.*)\\.$/, \"BLAST\"],\n    [/^You barrel into (.*) and knock (\\w+) to the ground before stomping over (\\w+) prone form\\.$/, \"OVERRIDE\", \"Override\"],\n    [/^You open your enormous maw and let loose a mighty roar at (.*), causing (\\w+) to quail in fear\\.$/, \"DRAGONFEAR\", \"Dragonfear\"],\n    [/^You let out a great keening, and cast the impurities from your form\\.$/, \"DRAGONHEAL\"]\n  ]\n};\n\n// Blue Dragon: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\nHU.classes[\"Blue Dragon\"] = {\n  keys: [\n    [\"{DRAGON}\", \"queue add eb!wu!t!p {dragon} @tar\", \"main\"],\n    [\"Dragonchill\", huQ + \"dragonchill @tar\"],\n    [\"Override\", huQ + \"override @tar\"],\n    [\"Blast\", \"queue add eb!wu!t!p blast @tar\", \"main\"],\n    [\"Frostwave\", huQ + \"frostwave @tar\"],\n    [\"Ague\", huQ + \"ague @tar\"],\n    [\"\", \"\"],\n    [\"{MODE}\", \"hunting dragonmode\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Dragonchill: 14, Glaciate: 26, Frostrive: 17, Frostwave: 25, Ague: 14, Override: 36 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Frostrive\"],\n  lines: [\n    [/^You form small chunks of ice in your enormous maw, then spit them at (.*) in a barrage\\.$/, \"DRAGONCHILL\", \"Dragonchill\"],\n    [/^You breathe a wave of icy air at (.*)\\.$/, \"FROSTWAVE\", \"Frostwave\"],\n    [/^You let loose a steady stream of cold air around (.*), who begins to shiver uncontrollably\\.$/, \"AGUE\", \"Ague\"],\n    [/^You breathe a column of icy air at (.*)'s head, stunning (\\w+)\\.$/, \"GLACIATE\", \"Glaciate\"],\n    [/^Opening your massive maw, you throw your head forward and blast wave after wave of deadly, all-consuming cold at (.*)\\.$/, \"BLAST\"]\n  ]\n};\n\n// Druid: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\nHU.classes[\"Druid\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    maul: [\"Maul\", \"queue add b!wu!t!p wreathe | queue add b!wu!t!p maul @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Strangle\", huQ + \"strangle @tar\"],\n    [\"Ravage\", huQ + \"ravage @tar\"],\n    [\"Vinecrack\", huQ + \"vinecrack @tar\"],\n    [\"Glare\", huQ + \"quarterstaff glare @tar\"],\n    [\"Sting\", \"queue add b!wu!t sting @tar\"],\n    [\"Remedy\", \"evoke remedy {target}\"],\n    [\"Douse\", \"freeze ground\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Barrier\", \"evoke barrier\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  // Morphing breaks if anything is sent: pause from the call to the spirits\n  // until the transformation (or the Morph change in charstats).\n  pauses: [\n    [/^You throw your arms wide and a cry rings out from your lips, a clarion call to the ancient spirits of nature to taste the joy of life once more\\.$/,\n     /^You are surrounded by a shining corona of blinding light as your soul is transformed by metamorphosis\\.$/]\n  ],\n  rage: { Strangle: 14, Redeem: 22, Vinecrack: 17, Ravage: 36, Sear: 25, Glare: 14 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Vinecrack\"],\n  lines: [\n    [/You roar in rage and spring upon/, \"RAVAGE\", \"Ravage\"],\n    [/^You spring forwards onto /, \"MAUL\"],\n    [/Rising in response to your incantation, vines burst forth from the very earth/, \"STRANGLE\", \"Strangle\"],\n    [/You cause the tip of your quarterstaff to glow brightly before thrusting it at the face of/, \"GLARE\", \"Glare\"],\n    // Sear: matched on its opening, so the line counts whether the target\n    // averts its eyes (as here, on a stunned one) or takes the full beam.\n    [/^You hold your quarterstaff aloft and focus a beam of intense sunlight on /, \"SEAR\", \"Sear\"],\n    [/^At your command, undergrowth rises from the ground under (.*) and pierces (\\w+) skin/, \"REDEEM\", \"Redeem\"],\n    [/^You clench one fist before (.*) and vines grow up to entangle (\\w+) translucent shield/, \"VINECRACK\", \"Vinecrack\"]\n  ]\n};\n\n// Infernal: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Ravage 16s,\n// Spike 23s, Hellstrike 23s, Deathlink 43s, Soulshield 37s, Provoke 20s.\n// Class conditions (charstats, for self): Essence, Spec.\nHU.classes[\"Infernal\"] = {\n  // Main attacks for F1 and their lines come from the weapon specs, shared\n  // by the knight classes (hunting_weapons.js). HUNTING MAIN adds more in game.\n  weapons: true,\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Ravage\", huQ + \"ravage @tar\"],\n    [\"Spike\", huQ + \"spike @tar\"],\n    [\"Shiver\", huQ + \"shiver @tar\"],\n    [\"Hellstrike\", huQ + \"hellstrike @tar\"],\n    [\"Deathlink\", huQ + \"deathlink {target}\"],\n    [\"\", \"\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Soulshield\", huQ + \"soulshield\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Ravage: 14, Spike: 36, Shiver: 17, Hellstrike: 25, Deathlink: 30, Soulshield: 20, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Shiver\"],\n  // Past level 35 (#149): Deathlink (needs someone to cast it on) and\n  // HELLSTRIKE++ (target reckless or afraid).\n  lines: [\n    [/^A black tendril of mist coalesces from your hand and enters (.*)'s brain, causing (\\w+) to flinch in pain\\.$/, \"RAVAGE\", \"Ravage\"],\n    [/^A miasma of black flames springs up around you\\.$/, \"SOULSHIELD\", \"Soulshield\"],\n    [/^You leap upon (.*), forming putrid spikes on your armour that tear into (\\w+) flesh\\.$/, \"SPIKE\", \"Spike\"],\n    [/^Dark energy wreathes (.*) as you slash at (.*) with it, causing (\\w+) translucent shield to crumble\\.$/, \"SHIVER\", \"Shiver\"],\n    [/^Dark fire courses down (.*) as you strike (.*) with a solid blow\\.$/, \"HELLSTRIKE\", \"Hellstrike\"]\n  ]\n};\n\n// Jester: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Noogie 16s,\n// Ensconce 23s, Befuddle 23s, Dustthrow 25s, Rap 33s, Provoke 20s.\n// Class conditions: none in charstats.\nHU.classes[\"Jester\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    bop: [\"Bop\", \"queue add b!wu!t!p bop @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Noogie\", huQ + \"noogie @tar\"],\n    [\"Ensconce\", huQ + \"ensconce firecracker on @tar\"],\n    [\"Jacks\", huQ + \"throw jacks at @tar\"],\n    [\"Befuddle\", huQ + \"befuddle @tar\"],\n    [\"Dustthrow\", huQ + \"dustthrow @tar\"],\n    [\"Rap\", huQ + \"rap @tar\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Noogie: 14, Ensconce: 36, Jacks: 17, Befuddle: 25, Dustthrow: 18, Rap: 26, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Jacks\"],\n  // Past level 35 (#149): BEFUDDLE++ (target in aeon or amnesiac); Rap.\n  // Befuddle: the plain line is the \"minor headache\" one; any other line\n  // that starts the same way (likely the ++ one) is tagged BEFUDDLE until\n  // it's captured.\n  lines: [\n    [/^You reach out and bop (.*) on the nose with your blackjack\\.$/, \"BOP\"],\n    [/^You wrap (.*) in a tight headlock and repeatedly rub your knuckles painfully across (\\w+) scalp\\.$/, \"NOOGIE\", \"Noogie\"],\n    [/^You discreetly secret a lit firecracker to (.*?)\\./, \"ENSCONCE\", \"Ensconce\"],\n    [/^You throw a handful of small metallic jacks at (.*), the sharpened points shredding (\\w+) translucent shield\\.$/, \"JACKS\", \"Jacks\"],\n    [/^You strike up a bantering dialogue with (.*), but you're only able to cause a minor headache\\.$/, \"BEFUDDLE\", \"Befuddle\"],\n    [/^You strike up a bantering dialogue with /, \"BEFUDDLE\", \"Befuddle\"],\n    [/^You take a pinch of diamond dust and flick it at (.*)'s face\\./, \"DUSTTHROW\", \"Dustthrow\"]\n  ]\n};\n\n// Magi: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\nHU.classes[\"Magi\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    staff: [\"Staff\", \"queue add e!wu!t!p staff cast {staff} at @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Windlash\", huQ + \"cast windlash at @tar\"],\n    [\"Squeeze\", huQ + \"cast squeeze @tar\"],\n    [\"Disintegrate\", huQ + \"cast disintegrate at @tar\"],\n    [\"Firefall\", huQ + \"cast firefall at @tar\"],\n    [\"Stormbolt\", huQ + \"cast stormbolt at @tar\"],\n    [\"Dilation\", huQ + \"cast dilation at @tar\"],\n    [\"Flood\", \"queue add e cast flood\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Reflection\", \"queue add e!wu!t!p cast reflection at me\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Windlash: 14, Dilation: 35, Disintegrate: 17, Squeeze: 36, Firefall: 25, Stormbolt: 25 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Disintegrate\"],\n  lines: [\n    [/^As you point an elemental staff at (.*), a scintilla of bright, burning light shoots out, striking (\\w+) with focused elemental power\\.$/, \"STAFF\"],\n    [/^You draw upon the power of air to summon sharp gusts of wind which begin to whip across (.*)'s exposed flesh\\.$/, \"WINDLASH\", \"Windlash\"],\n    [/^You raise a clenched fist and in obedience the earth rises in turn, a great hand of stone unfurling to clamp about (.*) in a vice-like squeeze\\.$/, \"SQUEEZE\", \"Squeeze\"],\n    [/^You raise your hands dramatically and summon a mighty flaming rock from the sky down at (.*), but (\\w+) dodges aside and is only dealt a glancing blow\\.$/, \"FIREFALL\", \"Firefall\"],\n    [/^You summon a whirlwind of flame around (.*) which consumes (\\w+) translucent shield\\.$/, \"DISINTEGRATE\", \"Disintegrate\"],\n    [/^A bolt of lightning roars out from your hands as you cast a powerful spell at (.*), inciting sensitive nerves across (\\w+) skin\\.$/, \"STORMBOLT\", \"Stormbolt\"],\n    [/^You raise your hands dramatically and summon a mighty flaming rock from the sky that slams into the clumsy form of (.*)\\.$/, \"FIREFALL++\", \"Firefall\"],\n    [/^You summon a polar vortex in a tight field around (.*), chilling the small pocket so intensely that time itself begins to slow\\.$/, \"DILATION\", \"Dilation\"],\n    [/^You point an elemental staff at (.*) and (\\w+) screams in pain as (\\w+) skin begins to freeze and crack\\.$/, \"STAFF\"]\n  ]\n};\n\n// Monk: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them):\n// Spinningbackfist 16s, Tornadokick 23s, Mindblast 23s, Scramble 31s,\n// Ripplestrike 27s, Provoke 20s.\n// Class conditions (charstats, for self): Kai, Stance.\nHU.classes[\"Monk\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    combo: [\"Combo\", \"queue add b!wu!t!p combo @tar sdk ucp ucp\"]\n  },\n  keys: [\n    // One combo on one balance: sidekick, uppercut, uppercut (Eagle Stance).\n    [\"{main}\", \"\"],\n    [\"SBP\", huQ + \"sbp @tar\", \"Spinningbackfist\"],\n    [\"TNK\", huQ + \"tnk @tar\", \"Tornadokick\"],\n    [\"SPK\", huQ + \"spk @tar\", \"Splinterkick\"],\n    [\"Mindblast\", huQ + \"mind blast @tar\"],\n    [\"Scramble\", huQ + \"mind scramble @tar\"],\n    [\"RPST\", huQ + \"rpst @tar\", \"Ripplestrike\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"{toggle:block}\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  // F11: Bodyblock. The game's own lines keep the key right, however it was\n  // switched.\n  toggles: {\n    block: { label: \"Block\", on: [\"bdb\"], off: [\"unblock bdb\"],\n             seen: [/^You ready yourself to block as best you can\\.$/, /^You lower your body block\\.$/] }\n  },\n  // Tekura gradings: the tutor's demonstration breaks if anything else is\n  // sent, so triggers pause, \"ok\" starts it, and the new belt resumes them.\n  pauses: [\n    [/offers you a formal grading\\. Type \"OK\" to commence the demonstration\\.$/,\n     /confers on you the right to wear the \\w+ belt\\.$/, \"ok\"]\n  ],\n  // \"You connect!\" follows every hit of a combo; a miss says so instead.\n  gags: [/^You connect!$/],\n  rage: { Spinningbackfist: 14, Tornadokick: 36, Splinterkick: 17, Mindblast: 25, Scramble: 22, Ripplestrike: 25, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Splinterkick\"],\n  // Past level 35 (#149): Mindblast, plain and MINDBLAST++ (target weakened\n  // or sensitive); Ripplestrike.\n  lines: [\n    [/^You pump out at (.*) with a powerful side kick\\.$/, \"SDK\"],\n    [/^You launch a powerful uppercut at (.*)\\.$/, \"UCP\"],\n    [/^You spin and strike (.*) with the back of your fist\\.$/, \"SBP\", \"Spinningbackfist\"],\n    [/^You leap and spin in the air, striking (.*) repeatedly with an outstretched foot\\.$/, \"TNK\", \"Tornadokick\"],\n    [/^You focus your rage in a single powerful sidekick, shattering (.*)'s translucent shield\\.$/, \"SPK\", \"Splinterkick\"],\n    [/^You rummage quickly through (.*)'s mind, finding the link to fine motor control before exerting a small amount of psychic force and deadening it\\.$/, \"SCRAMBLE\", \"Scramble\"]\n  ]\n};\n\n// Occultist: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Harry 16s,\n// Chaosgate 23s, Fluctuate 23s, Temperance 43s, Stagnate 35s, Provoke 20s.\n// Class conditions (charstats, for self): Karma, Entity (Yes/No).\nHU.classes[\"Occultist\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    warp: [\"Warp\", \"queue add e!wu!t!p warp @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Harry\", huQ + \"harry @tar\"],\n    [\"Chaosgate\", huQ + \"chaosgate @tar\"],\n    [\"Ruin\", huQ + \"ruin @tar\"],\n    [\"Fluctuate\", huQ + \"fluctuate @tar\"],\n    [\"Temperance\", huQ + \"temper @tar\"],\n    [\"Stagnate\", huQ + \"stagnate @tar\"],\n    [\"{toggle:sneak}\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  // Sneak: SHROUD / UNSHROUD; shrouds again when it dissipates while on.\n  toggles: {\n    sneak: { label: \"Sneak\", on: [\"shroud\"], off: [\"unshroud\"],\n             renew: [/^Your shroud dissipates and you return to the realm of perception\\.$/, \"shroud\"] }\n  },\n  rage: { Harry: 14, Chaosgate: 36, Ruin: 17, Fluctuate: 25, Temperance: 32, Stagnate: 24, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Ruin\"],\n  // Past level 35 (#149): Fluctuate, plain and FLUCTUATE++ (target afraid or\n  // amnesiac); Stagnate.\n  lines: [\n    [/^You reach out and clench a fist before (.*), who screams and doubles over in agony as (\\w+) skin suddenly bubbles with gangrenous growths\\.$/, \"WARP\"],\n    [/^Raising your hands in the air, you summon horrific visions to torment (.*)\\.$/, \"HARRY\", \"Harry\"],\n    [/^You cup your hands together and fling them outwards, sending a spiral of shimmering portals into (.*)'s body\\.$/, \"CHAOSGATE\", \"Chaosgate\"],\n    [/^You gesture in a slashing motion at (.*), and small tears form in (\\w+) translucent shield as chaos rips it apart\\.$/, \"RUIN\", \"Ruin\"],\n    [/^Multicoloured rays burst forth from your outstretched hands and strike (.*) in the head, forcing (\\w+) to obey your will\\.$/, \"TEMPERANCE\", \"Temperance\"]\n  ]\n};\n\n// Paladin: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Harrow 16s,\n// Shock 23s, Punishment 23s, Recovery 44s, Provoke 20s, Regeneration 53s.\n// Class conditions (charstats, for self): Wrath, wrathbal, Spec.\nHU.classes[\"Paladin\"] = {\n  // Main attacks for F1 and their lines come from the weapon specs, shared\n  // by the knight classes (hunting_weapons.js); Doubleslash first, so it's the\n  // default with no spec. HUNTING MAIN adds more in game.\n  mains: {\n    doubleslash: [\"Doubleslash\", \"queue add b!wu!t!p dsl @tar\"]\n  },\n  weapons: true,\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Harrow\", huQ + \"harrow @tar\"],\n    [\"Shock\", huQ + \"perform rite of shock at @tar\"],\n    [\"Faithrend\", huQ + \"faithrend @tar\"],\n    [\"Punishment\", huQ + \"perform rite of punishment at @tar\"],\n    [\"Recovery\", huQ + \"perform recovery {target}\"],\n    [\"Provoke\", huQ + \"provoke @tar\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Regeneration\", huQ + \"perform rite of regeneration\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Harrow: 14, Shock: 36, Faithrend: 17, Punishment: 25, Recovery: 31, Provoke: 32, Regeneration: 33 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Faithrend\"],\n  // Doubleslash's lines are Dual Cutting's, in hunting_weapons.js.\n  // Past level 35 (#149): Punishment, plain and PUNISHMENT++ (target weakened\n  // or clumsy); Recovery.\n  lines: [\n    [/^Holy fire lends strength to your arm as you bring (.*) crashing down on (.*)\\.$/, \"HARROW\", \"Harrow\"],\n    [/^You perform a holy rite and bind it to (.*)'s soul, creating a conduit for holy lightning to strike down upon (\\w+)\\.$/, \"SHOCK\", \"Shock\"],\n    [/^You raise (.*) high in the air and utter a quick prayer as you bring it crashing down on (.*), shattering (\\w+) translucent shield\\.$/, \"FAITHREND\", \"Faithrend\"],\n    [/^You perform a holy rite and a gold-tinged aura springs up around you\\.$/, \"REGENERATION\", \"Regeneration\"]\n  ]\n};\n\n// Pariah: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Boil 16s,\n// Feast 23s, Spider 23s, Wail 38s, Symphony 35s, Provoke 20s.\n// Class condition (charstats, for self): epitaph_length.\nHU.classes[\"Pariah\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    wrack: [\"Wrack\", \"queue add b!wu!t!p blood wrack @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Boil\", huQ + \"blood boil @tar\"],\n    [\"Feast\", huQ + \"swarm feast @tar\"],\n    [\"Scour\", huQ + \"accursed scour @tar\"],\n    [\"Spider\", huQ + \"trace spider @tar\"],\n    [\"Wail\", huQ + \"accursed wail @tar\"],\n    [\"\", \"\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Symphony\", huQ + \"swarm symphony @tar\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Boil: 14, Feast: 36, Scour: 17, Spider: 25, Wail: 32, Symphony: 24, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Scour\"],\n  // Past level 35 (#149): Spider, plain and SPIDER++ (target inhibited or\n  // sensitive); Wail.\n  lines: [\n    [/^You raise your (?:left|right) hand before (.*), and clench it into a fist as you wrack the blood that flows throughout\\.$/, \"WRACK\"],\n    [/^You reach out and claw at the air, heating the body of (.*) from within\\.$/, \"BOIL\", \"Boil\"],\n    [/^You croon to the myriad minds that surround you, and send them to feast upon (.*) in a wave of chittering hunger\\.$/, \"FEAST\", \"Feast\"],\n    [/^You flick your hand towards (.*), and a sheet of sand rises to scour the magical shield surrounding (\\w+)\\.$/, \"SCOUR\", \"Scour\"],\n    // Symphony: matched on its opening, as the target's reaction follows.\n    [/^You tilt back your head and raise your voice in humming symphony with the myriad minds that crawl and fly\\./, \"SYMPHONY\", \"Symphony\"]\n  ]\n};\n\n// Priest: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Torment 16s,\n// Desolation 23s, Hammer 23s, Incense 19s, Horrify 34s, Provoke 20s.\n// Class conditions (charstats, for self): Angelpower, Devotion, conviction,\n// prayer_length, Prayer (Yes/No).\nHU.classes[\"Priest\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    smite: [\"Smite\", \"queue add b!wu!t!p smite @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Torment\", huQ + \"angel torment @tar\"],\n    [\"Desolation\", huQ + \"perform rite of desolation on @tar\"],\n    [\"Crack\", huQ + \"crack @tar\"],\n    [\"Hammer\", huQ + \"hammer @tar\"],\n    [\"Incense\", huQ + \"angel incense @tar\"],\n    [\"\", \"\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Horrify\", huQ + \"perform rite of horrify on @tar\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Torment: 14, Desolation: 36, Crack: 17, Hammer: 25, Incense: 18, Horrify: 29, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Crack\"],\n  // Past level 35 (#149): Hammer, plain and HAMMER++ (target clumsy or\n  // amnesiac); Horrify.\n  // Weapons and pronouns are left open: they change with what you wield and\n  // with your angel.\n  lines: [\n    [/^You utter a prayer and smite (.*) with (.*)\\.$/, \"SMITE\"],\n    [/^Your angel flares its wings and flaps them powerfully at (.*), causing shards of crystal to tear through (\\w+) flesh\\.$/, \"TORMENT\", \"Torment\"],\n    [/^Praying to the Gods, you lay a desolating rite on (.*)'s body and watch as (\\w+) arches (\\w+) back in agony\\.$/, \"DESOLATION\", \"Desolation\"],\n    [/^You strike (.*)'s translucent shield with your (.*), shattering it completely\\.$/, \"CRACK\", \"Crack\"],\n    [/^Your guardian angel becomes translucent as (\\w+) floats first through you and then (.*), absorbing your rage and passing it to (\\w+)\\.$/, \"INCENSE\", \"Incense\"]\n  ]\n};\n\n// Psion: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Barbedblade\n// 16s, Devastate 23s, Whirlwind 23s, Regrowth 35s, Terror 38s, Provoke 20s.\n// Class conditions: none in charstats.\nHU.classes[\"Psion\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    overhand: [\"Overhand\", \"queue add b!wu!t!p weave overhand @tar\"]\n  },\n  keys: [\n    // Overhand: learnt early. Charge and later Deathblow are the other main\n    // attacks; their lines are kept below so either one shows when used.\n    [\"{main}\", \"\"],\n    [\"Barbedblade\", huQ + \"weave barbedblade @tar\"],\n    [\"Devastate\", huQ + \"psi devastate @tar\"],\n    [\"Pulverise\", huQ + \"weave pulverise @tar\"],\n    [\"Whirlwind\", huQ + \"weave whirlwind @tar\"],\n    [\"Regrowth\", huQ + \"enact regrowth @tar\"],\n    [\"\", \"\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Terror\", huQ + \"psi terror @tar\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Barbedblade: 14, Devastate: 36, Pulverise: 17, Whirlwind: 25, Regrowth: 24, Terror: 32, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Pulverise\"],\n  // Past level 35 (#149): Whirlwind, plain and WHIRLWIND++ (target inhibited\n  // or stunned); Terror.\n  // Charge, Barbedblade and Devastate come from Ricardo's pre-Loom package.\n  lines: [\n    [/^You bring (.*) around in a savage overhand strike, smashing it into the face of (.*)\\.$/, \"OVERHAND\"],\n    [/^You weave a great warhammer into being and with an overhand swing obliterate the magical shield surrounding (.*)\\.$/, \"PULVERISE\", \"Pulverise\"],\n    [/^You direct nature to restrain (.*), and vines flash from nothingness into being to bind (\\w+)\\.$/, \"REGROWTH\", \"Regrowth\"],\n    [/^Charging forward, you drive a translucent spear into (.*)\\.$/, \"CHARGE\"],\n    [/^You weave a jagged blade into being and viciously hack at (.*), opening bleeding wounds\\.$/, \"BARBEDBLADE\", \"Barbedblade\"],\n    [/^You hammer the mind of (.*) with a devastating psionic onslaught\\.$/, \"DEVASTATE\", \"Devastate\"]\n  ]\n};\n\n// Runewarden: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Collide 16s,\n// Onslaught 23s, Etch 23s, Safeguard 57s, Bulwark 45s, Provoke 20s.\n// Class conditions (charstats, for self): Ferocity, empower, Spec.\nHU.classes[\"Runewarden\"] = {\n  // Main attacks for F1 and their lines come from the weapon specs, shared\n  // by the knight classes (hunting_weapons.js). HUNTING MAIN adds more in game.\n  weapons: true,\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Collide\", huQ + \"collide @tar\"],\n    [\"Onslaught\", huQ + \"onslaught @tar\"],\n    // Raze: the balance shieldbreak (no rage). Fragment is the rage one,\n    // tracked but without a key.\n    [\"Raze\", \"queue add b!wu!t!p raze @tar\"],\n    [\"Etch\", huQ + \"etch rune at @tar\"],\n    [\"Safeguard\", huQ + \"safeguard {target}\"],\n    [\"\", \"\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Bulwark\", huQ + \"bulwark\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Collide: 14, Onslaught: 36, Fragment: 17, Etch: 25, Safeguard: 35, Bulwark: 28, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Fragment\"],\n  // The combination's and Raze's lines are Sword and Shield's, in\n  // hunting_weapons.js.\n  // Past level 35 (#149): Fragment (on a shielded target); ETCH++ (target in\n  // aeon or stunned); Safeguard.\n  lines: [\n    [/^You charge at (.*), slamming into (\\w+) and throwing (\\w+) back\\.$/, \"COLLIDE\", \"Collide\"],\n    [/^You unleash a ferocious onslaught on (.*), relentlessly pounding (\\w+) with (.*)\\.$/, \"ONSLAUGHT\", \"Onslaught\"],\n    // Etch: matched on its opening, so a glancing hit (as captured) and a\n    // full one both count.\n    [/^You trace the outline of a rune in the air with (.*)\\. The edges catch fire as it hurtles towards /, \"ETCH\", \"Etch\"],\n    [/^The runes on your armour flare brightly as you adopt a defensive stance\\.$/, \"BULWARK\", \"Bulwark\"]\n  ]\n};\n\n// Sentinel: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Pester 16s,\n// Skewer 23s, Swarm 23s, Tame 43s, Goad 19s, Provoke 20s.\n// Class condition (charstats, for self): Morph.\nHU.classes[\"Sentinel\"] = {\n  // Main attacks for F1. Doublestrike is the default, morphed or not\n  // (#150 testing); without it learned, HUNTING MAIN BITE, CLAW or MAUL\n  // once and that's remembered. HUNTING MAIN x = cmd adds more in game.\n  mains: {\n    // First, so it's the default.\n    doublestrike: [\"Doublestrike\", \"queue add b!wu!t!p doublestrike @tar\"],\n    bite: [\"Bite\", \"queue add b!wu!t!p bite @tar\"],\n    claw: [\"Claw\", \"queue add b!wu!t!p claw @tar\"],\n    maul: [\"Maul\", \"queue add b!wu!t!p maul @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Pester\", huQ + \"pester @tar\"],\n    [\"Skewer\", huQ + \"skewer @tar\"],\n    [\"Bore\", huQ + \"bore @tar\"],\n    [\"Swarm\", huQ + \"swarm @tar\"],\n    [\"Tame\", huQ + \"tame @tar\"],\n    [\"Goad\", huQ + \"goad @tar\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  // Morphing breaks if anything is sent: pause from the call to the spirits\n  // until the transformation (or the Morph change in charstats).\n  pauses: [\n    [/^You throw your arms wide and a cry rings out from your lips, a clarion call to the ancient spirits of nature to taste the joy of life once more\\.$/,\n     /^You are surrounded by a shining corona of blinding light as your soul is transformed by metamorphosis\\.$/]\n  ],\n  rage: { Pester: 14, Skewer: 36, Bore: 17, Swarm: 25, Tame: 32, Goad: 18, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Bore\"],\n  // For #149: SWARM++ (target in aeon or inhibited).\n  // Weapons, pronouns and the pestering animal are left open. Swarm matches\n  // on its opening, so SWARM++ counts too.\n  lines: [\n    // Doublestrike's two hits: the slice, then the haft.\n    [/^You lay open the flesh of (.*) with an expert lateral slice with (.*)\\.$/, \"DOUBLESTRIKE\"],\n    [/^Turning with the motion of your strike, you come back around and slam the haft of your weapon into the temple of (.*)\\.$/, \"DOUBLESTRIKE\"],\n    [/^You sink your teeth deep into (.*), who howls in pain\\.$/, \"BITE\"],\n    [/^You strike brutally at (.*), and shred (\\w+) skin\\.$/, \"CLAW\"],\n    [/^You spring forwards onto (.*), and maul (\\w+) viciously\\.$/, \"MAUL\"],\n    [/^(.*) continues to pester (.*), continually biting (\\w+)\\.$/, \"PESTER\", \"Pester\"],\n    [/^You leap high into the air, (.*) held high above your head as you land on top of (.*), skewering (\\w+) with your weapon\\.$/, \"SKEWER\", \"Skewer\"],\n    [/^You thrust forward with (.*), piercing through (.*)'s shield\\.$/, \"BORE\", \"Bore\"],\n    [/^You utter a loud, buzzing call, and a swarm of wasps rushes in/, \"SWARM\", \"Swarm\"],\n    [/^Making soothing noises, you carefully approach (.*), assuring (\\w+) that you are a friend and urging (\\w+) to fight for you\\.$/, \"TAME\", \"Tame\"],\n    [/^You cower before (.*), causing (\\w+) to recklessly attack you with no regard for (\\w+) own safety\\.$/, \"GOAD\", \"Goad\"]\n  ]\n};\n\n// Serpent: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Thrash 16s,\n// Throatrip 23s, Snare 23s, Provoke 20s. Flagellate and Obliviate: not given.\n// Class condition (charstats, for self): Venom.\nHU.classes[\"Serpent\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    garrote: [\"Garrote\", \"queue add b!wu!t!p garrote @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Thrash\", huQ + \"thrash @tar\"],\n    [\"Throatrip\", huQ + \"throatrip @tar\"],\n    [\"Excoriate\", huQ + \"excoriate @tar\"],\n    [\"Snare\", huQ + \"snare @tar\"],\n    [\"Flagellate\", huQ + \"flagellate @tar\"],\n    [\"Obliviate\", huQ + \"obliviate @tar\"],\n    [\"{toggle:sneak}\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"{toggle:weave}\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  // From Ricardo's subterfuge package (Rienest). Sneak hides and cloaks, and\n  // re-conjures the cloak when the shroud drops while sneaking.\n  toggles: {\n    sneak: { label: \"Sneak\", on: [\"hide\", \"conjure cloak\"], off: [\"emerge\", \"dispel self\"],\n             renew: [/^Your shroud dissipates and you return to the realm of perception\\.$/, \"conjure cloak\"] },\n    weave: { label: \"Weave\", on: [\"weaving on\"], off: [\"weaving off\"] }\n  },\n  rage: { Thrash: 14, Throatrip: 36, Excoriate: 17, Snare: 25, Flagellate: 25, Obliviate: 28, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Excoriate\"],\n  // For #149: SNARE++ (target reckless or inhibited); Obliviate; Lash as a\n  // second main.\n  // Weapons and pronouns are left open: the whip can change. Snare matches on\n  // its opening, so the plain line and SNARE++ both count.\n  lines: [\n    [/^You slip behind (.*) and garrote (\\w+) with your (.*)\\.$/, \"GARROTE\"],\n    [/^You crack (.*) over your head before repeatedly lashing (.*) with it\\.$/, \"THRASH\", \"Thrash\"],\n    [/^You leap upon (.*) and sink your fangs into (\\w+) throat before leaping away, blood gushing from the horrific wound\\.$/, \"THROATRIP\", \"Throatrip\"],\n    [/^You lash out at (.*) with your (.*), stripping (\\w+) translucent shield\\.$/, \"EXCORIATE\", \"Excoriate\"],\n    [/^You step behind (.*) and trip (\\w+) into your waiting (.*)\\./, \"SNARE\", \"Snare\"],\n    [/^You crack (.*) lightly against (.*)'s flesh, awakening sensitive nerves\\.$/, \"FLAGELLATE\", \"Flagellate\"]\n  ]\n};\n\n// Shaman: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Corruption 16s,\n// Haemorrhage 23s, Vurus 23s, Cesaret 19s, Korkma 34s, Provoke 20s.\n// Class condition (charstats, for self): Spirits.\nHU.classes[\"Shaman\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    bleed: [\"Bleed\", \"queue add b!wu!t!p curse @tar bleed\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Corruption\", huQ + \"curse @tar corruption\"],\n    [\"Haemorrhage\", huQ + \"curse @tar haemorrhage\"],\n    [\"Vulnerability\", huQ + \"curse @tar vulnerability\"],\n    [\"Vurus\", huQ + \"invoke vurus @tar\"],\n    [\"Cesaret\", huQ + \"invoke cesaret @tar\"],\n    [\"\", \"\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Korkma\", huQ + \"invoke korkma @tar\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Corruption: 14, Haemorrhage: 36, Vulnerability: 17, Vurus: 25, Cesaret: 18, Korkma: 29, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Vulnerability\"],\n  // Past level 35 (#149): Vurus, plain and VURUS++ (target sensitive or\n  // amnesiac); Cesaret.\n  // Pronouns are left open: they change with the target.\n  lines: [\n    [/^You point an imperious finger at (.*) and blood begins to flow from (\\w+) pores\\.$/, \"BLEED\"],\n    [/^You point an imperious finger at (.*)\\. (\\w+) flesh blackens and sloughs off\\.$/, \"CORRUPTION\", \"Corruption\"],\n    [/^You point an imperious finger at (.*)\\. Blood spurts out of (.*)'s eyes, ears, nose, and mouth\\.$/, \"HAEMORRHAGE\", \"Haemorrhage\"],\n    [/^You point an imperious finger at (.*) and (\\w+) translucent shield fades away\\.$/, \"VULNERABILITY\", \"Vulnerability\"],\n    [/^You call upon the spirit of Korkma, sending his many-tentacled form to torment (.*)\\.$/, \"KORKMA\", \"Korkma\"]\n  ]\n};\n\n// Sylvan: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\nHU.classes[\"Sylvan\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    thornrend: [\"Thornrend\", \"queue add e!wu!t!p thornrend @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Torrent\", huQ + \"cast torrent at @tar\"],\n    [\"Sandstorm\", huQ + \"cast sandstorm at @tar\"],\n    [\"Thornpierce\", huQ + \"thornpierce @tar\"],\n    [\"Stonevine\", huQ + \"stonevine @tar\"],\n    [\"Leechroot\", huQ + \"leechroot @tar\"],\n    [\"Rockshot\", huQ + \"cast rockshot at @tar\"],\n    [\"Flood\", \"queue add e cast flood\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Reflection\", \"queue add e!wu!t!p cast reflection at me\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Torrent: 14, Sandstorm: 29, Thornpierce: 17, Stonevine: 36, Leechroot: 25, Rockshot: 28 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Thornpierce\"],\n  lines: [\n    [/^You command the razor-edged thorny vines around you to lash out and rend the flesh of (.*)\\.$/, \"THORNREND\"],\n    [/^(.*) coughs and splutters as you channel a gout of water at (\\w+) face\\.$/, \"TORRENT\", \"Torrent\"],\n    [/^(.*) stumbles about in fear and flails at (\\w+) head as you summon a small sandstorm around it\\.$/, \"SANDSTORM\", \"Sandstorm\"],\n    [/^A thorny vine reaches out from you and pierces through (.*)'s translucent shield, causing it to fade\\.$/, \"THORNPIERCE\", \"Thornpierce\"],\n    [/^You summon a great vine to wrap itself around (.*), then channel the element of earth into it, causing it to become rock hard and shatter as it constricts around (\\w+)\\.$/, \"STONEVINE\", \"Stonevine\"],\n    [/^A deadly root flies from your hand and burrows into (.*)'s flesh, but is unable to find sufficient sustenance\\.$/, \"LEECHROOT\", \"Leechroot\"],\n    [/^You form a small pebble, then channel air to fling it violently at (.*)'s head, causing (\\w+) to look dazed\\.$/, \"ROCKSHOT\", \"Rockshot\"]\n  ]\n};\n\n// Unnamable: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Shriek 16s,\n// Destroy 23s, Onslaught 23s, Entropy 38s, Dread 35s, Provoke 20s.\n// Class conditions (charstats, for self): Karma, Anathema (Yes/No),\n// Manifestation, Spec.\nHU.classes[\"Unnamable\"] = {\n  // Main attacks for F1 and their lines come from the weapon specs, shared\n  // by the knight classes (hunting_weapons.js); Doublewhirl first, so it's the\n  // default with no spec. HUNTING MAIN adds more in game.\n  mains: {\n    doublewhirl: [\"Doublewhirl\", \"queue add b!wu!t!p doublewhirl @tar\"]\n  },\n  weapons: true,\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Shriek\", huQ + \"unnamable shriek @tar\"],\n    [\"Destroy\", huQ + \"unnamable destroy @tar\"],\n    // Fracture: the balance shieldbreak (no rage). Sunder is the rage one,\n    // tracked but without a key.\n    [\"Fracture\", \"queue add b!wu!t!p fracture @tar shield\"],\n    [\"Onslaught\", huQ + \"unnamable onslaught @tar\"],\n    [\"Entropy\", huQ + \"croon entropy @tar\"],\n    [\"\", \"\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Dread\", huQ + \"croon dread @tar\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Shriek: 14, Destroy: 36, Sunder: 17, Onslaught: 25, Entropy: 32, Dread: 24, Provoke: 32 },\n  // Shieldbreak: no cooldown, no global cooldown (see README, razes).\n  razes: [\"Sunder\"],\n  // For #149: Fracture and Sunder (on a shielded target); Onslaught, plain and\n  // ONSLAUGHT++ (target charmed or sensitive); Entropy.\n  lines: [\n    [/^Your many mouths shriek at (.*), a wrath-filled cry given ancient power\\.$/, \"SHRIEK\", \"Shriek\"],\n    [/^You lash out with power and will, your only task to crush the light from your wretched target, (.*)\\.$/, \"DESTROY\", \"Destroy\"],\n    [/^You croon to (.*) of terror, of the fear of aeons, of the ineffable dread, each of your mouths joined in profane design\\.$/, \"DREAD\", \"Dread\"]\n  ]\n};\n\n// hunting_weapons -- the knights' weapon specialisations (Weaponmastery), shared\n// by every class that has them: Infernal, Paladin, Runewarden, Unnamable.\n// Joined after the class files by tools/build.py. A spec's attacks and lines\n// are the same whichever of those classes uses it, so each is captured once\n// (#31): Two Handed on the Infernal, Sword and Shield on the Runewarden, Dual\n// Cutting on the Paladin, Dual Blunt on the Unnamable.\n// Spec names as charstats gives them (\"Spec: Two Handed\").\nHU.weapons = {\n  \"Two Handed\": {\n    main: \"slaughter\",\n    mains: { slaughter: [\"Slaughter\", \"queue add b!wu!t!p slaughter @tar\"] },\n    lines: [\n      [/^Drawing back (.*), you unleash a flesh-mincing blow at (.*)\\.$/, \"SLAUGHTER\"],\n      [/^Lunging forward, you bring (.*) down in a savage diagonal blow, carving through (.*)'s magical shield\\.$/, \"CARVE\"]\n    ]\n  },\n  \"Sword and Shield\": {\n    main: \"combination\",\n    mains: { combination: [\"Combo\", \"queue add b!wu!t!p combination @tar rend smash\"] },\n    // The combination's two hits, and Raze (the balance shieldbreak), from\n    // the Runewarden.\n    lines: [\n      [/^You carve into (.*)'s flesh with a vicious strike, opening a bleeding wound\\.$/, \"REND\"],\n      [/^You brutally smash your shield into (.*)\\.$/, \"SMASH\"],\n      [/^You raze (.*)'s magical shield with (.*)\\.$/, \"RAZE\"]\n    ]\n  },\n  \"Dual Cutting\": {\n    main: \"doubleslash\",\n    mains: { doubleslash: [\"Doubleslash\", \"queue add b!wu!t!p dsl @tar\"] },\n    // Two hits per Doubleslash, each worded one of these ways (from the\n    // Paladin). They're the game's plain weapon hits, so JAB, SLASH and SWING\n    // print them too: each is tagged by its wording, not as DOUBLESLASH.\n    lines: [\n      [/^Lightning-quick, you jab (.*) with (.*)\\.$/, \"JAB\"],\n      [/^You slash into (.*) with (.*)\\.$/, \"SLASH\"],\n      [/^You swing (.*) at (.*) with all your might\\.$/, \"SWING\"]\n    ]\n  },\n  \"Dual Blunt\": {\n    main: \"doublewhirl\",\n    mains: { doublewhirl: [\"Doublewhirl\", \"queue add b!wu!t!p doublewhirl @tar\"] },\n    // Doublewhirl's two hits, one line each (from the Unnamable). Tagged\n    // WHIRL, not DOUBLEWHIRL, in case a plain flail hit prints it too (as\n    // with Dual Cutting). Fracture, the balance shieldbreak, still to capture.\n    lines: [\n      [/^You whip (.*) toward (.*)\\.$/, \"WHIRL\"]\n    ]\n  }\n};\n// Every class with \"weapons: true\" gets every spec's main attacks (after its\n// own, so its own first one stays the default with no spec), the spec's\n// default for F1, and every spec's lines (after its own; mostly only the\n// spec you use will show, but Dual Cutting's are the plain weapon hits).\nfor (var hwC in HU.classes) {\n  var hwE = HU.classes[hwC];\n  if (!hwE.weapons) continue;\n  if (!hwE.mains) hwE.mains = {};\n  if (!hwE.specMain) hwE.specMain = {};\n  if (!hwE.lines) hwE.lines = [];\n  for (var hwS in HU.weapons) {\n    var hwW = HU.weapons[hwS];\n    for (var hwM in hwW.mains) { if (!hwE.mains[hwM]) hwE.mains[hwM] = hwW.mains[hwM]; }\n    if (!hwE.specMain[hwS]) hwE.specMain[hwS] = hwW.main;\n    hwE.lines = hwE.lines.concat(hwW.lines);\n  }\n}\n"
    },
    {
     "type": "function",
     "name": "hunting_mainlist",
     "enabled": true,
     "code": "// hunting_mainlist -- the current class's main attacks into HU.mainList\n// ([{ name, label, cmd, added }]) and the one in use into HU.mainNow.\n// Order: the class file's \"mains\", then those added with HUNTING MAIN x = cmd\n// (an added one with the same name replaces the file's). In use: the one\n// picked with HUNTING MAIN, else the class's default for your spec\n// (specMain) or morph (morphMain), else the first. A spec or morph change\n// drops the hand-picked one (see onGMCP).\nvar HU = client.loom.hunting;\nvar mlEntry = HU.classes[HU.cls] || {};\nvar mlFile = mlEntry.mains || {};\nvar mlAdded = HU.mainsAdded[HU.cls] || {};\nvar mlByName = {};\nHU.mainList = [];\nfor (var mlK in mlFile) {\n  var mlRow = { name: mlK, label: mlFile[mlK][0], cmd: mlFile[mlK][1], added: false };\n  mlByName[mlK] = mlRow;\n  HU.mainList.push(mlRow);\n}\nfor (var mlA in mlAdded) {\n  // Typed in game: queued on balance and equilibrium unless it is a queue\n  // command already.\n  var mlCmd = /^queue\\s/i.test(mlAdded[mlA]) ? mlAdded[mlA] : \"queue add eb!wu!t!p \" + mlAdded[mlA];\n  var mlLabel = mlA.charAt(0).toUpperCase() + mlA.substring(1);\n  if (mlByName[mlA]) { mlByName[mlA].cmd = mlCmd; mlByName[mlA].added = true; }\n  else { var mlNew = { name: mlA, label: mlLabel, cmd: mlCmd, added: true }; mlByName[mlA] = mlNew; HU.mainList.push(mlNew); }\n}\nvar mlPick = HU.mains[HU.cls];\nif (!mlPick || !mlByName[mlPick]) mlPick = (mlEntry.specMain && HU.spec && mlEntry.specMain[HU.spec]) || \"\";\nif (!mlPick || !mlByName[mlPick]) mlPick = (mlEntry.morphMain && HU.morph && mlEntry.morphMain[HU.morph]) || \"\";\nif (!mlPick || !mlByName[mlPick]) mlPick = HU.mainList.length ? HU.mainList[0].name : \"\";\nHU.mainNow = mlPick ? mlByName[mlPick] : null;\n"
    },
    {
     "type": "function",
     "name": "hunting_help",
     "enabled": true,
     "code": "// hunting_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[hunting] class F-keys, battlerage highlights, dragon attacks and autogold. Commands:\";\n// Whether the current class has a file in classes/, and which classes do.\nvar hlHU = client.loom.hunting || {};\nvar hlKnown = [];\nfor (var hlK in (hlHU.classes || {})) hlKnown.push(hlK);\nvar hlClassNote = \"Classes set up: \" + hlKnown.join(\", \") + \".\"\n  + (hlHU.cls && !(hlHU.classes && hlHU.classes[hlHU.cls]) ? \" \" + hlHU.cls + \" isn't one yet: you get the generic keys (Stats, Diag, Shield) and no attack highlights.\" : \"\");\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"HUNTING\", \"status\"],\n  [\"HUNTING DRAGONMODE [PHY|MAG|AUTO]\", \"gut, incantation, or whichever pool is fuller (no argument: next mode)\"],\n  [\"HUNTING AUTOGOLD [ON|ALL|OFF]\", \"pick up gold from your kills, from any corpse, or not at all\"],\n  [\"HUNTING PARTYTARGET [name|OFF]\", \"who party-aimed keys act on (the druid's Remedy key)\"],\n  [\"HUNTING AFTERFORM [cmd|OFF]\", \"command sent when dragonform rises or falls, e.g. DEFCON UP\"],\n  [\"HUNTING MAIN [name]\", \"your class's main attack on F1 (no name: list them)\"],\n  [\"HUNTING MAIN <name> = <command>\", \"add one for this class, e.g. to try an attack; empty command removes it\"],\n  [\"HUNTING TOGGLE <name> [ON|OFF]\", \"class toggles on the F-keys, e.g. the Serpent's SNEAK and WEAVE\"],\n  [\"HUNTING BUTTONS\", \"lay out the F-keys again\"],\n  [\"HUNTING RAGE\", \"rage, cooldowns and tracked keys\"],\n  [\"HUNTING RESET\", \"clear rage cooldowns, lay out the F-keys again\"],\n  [\"HUNTING DEBUG\", \"internal state\"],\n  [\"F8 to F12 only show if Nexus is set to 12 buttons: gear icon (bottom right) > Buttons > Button Count.\"],\n  [hlClassNote]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
    },
    {
     "type": "function",
     "name": "hunting_status",
     "enabled": true,
     "code": "var HU = client.loom.hunting;\nrun_function(\"hunting_mainlist\", [], \"hunting\");\nvar huPt = get_variable(\"hunting_party_target\");\nvar huAf = get_variable(\"hunting_after_form\");\ndisplay_notice(\"[hunting] class \" + (HU.cls || \"unknown\") + (HU.cls && !(HU.classes && HU.classes[HU.cls]) ? \" (not configured yet)\" : \"\") + \", dragon mode \" + String(get_variable(\"hunting_dragon_mode\")).toUpperCase()\n  + \" (\" + get_variable(\"hunting_dragon_attack\") + \"), autogold \" + String(get_variable(\"hunting_autogold\")).toUpperCase()\n  + (HU.mainNow ? \", main attack \" + HU.mainNow.name.toUpperCase() : \"\")\n  + \", party target \" + (huPt ? huPt : \"none\") + \", after form \" + (huAf ? huAf.toUpperCase() : \"nothing\")\n  + \". HUNTING HELP for commands.\", \"cyan\");\n"
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "// HUNTING [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\nvar huRaw = String(args[1] || \"\").trim();\nvar huSub = huRaw.split(/\\s+/)[0].toLowerCase();\nvar huRest = huRaw.substring(huSub.length).trim();\nvar huVal = huRest.toLowerCase();\nvar C = \"cyan\";\n\nif (huSub === \"\" || huSub === \"status\") {\n  run_function(\"hunting_status\", [], \"hunting\");\n}\nelse if (huSub === \"help\") {\n  run_function(\"hunting_help\", [], \"hunting\");\n}\nelse if (huSub === \"dragonmode\") {\n  var huCur = get_variable(\"hunting_dragon_mode\");\n  var huNext = huVal;\n  if (huNext === \"\") huNext = (huCur == \"auto\") ? \"physical\" : (huCur == \"physical\") ? \"magical\" : \"auto\";\n  if (huNext === \"phy\") huNext = \"physical\";\n  if (huNext === \"mag\") huNext = \"magical\";\n  if (huNext === \"aut\") huNext = \"auto\";\n  if (huNext !== \"physical\" && huNext !== \"magical\" && huNext !== \"auto\") {\n    display_notice(\"[hunting] dragon mode is PHYSICAL, MAGICAL or AUTO.\", \"orange\");\n  } else {\n    set_variable(\"hunting_dragon_mode\", huNext);\n    if (huNext === \"physical\") set_variable(\"hunting_dragon_attack\", \"gut\");\n    if (huNext === \"magical\") set_variable(\"hunting_dragon_attack\", \"incantation\");\n    if (huNext === \"auto\") run_function(\"hunting_dragon_best\", [], \"hunting\");\n    display_notice(\"[hunting] dragon mode \" + huNext.toUpperCase() + \": attacking with \" + get_variable(\"hunting_dragon_attack\") + \".\", C);\n    run_function(\"hunting_buttons\", [], \"hunting\");\n  }\n}\nelse if (huSub === \"autogold\") {\n  if (huVal === \"on\" || huVal === \"off\" || huVal === \"all\") {\n    set_variable(\"hunting_autogold\", huVal);\n    display_notice(\"[hunting] autogold \" + huVal.toUpperCase() + \".\", C);\n  } else if (huVal === \"\") {\n    display_notice(\"[hunting] autogold is \" + String(get_variable(\"hunting_autogold\")).toUpperCase() + \". HUNTING AUTOGOLD ON (your kills), ALL (any gold) or OFF.\", C);\n  } else {\n    display_notice(\"[hunting] autogold is ON, ALL or OFF.\", \"orange\");\n  }\n}\nelse if (huSub === \"partytarget\") {\n  if (huVal === \"\") {\n    var huPt = get_variable(\"hunting_party_target\");\n    display_notice(\"[hunting] party target: \" + (huPt ? huPt : \"none\") + \". HUNTING PARTYTARGET <name> or OFF.\", C);\n  } else {\n    set_variable(\"hunting_party_target\", huVal === \"off\" ? \"\" : huVal);\n    display_notice(\"[hunting] party target \" + (huVal === \"off\" ? \"cleared\" : \"set to \" + huVal) + \".\", C);\n    run_function(\"hunting_buttons\", [], \"hunting\");\n  }\n}\nelse if (huSub === \"afterform\") {\n  if (huVal === \"\") {\n    var huAf = get_variable(\"hunting_after_form\");\n    display_notice(\"[hunting] after dragonform rises or falls: \" + (huAf ? huAf.toUpperCase() : \"nothing\") + \". HUNTING AFTERFORM <command> or OFF.\", C);\n  } else {\n    set_variable(\"hunting_after_form\", huVal === \"off\" ? \"\" : huRest);\n    display_notice(\"[hunting] after dragonform rises or falls: \" + (huVal === \"off\" ? \"nothing\" : huRest.toUpperCase()) + \".\", C);\n  }\n}\nelse if (huSub === \"main\") {\n  // HUNTING MAIN: list; HUNTING MAIN <name>: use it; HUNTING MAIN <name> =\n  // <command>: add or replace one for this class; HUNTING MAIN <name> = (empty):\n  // remove an added one.\n  run_function(\"hunting_mainlist\", [], \"hunting\");\n  var huMeq = huRest.indexOf(\"=\");\n  var huMname = (huMeq >= 0 ? huRest.substring(0, huMeq) : huRest).trim().toLowerCase().replace(/\\s+/g, \"\");\n  var huMcmd = huMeq >= 0 ? huRest.substring(huMeq + 1).trim() : null;\n  if (!HU.cls) {\n    display_notice(\"[hunting] no class seen yet.\", \"orange\");\n  } else if (huMname === \"\") {\n    var huMout = [];\n    for (var huMi = 0; huMi < HU.mainList.length; huMi++) {\n      var huMr = HU.mainList[huMi];\n      huMout.push((HU.mainNow && HU.mainNow.name == huMr.name ? \"*\" : \"\") + huMr.name.toUpperCase() + (huMr.added ? \" (added)\" : \"\"));\n    }\n    display_notice(\"[hunting] main attacks for \" + HU.cls + \": \" + (huMout.length ? huMout.join(\", \") : \"none\") + \". HUNTING MAIN <name> to use one, HUNTING MAIN <name> = <command> to add one.\", C);\n  } else if (huMcmd !== null) {\n    if (!HU.mainsAdded[HU.cls]) HU.mainsAdded[HU.cls] = {};\n    if (huMcmd === \"\") {\n      delete HU.mainsAdded[HU.cls][huMname];\n      display_notice(\"[hunting] removed the added \" + huMname.toUpperCase() + \" for \" + HU.cls + \".\", C);\n    } else {\n      HU.mainsAdded[HU.cls][huMname] = huMcmd;\n      HU.mains[HU.cls] = huMname;\n      set_variable(\"hunting_mains\", JSON.stringify(HU.mains));\n      display_notice(\"[hunting] \" + huMname.toUpperCase() + \" = \" + huMcmd + \", now your main attack as \" + HU.cls + \".\", \"lime\");\n    }\n    set_variable(\"hunting_mains_added\", JSON.stringify(HU.mainsAdded));\n    run_function(\"hunting_buttons\", [], \"hunting\");\n  } else {\n    var huMfound = false;\n    for (var huMj = 0; huMj < HU.mainList.length; huMj++) if (HU.mainList[huMj].name == huMname) huMfound = true;\n    if (!huMfound) {\n      display_notice(\"[hunting] no main attack \" + huMname.toUpperCase() + \" for \" + HU.cls + \". HUNTING MAIN lists them.\", \"orange\");\n    } else {\n      HU.mains[HU.cls] = huMname;\n      set_variable(\"hunting_mains\", JSON.stringify(HU.mains));\n      run_function(\"hunting_buttons\", [], \"hunting\");\n      display_notice(\"[hunting] main attack for \" + HU.cls + \": \" + huMname.toUpperCase() + \".\", \"lime\");\n    }\n  }\n}\nelse if (huSub === \"toggle\") {\n  // Class toggles (classes/*.js \"toggles\"): flip, or set ON/OFF, and send\n  // that state's commands.\n  var huTp = huVal.split(/\\s+/);\n  var huTn = huTp[0] || \"\";\n  var huTset = huTp[1] || \"\";\n  var huTcls = HU.classes[HU.cls];\n  var huTdef = huTcls && huTcls.toggles ? huTcls.toggles[huTn] : null;\n  if (!huTdef) {\n    var huTnames = [];\n    for (var huTk in ((huTcls && huTcls.toggles) || {})) huTnames.push(huTk.toUpperCase());\n    display_notice(\"[hunting] \" + (huTnames.length ? \"toggles for \" + HU.cls + \": \" + huTnames.join(\", \") + \".\" : \"no toggles for \" + (HU.cls || \"this class\") + \".\"), huTn ? \"orange\" : C);\n  } else if (huTset !== \"\" && huTset !== \"on\" && huTset !== \"off\") {\n    display_notice(\"[hunting] HUNTING TOGGLE \" + huTn.toUpperCase() + \" [ON|OFF].\", \"orange\");\n  } else {\n    var huTnow = HU.toggles[huTn] === \"on\" ? \"on\" : \"off\";\n    var huTnext = huTset || (huTnow === \"on\" ? \"off\" : \"on\");\n    var huTcmds = huTdef[huTnext] || [];\n    for (var huTi = 0; huTi < huTcmds.length; huTi++) send_command(huTcmds[huTi]);\n    HU.toggles[huTn] = huTnext;\n    set_variable(\"hunting_toggles\", JSON.stringify(HU.toggles));\n    run_function(\"hunting_buttons\", [], \"hunting\");\n    display_notice(\"[hunting] \" + (huTdef.label || huTn) + \" \" + huTnext.toUpperCase() + \".\", C);\n  }\n}\nelse if (huSub === \"buttons\") {\n  run_function(\"hunting_buttons\", [], \"hunting\");\n  display_notice(\"[hunting] F-keys laid out for \" + (HU.cls || \"no class yet\") + \".\", C);\n}\nelse if (huSub === \"rage\") {\n  display_notice(\"[hunting] rage \" + HU.rage + \", global cooldown \" + (HU.glob ? \"clear\" : \"running\"), C);\n  display_notice(\"  slots: \" + JSON.stringify(HU.slots), C);\n  display_notice(\"  cooldowns: \" + JSON.stringify(HU.cd), C);\n}\nelse if (huSub === \"reset\") {\n  HU.cd = {};\n  HU.glob = true;\n  run_function(\"hunting_setup\", [], \"hunting\");\n  run_function(\"hunting_buttons\", [], \"hunting\");\n  display_notice(\"[hunting] reset: rage cooldowns cleared, F-keys laid out again. Settings are kept.\", C);\n}\nelse if (huSub === \"debug\") {\n  display_notice(\"[hunting] cls=\" + HU.cls + \" bal=\" + HU.bal + \" eq=\" + HU.eq\n    + \" ep=\" + HU.ep + \"/\" + HU.maxep + \" wp=\" + HU.wp + \"/\" + HU.maxwp\n    + \" main=\" + JSON.stringify(HU.main) + \" spec=\" + HU.spec + \" toggles=\" + JSON.stringify(HU.toggles) + \" kill=\" + HU.kill, C);\n}\nelse {\n  display_notice(\"[hunting] unknown command '\" + huSub + \"'. HUNTING HELP for commands.\", \"orange\");\n}\n"
      }
     ],
     "text": "^hunting(?:\\s+(.*))?$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": false,
     "prefix_suffix": true
    }
   ]
  },
  {
   "type": "group",
   "name": "buttons",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "hunting_buttons",
     "enabled": true,
     "code": "// hunting_buttons -- lays out the F-key buttons for the current class, from\n// its file in classes/ (see classes/README.md), and makes that class's\n// battlerage costs the ones in use. Rows are [label, command] or\n// [label, command, \"main\"]: \"main\" lights the key whenever you have balance\n// and equilibrium. A key whose label has a battlerage cost is tracked for\n// rage highlighting automatically.\nvar HU = client.loom.hunting;\nvar huEntry = HU.classes[HU.cls];\nHU.costs = (huEntry && huEntry.rage) || {};\n\nvar huDragon = get_variable(\"hunting_dragon_attack\") || \"gut\";\nvar huModes = { physical: \"PHY\", magical: \"MAG\", auto: \"AUT\" };\nvar huMode = huModes[get_variable(\"hunting_dragon_mode\")] || \"AUT\";\n// The staff attack is artificing's setting when it's installed.\nvar huStaff = (client.loom.artificing && client.loom.artificing.staff) || get_variable(\"artificing_staff\") || get_variable(\"staffAttack\") || \"scintilla\";\n// Remembered so a new staff attack redraws the keys (see onGMCP).\nHU.staffDrawn = huStaff;\nvar huTarget = get_variable(\"hunting_party_target\") || \"\";\n// F9 opens huntstats when that package is around; otherwise the key stays empty.\n// Its saved records count too, as huntstats may load after hunting.\nvar huStats = (client.loom.registry && client.loom.registry.huntstats) || get_variable(\"huntstats_log\") || client.track || get_variable(\"hs_log\");\n\n// A class with no layout yet gets the generic keys only.\nvar huGeneric = [[\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"{stats}\", \"\"], [\"Diag\", \"diagnose\"], [\"\", \"\"], [\"Shield\", \"touch shield\"]];\nvar huRows = (huEntry && huEntry.keys) || huGeneric;\n// Keys that depend on your specialisation: specKeys[\"<Spec>\"] = { <F-key>: row }.\nvar huSpecRows = huEntry && huEntry.specKeys && HU.spec ? huEntry.specKeys[HU.spec] : null;\nif (huSpecRows) {\n  huRows = huRows.slice();\n  for (var huF in huSpecRows) huRows[to_number(huF) - 1] = huSpecRows[huF];\n}\nHU.slots = {};\nHU.main = [];\nrun_function(\"hunting_mainlist\", [], \"hunting\");\n\nfor (var huK = 1; huK <= 12; huK++) {\n  buttons_set_highlight(huK, 0);\n  var huRow = huRows[huK - 1] || [\"\", \"\"];\n  var huLabel = huRow[0];\n  var huCmd = huRow[1];\n  if (huLabel == \"{stats}\") {\n    huLabel = huStats ? \"Stats\" : \"\";\n    huCmd = huStats ? \"huntstats\" : \"\";\n  }\n  // {main}: the main attack in use (HUNTING MAIN); lit on balance and\n  // equilibrium.\n  if (huLabel == \"{main}\") {\n    huLabel = HU.mainNow ? HU.mainNow.label : \"\";\n    huCmd = HU.mainNow ? HU.mainNow.cmd : \"\";\n    if (HU.mainNow) HU.main.push(huK);\n  }\n  // {toggle:name}: a class toggle; the label shows its state, the key runs\n  // HUNTING TOGGLE. Not lit: the label says ON or OFF, and a lit key read as\n  // a ready ability.\n  var huTog = huLabel.match(/^\\{toggle:(\\w+)\\}$/);\n  var huTogOn = false;\n  if (huTog) {\n    var huTogDef = (huEntry && huEntry.toggles && huEntry.toggles[huTog[1]]) || {};\n    huTogOn = HU.toggles[huTog[1]] === \"on\";\n    huLabel = (huTogDef.label || huTog[1]) + (huTogOn ? \" ON\" : \" OFF\");\n    huCmd = \"hunting toggle \" + huTog[1];\n  }\n  huLabel = huLabel.replace(\"{DRAGON}\", huDragon == \"gut\" ? \"Gut\" : \"Incantation\").replace(\"{MODE}\", huMode);\n  huCmd = huCmd.replace(\"{dragon}\", huDragon).replace(\"{staff}\", huStaff).replace(\"{target}\", huTarget).replace(/\\s+$/, \"\");\n  buttons_set_label(huK, huLabel);\n  buttons_set_commands(huK, huCmd);\n  // The third field is \"main\", or the ability this key uses when its label\n  // is an abbreviation (\"SBP\" for Spinningbackfist); otherwise the label is\n  // the ability name.\n  var huAb = (huRow[2] && huRow[2] != \"main\") ? huRow[2] : huLabel;\n  if (HU.costs[huAb] !== undefined) HU.slots[huAb] = huK;\n  if (huRow[2] == \"main\") HU.main.push(huK);\n}\n\nif (get_variable(\"debug\") == \"on\") display_notice(\"[debug][hunting] buttons for \" + (HU.cls || \"no class\") + (HU.spec ? \", spec \" + HU.spec : \"\") + (huEntry ? \"\" : \" (not configured yet: generic keys)\"), \"cyan\");\nrun_function(\"hunting_highlight\", [], \"hunting\");\n"
    },
    {
     "type": "function",
     "name": "hunting_dragon_best",
     "enabled": true,
     "code": "// hunting_dragon_best -- in AUTO dragon mode, attack with GUT while endurance is\n// the fuller pool and with INCANTATION while willpower is. Vitals come from\n// hunting's own onGMCP.\nvar HU = client.loom.hunting;\nvar huDragon = HU.cls == \"Black Dragon\" || HU.cls == \"Blue Dragon\";\nif (huDragon && get_variable(\"hunting_dragon_mode\") == \"auto\" && HU.maxep && HU.maxwp) {\n  var huAttack = (HU.ep / HU.maxep > HU.wp / HU.maxwp) ? \"gut\" : \"incantation\";\n  if (huAttack != get_variable(\"hunting_dragon_attack\")) {\n    set_variable(\"hunting_dragon_attack\", huAttack);\n    if (get_variable(\"debug\") == \"on\") display_notice(\"[debug][hunting] dragon attack: \" + huAttack, \"cyan\");\n  }\n}\n"
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\n// Dragonform is up: fresh rage cooldowns, resume packages, after-form command.\nHU.cd = {};\nset_variable(\"pauseTriggers\", \"off\");\nvar huAf = get_variable(\"hunting_after_form\");\nif (huAf) send_command(huAf);\n"
      }
     ],
     "text": "^With an ear-splitting roar\\, you rear back your draconic head and scream out your triumph\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\n// Back to lesserform: fresh rage cooldowns, after-form command.\nHU.cd = {};\nvar huAf = get_variable(\"hunting_after_form\");\nif (huAf) send_command(huAf);\n"
      }
     ],
     "text": "^Your draconic form melts away, leaving you suddenly weaker and more vulnerable\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "// Dragonform is starting: it is interrupted by anything sent to the game, so\n// pause every package that respects pauseTriggers until the roar.\nset_variable(\"pauseTriggers\", \"on\");\n"
      }
     ],
     "text": "^With a grimness born of determination\\, you begin to unleash the Dragon that is now so much a part of the fabric of your soul\\. A black light begins to shine through from within you\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    }
   ]
  },
  {
   "type": "group",
   "name": "afflictions",
   "enabled": true,
   "items": [
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "rewrite",
       "enabled": true,
       "rewrite_text_type": "value",
       "rewrite_text": "[AGUE] ",
       "rewrite": "prefix",
       "rewrite_backref": "",
       "rewrite_colors": true,
       "rewrite_fg": "#007dff",
       "rewrite_bg": "#060606"
      }
     ],
     "text": "^(\\w+) lets loose a steady stream of cold air around (.*)\\, who begins to shiver uncontrollably\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "rewrite",
       "enabled": true,
       "rewrite_text_type": "value",
       "rewrite_text": "[-CLUMSINESS] ",
       "rewrite": "prefix",
       "rewrite_backref": "",
       "rewrite_colors": true,
       "rewrite_fg": "#007dff",
       "rewrite_bg": "#000000"
      }
     ],
     "text": "^(.*) rallies\\, no longer plagued with clumsiness\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "rewrite",
       "enabled": true,
       "rewrite_text_type": "value",
       "rewrite_text": "[+CLUMSINESS] ",
       "rewrite": "prefix",
       "rewrite_backref": "",
       "rewrite_colors": true,
       "rewrite_fg": "#007dff",
       "rewrite_bg": "#000000"
      }
     ],
     "text": "^(.*) reels\\, flinching as clumsiness takes hold\\.$",
