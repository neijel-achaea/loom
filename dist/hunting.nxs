  {
   "type": "group",
   "name": "rage",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "hl_buttons",
     "enabled": true,
     "code": "var activeClass = get_variable(\"activeClass\");\nvar slots = get_variable(\"rage_slots\") || {};\nvar costs = get_variable(\"rage_costs\") || {};\nvar cd    = get_variable(\"rage_cd\") || {};\nvar rage  = get_variable(\"my_rage\") || 0;\nvar glob  = get_variable(\"rage_global\");\n\nfor (var name in slots) {\n  if (costs[name] === undefined) { continue; }\n  var lit = glob && (cd[name] !== false) && rage >= costs[name];\n  buttons_set_highlight(slots[name], lit ? 1 : 0);\n}\n\n// Highlight main attack\nvar mybal = get_variable(\"my_bal\");\nvar myeq = get_variable(\"my_eq\");\n\nif (activeClass == \"Black Dragon\") {\n  if (mybal == \"1\" && myeq == \"1\") {\n    buttons_set_highlight(1, 1);\n    buttons_set_highlight(4, 1);\n    buttons_set_highlight(11, 1);\n  } else {\n    buttons_set_highlight(1, 0);\n    buttons_set_highlight(4, 0);\n    buttons_set_highlight(11, 0);\n  } \n}\n\nif (activeClass == \"Blue Dragon\") {\n  if (mybal == \"1\" && myeq == \"1\") {\n    buttons_set_highlight(1, 1);\n    buttons_set_highlight(4, 1);\n  } else {\n    buttons_set_highlight(1, 0);\n    buttons_set_highlight(4, 0);\n  } \n}\n\nif (activeClass == \"Magi\") {\n  if (mybal == \"1\" && myeq == \"1\") {\n    buttons_set_highlight(1, 1);\n  } else {\n    buttons_set_highlight(1, 0);\n  } \n}\n\nif (activeClass == \"Sylvan\") {\n  if (mybal == \"1\" && myeq == \"1\") {\n    buttons_set_highlight(1, 1);\n  } else {\n    buttons_set_highlight(1, 0);\n  } \n}"
    },
    {
     "type": "function",
     "name": "rage_init",
     "enabled": true,
     "code": "// Stores rage cost for all rage abilities across classes\nset_variable(\"rage_global\", \"true\");\n\nset_variable(\"rage_costs\", {\n  // Druid\n  Strangle: 14, Redeem: 22, Vinecrack: 17, Ravage: 36, Sear: 25, Glare: 14,\n\n  // Magi\n  Windlash: 14, Dilation: 35, Disintegrate: 17, Squeeze: 36, Firefall: 25, \n  Stormbolt: 25,\n\n  // Sylvan\n  Torrent: 14, Sandstorm: 29, Thornpierce: 17, Stonevine: 36, Leechroot: 25, \n  Rockshot: 28,\n\n  // Black Dragon\n  Dragonspit: 14, Dragonsting: 25, Dissolve: 17, Override: 36, Corrode: 25, \n  Dragonfear: 29, Provoke: 32,\n\n  // Blue Dragon\n  Dragonchill: 14, Glaciate: 26, Frostrive: 17, Frostwave: 25, Ague: 14,\n  \n  // Silver Dragon\n});\n\ndisplay_notice(\"[hunting] Rage abilities updated.\");"
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var costs = get_variable(\"rage_costs\") || {};\nvar cd    = get_variable(\"rage_cd\") || {};\nvar rage  = get_variable(\"my_rage\") || 0;\nvar avail = {};\nvar list  = args[1].replace(/\\.\\s*$/, \"\").split(/,\\s*/);\nfor (var i = 0; i < list.length; i++) { avail[list[i]] = true; }\nfor (var name in costs) {\n  if (avail[name]) {\n    cd[name] = true;\n  } else if (rage >= costs[name]) {\n    cd[name] = false;\n  }\n}\nset_variable(\"rage_cd\", cd);\nset_variable(\"rage_global\", true);\nrun_function(\"hl_buttons\", [], \"hunting\");"
      }
     ],
     "text": "^You can use another Battlerage ability again\\. Available abilities: (.+)$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var costs = get_variable(\"rage_costs\") || {};\nvar cd    = get_variable(\"rage_cd\") || {};\nvar rage  = get_variable(\"my_rage\") || 0;\nfor (var name in costs) {\n  if (rage >= costs[name]) { cd[name] = false; }\n}\nset_variable(\"rage_cd\", cd);\nset_variable(\"rage_global\", true);\nrun_function(\"hl_buttons\", [], \"hunting\");"
      }
     ],
     "text": "^You can use another Battlerage ability again, but none of your abilities are currently available\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var cd = get_variable(\"rage_cd\") || {};\ncd[args[1]] = true;\n\nset_variable(\"rage_cd\", cd);\nrun_function(\"hl_buttons\", [], \"hunting\");"
      }
     ],
     "text": "^You can use (\\w+) again\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "// alias: ragedebug\nvar slots = get_variable(\"rage_slots\");\nvar costs = get_variable(\"rage_costs\");\nvar cd    = get_variable(\"rage_cd\");\n\ndisplay_notice(\"rage: \"   + get_variable(\"my_rage\"), \"orange\");\ndisplay_notice(\"global: \" + get_variable(\"rage_global\"), \"orange\");\ndisplay_notice(\"slots: \"  + JSON.stringify(slots), \"orange\");\ndisplay_notice(\"costs: \"  + JSON.stringify(costs), \"orange\");\ndisplay_notice(\"cd: \"     + JSON.stringify(cd), \"orange\");"
      }
     ],
     "text": "^ragedebug$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var cd = get_variable(\"rage_cd\") || {};\ncd[args[1]] = true;\nset_variable(\"rage_cd\", cd);\nrun_function(\"hl_buttons\", [], \"hunting\");"
      }
     ],
     "text": "^Your (\\w+) ability could be used again but you lack the necessary Rage\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    }
   ]
  }
