     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "rewrite",
       "enabled": true,
       "rewrite_text_type": "value",
       "rewrite_text": "[-CLUMSINESS] ",
       "rewrite": "prefix",
       "rewrite_backref": "",
       "rewrite_colors": true,
