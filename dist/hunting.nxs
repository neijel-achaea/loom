     "actions": [
      {
       "type": "rewrite",
       "enabled": true,
       "rewrite_text_type": "value",
       "rewrite_text": "[-CLUMSINESS] ",
       "rewrite": "prefix",
       "rewrite_backref": "",
       "rewrite_colors": true,
       "rewrite_fg": "#007dff",
       "rewrite_bg": "#000000"
