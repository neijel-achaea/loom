       "script": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\nHU.cd[args[1]] = true;\nrun_function(\"hunting_highlight\", [], \"hunting\");\n"
      }
     ],
     "text": "^You can use (\\w+) again\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\nHU.cd[args[1]] = true;\nrun_function(\"hunting_highlight\", [], \"hunting\");\n"
      }
     ],
     "text": "^Your (\\w+) ability could be used again but you lack the necessary Rage\\.$",
     "matching": "regexp",
