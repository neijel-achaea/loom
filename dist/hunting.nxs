{
 "type": "group",
 "name": "hunting",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"hunting_setup\", [], \"hunting\");\nrun_function(\"hunting_buttons\", [], \"hunting\");\ndisplay_notice(\"[hunting] installed. HUNTING HELP for commands.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is uninstalled"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"hunting_setup\", [], \"hunting\");\nrun_function(\"hunting_buttons\", [], \"hunting\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.costs) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\n\n// Class: hunting follows it itself and lays out the F-key buttons on change.\nif (args.gmcp_method == \"Char.Status\" && args.gmcp_args.class) {\n  if (args.gmcp_args.class != HU.cls) {\n    HU.cls = args.gmcp_args.class;\n    run_function(\"hunting_buttons\", [], \"hunting\");\n  }\n}\n\nif (args.gmcp_method == \"Char.Vitals\") {\n  var v = args.gmcp_args;\n  HU.bal = String(v.bal) == \"1\";\n  HU.eq = String(v.eq) == \"1\";\n  HU.ep = to_number(v.ep); HU.maxep = to_number(v.maxep);\n  HU.wp = to_number(v.wp); HU.maxwp = to_number(v.maxwp);\n\n  // Dragonform in auto mode: pick gut or incantation from endurance vs willpower.\n  if (get_variable(\"hunting_dragon_mode\") == \"auto\") {\n    var huBefore = get_variable(\"hunting_dragon_attack\");\n    run_function(\"hunting_dragon_best\", [], \"hunting\");\n    if (get_variable(\"hunting_dragon_attack\") != huBefore) run_function(\"hunting_buttons\", [], \"hunting\");\n  }\n\n  var stats = args.gmcp_args.charstats;\n  var rage = null;\n  if (stats) {\n    for (var i = 0; i < stats.length; i++) {\n      var m = stats[i].match(/^Rage:\\s*(\\d+)/);\n      if (m) { rage = parseInt(m[1], 10); }\n    }\n  }\n  if (rage !== null) {\n    HU.rage = rage;\n  }\n  // Balance and equilibrium arrive on every vitals message, so refresh the\n  // highlights each time (the main attack lights on bal + eq).\n  run_function(\"hunting_highlight\", [], \"hunting\");\n}\n"
  },
  {
   "type": "group",
   "name": "core",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "hunting_setup",
     "enabled": true,
     "code": "// hunting_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Namespace, registry, one-time migration, defaults.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.hunting) client.loom.hunting = {};\nclient.loom.registry.hunting = { version: \"0.2.4\", keyword: \"HUNTING\" };\n\nvar HU = client.loom.hunting;\n\n// Battlerage costs for every class configured so far. Session data, not a\n// variable: rebuilt here on every load.\nHU.costs = {\n  // Druid\n  Strangle: 14, Redeem: 22, Vinecrack: 17, Ravage: 36, Sear: 25, Glare: 14,\n  // Magi\n  Windlash: 14, Dilation: 35, Disintegrate: 17, Squeeze: 36, Firefall: 25, Stormbolt: 25,\n  // Sylvan\n  Torrent: 14, Sandstorm: 29, Thornpierce: 17, Stonevine: 36, Leechroot: 25, Rockshot: 28,\n  // Black Dragon\n  Dragonspit: 14, Dragonsting: 25, Dissolve: 17, Override: 36, Corrode: 25, Dragonfear: 29, Provoke: 32,\n  // Blue Dragon\n  Dragonchill: 14, Glaciate: 26, Frostrive: 17, Frostwave: 25, Ague: 14\n};\n// Rage state: cooldowns per ability, F-key slot per ability, the global\n// battlerage cooldown, current rage.\nif (!HU.cd) HU.cd = {};\nif (!HU.slots) HU.slots = {};\nif (HU.glob === undefined) HU.glob = true;\nif (HU.rage === undefined) HU.rage = 0;\n\n// Class: followed from GMCP in onGMCP. Until the first Char.Status of the\n// session arrives, borrow the legacy shared variable if a package still sets it.\nif (!HU.cls && get_variable(\"activeClass\")) HU.cls = get_variable(\"activeClass\");\n\n// One-time migration from the pre-0.2 names: copy when the new one is unset,\n// then clear the old one.\nvar huOld = [\"dragonMode\", \"dragonAttack\", \"autogold\"];\nvar huNew = [\"hunting_dragon_mode\", \"hunting_dragon_attack\", \"hunting_autogold\"];\nvar huLegacy = false;\nfor (var huI = 0; huI < huOld.length; huI++) {\n  var huOv = get_variable(huOld[huI]);\n  if (huOv === null || huOv === undefined || huOv === \"\") continue;\n  huLegacy = true;\n  var huNv = get_variable(huNew[huI]);\n  if (huNv === null || huNv === undefined || huNv === \"\") set_variable(huNew[huI], huOv);\n  delete_variable(huOld[huI]);\n}\nvar huGone = [\"rage_costs\", \"rage_slots\", \"rage_cd\", \"rage_global\"];\nfor (var huJ = 0; huJ < huGone.length; huJ++) {\n  var huGv = get_variable(huGone[huJ]);\n  if (huGv !== null && huGv !== undefined) { huLegacy = true; delete_variable(huGone[huJ]); }\n}\n\n// Command sent when dragonform rises or falls. A profile that used hunting\n// before 0.2 always sent INITDEF there, so it keeps doing so; a fresh profile\n// sends nothing until HUNTING AFTERFORM sets one.\nvar huAf = get_variable(\"hunting_after_form\");\nif (huAf === null || huAf === undefined) set_variable(\"hunting_after_form\", huLegacy ? \"initdef\" : \"\");\n\nif (!get_variable(\"hunting_dragon_mode\")) set_variable(\"hunting_dragon_mode\", \"auto\");\nif (!get_variable(\"hunting_dragon_attack\")) set_variable(\"hunting_dragon_attack\", \"gut\");\nif (!get_variable(\"hunting_autogold\")) set_variable(\"hunting_autogold\", \"off\");\nvar huPt = get_variable(\"hunting_party_target\");\nif (huPt === null || huPt === undefined) set_variable(\"hunting_party_target\", \"\");\n"
    },
    {
     "type": "function",
     "name": "hunting_help",
     "enabled": true,
     "code": "// hunting_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[hunting] class F-keys, battlerage highlights, dragon attacks and autogold. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"HUNTING\", \"status\"],\n  [\"HUNTING DRAGONMODE [PHY|MAG|AUTO]\", \"gut, incantation, or whichever pool is fuller (no argument: next mode)\"],\n  [\"HUNTING AUTOGOLD [ON|ALL|OFF]\", \"pick up gold from your kills, from any corpse, or not at all\"],\n  [\"HUNTING PARTYTARGET [name|OFF]\", \"who party-aimed keys act on (the druid's Remedy key)\"],\n  [\"HUNTING AFTERFORM [cmd|OFF]\", \"command sent when dragonform rises or falls, e.g. DEFCON UP\"],\n  [\"HUNTING BUTTONS\", \"lay out the F-keys again\"],\n  [\"HUNTING RAGE\", \"rage, cooldowns and tracked keys\"],\n  [\"HUNTING RESET\", \"clear rage cooldowns, lay out the F-keys again\"],\n  [\"HUNTING DEBUG\", \"internal state\"],\n  [\"F-keys are set up for Druid, Magi, Sylvan, Black and Blue Dragon; other classes get Diag, Shield and Stats.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
    },
    {
     "type": "function",
     "name": "hunting_status",
     "enabled": true,
     "code": "var HU = client.loom.hunting;\nvar huPt = get_variable(\"hunting_party_target\");\nvar huAf = get_variable(\"hunting_after_form\");\ndisplay_notice(\"[hunting] class \" + (HU.cls || \"unknown\") + \", dragon mode \" + String(get_variable(\"hunting_dragon_mode\")).toUpperCase()\n  + \" (\" + get_variable(\"hunting_dragon_attack\") + \"), autogold \" + String(get_variable(\"hunting_autogold\")).toUpperCase()\n  + \", party target \" + (huPt ? huPt : \"none\") + \", after form \" + (huAf ? huAf.toUpperCase() : \"nothing\")\n  + \". HUNTING HELP for commands.\", \"cyan\");\n"
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "// HUNTING [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.hunting || !client.loom.hunting.costs) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\nvar huRaw = String(args[1] || \"\").trim();\nvar huSub = huRaw.split(/\\s+/)[0].toLowerCase();\nvar huRest = huRaw.substring(huSub.length).trim();\nvar huVal = huRest.toLowerCase();\nvar C = \"cyan\";\n\nif (huSub === \"\" || huSub === \"status\") {\n  run_function(\"hunting_status\", [], \"hunting\");\n}\nelse if (huSub === \"help\") {\n  run_function(\"hunting_help\", [], \"hunting\");\n}\nelse if (huSub === \"dragonmode\") {\n  var huCur = get_variable(\"hunting_dragon_mode\");\n  var huNext = huVal;\n  if (huNext === \"\") huNext = (huCur == \"auto\") ? \"physical\" : (huCur == \"physical\") ? \"magical\" : \"auto\";\n  if (huNext === \"phy\") huNext = \"physical\";\n  if (huNext === \"mag\") huNext = \"magical\";\n  if (huNext === \"aut\") huNext = \"auto\";\n  if (huNext !== \"physical\" && huNext !== \"magical\" && huNext !== \"auto\") {\n    display_notice(\"[hunting] dragon mode is PHYSICAL, MAGICAL or AUTO.\", \"orange\");\n  } else {\n    set_variable(\"hunting_dragon_mode\", huNext);\n    if (huNext === \"physical\") set_variable(\"hunting_dragon_attack\", \"gut\");\n    if (huNext === \"magical\") set_variable(\"hunting_dragon_attack\", \"incantation\");\n    if (huNext === \"auto\") run_function(\"hunting_dragon_best\", [], \"hunting\");\n    display_notice(\"[hunting] dragon mode \" + huNext.toUpperCase() + \": attacking with \" + get_variable(\"hunting_dragon_attack\") + \".\", C);\n    run_function(\"hunting_buttons\", [], \"hunting\");\n  }\n}\nelse if (huSub === \"autogold\") {\n  if (huVal === \"on\" || huVal === \"off\" || huVal === \"all\") {\n    set_variable(\"hunting_autogold\", huVal);\n    display_notice(\"[hunting] autogold \" + huVal.toUpperCase() + \".\", C);\n  } else if (huVal === \"\") {\n    display_notice(\"[hunting] autogold is \" + String(get_variable(\"hunting_autogold\")).toUpperCase() + \". HUNTING AUTOGOLD ON (your kills), ALL (any gold) or OFF.\", C);\n  } else {\n    display_notice(\"[hunting] autogold is ON, ALL or OFF.\", \"orange\");\n  }\n}\nelse if (huSub === \"partytarget\") {\n  if (huVal === \"\") {\n    var huPt = get_variable(\"hunting_party_target\");\n    display_notice(\"[hunting] party target: \" + (huPt ? huPt : \"none\") + \". HUNTING PARTYTARGET <name> or OFF.\", C);\n  } else {\n    set_variable(\"hunting_party_target\", huVal === \"off\" ? \"\" : huVal);\n    display_notice(\"[hunting] party target \" + (huVal === \"off\" ? \"cleared\" : \"set to \" + huVal) + \".\", C);\n    run_function(\"hunting_buttons\", [], \"hunting\");\n  }\n}\nelse if (huSub === \"afterform\") {\n  if (huVal === \"\") {\n    var huAf = get_variable(\"hunting_after_form\");\n    display_notice(\"[hunting] after dragonform rises or falls: \" + (huAf ? huAf.toUpperCase() : \"nothing\") + \". HUNTING AFTERFORM <command> or OFF.\", C);\n  } else {\n    set_variable(\"hunting_after_form\", huVal === \"off\" ? \"\" : huRest);\n    display_notice(\"[hunting] after dragonform rises or falls: \" + (huVal === \"off\" ? \"nothing\" : huRest.toUpperCase()) + \".\", C);\n  }\n}\nelse if (huSub === \"buttons\") {\n  run_function(\"hunting_buttons\", [], \"hunting\");\n  display_notice(\"[hunting] F-keys laid out for \" + (HU.cls || \"no class yet\") + \".\", C);\n}\nelse if (huSub === \"rage\") {\n  display_notice(\"[hunting] rage \" + HU.rage + \", global cooldown \" + (HU.glob ? \"clear\" : \"running\"), C);\n  display_notice(\"  slots: \" + JSON.stringify(HU.slots), C);\n  display_notice(\"  cooldowns: \" + JSON.stringify(HU.cd), C);\n}\nelse if (huSub === \"reset\") {\n  HU.cd = {};\n  HU.glob = true;\n  run_function(\"hunting_setup\", [], \"hunting\");\n  run_function(\"hunting_buttons\", [], \"hunting\");\n  display_notice(\"[hunting] reset: rage cooldowns cleared, F-keys laid out again. Settings are kept.\", C);\n}\nelse if (huSub === \"debug\") {\n  display_notice(\"[hunting] cls=\" + HU.cls + \" bal=\" + HU.bal + \" eq=\" + HU.eq\n    + \" ep=\" + HU.ep + \"/\" + HU.maxep + \" wp=\" + HU.wp + \"/\" + HU.maxwp\n    + \" main=\" + JSON.stringify(HU.main) + \" kill=\" + HU.kill, C);\n}\nelse {\n  display_notice(\"[hunting] unknown command '\" + huSub + \"'. HUNTING HELP for commands.\", \"orange\");\n}\n"
      }
     ],
     "text": "^hunting(?:\\s+(.*))?$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": false,
     "prefix_suffix": true
    }
   ]
  },
  {
   "type": "group",
   "name": "buttons",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "hunting_buttons",
     "enabled": true,
     "code": "// hunting_buttons -- lays out the F-key buttons for the current class.\n// One row per key: [label, command, main]. \"main\" lights the key whenever you\n// have balance and equilibrium. A key whose label has a battlerage cost in\n// HU.costs is tracked for rage highlighting automatically.\n// Placeholders filled in below: {dragon}/{DRAGON} gut or incantation,\n// {MODE} the dragon mode, {staff} the staff attack (artificing's ARTIFICING STAFF),\n// {target} the party target (HUNTING PARTYTARGET).\nvar HU = client.loom.hunting;\nvar huQ = \"queue add !wu!t!p \";\n\nvar huLayouts = {\n  \"Druid\": [\n    [\"Maul\", \"queue add b!wu!t!p wreathe | queue add b!wu!t!p maul @tar\", false],\n    [\"Strangle\", huQ + \"strangle @tar\", false],\n    [\"Ravage\", huQ + \"ravage @tar\", false],\n    [\"Vinecrack\", huQ + \"vinecrack @tar\", false],\n    [\"Glare\", huQ + \"quarterstaff glare @tar\", false],\n    [\"Sting\", \"queue add b!wu!t sting @tar\", false],\n    [\"Remedy\", \"evoke remedy {target}\", false],\n    [\"Douse\", \"freeze ground\", false],\n    [\"{stats}\", \"\", false],\n    [\"Diag\", \"diagnose\", false],\n    [\"Barrier\", \"evoke barrier\", false],\n    [\"Shield\", \"touch shield\", false]\n  ],\n  \"Magi\": [\n    [\"Staff\", \"queue add e!wu!t!p staff cast {staff} at @tar\", true],\n    [\"Windlash\", huQ + \"cast windlash at @tar\", false],\n    [\"Squeeze\", huQ + \"cast squeeze @tar\", false],\n    [\"Disintegrate\", huQ + \"cast disintegrate at @tar\", false],\n    [\"Firefall\", huQ + \"cast firefall at @tar\", false],\n    [\"Stormbolt\", huQ + \"cast stormbolt at @tar\", false],\n    [\"Dilation\", huQ + \"cast dilation at @tar\", false],\n    [\"Flood\", \"queue add e cast flood\", false],\n    [\"{stats}\", \"\", false],\n    [\"Diag\", \"diagnose\", false],\n    [\"Reflection\", \"queue add e!wu!t!p cast reflection at me\", false],\n    [\"Shield\", \"touch shield\", false]\n  ],\n  \"Sylvan\": [\n    [\"Thornrend\", \"queue add e!wu!t!p thornrend @tar\", true],\n    [\"Torrent\", huQ + \"cast torrent at @tar\", false],\n    [\"Sandstorm\", huQ + \"cast sandstorm at @tar\", false],\n    [\"Thornpierce\", huQ + \"thornpierce @tar\", false],\n    [\"Stonevine\", huQ + \"stonevine @tar\", false],\n    [\"Leechroot\", huQ + \"leechroot @tar\", false],\n    [\"Rockshot\", huQ + \"cast rockshot at @tar\", false],\n    [\"Flood\", \"queue add e cast flood\", false],\n    [\"{stats}\", \"\", false],\n    [\"Diag\", \"diagnose\", false],\n    [\"Reflection\", \"queue add e!wu!t!p cast reflection at me\", false],\n    [\"Shield\", \"touch shield\", false]\n  ],\n  \"Black Dragon\": [\n    [\"{DRAGON}\", \"queue add eb!wu!t!p {dragon} @tar\", true],\n    [\"Dragonspit\", huQ + \"dragonspit @tar\", false],\n    [\"Override\", huQ + \"override @tar\", false],\n    [\"Blast\", \"queue add eb!wu!t!p blast @tar\", true],\n    [\"Corrode\", huQ + \"corrode @tar\", false],\n    [\"Dragonsting\", huQ + \"dragonsting @tar\", false],\n    [\"Dragonfear\", huQ + \"dragonfear @tar\", false],\n    [\"{MODE}\", \"hunting dragonmode\", false],\n    [\"{stats}\", \"\", false],\n    [\"Diag\", \"diagnose\", false],\n    [\"Dragonheal\", \"queue add eq!wu!t!p dragonheal\", true],\n    [\"Shield\", \"touch shield\", false]\n  ],\n  \"Blue Dragon\": [\n    [\"{DRAGON}\", \"queue add eb!wu!t!p {dragon} @tar\", true],\n    [\"Dragonchill\", huQ + \"dragonchill @tar\", false],\n    [\"Override\", huQ + \"override @tar\", false],\n    [\"Blast\", \"queue add eb!wu!t!p blast @tar\", true],\n    [\"Frostwave\", huQ + \"frostwave @tar\", false],\n    [\"Ague\", huQ + \"ague @tar\", false],\n    [\"\", \"\", false],\n    [\"{MODE}\", \"hunting dragonmode\", false],\n    [\"{stats}\", \"\", false],\n    [\"Diag\", \"diagnose\", false],\n    [\"\", \"\", false],\n    [\"Shield\", \"touch shield\", false]\n  ]\n};\n\nvar huDragon = get_variable(\"hunting_dragon_attack\") || \"gut\";\nvar huModes = { physical: \"PHY\", magical: \"MAG\", auto: \"AUT\" };\nvar huMode = huModes[get_variable(\"hunting_dragon_mode\")] || \"AUT\";\n// The staff attack is artificing's setting when it's installed.\nvar huStaff = (client.loom.artificing && client.loom.artificing.staff) || get_variable(\"artificing_staff\") || get_variable(\"staffAttack\") || \"scintilla\";\nvar huTarget = get_variable(\"hunting_party_target\") || \"\";\n// F9 opens huntstats when that package is around; otherwise the key stays empty.\n// Its saved records count too, as huntstats may load after hunting.\nvar huStats = (client.loom.registry && client.loom.registry.huntstats) || get_variable(\"huntstats_log\") || client.track || get_variable(\"hs_log\");\n\n// A class with no layout yet gets the generic keys only.\nvar huGeneric = [[\"\", \"\", false], [\"\", \"\", false], [\"\", \"\", false], [\"\", \"\", false], [\"\", \"\", false], [\"\", \"\", false], [\"\", \"\", false], [\"\", \"\", false], [\"{stats}\", \"\", false], [\"Diag\", \"diagnose\", false], [\"\", \"\", false], [\"Shield\", \"touch shield\", false]];\nvar huRows = huLayouts[HU.cls] || huGeneric;\nHU.slots = {};\nHU.main = [];\n\nfor (var huK = 1; huK <= 12; huK++) {\n  buttons_set_highlight(huK, 0);\n  var huRow = huRows[huK - 1] || [\"\", \"\", false];\n  var huLabel = huRow[0];\n  var huCmd = huRow[1];\n  if (huLabel == \"{stats}\") {\n    huLabel = huStats ? \"Stats\" : \"\";\n    huCmd = huStats ? \"huntstats\" : \"\";\n  }\n  huLabel = huLabel.replace(\"{DRAGON}\", huDragon == \"gut\" ? \"Gut\" : \"Incantation\").replace(\"{MODE}\", huMode);\n  huCmd = huCmd.replace(\"{dragon}\", huDragon).replace(\"{staff}\", huStaff).replace(\"{target}\", huTarget).replace(/\\s+$/, \"\");\n  buttons_set_label(huK, huLabel);\n  buttons_set_commands(huK, huCmd);\n  if (HU.costs[huLabel] !== undefined) HU.slots[huLabel] = huK;\n  if (huRow[2]) HU.main.push(huK);\n}\n\nif (get_variable(\"debug\") == \"on\") display_notice(\"[debug][hunting] buttons for \" + (HU.cls || \"no class\") + (huLayouts[HU.cls] ? \"\" : \" (not configured: generic keys)\"), \"cyan\");\nrun_function(\"hunting_highlight\", [], \"hunting\");\n"
    },
    {
     "type": "function",
     "name": "hunting_dragon_best",
     "enabled": true,
     "code": "// hunting_dragon_best -- in AUTO dragon mode, attack with GUT while endurance is\n// the fuller pool and with INCANTATION while willpower is. Vitals come from\n// hunting's own onGMCP.\nvar HU = client.loom.hunting;\nvar huDragon = HU.cls == \"Black Dragon\" || HU.cls == \"Blue Dragon\";\nif (huDragon && get_variable(\"hunting_dragon_mode\") == \"auto\" && HU.maxep && HU.maxwp) {\n  var huAttack = (HU.ep / HU.maxep > HU.wp / HU.maxwp) ? \"gut\" : \"incantation\";\n  if (huAttack != get_variable(\"hunting_dragon_attack\")) {\n    set_variable(\"hunting_dragon_attack\", huAttack);\n    if (get_variable(\"debug\") == \"on\") display_notice(\"[debug][hunting] dragon attack: \" + huAttack, \"cyan\");\n  }\n}\n"
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.costs) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\n// Dragonform is up: fresh rage cooldowns, resume packages, after-form command.\nHU.cd = {};\nset_variable(\"pauseTriggers\", \"off\");\nvar huAf = get_variable(\"hunting_after_form\");\nif (huAf) send_command(huAf);\n"
      }
     ],
     "text": "^With an ear-splitting roar\\, you rear back your draconic head and scream out your triumph\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.costs) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\n// Back to lesserform: fresh rage cooldowns, after-form command.\nHU.cd = {};\nvar huAf = get_variable(\"hunting_after_form\");\nif (huAf) send_command(huAf);\n"
      }
     ],
     "text": "^Your draconic form melts away, leaving you suddenly weaker and more vulnerable\\.$",
     "matching": "regexp",
