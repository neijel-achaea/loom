       "highlight_fg": "#ffbc00",
       "highlight_bg": "#000000",
       "highlight": "line",
       "highlight_backref": ""
      }
     ],
     "text": "A dizzying beam of energy strikes you as your attack rebounds off of",
     "matching": "substring",
