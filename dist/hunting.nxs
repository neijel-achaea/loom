{
 "type": "group",
 "name": "hunting",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is installed"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is uninstalled"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"rage_init\", [], \"hunting\");"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "if (args.gmcp_method == \"Char.Vitals\") {\n  var stats = args.gmcp_args.charstats;\n  var rage = null;\n  if (stats) {\n    for (var i = 0; i < stats.length; i++) {\n      var m = stats[i].match(/^Rage:\\s*(\\d+)/);\n      if (m) { rage = parseInt(m[1], 10); }\n    }\n  }\n  if (rage !== null) {\n    set_variable(\"my_rage\", rage);\n    run_function(\"hl_buttons\", [], \"hunting\");\n  }\n}"
  },
  {
   "type": "group",
   "name": "afflictions",
   "enabled": true,
   "items": [
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "rewrite",
       "enabled": true,
       "rewrite_text_type": "value",
       "rewrite_text": "[AGUE] ",
       "rewrite": "prefix",
       "rewrite_backref": "",
       "rewrite_colors": true,
       "rewrite_fg": "#007dff",
       "rewrite_bg": "#060606"
      },
      {
       "type": "sound",
       "enabled": true,
       "sound": "spell 4"
      }
     ],
     "text": "^(\\w+) lets loose a steady stream of cold air around (.*)\\, who begins to shiver uncontrollably\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "rewrite",
       "enabled": true,
       "rewrite_text_type": "value",
       "rewrite_text": "[-CLUMSINESS] ",
       "rewrite": "prefix",
       "rewrite_backref": "",
       "rewrite_colors": true,
       "rewrite_fg": "#007dff",
       "rewrite_bg": "#000000"
      }
     ],
     "text": "^(.*) rallies\\, no longer plagued with clumsiness\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "sound",
       "enabled": true,
       "sound": "spell 4"
      },
      {
       "type": "rewrite",
       "enabled": true,
       "rewrite_text_type": "value",
       "rewrite_text": "[+CLUMSINESS] ",
       "rewrite": "prefix",
       "rewrite_backref": "",
       "rewrite_colors": true,
       "rewrite_fg": "#007dff",
       "rewrite_bg": "#000000"
      }
     ],
     "text": "^(.*) reels\\, flinching as clumsiness takes hold\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "rewrite",
       "enabled": true,
       "rewrite_text_type": "value",
       "rewrite_text": "[-CLUMSINESS] ",
       "rewrite": "prefix",
       "rewrite_backref": "",
       "rewrite_colors": true,
       "rewrite_fg": "#007dff",
       "rewrite_bg": "#000000"
      }
     ],
     "text": "^(.*) shakes off the cold and clumsiness plaguing (\\w+)\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "sound",
       "enabled": true,
       "sound": "spell 4"
      },
      {
       "type": "rewrite",
       "enabled": true,
       "rewrite_text_type": "value",
       "rewrite_text": "[+CLUMSINESS] ",
       "rewrite": "prefix",
       "rewrite_backref": "",
       "rewrite_colors": true,
       "rewrite_fg": "#007dff",
       "rewrite_bg": "#000000"
      }
     ],
     "text": "^Frost blooms outwards from you\\, wreathing (.*) in frigid cold as clumsiness takes hold\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    }
   ]
  },
