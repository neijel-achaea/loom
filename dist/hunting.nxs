{
 "type": "group",
 "name": "hunting",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"hunting_setup\", [], \"hunting\");\nrun_function(\"hunting_buttons\", [], \"hunting\");\ndisplay_notice(\"[hunting] installed. HUNTING HELP for commands.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is uninstalled"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"hunting_setup\", [], \"hunting\");\nrun_function(\"hunting_buttons\", [], \"hunting\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\n\n// Class: hunting follows it itself. On a change: that class's keys and costs,\n// and fresh cooldowns, since ability names can repeat across classes.\nif (args.gmcp_method == \"Char.Status\" && args.gmcp_args.class) {\n  if (args.gmcp_args.class != HU.cls) {\n    HU.cls = args.gmcp_args.class;\n    HU.cd = {};\n    set_variable(\"hunting_class\", HU.cls);\n    run_function(\"hunting_buttons\", [], \"hunting\");\n  }\n}\n\nif (args.gmcp_method == \"Char.Vitals\") {\n  // A staff attack changed in artificing since the keys were drawn: redraw,\n  // so the staff key casts the new one. Read only, never called into.\n  var huStaffNow = client.loom.artificing && client.loom.artificing.staff;\n  if (huStaffNow && HU.staffDrawn && huStaffNow !== HU.staffDrawn) run_function(\"hunting_buttons\", [], \"hunting\");\n\n  var v = args.gmcp_args;\n  HU.bal = String(v.bal) == \"1\";\n  HU.eq = String(v.eq) == \"1\";\n  HU.ep = to_number(v.ep); HU.maxep = to_number(v.maxep);\n  HU.wp = to_number(v.wp); HU.maxwp = to_number(v.maxwp);\n\n  // Dragonform in auto mode: pick gut or incantation from endurance vs willpower.\n  if (get_variable(\"hunting_dragon_mode\") == \"auto\") {\n    var huBefore = get_variable(\"hunting_dragon_attack\");\n    run_function(\"hunting_dragon_best\", [], \"hunting\");\n    if (get_variable(\"hunting_dragon_attack\") != huBefore) run_function(\"hunting_buttons\", [], \"hunting\");\n  }\n\n  var stats = args.gmcp_args.charstats;\n  var rage = null;\n  if (stats) {\n    for (var i = 0; i < stats.length; i++) {\n      var m = stats[i].match(/^Rage:\\s*(\\d+)/);\n      if (m) { rage = parseInt(m[1], 10); }\n    }\n  }\n  if (rage !== null) {\n    HU.rage = rage;\n  }\n  // Balance and equilibrium arrive on every vitals message, so refresh the\n  // highlights each time (the main attack lights on bal + eq).\n  run_function(\"hunting_highlight\", [], \"hunting\");\n}\n"
  },
  {
   "type": "group",
   "name": "core",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "hunting_setup",
     "enabled": true,
     "code": "// hunting_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Namespace, registry, one-time migration, defaults.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.hunting) client.loom.hunting = {};\nclient.loom.registry.hunting = { version: \"0.3.0\", keyword: \"HUNTING\", desc: \"Class F-keys with battlerage cooldowns, dragon attacks, autogold\" };\n\nvar HU = client.loom.hunting;\n\n// Per-class tables (classes/*.js): F-keys, battlerage costs, attack lines.\n// Session data, rebuilt on every load. HU.costs is the current class's costs,\n// set below and by hunting_buttons on each class change.\nrun_function(\"hunting_classes\", [], \"hunting\");\n// Colour of tagged attack lines.\nHU.lineFg = \"#d8f37e\";\nHU.lineBg = \"#000000\";\n// Rage state: cooldowns per ability (current class only: cleared on every\n// class change), F-key slot per ability, the global battlerage cooldown,\n// current rage.\nif (!HU.cd) HU.cd = {};\nif (!HU.slots) HU.slots = {};\nif (HU.glob === undefined) HU.glob = true;\nif (HU.rage === undefined) HU.rage = 0;\n\n// Class: followed from GMCP in onGMCP, and kept in hunting_class because the\n// game sends Char.Status only at login and on a change. The first time,\n// loom's old activeClass seeds it (read only).\nif (!HU.cls) HU.cls = get_variable(\"hunting_class\") || get_variable(\"activeClass\") || \"\";\nif (HU.cls && !get_variable(\"hunting_class\")) set_variable(\"hunting_class\", HU.cls);\nHU.costs = (HU.classes[HU.cls] && HU.classes[HU.cls].rage) || {};\n\n// One-time migration from the pre-0.2 names: copy when the new one is unset,\n// then clear the old one.\nvar huOld = [\"dragonMode\", \"dragonAttack\", \"autogold\"];\nvar huNew = [\"hunting_dragon_mode\", \"hunting_dragon_attack\", \"hunting_autogold\"];\nvar huLegacy = false;\nfor (var huI = 0; huI < huOld.length; huI++) {\n  var huOv = get_variable(huOld[huI]);\n  if (huOv === null || huOv === undefined || huOv === \"\") continue;\n  huLegacy = true;\n  var huNv = get_variable(huNew[huI]);\n  if (huNv === null || huNv === undefined || huNv === \"\") set_variable(huNew[huI], huOv);\n  delete_variable(huOld[huI]);\n}\nvar huGone = [\"rage_costs\", \"rage_slots\", \"rage_cd\", \"rage_global\"];\nfor (var huJ = 0; huJ < huGone.length; huJ++) {\n  var huGv = get_variable(huGone[huJ]);\n  if (huGv !== null && huGv !== undefined) { huLegacy = true; delete_variable(huGone[huJ]); }\n}\n\n// Command sent when dragonform rises or falls. A profile that used hunting\n// before 0.2 always sent INITDEF there, so it keeps doing so; a fresh profile\n// sends nothing until HUNTING AFTERFORM sets one.\nvar huAf = get_variable(\"hunting_after_form\");\nif (huAf === null || huAf === undefined) set_variable(\"hunting_after_form\", huLegacy ? \"initdef\" : \"\");\n\nif (!get_variable(\"hunting_dragon_mode\")) set_variable(\"hunting_dragon_mode\", \"auto\");\nif (!get_variable(\"hunting_dragon_attack\")) set_variable(\"hunting_dragon_attack\", \"gut\");\nif (!get_variable(\"hunting_autogold\")) set_variable(\"hunting_autogold\", \"off\");\nvar huPt = get_variable(\"hunting_party_target\");\nif (huPt === null || huPt === undefined) set_variable(\"hunting_party_target\", \"\");\n"
    },
    {
     "type": "function",
     "name": "hunting_classes",
     "enabled": true,
     "code": "// hunting_classes -- the per-class tables, one file per class in classes/,\n// joined after this header by tools/build.py. Run from hunting_setup on every\n// load, so the tables are session data, never variables.\n// Each class file adds one entry: HU.classes[\"<class as GMCP names it>\"].\nvar HU = client.loom.hunting;\n// Prefix for battlerage keys: queued, so they fire as soon as you can act.\nvar huQ = \"queue add !wu!t!p \";\nHU.classes = {};\n\n// Black Dragon: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\nHU.classes[\"Black Dragon\"] = {\n  keys: [\n    [\"{DRAGON}\", \"queue add eb!wu!t!p {dragon} @tar\", \"main\"],\n    [\"Dragonspit\", huQ + \"dragonspit @tar\"],\n    [\"Override\", huQ + \"override @tar\"],\n    [\"Blast\", \"queue add eb!wu!t!p blast @tar\", \"main\"],\n    [\"Corrode\", huQ + \"corrode @tar\"],\n    [\"Dragonsting\", huQ + \"dragonsting @tar\"],\n    [\"Dragonfear\", huQ + \"dragonfear @tar\"],\n    [\"{MODE}\", \"hunting dragonmode\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Dragonheal\", \"queue add eq!wu!t!p dragonheal\", \"main\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Dragonspit: 14, Dragonsting: 25, Dissolve: 17, Override: 36, Corrode: 25, Dragonfear: 29, Provoke: 32 },\n  lines: [\n    [/^You rip into (.*) with your massive, deadly claws\\.$/, \"GUT\"],\n    [/^You spit a stream of acidic venom at (.*) who writhes in agony as the spittle seeps into (\\w+) skin\\.$/, \"DRAGONSPIT\", \"Dragonspit\"],\n    [/^Drawing from the well of your puissance, you invoke a dramatic chant in the dragon tongue. Your voice resonates with each word, culminating in a wave of magical energy that you bend to your will and thrust towards (.*), bombarding (\\w+) with the ancient power\\.$/, \"INCANTATION\"],\n    [/^You open your gigantic maw and spew acid on (.*). (\\w+) dodges to the side and is only partially covered by the corrosive slime\\.$/, \"CORRODE\", \"Corrode\"],\n    [/^You open your gigantic maw and spew acid on (.*)\\. (\\w+) is too clumsy to dodge the deluge and is coated in the corrosive slime\\.$/, \"CORRODE++\", \"Corrode\"],\n    [/^You bathe (.*)'s translucent shield in your noxious breath, dissolving it\\.$/, \"DISSOLVE\", \"Dissolve\"],\n    [/^You swing your mighty tail around, stabbing (.+) with an acid-covered spine\\.$/, \"DRAGONSTING\", \"Dragonsting\"],\n    [/^Opening your maw, you force out a tremendous stream of acid, blasting the flesh from the very bones of (.*)\\.$/, \"BLAST\"],\n    [/^You barrel into (.*) and knock (\\w+) to the ground before stomping over (\\w+) prone form\\.$/, \"OVERRIDE\", \"Override\"],\n    [/^You let out a great keening, and cast the impurities from your form\\.$/, \"DRAGONHEAL\"]\n  ]\n};\n\n// Blue Dragon: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\nHU.classes[\"Blue Dragon\"] = {\n  keys: [\n    [\"{DRAGON}\", \"queue add eb!wu!t!p {dragon} @tar\", \"main\"],\n    [\"Dragonchill\", huQ + \"dragonchill @tar\"],\n    [\"Override\", huQ + \"override @tar\"],\n    [\"Blast\", \"queue add eb!wu!t!p blast @tar\", \"main\"],\n    [\"Frostwave\", huQ + \"frostwave @tar\"],\n    [\"Ague\", huQ + \"ague @tar\"],\n    [\"\", \"\"],\n    [\"{MODE}\", \"hunting dragonmode\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Dragonchill: 14, Glaciate: 26, Frostrive: 17, Frostwave: 25, Ague: 14, Override: 36 },\n  lines: [\n    [/^You form small chunks of ice in your enormous maw, then spit them at (.*) in a barrage\\.$/, \"DRAGONCHILL\", \"Dragonchill\"],\n    [/^You breathe a wave of icy air at (.*)\\.$/, \"FROSTWAVE\", \"Frostwave\"],\n    [/^You let loose a steady stream of cold air around (.*), who begins to shiver uncontrollably\\.$/, \"AGUE\", \"Ague\"],\n    [/^You breathe a column of icy air at (.*)'s head, stunning (\\w+)\\.$/, \"GLACIATE\", \"Glaciate\"],\n    [/^Opening your massive maw, you throw your head forward and blast wave after wave of deadly, all-consuming cold at (.*)\\.$/, \"BLAST\"]\n  ]\n};\n\n// Druid: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\nHU.classes[\"Druid\"] = {\n  keys: [\n    [\"Maul\", \"queue add b!wu!t!p wreathe | queue add b!wu!t!p maul @tar\"],\n    [\"Strangle\", huQ + \"strangle @tar\"],\n    [\"Ravage\", huQ + \"ravage @tar\"],\n    [\"Vinecrack\", huQ + \"vinecrack @tar\"],\n    [\"Glare\", huQ + \"quarterstaff glare @tar\"],\n    [\"Sting\", \"queue add b!wu!t sting @tar\"],\n    [\"Remedy\", \"evoke remedy {target}\"],\n    [\"Douse\", \"freeze ground\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Barrier\", \"evoke barrier\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Strangle: 14, Redeem: 22, Vinecrack: 17, Ravage: 36, Sear: 25, Glare: 14 },\n  lines: [\n    [/You roar in rage and spring upon/, \"RAVAGE\", \"Ravage\"],\n    [/^You spring forwards onto /, \"MAUL\", null, \"knifes\"],\n    [/Rising in response to your incantation, vines burst forth from the very earth/, \"STRANGLE\", \"Strangle\"],\n    [/You cause the tip of your quarterstaff to glow brightly before thrusting it at the face of/, \"GLARE\", \"Glare\"]\n  ]\n};\n\n// Magi: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\nHU.classes[\"Magi\"] = {\n  keys: [\n    [\"Staff\", \"queue add e!wu!t!p staff cast {staff} at @tar\", \"main\"],\n    [\"Windlash\", huQ + \"cast windlash at @tar\"],\n    [\"Squeeze\", huQ + \"cast squeeze @tar\"],\n    [\"Disintegrate\", huQ + \"cast disintegrate at @tar\"],\n    [\"Firefall\", huQ + \"cast firefall at @tar\"],\n    [\"Stormbolt\", huQ + \"cast stormbolt at @tar\"],\n    [\"Dilation\", huQ + \"cast dilation at @tar\"],\n    [\"Flood\", \"queue add e cast flood\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Reflection\", \"queue add e!wu!t!p cast reflection at me\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Windlash: 14, Dilation: 35, Disintegrate: 17, Squeeze: 36, Firefall: 25, Stormbolt: 25 },\n  lines: [\n    [/^As you point an elemental staff at (.*), a scintilla of bright, burning light shoots out, striking (\\w+) with focused elemental power\\.$/, \"STAFF\"],\n    [/^You draw upon the power of air to summon sharp gusts of wind which begin to whip across (.*)'s exposed flesh\\.$/, \"WINDLASH\", \"Windlash\"],\n    [/^You raise a clenched fist and in obedience the earth rises in turn, a great hand of stone unfurling to clamp about (.*) in a vice-like squeeze\\.$/, \"SQUEEZE\", \"Squeeze\"],\n    [/^You raise your hands dramatically and summon a mighty flaming rock from the sky down at (.*), but (\\w+) dodges aside and is only dealt a glancing blow\\.$/, \"FIREFALL\", \"Firefall\"],\n    [/^You summon a whirlwind of flame around (.*) which consumes (\\w+) translucent shield\\.$/, \"DISINTEGRATE\", \"Disintegrate\"],\n    [/^A bolt of lightning roars out from your hands as you cast a powerful spell at (.*), inciting sensitive nerves across (\\w+) skin\\.$/, \"STORMBOLT\", \"Stormbolt\"],\n    [/^You raise your hands dramatically and summon a mighty flaming rock from the sky that slams into the clumsy form of (.*)\\.$/, \"FIREFALL++\", \"Firefall\"],\n    [/^You point an elemental staff at (.*) and (\\w+) screams in pain as (\\w+) skin begins to freeze and crack\\.$/, \"STAFF\"]\n  ]\n};\n\n// Sylvan: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\nHU.classes[\"Sylvan\"] = {\n  keys: [\n    [\"Thornrend\", \"queue add e!wu!t!p thornrend @tar\", \"main\"],\n    [\"Torrent\", huQ + \"cast torrent at @tar\"],\n    [\"Sandstorm\", huQ + \"cast sandstorm at @tar\"],\n    [\"Thornpierce\", huQ + \"thornpierce @tar\"],\n    [\"Stonevine\", huQ + \"stonevine @tar\"],\n    [\"Leechroot\", huQ + \"leechroot @tar\"],\n    [\"Rockshot\", huQ + \"cast rockshot at @tar\"],\n    [\"Flood\", \"queue add e cast flood\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Reflection\", \"queue add e!wu!t!p cast reflection at me\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Torrent: 14, Sandstorm: 29, Thornpierce: 17, Stonevine: 36, Leechroot: 25, Rockshot: 28 },\n  lines: [\n    [/^You command the razor-edged thorny vines around you to lash out and rend the flesh of (.*)\\.$/, \"THORNREND\"],\n    [/^(.*) coughs and splutters as you channel a gout of water at (\\w+) face\\.$/, \"TORRENT\", \"Torrent\"],\n    [/^(.*) stumbles about in fear and flails at (\\w+) head as you summon a small sandstorm around it\\.$/, \"SANDSTORM\", \"Sandstorm\"],\n    [/^A thorny vine reaches out from you and pierces through (.*)'s translucent shield, causing it to fade\\.$/, \"THORNPIERCE\", \"Thornpierce\"],\n    [/^You summon a great vine to wrap itself around (.*), then channel the element of earth into it, causing it to become rock hard and shatter as it constricts around (\\w+)\\.$/, \"STONEVINE\", \"Stonevine\"],\n    [/^A deadly root flies from your hand and burrows into (.*)'s flesh, but is unable to find sufficient sustenance\\.$/, \"LEECHROOT\", \"Leechroot\"],\n    [/^You form a small pebble, then channel air to fling it violently at (.*)'s head, causing (\\w+) to look dazed\\.$/, \"ROCKSHOT\", \"Rockshot\"]\n  ]\n};\n"
    },
    {
     "type": "function",
     "name": "hunting_help",
     "enabled": true,
     "code": "// hunting_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[hunting] class F-keys, battlerage highlights, dragon attacks and autogold. Commands:\";\n// Whether the current class has a file in classes/, and which classes do.\nvar hlHU = client.loom.hunting || {};\nvar hlKnown = [];\nfor (var hlK in (hlHU.classes || {})) hlKnown.push(hlK);\nvar hlClassNote = (hlHU.cls ? (hlHU.classes && hlHU.classes[hlHU.cls] ? hlHU.cls + \" is configured.\" : hlHU.cls + \" isn't configured yet: you get the generic keys (Stats, Diag, Shield) and no attack highlights.\") : \"No class seen yet.\")\n  + \" Configured: \" + hlKnown.join(\", \") + \".\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"HUNTING\", \"status\"],\n  [\"HUNTING DRAGONMODE [PHY|MAG|AUTO]\", \"gut, incantation, or whichever pool is fuller (no argument: next mode)\"],\n  [\"HUNTING AUTOGOLD [ON|ALL|OFF]\", \"pick up gold from your kills, from any corpse, or not at all\"],\n  [\"HUNTING PARTYTARGET [name|OFF]\", \"who party-aimed keys act on (the druid's Remedy key)\"],\n  [\"HUNTING AFTERFORM [cmd|OFF]\", \"command sent when dragonform rises or falls, e.g. DEFCON UP\"],\n  [\"HUNTING BUTTONS\", \"lay out the F-keys again\"],\n  [\"HUNTING RAGE\", \"rage, cooldowns and tracked keys\"],\n  [\"HUNTING RESET\", \"clear rage cooldowns, lay out the F-keys again\"],\n  [\"HUNTING DEBUG\", \"internal state\"],\n  [hlClassNote]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
    },
    {
     "type": "function",
     "name": "hunting_status",
     "enabled": true,
     "code": "var HU = client.loom.hunting;\nvar huPt = get_variable(\"hunting_party_target\");\nvar huAf = get_variable(\"hunting_after_form\");\ndisplay_notice(\"[hunting] class \" + (HU.cls || \"unknown\") + (HU.cls && !(HU.classes && HU.classes[HU.cls]) ? \" (not configured yet)\" : \"\") + \", dragon mode \" + String(get_variable(\"hunting_dragon_mode\")).toUpperCase()\n  + \" (\" + get_variable(\"hunting_dragon_attack\") + \"), autogold \" + String(get_variable(\"hunting_autogold\")).toUpperCase()\n  + \", party target \" + (huPt ? huPt : \"none\") + \", after form \" + (huAf ? huAf.toUpperCase() : \"nothing\")\n  + \". HUNTING HELP for commands.\", \"cyan\");\n"
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "// HUNTING [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\nvar huRaw = String(args[1] || \"\").trim();\nvar huSub = huRaw.split(/\\s+/)[0].toLowerCase();\nvar huRest = huRaw.substring(huSub.length).trim();\nvar huVal = huRest.toLowerCase();\nvar C = \"cyan\";\n\nif (huSub === \"\" || huSub === \"status\") {\n  run_function(\"hunting_status\", [], \"hunting\");\n}\nelse if (huSub === \"help\") {\n  run_function(\"hunting_help\", [], \"hunting\");\n}\nelse if (huSub === \"dragonmode\") {\n  var huCur = get_variable(\"hunting_dragon_mode\");\n  var huNext = huVal;\n  if (huNext === \"\") huNext = (huCur == \"auto\") ? \"physical\" : (huCur == \"physical\") ? \"magical\" : \"auto\";\n  if (huNext === \"phy\") huNext = \"physical\";\n  if (huNext === \"mag\") huNext = \"magical\";\n  if (huNext === \"aut\") huNext = \"auto\";\n  if (huNext !== \"physical\" && huNext !== \"magical\" && huNext !== \"auto\") {\n    display_notice(\"[hunting] dragon mode is PHYSICAL, MAGICAL or AUTO.\", \"orange\");\n  } else {\n    set_variable(\"hunting_dragon_mode\", huNext);\n    if (huNext === \"physical\") set_variable(\"hunting_dragon_attack\", \"gut\");\n    if (huNext === \"magical\") set_variable(\"hunting_dragon_attack\", \"incantation\");\n    if (huNext === \"auto\") run_function(\"hunting_dragon_best\", [], \"hunting\");\n    display_notice(\"[hunting] dragon mode \" + huNext.toUpperCase() + \": attacking with \" + get_variable(\"hunting_dragon_attack\") + \".\", C);\n    run_function(\"hunting_buttons\", [], \"hunting\");\n  }\n}\nelse if (huSub === \"autogold\") {\n  if (huVal === \"on\" || huVal === \"off\" || huVal === \"all\") {\n    set_variable(\"hunting_autogold\", huVal);\n    display_notice(\"[hunting] autogold \" + huVal.toUpperCase() + \".\", C);\n  } else if (huVal === \"\") {\n    display_notice(\"[hunting] autogold is \" + String(get_variable(\"hunting_autogold\")).toUpperCase() + \". HUNTING AUTOGOLD ON (your kills), ALL (any gold) or OFF.\", C);\n  } else {\n    display_notice(\"[hunting] autogold is ON, ALL or OFF.\", \"orange\");\n  }\n}\nelse if (huSub === \"partytarget\") {\n  if (huVal === \"\") {\n    var huPt = get_variable(\"hunting_party_target\");\n    display_notice(\"[hunting] party target: \" + (huPt ? huPt : \"none\") + \". HUNTING PARTYTARGET <name> or OFF.\", C);\n  } else {\n    set_variable(\"hunting_party_target\", huVal === \"off\" ? \"\" : huVal);\n    display_notice(\"[hunting] party target \" + (huVal === \"off\" ? \"cleared\" : \"set to \" + huVal) + \".\", C);\n    run_function(\"hunting_buttons\", [], \"hunting\");\n  }\n}\nelse if (huSub === \"afterform\") {\n  if (huVal === \"\") {\n    var huAf = get_variable(\"hunting_after_form\");\n    display_notice(\"[hunting] after dragonform rises or falls: \" + (huAf ? huAf.toUpperCase() : \"nothing\") + \". HUNTING AFTERFORM <command> or OFF.\", C);\n  } else {\n    set_variable(\"hunting_after_form\", huVal === \"off\" ? \"\" : huRest);\n    display_notice(\"[hunting] after dragonform rises or falls: \" + (huVal === \"off\" ? \"nothing\" : huRest.toUpperCase()) + \".\", C);\n  }\n}\nelse if (huSub === \"buttons\") {\n  run_function(\"hunting_buttons\", [], \"hunting\");\n  display_notice(\"[hunting] F-keys laid out for \" + (HU.cls || \"no class yet\") + \".\", C);\n}\nelse if (huSub === \"rage\") {\n  display_notice(\"[hunting] rage \" + HU.rage + \", global cooldown \" + (HU.glob ? \"clear\" : \"running\"), C);\n  display_notice(\"  slots: \" + JSON.stringify(HU.slots), C);\n  display_notice(\"  cooldowns: \" + JSON.stringify(HU.cd), C);\n}\nelse if (huSub === \"reset\") {\n  HU.cd = {};\n  HU.glob = true;\n  run_function(\"hunting_setup\", [], \"hunting\");\n  run_function(\"hunting_buttons\", [], \"hunting\");\n  display_notice(\"[hunting] reset: rage cooldowns cleared, F-keys laid out again. Settings are kept.\", C);\n}\nelse if (huSub === \"debug\") {\n  display_notice(\"[hunting] cls=\" + HU.cls + \" bal=\" + HU.bal + \" eq=\" + HU.eq\n    + \" ep=\" + HU.ep + \"/\" + HU.maxep + \" wp=\" + HU.wp + \"/\" + HU.maxwp\n    + \" main=\" + JSON.stringify(HU.main) + \" kill=\" + HU.kill, C);\n}\nelse {\n  display_notice(\"[hunting] unknown command '\" + huSub + \"'. HUNTING HELP for commands.\", \"orange\");\n}\n"
      }
     ],
     "text": "^hunting(?:\\s+(.*))?$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": false,
     "prefix_suffix": true
    }
   ]
  },
  {
   "type": "group",
   "name": "buttons",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "hunting_buttons",
     "enabled": true,
     "code": "// hunting_buttons -- lays out the F-key buttons for the current class, from\n// its file in classes/ (see classes/README.md), and makes that class's\n// battlerage costs the ones in use. Rows are [label, command] or\n// [label, command, \"main\"]: \"main\" lights the key whenever you have balance\n// and equilibrium. A key whose label has a battlerage cost is tracked for\n// rage highlighting automatically.\nvar HU = client.loom.hunting;\nvar huEntry = HU.classes[HU.cls];\nHU.costs = (huEntry && huEntry.rage) || {};\n\nvar huDragon = get_variable(\"hunting_dragon_attack\") || \"gut\";\nvar huModes = { physical: \"PHY\", magical: \"MAG\", auto: \"AUT\" };\nvar huMode = huModes[get_variable(\"hunting_dragon_mode\")] || \"AUT\";\n// The staff attack is artificing's setting when it's installed.\nvar huStaff = (client.loom.artificing && client.loom.artificing.staff) || get_variable(\"artificing_staff\") || get_variable(\"staffAttack\") || \"scintilla\";\n// Remembered so a new staff attack redraws the keys (see onGMCP).\nHU.staffDrawn = huStaff;\nvar huTarget = get_variable(\"hunting_party_target\") || \"\";\n// F9 opens huntstats when that package is around; otherwise the key stays empty.\n// Its saved records count too, as huntstats may load after hunting.\nvar huStats = (client.loom.registry && client.loom.registry.huntstats) || get_variable(\"huntstats_log\") || client.track || get_variable(\"hs_log\");\n\n// A class with no layout yet gets the generic keys only.\nvar huGeneric = [[\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"{stats}\", \"\"], [\"Diag\", \"diagnose\"], [\"\", \"\"], [\"Shield\", \"touch shield\"]];\nvar huRows = (huEntry && huEntry.keys) || huGeneric;\nHU.slots = {};\nHU.main = [];\n\nfor (var huK = 1; huK <= 12; huK++) {\n  buttons_set_highlight(huK, 0);\n  var huRow = huRows[huK - 1] || [\"\", \"\"];\n  var huLabel = huRow[0];\n  var huCmd = huRow[1];\n  if (huLabel == \"{stats}\") {\n    huLabel = huStats ? \"Stats\" : \"\";\n    huCmd = huStats ? \"huntstats\" : \"\";\n  }\n  huLabel = huLabel.replace(\"{DRAGON}\", huDragon == \"gut\" ? \"Gut\" : \"Incantation\").replace(\"{MODE}\", huMode);\n  huCmd = huCmd.replace(\"{dragon}\", huDragon).replace(\"{staff}\", huStaff).replace(\"{target}\", huTarget).replace(/\\s+$/, \"\");\n  buttons_set_label(huK, huLabel);\n  buttons_set_commands(huK, huCmd);\n  if (HU.costs[huLabel] !== undefined) HU.slots[huLabel] = huK;\n  if (huRow[2] == \"main\") HU.main.push(huK);\n}\n\nif (get_variable(\"debug\") == \"on\") display_notice(\"[debug][hunting] buttons for \" + (HU.cls || \"no class\") + (huEntry ? \"\" : \" (not configured yet: generic keys)\"), \"cyan\");\nrun_function(\"hunting_highlight\", [], \"hunting\");\n"
    },
    {
     "type": "function",
     "name": "hunting_dragon_best",
     "enabled": true,
     "code": "// hunting_dragon_best -- in AUTO dragon mode, attack with GUT while endurance is\n// the fuller pool and with INCANTATION while willpower is. Vitals come from\n// hunting's own onGMCP.\nvar HU = client.loom.hunting;\nvar huDragon = HU.cls == \"Black Dragon\" || HU.cls == \"Blue Dragon\";\nif (huDragon && get_variable(\"hunting_dragon_mode\") == \"auto\" && HU.maxep && HU.maxwp) {\n  var huAttack = (HU.ep / HU.maxep > HU.wp / HU.maxwp) ? \"gut\" : \"incantation\";\n  if (huAttack != get_variable(\"hunting_dragon_attack\")) {\n    set_variable(\"hunting_dragon_attack\", huAttack);\n    if (get_variable(\"debug\") == \"on\") display_notice(\"[debug][hunting] dragon attack: \" + huAttack, \"cyan\");\n  }\n}\n"
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\n// Dragonform is up: fresh rage cooldowns, resume packages, after-form command.\nHU.cd = {};\nset_variable(\"pauseTriggers\", \"off\");\nvar huAf = get_variable(\"hunting_after_form\");\nif (huAf) send_command(huAf);\n"
      }
     ],
     "text": "^With an ear-splitting roar\\, you rear back your draconic head and scream out your triumph\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\n// Back to lesserform: fresh rage cooldowns, after-form command.\nHU.cd = {};\nvar huAf = get_variable(\"hunting_after_form\");\nif (huAf) send_command(huAf);\n"
      }
     ],
     "text": "^Your draconic form melts away, leaving you suddenly weaker and more vulnerable\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "// Dragonform is starting: it is interrupted by anything sent to the game, so\n// pause every package that respects pauseTriggers until the roar.\nset_variable(\"pauseTriggers\", \"on\");\n"
      }
     ],
     "text": "^With a grimness born of determination\\, you begin to unleash the Dragon that is now so much a part of the fabric of your soul\\. A black light begins to shine through from within you\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    }
   ]
  },
  {
   "type": "group",
   "name": "afflictions",
   "enabled": true,
   "items": [
    {
     "type": "trigger",
