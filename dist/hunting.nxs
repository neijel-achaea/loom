       "script": "run_function(\"hunting_gold\", [], \"hunting\");\n"
      }
     ],
     "text": "Numerous golden sovereigns spill from the corpse.",
     "matching": "substring",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "run_function(\"hunting_gold\", [], \"hunting\");\n"
      }
     ],
     "text": "^A few golden sovereigns spill from the corpse\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "highlight",
       "enabled": true,
       "highlight_fg": "#6998de",
       "highlight_bg": "#000000",
       "highlight": "match",
       "highlight_backref": ""
      },
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\nHU.kill = new Date().getTime();\n"
      }
     ],
     "text": "^You have slain (.+)\\, retrieving the corpse\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "highlight",
       "enabled": true,
       "highlight_fg": "#6998de",
       "highlight_bg": "#000000",
       "highlight": "match",
       "highlight_backref": ""
      },
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\n// Only your own kills arm autogold: someone else's kill in the room is theirs.\nvar huMe = String(HU.name || get_variable(\"hunting_name\") || \"\").toLowerCase();\nif (huMe !== \"\" && String(args[2]).toLowerCase() === huMe) HU.kill = new Date().getTime();\n"
      }
     ],
     "text": "^(\\w+(?: \\w+)*) has been slain by (\\w+)\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    }
