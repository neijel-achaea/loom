        },
        {
         "type": "script",
         "enabled": true,
         "script": "var cd = get_variable(\"rage_cd\") || {};\ncd[\"Dragonspit\"] = false;\n\nset_variable(\"rage_cd\", cd);\nset_variable(\"rage_global\", false);\nrun_function(\"hl_buttons\", [], \"hunting\");"
        }
       ],
       "text": "^You spit a stream of acidic venom at (.*) who writhes in agony as the spittle seeps into (\\w+) skin\\.$",
