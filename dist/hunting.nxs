    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "rewrite",
       "enabled": true,
       "rewrite_text_type": "value",
       "rewrite_text": "[+CLUMSINESS] ",
       "rewrite": "prefix",
       "rewrite_backref": "",
       "rewrite_colors": true,
       "rewrite_fg": "#007dff",
       "rewrite_bg": "#000000"
      }
     ],
     "text": "^Frost blooms outwards from you\\, wreathing (.*) in frigid cold as clumsiness takes hold\\.$",
     "matching": "regexp",
