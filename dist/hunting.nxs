{
 "type": "group",
 "name": "hunting",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"hunting_setup\", [], \"hunting\");\nrun_function(\"hunting_buttons\", [], \"hunting\");\ndisplay_notice(\"[hunting] installed. HUNTING HELP for commands.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is uninstalled"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"hunting_setup\", [], \"hunting\");\nrun_function(\"hunting_buttons\", [], \"hunting\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\n\n// Class: hunting follows it itself. On a change: that class's keys and costs,\n// and fresh cooldowns, since ability names can repeat across classes.\nif (args.gmcp_method == \"Char.Status\" && args.gmcp_args.class) {\n  if (args.gmcp_args.class != HU.cls) {\n    HU.cls = args.gmcp_args.class;\n    HU.cd = {};\n    set_variable(\"hunting_class\", HU.cls);\n    run_function(\"hunting_buttons\", [], \"hunting\");\n  }\n}\n\nif (args.gmcp_method == \"Char.Vitals\") {\n  // A staff attack changed in artificing since the keys were drawn: redraw,\n  // so the staff key casts the new one. Read only, never called into.\n  var huStaffNow = client.loom.artificing && client.loom.artificing.staff;\n  if (huStaffNow && HU.staffDrawn && huStaffNow !== HU.staffDrawn) run_function(\"hunting_buttons\", [], \"hunting\");\n\n  var v = args.gmcp_args;\n  HU.bal = String(v.bal) == \"1\";\n  HU.eq = String(v.eq) == \"1\";\n  HU.ep = to_number(v.ep); HU.maxep = to_number(v.maxep);\n  HU.wp = to_number(v.wp); HU.maxwp = to_number(v.maxwp);\n\n  // Dragonform in auto mode: pick gut or incantation from endurance vs willpower.\n  if (get_variable(\"hunting_dragon_mode\") == \"auto\") {\n    var huBefore = get_variable(\"hunting_dragon_attack\");\n    run_function(\"hunting_dragon_best\", [], \"hunting\");\n    if (get_variable(\"hunting_dragon_attack\") != huBefore) run_function(\"hunting_buttons\", [], \"hunting\");\n  }\n\n  var stats = args.gmcp_args.charstats;\n  var rage = null;\n  if (stats) {\n    for (var i = 0; i < stats.length; i++) {\n      var m = stats[i].match(/^Rage:\\s*(\\d+)/);\n      if (m) { rage = parseInt(m[1], 10); }\n    }\n  }\n  if (rage !== null) {\n    HU.rage = rage;\n  }\n  // Specialisation (Infernal, Paladin, Runewarden): some keys depend on it,\n  // so a change lays the keys out again.\n  // Morph (Sentinel): picks the main attack, like the spec.\n  var huSpec = null, huMorph = null;\n  if (stats) {\n    for (var huS = 0; huS < stats.length; huS++) {\n      var huSm = String(stats[huS]).match(/^Spec:\\s*(.+)$/);\n      if (huSm) huSpec = huSm[1];\n      var huMm = String(stats[huS]).match(/^Morph:\\s*(.+)$/);\n      if (huMm) huMorph = huMm[1];\n    }\n  }\n  var huRedraw = false;\n  if (huSpec !== null && huSpec !== HU.spec) {\n    // A real change (not the first reading after a load) drops the main\n    // attack picked by hand, so the new spec's default takes over.\n    if (HU.spec !== undefined && HU.mains[HU.cls]) { delete HU.mains[HU.cls]; set_variable(\"hunting_mains\", JSON.stringify(HU.mains)); }\n    HU.spec = huSpec;\n    huRedraw = true;\n  }\n  if (huMorph !== null && huMorph !== HU.morph) {\n    if (HU.morph !== undefined && HU.mains[HU.cls]) { delete HU.mains[HU.cls]; set_variable(\"hunting_mains\", JSON.stringify(HU.mains)); }\n    HU.morph = huMorph;\n    huRedraw = true;\n  }\n  if (huRedraw) run_function(\"hunting_buttons\", [], \"hunting\");\n  // Balance and equilibrium arrive on every vitals message, so refresh the\n  // highlights each time (the main attack lights on bal + eq).\n  run_function(\"hunting_highlight\", [], \"hunting\");\n}\n"
  },
  {
   "type": "group",
   "name": "core",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "hunting_setup",
     "enabled": true,
     "code": "// hunting_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Namespace, registry, one-time migration, defaults.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.hunting) client.loom.hunting = {};\nclient.loom.registry.hunting = { version: \"0.3.6\", keyword: \"HUNTING\", desc: \"Class F-keys with battlerage cooldowns, dragon attacks, autogold\" };\n\nvar HU = client.loom.hunting;\n\n// Per-class tables (classes/*.js): F-keys, battlerage costs, attack lines.\n// Session data, rebuilt on every load. HU.costs is the current class's costs,\n// set below and by hunting_buttons on each class change.\nrun_function(\"hunting_classes\", [], \"hunting\");\n// Colour of tagged attack lines.\nHU.lineFg = \"#d8f37e\";\nHU.lineBg = \"#000000\";\n// Rage state: cooldowns per ability (current class only: cleared on every\n// class change), F-key slot per ability, the global battlerage cooldown,\n// current rage.\nif (!HU.cd) HU.cd = {};\nif (!HU.slots) HU.slots = {};\nif (HU.glob === undefined) HU.glob = true;\n// Main attack chosen per class (HUNTING MAIN), and the ones added in game:\n// { \"Psion\": \"overhand\" }, { \"Psion\": { \"deathblow\": \"weave deathblow @tar\" } }.\nif (!HU.mains) {\n  HU.mains = {};\n  try { HU.mains = JSON.parse(get_variable(\"hunting_mains\") || \"{}\") || {}; } catch (e) { HU.mains = {}; }\n}\nif (!HU.mainsAdded) {\n  HU.mainsAdded = {};\n  try { HU.mainsAdded = JSON.parse(get_variable(\"hunting_mains_added\") || \"{}\") || {}; } catch (e) { HU.mainsAdded = {}; }\n}\n// Class toggles' state (sneak, weave...): { name: \"on\" | \"off\" }, kept so a\n// reload remembers it.\nif (!HU.toggles) {\n  HU.toggles = {};\n  try { HU.toggles = JSON.parse(get_variable(\"hunting_toggles\") || \"{}\") || {}; } catch (e) { HU.toggles = {}; }\n}\nif (HU.rage === undefined) HU.rage = 0;\n\n// Class: followed from GMCP in onGMCP, and kept in hunting_class because the\n// game sends Char.Status only at login and on a change. The first time,\n// loom's old activeClass seeds it (read only).\nif (!HU.cls) HU.cls = get_variable(\"hunting_class\") || get_variable(\"activeClass\") || \"\";\nif (HU.cls && !get_variable(\"hunting_class\")) set_variable(\"hunting_class\", HU.cls);\nHU.costs = (HU.classes[HU.cls] && HU.classes[HU.cls].rage) || {};\n\n// One-time migration from the pre-0.2 names: copy when the new one is unset,\n// then clear the old one.\nvar huOld = [\"dragonMode\", \"dragonAttack\", \"autogold\"];\nvar huNew = [\"hunting_dragon_mode\", \"hunting_dragon_attack\", \"hunting_autogold\"];\nvar huLegacy = false;\nfor (var huI = 0; huI < huOld.length; huI++) {\n  var huOv = get_variable(huOld[huI]);\n  if (huOv === null || huOv === undefined || huOv === \"\") continue;\n  huLegacy = true;\n  var huNv = get_variable(huNew[huI]);\n  if (huNv === null || huNv === undefined || huNv === \"\") set_variable(huNew[huI], huOv);\n  delete_variable(huOld[huI]);\n}\nvar huGone = [\"rage_costs\", \"rage_slots\", \"rage_cd\", \"rage_global\"];\nfor (var huJ = 0; huJ < huGone.length; huJ++) {\n  var huGv = get_variable(huGone[huJ]);\n  if (huGv !== null && huGv !== undefined) { huLegacy = true; delete_variable(huGone[huJ]); }\n}\n\n// Command sent when dragonform rises or falls. A profile that used hunting\n// before 0.2 always sent INITDEF there, so it keeps doing so; a fresh profile\n// sends nothing until HUNTING AFTERFORM sets one.\nvar huAf = get_variable(\"hunting_after_form\");\nif (huAf === null || huAf === undefined) set_variable(\"hunting_after_form\", huLegacy ? \"initdef\" : \"\");\n\nif (!get_variable(\"hunting_dragon_mode\")) set_variable(\"hunting_dragon_mode\", \"auto\");\nif (!get_variable(\"hunting_dragon_attack\")) set_variable(\"hunting_dragon_attack\", \"gut\");\nif (!get_variable(\"hunting_autogold\")) set_variable(\"hunting_autogold\", \"off\");\nvar huPt = get_variable(\"hunting_party_target\");\nif (huPt === null || huPt === undefined) set_variable(\"hunting_party_target\", \"\");\n"
    },
    {
     "type": "function",
     "name": "hunting_classes",
     "enabled": true,
     "code": "// hunting_classes -- the per-class tables, one file per class in classes/,\n// joined after this header by tools/build.py. Run from hunting_setup on every\n// load, so the tables are session data, never variables.\n// Each class file adds one entry: HU.classes[\"<class as GMCP names it>\"].\nvar HU = client.loom.hunting;\n// Prefix for battlerage keys: queued, so they fire as soon as you can act.\nvar huQ = \"queue add !wu!t!p \";\nHU.classes = {};\n\n// Alchemist: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Miasma 16s,\n// Magnesium 23s, Pathogen 23s, Cadmium 31s, Hypnotic 41s, Provoke 20s.\nHU.classes[\"Alchemist\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    iron: [\"Iron\", \"queue add e!wu!t!p educe iron @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Miasma\", huQ + \"throw miasma at @tar\"],\n    [\"Magnesium\", huQ + \"educe magnesium @tar\"],\n    [\"Caustic\", huQ + \"throw caustic at @tar\"],\n    [\"Pathogen\", huQ + \"throw pathogen at @tar\"],\n    [\"Cadmium\", huQ + \"educe cadmium @tar\"],\n    [\"Hypnotic\", huQ + \"throw hypnotic at @tar\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Miasma: 14, Magnesium: 36, Caustic: 17, Pathogen: 25, Cadmium: 22, Hypnotic: 28, Provoke: 32 },\n  // To capture (#31): Iron; Miasma; Magnesium; Caustic (on a shielded\n  // target); Pathogen, plain and PATHOGEN++ (target inhibited or afraid);\n  // Cadmium; Hypnotic; Provoke.\n  lines: [\n  ]\n};\n\n// Apostate: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Convulsions 16s,\n// Burrow 23s, Bloodlet 23s, Possess 43s, Horrify 34s, Provoke 20s.\n// Class condition (charstats, for self): Essence.\nHU.classes[\"Apostate\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    bleed: [\"Bleed\", \"queue add b!wu!t!p deadeyes @tar bleed bleed\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Convulsions\", huQ + \"stare @tar convulsions\"],\n    [\"Burrow\", huQ + \"daegger burrow @tar\"],\n    [\"Pierce\", huQ + \"daegger pierce @tar\"],\n    [\"Bloodlet\", huQ + \"bloodlet @tar\"],\n    [\"Possess\", huQ + \"possess @tar\"],\n    [\"\", \"\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Horrify\", huQ + \"stare @tar horrify\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Convulsions: 14, Burrow: 36, Pierce: 17, Bloodlet: 25, Possess: 32, Horrify: 29, Provoke: 32 },\n  // To capture (#31): Bleed (deadeyes); Convulsions; Burrow; Pierce (on a\n  // shielded target); Bloodlet, plain and BLOODLET++ (target sensitive or\n  // stunned); Possess; Horrify; Provoke.\n  lines: [\n  ]\n};\n\n// Bard: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Moulinet 16s,\n// Howlslash 23s, Cyclone 23s, Trill 41s, Charm 43s, Provoke 20s.\n// Class condition (charstats, for self): Voice (Yes/No).\nHU.classes[\"Bard\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    jab: [\"Jab\", \"queue add b!wu!t!p blade jab @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Moulinet\", huQ + \"moulinet @tar\"],\n    [\"Howlslash\", huQ + \"howlslash @tar\"],\n    [\"Resonance\", huQ + \"play resonance at @tar\"],\n    [\"Cyclone\", huQ + \"cyclone @tar\"],\n    [\"Trill\", huQ + \"play trill at @tar\"],\n    [\"Charm\", huQ + \"play charm at @tar\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Moulinet: 14, Howlslash: 36, Resonance: 17, Cyclone: 25, Trill: 28, Charm: 32, Provoke: 32 },\n  // To capture (#31): Jab; Moulinet; Howlslash; Resonance (on a shielded\n  // target); Cyclone, plain and CYCLONE++ (target clumsy or stunned); Trill;\n  // Charm; Provoke.\n  lines: [\n  ]\n};\n\n// Blademaster: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Leapstrike 16s,\n// Spinslash 23s, Headstrike 23s, Daze 33s, Nerveslash 31s, Provoke 20s.\n// Class conditions (charstats, for self): Shin, Stance.\nHU.classes[\"Blademaster\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    drawslash: [\"Drawslash\", \"queue add b!wu!t!p drawslash @tar sternum\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Leapstrike\", huQ + \"leapstrike @tar\"],\n    [\"Spinslash\", huQ + \"spinslash @tar\"],\n    [\"Shatter\", huQ + \"shin shatter @tar\"],\n    [\"Headstrike\", huQ + \"strike @tar head\"],\n    [\"Daze\", huQ + \"shin daze @tar\"],\n    [\"Nerveslash\", huQ + \"nerveslash @tar\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Leapstrike: 14, Spinslash: 36, Shatter: 17, Headstrike: 25, Daze: 26, Nerveslash: 22, Provoke: 32 },\n  // To capture (#31): Drawslash (check that STERNUM works); Leapstrike; Spinslash; Shatter (on a\n  // shielded target); Headstrike, plain and HEADSTRIKE++ (target reckless or\n  // afraid); Daze; Nerveslash; Provoke. Also check the name the game uses in\n  // \"You can use ... again\" for Headstrike (typed as STRIKE HEAD).\n  lines: [\n  ]\n};\n\n// Depthswalker: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Drain 16s,\n// Lash 23s, Erasure 23s, Curse 35s, Boinad 38s, Provoke 20s.\n// Class conditions (charstats, for self): Word (Yes/No), Age.\nHU.classes[\"Depthswalker\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    cull: [\"Cull\", \"queue add eb!wu!t!p shadow cull @tar\"]\n  },\n  keys: [\n    // Cull: the help doesn't say bal or eq, so it waits for both until #31\n    // shows which one it uses.\n    [\"{main}\", \"\"],\n    [\"Drain\", huQ + \"shadow drain @tar\"],\n    [\"Lash\", huQ + \"shadow lash @tar\"],\n    [\"Nakail\", huQ + \"intone nakail @tar\"],\n    [\"Erasure\", huQ + \"chrono erasure @tar\"],\n    [\"Curse\", huQ + \"chrono curse @tar\"],\n    [\"Boinad\", huQ + \"intone boinad @tar\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Drain: 14, Lash: 36, Nakail: 17, Erasure: 25, Curse: 24, Boinad: 32, Provoke: 32 },\n  // To capture (#31): Cull (and which balance it takes); Drain; Lash; Nakail\n  // (on a shielded target); Erasure, plain and ERASURE++ (target weakened or\n  // amnesiac); Curse; Boinad; Provoke.\n  lines: [\n  ]\n};\n\n// Black Dragon: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\nHU.classes[\"Black Dragon\"] = {\n  keys: [\n    [\"{DRAGON}\", \"queue add eb!wu!t!p {dragon} @tar\", \"main\"],\n    [\"Dragonspit\", huQ + \"dragonspit @tar\"],\n    [\"Override\", huQ + \"override @tar\"],\n    [\"Blast\", \"queue add eb!wu!t!p blast @tar\", \"main\"],\n    [\"Corrode\", huQ + \"corrode @tar\"],\n    [\"Dragonsting\", huQ + \"dragonsting @tar\"],\n    [\"Dragonfear\", huQ + \"dragonfear @tar\"],\n    [\"{MODE}\", \"hunting dragonmode\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Dragonheal\", \"queue add eq!wu!t!p dragonheal\", \"main\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Dragonspit: 14, Dragonsting: 25, Dissolve: 17, Override: 36, Corrode: 25, Dragonfear: 29, Provoke: 32 },\n  lines: [\n    [/^You rip into (.*) with your massive, deadly claws\\.$/, \"GUT\"],\n    [/^You spit a stream of acidic venom at (.*) who writhes in agony as the spittle seeps into (\\w+) skin\\.$/, \"DRAGONSPIT\", \"Dragonspit\"],\n    [/^Drawing from the well of your puissance, you invoke a dramatic chant in the dragon tongue. Your voice resonates with each word, culminating in a wave of magical energy that you bend to your will and thrust towards (.*), bombarding (\\w+) with the ancient power\\.$/, \"INCANTATION\"],\n    [/^You open your gigantic maw and spew acid on (.*). (\\w+) dodges to the side and is only partially covered by the corrosive slime\\.$/, \"CORRODE\", \"Corrode\"],\n    [/^You open your gigantic maw and spew acid on (.*)\\. (\\w+) is too clumsy to dodge the deluge and is coated in the corrosive slime\\.$/, \"CORRODE++\", \"Corrode\"],\n    [/^You bathe (.*)'s translucent shield in your noxious breath, dissolving it\\.$/, \"DISSOLVE\", \"Dissolve\"],\n    [/^You swing your mighty tail around, stabbing (.+) with an acid-covered spine\\.$/, \"DRAGONSTING\", \"Dragonsting\"],\n    [/^Opening your maw, you force out a tremendous stream of acid, blasting the flesh from the very bones of (.*)\\.$/, \"BLAST\"],\n    [/^You barrel into (.*) and knock (\\w+) to the ground before stomping over (\\w+) prone form\\.$/, \"OVERRIDE\", \"Override\"],\n    [/^You let out a great keening, and cast the impurities from your form\\.$/, \"DRAGONHEAL\"]\n  ]\n};\n\n// Blue Dragon: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\nHU.classes[\"Blue Dragon\"] = {\n  keys: [\n    [\"{DRAGON}\", \"queue add eb!wu!t!p {dragon} @tar\", \"main\"],\n    [\"Dragonchill\", huQ + \"dragonchill @tar\"],\n    [\"Override\", huQ + \"override @tar\"],\n    [\"Blast\", \"queue add eb!wu!t!p blast @tar\", \"main\"],\n    [\"Frostwave\", huQ + \"frostwave @tar\"],\n    [\"Ague\", huQ + \"ague @tar\"],\n    [\"\", \"\"],\n    [\"{MODE}\", \"hunting dragonmode\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Dragonchill: 14, Glaciate: 26, Frostrive: 17, Frostwave: 25, Ague: 14, Override: 36 },\n  lines: [\n    [/^You form small chunks of ice in your enormous maw, then spit them at (.*) in a barrage\\.$/, \"DRAGONCHILL\", \"Dragonchill\"],\n    [/^You breathe a wave of icy air at (.*)\\.$/, \"FROSTWAVE\", \"Frostwave\"],\n    [/^You let loose a steady stream of cold air around (.*), who begins to shiver uncontrollably\\.$/, \"AGUE\", \"Ague\"],\n    [/^You breathe a column of icy air at (.*)'s head, stunning (\\w+)\\.$/, \"GLACIATE\", \"Glaciate\"],\n    [/^Opening your massive maw, you throw your head forward and blast wave after wave of deadly, all-consuming cold at (.*)\\.$/, \"BLAST\"]\n  ]\n};\n\n// Druid: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\nHU.classes[\"Druid\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    maul: [\"Maul\", \"queue add b!wu!t!p wreathe | queue add b!wu!t!p maul @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Strangle\", huQ + \"strangle @tar\"],\n    [\"Ravage\", huQ + \"ravage @tar\"],\n    [\"Vinecrack\", huQ + \"vinecrack @tar\"],\n    [\"Glare\", huQ + \"quarterstaff glare @tar\"],\n    [\"Sting\", \"queue add b!wu!t sting @tar\"],\n    [\"Remedy\", \"evoke remedy {target}\"],\n    [\"Douse\", \"freeze ground\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Barrier\", \"evoke barrier\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Strangle: 14, Redeem: 22, Vinecrack: 17, Ravage: 36, Sear: 25, Glare: 14 },\n  lines: [\n    [/You roar in rage and spring upon/, \"RAVAGE\", \"Ravage\"],\n    [/^You spring forwards onto /, \"MAUL\"],\n    [/Rising in response to your incantation, vines burst forth from the very earth/, \"STRANGLE\", \"Strangle\"],\n    [/You cause the tip of your quarterstaff to glow brightly before thrusting it at the face of/, \"GLARE\", \"Glare\"]\n  ]\n};\n\n// Infernal: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Ravage 16s,\n// Spike 23s, Hellstrike 23s, Deathlink 43s, Soulshield 37s, Provoke 20s.\n// Class conditions (charstats, for self): Essence, Spec.\nHU.classes[\"Infernal\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game. The\n  // default follows the specialisation (specMain); other specs to add.\n  mains: {\n    slaughter: [\"Slaughter\", \"queue add b!wu!t!p slaughter @tar\"]\n  },\n  specMain: { \"Two Handed\": \"slaughter\" },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Ravage\", huQ + \"ravage @tar\"],\n    [\"Spike\", huQ + \"spike @tar\"],\n    [\"Shiver\", huQ + \"shiver @tar\"],\n    [\"Hellstrike\", huQ + \"hellstrike @tar\"],\n    [\"Deathlink\", huQ + \"deathlink {target}\"],\n    [\"\", \"\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Soulshield\", huQ + \"soulshield\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Ravage: 14, Spike: 36, Shiver: 17, Hellstrike: 25, Deathlink: 30, Soulshield: 20, Provoke: 32 },\n  // Still to capture (#31): the other specs' main attacks, Shiver (on a\n  // shielded target), Deathlink, Provoke, and HELLSTRIKE++ (target reckless\n  // or afraid).\n  lines: [\n    [/^Drawing back (.*), you unleash a flesh-mincing blow at (.*)\\.$/, \"SLAUGHTER\"],\n    [/^Lunging forward, you bring (.*) down in a savage diagonal blow, carving through (.*)'s magical shield\\.$/, \"CARVE\"],\n    [/^A black tendril of mist coalesces from your hand and enters (.*)'s brain, causing (\\w+) to flinch in pain\\.$/, \"RAVAGE\", \"Ravage\"],\n    [/^A miasma of black flames springs up around you\\.$/, \"SOULSHIELD\", \"Soulshield\"],\n    [/^You leap upon (.*), forming putrid spikes on your armour that tear into (\\w+) flesh\\.$/, \"SPIKE\", \"Spike\"],\n    [/^Dark fire courses down (.*) as you strike (.*) with a solid blow\\.$/, \"HELLSTRIKE\", \"Hellstrike\"]\n  ]\n};\n\n// Jester: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Noogie 16s,\n// Ensconce 23s, Befuddle 23s, Dustthrow 25s, Rap 33s, Provoke 20s.\n// Class conditions: none in charstats.\nHU.classes[\"Jester\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    bop: [\"Bop\", \"queue add b!wu!t!p bop @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Noogie\", huQ + \"noogie @tar\"],\n    [\"Ensconce\", huQ + \"ensconce firecracker on @tar\"],\n    [\"Jacks\", huQ + \"throw jacks at @tar\"],\n    [\"Befuddle\", huQ + \"befuddle @tar\"],\n    [\"Dustthrow\", huQ + \"dustthrow @tar\"],\n    [\"Rap\", huQ + \"rap @tar\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Noogie: 14, Ensconce: 36, Jacks: 17, Befuddle: 25, Dustthrow: 18, Rap: 26, Provoke: 32 },\n  // To capture (#31): Bop; Noogie; Ensconce; Jacks (on a shielded target);\n  // Befuddle, plain and BEFUDDLE++ (target in aeon or amnesiac); Dustthrow;\n  // Rap; Provoke.\n  lines: [\n  ]\n};\n\n// Magi: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\nHU.classes[\"Magi\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    staff: [\"Staff\", \"queue add e!wu!t!p staff cast {staff} at @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Windlash\", huQ + \"cast windlash at @tar\"],\n    [\"Squeeze\", huQ + \"cast squeeze @tar\"],\n    [\"Disintegrate\", huQ + \"cast disintegrate at @tar\"],\n    [\"Firefall\", huQ + \"cast firefall at @tar\"],\n    [\"Stormbolt\", huQ + \"cast stormbolt at @tar\"],\n    [\"Dilation\", huQ + \"cast dilation at @tar\"],\n    [\"Flood\", \"queue add e cast flood\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Reflection\", \"queue add e!wu!t!p cast reflection at me\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Windlash: 14, Dilation: 35, Disintegrate: 17, Squeeze: 36, Firefall: 25, Stormbolt: 25 },\n  lines: [\n    [/^As you point an elemental staff at (.*), a scintilla of bright, burning light shoots out, striking (\\w+) with focused elemental power\\.$/, \"STAFF\"],\n    [/^You draw upon the power of air to summon sharp gusts of wind which begin to whip across (.*)'s exposed flesh\\.$/, \"WINDLASH\", \"Windlash\"],\n    [/^You raise a clenched fist and in obedience the earth rises in turn, a great hand of stone unfurling to clamp about (.*) in a vice-like squeeze\\.$/, \"SQUEEZE\", \"Squeeze\"],\n    [/^You raise your hands dramatically and summon a mighty flaming rock from the sky down at (.*), but (\\w+) dodges aside and is only dealt a glancing blow\\.$/, \"FIREFALL\", \"Firefall\"],\n    [/^You summon a whirlwind of flame around (.*) which consumes (\\w+) translucent shield\\.$/, \"DISINTEGRATE\", \"Disintegrate\"],\n    [/^A bolt of lightning roars out from your hands as you cast a powerful spell at (.*), inciting sensitive nerves across (\\w+) skin\\.$/, \"STORMBOLT\", \"Stormbolt\"],\n    [/^You raise your hands dramatically and summon a mighty flaming rock from the sky that slams into the clumsy form of (.*)\\.$/, \"FIREFALL++\", \"Firefall\"],\n    [/^You point an elemental staff at (.*) and (\\w+) screams in pain as (\\w+) skin begins to freeze and crack\\.$/, \"STAFF\"]\n  ]\n};\n\n// Monk: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them):\n// Spinningbackfist 16s, Tornadokick 23s, Mindblast 23s, Scramble 31s,\n// Ripplestrike 27s, Provoke 20s.\n// Class conditions (charstats, for self): Kai, Stance.\nHU.classes[\"Monk\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    combo: [\"Combo\", \"queue add b!wu!t!p combo @tar sdk ucp ucp\"]\n  },\n  keys: [\n    // One combo on one balance: sidekick, uppercut, uppercut (Eagle Stance).\n    // Syntax still to confirm in game.\n    [\"{main}\", \"\"],\n    [\"SBP\", huQ + \"sbp @tar\", \"Spinningbackfist\"],\n    [\"TNK\", huQ + \"tnk @tar\", \"Tornadokick\"],\n    [\"SPK\", huQ + \"spk @tar\", \"Splinterkick\"],\n    [\"Mindblast\", huQ + \"mind blast @tar\"],\n    [\"Scramble\", huQ + \"mind scramble @tar\"],\n    [\"RPST\", huQ + \"rpst @tar\", \"Ripplestrike\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Spinningbackfist: 14, Tornadokick: 36, Splinterkick: 17, Mindblast: 25, Scramble: 22, Ripplestrike: 25, Provoke: 32 },\n  // To capture (#31): the combo's three lines (sidekick, uppercut, uppercut;\n  // each can be tagged on its own); Spinningbackfist; Tornadokick;\n  // Splinterkick (on a shielded target); Mindblast, plain and MINDBLAST++\n  // (target weakened or sensitive); Scramble; Ripplestrike; Provoke. Check\n  // the names in \"You can use ... again\" (Mindblast is typed MIND BLAST).\n  lines: [\n  ]\n};\n\n// Occultist: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Harry 16s,\n// Chaosgate 23s, Fluctuate 23s, Temperance 43s, Stagnate 35s, Provoke 20s.\n// Class conditions (charstats, for self): Karma, Entity (Yes/No).\nHU.classes[\"Occultist\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    warp: [\"Warp\", \"queue add e!wu!t!p warp @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Harry\", huQ + \"harry @tar\"],\n    [\"Chaosgate\", huQ + \"chaosgate @tar\"],\n    [\"Ruin\", huQ + \"ruin @tar\"],\n    [\"Fluctuate\", huQ + \"fluctuate @tar\"],\n    [\"Temperance\", huQ + \"temper @tar\"],\n    [\"Stagnate\", huQ + \"stagnate @tar\"],\n    [\"{toggle:sneak}\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  // Sneak: SHROUD / UNSHROUD.\n  toggles: {\n    sneak: { label: \"Sneak\", on: [\"shroud\"], off: [\"unshroud\"] }\n  },\n  rage: { Harry: 14, Chaosgate: 36, Ruin: 17, Fluctuate: 25, Temperance: 32, Stagnate: 24, Provoke: 32 },\n  // To capture (#31): Warp; Harry; Chaosgate; Ruin (on a shielded target);\n  // Fluctuate, plain and FLUCTUATE++ (target afraid or amnesiac); Temperance;\n  // Stagnate; Provoke. Check the name in \"You can use ... again\" for\n  // Temperance (typed TEMPER).\n  lines: [\n  ]\n};\n\n// Paladin: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Harrow 16s,\n// Shock 23s, Punishment 23s, Recovery 44s, Provoke 20s, Regeneration 53s.\n// Class conditions (charstats, for self): Wrath, wrathbal, Spec.\nHU.classes[\"Paladin\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    doubleslash: [\"Doubleslash\", \"queue add b!wu!t!p dsl @tar\"]\n  },\n  keys: [\n    // Doubleslash with no spec yet (Spec: None). The other specs' main\n    // attacks go in specKeys once tested.\n    [\"{main}\", \"\"],\n    [\"Harrow\", huQ + \"harrow @tar\"],\n    [\"Shock\", huQ + \"perform rite of shock at @tar\"],\n    [\"Faithrend\", huQ + \"faithrend @tar\"],\n    [\"Punishment\", huQ + \"perform rite of punishment at @tar\"],\n    [\"Recovery\", huQ + \"perform recovery {target}\"],\n    [\"Provoke\", huQ + \"provoke @tar\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Regeneration\", huQ + \"perform rite of regeneration\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  // specKeys: { \"Two Handed\": { 1: [...] }, ... } to come.\n  rage: { Harrow: 14, Shock: 36, Faithrend: 17, Punishment: 25, Recovery: 31, Provoke: 32, Regeneration: 33 },\n  // To capture (#31): Doubleslash (and each spec's main attack); Harrow;\n  // Shock; Faithrend (on a shielded target); Punishment, plain and\n  // PUNISHMENT++ (target weakened or clumsy); Recovery; Provoke;\n  // Regeneration. Check the names in \"You can use ... again\" for the rites.\n  lines: [\n  ]\n};\n\n// Pariah: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Boil 16s,\n// Feast 23s, Spider 23s, Wail 38s, Symphony 35s, Provoke 20s.\n// Class condition (charstats, for self): epitaph_length.\nHU.classes[\"Pariah\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    wrack: [\"Wrack\", \"queue add b!wu!t!p blood wrack @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Boil\", huQ + \"blood boil @tar\"],\n    [\"Feast\", huQ + \"swarm feast @tar\"],\n    [\"Scour\", huQ + \"accursed scour @tar\"],\n    [\"Spider\", huQ + \"trace spider @tar\"],\n    [\"Wail\", huQ + \"accursed wail @tar\"],\n    [\"\", \"\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Symphony\", huQ + \"swarm symphony @tar\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Boil: 14, Feast: 36, Scour: 17, Spider: 25, Wail: 32, Symphony: 24, Provoke: 32 },\n  // To capture (#31): Wrack; Boil; Feast; Scour (on a shielded target);\n  // Spider, plain and SPIDER++ (target inhibited or sensitive); Wail;\n  // Symphony; Provoke.\n  lines: [\n  ]\n};\n\n// Priest: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Torment 16s,\n// Desolation 23s, Hammer 23s, Incense 19s, Horrify 34s, Provoke 20s.\n// Class conditions (charstats, for self): Angelpower, Devotion, conviction,\n// prayer_length, Prayer (Yes/No).\nHU.classes[\"Priest\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    smite: [\"Smite\", \"queue add b!wu!t!p smite @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Torment\", huQ + \"angel torment @tar\"],\n    [\"Desolation\", huQ + \"perform rite of desolation on @tar\"],\n    [\"Crack\", huQ + \"crack @tar\"],\n    [\"Hammer\", huQ + \"hammer @tar\"],\n    [\"Incense\", huQ + \"angel incense @tar\"],\n    [\"\", \"\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Horrify\", huQ + \"perform rite of horrify on @tar\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Torment: 14, Desolation: 36, Crack: 17, Hammer: 25, Incense: 18, Horrify: 29, Provoke: 32 },\n  // To capture (#31): Smite; Torment; Desolation; Crack (on a shielded\n  // target); Hammer, plain and HAMMER++ (target clumsy or amnesiac); Incense;\n  // Horrify; Provoke. Check the names in \"You can use ... again\" for the\n  // rites.\n  lines: [\n  ]\n};\n\n// Psion: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Barbedblade\n// 16s, Devastate 23s, Whirlwind 23s, Regrowth 35s, Terror 38s, Provoke 20s.\n// Class conditions: none in charstats.\nHU.classes[\"Psion\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    overhand: [\"Overhand\", \"queue add b!wu!t!p weave overhand @tar\"]\n  },\n  keys: [\n    // Overhand: learnt early. Charge and later Deathblow are the other main\n    // attacks; their lines are kept below so either one shows when used.\n    [\"{main}\", \"\"],\n    [\"Barbedblade\", huQ + \"weave barbedblade @tar\"],\n    [\"Devastate\", huQ + \"psi devastate @tar\"],\n    [\"Pulverise\", huQ + \"weave pulverise @tar\"],\n    [\"Whirlwind\", huQ + \"weave whirlwind @tar\"],\n    [\"Regrowth\", huQ + \"enact regrowth @tar\"],\n    [\"\", \"\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Terror\", huQ + \"psi terror @tar\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Barbedblade: 14, Devastate: 36, Pulverise: 17, Whirlwind: 25, Regrowth: 24, Terror: 32, Provoke: 32 },\n  // Still to capture (#31): Overhand; Pulverise (on a shielded target);\n  // Whirlwind, plain and WHIRLWIND++ (target inhibited or stunned);\n  // Regrowth; Terror; Provoke.\n  // Charge, Barbedblade and Devastate come from Ricardo's pre-Loom package.\n  lines: [\n    [/^Charging forward, you drive a translucent spear into (.*)\\.$/, \"CHARGE\"],\n    [/^You weave a jagged blade into being and viciously hack at (.*), opening bleeding wounds\\.$/, \"BARBEDBLADE\", \"Barbedblade\"],\n    [/^You hammer the mind of (.*) with a devastating psionic onslaught\\.$/, \"DEVASTATE\", \"Devastate\"]\n  ]\n};\n\n// Runewarden: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Collide 16s,\n// Onslaught 23s, Etch 23s, Safeguard 57s, Bulwark 45s, Provoke 20s.\n// Class conditions (charstats, for self): Ferocity, empower, Spec.\nHU.classes[\"Runewarden\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game. The\n  // default follows the specialisation (specMain); other specs to add.\n  mains: {\n    combination: [\"Combo\", \"queue add b!wu!t!p combination @tar rend smash\"]\n  },\n  specMain: { \"Sword and Shield\": \"combination\" },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Collide\", huQ + \"collide @tar\"],\n    [\"Onslaught\", huQ + \"onslaught @tar\"],\n    // Raze: the balance shieldbreak (no rage). Fragment is the rage one,\n    // tracked but without a key.\n    [\"Raze\", \"queue add b!wu!t!p raze @tar\"],\n    [\"Etch\", huQ + \"etch rune at @tar\"],\n    [\"Safeguard\", huQ + \"safeguard {target}\"],\n    [\"\", \"\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Bulwark\", huQ + \"bulwark\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Collide: 14, Onslaught: 36, Fragment: 17, Etch: 25, Safeguard: 35, Bulwark: 28, Provoke: 32 },\n  // To capture (#31): the combination's lines (rend, smash); Collide;\n  // Onslaught; Raze and Fragment (on a shielded target); Etch, plain and\n  // ETCH++ (target in aeon or stunned); Safeguard; Bulwark; Provoke. The\n  // other specs' main attacks, when tested.\n  lines: [\n  ]\n};\n\n// Sentinel: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Pester 16s,\n// Skewer 23s, Swarm 23s, Tame 43s, Goad 19s, Provoke 20s.\n// Class condition (charstats, for self): Morph.\nHU.classes[\"Sentinel\"] = {\n  // Main attacks for F1, following the morph; HUNTING MAIN picks another,\n  // and adds more in game.\n  mains: {\n    bite: [\"Bite\", \"queue add b!wu!t!p bite @tar\"],\n    claw: [\"Claw\", \"queue add b!wu!t!p claw @tar\"],\n    maul: [\"Maul\", \"queue add b!wu!t!p maul @tar\"]\n  },\n  morphMain: { \"Wolf\": \"bite\", \"Hyena\": \"claw\", \"Jaguar\": \"maul\" },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Pester\", huQ + \"pester @tar\"],\n    [\"Skewer\", huQ + \"skewer @tar\"],\n    [\"Bore\", huQ + \"bore @tar\"],\n    [\"Swarm\", huQ + \"swarm @tar\"],\n    [\"Tame\", huQ + \"tame @tar\"],\n    [\"Goad\", huQ + \"goad @tar\"],\n    [\"\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Pester: 14, Skewer: 36, Bore: 17, Swarm: 25, Tame: 32, Goad: 18, Provoke: 32 },\n  // To capture (#31): Bite, Claw and Maul; Pester; Skewer; Bore (on a\n  // shielded target); Swarm, plain and SWARM++ (target in aeon or\n  // inhibited); Tame; Goad; Provoke.\n  lines: [\n  ]\n};\n\n// Serpent: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\n// Cooldowns (for reference; the game's messages drive them): Thrash 16s,\n// Throatrip 23s, Snare 23s. Flagellate and Obliviate: not given.\n// Class condition (charstats, for self): Venom.\nHU.classes[\"Serpent\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    garrote: [\"Garrote\", \"queue add b!wu!t!p garrote @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Thrash\", huQ + \"thrash @tar\"],\n    [\"Throatrip\", huQ + \"throatrip @tar\"],\n    [\"Excoriate\", huQ + \"excoriate @tar\"],\n    [\"Snare\", huQ + \"snare @tar\"],\n    [\"Flagellate\", huQ + \"flagellate @tar\"],\n    [\"Obliviate\", huQ + \"obliviate @tar\"],\n    [\"{toggle:sneak}\", \"\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"{toggle:weave}\", \"\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  // From Ricardo's subterfuge package (Rienest). Sneak hides and cloaks, and\n  // re-conjures the cloak when the shroud drops while sneaking.\n  toggles: {\n    sneak: { label: \"Sneak\", on: [\"hide\", \"conjure cloak\"], off: [\"emerge\", \"dispel self\"],\n             renew: [/^Your shroud dissipates and you return to the realm of perception\\.$/, \"conjure cloak\"] },\n    weave: { label: \"Weave\", on: [\"weaving on\"], off: [\"weaving off\"] }\n  },\n  // No Provoke listed for Serpent: add it here if the class has it.\n  rage: { Thrash: 14, Throatrip: 36, Excoriate: 17, Snare: 25, Flagellate: 25, Obliviate: 28 },\n  // To capture (#31): Garrote; Thrash; Throatrip; Excoriate (on a shielded\n  // target); Snare, plain and SNARE++ (target reckless or inhibited);\n  // Flagellate; Obliviate.\n  lines: [\n  ]\n};\n\n// Sylvan: F-keys, battlerage costs and attack lines for hunting.\n// See classes/README.md for the format. Only this file changes when the\n// game rewords an attack or a key needs moving.\nHU.classes[\"Sylvan\"] = {\n  // Main attacks for F1: HUNTING MAIN picks one, and adds more in game.\n  mains: {\n    thornrend: [\"Thornrend\", \"queue add e!wu!t!p thornrend @tar\"]\n  },\n  keys: [\n    [\"{main}\", \"\"],\n    [\"Torrent\", huQ + \"cast torrent at @tar\"],\n    [\"Sandstorm\", huQ + \"cast sandstorm at @tar\"],\n    [\"Thornpierce\", huQ + \"thornpierce @tar\"],\n    [\"Stonevine\", huQ + \"stonevine @tar\"],\n    [\"Leechroot\", huQ + \"leechroot @tar\"],\n    [\"Rockshot\", huQ + \"cast rockshot at @tar\"],\n    [\"Flood\", \"queue add e cast flood\"],\n    [\"{stats}\", \"\"],\n    [\"Diag\", \"diagnose\"],\n    [\"Reflection\", \"queue add e!wu!t!p cast reflection at me\"],\n    [\"Shield\", \"touch shield\"]\n  ],\n  rage: { Torrent: 14, Sandstorm: 29, Thornpierce: 17, Stonevine: 36, Leechroot: 25, Rockshot: 28 },\n  lines: [\n    [/^You command the razor-edged thorny vines around you to lash out and rend the flesh of (.*)\\.$/, \"THORNREND\"],\n    [/^(.*) coughs and splutters as you channel a gout of water at (\\w+) face\\.$/, \"TORRENT\", \"Torrent\"],\n    [/^(.*) stumbles about in fear and flails at (\\w+) head as you summon a small sandstorm around it\\.$/, \"SANDSTORM\", \"Sandstorm\"],\n    [/^A thorny vine reaches out from you and pierces through (.*)'s translucent shield, causing it to fade\\.$/, \"THORNPIERCE\", \"Thornpierce\"],\n    [/^You summon a great vine to wrap itself around (.*), then channel the element of earth into it, causing it to become rock hard and shatter as it constricts around (\\w+)\\.$/, \"STONEVINE\", \"Stonevine\"],\n    [/^A deadly root flies from your hand and burrows into (.*)'s flesh, but is unable to find sufficient sustenance\\.$/, \"LEECHROOT\", \"Leechroot\"],\n    [/^You form a small pebble, then channel air to fling it violently at (.*)'s head, causing (\\w+) to look dazed\\.$/, \"ROCKSHOT\", \"Rockshot\"]\n  ]\n};\n"
    },
    {
     "type": "function",
     "name": "hunting_mainlist",
     "enabled": true,
     "code": "// hunting_mainlist -- the current class's main attacks into HU.mainList\n// ([{ name, label, cmd, added }]) and the one in use into HU.mainNow.\n// Order: the class file's \"mains\", then those added with HUNTING MAIN x = cmd\n// (an added one with the same name replaces the file's). In use: the one\n// picked with HUNTING MAIN, else the class's default for your spec\n// (specMain) or morph (morphMain), else the first. A spec or morph change\n// drops the hand-picked one (see onGMCP).\nvar HU = client.loom.hunting;\nvar mlEntry = HU.classes[HU.cls] || {};\nvar mlFile = mlEntry.mains || {};\nvar mlAdded = HU.mainsAdded[HU.cls] || {};\nvar mlByName = {};\nHU.mainList = [];\nfor (var mlK in mlFile) {\n  var mlRow = { name: mlK, label: mlFile[mlK][0], cmd: mlFile[mlK][1], added: false };\n  mlByName[mlK] = mlRow;\n  HU.mainList.push(mlRow);\n}\nfor (var mlA in mlAdded) {\n  // Typed in game: queued on balance and equilibrium unless it is a queue\n  // command already.\n  var mlCmd = /^queue\\s/i.test(mlAdded[mlA]) ? mlAdded[mlA] : \"queue add eb!wu!t!p \" + mlAdded[mlA];\n  var mlLabel = mlA.charAt(0).toUpperCase() + mlA.substring(1);\n  if (mlByName[mlA]) { mlByName[mlA].cmd = mlCmd; mlByName[mlA].added = true; }\n  else { var mlNew = { name: mlA, label: mlLabel, cmd: mlCmd, added: true }; mlByName[mlA] = mlNew; HU.mainList.push(mlNew); }\n}\nvar mlPick = HU.mains[HU.cls];\nif (!mlPick || !mlByName[mlPick]) mlPick = (mlEntry.specMain && HU.spec && mlEntry.specMain[HU.spec]) || \"\";\nif (!mlPick || !mlByName[mlPick]) mlPick = (mlEntry.morphMain && HU.morph && mlEntry.morphMain[HU.morph]) || \"\";\nif (!mlPick || !mlByName[mlPick]) mlPick = HU.mainList.length ? HU.mainList[0].name : \"\";\nHU.mainNow = mlPick ? mlByName[mlPick] : null;\n"
    },
    {
     "type": "function",
     "name": "hunting_help",
     "enabled": true,
     "code": "// hunting_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[hunting] class F-keys, battlerage highlights, dragon attacks and autogold. Commands:\";\n// Whether the current class has a file in classes/, and which classes do.\nvar hlHU = client.loom.hunting || {};\nvar hlKnown = [];\nfor (var hlK in (hlHU.classes || {})) hlKnown.push(hlK);\nvar hlClassNote = \"Classes set up: \" + hlKnown.join(\", \") + \".\"\n  + (hlHU.cls && !(hlHU.classes && hlHU.classes[hlHU.cls]) ? \" \" + hlHU.cls + \" isn't one yet: you get the generic keys (Stats, Diag, Shield) and no attack highlights.\" : \"\");\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"HUNTING\", \"status\"],\n  [\"HUNTING DRAGONMODE [PHY|MAG|AUTO]\", \"gut, incantation, or whichever pool is fuller (no argument: next mode)\"],\n  [\"HUNTING AUTOGOLD [ON|ALL|OFF]\", \"pick up gold from your kills, from any corpse, or not at all\"],\n  [\"HUNTING PARTYTARGET [name|OFF]\", \"who party-aimed keys act on (the druid's Remedy key)\"],\n  [\"HUNTING AFTERFORM [cmd|OFF]\", \"command sent when dragonform rises or falls, e.g. DEFCON UP\"],\n  [\"HUNTING MAIN [name]\", \"your class's main attack on F1 (no name: list them)\"],\n  [\"HUNTING MAIN <name> = <command>\", \"add one for this class, e.g. to try an attack; empty command removes it\"],\n  [\"HUNTING TOGGLE <name> [ON|OFF]\", \"class toggles on the F-keys, e.g. the Serpent's SNEAK and WEAVE\"],\n  [\"HUNTING BUTTONS\", \"lay out the F-keys again\"],\n  [\"HUNTING RAGE\", \"rage, cooldowns and tracked keys\"],\n  [\"HUNTING RESET\", \"clear rage cooldowns, lay out the F-keys again\"],\n  [\"HUNTING DEBUG\", \"internal state\"],\n  [hlClassNote]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
    },
    {
     "type": "function",
     "name": "hunting_status",
     "enabled": true,
     "code": "var HU = client.loom.hunting;\nrun_function(\"hunting_mainlist\", [], \"hunting\");\nvar huPt = get_variable(\"hunting_party_target\");\nvar huAf = get_variable(\"hunting_after_form\");\ndisplay_notice(\"[hunting] class \" + (HU.cls || \"unknown\") + (HU.cls && !(HU.classes && HU.classes[HU.cls]) ? \" (not configured yet)\" : \"\") + \", dragon mode \" + String(get_variable(\"hunting_dragon_mode\")).toUpperCase()\n  + \" (\" + get_variable(\"hunting_dragon_attack\") + \"), autogold \" + String(get_variable(\"hunting_autogold\")).toUpperCase()\n  + (HU.mainNow ? \", main attack \" + HU.mainNow.name.toUpperCase() : \"\")\n  + \", party target \" + (huPt ? huPt : \"none\") + \", after form \" + (huAf ? huAf.toUpperCase() : \"nothing\")\n  + \". HUNTING HELP for commands.\", \"cyan\");\n"
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "// HUNTING [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\nvar huRaw = String(args[1] || \"\").trim();\nvar huSub = huRaw.split(/\\s+/)[0].toLowerCase();\nvar huRest = huRaw.substring(huSub.length).trim();\nvar huVal = huRest.toLowerCase();\nvar C = \"cyan\";\n\nif (huSub === \"\" || huSub === \"status\") {\n  run_function(\"hunting_status\", [], \"hunting\");\n}\nelse if (huSub === \"help\") {\n  run_function(\"hunting_help\", [], \"hunting\");\n}\nelse if (huSub === \"dragonmode\") {\n  var huCur = get_variable(\"hunting_dragon_mode\");\n  var huNext = huVal;\n  if (huNext === \"\") huNext = (huCur == \"auto\") ? \"physical\" : (huCur == \"physical\") ? \"magical\" : \"auto\";\n  if (huNext === \"phy\") huNext = \"physical\";\n  if (huNext === \"mag\") huNext = \"magical\";\n  if (huNext === \"aut\") huNext = \"auto\";\n  if (huNext !== \"physical\" && huNext !== \"magical\" && huNext !== \"auto\") {\n    display_notice(\"[hunting] dragon mode is PHYSICAL, MAGICAL or AUTO.\", \"orange\");\n  } else {\n    set_variable(\"hunting_dragon_mode\", huNext);\n    if (huNext === \"physical\") set_variable(\"hunting_dragon_attack\", \"gut\");\n    if (huNext === \"magical\") set_variable(\"hunting_dragon_attack\", \"incantation\");\n    if (huNext === \"auto\") run_function(\"hunting_dragon_best\", [], \"hunting\");\n    display_notice(\"[hunting] dragon mode \" + huNext.toUpperCase() + \": attacking with \" + get_variable(\"hunting_dragon_attack\") + \".\", C);\n    run_function(\"hunting_buttons\", [], \"hunting\");\n  }\n}\nelse if (huSub === \"autogold\") {\n  if (huVal === \"on\" || huVal === \"off\" || huVal === \"all\") {\n    set_variable(\"hunting_autogold\", huVal);\n    display_notice(\"[hunting] autogold \" + huVal.toUpperCase() + \".\", C);\n  } else if (huVal === \"\") {\n    display_notice(\"[hunting] autogold is \" + String(get_variable(\"hunting_autogold\")).toUpperCase() + \". HUNTING AUTOGOLD ON (your kills), ALL (any gold) or OFF.\", C);\n  } else {\n    display_notice(\"[hunting] autogold is ON, ALL or OFF.\", \"orange\");\n  }\n}\nelse if (huSub === \"partytarget\") {\n  if (huVal === \"\") {\n    var huPt = get_variable(\"hunting_party_target\");\n    display_notice(\"[hunting] party target: \" + (huPt ? huPt : \"none\") + \". HUNTING PARTYTARGET <name> or OFF.\", C);\n  } else {\n    set_variable(\"hunting_party_target\", huVal === \"off\" ? \"\" : huVal);\n    display_notice(\"[hunting] party target \" + (huVal === \"off\" ? \"cleared\" : \"set to \" + huVal) + \".\", C);\n    run_function(\"hunting_buttons\", [], \"hunting\");\n  }\n}\nelse if (huSub === \"afterform\") {\n  if (huVal === \"\") {\n    var huAf = get_variable(\"hunting_after_form\");\n    display_notice(\"[hunting] after dragonform rises or falls: \" + (huAf ? huAf.toUpperCase() : \"nothing\") + \". HUNTING AFTERFORM <command> or OFF.\", C);\n  } else {\n    set_variable(\"hunting_after_form\", huVal === \"off\" ? \"\" : huRest);\n    display_notice(\"[hunting] after dragonform rises or falls: \" + (huVal === \"off\" ? \"nothing\" : huRest.toUpperCase()) + \".\", C);\n  }\n}\nelse if (huSub === \"main\") {\n  // HUNTING MAIN: list; HUNTING MAIN <name>: use it; HUNTING MAIN <name> =\n  // <command>: add or replace one for this class; HUNTING MAIN <name> = (empty):\n  // remove an added one.\n  run_function(\"hunting_mainlist\", [], \"hunting\");\n  var huMeq = huRest.indexOf(\"=\");\n  var huMname = (huMeq >= 0 ? huRest.substring(0, huMeq) : huRest).trim().toLowerCase().replace(/\\s+/g, \"\");\n  var huMcmd = huMeq >= 0 ? huRest.substring(huMeq + 1).trim() : null;\n  if (!HU.cls) {\n    display_notice(\"[hunting] no class seen yet.\", \"orange\");\n  } else if (huMname === \"\") {\n    var huMout = [];\n    for (var huMi = 0; huMi < HU.mainList.length; huMi++) {\n      var huMr = HU.mainList[huMi];\n      huMout.push((HU.mainNow && HU.mainNow.name == huMr.name ? \"*\" : \"\") + huMr.name.toUpperCase() + (huMr.added ? \" (added)\" : \"\"));\n    }\n    display_notice(\"[hunting] main attacks for \" + HU.cls + \": \" + (huMout.length ? huMout.join(\", \") : \"none\") + \". HUNTING MAIN <name> to use one, HUNTING MAIN <name> = <command> to add one.\", C);\n  } else if (huMcmd !== null) {\n    if (!HU.mainsAdded[HU.cls]) HU.mainsAdded[HU.cls] = {};\n    if (huMcmd === \"\") {\n      delete HU.mainsAdded[HU.cls][huMname];\n      display_notice(\"[hunting] removed the added \" + huMname.toUpperCase() + \" for \" + HU.cls + \".\", C);\n    } else {\n      HU.mainsAdded[HU.cls][huMname] = huMcmd;\n      HU.mains[HU.cls] = huMname;\n      set_variable(\"hunting_mains\", JSON.stringify(HU.mains));\n      display_notice(\"[hunting] \" + huMname.toUpperCase() + \" = \" + huMcmd + \", now your main attack as \" + HU.cls + \".\", \"lime\");\n    }\n    set_variable(\"hunting_mains_added\", JSON.stringify(HU.mainsAdded));\n    run_function(\"hunting_buttons\", [], \"hunting\");\n  } else {\n    var huMfound = false;\n    for (var huMj = 0; huMj < HU.mainList.length; huMj++) if (HU.mainList[huMj].name == huMname) huMfound = true;\n    if (!huMfound) {\n      display_notice(\"[hunting] no main attack \" + huMname.toUpperCase() + \" for \" + HU.cls + \". HUNTING MAIN lists them.\", \"orange\");\n    } else {\n      HU.mains[HU.cls] = huMname;\n      set_variable(\"hunting_mains\", JSON.stringify(HU.mains));\n      run_function(\"hunting_buttons\", [], \"hunting\");\n      display_notice(\"[hunting] main attack for \" + HU.cls + \": \" + huMname.toUpperCase() + \".\", \"lime\");\n    }\n  }\n}\nelse if (huSub === \"toggle\") {\n  // Class toggles (classes/*.js \"toggles\"): flip, or set ON/OFF, and send\n  // that state's commands.\n  var huTp = huVal.split(/\\s+/);\n  var huTn = huTp[0] || \"\";\n  var huTset = huTp[1] || \"\";\n  var huTcls = HU.classes[HU.cls];\n  var huTdef = huTcls && huTcls.toggles ? huTcls.toggles[huTn] : null;\n  if (!huTdef) {\n    var huTnames = [];\n    for (var huTk in ((huTcls && huTcls.toggles) || {})) huTnames.push(huTk.toUpperCase());\n    display_notice(\"[hunting] \" + (huTnames.length ? \"toggles for \" + HU.cls + \": \" + huTnames.join(\", \") + \".\" : \"no toggles for \" + (HU.cls || \"this class\") + \".\"), huTn ? \"orange\" : C);\n  } else if (huTset !== \"\" && huTset !== \"on\" && huTset !== \"off\") {\n    display_notice(\"[hunting] HUNTING TOGGLE \" + huTn.toUpperCase() + \" [ON|OFF].\", \"orange\");\n  } else {\n    var huTnow = HU.toggles[huTn] === \"on\" ? \"on\" : \"off\";\n    var huTnext = huTset || (huTnow === \"on\" ? \"off\" : \"on\");\n    var huTcmds = huTdef[huTnext] || [];\n    for (var huTi = 0; huTi < huTcmds.length; huTi++) send_command(huTcmds[huTi]);\n    HU.toggles[huTn] = huTnext;\n    set_variable(\"hunting_toggles\", JSON.stringify(HU.toggles));\n    run_function(\"hunting_buttons\", [], \"hunting\");\n    display_notice(\"[hunting] \" + (huTdef.label || huTn) + \" \" + huTnext.toUpperCase() + \".\", C);\n  }\n}\nelse if (huSub === \"buttons\") {\n  run_function(\"hunting_buttons\", [], \"hunting\");\n  display_notice(\"[hunting] F-keys laid out for \" + (HU.cls || \"no class yet\") + \".\", C);\n}\nelse if (huSub === \"rage\") {\n  display_notice(\"[hunting] rage \" + HU.rage + \", global cooldown \" + (HU.glob ? \"clear\" : \"running\"), C);\n  display_notice(\"  slots: \" + JSON.stringify(HU.slots), C);\n  display_notice(\"  cooldowns: \" + JSON.stringify(HU.cd), C);\n}\nelse if (huSub === \"reset\") {\n  HU.cd = {};\n  HU.glob = true;\n  run_function(\"hunting_setup\", [], \"hunting\");\n  run_function(\"hunting_buttons\", [], \"hunting\");\n  display_notice(\"[hunting] reset: rage cooldowns cleared, F-keys laid out again. Settings are kept.\", C);\n}\nelse if (huSub === \"debug\") {\n  display_notice(\"[hunting] cls=\" + HU.cls + \" bal=\" + HU.bal + \" eq=\" + HU.eq\n    + \" ep=\" + HU.ep + \"/\" + HU.maxep + \" wp=\" + HU.wp + \"/\" + HU.maxwp\n    + \" main=\" + JSON.stringify(HU.main) + \" spec=\" + HU.spec + \" toggles=\" + JSON.stringify(HU.toggles) + \" kill=\" + HU.kill, C);\n}\nelse {\n  display_notice(\"[hunting] unknown command '\" + huSub + \"'. HUNTING HELP for commands.\", \"orange\");\n}\n"
      }
     ],
     "text": "^hunting(?:\\s+(.*))?$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": false,
     "prefix_suffix": true
    }
   ]
  },
  {
   "type": "group",
   "name": "buttons",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "hunting_buttons",
     "enabled": true,
     "code": "// hunting_buttons -- lays out the F-key buttons for the current class, from\n// its file in classes/ (see classes/README.md), and makes that class's\n// battlerage costs the ones in use. Rows are [label, command] or\n// [label, command, \"main\"]: \"main\" lights the key whenever you have balance\n// and equilibrium. A key whose label has a battlerage cost is tracked for\n// rage highlighting automatically.\nvar HU = client.loom.hunting;\nvar huEntry = HU.classes[HU.cls];\nHU.costs = (huEntry && huEntry.rage) || {};\n\nvar huDragon = get_variable(\"hunting_dragon_attack\") || \"gut\";\nvar huModes = { physical: \"PHY\", magical: \"MAG\", auto: \"AUT\" };\nvar huMode = huModes[get_variable(\"hunting_dragon_mode\")] || \"AUT\";\n// The staff attack is artificing's setting when it's installed.\nvar huStaff = (client.loom.artificing && client.loom.artificing.staff) || get_variable(\"artificing_staff\") || get_variable(\"staffAttack\") || \"scintilla\";\n// Remembered so a new staff attack redraws the keys (see onGMCP).\nHU.staffDrawn = huStaff;\nvar huTarget = get_variable(\"hunting_party_target\") || \"\";\n// F9 opens huntstats when that package is around; otherwise the key stays empty.\n// Its saved records count too, as huntstats may load after hunting.\nvar huStats = (client.loom.registry && client.loom.registry.huntstats) || get_variable(\"huntstats_log\") || client.track || get_variable(\"hs_log\");\n\n// A class with no layout yet gets the generic keys only.\nvar huGeneric = [[\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"\", \"\"], [\"{stats}\", \"\"], [\"Diag\", \"diagnose\"], [\"\", \"\"], [\"Shield\", \"touch shield\"]];\nvar huRows = (huEntry && huEntry.keys) || huGeneric;\n// Keys that depend on your specialisation: specKeys[\"<Spec>\"] = { <F-key>: row }.\nvar huSpecRows = huEntry && huEntry.specKeys && HU.spec ? huEntry.specKeys[HU.spec] : null;\nif (huSpecRows) {\n  huRows = huRows.slice();\n  for (var huF in huSpecRows) huRows[to_number(huF) - 1] = huSpecRows[huF];\n}\nHU.slots = {};\nHU.main = [];\nrun_function(\"hunting_mainlist\", [], \"hunting\");\n\nfor (var huK = 1; huK <= 12; huK++) {\n  buttons_set_highlight(huK, 0);\n  var huRow = huRows[huK - 1] || [\"\", \"\"];\n  var huLabel = huRow[0];\n  var huCmd = huRow[1];\n  if (huLabel == \"{stats}\") {\n    huLabel = huStats ? \"Stats\" : \"\";\n    huCmd = huStats ? \"huntstats\" : \"\";\n  }\n  // {main}: the main attack in use (HUNTING MAIN); lit on balance and\n  // equilibrium.\n  if (huLabel == \"{main}\") {\n    huLabel = HU.mainNow ? HU.mainNow.label : \"\";\n    huCmd = HU.mainNow ? HU.mainNow.cmd : \"\";\n    if (HU.mainNow) HU.main.push(huK);\n  }\n  // {toggle:name}: a class toggle; the label shows its state, the key runs\n  // HUNTING TOGGLE and is lit while the toggle is on.\n  var huTog = huLabel.match(/^\\{toggle:(\\w+)\\}$/);\n  var huTogOn = false;\n  if (huTog) {\n    var huTogDef = (huEntry && huEntry.toggles && huEntry.toggles[huTog[1]]) || {};\n    huTogOn = HU.toggles[huTog[1]] === \"on\";\n    huLabel = (huTogDef.label || huTog[1]) + (huTogOn ? \" ON\" : \" OFF\");\n    huCmd = \"hunting toggle \" + huTog[1];\n  }\n  huLabel = huLabel.replace(\"{DRAGON}\", huDragon == \"gut\" ? \"Gut\" : \"Incantation\").replace(\"{MODE}\", huMode);\n  huCmd = huCmd.replace(\"{dragon}\", huDragon).replace(\"{staff}\", huStaff).replace(\"{target}\", huTarget).replace(/\\s+$/, \"\");\n  buttons_set_label(huK, huLabel);\n  buttons_set_commands(huK, huCmd);\n  // The third field is \"main\", or the ability this key uses when its label\n  // is an abbreviation (\"SBP\" for Spinningbackfist); otherwise the label is\n  // the ability name.\n  var huAb = (huRow[2] && huRow[2] != \"main\") ? huRow[2] : huLabel;\n  if (HU.costs[huAb] !== undefined) HU.slots[huAb] = huK;\n  if (huRow[2] == \"main\") HU.main.push(huK);\n  if (huTogOn) buttons_set_highlight(huK, 1);\n}\n\nif (get_variable(\"debug\") == \"on\") display_notice(\"[debug][hunting] buttons for \" + (HU.cls || \"no class\") + (HU.spec ? \", spec \" + HU.spec : \"\") + (huEntry ? \"\" : \" (not configured yet: generic keys)\"), \"cyan\");\nrun_function(\"hunting_highlight\", [], \"hunting\");\n"
    },
    {
     "type": "function",
     "name": "hunting_dragon_best",
     "enabled": true,
     "code": "// hunting_dragon_best -- in AUTO dragon mode, attack with GUT while endurance is\n// the fuller pool and with INCANTATION while willpower is. Vitals come from\n// hunting's own onGMCP.\nvar HU = client.loom.hunting;\nvar huDragon = HU.cls == \"Black Dragon\" || HU.cls == \"Blue Dragon\";\nif (huDragon && get_variable(\"hunting_dragon_mode\") == \"auto\" && HU.maxep && HU.maxwp) {\n  var huAttack = (HU.ep / HU.maxep > HU.wp / HU.maxwp) ? \"gut\" : \"incantation\";\n  if (huAttack != get_variable(\"hunting_dragon_attack\")) {\n    set_variable(\"hunting_dragon_attack\", huAttack);\n    if (get_variable(\"debug\") == \"on\") display_notice(\"[debug][hunting] dragon attack: \" + huAttack, \"cyan\");\n  }\n}\n"
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\n// Dragonform is up: fresh rage cooldowns, resume packages, after-form command.\nHU.cd = {};\nset_variable(\"pauseTriggers\", \"off\");\nvar huAf = get_variable(\"hunting_after_form\");\nif (huAf) send_command(huAf);\n"
      }
     ],
     "text": "^With an ear-splitting roar\\, you rear back your draconic head and scream out your triumph\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\n// Back to lesserform: fresh rage cooldowns, after-form command.\nHU.cd = {};\nvar huAf = get_variable(\"hunting_after_form\");\nif (huAf) send_command(huAf);\n"
      }
     ],
     "text": "^Your draconic form melts away, leaving you suddenly weaker and more vulnerable\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "// Dragonform is starting: it is interrupted by anything sent to the game, so\n// pause every package that respects pauseTriggers until the roar.\nset_variable(\"pauseTriggers\", \"on\");\n"
      }
     ],
     "text": "^With a grimness born of determination\\, you begin to unleash the Dragon that is now so much a part of the fabric of your soul\\. A black light begins to shine through from within you\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    }
   ]
  },
  {
   "type": "group",
   "name": "afflictions",
   "enabled": true,
