  {
   "type": "group",
   "name": "autogold",
   "enabled": true,
   "items": [
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "// ---- command dispatch ----\nvar arg = args[1] || \"\";\n\nif (arg === \"on\")          { set_variable(\"autogold\", \"on\"); display_notice(\"[hunting] Autogold mode: ON\", \"cyan\"); }\nelse if (arg === \"off\")    { set_variable(\"autogold\", \"off\"); display_notice(\"[hunting] Autogold mode: OFF\", \"cyan\");}\nelse if (arg === \"all\")    { set_variable(\"autogold\", \"all\"); display_notice(\"[hunting] Autogold mode: ALL\", \"cyan\"); }\nelse {\n  var state = get_variable(\"autogold\");\n  display_notice(\"[hunting] Autogold mode: \" + state + \". Use AUTOGOLD ON/OFF/ALL.\", \"cyan\");\n}"
      }
     ],
     "text": "^autogold(?:\\s+(on|off|all))?$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var pause = get_variable(\"pauseTriggers\");\nvar autogold = get_variable(\"autogold\");\nvar backpack = get_variable(\"backpack\");\n\nif (pause == \"off\") {\n  if (autogold == \"all\")\n  {\n    send_command(\"queue add be get gold\", 1); \n    send_command(\"queue add be put gold in \" + backpack, 1); \n  }\n    \n  if (autogold == \"on\" && client.mykill && Date.now() - client.mykill < 5000) { \n    client.mykill = 0; \n    send_command(\"queue add be get gold\", 1); \n    send_command(\"queue add be put gold in \" + backpack, 1); \n  }\n} else {\n  display_notice(\"[common] Triggers are currently paused.\", \"orange\");\n}"
      }
     ],
     "text": "A small pile of sovereigns spills from the corpse.",
     "matching": "substring",
     "whole_words": true,
     "case_sensitive": true
    },
