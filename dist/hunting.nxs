  {
   "type": "group",
   "name": "rage",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "hunting_highlight",
     "enabled": true,
     "code": "// hunting_highlight -- lights the F-keys: a battlerage ability when it is off\n// cooldown, the global battlerage cooldown is clear and you have the rage for\n// it; the main attack keys (set by hunting_buttons) on balance + equilibrium.\nvar HU = client.loom.hunting;\nvar huSlots = HU.slots || {};\n\nfor (var huName in huSlots) {\n  if (HU.costs[huName] === undefined) continue;\n  var huLit = HU.glob && (HU.cd[huName] !== false) && HU.rage >= HU.costs[huName];\n  buttons_set_highlight(huSlots[huName], huLit ? 1 : 0);\n}\n\nvar huMain = HU.main || [];\nvar huReady = HU.bal && HU.eq;\nfor (var huI = 0; huI < huMain.length; huI++) {\n  buttons_set_highlight(huMain[huI], huReady ? 1 : 0);\n}\n"
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\n// The list means \"off cooldown AND affordable\": an ability missing from it\n// is only known to be on cooldown if you could have afforded it.\nvar huAvail = {};\nvar huList = args[1].replace(/\\.\\s*$/, \"\").split(/,\\s*/);\nfor (var huI = 0; huI < huList.length; huI++) { huAvail[huList[huI]] = true; }\nfor (var huName in HU.costs) {\n  if (huAvail[huName]) {\n    HU.cd[huName] = true;\n  } else if (HU.rage >= HU.costs[huName]) {\n    HU.cd[huName] = false;\n  }\n}\nHU.glob = true;\nrun_function(\"hunting_highlight\", [], \"hunting\");\n"
      }
     ],
     "text": "^You can use another Battlerage ability again\\. Available abilities: (.+)$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\nfor (var huName in HU.costs) {\n  if (HU.rage >= HU.costs[huName]) { HU.cd[huName] = false; }\n}\nHU.glob = true;\nrun_function(\"hunting_highlight\", [], \"hunting\");\n"
      }
     ],
     "text": "^You can use another Battlerage ability again, but none of your abilities are currently available\\.$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true
    },
