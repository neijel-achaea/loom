  {
   "type": "group",
   "name": "autogold",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "hunting_gold",
     "enabled": true,
     "code": "// hunting_gold -- gold spilled from a corpse. AUTOGOLD ON picks it up when the\n// kill was yours (or announced) in the last 5 seconds, ALL picks up any gold,\n// OFF leaves it. Into the backpack when security has one set.\nif (!client.loom || !client.loom.hunting || !client.loom.hunting.classes) run_function(\"hunting_setup\", [], \"hunting\");\nvar HU = client.loom.hunting;\nvar huMode = get_variable(\"hunting_autogold\");\nvar huMine = HU.kill && (new Date().getTime() - HU.kill < 5000);\nif (huMode == \"all\" || (huMode == \"on\" && huMine)) {\n  if (get_variable(\"pauseTriggers\") == \"on\") {\n    display_notice(\"[hunting] gold left on the ground: triggers are paused.\", \"orange\");\n  } else {\n    HU.kill = 0;\n    send_command(\"queue add be get gold\", 1);\n    var huPack = (client.loom.security && client.loom.security.backpack) || get_variable(\"backpack\");\n    if (huPack) send_command(\"queue add be put gold in \" + huPack, 1);\n  }\n}\n"
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "run_function(\"hunting_gold\", [], \"hunting\");\n"
      }
     ],
     "text": "A small pile of sovereigns spills from the corpse.",
     "matching": "substring",
     "whole_words": true,
     "case_sensitive": true
    },
