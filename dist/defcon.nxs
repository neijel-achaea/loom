{
 "type": "group",
 "name": "defcon",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"defcon_setup\", [], \"defcon\");\ndisplay_notice(\"[defcon] installed. DEFCON HELP for commands.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is uninstalled"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"defcon_setup\", [], \"defcon\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.defcon || !client.loom.defcon.classes) run_function(\"defcon_setup\", [], \"defcon\");\nvar D = client.loom.defcon;\nif (args.gmcp_method == \"Char.Status\" && args.gmcp_args.class) {\n  var dcWas = D.cls;\n  D.cls = args.gmcp_args.class;\n  if (get_variable(\"defcon_class\") !== D.cls) set_variable(\"defcon_class\", D.cls);\n  // A class change (dragonform included): the game has already loaded that\n  // class's curing list, so just say what level it was left at.\n  if (dcWas && dcWas !== D.cls && D.upDone) {\n    run_function(\"defcon_table\", [], \"defcon\");\n    display_notice(\"[defcon] \" + D.tbl.name + \": \" + ((D.level === undefined || D.level === null) ? \"no DEFCON level set in this class yet.\" : \"DEFCON \" + D.level + \".\"), \"cyan\");\n  }\n  // First class message of the session: raise defences if DEFCON AUTOUP is on.\n  if (!D.upDone) {\n    D.upDone = true;\n    if (get_variable(\"defcon_autoup\") == \"on\") run_function(\"defcon_up\", [], \"defcon\");\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_setup",
   "enabled": true,
   "code": "// defcon_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Namespace, registry, class tables, defaults.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.defcon) client.loom.defcon = {};\nclient.loom.registry.defcon = { version: \"0.3.10\", keyword: \"DEFCON\", desc: \"Defence readiness for any class: five tiers, raised on login\" };\n\nvar D = client.loom.defcon;\n\n// Class tables: defcon_classes.js and classes/*.js.\nrun_function(\"defcon_classes\", [], \"defcon\");\n\nif (!D.queue) D.queue = [];\n\n// Class: followed from GMCP in onGMCP, and kept in defcon_class because the\n// game sends Char.Status only at login and on a change. The first time,\n// loom's old activeClass seeds it (read only).\nif (!D.cls) D.cls = get_variable(\"defcon_class\") || get_variable(\"activeClass\") || \"\";\nif (D.cls && !get_variable(\"defcon_class\")) set_variable(\"defcon_class\", D.cls);\n\n// DEFCON UP on the first class message of each session (the old package sent\n// INITDEF on every load). On unless switched off.\nif (!get_variable(\"defcon_autoup\")) set_variable(\"defcon_autoup\", \"on\");\n"
  },
  {
   "type": "function",
   "name": "defcon_classes",
   "enabled": true,
   "code": "// defcon_classes -- the class tables, built from this file and classes/*.js\n// (one file per class; see classes/README.md). Run from defcon_setup.\n//\n// Per class, in classes/<class>.js, named exactly as GMCP sends the class:\n//   up   -- commands DEFCON UP sends for this class, before the common ones\n//   defs -- [defence, tier, curing priority, relax?]. A defence is kept up at\n//           DEFCON n when its tier >= n. \"relax\" defences are also dropped\n//           (RELAX <def>) when the level no longer wants them.\n// A class with no file gets D.generic for its defences and only D.common\n// for DEFCON UP.\nvar D = client.loom.defcon;\nD.classes = {};\n// Every dragon colour shares the dragonform table.\nD.alias = { \"Black Dragon\": \"Dragon\", \"Blue Dragon\": \"Dragon\", \"Red Dragon\": \"Dragon\", \"Green Dragon\": \"Dragon\", \"Silver Dragon\": \"Dragon\", \"Gold Dragon\": \"Dragon\" };\n\n// Defences taken out of every table. DEFCON resets their curing priority\n// once per table, so a priority set by an older version doesn't keep the\n// game recasting them. Rebounding: it needs recasting so often that you do\n// little else (#156). Curseward: the same, needs constant recasting.\nD.retired = [\"rebounding\", \"curseward\"];\n\n// Sent by DEFCON UP for every class, after the class's own commands.\nD.common = [\"selfishness\", \"avoid physical\", \"insomnia\"];\n\n// Defences for a class with no table yet: the general ones every class above shares.\nD.generic = [\n  [\"alertness\", 1, 10, true],\n  [\"vigilance\", 1, 10, true],\n  [\"hypersight\", 1, 9, true],\n  [\"telesense\", 1, 10, true],\n  [\"metawake\", 1, 9, true],\n  [\"mass\", 2, 8],\n  [\"heldbreath\", 2, 20],\n  [\"fangbarrier\", 3, 8],\n  [\"deafness\", 3, 4],\n  [\"blindness\", 3, 4],\n  [\"kola\", 3, 3],\n  [\"levitating\", 3, 15],\n  [\"speed\", 3, 5],\n  [\"poisonresist\", 3, 8],\n  [\"nightsight\", 4, 13],\n  [\"deathsight\", 4, 18],\n  [\"thirdeye\", 3, 5],\n  [\"insomnia\", 2, 6],\n  [\"selfishness\", 2, 17],\n  [\"mindseye\", 5, 1],\n  [\"temperance\", 3, 8]\n];\n\n// Alchemist: DEFCON UP commands and defences. See classes/README.md.\n// Sulphur and mercury (EDUCE, 350 mana each, equilibrium) make health and\n// mana elixirs heal more; they wear off and are re-educed. Not kept:\n// tin (500 mana, reflects two attacks: a hunting key instead), lead\n// (density: the mass salve covers it), extispicy (needs a rat corpse).\nD.classes[\"Alchemist\"] = {\n  up: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"sulphur\", 3, 12],\n    [\"mercury\", 3, 14]\n  ]\n};\n\n// Apostate: DEFCON UP commands and defences. See classes/README.md.\n// DEFCON UP summons the Baalzadeen first (demon armour needs it), then the\n// daegger, masks the Baalzadeen and wields the daegger. Everything waits for\n// equilibrium in order, so the wield comes after the summon.\n// Demon armour costs the Baalzadeen 300 health, lifevision 600 mana once:\n// neither drains, so both are kept from DEFCON 4. Lifevision mostly guards\n// against adventurers (thieves), but costs nothing to keep up.\nD.classes[\"Apostate\"] = {\n  up: [\"queue add eq summon baalzadeen\", \"queue add eq summon daegger\", \"queue add eq mask\", \"queue add eq wield daegger\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"demonarmour\", 4, 10],\n    [\"lifevision\", 4, 13]\n  ]\n};\n\n// Bard: DEFCON UP commands and defences. See classes/README.md.\n// Tempo is a footwork setting, not a defence: DEFCON UP sets MODERATO on\n// balance, and it can be changed by hand at any time. Blade tune (balance)\n// and grip (balance, keeps weapons from being knocked away) are free once up.\n// Acrobatics (harder to hit) drains endurance heavily and doesn't seem to\n// help against denizens: full alert only. Balancing (harder to knock down)\n// drains mana. Both are relaxed below DEFCON 1.\n// Composition's movements only last while a song plays, and Sagas has no\n// self defence, so neither adds anything here.\nD.classes[\"Bard\"] = {\n  up: [\"queue add bal tempo moderato\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"tune\", 4, 10],\n    [\"gripping\", 4, 12],\n    [\"acrobatics\", 1, 11, true],\n    [\"balancing\", 1, 14, true]\n  ]\n};\n\n// Dragon: DEFCON UP commands and defences. See classes/README.md.\n// Every dragon colour uses this table (D.alias in defcon_classes.js).\n// Same tiers as the generic table (the README's questions). Own defences:\n// dragonarmour (500 mana, then drains willpower and endurance: 3, relaxed\n// below it) and dragonbreath (SUMMON, 300 mana once: 4).\nD.classes[\"Dragon\"] = {\n  up: [\"dragonarmour\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"insulation\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"dragonbreath\", 4, 10],\n    [\"dragonarmour\", 3, 5, true],\n    [\"temperance\", 3, 8]\n  ]\n};\n\n// Druid: DEFCON UP commands and defences. See classes/README.md.\n// Morphs to wyvern and flails the staff first.\nD.classes[\"Druid\"] = {\n  up: [\"morph wyvern\", \"queue add eq embrace spirit\", \"queue add equilibrium summon fire\", \"flail staff\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"temperance\", 3, 12],\n    [\"vitality\", 3, 7],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"harmony\", 3, 11],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1]\n  ]\n};\n\n// Magi: DEFCON UP commands and defences. See classes/README.md.\n// Simultaneity and the staff first.\nD.classes[\"Magi\"] = {\n  up: [\"queue add eq simultaneity\", \"wield staff\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"insulation\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"stoneskin\", 4, 10],\n    [\"diamondskin\", 4, 10],\n    [\"stonefist\", 3, 11, true],\n    [\"chargeshield\", 3, 15],\n    [\"temperance\", 3, 8]\n  ]\n};\n\n// Sylvan: DEFCON UP commands and defences. See classes/README.md.\n// No class commands for DEFCON UP yet.\nD.classes[\"Sylvan\"] = {\n  up: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"barkskin\", 3, 10],\n    [\"temperance\", 3, 8]\n  ]\n};\n"
  },
  {
   "type": "function",
   "name": "defcon_table",
   "enabled": true,
   "code": "// defcon_table -- picks the table for the current class into D.tbl\n// ({ name, up, defs, known }) and that class's remembered level into D.level\n// (undefined: never applied in this class). Unknown classes get the generic\n// defences. Levels are kept per table name (defcon_levels), since the game\n// keeps a curing list per class: every dragon colour shares \"Dragon\".\nvar D = client.loom.defcon;\nvar dcKey = D.alias[D.cls] || D.cls;\nvar dcEntry = D.classes[dcKey];\nif (dcEntry) {\n  D.tbl = { name: dcKey, up: dcEntry.up, defs: dcEntry.defs, known: true };\n} else {\n  D.tbl = { name: D.cls || \"unknown\", up: [], defs: D.generic, known: false };\n}\n\nif (!D.levels) {\n  var dcRaw = get_variable(\"defcon_levels\");\n  D.levels = {};\n  if (dcRaw && typeof dcRaw == \"object\") D.levels = dcRaw;\n  else if (dcRaw) { try { D.levels = JSON.parse(dcRaw); } catch (e) { D.levels = {}; } }\n}\n// One-time migration: the old single defcon_level belongs to the class you\n// are in when it is first seen with a class known, then is cleared.\nvar dcOldLevel = get_variable(\"defcon_level\");\nif (dcOldLevel !== null && dcOldLevel !== undefined && D.cls) {\n  if (D.levels[D.tbl.name] === undefined) D.levels[D.tbl.name] = to_number(dcOldLevel);\n  set_variable(\"defcon_levels\", JSON.stringify(D.levels));\n  delete_variable(\"defcon_level\");\n}\nD.level = D.levels[D.tbl.name];\n"
  },
  {
   "type": "function",
   "name": "defcon_up",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.defcon || !client.loom.defcon.classes) run_function(\"defcon_setup\", [], \"defcon\");\nvar D = client.loom.defcon;\n// DEFCON UP: the class's own commands, then the common ones.\nrun_function(\"defcon_table\", [], \"defcon\");\nvar dcCmds = D.tbl.up.concat(D.common);\nfor (var dcI = 0; dcI < dcCmds.length; dcI++) send_command(dcCmds[dcI]);\ndisplay_notice(\"[defcon] defences up for \" + D.tbl.name + (D.tbl.known ? \"\" : \" (class not configured yet: common defences only)\") + \".\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "defcon_set",
   "enabled": true,
   "code": "// defcon_set -- applies DEFCON D.want (1-5): curing priorities for every\n// defence of a tier >= the level, reset (and relax) for the rest. Setting the\n// level you are already at resends everything (a resync), as does the first\n// level set in a class. The level is remembered for the current class only.\nvar D = client.loom.defcon;\nrun_function(\"defcon_table\", [], \"defcon\");\nvar dcDefs = D.tbl.defs;\nvar dcFirst = (D.level === undefined || D.level === null);\nvar dcOld = dcFirst ? 5 : D.level;\nvar dcLevel = D.want;\nvar dcResync = (dcLevel === dcOld) || dcFirst;\nvar dcQueue = [];\n\nfor (var dcI = 0; dcI < dcDefs.length; dcI++) {\n  var dcName = dcDefs[dcI][0];\n  var dcWant = dcDefs[dcI][1] >= dcLevel;\n  var dcHad = dcDefs[dcI][1] >= dcOld;\n  var dcRelax = dcDefs[dcI][3];\n  if (dcWant && (dcResync || !dcHad)) {\n    dcQueue.push(\"curing priority defence \" + dcName + \" \" + dcDefs[dcI][2]);\n  } else if (!dcWant && (dcResync || dcHad)) {\n    dcQueue.push(\"curing priority defence \" + dcName + \" reset\");\n    if (dcRelax) dcQueue.push(\"relax \" + dcName);\n  }\n}\n\n// Retired defences: reset once per table (defcon_retired remembers which).\nvar dcRet = {};\ntry { dcRet = JSON.parse(get_variable(\"defcon_retired\") || \"{}\") || {}; } catch (e) { dcRet = {}; }\nvar dcRetDone = dcRet[D.tbl.name] || [];\nfor (var dcR = 0; dcR < (D.retired || []).length; dcR++) {\n  if (dcRetDone.indexOf(D.retired[dcR]) < 0) {\n    dcQueue.push(\"curing priority defence \" + D.retired[dcR] + \" reset\");\n    dcRetDone.push(D.retired[dcR]);\n  }\n}\ndcRet[D.tbl.name] = dcRetDone;\nset_variable(\"defcon_retired\", JSON.stringify(dcRet));\n\nD.levels[D.tbl.name] = dcLevel;\nD.level = dcLevel;\nset_variable(\"defcon_levels\", JSON.stringify(D.levels));\nif (D.timer) { clearTimeout(D.timer); D.timer = null; }\nD.queue = dcQueue;\n\nvar dcNote = D.tbl.known ? \"\" : \" (\" + D.tbl.name + \" not configured yet: general defences only)\";\nif (dcQueue.length === 0) {\n  display_notice(\"[defcon] DEFCON \" + dcLevel + \": no changes\" + dcNote + \".\", \"cyan\");\n} else {\n  display_notice(\"[defcon] DEFCON \" + dcLevel + \": applying \" + dcQueue.length + \" changes\" + dcNote + \"...\", \"cyan\");\n  run_function(\"defcon_drain\", [], \"defcon\");\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_drain",
   "enabled": true,
   "code": "// defcon_drain -- sends the queued curing changes one every 250ms.\nvar D = client.loom.defcon;\nif (D.queue.length === 0) {\n  D.timer = null;\n  display_notice(\"[defcon] change complete.\", \"cyan\");\n} else {\n  send_command(D.queue.shift());\n  D.timer = setTimeout(function () {\n    run_function(\"defcon_drain\", [], \"defcon\");\n  }, 250);\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_help",
   "enabled": true,
   "code": "// defcon_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[defcon] defence readiness: one level, five tiers. Commands:\";\n// Whether the current class has its own table, and which classes do.\nvar dcD = client.loom.defcon || {};\nvar dcKnown = [];\nfor (var dcK in (dcD.classes || {})) dcKnown.push(dcK);\nvar dcName = dcD.cls ? ((dcD.alias && dcD.alias[dcD.cls]) || dcD.cls) : \"\";\nvar dcClassNote = \"Classes set up: \" + dcKnown.join(\", \") + \".\"\n  + (dcName && !(dcD.classes && dcD.classes[dcName]) ? \" \" + dcD.cls + \" isn't one yet: you get the general defences.\" : \"\");\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"DEFCON\", \"status\"],\n  [\"DEFCON 1-5\", \"keep defences of that tier and above in curing (5 = fewest, 1 = all), for your current class\"],\n  [\"DEFCON UP\", \"raise your class's defences now\"],\n  [\"DEFCON LIST\", \"defences per tier for your class, with curing priority\"],\n  [\"DEFCON AUTOUP ON|OFF\", \"DEFCON UP when you log in\"],\n  [\"DEFCON ON|OFF\", \"the game's defence upkeep (CURING DEFENCES ON/OFF)\"],\n  [\"DEFCON DEBUG\", \"internal state\"],\n  [\"Each class keeps its own level, as the game keeps its own curing list (dragonform counts as one class).\"],\n  [dcClassNote]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_status",
   "enabled": true,
   "code": "var D = client.loom.defcon;\nrun_function(\"defcon_table\", [], \"defcon\");\ndisplay_notice(\"[defcon] DEFCON \" + ((D.level === null || D.level === undefined) ? \"5 (default, not applied yet in this class)\" : D.level)\n  + \", class \" + D.tbl.name + (D.tbl.known ? \"\" : \" (not configured yet: general defences)\")\n  + \", autoup \" + String(get_variable(\"defcon_autoup\")).toUpperCase() + \". DEFCON HELP for commands.\", \"cyan\");\n"
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// DEFCON [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.defcon || !client.loom.defcon.classes) run_function(\"defcon_setup\", [], \"defcon\");\nvar D = client.loom.defcon;\nvar dcRaw = String(args[1] || \"\").trim().toLowerCase();\nvar dcParts = dcRaw.split(/\\s+/);\nvar dcSub = dcParts[0];\nvar dcVal = dcParts[1] || \"\";\nvar C = \"cyan\";\n\nif (dcSub === \"\" || dcSub === \"status\") {\n  run_function(\"defcon_status\", [], \"defcon\");\n}\nelse if (dcSub === \"help\") {\n  run_function(\"defcon_help\", [], \"defcon\");\n}\nelse if (/^[1-5]$/.test(dcSub)) {\n  D.want = parseInt(dcSub, 10);\n  run_function(\"defcon_set\", [], \"defcon\");\n}\nelse if (/^\\d+$/.test(dcSub)) {\n  display_notice(\"[defcon] levels go from 1 (all defences) to 5 (fewest).\", \"orange\");\n}\nelse if (dcSub === \"up\") {\n  run_function(\"defcon_up\", [], \"defcon\");\n}\nelse if (dcSub === \"on\" || dcSub === \"off\") {\n  send_command(\"curing defences \" + dcSub);\n  display_notice(\"[defcon] defence upkeep \" + dcSub.toUpperCase() + \".\", C);\n}\nelse if (dcSub === \"autoup\") {\n  if (dcVal === \"on\" || dcVal === \"off\") {\n    set_variable(\"defcon_autoup\", dcVal);\n    display_notice(\"[defcon] autoup \" + dcVal.toUpperCase() + \": defences \" + (dcVal === \"on\" ? \"go up\" : \"stay as they are\") + \" when you log in.\", C);\n  } else {\n    display_notice(\"[defcon] autoup is \" + String(get_variable(\"defcon_autoup\")).toUpperCase() + \". DEFCON AUTOUP ON or OFF.\", C);\n  }\n}\nelse if (dcSub === \"list\") {\n  run_function(\"defcon_table\", [], \"defcon\");\n  var dcLvl = D.level || 5;\n  display_notice(\"[defcon] \" + D.tbl.name + (D.tbl.known ? \"\" : \" (general defences)\") + \", tier: defence (priority)\", C);\n  for (var dcT = 1; dcT <= 5; dcT++) {\n    var dcRow = [];\n    for (var dcI = 0; dcI < D.tbl.defs.length; dcI++) {\n      if (D.tbl.defs[dcI][1] === dcT) dcRow.push(D.tbl.defs[dcI][0] + \" (\" + D.tbl.defs[dcI][2] + \")\");\n    }\n    display_notice(\"  \" + dcT + (dcT >= dcLvl ? \" up   \" : \" down \") + dcRow.join(\", \"), dcT >= dcLvl ? \"lime\" : C);\n  }\n}\nelse if (dcSub === \"debug\") {\n  display_notice(\"[defcon] cls=\" + D.cls + \" upDone=\" + D.upDone + \" levels=\" + JSON.stringify(D.levels) + \" queue=\" + JSON.stringify(D.queue) + \" timer=\" + (D.timer ? \"running\" : \"none\"), C);\n}\nelse {\n  display_notice(\"[defcon] unknown command '\" + dcSub + \"'. DEFCON HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^defcon(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
