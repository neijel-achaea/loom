{
 "type": "group",
 "name": "defcon",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"defcon_setup\", [], \"defcon\");\ndisplay_notice(\"[defcon] installed. DEFCON HELP for commands.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is uninstalled"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"defcon_setup\", [], \"defcon\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.defcon || !client.loom.defcon.classes) run_function(\"defcon_setup\", [], \"defcon\");\nvar D = client.loom.defcon;\nif (args.gmcp_method == \"Char.Status\" && args.gmcp_args.class) {\n  D.cls = args.gmcp_args.class;\n  if (get_variable(\"defcon_class\") !== D.cls) set_variable(\"defcon_class\", D.cls);\n  // First class message of the session: raise defences if DEFCON AUTOUP is on.\n  if (!D.upDone) {\n    D.upDone = true;\n    if (get_variable(\"defcon_autoup\") == \"on\") run_function(\"defcon_up\", [], \"defcon\");\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_setup",
   "enabled": true,
   "code": "// defcon_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Namespace, registry, class tables, defaults.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.defcon) client.loom.defcon = {};\nclient.loom.registry.defcon = { version: \"0.2.1\", keyword: \"DEFCON\" };\n\nvar D = client.loom.defcon;\n\n// Per class:\n//   up   -- commands DEFCON UP sends for this class, before the common ones\n//   defs -- [defence, tier, curing priority, relax?]. A defence is kept up at\n//           DEFCON n when its tier >= n. \"relax\" defences are also dropped\n//           (RELAX <def>) when the level no longer wants them.\n// A class missing here gets D.generic for its defences and only D.common\n// for DEFCON UP.\nD.classes = {\n  \"Druid\": {\n    up: [\"morph wyvern\", \"queue add eq embrace spirit\", \"queue add equilibrium summon fire\", \"flail staff\"],\n    defs: [[\"alertness\", 1, 10, true], [\"vigilance\", 1, 10, true], [\"hypersight\", 1, 9, true], [\"telesense\", 1, 10, true], [\"metawake\", 1, 9, true], [\"mass\", 2, 8], [\"rebounding\", 2, 2], [\"heldbreath\", 2, 20], [\"fangbarrier\", 3, 8], [\"deafness\", 3, 4], [\"blindness\", 3, 4], [\"temperance\", 3, 12], [\"vitality\", 3, 7], [\"curseward\", 2, 9], [\"kola\", 3, 3], [\"levitating\", 3, 15], [\"speed\", 3, 5], [\"harmony\", 3, 11], [\"poisonresist\", 3, 8], [\"nightsight\", 4, 13], [\"deathsight\", 4, 18], [\"thirdeye\", 4, 5], [\"insomnia\", 2, 6], [\"selfishness\", 2, 17], [\"mindseye\", 5, 1]]\n  },\n  \"Magi\": {\n    up: [\"queue add eq simultaneity\", \"wield staff\"],\n    defs: [[\"alertness\", 1, 10, true], [\"vigilance\", 1, 10, true], [\"hypersight\", 1, 9, true], [\"telesense\", 1, 10, true], [\"metawake\", 1, 9, true], [\"mass\", 2, 8], [\"rebounding\", 2, 2], [\"heldbreath\", 2, 20], [\"fangbarrier\", 3, 8], [\"deafness\", 3, 4], [\"blindness\", 3, 4], [\"curseward\", 2, 9], [\"kola\", 3, 3], [\"levitating\", 3, 15], [\"speed\", 3, 5], [\"poisonresist\", 3, 8], [\"insulation\", 3, 8], [\"nightsight\", 4, 13], [\"deathsight\", 4, 18], [\"thirdeye\", 4, 5], [\"insomnia\", 2, 6], [\"selfishness\", 2, 17], [\"mindseye\", 5, 1], [\"stoneskin\", 4, 10], [\"diamondskin\", 4, 10], [\"stonefist\", 3, 11, true], [\"chargeshield\", 3, 15], [\"temperance\", 3, 8]]\n  },\n  \"Sylvan\": {\n    up: [],\n    defs: [[\"alertness\", 1, 10, true], [\"vigilance\", 1, 10, true], [\"hypersight\", 1, 9, true], [\"telesense\", 1, 10, true], [\"metawake\", 1, 9, true], [\"mass\", 2, 8], [\"rebounding\", 2, 2], [\"heldbreath\", 2, 20], [\"fangbarrier\", 3, 8], [\"deafness\", 3, 4], [\"blindness\", 3, 4], [\"curseward\", 2, 9], [\"kola\", 3, 3], [\"levitating\", 3, 15], [\"speed\", 3, 5], [\"poisonresist\", 3, 8], [\"nightsight\", 4, 13], [\"deathsight\", 4, 18], [\"thirdeye\", 4, 5], [\"insomnia\", 2, 6], [\"selfishness\", 2, 17], [\"mindseye\", 5, 1], [\"barkskin\", 3, 10], [\"temperance\", 3, 8]]\n  },\n  \"Dragon\": {\n    up: [\"dragonarmour\"],\n    defs: [[\"alertness\", 1, 10, true], [\"vigilance\", 1, 10, true], [\"hypersight\", 1, 9, true], [\"telesense\", 1, 10, true], [\"metawake\", 1, 9, true], [\"mass\", 2, 8], [\"rebounding\", 1, 2], [\"heldbreath\", 2, 20], [\"fangbarrier\", 4, 8], [\"deafness\", 4, 4], [\"blindness\", 4, 4], [\"curseward\", 1, 9], [\"kola\", 4, 3], [\"levitating\", 4, 15], [\"speed\", 4, 5], [\"poisonresist\", 4, 8], [\"insulation\", 3, 8], [\"nightsight\", 5, 13], [\"deathsight\", 5, 18], [\"thirdeye\", 5, 5], [\"insomnia\", 2, 6], [\"selfishness\", 2, 17], [\"mindseye\", 5, 1], [\"dragonbreath\", 4, 10], [\"dragonarmour\", 3, 5, true], [\"temperance\", 3, 8]]\n  }\n};\n// Every dragon colour shares the dragonform table.\nD.alias = { \"Black Dragon\": \"Dragon\", \"Blue Dragon\": \"Dragon\", \"Red Dragon\": \"Dragon\", \"Green Dragon\": \"Dragon\", \"Silver Dragon\": \"Dragon\", \"Gold Dragon\": \"Dragon\" };\n\n// Sent by DEFCON UP for every class, after the class's own commands.\nD.common = [\"selfishness\", \"avoid physical\", \"insomnia\"];\n\n// Defences for a class with no table yet: the general ones every class above shares.\nD.generic = [[\"alertness\", 1, 10, true], [\"vigilance\", 1, 10, true], [\"hypersight\", 1, 9, true], [\"telesense\", 1, 10, true], [\"metawake\", 1, 9, true], [\"mass\", 2, 8], [\"rebounding\", 2, 2], [\"heldbreath\", 2, 20], [\"fangbarrier\", 3, 8], [\"deafness\", 3, 4], [\"blindness\", 3, 4], [\"curseward\", 2, 9], [\"kola\", 3, 3], [\"levitating\", 3, 15], [\"speed\", 3, 5], [\"poisonresist\", 3, 8], [\"nightsight\", 4, 13], [\"deathsight\", 4, 18], [\"thirdeye\", 4, 5], [\"insomnia\", 2, 6], [\"selfishness\", 2, 17], [\"mindseye\", 5, 1], [\"temperance\", 3, 8]];\n\nif (!D.queue) D.queue = [];\n\n// Class: followed from GMCP in onGMCP, and kept in defcon_class because the\n// game sends Char.Status only at login and on a change. The first time,\n// loom's old activeClass seeds it (read only).\nif (!D.cls) D.cls = get_variable(\"defcon_class\") || get_variable(\"activeClass\") || \"\";\nif (D.cls && !get_variable(\"defcon_class\")) set_variable(\"defcon_class\", D.cls);\n\n// DEFCON UP on the first class message of each session (the old package sent\n// INITDEF on every load). On unless switched off.\nif (!get_variable(\"defcon_autoup\")) set_variable(\"defcon_autoup\", \"on\");\n"
  },
  {
   "type": "function",
   "name": "defcon_table",
   "enabled": true,
   "code": "// defcon_table -- picks the table for the current class into D.tbl\n// ({ name, up, defs, known }). Unknown classes get the generic defences.\nvar D = client.loom.defcon;\nvar dcKey = D.alias[D.cls] || D.cls;\nvar dcEntry = D.classes[dcKey];\nif (dcEntry) {\n  D.tbl = { name: dcKey, up: dcEntry.up, defs: dcEntry.defs, known: true };\n} else {\n  D.tbl = { name: D.cls || \"unknown\", up: [], defs: D.generic, known: false };\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_up",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.defcon || !client.loom.defcon.classes) run_function(\"defcon_setup\", [], \"defcon\");\nvar D = client.loom.defcon;\n// DEFCON UP: the class's own commands, then the common ones.\nrun_function(\"defcon_table\", [], \"defcon\");\nvar dcCmds = D.tbl.up.concat(D.common);\nfor (var dcI = 0; dcI < dcCmds.length; dcI++) send_command(dcCmds[dcI]);\ndisplay_notice(\"[defcon] defences up for \" + D.tbl.name + (D.tbl.known ? \"\" : \" (class not configured yet: common defences only)\") + \".\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "defcon_set",
   "enabled": true,
   "code": "// defcon_set -- applies DEFCON D.want (1-5): curing priorities for every\n// defence of a tier >= the level, reset (and relax) for the rest. Setting the\n// level you are already at resends everything (a resync).\nvar D = client.loom.defcon;\nrun_function(\"defcon_table\", [], \"defcon\");\nvar dcDefs = D.tbl.defs;\nvar dcStored = get_variable(\"defcon_level\");\nvar dcFirst = (dcStored === null || dcStored === undefined);\nvar dcOld = dcFirst ? 5 : to_number(dcStored);\nvar dcLevel = D.want;\nvar dcResync = (dcLevel === dcOld) || dcFirst;\nvar dcQueue = [];\n\nfor (var dcI = 0; dcI < dcDefs.length; dcI++) {\n  var dcName = dcDefs[dcI][0];\n  var dcWant = dcDefs[dcI][1] >= dcLevel;\n  var dcHad = dcDefs[dcI][1] >= dcOld;\n  var dcRelax = dcDefs[dcI][3];\n  if (dcWant && (dcResync || !dcHad)) {\n    dcQueue.push(\"curing priority defence \" + dcName + \" \" + dcDefs[dcI][2]);\n  } else if (!dcWant && (dcResync || dcHad)) {\n    dcQueue.push(\"curing priority defence \" + dcName + \" reset\");\n    if (dcRelax) dcQueue.push(\"relax \" + dcName);\n  }\n}\n\nset_variable(\"defcon_level\", dcLevel);\nif (D.timer) { clearTimeout(D.timer); D.timer = null; }\nD.queue = dcQueue;\n\nvar dcNote = D.tbl.known ? \"\" : \" (\" + D.tbl.name + \" not configured yet: general defences only)\";\nif (dcQueue.length === 0) {\n  display_notice(\"[defcon] DEFCON \" + dcLevel + \": no changes\" + dcNote + \".\", \"cyan\");\n} else {\n  display_notice(\"[defcon] DEFCON \" + dcLevel + \": applying \" + dcQueue.length + \" changes\" + dcNote + \"...\", \"cyan\");\n  run_function(\"defcon_drain\", [], \"defcon\");\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_drain",
   "enabled": true,
   "code": "// defcon_drain -- sends the queued curing changes one every 250ms.\nvar D = client.loom.defcon;\nif (D.queue.length === 0) {\n  D.timer = null;\n  display_notice(\"[defcon] change complete.\", \"cyan\");\n} else {\n  send_command(D.queue.shift());\n  D.timer = setTimeout(function () {\n    run_function(\"defcon_drain\", [], \"defcon\");\n  }, 250);\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_help",
   "enabled": true,
   "code": "// defcon_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[defcon] defence readiness: one level, five tiers. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"DEFCON\", \"status\"],\n  [\"DEFCON 1-5\", \"keep defences of that tier and above in curing (5 = fewest, 1 = all)\"],\n  [\"DEFCON UP\", \"raise your class's defences now\"],\n  [\"DEFCON LIST\", \"defences per tier for your class, with curing priority\"],\n  [\"DEFCON AUTOUP ON|OFF\", \"DEFCON UP when you log in\"],\n  [\"DEFCON ON|OFF\", \"the game's defence upkeep (CURING DEFENCES ON/OFF)\"],\n  [\"DEFCON DEBUG\", \"internal state\"],\n  [\"Classes set up: Druid, Magi, Sylvan, dragonform. Others get the general defences.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_status",
   "enabled": true,
   "code": "var D = client.loom.defcon;\nrun_function(\"defcon_table\", [], \"defcon\");\nvar dcStored = get_variable(\"defcon_level\");\ndisplay_notice(\"[defcon] DEFCON \" + ((dcStored === null || dcStored === undefined) ? \"5 (default, not applied yet)\" : dcStored)\n  + \", class \" + D.tbl.name + (D.tbl.known ? \"\" : \" (not configured: general defences)\")\n  + \", autoup \" + String(get_variable(\"defcon_autoup\")).toUpperCase() + \". DEFCON HELP for commands.\", \"cyan\");\n"
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// DEFCON [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.defcon || !client.loom.defcon.classes) run_function(\"defcon_setup\", [], \"defcon\");\nvar D = client.loom.defcon;\nvar dcRaw = String(args[1] || \"\").trim().toLowerCase();\nvar dcParts = dcRaw.split(/\\s+/);\nvar dcSub = dcParts[0];\nvar dcVal = dcParts[1] || \"\";\nvar C = \"cyan\";\n\nif (dcSub === \"\" || dcSub === \"status\") {\n  run_function(\"defcon_status\", [], \"defcon\");\n}\nelse if (dcSub === \"help\") {\n  run_function(\"defcon_help\", [], \"defcon\");\n}\nelse if (/^[1-5]$/.test(dcSub)) {\n  D.want = parseInt(dcSub, 10);\n  run_function(\"defcon_set\", [], \"defcon\");\n}\nelse if (/^\\d+$/.test(dcSub)) {\n  display_notice(\"[defcon] levels go from 1 (all defences) to 5 (fewest).\", \"orange\");\n}\nelse if (dcSub === \"up\") {\n  run_function(\"defcon_up\", [], \"defcon\");\n}\nelse if (dcSub === \"on\" || dcSub === \"off\") {\n  send_command(\"curing defences \" + dcSub);\n  display_notice(\"[defcon] defence upkeep \" + dcSub.toUpperCase() + \".\", C);\n}\nelse if (dcSub === \"autoup\") {\n  if (dcVal === \"on\" || dcVal === \"off\") {\n    set_variable(\"defcon_autoup\", dcVal);\n    display_notice(\"[defcon] autoup \" + dcVal.toUpperCase() + \": defences \" + (dcVal === \"on\" ? \"go up\" : \"stay as they are\") + \" when you log in.\", C);\n  } else {\n    display_notice(\"[defcon] autoup is \" + String(get_variable(\"defcon_autoup\")).toUpperCase() + \". DEFCON AUTOUP ON or OFF.\", C);\n  }\n}\nelse if (dcSub === \"list\") {\n  run_function(\"defcon_table\", [], \"defcon\");\n  var dcLvl = to_number(get_variable(\"defcon_level\")) || 5;\n  display_notice(\"[defcon] \" + D.tbl.name + (D.tbl.known ? \"\" : \" (general defences)\") + \", tier: defence (priority)\", C);\n  for (var dcT = 1; dcT <= 5; dcT++) {\n    var dcRow = [];\n    for (var dcI = 0; dcI < D.tbl.defs.length; dcI++) {\n      if (D.tbl.defs[dcI][1] === dcT) dcRow.push(D.tbl.defs[dcI][0] + \" (\" + D.tbl.defs[dcI][2] + \")\");\n    }\n    display_notice(\"  \" + dcT + (dcT >= dcLvl ? \" up   \" : \" down \") + dcRow.join(\", \"), dcT >= dcLvl ? \"lime\" : C);\n  }\n}\nelse if (dcSub === \"debug\") {\n  display_notice(\"[defcon] cls=\" + D.cls + \" upDone=\" + D.upDone + \" level=\" + get_variable(\"defcon_level\") + \" queue=\" + JSON.stringify(D.queue) + \" timer=\" + (D.timer ? \"running\" : \"none\"), C);\n}\nelse {\n  display_notice(\"[defcon] unknown command '\" + dcSub + \"'. DEFCON HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^defcon(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Choking underwater: outrift and eat a pear for waterbreathing.\nif (get_variable(\"pauseTriggers\") != \"on\") {\n  send_command(\"outr pear\");\n  send_command(\"eat pear\");\n}\n"
    }
   ],
   "text": "You choke as you inhale water.",
   "matching": "substring",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#ff0000",
     "highlight_bg": "#000000",
     "highlight": "line",
     "highlight_backref": ""
    }
   ],
   "text": "fades from view and disappears.",
   "matching": "substring",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#000000",
     "highlight_bg": "#84e251",
     "highlight": "match",
     "highlight_backref": ""
    }
   ],
   "text": "You have writhed free of your state of transfixation.",
   "matching": "substring",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#000000",
     "highlight_bg": "#84e251",
     "highlight": "match",
     "highlight_backref": ""
    }
   ],
   "text": "You are no longer stunned.",
   "matching": "substring",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#000000",
     "highlight_bg": "#84e251",
     "highlight": "match",
     "highlight_backref": ""
    }
   ],
   "text": "You have writhed free of your entanglement by webs.",
   "matching": "substring",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.defcon || !client.loom.defcon.classes) run_function(\"defcon_setup\", [], \"defcon\");\nvar D = client.loom.defcon;\n// Druids flail a quarterstaff as soon as they wield one.\nif (D.cls == \"Druid\" && get_variable(\"pauseTriggers\") != \"on\") send_command(\"flail staff\");\n"
    }
   ],
   "text": "^You start to wield .+ quarterstaff in your hands\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "gag",
     "enabled": true
    }
   ],
   "text": "^You have set the '.*' defence to the \\d+ priority\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Insomnia upkeep.\nif (get_variable(\"pauseTriggers\") != \"on\") send_command(\"insomnia\");\n"
    }
   ],
   "text": "^Your insomnia has cleared up\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  }
 ],
 "description": "Defence upkeep, defence configuration, initdef"
}