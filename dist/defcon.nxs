{
 "type": "group",
 "name": "defcon",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"defcon_setup\", [], \"defcon\");\ndisplay_notice(\"[defcon] installed. DEFCON HELP for commands.\", \"lime\");\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"defcon_gmcp\", [], \"defcon\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// The defcon_* variables are left intact.\n// Leave LOOM and the integrations at once, not at the next load (#137):\n// loom takes the entry out and redraws the tabs that showed this package's answers.\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"defcon\");\n  else delete client.loom.registry.defcon;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"defcon_setup\", [], \"defcon\");\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"defcon_gmcp\", [], \"defcon\");\n"
  },
  {
   "type": "function",
   "name": "defcon_gmcp",
   "enabled": true,
   "code": "// defcon_gmcp -- the work behind onGMCP, as a function made once per load\n// (client.loom.hooks.defcon.gmcp). Nexus compiles a script afresh every time it\n// runs, and long ones cost on every GMCP message, so the script itself stays two\n// lines and calls this (#136). Run from onLoad and onInstall, so a reimport\n// replaces it.\nif (!client.loom) client.loom = {};\nif (!client.loom.hooks) client.loom.hooks = {};\nif (!client.loom.hooks.defcon) client.loom.hooks.defcon = {};\nclient.loom.hooks.defcon.gmcp = function (args) {\n  if (!client.loom || !client.loom.defcon || !client.loom.defcon.classes) run_function(\"defcon_setup\", [], \"defcon\");\n  var D = client.loom.defcon;\n  // A payload that came empty or as something other than an object reads as\n  // an empty one (#135).\n  var dcG = (args.gmcp_args && typeof args.gmcp_args == \"object\") ? args.gmcp_args : {};\n  if (args.gmcp_method == \"Char.Status\" && dcG.class) {\n    var dcWas = D.cls;\n    D.cls = dcG.class;\n    if (get_variable(\"defcon_class\") !== D.cls) set_variable(\"defcon_class\", D.cls);\n    // A class change (dragonform included): the game has already loaded that\n    // class's curing list, so just say what level it was left at.\n    if (dcWas && dcWas !== D.cls && D.upDone) {\n      run_function(\"defcon_table\", [], \"defcon\");\n      // Another class, other skills (#173); its groups come again from GMCP.\n      D.groups = null;\n      if (D.skillCheck) D.skillCheck(\"class\");\n      display_notice(\"[defcon] \" + D.tbl.name + \": \" + ((D.level === undefined || D.level === null) ? \"no DEFCON level set in this class yet.\" : \"DEFCON \" + D.level + \".\"), \"cyan\");\n    }\n    // First class message of the session: send the init commands if DEFCON\n    // INIT AUTO is on.\n    if (!D.upDone) {\n      D.upDone = true;\n      if (get_variable(\"defcon_autoinit\") == \"on\") run_function(\"defcon_up\", [], \"defcon\");\n    }\n  }\n\n  // Skill groups and their abilities (#173, defcon_skills).\n  if (args.gmcp_method == \"Char.Skills.Groups\" && D.skillGroups) D.skillGroups(args.gmcp_args);\n  if (args.gmcp_method == \"Char.Skills.List\" && D.skillList) D.skillList(dcG);\n\n  // Morph (Druid, Sentinel), from charstats: a change completes a pending\n  // DEFCON UP morph (defcon_aftermorph).\n  if (args.gmcp_method == \"Char.Vitals\" && dcG.charstats) {\n    var dcStats = Array.isArray(dcG.charstats) ? dcG.charstats : [], dcMorph = null;\n    for (var dcS = 0; dcS < dcStats.length; dcS++) {\n      var dcMs = String(dcStats[dcS]).match(/^Morph:\\s*(.+)$/);\n      if (dcMs) dcMorph = dcMs[1];\n    }\n    if (dcMorph !== null && dcMorph !== D.morph) {\n      D.morph = dcMorph;\n      // Only the form DEFCON UP asked for (or, if it named none, any form):\n      // the first reading after a load is often \"None\".\n      if (D.afterMorph && (D.afterMorph.want ? dcMorph.toLowerCase() == D.afterMorph.want : !/^none$/i.test(dcMorph))) run_function(\"defcon_aftermorph\", [], \"defcon\");\n    }\n  }\n};\n"
  },
  {
   "type": "function",
   "name": "defcon_skills",
   "enabled": true,
   "code": "// defcon_skills -- skill defences the character hasn't learned yet (#173).\n// Run from defcon_setup: the helpers are made afresh every run, the data kept.\n//\n// What the game tells (Ricardo's probes, 2026-10-31):\n//   Char.Skills.Get {group} -> Char.Skills.List: EVERY ability in the group,\n//     learned or not (an alt knowing three of Vision got all 34). Used only to\n//     know which defences are abilities, and in which group.\n//   Char.Skills.Get {group, name} -> Char.Skills.Info { group, skill, info }:\n//     info starts \"*** You have not yet learned this ability ***\" when it\n//     isn't learned. Nexus opens a popup for every Info, so while DEFCON's\n//     questions are out it wraps Nexus's GMCP handler and keeps the answers\n//     it asked for away from it; everything else passes through, and the\n//     handler goes back as it was once the answers are in (or after\n//     D.skillMs). An ability you look up yourself still pops up.\n//\n// Checked at DEFCON INIT (so at login, with INIT AUTO on) and when the class\n// changes. A defence is a skill when its name (or its curing name, D.defNames)\n// is an ability in one of your groups; herbs, salves and elixirs never are,\n// and stay as before. Unlearned ones are left out of curing at every level\n// (D.isOff), and the change goes to the game at once.\n//   D.abilities   ability -> group, from the lists\n//   D.unlearned   ability -> 1, from the last check\n//   D.sk          the check under way, or null\nvar D = client.loom.defcon;\nif (!D.abilities) D.abilities = {};\nif (!D.unlearned) D.unlearned = {};\nif (D.sk === undefined) D.sk = null;\nD.skillMs = 8000;\n// Some groups never answer a list request (Ricardo's Serpent alt, 2026-10-31:\n// Constitution, Thermology, Frost, Antidotes, Fitness, Galvanism and\n// Philosophy, likely groups without abilities of their own), so the lists\n// aren't all waited for: each one that comes restarts a short wait\n// (D.skillListMs), and when none has come for that long the check goes on.\nD.skillListMs = 1500;\nD.skillListWait = function (sk, ms) {\n  clearTimeout(sk.lt);\n  sk.lt = setTimeout(function () { if (D.sk === sk && sk.phase === \"lists\") D.skillInfo(); }, ms);\n};\nD.skillMark = /^\\s*\\*+\\s*You have not yet learned this ability/i;\n\n// The ability a defence stands for, or \"\" when it isn't one.\nD.abilityOf = function (def) {\n  var n = String(def || \"\").toLowerCase();\n  if (D.abilities[n]) return n;\n  var a = D.defNames && D.defNames[n];\n  return (a && D.abilities[a]) ? a : \"\";\n};\n// The ability an INIT command uses: its first word, after any\n// \"queue add <queue>\" (\"queue add eq simultaneity\" -> simultaneity).\nD.cmdAbility = function (cmd) {\n  var c = String(cmd || \"\").trim().replace(/^queue\\s+(?:add|addclear|prepend)\\s+\\S+\\s+/i, \"\");\n  return D.abilityOf(c.split(/\\s+/)[0]);\n};\nD.cmdOff = function (cmd) {\n  var a = D.cmdAbility(cmd);\n  return !!(a && D.unlearned[a]);\n};\n// A defence left out because its ability isn't learned.\nD.isOff = function (def) {\n  var a = D.abilityOf(def);\n  return !!(a && D.unlearned[a]);\n};\n\n// then: run DEFCON INIT once the check is over (defcon_up, #173).\nD.skillCheck = function (why, then) {\n  if (typeof send_GMCP != \"function\") return false;\n  D.skillUnwrap();\n  if (D.sk && D.sk.t) clearTimeout(D.sk.t);\n  // A check already under way that was to run INIT still runs it.\n  var thenInit = !!then || !!(D.sk && D.sk.thenInit);\n  var sk = { why: why || \"\", phase: \"groups\", lists: {}, ask: {}, unlearned: {}, learned: {}, at: Date.now(), thenInit: thenInit };\n  D.sk = sk;\n  sk.t = setTimeout(function () { if (D.sk === sk) D.skillFinish(\"timeout\"); }, D.skillMs);\n  try { send_GMCP(\"Char.Skills.Get\", {}); } catch (e) {}\n  // The groups may already be known from login: no need to wait for them.\n  if (D.groups && D.groups.length) D.skillLists();\n  return true;\n};\n\n// Ask for every group's ability list (no popups for these).\nD.skillLists = function () {\n  var sk = D.sk;\n  if (!sk || sk.phase !== \"groups\") return;\n  sk.phase = \"lists\";\n  var gs = D.groups || [];\n  for (var i = 0; i < gs.length; i++) {\n    sk.lists[gs[i]] = 1;\n    try { send_GMCP(\"Char.Skills.Get\", { group: gs[i] }); } catch (e) {}\n  }\n  if (!gs.length) { D.skillFinish(\"no groups\"); return; }\n  D.skillListWait(sk, D.skillListMs * 2);\n};\n\n// From the GMCP hook: Char.Skills.Groups and Char.Skills.List.\nD.skillGroups = function (list) {\n  var out = [];\n  if (Array.isArray(list)) {\n    for (var i = 0; i < list.length; i++) {\n      var g = list[i] && (typeof list[i] == \"object\" ? list[i].name : list[i]);\n      if (g) out.push(String(g).toLowerCase());\n    }\n  }\n  if (!out.length) return;\n  D.groups = out;\n  if (D.sk && D.sk.phase === \"groups\") D.skillLists();\n};\nD.skillList = function (g) {\n  var grp = String((g && g.group) || \"\").toLowerCase();\n  var ls = (g && Array.isArray(g.list)) ? g.list : [];\n  if (!grp) return;\n  for (var i = 0; i < ls.length; i++) D.abilities[String(ls[i]).toLowerCase()] = grp;\n  var sk = D.sk;\n  if (!sk || sk.phase !== \"lists\" || !sk.lists[grp]) return;\n  delete sk.lists[grp];\n  for (var k in sk.lists) { if (sk.lists.hasOwnProperty(k)) { D.skillListWait(sk, D.skillListMs); return; } }\n  D.skillInfo();\n};\n\n// Ask about each ability in the class's table, with the popups kept away.\nD.skillInfo = function () {\n  var sk = D.sk;\n  if (!sk) return;\n  clearTimeout(sk.lt);\n  sk.silent = Object.keys(sk.lists);\n  sk.phase = \"info\";\n  run_function(\"defcon_table\", [], \"defcon\");\n  var defs = (D.tbl && D.tbl.defs) || [], n = 0;\n  for (var i = 0; i < defs.length; i++) {\n    var a = D.abilityOf(defs[i][0]);\n    if (a && !sk.ask[a]) { sk.ask[a] = D.abilities[a]; n++; }\n  }\n  // INIT's commands too (insomnia, simultaneity…).\n  var cmds = (D.common || []).concat((D.tbl && D.tbl.init) || [], (D.tbl && D.tbl.aftermorph) || []);\n  for (var c = 0; c < cmds.length; c++) {\n    var ca = D.cmdAbility(cmds[c]);\n    if (ca && !sk.ask[ca]) { sk.ask[ca] = D.abilities[ca]; n++; }\n  }\n  if (!n) { D.skillFinish(\"no skills\"); return; }\n  if (!D.skillWrap()) { D.skillFinish(\"no handler\"); return; }\n  for (var k in sk.ask) {\n    if (sk.ask.hasOwnProperty(k)) { try { send_GMCP(\"Char.Skills.Get\", { group: sk.ask[k], name: k }); } catch (e) {} }\n  }\n};\n\n// The wrap: only while answers are due; a no-op once it's done, even if\n// something else (LOOM PERF) has wrapped on top of it meanwhile.\nD.skillWrap = function () {\n  var dh = client && client._datahandler;\n  if (!dh || typeof dh.handle_GMCP != \"function\") return false;\n  if (D.skW && D.skW.on) return true;\n  var orig = dh.handle_GMCP;\n  var w = { on: true, orig: orig };\n  w.fn = function (method, data) {\n    if (w.on && method === \"Char.Skills.Info\" && D.sk && D.sk.phase === \"info\") {\n      var p = data;\n      if (typeof p == \"string\") { try { p = JSON.parse(p); } catch (e) { p = null; } }\n      var name = p && p.skill ? String(p.skill).toLowerCase() : \"\";\n      if (name && D.sk.ask.hasOwnProperty(name)) {\n        if (D.skillMark.test(String(p.info || \"\"))) D.sk.unlearned[name] = 1; else D.sk.learned[name] = 1;\n        delete D.sk.ask[name];\n        var left = false;\n        for (var k in D.sk.ask) { if (D.sk.ask.hasOwnProperty(k)) { left = true; break; } }\n        if (!left) setTimeout(function () { if (D.sk && D.sk.phase === \"info\") D.skillFinish(\"answered\"); }, 0);\n        return;\n      }\n    }\n    return orig.apply(this, arguments);\n  };\n  dh.handle_GMCP = w.fn;\n  w.dh = dh;\n  D.skW = w;\n  return true;\n};\nD.skillUnwrap = function () {\n  var w = D.skW;\n  if (!w) return;\n  w.on = false;\n  if (w.dh && w.dh.handle_GMCP === w.fn) w.dh.handle_GMCP = w.orig;\n  D.skW = null;\n};\n\n// \"You have learned the SECRETS ability!\" (Ricardo, 2026-10-31): the line\n// names the ability, so it's marked learned at once, with no question to the\n// game; a defence it stands for goes back into curing at the current level.\nD.skillLearned = function (name) {\n  var a = String(name || \"\").toLowerCase().trim();\n  if (!a || !D.unlearned[a]) return;\n  delete D.unlearned[a];\n  run_function(\"defcon_table\", [], \"defcon\");\n  var defs = (D.tbl && D.tbl.defs) || [], back = [], q = [], lvl = D.level;\n  for (var i = 0; i < defs.length; i++) {\n    if (D.abilityOf(defs[i][0]) !== a) continue;\n    back.push(defs[i][0]);\n    if (lvl !== undefined && lvl !== null && defs[i][1] >= lvl) q.push(\"curing priority defence \" + defs[i][0] + \" \" + defs[i][2]);\n  }\n  if (!back.length) return;\n  var off = [];\n  for (var j = 0; j < defs.length; j++) { if (D.isOff(defs[j][0])) off.push(defs[j][0]); }\n  D.skillSaid = off.slice().sort().join(\",\");\n  display_notice(\"[defcon] \" + back.join(\", \") + \" learned: back in curing\" + (q.length ? \" at DEFCON \" + lvl : \"\") + \".\", \"lime\");\n  if (q.length) {\n    D.queue = (D.queue || []).concat(q);\n    if (!D.timer) run_function(\"defcon_drain\", [], \"defcon\");\n  }\n  if (client.loom.notify) client.loom.notify(\"defcon\");\n};\n\n// The check is over: what changed reaches curing at the current level.\nD.skillFinish = function (how) {\n  var sk = D.sk;\n  if (!sk) return;\n  D.sk = null;\n  clearTimeout(sk.t);\n  clearTimeout(sk.lt);\n  D.skillUnwrap();\n  // Abilities that went unanswered keep what the last check found.\n  var was = D.unlearned, now = {};\n  for (var a in was) { if (was.hasOwnProperty(a) && sk.ask.hasOwnProperty(a)) now[a] = 1; }\n  for (var u in sk.unlearned) { if (sk.unlearned.hasOwnProperty(u)) now[u] = 1; }\n  D.unlearned = now;\n  D.skillLast = { how: how, why: sk.why, at: Date.now(), asked: Object.keys(sk.learned).length + Object.keys(sk.unlearned).length, unanswered: Object.keys(sk.ask), silent: sk.silent || Object.keys(sk.lists) };\n  run_function(\"defcon_table\", [], \"defcon\");\n  var defs = (D.tbl && D.tbl.defs) || [], off = [], q = [];\n  var lvl = D.level, first = !D.skillDone;\n  for (var i = 0; i < defs.length; i++) {\n    var n = defs[i][0], ab = D.abilityOf(n);\n    if (!ab) continue;\n    var isOff = !!now[ab], wasOff = !!was[ab];\n    if (isOff) off.push(n);\n    if (lvl === undefined || lvl === null || defs[i][1] < lvl) continue;\n    // Wanted at this level: left out now (or first check this session, in\n    // case the game still has it from before), or learned since.\n    if (isOff && (!wasOff || first)) q.push(\"curing priority defence \" + n + \" reset\");\n    else if (!isOff && wasOff) q.push(\"curing priority defence \" + n + \" \" + defs[i][2]);\n  }\n  D.skillDone = true;\n  var key = off.slice().sort().join(\",\");\n  if (off.length && key !== D.skillSaid) display_notice(\"[defcon] not learned yet, left out of curing: \" + off.join(\", \") + \".\", \"cyan\");\n  else if (!off.length && D.skillSaid) display_notice(\"[defcon] every skill defence in \" + D.tbl.name + \" is learned now: back in curing.\", \"lime\");\n  D.skillSaid = key;\n  if (q.length) {\n    D.queue = (D.queue || []).concat(q);\n    if (!D.timer) run_function(\"defcon_drain\", [], \"defcon\");\n  }\n  if (client.loom.notify) client.loom.notify(\"defcon\");\n  if (sk.thenInit) { D.initGo = true; run_function(\"defcon_up\", [], \"defcon\"); }\n};\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// onGMCP: the work is in defcon_gmcp (#136: this runs on every GMCP message, so it stays short).\nvar lkH = client.loom && client.loom.hooks && client.loom.hooks.defcon;\nif (!lkH || !lkH.gmcp) { run_function(\"defcon_gmcp\", [], \"defcon\"); lkH = client.loom.hooks.defcon; }\nlkH.gmcp(args);\n"
  },
  {
   "type": "function",
   "name": "defcon_setup",
   "enabled": true,
   "code": "// defcon_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Namespace, registry, class tables, defaults.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.defcon) client.loom.defcon = {};\nclient.loom.registry.defcon = { version: \"1.1.0\", keyword: \"DEFCON\", desc: \"Defence readiness for any class: five tiers, raised on login\" };\n\nvar D = client.loom.defcon;\n\n// Class tables: defcon_classes.js and classes/*.js.\nrun_function(\"defcon_classes\", [], \"defcon\");\n\nif (!D.queue) D.queue = [];\n\n// Class: followed from GMCP in onGMCP, and kept in defcon_class because the\n// game sends Char.Status only at login and on a change. The first time,\n// loom's old activeClass seeds it (read only).\nif (!D.cls) D.cls = get_variable(\"defcon_class\") || get_variable(\"activeClass\") || \"\";\nif (D.cls && !get_variable(\"defcon_class\")) set_variable(\"defcon_class\", D.cls);\n\n// DEFCON INIT on the first class message of each session (the old package\n// sent INITDEF on every load). On unless switched off. Until 0.4.0 this was\n// defcon_autoup: carried over once.\nvar dcAu = get_variable(\"defcon_autoup\");\nif (dcAu !== null && dcAu !== undefined) {\n  if (!get_variable(\"defcon_autoinit\")) set_variable(\"defcon_autoinit\", String(dcAu));\n  delete_variable(\"defcon_autoup\");\n}\nif (!get_variable(\"defcon_autoinit\")) set_variable(\"defcon_autoinit\", \"on\");\n\n// The read-only look other packages see through loom (#176): never its\n// variables. Defined on every run.\n//   look.wanted() -> { level, table, defs } at the current class's DEFCON\n//     level: defs are the defences of the effective table (defaults plus\n//     your changes) with a tier >= the level, the ones DEFCON keeps up.\n//     undefined while no table is loaded or no level is set in this class.\n// Some defences go by one name in curing (the table's) and another in the\n// game's defence list (GMCP, DEF): the look reports the defence-list name,\n// so Self can match it. Add pairs here as they turn up.\nD.defNames = { mass: \"density\" };\n// Skill defences not learned yet (#173): D.isOff, D.skillCheck.\nrun_function(\"defcon_skills\", [], \"defcon\");\nD.look = {\n  wanted: function () {\n    if (!D.tbl || !D.tbl.defs || D.level === undefined || D.level === null) return undefined;\n    var out = [];\n    for (var i = 0; i < D.tbl.defs.length; i++) {\n      if (D.tbl.defs[i][1] < D.level || (D.isOff && D.isOff(D.tbl.defs[i][0]))) continue;\n      var nm = String(D.tbl.defs[i][0]).toLowerCase();\n      out.push(D.defNames[nm] || nm);\n    }\n    return { level: D.level, table: D.tbl.name, defs: out };\n  }\n};\n"
  },
  {
   "type": "function",
   "name": "defcon_classes",
   "enabled": true,
   "code": "// defcon_classes -- the class tables, built from this file and classes/*.js\n// (one file per class; see classes/README.md). Run from defcon_setup.\n//\n// Per class, in classes/<class>.js, named exactly as GMCP sends the class:\n//   init -- commands DEFCON INIT sends for this class, after the common ones\n//   aftermorph -- optional: sent once the morph in init has completed\n//   defs -- [defence, tier, curing priority, relax?]. A defence is kept up at\n//           DEFCON n when its tier >= n. \"relax\" defences are also dropped\n//           (RELAX <def>) when the level no longer wants them.\n// A class with no file gets D.generic for its defences and only D.common\n// for DEFCON INIT.\nvar D = client.loom.defcon;\nD.classes = {};\n// Every dragon colour shares the dragonform table.\nD.alias = { \"Black Dragon\": \"Dragon\", \"Blue Dragon\": \"Dragon\", \"Red Dragon\": \"Dragon\", \"Green Dragon\": \"Dragon\", \"Silver Dragon\": \"Dragon\", \"Gold Dragon\": \"Dragon\", \"Golden Dragon\": \"Dragon\" };\n\n// Defences taken out of every table. DEFCON resets their curing priority\n// once per table, so a priority set by an older version doesn't keep the\n// game recasting them. Rebounding: it needs recasting so often that you do\n// little else (#156). Curseward: the same, needs constant recasting.\nD.retired = [\"rebounding\", \"curseward\"];\n\n// Sent by DEFCON INIT for every class, before the class's own commands.\nD.common = [\"selfishness\", \"avoid physical\", \"insomnia\"];\n\n// Defences for a class with no table yet: the general ones every class above shares.\nD.generic = [\n  [\"alertness\", 1, 10, true],\n  [\"vigilance\", 1, 10, true],\n  [\"hypersight\", 1, 9, true],\n  [\"telesense\", 1, 10, true],\n  [\"metawake\", 1, 9, true],\n  [\"mass\", 2, 8],\n  [\"heldbreath\", 2, 20],\n  [\"fangbarrier\", 3, 8],\n  [\"deafness\", 3, 4],\n  [\"blindness\", 3, 4],\n  [\"kola\", 3, 3],\n  [\"levitating\", 3, 15],\n  [\"speed\", 3, 5],\n  [\"poisonresist\", 3, 8],\n  [\"nightsight\", 4, 13],\n  [\"deathsight\", 4, 18],\n  [\"thirdeye\", 3, 5],\n  [\"insomnia\", 2, 6],\n  [\"selfishness\", 2, 17],\n  [\"mindseye\", 5, 1],\n  [\"temperance\", 3, 8]\n];\n\n// Alchemist: DEFCON INIT commands and defences. See classes/README.md.\n// Sulphur and mercury (EDUCE, 350 mana each, equilibrium) make health and\n// mana elixirs heal more; they wear off and are re-educed. Not kept:\n// tin (500 mana, reflects two attacks: a hunting key instead), lead\n// (density: the mass salve covers it), extispicy (needs a rat corpse).\nD.classes[\"Alchemist\"] = {\n  init: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"sulphur\", 3, 12],\n    [\"mercury\", 3, 14]\n  ]\n};\n\n// Apostate: DEFCON INIT commands and defences. See classes/README.md.\n// DEFCON INIT summons the Baalzadeen first (demon armour needs it), then the\n// daegger, masks the Baalzadeen and wields the daegger. Everything waits for\n// equilibrium in order, so the wield comes after the summon.\n// Demon armour costs the Baalzadeen 300 health, lifevision 600 mana once:\n// neither drains, so both are kept from DEFCON 4. Lifevision mostly guards\n// against adventurers (thieves), but costs nothing to keep up.\nD.classes[\"Apostate\"] = {\n  init: [\"queue add eq summon baalzadeen\", \"queue add eq summon daegger\", \"queue add eq mask\", \"queue add eq wield daegger\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"demonarmour\", 4, 10],\n    [\"lifevision\", 4, 13]\n  ]\n};\n\n// Bard: DEFCON INIT commands and defences. See classes/README.md.\n// Tempo is a footwork setting, not a defence: DEFCON INIT sets MODERATO on\n// balance, and it can be changed by hand at any time. Blade tune (balance)\n// and grip (balance, keeps weapons from being knocked away) are free once up.\n// Acrobatics (harder to hit) drains endurance heavily and doesn't seem to\n// help against denizens: full alert only. Balancing (harder to knock down)\n// drains mana. Both are relaxed below DEFCON 1.\n// Composition's movements only last while a song plays, and Sagas has no\n// self defence, so neither adds anything here.\nD.classes[\"Bard\"] = {\n  init: [\"queue add bal tempo moderato\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"tune\", 4, 10],\n    [\"gripping\", 4, 12],\n    [\"acrobatics\", 1, 11, true],\n    [\"balancing\", 1, 14, true]\n  ]\n};\n\n// Blademaster: DEFCON INIT commands and defences. See classes/README.md.\n// DEFCON INIT positions the scabbard (the First Art needs it, every login),\n// enters the Shin trance and takes the Doya stance, on the balance queue.\n// Defaults: the generic defences plus gripping and toughness. Unconfirmed\n// Shindo and Striking defences are suggestions in classes/README.md.\nD.classes[\"Blademaster\"] = {\n  init: [\"queue add bal position scabbard\", \"queue add bal shin trance\", \"queue add bal doya\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"gripping\", 4, 12],\n    [\"toughness\", 4, 10]\n  ]\n};\n\n// Depthswalker: defences. See classes/README.md.\n// Defaults: the generic defences. The shadow cloak and scythe persist\n// across sessions, so nothing is sent on DEFCON INIT. The Terminus\n// intonements (after embracing) are suggestions in classes/README.md.\nD.classes[\"Depthswalker\"] = {\n  init: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8]\n  ]\n};\n\n// Dragon: DEFCON INIT commands and defences. See classes/README.md.\n// Every dragon colour uses this table (D.alias in defcon_classes.js).\n// Same tiers as the generic table (the README's questions). Own defences:\n// dragonarmour (500 mana, then drains willpower and endurance: 3, relaxed\n// below it) and dragonbreath (SUMMON, 300 mana once: 4).\nD.classes[\"Dragon\"] = {\n  init: [\"dragonarmour\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"insulation\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"dragonbreath\", 4, 10],\n    [\"dragonarmour\", 3, 5, true],\n    [\"temperance\", 3, 8]\n  ]\n};\n\n// Druid: DEFCON INIT commands and defences. See classes/README.md.\n// DEFCON INIT morphs into a wyvern on equilibrium, last, since anything sent\n// while morphing breaks it (Neijel has truemorph, others may not). Once the\n// morph completes: embrace the spirit, summon fire, flail the staff.\nD.classes[\"Druid\"] = {\n  init: [\"queue add eq morph wyvern\"],\n  aftermorph: [\"queue add eq embrace spirit\", \"queue add eq summon fire\", \"flail staff\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"temperance\", 3, 12],\n    [\"vitality\", 4, 7],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"harmony\", 3, 11],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1]\n  ]\n};\n\n// Infernal: defences. See classes/README.md. Skills: Oppression,\n// Malignity, Weaponmastery.\n// Defaults: the generic defences plus resistance and gripping. The\n// hellforge activations are suggestions in classes/README.md until\n// confirmed. Soulshield is a battlerage key in hunting (F11).\nD.classes[\"Infernal\"] = {\n  init: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"resistance\", 4, 10],\n    [\"gripping\", 4, 12]\n  ]\n};\n\n// Jester: defences. See classes/README.md. Skills: Pranks, Tarot,\n// Puppetry. Nothing is sent on DEFCON INIT (the blackjack stays wielded).\n// Slipperiness (no ongoing cost) and gripping at DEFCON 4; acrobatics\n// (endurance) and balancing (mana) only at 1, relaxed below. Arrowcatch is\n// a suggestion in classes/README.md. Fool is a hunting key (F11).\nD.classes[\"Jester\"] = {\n  init: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"slipperiness\", 4, 10],\n    [\"gripping\", 4, 12],\n    [\"acrobatics\", 1, 11, true],\n    [\"balancing\", 1, 14, true]\n  ]\n};\n\n// Magi: DEFCON INIT commands and defences. See classes/README.md.\n// Simultaneity and the staff first.\nD.classes[\"Magi\"] = {\n  init: [\"queue add eq simultaneity\", \"wield staff\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"insulation\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"stoneskin\", 4, 10],\n    [\"diamondskin\", 4, 10],\n    [\"stonefist\", 3, 11, true],\n    [\"chargeshield\", 3, 15],\n    [\"temperance\", 3, 8]\n  ]\n};\n\n// Monk: DEFCON INIT commands and defences. See classes/README.md.\n// Skills: Tekura, Kaido, Telepathy.\n// DEFCON INIT takes the Eagle stance (EGS) on balance: the hunting combo\n// (sidekick, uppercut, uppercut) is built for it.\n// Toughness (less cutting damage), vitality (a big heal under 25% health;\n// only raised near full health and mana) and weathering (+1 constitution)\n// are free once up: DEFCON 4. Projectiles and dodging drain mana and\n// willpower: DEFCON 1, relaxed below. Bodyblock is a hunting toggle (F11).\nD.classes[\"Monk\"] = {\n  init: [\"queue add bal egs\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"toughness\", 4, 10],\n    [\"vitality\", 4, 7],\n    [\"weathering\", 4, 12],\n    [\"projectiles\", 1, 14, true],\n    [\"dodging\", 1, 15, true]\n  ]\n};\n\n// Occultist: defences. See classes/README.md. Skills: Occultism,\n// Domination, Tarot. Nothing is sent on DEFCON INIT.\n// Astralvision (lifevision and deathsight in one) is free once up: DEFCON 4.\n// Distortaura (karma, then a steady mana drain) feeds back physical damage\n// and softens some denizen damage: DEFCON 1, taken down with NORMALAURA\n// below. Simulacrum and heartstone cost karma on every raise, so curing\n// doesn't keep them; simulacrum is a hunting panic key (F11).\nD.classes[\"Occultist\"] = {\n  init: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"astralvision\", 4, 13],\n    [\"distortaura\", 1, 14, \"normalaura\"]\n  ]\n};\n\n// Paladin: defences. See classes/README.md. Skills: Weaponmastery,\n// Excision, Valour. Nothing is sent on DEFCON INIT.\n// Free once up (DEFCON 4): faith (resists cutting, blunt and some magic),\n// unbowed (a health surge when badly hurt, can stop one killing blow),\n// resistance (less magic damage), gripping and weathering (+1 con).\n// The Rite of Regeneration is a hunting key (F11). Fury stays out (500\n// willpower per re-enable).\nD.classes[\"Paladin\"] = {\n  init: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"faith\", 4, 10],\n    [\"unbowed\", 4, 11],\n    [\"resistance\", 4, 10],\n    [\"gripping\", 4, 12],\n    [\"weathering\", 4, 12]\n  ]\n};\n\n// Pariah: DEFCON INIT commands and defences. See classes/README.md.\n// Skills: Memorium, Pestilence, Charnel (after embracing).\n// DEFCON INIT lets your own blood onto the ritual blade (CRUX LET ME) on\n// equilibrium. Swarms persist, so nothing else is sent.\n// Free once up (DEFCON 4): shieldlogograph (TRACE SHIELD ME, damage\n// resistance by intelligence) and leechlogograph (TRACE LEECH ME, draws\n// out afflictions for five minutes). Resolve is a suggestion.\nD.classes[\"Pariah\"] = {\n  init: [\"queue add eq crux let me\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"shieldlogograph\", 4, 10],\n    [\"leechlogograph\", 4, 12]\n  ]\n};\n\n// Priest: DEFCON INIT commands and defences. See classes/README.md.\n// Skills: Spirituality, Devotion, Zeal (after embracing).\n// DEFCON INIT summons the angel (equilibrium), then summons and wields the\n// spiritual mace (balance), in that order.\n// Angel care heals your afflictions but drains angel power: DEFCON 1,\n// switched off (ANGEL CARE OFF) below. DEF name \"care\" unconfirmed.\n// Not kept: angel aura (drops when you move or attack, like the shield\n// tattoo), inspiration (short and costly), the room rites. The Zeal\n// blessings are suggestions until confirmed after embracing.\nD.classes[\"Priest\"] = {\n  init: [\"queue add eq angel summon\", \"queue add bal summon mace\", \"queue add bal wield mace\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"care\", 1, 13, \"angel care off\"]\n  ]\n};\n\n// Psion: defences. See classes/README.md. Skills: Weaving, Psionics,\n// Emulation. Nothing is sent on DEFCON INIT (WEAVE PREPARE lasts until\n// changed).\n// Free once up (DEFCON 4): secondskin (WEAVE SECONDSKIN, resists every\n// damage type) and guidedstrike (ENACT GUIDEDSTRIKE, bigger critical hits).\n// Indomitability is a hunting panic key (F11): its images run out, so\n// curing would keep re-casting it.\nD.classes[\"Psion\"] = {\n  init: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"secondskin\", 4, 10],\n    [\"guidedstrike\", 4, 12]\n  ]\n};\n\n// Runewarden: defences. See classes/README.md. Skills: Weaponmastery,\n// Runelore, Discipline. Nothing is sent on DEFCON INIT.\n// Free once up (DEFCON 4): resistance (less magic damage), gripping and\n// weathering (+1 constitution), as on the other knights.\n// Runes sketched on yourself (algiz, jera, berkana) don't show in DEF, so\n// curing can't keep them; fury stays out (500 willpower per re-enable).\n// Bulwark is a battlerage key (F11).\nD.classes[\"Runewarden\"] = {\n  init: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"resistance\", 4, 10],\n    [\"gripping\", 4, 12],\n    [\"weathering\", 4, 12]\n  ]\n};\n\n// Sentinel: DEFCON INIT commands and defences. See classes/README.md.\n// Skills: Metamorphosis, Woodlore, Skirmishing.\n// DEFCON INIT morphs into a jaguar on equilibrium, last, since anything sent\n// while morphing breaks it. Once the morph completes, it embraces the spirit\n// (less endurance loss in every spirit form). If the morph doesn't take,\n// morph by hand.\n// Free once up (DEFCON 4): barkskin (200 mana once, physical protection),\n// firstaid (wounds clot faster) and fleetness (faster through forests).\nD.classes[\"Sentinel\"] = {\n  init: [\"queue add eq morph jaguar\"],\n  aftermorph: [\"queue add eq embrace spirit\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"barkskin\", 4, 10],\n    [\"firstaid\", 4, 12],\n    [\"fleetness\", 4, 14]\n  ]\n};\n\n// Serpent: defences. See classes/README.md. Skills: Subterfuge, Venom,\n// Hypnosis. Nothing is sent on DEFCON INIT.\n// Scales (balance, mildly protective) are free once up: DEFCON 4.\n// Weaving and hiding are the hunting keys' Weave and Sneak toggles, so\n// DEFCON leaves them alone (it would fight the toggle). Pacing and phase\n// are for chasing or avoiding adventurers.\nD.classes[\"Serpent\"] = {\n  init: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"scales\", 4, 10]\n  ]\n};\n\n// Shaman: defences. See classes/README.md. Skills: Vodun, Curses,\n// Spiritlore. Nothing is sent on DEFCON INIT: spirit bonds and attunements\n// last until changed.\n// Free once up (DEFCON 4): gripping, and the invocations regeneration\n// (Ri'shen, 300 mana once) and purification (Daina, 200 mana once), which\n// need that spirit bound. Their DEF names are unconfirmed.\n// Arrowcatching (mana drain) is a suggestion; swiftcurse is used up after\n// ten curses, so curing can't keep it.\nD.classes[\"Shaman\"] = {\n  init: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"gripping\", 4, 12],\n    [\"regeneration\", 4, 11],\n    [\"purification\", 4, 13]\n  ]\n};\n\n// Sylvan: DEFCON INIT commands and defences. See classes/README.md.\n// No class commands for DEFCON INIT yet.\nD.classes[\"Sylvan\"] = {\n  init: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"barkskin\", 4, 10],\n    [\"temperance\", 3, 8]\n  ]\n};\n\n// Unnamable: defences. See classes/README.md. Skills: Weaponmastery,\n// Dominion (the knights' shared skill), Anathema. Nothing is sent on\n// DEFCON INIT.\n// Free once up (DEFCON 4): resistance, gripping and weathering, as on the\n// other knights.\n// Mutations (Anathema) don't persist across logins and use their own\n// anathema balance (\"You may wield the Chaotic forces once again.\"):\n// mouths (0.5% karma; Shriek, Dread and Entropy need it) and bulk (0.5%\n// karma; +1 strength, minor cutting and blunt resistance) are left to\n// curing at DEFCON 3, since each raise costs karma. DEF names unconfirmed;\n// if curing doesn't raise them, they move to DEFCON INIT.\nD.classes[\"Unnamable\"] = {\n  init: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"resistance\", 4, 10],\n    [\"gripping\", 4, 12],\n    [\"weathering\", 4, 12],\n    [\"mouths\", 3, 10],\n    [\"bulk\", 3, 12]\n  ]\n};\n"
  },
  {
   "type": "function",
   "name": "defcon_table",
   "enabled": true,
   "code": "// defcon_table -- builds the table for the current class into D.tbl and\n// that class's remembered level into D.level (undefined: never applied in\n// this class). Unknown classes get the generic defences. Levels and the\n// player's own changes are kept per table name, since the game keeps a\n// curing list per class: every dragon colour shares \"Dragon\".\n//\n// D.tbl = { name, known, init, aftermorph, defs,\n//           mine: { defence: \"added\" | \"changed\" }, removed: [defence],\n//           initMine: [cmd], afterMine: [cmd] }\n// The defaults come from the class file; the player's changes\n// (defcon_custom, see defcon_edit) are laid over them, so a later fix to a\n// default still arrives, except where the player changed that entry.\nvar D = client.loom.defcon;\nif (!D.custom) {\n  D.custom = {};\n  var dcCr = get_variable(\"defcon_custom\");\n  if (dcCr && typeof dcCr == \"object\") D.custom = dcCr;\n  else if (dcCr) { try { D.custom = JSON.parse(dcCr) || {}; } catch (e) { D.custom = {}; } }\n  // Anything but a table of tables (a number, a list, broken JSON) starts\n  // afresh rather than breaking every DEFCON command (#135).\n  if (!D.custom || typeof D.custom != \"object\" || Array.isArray(D.custom)) D.custom = {};\n  for (var dcCk in D.custom) { if (D.custom.hasOwnProperty(dcCk) && (!D.custom[dcCk] || typeof D.custom[dcCk] != \"object\" || Array.isArray(D.custom[dcCk]))) delete D.custom[dcCk]; }\n}\nvar dcKey = D.alias[D.cls] || D.cls;\nvar dcEntry = D.classes[dcKey];\nvar dcName = dcEntry ? dcKey : (D.cls || \"unknown\");\n// Class files used \"up\" before 0.4.0; both are read.\nvar dcBase = dcEntry\n  ? { init: dcEntry.init || dcEntry.up || [], aftermorph: dcEntry.aftermorph || [], defs: dcEntry.defs }\n  : { init: [], aftermorph: [], defs: D.generic };\nvar dcMine = D.custom[dcName] || {};\n\n// Defences: defaults in order, the player's changes in place, additions last.\nvar dcCd = dcMine.defs || {};\nvar dcDefs = [], dcMineMark = {}, dcRemoved = [], dcSeen = {};\nfor (var dcI = 0; dcI < dcBase.defs.length; dcI++) {\n  var dcRow = dcBase.defs[dcI], dcN = dcRow[0];\n  dcSeen[dcN] = true;\n  if (dcCd.hasOwnProperty(dcN)) {\n    if (dcCd[dcN] === null) { dcRemoved.push(dcN); continue; }\n    dcDefs.push([dcN].concat(dcCd[dcN]));\n    dcMineMark[dcN] = \"changed\";\n  } else {\n    dcDefs.push(dcRow);\n  }\n}\nfor (var dcA in dcCd) {\n  if (dcCd.hasOwnProperty(dcA) && !dcSeen[dcA] && dcCd[dcA] !== null) {\n    dcDefs.push([dcA].concat(dcCd[dcA]));\n    dcMineMark[dcA] = \"added\";\n  }\n}\n\n// Command lists: defaults minus the ones removed, then the ones added.\nfunction dcCmdList(base, mine) {\n  var rm = (mine && mine.remove) || [], add = (mine && mine.add) || [], out = [];\n  for (var i = 0; i < base.length; i++) { if (rm.indexOf(base[i]) < 0) out.push(base[i]); }\n  return out.concat(add);\n}\n\nD.tbl = {\n  name: dcName,\n  known: !!dcEntry,\n  init: dcCmdList(dcBase.init, dcMine.init),\n  aftermorph: dcCmdList(dcBase.aftermorph, dcMine.aftermorph),\n  defs: dcDefs,\n  mine: dcMineMark,\n  removed: dcRemoved,\n  initMine: ((dcMine.init && dcMine.init.add) || []).slice(),\n  afterMine: ((dcMine.aftermorph && dcMine.aftermorph.add) || []).slice(),\n  base: dcBase\n};\n\nif (!D.levels) {\n  var dcRaw = get_variable(\"defcon_levels\");\n  D.levels = {};\n  if (dcRaw && typeof dcRaw == \"object\") D.levels = dcRaw;\n  else if (dcRaw) { try { D.levels = JSON.parse(dcRaw); } catch (e) { D.levels = {}; } }\n  if (!D.levels || typeof D.levels != \"object\" || Array.isArray(D.levels)) D.levels = {};\n}\n// One-time migration: the old single defcon_level belongs to the class you\n// are in when it is first seen with a class known, then is cleared.\nvar dcOldLevel = get_variable(\"defcon_level\");\nif (dcOldLevel !== null && dcOldLevel !== undefined && D.cls) {\n  if (D.levels[D.tbl.name] === undefined) D.levels[D.tbl.name] = to_number(dcOldLevel);\n  set_variable(\"defcon_levels\", JSON.stringify(D.levels));\n  delete_variable(\"defcon_level\");\n}\nD.level = D.levels[D.tbl.name];\n// The table or level may have changed: tell loom (#176, the Self tab).\nif (client.loom.notify) client.loom.notify(\"defcon\");\n"
  },
  {
   "type": "function",
   "name": "defcon_up",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.defcon || !client.loom.defcon.classes) run_function(\"defcon_setup\", [], \"defcon\");\nvar D = client.loom.defcon;\n// The skill check comes first (#173), so INIT never sends a command for an\n// ability this character hasn't learned (insomnia on a young alt): the check\n// runs DEFCON INIT again when it's done (D.initGo), at most D.skillMs later.\n// Without send_GMCP there's no check, and INIT goes out at once.\nif (!D.initGo && D.skillCheck && D.skillCheck(\"init\", true)) {\n  // waiting for the check\n} else {\nD.initGo = false;\n// DEFCON INIT: the common commands, then the class's own, last: anything sent\n// while morphing breaks the morph, so a class can end on one. Commands the\n// class lists in \"aftermorph\" wait for the morph to complete\n// (defcon_aftermorph, from the game's line or the Morph charstat).\nrun_function(\"defcon_table\", [], \"defcon\");\nvar dcCmds = D.common.concat(D.tbl.init);\nvar dcAfter = D.tbl.aftermorph || [];\nD.afterMorph = null;\nif (dcAfter.length) {\n  var dcWant = \"\";\n  for (var dcJ = 0; dcJ < D.tbl.init.length; dcJ++) {\n    var dcMm = String(D.tbl.init[dcJ]).match(/\\bmorph\\s+(\\w+)\\s*$/i);\n    if (dcMm) dcWant = dcMm[1].toLowerCase();\n  }\n  if (dcWant && String(D.morph || \"\").toLowerCase() == dcWant) {\n    // Already in that form: no morph to wait for.\n    var dcKeep = [];\n    for (var dcK = 0; dcK < dcCmds.length; dcK++) { if (!/\\bmorph\\s+\\w+\\s*$/i.test(dcCmds[dcK])) dcKeep.push(dcCmds[dcK]); }\n    dcCmds = dcKeep.concat(dcAfter);\n  } else {\n    D.afterMorph = { cmds: dcAfter.slice(), want: dcWant };\n  }\n}\n// Commands for abilities not learned yet are left out (#173).\nvar dcLeft = [];\nvar dcKeepCmd = (c) => { if (D.cmdOff && D.cmdOff(c)) { dcLeft.push(String(c)); return false; } return true; };\ndcCmds = dcCmds.filter(dcKeepCmd);\nif (D.afterMorph) D.afterMorph.cmds = D.afterMorph.cmds.filter(dcKeepCmd);\nfor (var dcI = 0; dcI < dcCmds.length; dcI++) send_command(dcCmds[dcI]);\ndisplay_notice(\"[defcon] init sent for \" + D.tbl.name + (D.tbl.known ? \"\" : \" (class not configured yet: common defences only)\") + (D.afterMorph ? \"; the rest once the morph completes\" : \"\") + (dcLeft.length ? \" (left out, not learned yet: \" + dcLeft.join(\", \") + \")\" : \"\") + \".\", \"lime\");\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_set",
   "enabled": true,
   "code": "// defcon_set -- applies DEFCON D.want (1-5): curing priorities for every\n// defence of a tier >= the level, reset (and relax) for the rest. Setting the\n// level you are already at resends everything (a resync), as does the first\n// level set in a class. The level is remembered for the current class only.\nvar D = client.loom.defcon;\nrun_function(\"defcon_table\", [], \"defcon\");\nvar dcDefs = D.tbl.defs;\nvar dcFirst = (D.level === undefined || D.level === null);\nvar dcOld = dcFirst ? 5 : D.level;\nvar dcLevel = D.want;\nvar dcResync = (dcLevel === dcOld) || dcFirst;\nvar dcQueue = [];\n\nfor (var dcI = 0; dcI < dcDefs.length; dcI++) {\n  var dcName = dcDefs[dcI][0];\n  // A skill not learned yet is never wanted (#173): reset like a lower tier.\n  var dcOff = D.isOff && D.isOff(dcName);\n  var dcWant = dcDefs[dcI][1] >= dcLevel && !dcOff;\n  var dcHad = dcDefs[dcI][1] >= dcOld && !dcOff;\n  var dcRelax = dcDefs[dcI][3];\n  if (dcWant && (dcResync || !dcHad)) {\n    dcQueue.push(\"curing priority defence \" + dcName + \" \" + dcDefs[dcI][2]);\n  } else if (!dcWant && (dcResync || dcHad)) {\n    dcQueue.push(\"curing priority defence \" + dcName + \" reset\");\n    // relax: true sends RELAX <name>; a string is the defence's own off\n    // command (distortaura goes down with NORMALAURA).\n    if (dcRelax) dcQueue.push(typeof dcRelax == \"string\" ? dcRelax : \"relax \" + dcName);\n  }\n}\n\n// Retired defences: reset once per table (defcon_retired remembers which).\nvar dcRet = {};\ntry { dcRet = JSON.parse(get_variable(\"defcon_retired\") || \"{}\") || {}; } catch (e) { dcRet = {}; }\nvar dcRetDone = dcRet[D.tbl.name] || [];\nfor (var dcR = 0; dcR < (D.retired || []).length; dcR++) {\n  if (dcRetDone.indexOf(D.retired[dcR]) < 0) {\n    dcQueue.push(\"curing priority defence \" + D.retired[dcR] + \" reset\");\n    dcRetDone.push(D.retired[dcR]);\n  }\n}\ndcRet[D.tbl.name] = dcRetDone;\nset_variable(\"defcon_retired\", JSON.stringify(dcRet));\n\nD.levels[D.tbl.name] = dcLevel;\nD.level = dcLevel;\nset_variable(\"defcon_levels\", JSON.stringify(D.levels));\nif (D.timer) { clearTimeout(D.timer); D.timer = null; }\nD.queue = dcQueue;\n\nvar dcNote = D.tbl.known ? \"\" : \" (\" + D.tbl.name + \" not configured yet: general defences only)\";\nif (dcQueue.length === 0) {\n  display_notice(\"[defcon] DEFCON \" + dcLevel + \": no changes\" + dcNote + \".\", \"cyan\");\n} else {\n  display_notice(\"[defcon] DEFCON \" + dcLevel + \": applying \" + dcQueue.length + \" changes\" + dcNote + \"...\", \"cyan\");\n  run_function(\"defcon_drain\", [], \"defcon\");\n}\n// The table or level may have changed: tell loom (#176, the Self tab).\nif (client.loom.notify) client.loom.notify(\"defcon\");\n"
  },
  {
   "type": "function",
   "name": "defcon_drain",
   "enabled": true,
   "code": "// defcon_drain -- sends the queued curing changes one every 250ms.\nvar D = client.loom.defcon;\nif (D.queue.length === 0) {\n  D.timer = null;\n  display_notice(\"[defcon] change complete.\", \"lime\");\n} else {\n  send_command(D.queue.shift());\n  D.timer = setTimeout(function () {\n    run_function(\"defcon_drain\", [], \"defcon\");\n  }, 250);\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_aftermorph",
   "enabled": true,
   "code": "// defcon_aftermorph -- the morph DEFCON INIT asked for has completed: send the\n// class's \"aftermorph\" commands, once. Run from the metamorphosis line and\n// from a Morph charstat change.\nvar D = client.loom.defcon;\nif (D && D.afterMorph) {\n  var dcAm = D.afterMorph.cmds;\n  D.afterMorph = null;\n  for (var dcI = 0; dcI < dcAm.length; dcI++) send_command(dcAm[dcI]);\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_edit",
   "enabled": true,
   "code": "// defcon_edit -- the player's own changes to the current class's table,\n// from D.edit = { verb, words, rest } (set by the DEFCON alias):\n//   add <def> <tier> <priority> [relax | <off command>]\n//   set <def> <tier> [priority]\n//   remove <def>        reset <def>        reset all\n//   init add <cmd>      init remove <cmd | number>\n//   aftermorph add <cmd>   aftermorph remove <cmd | number>\n// Only the changes are stored (defcon_custom, per table name), laid over\n// the defaults by defcon_table. A change reaches curing at once at the\n// current level, if one has been set in this class.\nvar D = client.loom.defcon;\nvar E = D.edit || {};\nvar C = \"cyan\";\nvar dcSay = (t, c) => display_notice(\"[defcon] \" + t, c || C);\nrun_function(\"defcon_table\", [], \"defcon\");\nvar dcOld = D.tbl;\nvar dcName = dcOld.name;\nif (!D.custom[dcName]) D.custom[dcName] = {};\nvar M = D.custom[dcName];\nif (!M.defs) M.defs = {};\nvar dcW = E.words || [];\nvar dcOk = false;\n\nvar dcFind = (n) => { for (var i = 0; i < dcOld.defs.length; i++) { if (dcOld.defs[i][0] === n) return dcOld.defs[i]; } return null; };\nvar dcInBase = (n) => { for (var i = 0; i < dcOld.base.defs.length; i++) { if (dcOld.base.defs[i][0] === n) return dcOld.base.defs[i]; } return null; };\nvar dcValidName = (n) => /^[a-z][a-z0-9_']*$/.test(n || \"\");\n\nif (E.verb === \"add\") {\n  // add <def> <tier> <priority> [relax | <off command>]\n  var dcN = dcW[0], dcT = parseInt(dcW[1], 10), dcP = parseInt(dcW[2], 10);\n  var dcRel = String(E.rest || \"\").replace(/^\\s*\\S+\\s+\\S+\\s+\\S+\\s*/, \"\").replace(/^[\"']|[\"']$/g, \"\").trim();\n  if (!dcValidName(dcN) || !(dcT >= 1 && dcT <= 5) || !(dcP >= 1 && dcP <= 25)) {\n    dcSay(\"DEFCON ADD <defence> <tier 1-5> <priority 1-25> [RELAX | off command], e.g. DEFCON ADD toughness 4 10.\", \"orange\");\n  } else {\n    var dcRow = [dcT, dcP];\n    if (dcRel) dcRow.push(dcRel === \"relax\" ? true : dcRel);\n    var dcBa = dcInBase(dcN);\n    // The same as the default: nothing to store (an earlier change is undone).\n    if (dcBa && JSON.stringify(dcBa.slice(1)) === JSON.stringify(dcRow)) delete M.defs[dcN];\n    else M.defs[dcN] = dcRow;\n    dcOk = true;\n    dcSay(dcN + \" added to \" + dcName + \" at tier \" + dcT + \", priority \" + dcP + (dcRel ? (dcRel === \"relax\" ? \", relaxed below it\" : \", turned off with '\" + dcRel + \"' below it\") : \"\") + \".\", \"lime\");\n  }\n}\nelse if (E.verb === \"set\") {\n  var dcN2 = dcW[0], dcT2 = parseInt(dcW[1], 10);\n  var dcCur = dcFind(dcN2);\n  var dcP2 = dcW[2] !== undefined ? parseInt(dcW[2], 10) : (dcCur ? dcCur[2] : NaN);\n  if (!dcCur) {\n    dcSay(dcN2 ? dcN2 + \" isn't in the \" + dcName + \" table. DEFCON ADD adds one; DEFCON LIST shows them.\" : \"DEFCON SET <defence> <tier 1-5> [priority 1-25].\", \"orange\");\n  } else if (!(dcT2 >= 1 && dcT2 <= 5) || !(dcP2 >= 1 && dcP2 <= 25)) {\n    dcSay(\"DEFCON SET <defence> <tier 1-5> [priority 1-25].\", \"orange\");\n  } else {\n    var dcRow2 = [dcT2, dcP2];\n    if (dcCur[3]) dcRow2.push(dcCur[3]);\n    var dcB = dcInBase(dcN2);\n    // Back to exactly the default: no change left to store.\n    if (dcB && JSON.stringify(dcB.slice(1)) === JSON.stringify(dcRow2)) delete M.defs[dcN2];\n    else M.defs[dcN2] = dcRow2;\n    dcOk = true;\n    dcSay(dcN2 + \" in \" + dcName + \": tier \" + dcT2 + \", priority \" + dcP2 + \".\", \"lime\");\n  }\n}\nelse if (E.verb === \"remove\") {\n  var dcN3 = dcW[0];\n  if (!dcN3) { dcSay(\"DEFCON REMOVE <defence>.\", \"orange\"); }\n  else if (!dcFind(dcN3)) { dcSay(dcN3 + \" isn't in the \" + dcName + \" table.\", \"orange\"); }\n  else {\n    // A default stays out (null); one the player added is simply forgotten.\n    if (dcInBase(dcN3)) M.defs[dcN3] = null; else delete M.defs[dcN3];\n    dcOk = true;\n    dcSay(dcN3 + \" removed from \" + dcName + \". DEFCON RESET \" + dcN3 + \" brings the default back.\", \"lime\");\n  }\n}\nelse if (E.verb === \"reset\") {\n  var dcN4 = dcW[0];\n  if (dcN4 === \"all\") {\n    delete D.custom[dcName];\n    M = null;\n    dcOk = true;\n    dcSay(dcName + \" is back to the default table: all your changes for it are gone.\", \"lime\");\n  } else if (!dcN4) {\n    dcSay(\"DEFCON RESET <defence>, or DEFCON RESET ALL for the whole \" + dcName + \" table.\", \"orange\");\n  } else if (!M.defs.hasOwnProperty(dcN4)) {\n    dcSay(dcN4 + \" has no change of yours in \" + dcName + \".\", \"orange\");\n  } else {\n    delete M.defs[dcN4];\n    dcOk = true;\n    dcSay(dcN4 + \" in \" + dcName + \" is back to \" + (dcInBase(dcN4) ? \"the default.\" : \"not being kept (it isn't a default).\"), \"lime\");\n  }\n}\nelse if (E.verb === \"init\" || E.verb === \"aftermorph\") {\n  // init|aftermorph add <cmd> / remove <cmd | number from DEFCON LIST>\n  var dcKey = E.verb;\n  var dcBaseList = dcKey === \"init\" ? dcOld.base.init : dcOld.base.aftermorph;\n  var dcList = dcKey === \"init\" ? dcOld.init : dcOld.aftermorph;\n  var dcLabel = dcKey === \"init\" ? \"DEFCON INIT\" : \"after the morph\";\n  var dcOp = dcW[0];\n  var dcCmd = String(E.rest || \"\").replace(/^\\s*\\S+\\s*/, \"\").trim();\n  if (!M[dcKey]) M[dcKey] = { add: [], remove: [] };\n  var L = M[dcKey];\n  if (dcOp === \"add\" && dcCmd) {\n    var dcRmAt = L.remove.indexOf(dcCmd);\n    if (dcRmAt >= 0) L.remove.splice(dcRmAt, 1);\n    else if (dcList.indexOf(dcCmd) < 0) L.add.push(dcCmd);\n    dcOk = true;\n    dcSay(\"'\" + dcCmd + \"' sent \" + dcLabel + \" for \" + dcName + \".\", \"lime\");\n  } else if (dcOp === \"remove\" && dcCmd) {\n    if (/^\\d+$/.test(dcCmd)) dcCmd = dcList[parseInt(dcCmd, 10) - 1] || dcCmd;\n    if (dcList.indexOf(dcCmd) < 0) {\n      dcSay(\"'\" + dcCmd + \"' isn't sent \" + dcLabel + \" for \" + dcName + \". DEFCON LIST numbers them.\", \"orange\");\n    } else {\n      var dcAddAt = L.add.indexOf(dcCmd);\n      if (dcAddAt >= 0) L.add.splice(dcAddAt, 1);\n      if (dcBaseList.indexOf(dcCmd) >= 0 && L.remove.indexOf(dcCmd) < 0) L.remove.push(dcCmd);\n      dcOk = true;\n      dcSay(\"'\" + dcCmd + \"' no longer sent \" + dcLabel + \" for \" + dcName + \".\", \"lime\");\n    }\n  } else {\n    dcSay(\"DEFCON \" + dcKey.toUpperCase() + \" ADD <command>, or DEFCON \" + dcKey.toUpperCase() + \" REMOVE <command | number from DEFCON LIST>.\", \"orange\");\n  }\n  if (L.add.length === 0 && L.remove.length === 0) delete M[dcKey];\n}\n\nif (dcOk) {\n  // Tidy: drop an empty entry, then save.\n  if (M) {\n    var dcEmpty = true;\n    for (var dcX in M.defs) { if (M.defs.hasOwnProperty(dcX)) dcEmpty = false; }\n    if (dcEmpty) delete M.defs;\n    if (!M.defs && !M.init && !M.aftermorph) delete D.custom[dcName];\n  }\n  set_variable(\"defcon_custom\", JSON.stringify(D.custom));\n\n  // Bring curing in line at the current level: compare old and new tables.\n  run_function(\"defcon_table\", [], \"defcon\");\n  var dcLvl = D.level;\n  if (dcLvl !== undefined && dcLvl !== null) {\n    var dcNew = D.tbl, dcNames = {}, dcQ = [];\n    var dcRowOf = (t, n) => { for (var i = 0; i < t.defs.length; i++) { if (t.defs[i][0] === n) return t.defs[i]; } return null; };\n    for (var dcI2 = 0; dcI2 < dcOld.defs.length; dcI2++) dcNames[dcOld.defs[dcI2][0]] = true;\n    for (var dcI3 = 0; dcI3 < dcNew.defs.length; dcI3++) dcNames[dcNew.defs[dcI3][0]] = true;\n    for (var dcD in dcNames) {\n      if (!dcNames.hasOwnProperty(dcD)) continue;\n      var dcO = dcRowOf(dcOld, dcD), dcNw = dcRowOf(dcNew, dcD);\n      var dcOffD = D.isOff && D.isOff(dcD);\n      var dcWas = !!(dcO && dcO[1] >= dcLvl) && !dcOffD, dcIs = !!(dcNw && dcNw[1] >= dcLvl) && !dcOffD;\n      if (dcIs && (!dcWas || dcO[2] !== dcNw[2])) dcQ.push(\"curing priority defence \" + dcD + \" \" + dcNw[2]);\n      else if (!dcIs && dcWas) {\n        dcQ.push(\"curing priority defence \" + dcD + \" reset\");\n        var dcRx = dcO[3];\n        if (dcRx) dcQ.push(typeof dcRx == \"string\" ? dcRx : \"relax \" + dcD);\n      }\n    }\n    if (dcQ.length) {\n      D.queue = (D.queue || []).concat(dcQ);\n      if (!D.timer) run_function(\"defcon_drain\", [], \"defcon\");\n    }\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_list",
   "enabled": true,
   "code": "// defcon_list -- DEFCON LIST: the current class's table by tier, with\n// curing priorities; the player's own entries marked with *, the init and\n// after-morph commands numbered (for DEFCON INIT REMOVE <n>).\nvar D = client.loom.defcon;\nvar C = \"cyan\";\nrun_function(\"defcon_table\", [], \"defcon\");\nvar T = D.tbl;\nvar dcLvl = (D.level === undefined || D.level === null) ? 5 : D.level;\nvar dcAny = false;\nfor (var dcM in T.mine) { if (T.mine.hasOwnProperty(dcM)) dcAny = true; }\ndcAny = dcAny || T.removed.length > 0 || T.initMine.length > 0 || T.afterMine.length > 0\n  || ((D.custom[T.name] || {}).init || {}).remove || ((D.custom[T.name] || {}).aftermorph || {}).remove;\ndisplay_notice(\"[defcon] \" + T.name + (T.known ? \"\" : \" (general defences)\") + \" at DEFCON \" + dcLvl + \". tier: defence (priority)\" + (dcAny ? \", * = yours\" : \"\"), C);\nfor (var dcT = 1; dcT <= 5; dcT++) {\n  var dcRow = [];\n  for (var dcI = 0; dcI < T.defs.length; dcI++) {\n    var dcD = T.defs[dcI];\n    if (dcD[1] === dcT) dcRow.push((T.mine[dcD[0]] ? \"*\" : \"\") + dcD[0] + \" (\" + dcD[2] + (dcD[3] ? \", off below\" : \"\") + (D.isOff && D.isOff(dcD[0]) ? \", not learned\" : \"\") + \")\");\n  }\n  display_notice(\"  \" + dcT + (dcT >= dcLvl ? \" kept  \" : \" down  \") + (dcRow.join(\", \") || \"-\"), dcT >= dcLvl ? \"lime\" : C);\n}\nif (T.removed.length) display_notice(\"  removed by you: \" + T.removed.join(\", \"), C);\nvar dcCmds = (label, list, mine) => {\n  if (!list.length) return;\n  var out = [];\n  for (var i = 0; i < list.length; i++) out.push((i + 1) + \". \" + (mine.indexOf(list[i]) >= 0 ? \"*\" : \"\") + list[i]);\n  display_notice(\"  \" + label + \": \" + out.join(\"   \"), C);\n};\ndcCmds(\"DEFCON INIT\", T.init, T.initMine);\ndcCmds(\"after the morph\", T.aftermorph, T.afterMine);\nif (dcAny) display_notice(\"  DEFCON EXPORT prints this table to share; DEFCON RESET ALL drops your changes.\", C);\n"
  },
  {
   "type": "function",
   "name": "defcon_export",
   "enabled": true,
   "code": "// defcon_export -- DEFCON EXPORT: the current class's whole table, as it\n// is with the player's changes, in the class-file format\n// (packages/defcon/classes/<class>.js). Pasted into an issue, it can become\n// the new default as it is; the player's changes are marked in comments.\nvar D = client.loom.defcon;\nrun_function(\"defcon_table\", [], \"defcon\");\nvar T = D.tbl;\nvar dcQ = (s) => JSON.stringify(String(s));\nvar dcLines = [];\ndcLines.push(\"// \" + T.name + \": exported with DEFCON EXPORT (defcon \" + ((client.loom.registry.defcon || {}).version || \"?\") + \").\");\nif (T.removed.length) dcLines.push(\"// Removed from the default: \" + T.removed.join(\", \") + \".\");\nvar dcCustom = D.custom[T.name] || {};\nvar dcCmdRm = [].concat(((dcCustom.init || {}).remove) || [], ((dcCustom.aftermorph || {}).remove) || []);\nif (dcCmdRm.length) dcLines.push(\"// Commands removed from the default: \" + dcCmdRm.join(\"; \") + \".\");\ndcLines.push(\"D.classes[\" + dcQ(T.name) + \"] = {\");\nvar dcList = (key, list, mine) => {\n  if (!list.length && key !== \"init\") return;\n  var out = [];\n  for (var i = 0; i < list.length; i++) out.push(dcQ(list[i]));\n  dcLines.push(\"  \" + key + \": [\" + out.join(\", \") + \"],\" + (list.some((c) => mine.indexOf(c) >= 0) ? \"  // has yours\" : \"\"));\n};\ndcList(\"init\", T.init, T.initMine);\ndcList(\"aftermorph\", T.aftermorph, T.afterMine);\ndcLines.push(\"  defs: [\");\nfor (var dcI = 0; dcI < T.defs.length; dcI++) {\n  var dcD = T.defs[dcI];\n  var dcRow = \"    [\" + dcQ(dcD[0]) + \", \" + dcD[1] + \", \" + dcD[2] + (dcD[3] ? \", \" + (dcD[3] === true ? \"true\" : dcQ(dcD[3])) : \"\") + \"]\";\n  dcRow += (dcI < T.defs.length - 1 ? \",\" : \"\");\n  if (T.mine[dcD[0]]) dcRow += \"  // \" + T.mine[dcD[0]];\n  dcLines.push(dcRow);\n}\ndcLines.push(\"  ]\");\ndcLines.push(\"};\");\n\ndisplay_notice(\"[defcon] \" + T.name + \" table, ready to paste into an issue on github.com/neijel-achaea/loom:\", \"cyan\");\nvar dcHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nif (dcHtml) {\n  var dcEsc = (t) => t.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre;color:#9fc9c9\">' + dcEsc(dcLines.join(\"\\n\")) + '</span>');\n} else {\n  for (var dcJ = 0; dcJ < dcLines.length; dcJ++) display_notice(dcLines[dcJ], \"#9fc9c9\");\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_help",
   "enabled": true,
   "code": "// defcon_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[defcon] defence readiness: one level, five tiers. Commands:\";\n// Whether the current class has its own table, and which classes do.\nvar dcD = client.loom.defcon || {};\nvar dcKnown = [];\nfor (var dcK in (dcD.classes || {})) dcKnown.push(dcK);\nvar dcName = dcD.cls ? ((dcD.alias && dcD.alias[dcD.cls]) || dcD.cls) : \"\";\nvar dcClassNote = \"Classes set up: \" + dcKnown.join(\", \") + \".\"\n  + (dcName && !(dcD.classes && dcD.classes[dcName]) ? \" \" + dcD.cls + \" isn't one yet: you get the general defences.\" : \"\");\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"DEFCON\", \"status\"],\n  [\"DEFCON 1-5\", \"keep defences of that tier and above in curing (5 = fewest, 1 = all), for your current class\"],\n  [\"DEFCON LIST\", \"your class's defences by tier, with curing priority; * marks your own changes\"],\n  [\"DEFCON INIT\", \"send your class's init commands now (stance, summons, weapons...)\"],\n  [\"DEFCON INIT AUTO ON|OFF\", \"send them when you log in\"],\n  [\"Your own table, for the class you're in:\"],\n  [\"DEFCON ADD <def> <tier> <prio> [RELAX]\", \"add a defence (RELAX, or the command that turns it off, drops it below its tier)\"],\n  [\"DEFCON SET <def> <tier> [prio]\", \"change one\"],\n  [\"DEFCON REMOVE <def>\", \"stop keeping one, even a default\"],\n  [\"DEFCON RESET <def>|ALL\", \"back to the default\"],\n  [\"DEFCON INIT ADD|REMOVE <cmd>\", \"change the init commands (REMOVE also takes the number from DEFCON LIST)\"],\n  [\"DEFCON AFTERMORPH ADD|REMOVE <cmd>\", \"commands sent once the init morph completes\"],\n  [\"DEFCON EXPORT\", \"print the whole table to share, in the class-file format\"],\n  [\"DEFCON ON|OFF\", \"the game's defence upkeep (CURING DEFENCES ON/OFF)\"],\n  [\"DEFCON DEBUG\", \"internal state\"],\n  [\"Each class keeps its own level and changes, as the game keeps its own curing list (dragonform counts as one class). Default fixes still reach you, except where you changed that entry.\"],\n  [dcClassNote]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_status",
   "enabled": true,
   "code": "var D = client.loom.defcon;\nrun_function(\"defcon_table\", [], \"defcon\");\ndisplay_notice(\"[defcon] DEFCON \" + ((D.level === null || D.level === undefined) ? \"5 (default, not applied yet in this class)\" : D.level)\n  + \", class \" + D.tbl.name + (D.tbl.known ? \"\" : \" (not configured yet: general defences)\")\n  + \", init at login \" + String(get_variable(\"defcon_autoinit\")).toUpperCase() + \". DEFCON HELP for commands.\", \"cyan\");\n// Skill defences left out (#173).\nvar dcOffL = [];\nfor (var dcSi = 0; dcSi < D.tbl.defs.length; dcSi++) { if (D.isOff && D.isOff(D.tbl.defs[dcSi][0])) dcOffL.push(D.tbl.defs[dcSi][0]); }\n// A check that ended without asking anything (no answers in time) proves\n// nothing: said as such, not as \"all learned\".\nvar dcSl = D.skillLast;\nvar dcSkOk = dcSl && (dcSl.asked > 0 || dcSl.how === \"no skills\");\ndisplay_notice(\"[defcon] \" + (dcOffL.length ? \"not learned yet, left out of curing: \" + dcOffL.join(\", \") + \".\"\n  : (!dcSl ? \"skills not checked yet: DEFCON INIT checks them.\"\n  : (dcSkOk ? \"every skill defence in the table is learned.\"\n  : \"the skill check got no answers from the game (\" + dcSl.how + \"): DEFCON INIT tries again.\"))), \"cyan\");\n"
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// DEFCON [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.defcon || !client.loom.defcon.classes) run_function(\"defcon_setup\", [], \"defcon\");\nvar D = client.loom.defcon;\nvar dcRaw = String(args[1] || \"\").trim().toLowerCase();\nvar dcParts = dcRaw.split(/\\s+/);\nvar dcSub = dcParts[0];\nvar dcVal = dcParts[1] || \"\";\n// Everything after the subcommand, for commands that take free text.\nvar dcRest = dcRaw.replace(/^\\S+\\s*/, \"\");\nvar C = \"cyan\";\n\nif (dcSub === \"\" || dcSub === \"status\") {\n  run_function(\"defcon_status\", [], \"defcon\");\n}\nelse if (dcSub === \"help\") {\n  run_function(\"defcon_help\", [], \"defcon\");\n}\nelse if (/^[1-5]$/.test(dcSub)) {\n  D.want = parseInt(dcSub, 10);\n  run_function(\"defcon_set\", [], \"defcon\");\n}\nelse if (/^\\d+$/.test(dcSub)) {\n  display_notice(\"[defcon] levels go from 1 (all defences) to 5 (fewest).\", \"orange\");\n}\nelse if (dcSub === \"init\" && (dcVal === \"add\" || dcVal === \"remove\")) {\n  D.edit = { verb: \"init\", words: dcParts.slice(1), rest: dcRest };\n  run_function(\"defcon_edit\", [], \"defcon\");\n}\nelse if (dcSub === \"aftermorph\") {\n  D.edit = { verb: \"aftermorph\", words: dcParts.slice(1), rest: dcRest };\n  run_function(\"defcon_edit\", [], \"defcon\");\n}\nelse if (dcSub === \"init\" && dcVal === \"auto\") {\n  // DEFCON INIT AUTO ON|OFF.\n  var dcOnOff = dcParts[2] || \"\";\n  if (dcOnOff === \"on\" || dcOnOff === \"off\") {\n    set_variable(\"defcon_autoinit\", dcOnOff);\n    display_notice(\"[defcon] init at login \" + dcOnOff.toUpperCase() + \": your class's init commands \" + (dcOnOff === \"on\" ? \"are\" : \"aren't\") + \" sent when you log in.\", \"lime\");\n  } else {\n    display_notice(\"[defcon] init at login is \" + String(get_variable(\"defcon_autoinit\")).toUpperCase() + \". DEFCON INIT AUTO ON or OFF.\", C);\n  }\n}\nelse if (dcSub === \"init\") {\n  // DEFCON INIT: send the class's init commands now.\n  run_function(\"defcon_up\", [], \"defcon\");\n}\nelse if (dcSub === \"add\" || dcSub === \"set\" || dcSub === \"remove\" || dcSub === \"reset\") {\n  D.edit = { verb: dcSub, words: dcParts.slice(1), rest: dcRest };\n  run_function(\"defcon_edit\", [], \"defcon\");\n}\nelse if (dcSub === \"export\") {\n  run_function(\"defcon_export\", [], \"defcon\");\n}\nelse if (dcSub === \"on\" || dcSub === \"off\") {\n  send_command(\"curing defences \" + dcSub);\n  display_notice(\"[defcon] defence upkeep \" + dcSub.toUpperCase() + \".\", \"lime\");\n}\nelse if (dcSub === \"list\") {\n  run_function(\"defcon_list\", [], \"defcon\");\n}\nelse if (dcSub === \"debug\") {\n  display_notice(\"[defcon] cls=\" + D.cls + \" upDone=\" + D.upDone + \" levels=\" + JSON.stringify(D.levels) + \" custom=\" + JSON.stringify(D.custom) + \" queue=\" + JSON.stringify(D.queue) + \" timer=\" + (D.timer ? \"running\" : \"none\"), C);\n}\nelse {\n  display_notice(\"[defcon] unknown command '\" + dcSub + \"'. DEFCON HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^defcon(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
