{
 "type": "group",
 "name": "defcon",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"defcon_setup\", [], \"defcon\");\ndisplay_notice(\"[defcon] installed. DEFCON HELP for commands.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is uninstalled"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"defcon_setup\", [], \"defcon\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.defcon || !client.loom.defcon.classes) run_function(\"defcon_setup\", [], \"defcon\");\nvar D = client.loom.defcon;\nif (args.gmcp_method == \"Char.Status\" && args.gmcp_args.class) {\n  var dcWas = D.cls;\n  D.cls = args.gmcp_args.class;\n  if (get_variable(\"defcon_class\") !== D.cls) set_variable(\"defcon_class\", D.cls);\n  // A class change (dragonform included): the game has already loaded that\n  // class's curing list, so just say what level it was left at.\n  if (dcWas && dcWas !== D.cls && D.upDone) {\n    run_function(\"defcon_table\", [], \"defcon\");\n    display_notice(\"[defcon] \" + D.tbl.name + \": \" + ((D.level === undefined || D.level === null) ? \"no DEFCON level set in this class yet.\" : \"DEFCON \" + D.level + \".\"), \"cyan\");\n  }\n  // First class message of the session: raise defences if DEFCON AUTOUP is on.\n  if (!D.upDone) {\n    D.upDone = true;\n    if (get_variable(\"defcon_autoup\") == \"on\") run_function(\"defcon_up\", [], \"defcon\");\n  }\n}\n\n// Morph (Druid, Sentinel), from charstats: a change completes a pending\n// DEFCON UP morph (defcon_aftermorph).\nif (args.gmcp_method == \"Char.Vitals\" && args.gmcp_args.charstats) {\n  var dcStats = args.gmcp_args.charstats, dcMorph = null;\n  for (var dcS = 0; dcS < dcStats.length; dcS++) {\n    var dcMs = String(dcStats[dcS]).match(/^Morph:\\s*(.+)$/);\n    if (dcMs) dcMorph = dcMs[1];\n  }\n  if (dcMorph !== null && dcMorph !== D.morph) {\n    D.morph = dcMorph;\n    // Only the form DEFCON UP asked for (or, if it named none, any form):\n    // the first reading after a load is often \"None\".\n    if (D.afterMorph && (D.afterMorph.want ? dcMorph.toLowerCase() == D.afterMorph.want : !/^none$/i.test(dcMorph))) run_function(\"defcon_aftermorph\", [], \"defcon\");\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_setup",
   "enabled": true,
   "code": "// defcon_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Namespace, registry, class tables, defaults.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.defcon) client.loom.defcon = {};\nclient.loom.registry.defcon = { version: \"0.3.27\", keyword: \"DEFCON\", desc: \"Defence readiness for any class: five tiers, raised on login\" };\n\nvar D = client.loom.defcon;\n\n// Class tables: defcon_classes.js and classes/*.js.\nrun_function(\"defcon_classes\", [], \"defcon\");\n\nif (!D.queue) D.queue = [];\n\n// Class: followed from GMCP in onGMCP, and kept in defcon_class because the\n// game sends Char.Status only at login and on a change. The first time,\n// loom's old activeClass seeds it (read only).\nif (!D.cls) D.cls = get_variable(\"defcon_class\") || get_variable(\"activeClass\") || \"\";\nif (D.cls && !get_variable(\"defcon_class\")) set_variable(\"defcon_class\", D.cls);\n\n// DEFCON UP on the first class message of each session (the old package sent\n// INITDEF on every load). On unless switched off.\nif (!get_variable(\"defcon_autoup\")) set_variable(\"defcon_autoup\", \"on\");\n"
  },
  {
   "type": "function",
   "name": "defcon_classes",
   "enabled": true,
   "code": "// defcon_classes -- the class tables, built from this file and classes/*.js\n// (one file per class; see classes/README.md). Run from defcon_setup.\n//\n// Per class, in classes/<class>.js, named exactly as GMCP sends the class:\n//   up   -- commands DEFCON UP sends for this class, before the common ones\n//   defs -- [defence, tier, curing priority, relax?]. A defence is kept up at\n//           DEFCON n when its tier >= n. \"relax\" defences are also dropped\n//           (RELAX <def>) when the level no longer wants them.\n// A class with no file gets D.generic for its defences and only D.common\n// for DEFCON UP.\nvar D = client.loom.defcon;\nD.classes = {};\n// Every dragon colour shares the dragonform table.\nD.alias = { \"Black Dragon\": \"Dragon\", \"Blue Dragon\": \"Dragon\", \"Red Dragon\": \"Dragon\", \"Green Dragon\": \"Dragon\", \"Silver Dragon\": \"Dragon\", \"Gold Dragon\": \"Dragon\" };\n\n// Defences taken out of every table. DEFCON resets their curing priority\n// once per table, so a priority set by an older version doesn't keep the\n// game recasting them. Rebounding: it needs recasting so often that you do\n// little else (#156). Curseward: the same, needs constant recasting.\nD.retired = [\"rebounding\", \"curseward\"];\n\n// Sent by DEFCON UP for every class, after the class's own commands.\nD.common = [\"selfishness\", \"avoid physical\", \"insomnia\"];\n\n// Defences for a class with no table yet: the general ones every class above shares.\nD.generic = [\n  [\"alertness\", 1, 10, true],\n  [\"vigilance\", 1, 10, true],\n  [\"hypersight\", 1, 9, true],\n  [\"telesense\", 1, 10, true],\n  [\"metawake\", 1, 9, true],\n  [\"mass\", 2, 8],\n  [\"heldbreath\", 2, 20],\n  [\"fangbarrier\", 3, 8],\n  [\"deafness\", 3, 4],\n  [\"blindness\", 3, 4],\n  [\"kola\", 3, 3],\n  [\"levitating\", 3, 15],\n  [\"speed\", 3, 5],\n  [\"poisonresist\", 3, 8],\n  [\"nightsight\", 4, 13],\n  [\"deathsight\", 4, 18],\n  [\"thirdeye\", 3, 5],\n  [\"insomnia\", 2, 6],\n  [\"selfishness\", 2, 17],\n  [\"mindseye\", 5, 1],\n  [\"temperance\", 3, 8]\n];\n\n// Alchemist: DEFCON UP commands and defences. See classes/README.md.\n// Sulphur and mercury (EDUCE, 350 mana each, equilibrium) make health and\n// mana elixirs heal more; they wear off and are re-educed. Not kept:\n// tin (500 mana, reflects two attacks: a hunting key instead), lead\n// (density: the mass salve covers it), extispicy (needs a rat corpse).\nD.classes[\"Alchemist\"] = {\n  up: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"sulphur\", 3, 12],\n    [\"mercury\", 3, 14]\n  ]\n};\n\n// Apostate: DEFCON UP commands and defences. See classes/README.md.\n// DEFCON UP summons the Baalzadeen first (demon armour needs it), then the\n// daegger, masks the Baalzadeen and wields the daegger. Everything waits for\n// equilibrium in order, so the wield comes after the summon.\n// Demon armour costs the Baalzadeen 300 health, lifevision 600 mana once:\n// neither drains, so both are kept from DEFCON 4. Lifevision mostly guards\n// against adventurers (thieves), but costs nothing to keep up.\nD.classes[\"Apostate\"] = {\n  up: [\"queue add eq summon baalzadeen\", \"queue add eq summon daegger\", \"queue add eq mask\", \"queue add eq wield daegger\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"demonarmour\", 4, 10],\n    [\"lifevision\", 4, 13]\n  ]\n};\n\n// Bard: DEFCON UP commands and defences. See classes/README.md.\n// Tempo is a footwork setting, not a defence: DEFCON UP sets MODERATO on\n// balance, and it can be changed by hand at any time. Blade tune (balance)\n// and grip (balance, keeps weapons from being knocked away) are free once up.\n// Acrobatics (harder to hit) drains endurance heavily and doesn't seem to\n// help against denizens: full alert only. Balancing (harder to knock down)\n// drains mana. Both are relaxed below DEFCON 1.\n// Composition's movements only last while a song plays, and Sagas has no\n// self defence, so neither adds anything here.\nD.classes[\"Bard\"] = {\n  up: [\"queue add bal tempo moderato\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"tune\", 4, 10],\n    [\"gripping\", 4, 12],\n    [\"acrobatics\", 1, 11, true],\n    [\"balancing\", 1, 14, true]\n  ]\n};\n\n// Blademaster: DEFCON INIT commands and defences. See classes/README.md.\n// DEFCON UP positions the scabbard (the First Art needs it, every login),\n// enters the Shin trance and takes the Doya stance, on the balance queue.\n// Defaults: the generic defences plus gripping and toughness. Unconfirmed\n// Shindo and Striking defences are suggestions in classes/README.md.\nD.classes[\"Blademaster\"] = {\n  up: [\"queue add bal position scabbard\", \"queue add bal shin trance\", \"queue add bal doya\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"gripping\", 4, 12],\n    [\"toughness\", 4, 10]\n  ]\n};\n\n// Depthswalker: defences. See classes/README.md.\n// Defaults: the generic defences. The shadow cloak and scythe persist\n// across sessions, so nothing is sent on DEFCON UP. The Terminus\n// intonements (after embracing) are suggestions in classes/README.md.\nD.classes[\"Depthswalker\"] = {\n  up: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8]\n  ]\n};\n\n// Dragon: DEFCON UP commands and defences. See classes/README.md.\n// Every dragon colour uses this table (D.alias in defcon_classes.js).\n// Same tiers as the generic table (the README's questions). Own defences:\n// dragonarmour (500 mana, then drains willpower and endurance: 3, relaxed\n// below it) and dragonbreath (SUMMON, 300 mana once: 4).\nD.classes[\"Dragon\"] = {\n  up: [\"dragonarmour\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"insulation\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"dragonbreath\", 4, 10],\n    [\"dragonarmour\", 3, 5, true],\n    [\"temperance\", 3, 8]\n  ]\n};\n\n// Druid: DEFCON UP commands and defences. See classes/README.md.\n// DEFCON UP morphs into a wyvern on equilibrium, last, since anything sent\n// while morphing breaks it (Neijel has truemorph, others may not). Once the\n// morph completes: embrace the spirit, summon fire, flail the staff.\nD.classes[\"Druid\"] = {\n  up: [\"queue add eq morph wyvern\"],\n  aftermorph: [\"queue add eq embrace spirit\", \"queue add eq summon fire\", \"flail staff\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"temperance\", 3, 12],\n    [\"vitality\", 4, 7],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"harmony\", 3, 11],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1]\n  ]\n};\n\n// Infernal: defences. See classes/README.md. Skills: Oppression,\n// Malignity, Weaponmastery.\n// Defaults: the generic defences plus resistance and gripping. The\n// hellforge activations are suggestions in classes/README.md until\n// confirmed. Soulshield is a battlerage key in hunting (F11).\nD.classes[\"Infernal\"] = {\n  up: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"resistance\", 4, 10],\n    [\"gripping\", 4, 12]\n  ]\n};\n\n// Jester: defences. See classes/README.md. Skills: Pranks, Tarot,\n// Puppetry. Nothing is sent on DEFCON UP (the blackjack stays wielded).\n// Slipperiness (no ongoing cost) and gripping at DEFCON 4; acrobatics\n// (endurance) and balancing (mana) only at 1, relaxed below. Arrowcatch is\n// a suggestion in classes/README.md. Fool is a hunting key (F11).\nD.classes[\"Jester\"] = {\n  up: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"slipperiness\", 4, 10],\n    [\"gripping\", 4, 12],\n    [\"acrobatics\", 1, 11, true],\n    [\"balancing\", 1, 14, true]\n  ]\n};\n\n// Magi: DEFCON UP commands and defences. See classes/README.md.\n// Simultaneity and the staff first.\nD.classes[\"Magi\"] = {\n  up: [\"queue add eq simultaneity\", \"wield staff\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"insulation\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"stoneskin\", 4, 10],\n    [\"diamondskin\", 4, 10],\n    [\"stonefist\", 3, 11, true],\n    [\"chargeshield\", 3, 15],\n    [\"temperance\", 3, 8]\n  ]\n};\n\n// Monk: DEFCON UP commands and defences. See classes/README.md.\n// Skills: Tekura, Kaido, Telepathy.\n// DEFCON UP takes the Eagle stance (EGS) on balance: the hunting combo\n// (sidekick, uppercut, uppercut) is built for it.\n// Toughness (less cutting damage), vitality (a big heal under 25% health;\n// only raised near full health and mana) and weathering (+1 constitution)\n// are free once up: DEFCON 4. Projectiles and dodging drain mana and\n// willpower: DEFCON 1, relaxed below. Bodyblock is a hunting toggle (F11).\nD.classes[\"Monk\"] = {\n  up: [\"queue add bal egs\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"toughness\", 4, 10],\n    [\"vitality\", 4, 7],\n    [\"weathering\", 4, 12],\n    [\"projectiles\", 1, 14, true],\n    [\"dodging\", 1, 15, true]\n  ]\n};\n\n// Occultist: defences. See classes/README.md. Skills: Occultism,\n// Domination, Tarot. Nothing is sent on DEFCON UP.\n// Astralvision (lifevision and deathsight in one) is free once up: DEFCON 4.\n// Distortaura (karma, then a steady mana drain) feeds back physical damage\n// and softens some denizen damage: DEFCON 1, taken down with NORMALAURA\n// below. Simulacrum and heartstone cost karma on every raise, so curing\n// doesn't keep them; simulacrum is a hunting panic key (F11).\nD.classes[\"Occultist\"] = {\n  up: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"astralvision\", 4, 13],\n    [\"distortaura\", 1, 14, \"normalaura\"]\n  ]\n};\n\n// Paladin: defences. See classes/README.md. Skills: Weaponmastery,\n// Excision, Valour. Nothing is sent on DEFCON UP.\n// Free once up (DEFCON 4): faith (resists cutting, blunt and some magic),\n// unbowed (a health surge when badly hurt, can stop one killing blow),\n// resistance (less magic damage), gripping and weathering (+1 con).\n// The Rite of Regeneration is a hunting key (F11). Fury stays out (500\n// willpower per re-enable).\nD.classes[\"Paladin\"] = {\n  up: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"faith\", 4, 10],\n    [\"unbowed\", 4, 11],\n    [\"resistance\", 4, 10],\n    [\"gripping\", 4, 12],\n    [\"weathering\", 4, 12]\n  ]\n};\n\n// Pariah: DEFCON UP commands and defences. See classes/README.md.\n// Skills: Memorium, Pestilence, Charnel (after embracing).\n// DEFCON UP lets your own blood onto the ritual blade (CRUX LET ME) on\n// equilibrium. Swarms persist, so nothing else is sent.\n// Free once up (DEFCON 4): shieldlogograph (TRACE SHIELD ME, damage\n// resistance by intelligence) and leechlogograph (TRACE LEECH ME, draws\n// out afflictions for five minutes). Resolve is a suggestion.\nD.classes[\"Pariah\"] = {\n  up: [\"queue add eq crux let me\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"shieldlogograph\", 4, 10],\n    [\"leechlogograph\", 4, 12]\n  ]\n};\n\n// Priest: DEFCON UP commands and defences. See classes/README.md.\n// Skills: Spirituality, Devotion, Zeal (after embracing).\n// DEFCON UP summons the angel (equilibrium), then summons and wields the\n// spiritual mace (balance), in that order.\n// Angel care heals your afflictions but drains angel power: DEFCON 1,\n// switched off (ANGEL CARE OFF) below. DEF name \"care\" unconfirmed.\n// Not kept: angel aura (drops when you move or attack, like the shield\n// tattoo), inspiration (short and costly), the room rites. The Zeal\n// blessings are suggestions until confirmed after embracing.\nD.classes[\"Priest\"] = {\n  up: [\"queue add eq angel summon\", \"queue add bal summon mace\", \"queue add bal wield mace\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"care\", 1, 13, \"angel care off\"]\n  ]\n};\n\n// Psion: defences. See classes/README.md. Skills: Weaving, Psionics,\n// Emulation. Nothing is sent on DEFCON UP (WEAVE PREPARE lasts until\n// changed).\n// Free once up (DEFCON 4): secondskin (WEAVE SECONDSKIN, resists every\n// damage type) and guidedstrike (ENACT GUIDEDSTRIKE, bigger critical hits).\n// Indomitability is a hunting panic key (F11): its images run out, so\n// curing would keep re-casting it.\nD.classes[\"Psion\"] = {\n  up: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"secondskin\", 4, 10],\n    [\"guidedstrike\", 4, 12]\n  ]\n};\n\n// Runewarden: defences. See classes/README.md. Skills: Weaponmastery,\n// Runelore, Discipline. Nothing is sent on DEFCON UP.\n// Free once up (DEFCON 4): resistance (less magic damage), gripping and\n// weathering (+1 constitution), as on the other knights.\n// Runes sketched on yourself (algiz, jera, berkana) don't show in DEF, so\n// curing can't keep them; fury stays out (500 willpower per re-enable).\n// Bulwark is a battlerage key (F11).\nD.classes[\"Runewarden\"] = {\n  up: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"resistance\", 4, 10],\n    [\"gripping\", 4, 12],\n    [\"weathering\", 4, 12]\n  ]\n};\n\n// Sentinel: DEFCON UP commands and defences. See classes/README.md.\n// Skills: Metamorphosis, Woodlore, Skirmishing.\n// DEFCON UP morphs into a jaguar on equilibrium, last, since anything sent\n// while morphing breaks it. Once the morph completes, it embraces the spirit\n// (less endurance loss in every spirit form). If the morph doesn't take,\n// morph by hand.\n// Free once up (DEFCON 4): barkskin (200 mana once, physical protection),\n// firstaid (wounds clot faster) and fleetness (faster through forests).\nD.classes[\"Sentinel\"] = {\n  up: [\"queue add eq morph jaguar\"],\n  aftermorph: [\"queue add eq embrace spirit\"],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"temperance\", 3, 8],\n    [\"barkskin\", 4, 10],\n    [\"firstaid\", 4, 12],\n    [\"fleetness\", 4, 14]\n  ]\n};\n\n// Sylvan: DEFCON UP commands and defences. See classes/README.md.\n// No class commands for DEFCON UP yet.\nD.classes[\"Sylvan\"] = {\n  up: [],\n  defs: [\n    [\"alertness\", 1, 10, true],\n    [\"vigilance\", 1, 10, true],\n    [\"hypersight\", 1, 9, true],\n    [\"telesense\", 1, 10, true],\n    [\"metawake\", 1, 9, true],\n    [\"mass\", 2, 8],\n    [\"heldbreath\", 2, 20],\n    [\"fangbarrier\", 3, 8],\n    [\"deafness\", 3, 4],\n    [\"blindness\", 3, 4],\n    [\"kola\", 3, 3],\n    [\"levitating\", 3, 15],\n    [\"speed\", 3, 5],\n    [\"poisonresist\", 3, 8],\n    [\"nightsight\", 4, 13],\n    [\"deathsight\", 4, 18],\n    [\"thirdeye\", 3, 5],\n    [\"insomnia\", 2, 6],\n    [\"selfishness\", 2, 17],\n    [\"mindseye\", 5, 1],\n    [\"barkskin\", 4, 10],\n    [\"temperance\", 3, 8]\n  ]\n};\n"
  },
  {
   "type": "function",
   "name": "defcon_table",
   "enabled": true,
   "code": "// defcon_table -- picks the table for the current class into D.tbl\n// ({ name, up, aftermorph, defs, known }) and that class's remembered level into D.level\n// (undefined: never applied in this class). Unknown classes get the generic\n// defences. Levels are kept per table name (defcon_levels), since the game\n// keeps a curing list per class: every dragon colour shares \"Dragon\".\nvar D = client.loom.defcon;\nvar dcKey = D.alias[D.cls] || D.cls;\nvar dcEntry = D.classes[dcKey];\nif (dcEntry) {\n  D.tbl = { name: dcKey, up: dcEntry.up, aftermorph: dcEntry.aftermorph || [], defs: dcEntry.defs, known: true };\n} else {\n  D.tbl = { name: D.cls || \"unknown\", up: [], aftermorph: [], defs: D.generic, known: false };\n}\n\nif (!D.levels) {\n  var dcRaw = get_variable(\"defcon_levels\");\n  D.levels = {};\n  if (dcRaw && typeof dcRaw == \"object\") D.levels = dcRaw;\n  else if (dcRaw) { try { D.levels = JSON.parse(dcRaw); } catch (e) { D.levels = {}; } }\n}\n// One-time migration: the old single defcon_level belongs to the class you\n// are in when it is first seen with a class known, then is cleared.\nvar dcOldLevel = get_variable(\"defcon_level\");\nif (dcOldLevel !== null && dcOldLevel !== undefined && D.cls) {\n  if (D.levels[D.tbl.name] === undefined) D.levels[D.tbl.name] = to_number(dcOldLevel);\n  set_variable(\"defcon_levels\", JSON.stringify(D.levels));\n  delete_variable(\"defcon_level\");\n}\nD.level = D.levels[D.tbl.name];\n"
  },
  {
   "type": "function",
   "name": "defcon_up",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.defcon || !client.loom.defcon.classes) run_function(\"defcon_setup\", [], \"defcon\");\nvar D = client.loom.defcon;\n// DEFCON UP: the common commands, then the class's own, last: anything sent\n// while morphing breaks the morph, so a class can end on one. Commands the\n// class lists in \"aftermorph\" wait for the morph to complete\n// (defcon_aftermorph, from the game's line or the Morph charstat).\nrun_function(\"defcon_table\", [], \"defcon\");\nvar dcCmds = D.common.concat(D.tbl.up);\nvar dcAfter = D.tbl.aftermorph || [];\nD.afterMorph = null;\nif (dcAfter.length) {\n  var dcWant = \"\";\n  for (var dcJ = 0; dcJ < D.tbl.up.length; dcJ++) {\n    var dcMm = String(D.tbl.up[dcJ]).match(/\\bmorph\\s+(\\w+)\\s*$/i);\n    if (dcMm) dcWant = dcMm[1].toLowerCase();\n  }\n  if (dcWant && String(D.morph || \"\").toLowerCase() == dcWant) {\n    // Already in that form: no morph to wait for.\n    var dcKeep = [];\n    for (var dcK = 0; dcK < dcCmds.length; dcK++) { if (!/\\bmorph\\s+\\w+\\s*$/i.test(dcCmds[dcK])) dcKeep.push(dcCmds[dcK]); }\n    dcCmds = dcKeep.concat(dcAfter);\n  } else {\n    D.afterMorph = { cmds: dcAfter.slice(), want: dcWant };\n  }\n}\nfor (var dcI = 0; dcI < dcCmds.length; dcI++) send_command(dcCmds[dcI]);\ndisplay_notice(\"[defcon] defences up for \" + D.tbl.name + (D.tbl.known ? \"\" : \" (class not configured yet: common defences only)\") + (D.afterMorph ? \"; the rest once the morph completes\" : \"\") + \".\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "defcon_set",
   "enabled": true,
   "code": "// defcon_set -- applies DEFCON D.want (1-5): curing priorities for every\n// defence of a tier >= the level, reset (and relax) for the rest. Setting the\n// level you are already at resends everything (a resync), as does the first\n// level set in a class. The level is remembered for the current class only.\nvar D = client.loom.defcon;\nrun_function(\"defcon_table\", [], \"defcon\");\nvar dcDefs = D.tbl.defs;\nvar dcFirst = (D.level === undefined || D.level === null);\nvar dcOld = dcFirst ? 5 : D.level;\nvar dcLevel = D.want;\nvar dcResync = (dcLevel === dcOld) || dcFirst;\nvar dcQueue = [];\n\nfor (var dcI = 0; dcI < dcDefs.length; dcI++) {\n  var dcName = dcDefs[dcI][0];\n  var dcWant = dcDefs[dcI][1] >= dcLevel;\n  var dcHad = dcDefs[dcI][1] >= dcOld;\n  var dcRelax = dcDefs[dcI][3];\n  if (dcWant && (dcResync || !dcHad)) {\n    dcQueue.push(\"curing priority defence \" + dcName + \" \" + dcDefs[dcI][2]);\n  } else if (!dcWant && (dcResync || dcHad)) {\n    dcQueue.push(\"curing priority defence \" + dcName + \" reset\");\n    // relax: true sends RELAX <name>; a string is the defence's own off\n    // command (distortaura goes down with NORMALAURA).\n    if (dcRelax) dcQueue.push(typeof dcRelax == \"string\" ? dcRelax : \"relax \" + dcName);\n  }\n}\n\n// Retired defences: reset once per table (defcon_retired remembers which).\nvar dcRet = {};\ntry { dcRet = JSON.parse(get_variable(\"defcon_retired\") || \"{}\") || {}; } catch (e) { dcRet = {}; }\nvar dcRetDone = dcRet[D.tbl.name] || [];\nfor (var dcR = 0; dcR < (D.retired || []).length; dcR++) {\n  if (dcRetDone.indexOf(D.retired[dcR]) < 0) {\n    dcQueue.push(\"curing priority defence \" + D.retired[dcR] + \" reset\");\n    dcRetDone.push(D.retired[dcR]);\n  }\n}\ndcRet[D.tbl.name] = dcRetDone;\nset_variable(\"defcon_retired\", JSON.stringify(dcRet));\n\nD.levels[D.tbl.name] = dcLevel;\nD.level = dcLevel;\nset_variable(\"defcon_levels\", JSON.stringify(D.levels));\nif (D.timer) { clearTimeout(D.timer); D.timer = null; }\nD.queue = dcQueue;\n\nvar dcNote = D.tbl.known ? \"\" : \" (\" + D.tbl.name + \" not configured yet: general defences only)\";\nif (dcQueue.length === 0) {\n  display_notice(\"[defcon] DEFCON \" + dcLevel + \": no changes\" + dcNote + \".\", \"cyan\");\n} else {\n  display_notice(\"[defcon] DEFCON \" + dcLevel + \": applying \" + dcQueue.length + \" changes\" + dcNote + \"...\", \"cyan\");\n  run_function(\"defcon_drain\", [], \"defcon\");\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_drain",
   "enabled": true,
   "code": "// defcon_drain -- sends the queued curing changes one every 250ms.\nvar D = client.loom.defcon;\nif (D.queue.length === 0) {\n  D.timer = null;\n  display_notice(\"[defcon] change complete.\", \"cyan\");\n} else {\n  send_command(D.queue.shift());\n  D.timer = setTimeout(function () {\n    run_function(\"defcon_drain\", [], \"defcon\");\n  }, 250);\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_aftermorph",
   "enabled": true,
   "code": "// defcon_aftermorph -- the morph DEFCON UP asked for has completed: send the\n// class's \"aftermorph\" commands, once. Run from the metamorphosis line and\n// from a Morph charstat change.\nvar D = client.loom.defcon;\nif (D && D.afterMorph) {\n  var dcAm = D.afterMorph.cmds;\n  D.afterMorph = null;\n  for (var dcI = 0; dcI < dcAm.length; dcI++) send_command(dcAm[dcI]);\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_help",
   "enabled": true,
   "code": "// defcon_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[defcon] defence readiness: one level, five tiers. Commands:\";\n// Whether the current class has its own table, and which classes do.\nvar dcD = client.loom.defcon || {};\nvar dcKnown = [];\nfor (var dcK in (dcD.classes || {})) dcKnown.push(dcK);\nvar dcName = dcD.cls ? ((dcD.alias && dcD.alias[dcD.cls]) || dcD.cls) : \"\";\nvar dcClassNote = \"Classes set up: \" + dcKnown.join(\", \") + \".\"\n  + (dcName && !(dcD.classes && dcD.classes[dcName]) ? \" \" + dcD.cls + \" isn't one yet: you get the general defences.\" : \"\");\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"DEFCON\", \"status\"],\n  [\"DEFCON 1-5\", \"keep defences of that tier and above in curing (5 = fewest, 1 = all), for your current class\"],\n  [\"DEFCON UP\", \"raise your class's defences now\"],\n  [\"DEFCON LIST\", \"defences per tier for your class, with curing priority\"],\n  [\"DEFCON AUTOUP ON|OFF\", \"DEFCON UP when you log in\"],\n  [\"DEFCON ON|OFF\", \"the game's defence upkeep (CURING DEFENCES ON/OFF)\"],\n  [\"DEFCON DEBUG\", \"internal state\"],\n  [\"Each class keeps its own level, as the game keeps its own curing list (dragonform counts as one class).\"],\n  [dcClassNote]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "function",
   "name": "defcon_status",
   "enabled": true,
   "code": "var D = client.loom.defcon;\nrun_function(\"defcon_table\", [], \"defcon\");\ndisplay_notice(\"[defcon] DEFCON \" + ((D.level === null || D.level === undefined) ? \"5 (default, not applied yet in this class)\" : D.level)\n  + \", class \" + D.tbl.name + (D.tbl.known ? \"\" : \" (not configured yet: general defences)\")\n  + \", autoup \" + String(get_variable(\"defcon_autoup\")).toUpperCase() + \". DEFCON HELP for commands.\", \"cyan\");\n"
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// DEFCON [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.defcon || !client.loom.defcon.classes) run_function(\"defcon_setup\", [], \"defcon\");\nvar D = client.loom.defcon;\nvar dcRaw = String(args[1] || \"\").trim().toLowerCase();\nvar dcParts = dcRaw.split(/\\s+/);\nvar dcSub = dcParts[0];\nvar dcVal = dcParts[1] || \"\";\nvar C = \"cyan\";\n\nif (dcSub === \"\" || dcSub === \"status\") {\n  run_function(\"defcon_status\", [], \"defcon\");\n}\nelse if (dcSub === \"help\") {\n  run_function(\"defcon_help\", [], \"defcon\");\n}\nelse if (/^[1-5]$/.test(dcSub)) {\n  D.want = parseInt(dcSub, 10);\n  run_function(\"defcon_set\", [], \"defcon\");\n}\nelse if (/^\\d+$/.test(dcSub)) {\n  display_notice(\"[defcon] levels go from 1 (all defences) to 5 (fewest).\", \"orange\");\n}\nelse if (dcSub === \"up\") {\n  run_function(\"defcon_up\", [], \"defcon\");\n}\nelse if (dcSub === \"on\" || dcSub === \"off\") {\n  send_command(\"curing defences \" + dcSub);\n  display_notice(\"[defcon] defence upkeep \" + dcSub.toUpperCase() + \".\", C);\n}\nelse if (dcSub === \"autoup\") {\n  if (dcVal === \"on\" || dcVal === \"off\") {\n    set_variable(\"defcon_autoup\", dcVal);\n    display_notice(\"[defcon] autoup \" + dcVal.toUpperCase() + \": defences \" + (dcVal === \"on\" ? \"go up\" : \"stay as they are\") + \" when you log in.\", C);\n  } else {\n    display_notice(\"[defcon] autoup is \" + String(get_variable(\"defcon_autoup\")).toUpperCase() + \". DEFCON AUTOUP ON or OFF.\", C);\n  }\n}\nelse if (dcSub === \"list\") {\n  run_function(\"defcon_table\", [], \"defcon\");\n  var dcLvl = D.level || 5;\n  display_notice(\"[defcon] \" + D.tbl.name + (D.tbl.known ? \"\" : \" (general defences)\") + \", tier: defence (priority)\", C);\n  for (var dcT = 1; dcT <= 5; dcT++) {\n    var dcRow = [];\n    for (var dcI = 0; dcI < D.tbl.defs.length; dcI++) {\n      if (D.tbl.defs[dcI][1] === dcT) dcRow.push(D.tbl.defs[dcI][0] + \" (\" + D.tbl.defs[dcI][2] + \")\");\n    }\n    display_notice(\"  \" + dcT + (dcT >= dcLvl ? \" up   \" : \" down \") + dcRow.join(\", \"), dcT >= dcLvl ? \"lime\" : C);\n  }\n}\nelse if (dcSub === \"debug\") {\n  display_notice(\"[defcon] cls=\" + D.cls + \" upDone=\" + D.upDone + \" levels=\" + JSON.stringify(D.levels) + \" queue=\" + JSON.stringify(D.queue) + \" timer=\" + (D.timer ? \"running\" : \"none\"), C);\n}\nelse {\n  display_notice(\"[defcon] unknown command '\" + dcSub + \"'. DEFCON HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^defcon(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
