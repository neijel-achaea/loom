{
 "type": "group",
 "name": "elementalism",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"elementalism_setup\", [], \"elementalism\");\ndisplay_notice(\"[elementalism] installed. ELEMENTALISM HELP for the illusions and set pieces.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; the elementalism_* variables are left intact.\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"elementalism_setup\", [], \"elementalism\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Your name for the set pieces, from Char.Name / Char.Status at login.\nvar elM = \"\";\nvar elA = null;\ntry { elM = args.gmcp_method; elA = args.gmcp_args; } catch (e) { elM = \"\"; }\nif ((elM === \"Char.Name\" || elM === \"Char.Status\") && elA) {\n  if (typeof elA === \"string\") { try { elA = JSON.parse(elA); } catch (e) { elA = null; } }\n  if (elA && elA.name) {\n    if (!client.loom || !client.loom.elementalism || !client.loom.elementalism.pronouns) run_function(\"elementalism_setup\", [], \"elementalism\");\n    var EL = client.loom.elementalism;\n    if (String(elA.name) !== EL.name) { EL.name = String(elA.name); set_variable(\"elementalism_name\", EL.name); }\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "elementalism_setup",
   "enabled": true,
   "code": "// elementalism_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, and the name and\n// pronouns the set pieces use.\n//\n// PINK_DRAGON's lines are built from EL.name and EL.pronouns[EL.pron] by the\n// script actions between its waits.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.elementalism) client.loom.elementalism = {};\nclient.loom.registry.elementalism = { version: \"0.2.0\", keyword: \"ELEMENTALISM\" };\nvar EL = client.loom.elementalism;\n\n// [object, possessive], as the set pieces use them.\nEL.pronouns = { he: [\"him\", \"his\"], she: [\"her\", \"her\"], they: [\"them\", \"their\"] };\nfunction elGet(n) { var v; try { v = get_variable(n); } catch (e) { v = undefined; } return (v === undefined || v === null || (\"\" + v) === \"undefined\") ? \"\" : \"\" + v; }\n// Your name, as the game sent it (Char.Name/Char.Status) or as set with\n// ELEMENTALISM NAME; the game sends it only at login, so it's kept.\nEL.name = elGet(\"elementalism_name\");\nEL.pron = elGet(\"elementalism_pronouns\");\nif (!EL.pronouns[EL.pron]) { EL.pron = \"he\"; set_variable(\"elementalism_pronouns\", \"he\"); }\n"
  },
  {
   "type": "function",
   "name": "elementalism_help",
   "enabled": true,
   "code": "// elementalism_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[elementalism] illusions and set pieces. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"ILLUSION MOSSTATTOO [target]\", \"a moss tattoo fading away, on you or a target\"],\n  [\"FEEL_<environment>\", \"a scent drifting in: desert, forest, grassland, hill, jungle, mountain, swamp, underground, valley, water\"],\n  [\"PINK_DRAGON\", \"the pink dragon transformation, five lines two seconds apart, with your name\"],\n  [\"KAWHEDRAGON_F|M <name> <1-11>\", \"the kawhe dragon, one step at a time, for someone else\"],\n  [\"ELEMENTALISM\", \"the name and pronouns the set pieces use\"],\n  [\"ELEMENTALISM NAME <name>\", \"your name, if the game hasn't sent it since you imported\"],\n  [\"ELEMENTALISM PRONOUNS HE|SHE|THEY\", \"the pronouns PINK_DRAGON uses (default he)\"],\n  [\"ELEMENTALISM DEBUG\", \"internal state\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "group",
   "name": "Illusions",
   "enabled": true,
   "items": [
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var illusionType = args[1];\nvar illusionTarget = args[2];\n\nswitch (illusionType) {\n  case \"mosstattoo\":\n    send_command(\"cast illusion \" + illusionTarget + \" A moss tattoo fades from view and disappears.\");\n    break;\n\n  default:\n    display_notice(\"[elementalism] Invalid Illusion\", \"orange\");\n}"
      }
     ],
     "text": "^illusion (\\w+) (\\w+)$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var illusionType = args[1];\n\nswitch (illusionType) {\n  case \"mosstattoo\":\n    send_command(\"cast illusion A moss tattoo fades from view and disappears.\");\n    break;\n\n  default:\n    display_notice(\"[elementalism] Invalid Illusion\", \"orange\");\n}"
      }
     ],
     "text": "^illusion (\\w+)$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "// PINK_DRAGON line 1 of 5: your name and pronouns from elementalism.\nvar E = (client.loom && client.loom.elementalism) || {};\nvar N = E.name || \"\";\nvar PR = (E.pronouns && E.pronouns[E.pron]) || [\"him\", \"his\"];\nvar O = PR[0], P = PR[1], Pc = P.charAt(0).toUpperCase() + P.slice(1);\nif (!N) { display_notice(\"[elementalism] PINK_DRAGON needs your name: log in once, or ELEMENTALISM NAME <name>.\", \"orange\"); } else send_command(\"cast illusion A pink light suddenly emanates from within \" + N + \", willing forth the Dragon within \" + O + \".\");\n"
      },
      {
       "type": "wait",
       "enabled": true,
       "seconds": 2,
       "milliseconds": 0
      },
      {
       "type": "script",
       "enabled": true,
       "script": "// PINK_DRAGON line 2 of 5: your name and pronouns from elementalism.\nvar E = (client.loom && client.loom.elementalism) || {};\nvar N = E.name || \"\";\nvar PR = (E.pronouns && E.pronouns[E.pron]) || [\"him\", \"his\"];\nvar O = PR[0], P = PR[1], Pc = P.charAt(0).toUpperCase() + P.slice(1);\nif (!N) { } else send_command(\"cast illusion The Pink light grows to blinding intensity as \" + N + \"'s body quickly changes into that of a powerful and massive Dragon.\");\n"
      },
      {
       "type": "wait",
       "enabled": true,
       "seconds": 2,
       "milliseconds": 0
      },
      {
       "type": "script",
       "enabled": true,
       "script": "// PINK_DRAGON line 3 of 5: your name and pronouns from elementalism.\nvar E = (client.loom && client.loom.elementalism) || {};\nvar N = E.name || \"\";\nvar PR = (E.pronouns && E.pronouns[E.pron]) || [\"him\", \"his\"];\nvar O = PR[0], P = PR[1], Pc = P.charAt(0).toUpperCase() + P.slice(1);\nif (!N) { } else send_command(\"cast illusion Reveling in \" + P + \" power, \" + N + \" beats \" + P + \" mighty wings, throws \" + P + \" massive head back, and roars a challenge as if to the world itself.\");\n"
      },
      {
       "type": "wait",
       "enabled": true,
       "seconds": 2,
       "milliseconds": 0
      },
      {
       "type": "script",
       "enabled": true,
       "script": "// PINK_DRAGON line 4 of 5: your name and pronouns from elementalism.\nvar E = (client.loom && client.loom.elementalism) || {};\nvar N = E.name || \"\";\nvar PR = (E.pronouns && E.pronouns[E.pron]) || [\"him\", \"his\"];\nvar O = PR[0], P = PR[1], Pc = P.charAt(0).toUpperCase() + P.slice(1);\nif (!N) { } else send_command(\"cast illusion The saucer-sized eyes of \" + N + \" close briefly in ominous concentration.\");\n"
      },
      {
       "type": "wait",
       "enabled": true,
       "seconds": 2,
       "milliseconds": 0
      },
      {
       "type": "script",
       "enabled": true,
       "script": "// PINK_DRAGON line 5 of 5: your name and pronouns from elementalism.\nvar E = (client.loom && client.loom.elementalism) || {};\nvar N = E.name || \"\";\nvar PR = (E.pronouns && E.pronouns[E.pron]) || [\"him\", \"his\"];\nvar O = PR[0], P = PR[1], Pc = P.charAt(0).toUpperCase() + P.slice(1);\nif (!N) { } else send_command(\"cast illusion With a low rumbling from deep within \" + P + \" belly, \" + N + \" utters a guttural chant. \" + Pc + \" skin ripples as a web of magical confetti dances like fire across its surface, settling to solidify into a flexible, delicious shell.\");\n"
      }
     ],
     "text": "^pink_dragon$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "send_command(\"cast illusion For a heartbeat the damp chamber grows dry and still, smelling of sunbaked stone.\");"
      }
     ],
     "text": "^feel_desert$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "send_command(\"cast illusion The scent of wet bark and moss drifts down the stair, as if carried from the woods above.\");"
      }
     ],
     "text": "^feel_forest$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "send_command(\"cast illusion A warm breath of air stirs the vines, fragrant with sun and tall grass.\");"
      }
     ],
     "text": "^feel_grassland$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "send_command(\"cast illusion A soft wind sighs down the stair, smelling of heather and bayberry, and carries with it the lonely cry of a circling hawk.\");"
      }
     ],
     "text": "^feel_hill$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "send_command(\"cast illusion The air grows thick and heavy with warmth, and the cry of some unseen bird echoes briefly from far away.\");"
      }
     ],
     "text": "^feel_jungle$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "send_command(\"cast illusion A thread of cold, clean air spills down from far overhead, sharp with the bite of snow.\");"
      }
     ],
     "text": "^feel_mountain$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "send_command(\"cast illusion A rich smell of peat and still water rises from the floor, and somewhere in the dark a frog croaks once.\");"
      }
     ],
     "text": "^feel_swamp$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "send_command(\"cast illusion The limestone walls hum with a deep, slow resonance, and for a moment the weight of the earth above feels less a burden than an embrace.\");"
      }
     ],
     "text": "^feel_underground$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "send_command(\"cast illusion A mild, sheltered warmth settles over the chamber, sweet with the scent of blossoming orchards.\");"
      }
     ],
     "text": "^feel_valley$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "send_command(\"cast illusion Somewhere beyond the limestone, the faint sound of running water rises and fades.\");"
      }
     ],
     "text": "^feel_water$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    }
   ]
  },
  {
   "type": "group",
   "name": "Complex Illusions",
   "enabled": true,
   "items": [
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var target = args[1];\nvar step = args[2];\nvar textStep = \"\";\n\nswitch (step) {\n  case \"1\":\n    textStep = \"Without breaking off mid-sentence, \" + target + \" dips the end of her quarterstaff into an enormous mug of kawhe and gives it two brisk stirs.\";\n    break;\n\n  case \"2\":\n    textStep = target + \" regards the enormous mug of kawhe for a long moment, then tips it back and drains the whole of it without pausing once for breath.\";\n    break;\n\n  case \"3\":\n    textStep = \"A rich brown light suddenly wells up from within \" + target + \", and the air about her turns thick with the scent of roasting beans.\";\n    break;\n\n  case \"4\":\n    textStep = \"The kawhe-dark glow deepens to a scalding intensity as \" + target + \"'s body swells and remakes itself into that of a powerful and massive Dragon.\";\n    break;\n\n  case \"5\":\n    textStep = \"Reveling in her power, \" + target + \" beats her mighty wings, throws her horned head back, and roars a challenge that rolls out over the world like steam from a spilt pot.\";\n    break;\n\n  case \"6\":\n    textStep = \"The saucer-sized eyes of \" + target + \" close briefly in ominous concentration, and twin curls of fragrant vapour drift up from her nostrils.\";\n    break;\n\n  case \"7\":\n    textStep = \"With a low percolating rumble from deep within her belly, \" + target + \" utters a guttural chant. Her skin ripples as a froth of golden cream races like fire across its surface, settling to solidify into a flexible, faintly steaming shell.\";\n    break;\n\n  case \"8\":\n    textStep = target + \" begins to flap her wings powerfully, and rises quickly up into the firmament.\";\n    break;\n\n  case \"9\":\n    textStep = \"LETHAL A massive shadow begins to circle in the skies above, trailing a plume of steam and the unmistakable smell of a fresh pot.\";\n    break;\n\n  case \"10\":\n    textStep = \"High above, \" + target + \" opens her glistening, tooth-lined maw wide and pours a great tempest of scalding kawhe down upon you, served black, unsweetened, and with no escape or reprieve.\";\n    break;\n\n  case \"11\":\n    textStep = target + \" touches down amid the wreckage, folds her wings, and licks a stray drop of kawhe from her muzzle with evident satisfaction.\";\n    break;\n}\n\nif (textStep != \"\") {\n  send_command(\"cast illusion \" + textStep);\n  display_notice(\"Step \" + step + \" out of 11.\");\n} else {\n  display_notice (\"Wrong step: \" + args[1]);\n}"
      }
     ],
     "text": "^kawhedragon_f (\\w+) (\\d+)$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "var target = args[1];\nvar step = args[2];\nvar textStep = \"\";\n\nswitch (step) {\n  case \"1\":\n    textStep = \"Without breaking off mid-sentence, \" + target + \" dips the end of his quarterstaff into an enormous mug of kawhe and gives it two brisk stirs.\";\n    break;\n\n  case \"2\":\n    textStep = target + \" regards the enormous mug of kawhe for a long moment, then tips it back and drains the whole of it without pausing once for breath.\";\n    break;\n\n  case \"3\":\n    textStep = \"A rich brown light suddenly wells up from within \" + target + \", and the air about him turns thick with the scent of roasting beans.\";\n    break;\n\n  case \"4\":\n    textStep = \"The kawhe-dark glow deepens to a scalding intensity as \" + target + \"'s body swells and remakes itself into that of a powerful and massive Dragon.\";\n    break;\n\n  case \"5\":\n    textStep = \"Reveling in his power, \" + target + \" beats his mighty wings, throws his horned head back, and roars a challenge that rolls out over the world like steam from a spilt pot.\";\n    break;\n\n  case \"6\":\n    textStep = \"The saucer-sized eyes of \" + target + \" close briefly in ominous concentration, and twin curls of fragrant vapour drift up from his nostrils.\";\n    break;\n\n  case \"7\":\n    textStep = \"With a low percolating rumble from deep within his belly, \" + target + \" utters a guttural chant. His skin ripples as a froth of golden cream races like fire across its surface, settling to solidify into a flexible, faintly steaming shell.\";\n    break;\n\n  case \"8\":\n    textStep = target + \" begins to flap his wings powerfully, and rises quickly up into the firmament.\";\n    break;\n\n  case \"9\":\n    textStep = \"LETHAL A massive shadow begins to circle in the skies above, trailing a plume of steam and the unmistakable smell of a fresh pot.\";\n    break;\n\n  case \"10\":\n    textStep = \"High above, \" + target + \" opens his glistening, tooth-lined maw wide and pours a great tempest of scalding kawhe down upon you, served black, unsweetened, and with no escape or reprieve.\";\n    break;\n\n  case \"11\":\n    textStep = target + \" touches down amid the wreckage, folds his wings, and licks a stray drop of kawhe from his muzzle with evident satisfaction.\";\n    break;\n}\n\nif (textStep != \"\") {\n  send_command(\"cast illusion \" + textStep);\n  display_notice(\"Step \" + step + \" out of 11.\");\n} else {\n  display_notice (\"Wrong step: \" + args[1]);\n}"
      }
     ],
     "text": "^kawhedragon_m (\\w+) (\\d+)$",
     "matching": "regexp",
     "whole_words": true,
     "case_sensitive": true,
     "prefix_suffix": true
    }
   ]
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#00e9ff",
     "highlight_bg": "#000000",
     "highlight": "match",
     "highlight_backref": ""
    }
   ],
   "text": "This area is unnaturally flooded with water.",
   "matching": "substring",
   "whole_words": false,
   "case_sensitive": true
