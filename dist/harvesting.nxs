{
 "type": "group",
 "name": "harvesting",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"harvesting_setup\", [], \"harvesting\");\ndisplay_notice(\"[harvesting] installed. HARVESTING ON to start, HARVESTING HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is uninstalled"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"harvesting_setup\", [], \"harvesting\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.harvesting || !client.loom.harvesting.plants) run_function(\"harvesting_setup\", [], \"harvesting\");\nvar H = client.loom.harvesting;\n// Harvesting follows the room itself: remember the environment and check what\n// needs harvesting here.\nif (args.gmcp_method == \"Room.Info\") {\n  H.here = String(args.gmcp_args.environment || \"\").toLowerCase();\n  // First room of the session with harvesting on: read the rift first. The\n  // room is checked again once the listing ends (trigger_rift_rule).\n  if (!H.started) {\n    H.started = true;\n    if (get_variable(\"harvesting_on\") == \"on\" && get_variable(\"pauseTriggers\") != \"on\") {\n      H.quiet = true;\n      send_command(\"ir herbs\");\n    }\n  }\n  // While a quiet rift listing is on its way, the room is checked when it ends.\n  if (!H.quiet) run_function(\"harvesting_room\", [], \"harvesting\");\n}\n"
  },
  {
   "type": "function",
   "name": "harvesting_setup",
   "enabled": true,
   "code": "// harvesting_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, migration, saved state.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.harvesting) client.loom.harvesting = {};\nclient.loom.registry.harvesting = { version: \"0.2.4\", keyword: \"HARVESTING\", desc: \"Harvests the plants your rift is short of as you walk the rooms\" };\nvar H = client.loom.harvesting;\n\n// Plants that grow in each environment (GMCP Room.Info environment, lower case).\nH.plants = {\n  forest:                [\"ginseng\", \"echinacea\", \"ginger\", \"burdock\", \"myrrh\", \"lobelia\", \"elm\"],\n  swamp:                 [\"ash\", \"bellwort\", \"cohosh\"],\n  \"natural underground\": [\"bloodroot\", \"irid\"],\n  hills:                 [\"hawthorn\", \"bayberry\"],\n  jungle:                [\"kuzu\", \"skullcap\", \"kola\"],\n  grasslands:            [\"slipper\", \"goldenseal\"],\n  mountain:              [\"valerian\"],\n  mountains:             [\"valerian\"],\n  desert:                [\"pear\", \"weed\"],\n  valley:                [\"sileris\"],\n  freshwater:            [\"kelp\"],\n  river:                 [\"kelp\"]\n};\n\n// One-time migration from the hv_* variables of harvesting 2.0, then cleared.\nvar hvOld = [\"hv_on\", \"hv_min\", \"hv_map\", \"hv_stock\"];\nvar hvNew = [\"harvesting_on\", \"harvesting_min\", \"harvesting_map\", \"harvesting_stock\"];\nfor (var hvI = 0; hvI < hvOld.length; hvI++) {\n  var hvOv = get_variable(hvOld[hvI]);\n  if (hvOv === null || hvOv === undefined) continue;\n  var hvNv = get_variable(hvNew[hvI]);\n  if (hvNv === null || hvNv === undefined) set_variable(hvNew[hvI], hvOv);\n  delete_variable(hvOld[hvI]);\n}\n\n// Saved state. Older saves hold JSON strings; newer ones objects.\nvar hvMin = get_variable(\"harvesting_min\");\nvar hvMap = get_variable(\"harvesting_map\");\nvar hvStock = get_variable(\"harvesting_stock\");\nH.min = (typeof hvMin == \"string\" ? JSON.parse(hvMin) : hvMin) || {};\n// Plant name -> name in the rift, where they differ. Learnt from INR lines too.\nH.map = (typeof hvMap == \"string\" ? JSON.parse(hvMap) : hvMap) || { myrrh: \"myrrh gum\" };\nH.stock = (typeof hvStock == \"string\" ? JSON.parse(hvStock) : hvStock) || {};\n\nif (!get_variable(\"harvesting_on\")) set_variable(\"harvesting_on\", \"off\");\nif (!to_number(get_variable(\"harvesting_default_min\"))) set_variable(\"harvesting_default_min\", 2000);\nH.defMin = to_number(get_variable(\"harvesting_default_min\"));\n\nif (!H.queue) H.queue = [];\nif (H.current === undefined) H.current = null;\nif (H.here === undefined) H.here = \"\";\nH.waitBal = false;\nH.inrFor = null;\nH.inRift = false;\nH.dashes = 0;\nif (H.quiet === undefined) H.quiet = false;\n\n// The read-only look other packages see through loom (#159, #46): what\n// harvesting knows about your stock, never its variables.\n//   look.levels() -> [{ plant, stock, min }] for every plant whose stock has\n//     been seen in the rift (IR/INR), min being its own or the default.\n//   look.plant(name) -> { stock, min, tracked } for a plant: tracked when\n//     harvesting knows it (it grows in one of its environments), stock null\n//     when not seen in the rift yet (#166)\nH.look = {\n  plant: function (name) {\n    var pl = String(name || \"\").trim().toLowerCase(), tracked = false;\n    for (var env in H.plants) { if (H.plants.hasOwnProperty(env) && H.plants[env].indexOf(pl) >= 0) { tracked = true; break; } }\n    var st = H.stock[H.map[pl] || pl];\n    return { stock: (st === undefined || st === null) ? null : st, min: (H.min[pl] != null ? H.min[pl] : H.defMin), tracked: tracked };\n  },\n  levels: function () {\n    var out = [], seen = {};\n    for (var env in H.plants) {\n      if (!H.plants.hasOwnProperty(env)) continue;\n      for (var i = 0; i < H.plants[env].length; i++) {\n        var pl = H.plants[env][i];\n        if (seen[pl]) continue;\n        seen[pl] = true;\n        var st = H.stock[H.map[pl] || pl];\n        if (st === undefined || st === null) continue;\n        out.push({ plant: pl, stock: st, min: (H.min[pl] != null ? H.min[pl] : H.defMin) });\n      }\n    }\n    return out;\n  }\n};\nif (client.loom.notify) client.loom.notify(\"harvesting\");\n"
  },
  {
   "type": "function",
   "name": "harvesting_save",
   "enabled": true,
   "code": "var H = client.loom.harvesting;\nset_variable(\"harvesting_min\", H.min);\nset_variable(\"harvesting_map\", H.map);\nset_variable(\"harvesting_stock\", H.stock);\n// Stock and minimums are what harvesting's look reports (#46): tell loom,\n// guarded (harvesting works without it).\nif (client.loom.notify) client.loom.notify(\"harvesting\");\n"
  },
  {
   "type": "function",
   "name": "harvesting_room",
   "enabled": true,
   "code": "// harvesting_room -- on entering a room: queue the plants of this environment\n// that are below their minimum stock and start harvesting.\nif (!client.loom || !client.loom.harvesting || !client.loom.harvesting.plants) run_function(\"harvesting_setup\", [], \"harvesting\");\nvar H = client.loom.harvesting;\nH.queue = [];\nH.current = null;\nH.waitBal = false;\nif (get_variable(\"harvesting_on\") == \"on\" && get_variable(\"pauseTriggers\") != \"on\") {\n  var hvList = H.plants[H.here] || [];\n  for (var hvI = 0; hvI < hvList.length; hvI++) {\n    var hvP = hvList[hvI];\n    var hvHave = H.stock[H.map[hvP] || hvP] || 0;\n    var hvMin = (H.min[hvP] != null) ? H.min[hvP] : H.defMin;\n    if (hvHave < hvMin) H.queue.push(hvP);\n  }\n  if (H.queue.length) run_function(\"harvesting_next\", [], \"harvesting\");\n}\n"
  },
  {
   "type": "function",
   "name": "harvesting_next",
   "enabled": true,
   "code": "var H = client.loom.harvesting;\nH.waitBal = false;\nif (H.queue.length == 0) {\n  H.current = null;\n} else {\n  H.current = H.queue.shift();\n  send_command(\"harvest \" + H.current);\n}\n"
  },
  {
   "type": "function",
   "name": "harvesting_status",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.harvesting || !client.loom.harvesting.plants) run_function(\"harvesting_setup\", [], \"harvesting\");\nvar H = client.loom.harvesting;\nvar hvOut = [];\nvar hvSeen = {};\nfor (var hvEnv in H.plants) {\n  var hvList = H.plants[hvEnv];\n  for (var hvI = 0; hvI < hvList.length; hvI++) {\n    var hvP = hvList[hvI];\n    if (hvSeen[hvP]) continue;\n    hvSeen[hvP] = true;\n    var hvHave = H.stock[H.map[hvP] || hvP];\n    var hvMin = (H.min[hvP] != null) ? H.min[hvP] : H.defMin;\n    if (hvHave == null || hvHave < hvMin) hvOut.push(hvP + \" \" + (hvHave == null ? \"?\" : hvHave) + \"/\" + hvMin);\n  }\n}\ndisplay_notice(\"[harvesting] \" + (get_variable(\"harvesting_on\") == \"on\" ? \"ON\" : \"OFF\") + \", default minimum \" + H.defMin + \", environment here: \" + (H.here || \"?\") + \". HARVESTING HELP for commands.\", \"cyan\");\ndisplay_notice(hvOut.length ? \"[harvesting] below minimum: \" + hvOut.join(\", \") : \"[harvesting] everything at or above its minimum.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "harvesting_help",
   "enabled": true,
   "code": "// harvesting_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[harvesting] harvests and stores plants below their minimum rift stock as you walk. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"HARVESTING\", \"status: what is below its minimum\"],\n  [\"HARVESTING ON|OFF\", \"ON also re-reads your rift (IR HERBS)\"],\n  [\"HARVESTING MIN <n>\", \"default minimum for every plant\"],\n  [\"HARVESTING MIN <plant> <n>\", \"minimum for one plant (DEFAULT to go back to the default)\"],\n  [\"HARVESTING STOCK\", \"re-read your rift now\"],\n  [\"HARVESTING RESET\", \"clear the queue, reload saved state\"],\n  [\"HARVESTING DEBUG\", \"internal state\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "Harvesting control",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// HARVESTING [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.harvesting || !client.loom.harvesting.plants) run_function(\"harvesting_setup\", [], \"harvesting\");\nvar H = client.loom.harvesting;\nvar hvA = String(args[1] || \"\").toLowerCase().trim().split(/\\s+/);\nvar C = \"cyan\";\nif (hvA[0] === \"\" || hvA[0] === \"status\") {\n  run_function(\"harvesting_status\", [], \"harvesting\");\n} else if (hvA[0] === \"help\") {\n  run_function(\"harvesting_help\", [], \"harvesting\");\n} else if (hvA[0] === \"on\") {\n  set_variable(\"harvesting_on\", \"on\");\n  H.quiet = true;\n  send_command(\"ir herbs\");\n  display_notice(\"[harvesting] ON: reading your rift stock.\", \"lime\");\n} else if (hvA[0] === \"off\") {\n  set_variable(\"harvesting_on\", \"off\");\n  H.queue = [];\n  H.current = null;\n  H.waitBal = false;\n  display_notice(\"[harvesting] OFF.\", \"lime\");\n} else if (hvA[0] === \"stock\") {\n  send_command(\"ir herbs\");\n} else if (hvA[0] === \"min\" && hvA.length == 2 && /^\\d+$/.test(hvA[1])) {\n  H.defMin = parseInt(hvA[1], 10);\n  set_variable(\"harvesting_default_min\", H.defMin);\n  if (client.loom.notify) client.loom.notify(\"harvesting\");\n  display_notice(\"[harvesting] default minimum: \" + H.defMin + \".\", \"lime\");\n} else if (hvA[0] === \"min\" && hvA.length == 3 && (hvA[2] === \"default\" || /^\\d+$/.test(hvA[2]))) {\n  if (hvA[2] === \"default\") delete H.min[hvA[1]];\n  else H.min[hvA[1]] = parseInt(hvA[2], 10);\n  run_function(\"harvesting_save\", [], \"harvesting\");\n  display_notice(\"[harvesting] minimum for \" + hvA[1] + \": \" + (H.min[hvA[1]] != null ? H.min[hvA[1]] : H.defMin + \" (default)\") + \".\", \"lime\");\n} else if (hvA[0] === \"min\") {\n  display_notice(\"[harvesting] HARVESTING MIN <n>, or HARVESTING MIN <plant> <n|default>.\", \"orange\");\n} else if (hvA[0] === \"reset\") {\n  H.queue = [];\n  H.current = null;\n  H.quiet = false;\n  run_function(\"harvesting_setup\", [], \"harvesting\");\n  display_notice(\"[harvesting] reset: queue cleared, state reloaded from saved variables.\", \"lime\");\n} else if (hvA[0] === \"debug\") {\n  display_notice(\"[harvesting] here=\" + H.here + \" queue=\" + JSON.stringify(H.queue) + \" current=\" + H.current + \" waitBal=\" + H.waitBal + \" inRift=\" + H.inRift + \" quiet=\" + H.quiet + \" map=\" + JSON.stringify(H.map), C);\n} else {\n  display_notice(\"[harvesting] unknown command '\" + hvA[0] + \"'. HARVESTING HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^harvesting(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "Harvest success",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#00ffb3",
     "highlight_bg": "#000000",
     "highlight": "line",
     "highlight_backref": ""
    },
    {
     "type": "script",
     "enabled": true,
     "script": "if (get_variable(\"pauseTriggers\") != \"on\" && client.loom && client.loom.harvesting) {\n  var H = client.loom.harvesting;\n  if (H.current) {\n    H.inrFor = H.current;\n    H.waitBal = true;\n    send_command(\"queue add be inr \" + H.current);\n  }\n}\n"
    }
   ],
   "text": "^You reach out and carefully harvest (.*)\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Harvest failure",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#ff0074",
     "highlight_bg": "#000000",
     "highlight": "line",
     "highlight_backref": ""
    },
    {
     "type": "script",
     "enabled": true,
     "script": "if (get_variable(\"pauseTriggers\") != \"on\" && client.loom && client.loom.harvesting) {\n  var H = client.loom.harvesting;\n  if (H.current && !H.waitBal) run_function(\"harvesting_next\", [], \"harvesting\");\n}\n"
    }
   ],
   "text": "^(?:What do you wish to harvest\\?|That plant has been fully harvested\\.)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Balance recovered",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (get_variable(\"pauseTriggers\") != \"on\" && client.loom && client.loom.harvesting) {\n  var H = client.loom.harvesting;\n  if (H.waitBal) run_function(\"harvesting_next\", [], \"harvesting\");\n  else if (H.current) send_command(\"harvest \" + H.current);\n}\n"
    }
   ],
   "text": "^You have recovered balance on all limbs\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Rift store",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.harvesting || !client.loom.harvesting.plants) run_function(\"harvesting_setup\", [], \"harvesting\");\nvar H = client.loom.harvesting;\nH.stock[args[2]] = parseInt(args[3].replace(/,/g, \"\"), 10);\nif (H.inrFor) {\n  H.map[H.inrFor] = args[2];\n  H.inrFor = null;\n}\nrun_function(\"harvesting_save\", [], \"harvesting\");\n"
    }
   ],
   "text": "^You store ([\\d,]+) (.+), bringing the total in the rift to ([\\d,]+)\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Rift header",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.harvesting || !client.loom.harvesting.plants) run_function(\"harvesting_setup\", [], \"harvesting\");\nvar H = client.loom.harvesting;\nH.inRift = true;\nH.dashes = 0;\nif (H.quiet) gag_current_line();\n"
    }
   ],
   "text": "^Glancing into your rift, you see:$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Rift rule",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (client.loom && client.loom.harvesting && client.loom.harvesting.inRift) {\n  var H = client.loom.harvesting;\n  if (H.quiet) gag_current_line();\n  H.dashes++;\n  if (H.dashes >= 2) {\n    H.inRift = false;\n    if (H.quiet) {\n      H.quiet = false;\n      run_function(\"harvesting_room\", [], \"harvesting\");\n    }\n  }\n}\n"
    }
   ],
   "text": "^-{20,}$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Rift rows",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (client.loom && client.loom.harvesting && client.loom.harvesting.inRift) {\n  var H = client.loom.harvesting;\n  if (H.quiet) gag_current_line();\n  var hvRe = /\\[\\s*([\\d,]+)\\]\\s+(.+?)(?=\\s+\\[|\\s*$)/g;\n  var hvM;\n  while ((hvM = hvRe.exec(args[0])) !== null) {\n    H.stock[hvM[2]] = parseInt(hvM[1].replace(/,/g, \"\"), 10);\n  }\n  run_function(\"harvesting_save\", [], \"harvesting\");\n}\n"
    }
   ],
   "text": "^\\s*\\[\\s*[\\d,]+\\]\\s.*$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  }
 ],
 "description": "Harvests the plants your rift is short of as you walk the rooms"
}