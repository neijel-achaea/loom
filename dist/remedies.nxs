{
 "type": "group",
 "name": "remedies",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"remedies_setup\", [], \"remedies\");\ndisplay_notice(\"[remedies] installed. REMEDIES POT <pot> to set your pot, then REMEDIES CHECK or REMEDIES BREW. REMEDIES HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// The remedies_* variables are left intact.\nif (client.loom && client.loom.remedies) { client.loom.remedies.run = null; client.loom.remedies.reading = null; }\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"remedies\");\n  else delete client.loom.registry.remedies;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "run_function(\"remedies_setup\", [], \"remedies\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Remedies follows balance and equilibrium, and steps a run at each prompt.\nvar rmR = client.loom && client.loom.remedies;\nif (rmR && rmR.run && args.gmcp_method == \"Char.Vitals\") {\n  var rmG = (args.gmcp_args && typeof args.gmcp_args == \"object\") ? args.gmcp_args : {};\n  rmR.bal = rmG.bal != \"0\";\n  rmR.eq = rmG.eq != \"0\";\n  // After the packet's own lines, so an answer is seen first.\n  setTimeout(rmR.prompt, 0);\n}\n"
  },
  {
   "type": "function",
   "name": "remedies_setup",
   "enabled": true,
   "code": "// remedies_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, saved state, helpers.\n// Remedies is for the Remedies trade skill. Its first job (#436, Ricardo):\n// REMEDIES BREW tops every elixir and salve in your rift up to its target,\n// brewing in your pot and pouring into the rift, one step at a time, each\n// waiting for the game's answer to the one before; then it stops.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.remedies) client.loom.remedies = {};\nvar RM = client.loom.remedies;\n// busy (#318): true while a run has a command out, so Here's probe and\n// other packages wait their turn (and a run waits for theirs).\nclient.loom.registry.remedies = { version: \"0.1.1\", keyword: \"REMEDIES\", desc: \"Tops up the elixirs and salves in your rift: brews in your pot, pours, stops\", busy: function () {\n  var r = client.loom.remedies;\n  return !!(r && r.run && r.run.out && Date.now() - (r.run.sentAt || 0) < r.timeoutMs);\n} };\n\n// The game's numbers (Ricardo): 50 sips a unit, at most 20 units a brew.\nRM.sipsPerUnit = 50;\nRM.maxUnits = 20;\nRM.timeoutMs = 8000;      // an answer that never comes stops the run\n// Default targets: health and mana 2,000, everything else 1,000.\nRM.defaults = { health: 2000, mana: 2000 };\nRM.defaultTarget = 1000;\n\n// Saved state. A variable that isn't a readable table starts afresh (#135).\nRM.readTable = function (name) {\n  var v = get_variable(name);\n  if (typeof v == \"string\") { try { v = JSON.parse(v); } catch (e) { v = null; } }\n  return (v && typeof v == \"object\" && !Array.isArray(v)) ? v : {};\n};\n//   remedies_targets  { name: n }  your own targets (defaults otherwise)\n//   remedies_stock    { name: { n, kind: \"elixir\"|\"salve\" } }  the rift, as last read\n//   remedies_caps     { name: n }  the most the rift takes of one, learnt when a pour came up short\n//   remedies_pot      the pot you brew in, as you named it (pot123456)\nRM.targets = RM.readTable(\"remedies_targets\");\nRM.stock = RM.readTable(\"remedies_stock\");\nRM.caps = RM.readTable(\"remedies_caps\");\nRM.pot = String(get_variable(\"remedies_pot\") || \"\");\nRM.saveTable = function (name, t) {\n  var any = false;\n  for (var k in t) if (t.hasOwnProperty(k)) { any = true; break; }\n  try { if (any) set_variable(name, JSON.stringify(t)); else delete_variable(name); } catch (e) {}\n};\nRM.save = function () {\n  RM.saveTable(\"remedies_targets\", RM.targets);\n  RM.saveTable(\"remedies_stock\", RM.stock);\n  RM.saveTable(\"remedies_caps\", RM.caps);\n  if (client.loom.notify) client.loom.notify(\"remedies\");\n};\n\n// Runtime (never remembered: a reload ends a run).\nif (RM.run === undefined) RM.run = null;\nRM.bal = true;\nRM.eq = true;\nRM.reading = null;        // the IR listing being read: { kind, rule }\nRM.say = function (t, c) { display_notice(\"[remedies] \" + t, c || \"cyan\"); };\nRM.paused = function () { return get_variable(\"pauseTriggers\") == \"on\"; };\nRM.n = function (x) { return String(Math.round(x)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"); };\n\n// The level a remedy is topped up to: your target, never above the rift's cap.\nRM.targetOf = function (name) {\n  var t = RM.targets[name] != null ? RM.targets[name] : (RM.defaults[name] != null ? RM.defaults[name] : RM.defaultTarget);\n  if (RM.caps[name] != null && RM.caps[name] < t) t = RM.caps[name];\n  return t;\n};\n// Units to brew for one remedy, never overshooting its target.\nRM.unitsFor = function (name) {\n  var s = RM.stock[name];\n  if (!s) return 0;\n  var short = RM.targetOf(name) - s.n;\n  return short > 0 ? Math.floor(short / RM.sipsPerUnit) : 0;\n};\n// The plan from the stock as last read: [{ name, kind, units }].\nRM.plan = function () {\n  var out = [], kinds = [\"elixir\", \"salve\"];\n  for (var k = 0; k < kinds.length; k++) {\n    var names = [];\n    for (var nm in RM.stock) if (RM.stock.hasOwnProperty(nm) && RM.stock[nm].kind == kinds[k]) names.push(nm);\n    names.sort();\n    for (var i = 0; i < names.length; i++) {\n      var u = RM.unitsFor(names[i]);\n      if (u > 0) out.push({ name: names[i], kind: kinds[k], units: u });\n    }\n  }\n  return out;\n};\n// Is any other package waiting for an answer to something it sent (#318)?\nRM.othersBusy = function () {\n  var r = client.loom.registry || {};\n  for (var k in r) {\n    if (!r.hasOwnProperty(k) || k == \"remedies\" || !r[k] || typeof r[k].busy != \"function\") continue;\n    try { if (r[k].busy()) return k; } catch (e) {}\n  }\n  return \"\";\n};\n\n// ---- A run ---------------------------------------------------------------\n// RM.run = { dry, steps: [\"read elixir\", \"read salve\", then per remedy\n// \"brew\"/\"pour\"], plan, i (remedy), left (units still to brew for it),\n// out (what's waiting for an answer: \"read\"|\"brew\"|\"pour\"|\"\"), brewed\n// (units in the pot now), done: [{ name, units, sips }], skipped: [...],\n// sentAt, readQ [\"elixir\",\"salve\"] }.\nRM.start = function (dry) {\n  if (RM.run) { RM.say(\"a run is already under way. REMEDIES STOP ends it.\", \"orange\"); return; }\n  if (!dry && !RM.pot) { RM.say(\"set your pot first: REMEDIES POT <pot>, e.g. REMEDIES POT pot123456.\", \"orange\"); return; }\n  RM.run = { dry: !!dry, readQ: [\"elixir\", \"salve\"], plan: null, i: 0, left: 0, out: \"\", brewed: 0, done: [], skipped: [], full: [], sentAt: 0, potRetry: false };\n  RM.say(dry ? \"reading your rift to see what's short…\" : \"reading your rift, then brewing in \" + RM.pot + \"… REMEDIES STOP ends it.\", \"lime\");\n  RM.pump();\n};\nRM.stop = function (why, colour) {\n  if (!RM.run) return;\n  var r = RM.run;\n  RM.run = null;\n  RM.reading = null;\n  clearTimeout(RM.kickT);\n  if (why) RM.say(why, colour || \"orange\");\n  RM.summary(r);\n};\nRM.summary = function (r) {\n  if (r.dry || !r.plan) return;\n  var parts = [];\n  for (var i = 0; i < r.done.length; i++) parts.push(r.done[i].name + \" \" + RM.n(r.done[i].sips) + \" sips\");\n  var msg = parts.length ? \"brewed \" + parts.join(\", \") : \"nothing brewed\";\n  if (r.skipped.length) msg += \"; skipped \" + r.skipped.join(\", \");\n  if (r.full.length) msg += \"; rift full for \" + r.full.join(\", \");\n  RM.say(msg + \".\", parts.length ? \"lime\" : \"cyan\");\n};\n// Send the next command when nothing is waiting, at a prompt, with balance\n// and equilibrium, and no other package's answer still coming.\nRM.pump = function () {\n  var r = RM.run;\n  if (!r || r.out) return;\n  if (RM.paused() || !RM.bal || !RM.eq || RM.othersBusy()) return;\n  if (r.readQ.length) {\n    var kind = r.readQ.shift();\n    RM.reading = { kind: kind, rule: 0, own: true };\n    RM.send(\"read\", \"ir \" + kind);\n    return;\n  }\n  if (!r.plan) {\n    r.plan = RM.plan();\n    if (r.dry) {\n      var lines = [];\n      for (var p = 0; p < r.plan.length; p++) lines.push(r.plan[p].name + \" \" + r.plan[p].units + \" unit\" + (r.plan[p].units == 1 ? \"\" : \"s\"));\n      RM.run = null;\n      RM.say(lines.length ? \"to brew: \" + lines.join(\", \") + \". REMEDIES BREW to do it.\" : \"everything is at its target (or within 50 sips of it).\");\n      return;\n    }\n    if (!r.plan.length) { RM.run = null; RM.say(\"everything is at its target (or within 50 sips of it): nothing to brew.\"); return; }\n    r.i = 0; r.left = r.plan[0].units;\n  }\n  if (r.brewed > 0) { RM.send(\"pour\", \"pour \" + RM.pot + \" in rift\"); return; }\n  while (r.i < r.plan.length && r.left <= 0) { r.i++; if (r.i < r.plan.length) r.left = r.plan[r.i].units; }\n  if (r.i >= r.plan.length) { RM.stop(\"\", \"\"); return; }\n  var it = r.plan[r.i];\n  r.n = Math.min(RM.maxUnits, r.left);\n  RM.send(\"brew\", \"brew \" + r.n + \" \" + it.name + \" in \" + RM.pot);\n};\nRM.send = function (what, cmd) {\n  RM.run.out = what;\n  RM.run.sentAt = Date.now();\n  send_command(cmd);\n};\n// From onGMCP at each prompt (after its packet's lines).\nRM.prompt = function () {\n  var r = RM.run;\n  if (!r) return;\n  // A category with nothing in it may not list at all: stop waiting after 3 s.\n  if (r.out == \"read\" && Date.now() - r.sentAt > 3000) RM.listed();\n  if (r.out && Date.now() - r.sentAt > RM.timeoutMs) {\n    RM.reading = null;\n    RM.stop(\"no answer to \" + (r.out == \"read\" ? \"IR\" : r.out.toUpperCase()) + \" after \" + (RM.timeoutMs / 1000) + \" s: stopped.\");\n    return;\n  }\n  RM.pump();\n};\n// The next step after an answer. The prompt that came with the answer may\n// have been read before its lines (Vitals ahead of the text), and an idle\n// character gets no further prompt: so go on shortly after the answer\n// instead of waiting for one. Not after a brew: its balance recovery brings\n// a prompt, and the pour waits for it.\nRM.kick = function () {\n  clearTimeout(RM.kickT);\n  RM.kickT = setTimeout(function () { var R = client.loom.remedies; R.kickT = null; if (R.run) R.pump(); }, 150);\n};\nRM.cur = function () { var r = RM.run; return r && r.plan ? r.plan[r.i] : null; };\n\n// ---- Answers -------------------------------------------------------------\n// The rift listing: \"[ 947] frost [ 1443] health [ 958] immunity\".\nRM.row = function (text) {\n  var R = RM.reading;\n  if (!R) return false;\n  var re = /\\[\\s*([\\d,]+)\\]\\s+(.+?)(?=\\s+\\[|\\s*$)/g, m, any = false;\n  while ((m = re.exec(text)) !== null) {\n    RM.stock[m[2].toLowerCase()] = { n: parseInt(m[1].replace(/,/g, \"\"), 10), kind: R.kind };\n    any = true;\n  }\n  return any;\n};\nRM.rule = function () {\n  var R = RM.reading;\n  if (!R) return;\n  R.rule++;\n  if (R.rule >= 2) RM.listed();\n};\n// A listing ended (its second rule), or the game said the rift has none.\nRM.listed = function () {\n  RM.reading = null;\n  if (RM.run && RM.run.out == \"read\") { RM.run.out = \"\"; RM.save(); RM.kick(); }\n};\n// \"You place your ingredients into …, leaving you with ….\"\nRM.brewed = function () {\n  var r = RM.run;\n  if (!r || r.out != \"brew\") return false;\n  r.out = \"\";\n  r.brewed = r.n;\n  r.left -= r.n;\n  r.potRetry = false;\n  return true;\n};\n// \"You carefully pour N sips of X from … into your rift, bringing the total\n// stored sips to M.\"\nRM.poured = function (sips, total) {\n  var r = RM.run, it = RM.cur();\n  if (!r || r.out != \"pour\" || !it) return false;\n  r.out = \"\";\n  var want = r.brewed * RM.sipsPerUnit;\n  r.brewed = 0;\n  RM.stock[it.name] = { n: total, kind: it.kind };\n  var d = null;\n  for (var i = 0; i < r.done.length; i++) if (r.done[i].name == it.name) d = r.done[i];\n  if (!d) { d = { name: it.name, sips: 0 }; r.done.push(d); }\n  d.sips += sips;\n  if (sips < want) {\n    // The rift took less than the pot held: that's its cap for this one.\n    RM.caps[it.name] = total;\n    RM.save();\n    RM.stop(\"the rift took only \" + sips + \" of \" + want + \" sips of \" + it.name + \" (its limit is \" + RM.n(total) + \"; your target now stops there). \" + (want - sips) + \" sips are still in \" + RM.pot + \": use or empty them before brewing again.\");\n    return true;\n  }\n  RM.save();\n  RM.kick();\n  return true;\n};\n// \"Your rift is already full.\"\nRM.full = function () {\n  var r = RM.run, it = RM.cur();\n  if (!r || r.out != \"pour\" || !it) return false;\n  r.out = \"\";\n  RM.caps[it.name] = RM.stock[it.name] ? RM.stock[it.name].n : 0;\n  RM.save();\n  RM.stop(\"your rift is already full of \" + it.name + \" (\" + RM.n(RM.caps[it.name]) + \"; your target now stops there). \" + (r.brewed * RM.sipsPerUnit) + \" sips are still in \" + RM.pot + \".\");\n  return true;\n};\n// \"<pot> is empty.\" in answer to our pour: nothing was in it.\nRM.empty = function () {\n  var r = RM.run;\n  if (!r || r.out != \"pour\") return false;\n  r.out = \"\";\n  r.brewed = 0;\n  RM.kick();\n  return true;\n};\n// \"That pot already contains X!\": pour it into the rift first, then brew again.\nRM.potFull = function (what) {\n  var r = RM.run;\n  if (!r || r.out != \"brew\") return false;\n  r.out = \"\";\n  if (r.potRetry) { RM.stop(RM.pot + \" still holds \" + what + \": empty it, then REMEDIES BREW again.\"); return true; }\n  r.potRetry = true;\n  // Pour whatever it is; the pour line says what and how much.\n  r.brewed = 0;\n  r.out = \"pourOld\";\n  r.sentAt = Date.now();\n  RM.say(RM.pot + \" already holds \" + what + \": pouring it into your rift first.\");\n  send_command(\"pour \" + RM.pot + \" in rift\");\n  return true;\n};\n// Which remedy a pour line's \"an elixir of mana\" is: the known name in it.\nRM.whichIs = function (what) {\n  var t = \" \" + String(what || \"\").toLowerCase().replace(/[^a-z]+/g, \" \") + \" \";\n  for (var k in RM.stock) if (RM.stock.hasOwnProperty(k) && t.indexOf(\" \" + k + \" \") >= 0) return k;\n  return \"\";\n};\n// The answer to that first pour (any pour line, rift full, or empty). What\n// went in counts towards its remedy: the plan for it shrinks.\nRM.oldPoured = function (ok, total, what) {\n  var r = RM.run;\n  if (!r || r.out != \"pourOld\") return false;\n  r.out = \"\";\n  var k = ok && total !== undefined ? RM.whichIs(what) : \"\";\n  if (k) {\n    RM.stock[k].n = total;\n    RM.save();\n    for (var i = r.i; r.plan && i < r.plan.length; i++) {\n      if (r.plan[i].name != k) continue;\n      var u = RM.unitsFor(k);\n      if (i == r.i) r.left = Math.min(r.left, u); else r.plan[i].units = u;\n    }\n  }\n  if (!ok) { RM.stop(RM.pot + \" still holds something the rift won't take: empty it, then REMEDIES BREW again.\"); }\n  else RM.kick();\n  return true;\n};\n// \"You lack the required ingredients to brew that.\": skip it, go on.\nRM.noIngredients = function () {\n  var r = RM.run, it = RM.cur();\n  if (!r || r.out != \"brew\" || !it) return false;\n  r.out = \"\";\n  r.skipped.push(it.name + \" (no ingredients)\");\n  r.left = 0;\n  RM.kick();\n  return true;\n};\n// \"That is not a pot.\"\nRM.notPot = function () {\n  var r = RM.run;\n  if (!r || (r.out != \"brew\" && r.out != \"pour\" && r.out != \"pourOld\")) return false;\n  r.out = \"\";\n  RM.stop(RM.pot + \" is not a pot: set yours with REMEDIES POT <pot>.\");\n  return true;\n};\n"
  },
  {
   "type": "function",
   "name": "remedies_help",
   "enabled": true,
   "code": "// remedies_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[remedies] tops up the elixirs and salves in your rift: brews in your pot, pours into the rift, then stops. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"REMEDIES\", \"your pot, and each remedy's stock against its target (as last read)\"],\n  [\"REMEDIES POT <pot>\", \"the pot you brew in, as the game names it (e.g. pot123456)\"],\n  [\"REMEDIES CHECK\", \"read your rift (IR ELIXIR, IR SALVE) and say what would be brewed\"],\n  [\"REMEDIES BREW\", \"read your rift, then brew and pour each one up to its target, 20 units (1,000 sips) at a time; stops when done\"],\n  [\"REMEDIES STOP\", \"end a run now\"],\n  [\"REMEDIES TARGET <name> <n|DEFAULT>\", \"the level to top one up to (defaults: health and mana 2,000, the rest 1,000)\"],\n  [\"REMEDIES CAPS [CLEAR]\", \"the most your rift took of each, learnt when a pour came up short; CLEAR forgets them\"],\n  [\"REMEDIES DEBUG\", \"internal state\"],\n  [\"A unit is 50 sips; a remedy less than 50 sips short is left alone, so nothing goes over its target.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "Remedies control",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// REMEDIES [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.remedies || !client.loom.remedies.plan) run_function(\"remedies_setup\", [], \"remedies\");\nvar RM = client.loom.remedies;\nvar rmRaw = String(args[1] || \"\").trim();\nvar rmW = rmRaw.split(/\\s+/);\nvar rmSub = (rmW[0] || \"\").toLowerCase();\nif (rmSub === \"\" || rmSub === \"status\") {\n  RM.say(\"pot: \" + (RM.pot || \"none (REMEDIES POT <pot>)\") + (RM.run ? \"; a run is under way (\" + (RM.run.out || \"between steps\") + \")\" : \"\") + \".\");\n  var rmNames = Object.keys(RM.stock).sort(function (a, b) { return (RM.stock[a].kind > RM.stock[b].kind) - (RM.stock[a].kind < RM.stock[b].kind) || (a > b) - (a < b); });\n  if (!rmNames.length) RM.say(\"no rift reading yet: REMEDIES CHECK reads it.\");\n  else {\n    var rmL = [];\n    for (var rmI = 0; rmI < rmNames.length; rmI++) {\n      var rmN = rmNames[rmI], rmU = RM.unitsFor(rmN);\n      rmL.push(rmN + \" \" + RM.n(RM.stock[rmN].n) + \"/\" + RM.n(RM.targetOf(rmN)) + (rmU ? \" (+\" + rmU + \")\" : \"\"));\n    }\n    RM.say(\"stock/target, (+units to brew): \" + rmL.join(\" · \") + \".\");\n  }\n} else if (rmSub === \"help\") {\n  run_function(\"remedies_help\", [], \"remedies\");\n} else if (rmSub === \"pot\") {\n  var rmPot = (rmW[1] || \"\").toLowerCase();\n  if (!rmPot) RM.say(\"pot: \" + (RM.pot || \"none\") + \". REMEDIES POT <pot> sets it (the pot's id, e.g. pot123456).\");\n  else if (rmW.length > 2) RM.say(\"one word: the pot's id as the game shows it, e.g. REMEDIES POT pot123456.\", \"orange\");\n  else { RM.pot = rmPot; set_variable(\"remedies_pot\", rmPot); RM.say(\"brewing in \" + rmPot + \".\", \"lime\"); }\n} else if (rmSub === \"check\") {\n  RM.start(true);\n} else if (rmSub === \"brew\") {\n  RM.start(false);\n} else if (rmSub === \"stop\") {\n  if (!RM.run) RM.say(\"no run under way.\");\n  else RM.stop(\"stopped.\", \"orange\");\n} else if (rmSub === \"target\") {\n  var rmTn = (rmW[1] || \"\").toLowerCase(), rmTv = (rmW[2] || \"\").toLowerCase();\n  if (!rmTn) RM.say(\"REMEDIES TARGET <name> <n|DEFAULT>, e.g. REMEDIES TARGET health 2500.\", \"orange\");\n  else if (rmTv === \"default\") { delete RM.targets[rmTn]; RM.save(); RM.say(rmTn + \" back to its default target: \" + RM.n(RM.targetOf(rmTn)) + \".\", \"lime\"); }\n  else if (!/^\\d+$/.test(rmTv)) RM.say(\"the target is a number of sips: REMEDIES TARGET \" + rmTn + \" 1500.\", \"orange\");\n  else {\n    RM.targets[rmTn] = parseInt(rmTv, 10); RM.save();\n    RM.say(rmTn + \" topped up to \" + RM.n(RM.targets[rmTn]) + (RM.caps[rmTn] != null && RM.caps[rmTn] < RM.targets[rmTn] ? \" (but your rift takes only \" + RM.n(RM.caps[rmTn]) + \": REMEDIES CAPS CLEAR if that has changed)\" : \"\") + \".\", \"lime\");\n  }\n} else if (rmSub === \"caps\") {\n  if ((rmW[1] || \"\").toLowerCase() === \"clear\") { RM.caps = {}; RM.save(); RM.say(\"rift limits forgotten; they're learnt again when a pour comes up short.\", \"lime\"); }\n  else {\n    var rmC = Object.keys(RM.caps).sort().map(function (k) { return k + \" \" + RM.n(RM.caps[k]); });\n    RM.say(\"your rift's limits, as learnt: \" + (rmC.length ? rmC.join(\", \") : \"none yet\") + \". REMEDIES CAPS CLEAR forgets them.\");\n  }\n} else if (rmSub === \"debug\") {\n  RM.say(\"run \" + JSON.stringify(RM.run) + \" | reading \" + JSON.stringify(RM.reading) + \" | bal \" + RM.bal + \" eq \" + RM.eq + \" | pot \" + (RM.pot || \"-\") + \" | targets \" + JSON.stringify(RM.targets) + \" | caps \" + JSON.stringify(RM.caps) + \" | pause \" + (get_variable(\"pauseTriggers\") || \"unset\"));\n} else {\n  RM.say(\"unknown command '\" + rmSub + \"'. REMEDIES HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^remedies(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "Rift listing",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Our own IR ELIXIR / IR SALVE: header, category line, rules and rows,\n// hidden while a run reads them. args[0] is the line.\nvar RM = client.loom && client.loom.remedies;\nif (RM && RM.reading) {\n  var rmL = String(args[0] || \"\");\n  if (/^-{20,}$/.test(rmL)) { gag_current_line(); RM.rule(); }\n  else if (/^\\s*\\[\\s*[\\d,]+\\]\\s/.test(rmL)) { if (RM.row(rmL)) gag_current_line(); }\n  else if (/^(?:Glancing into your rift, you see:|Elixirs|Salves)$/.test(rmL)) gag_current_line();\n}\n"
    }
   ],
   "text": "^(?:Glancing into your rift, you see:|Elixirs|Salves|-{20,}|\\s*\\[\\s*[\\d,]+\\]\\s.*)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Brew done",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"You place your ingredients into …, leaving you with …\": a brew landed.\nvar RM = client.loom && client.loom.remedies;\nif (RM && RM.brewed) RM.brewed();\n"
    }
   ],
   "text": "^You place your ingredients into .+, leaving you with .+\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Pour into rift",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// \"You carefully pour N sips of X from <pot> into your rift, bringing the\n// total stored sips to M.\"\nvar RM = client.loom && client.loom.remedies;\nif (RM && RM.run) {\n  if (RM.run.out == \"pourOld\") RM.oldPoured(true, parseInt(String(args[4]).replace(/,/g, \"\"), 10), args[2]);\n  else RM.poured(parseInt(String(args[1]).replace(/,/g, \"\"), 10), parseInt(String(args[4]).replace(/,/g, \"\"), 10));\n}\n"
    }
   ],
   "text": "^You carefully pour ([\\d,]+) sips of (.+) from (.+) into your rift, bringing the total stored sips to ([\\d,]+)\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "Brew and pour answers",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// The game's other answers to BREW and POUR (Ricardo's lines, #436).\nvar RM = client.loom && client.loom.remedies;\nif (RM && RM.run) {\n  var rmL = String(args[0] || \"\");\n  var rmM;\n  if ((rmM = /^That pot already contains (.+)!$/.exec(rmL))) RM.potFull(rmM[1]);\n  else if (/^You lack the required ingredients to brew that\\.$/.test(rmL)) RM.noIngredients();\n  else if (/^That is not a pot\\.$/.test(rmL)) RM.notPot();\n  else if (/^Your rift is already full\\.$/.test(rmL)) { if (RM.run.out == \"pourOld\") RM.oldPoured(false); else RM.full(); }\n  else if (/ is empty\\.$/.test(rmL)) { if (RM.run.out == \"pourOld\") RM.oldPoured(true); else RM.empty(); }\n}\n"
    }
   ],
   "text": "^(?:That pot already contains .+!|You lack the required ingredients to brew that\\.|That is not a pot\\.|Your rift is already full\\.|.+ is empty\\.)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  }
 ],
 "description": "Tops up the elixirs and salves in your rift: brews in your pot, pours, stops"
}