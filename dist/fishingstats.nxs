     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\nFS.evt = { angler: FS.me, type: \"cast\" };\nrun_function(\"fishingstats_event\", [], \"fishingstats\");"
      }
     ],
     "text": "^You cock back your arm and smoothly cast a line into",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\nvar ft = parseInt(args[1], 10) || 0;\nif (ft > 0) {\n  FS.session.castFt = (FS.session.castFt || 0) + ft;\n  FS.session.castN = (FS.session.castN || 0) + 1;\n}"
      }
     ],
     "text": "You judge the cast at about (\\d+) feet",
     "matching": "regexp",
     "whole_words": false,
