       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\nFS.inp = { angler: FS.me, species: args[1], oz: (parseInt(args[2], 10) || 0) * 16 + (parseInt(args[3], 10) || 0) };\nrun_function(\"fishingstats_record\", [], \"fishingstats\");"
      }
     ],
     "text": "^You reel in the last bit of line and your struggle is over\\. You've landed (?:a|an|the) (.+?) weighing (\\d+) pounds?(?: and (\\d+) ounces?)?[.!]",
