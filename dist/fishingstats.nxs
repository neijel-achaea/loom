  {
   "type": "group",
   "name": "rankings",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "fishingstats_rank",
     "enabled": true,
     "code": "// Stores one row of a fishing rankings table.\n//   FS.rank = { species, who, lb, oz, year }\n// RANKINGS FISHING prints two tables with identical layout: the year's bests\n// and the all-time bests since the last reset. Rows are attributed by which\n// header was seen last, with the row's own year as a second check, so the\n// all-time figures cannot overwrite the yearly ones.\nif (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\nvar r = FS.rank;\nFS.rank = null;\nif (r && r.species) {\n  var oz = (parseInt(r.lb, 10) || 0) * 16 + (parseInt(r.oz, 10) || 0);\n  var key = String(r.species).toLowerCase();\n  var yr = parseInt(r.year, 10) || 0;\n  var mode = FS.rankMode || \"\";\n\n  if (mode === \"year\" && yr === FS.rec.year) {\n    if (!FS.rec.f[key] || oz > FS.rec.f[key][0]) {\n      FS.rec.f[key] = [oz, String(r.who)];\n      try { set_variable(\"fishingstats_records\", JSON.stringify(FS.rec)); } catch (e) {}\n    }\n  } else if (mode === \"reset\") {\n    // Kept for later use. Nothing displays these yet.\n    if (!FS.rec.a) { FS.rec.a = {}; }\n    if (!FS.rec.a[key] || oz > FS.rec.a[key][0]) {\n      FS.rec.a[key] = [oz, String(r.who)];\n      try { set_variable(\"fishingstats_records\", JSON.stringify(FS.rec)); } catch (e) {}\n    }\n  }\n}"
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\nvar yr = parseInt(args[1], 10) || 0;\nFS.rankMode = \"year\";\n// The table is complete, so rebuild from scratch rather than merging into\n// whatever was there before.\nFS.rec.year = yr;\nFS.rec.f = {};\ntry { set_variable(\"fishingstats_records\", JSON.stringify(FS.rec)); } catch (e) {}"
      }
     ],
     "text": "\\[ Fishing rankings for the year (\\d+) AF \\]",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\nFS.rankMode = \"reset\";\nFS.rec.a = {};"
      }
     ],
     "text": "\\[ Fishing rankings since last reset \\]",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\nFS.rank = { species: args[1], who: args[2], lb: args[3], oz: args[4], year: args[5] };\nrun_function(\"fishingstats_rank\", [], \"fishingstats\");"
      }
     ],
     "text": "^(?:A|An|The)\\s+(.+?)\\s+([A-Z][a-z]+)\\s+(\\d+)\\s+(\\d+)\\s+\\d+(?:st|nd|rd|th)\\s+of\\s+\\w+,\\s+(\\d+)\\s+AF?\\s*$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    }
   ]
  },
  {
   "type": "group",
   "name": "tabs",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "fishingstats_render",
     "enabled": true,
     "code": "if (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\n// Draws the 'fishingstats' tab: the live session.\n// House style shared in spirit with Coffers, Level and Ledger: ink panel,\n// serif small-caps headings, one large figure, monospace ledger rows.\nvar WATER = \"#7fd0c0\";\nvar DEEP = \"#3f7a72\";\nvar CATCH = \"#e6d27a\";\nvar TXT = \"#dbe8e4\";\nvar MUTED = \"#7f8f8b\";\nvar RULE = \"#20312d\";\nvar TRACK = \"#17241f\";\nvar RECORD = \"#b8d88a\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\n\nfunction esc(t) { return String(t).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\nfunction pad2(n) { return (n < 10 ? \"0\" : \"\") + n; }\nfunction clock(t) { var d = new Date(t * 1000); return d.getHours() + \":\" + pad2(d.getMinutes()); }\nfunction dur(secs) {\n  if (secs < 60) { return secs + \"s\"; }\n  if (secs < 3600) { return Math.round(secs / 60) + \"m\"; }\n  var h = Math.floor(secs / 3600);\n  var m = Math.round((secs - h * 3600) / 60);\n  return h + \"h\" + (m > 0 ? \" \" + m + \"m\" : \"\");\n}\nfunction wt(oz) {\n  oz = Math.round(oz);\n  var lb = Math.floor(oz / 16);\n  var o = oz % 16;\n  if (lb === 0) { return o + \"oz\"; }\n  return lb + \"lb\" + (o > 0 ? \" \" + o + \"oz\" : \"\");\n}\n// House typography, shared in spirit (not in code) with Coffers, Level and Ledger.\nfunction caps(t, col) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (col || DEEP) + ';font-size:11px;margin:0 0 3px;\">' + t + '</div>'; }\nfunction row(label, value, col) {\n  return '<div style=\"display:flex;justify-content:space-between;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"color:' + MUTED + ';white-space:nowrap;\">' + label + '</span><span style=\"color:' + (col || TXT) + ';white-space:nowrap;\">' + value + '</span></div>';\n}\nfunction box(inner, col) { return '<div style=\"flex:1 1 150px;min-width:150px;border-top:2px solid ' + (col || DEEP) + ';padding:3px 2px 0;\">' + inner + '</div>'; }\nfunction section(title, inner, extra) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title + (extra || \"\"), WATER) + inner + '</div>'; }\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">' + t + '</div>'; }\nfunction swatch(c) { return '<span style=\"display:inline-block;width:8px;height:8px;background:' + c + ';margin-right:4px;vertical-align:0;\"></span>'; }\n\n// A small leaping fish over a ripple, the fishing tabs' counterpart of the coin stack.\nvar glyph = '<svg width=\"20\" height=\"16\" viewBox=\"0 0 20 16\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<path d=\"M3 9 C6 3.5 12 3 15.5 6.5 C12 9.5 6 10 3 9 Z\" fill=\"' + WATER + '\"/>' +\n  '<path d=\"M15 6.3 L19 3.5 L18.2 7 L19 10 Z\" fill=\"' + WATER + '\"/><circle cx=\"6\" cy=\"7.2\" r=\"0.8\" fill=\"#0d1514\"/>' +\n  '<path d=\"M1 13.5 Q4 12 7 13.5 T13 13.5 T19 13.5\" fill=\"none\" stroke=\"' + DEEP + '\" stroke-width=\"1\"/></svg>';\nfunction header(title, right) {\n  return '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">' +\n    '<div style=\"font-family:' + SERIF + ';color:' + WATER + ';font-size:14px;letter-spacing:0.22em;\">' + glyph + title + '</div>' +\n    '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + DEEP + ';font-size:11px;\">' + right + '</div></div>';\n}\nfunction hero(num, tail) {\n  return '<div style=\"margin:6px 0 2px;\"><span style=\"font-family:' + SERIF + ';font-size:26px;color:' + WATER + ';\">' + num + '</span> ' +\n    '<span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">' + tail + '</span></div>';\n}\nvar PANEL = '<div style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:#0d1514;border:1px solid ' + RULE + ';padding:7px 8px 8px;\">';\n\nvar s = FS.session;\nvar pal = FS.palette;\nvar rec = FS.rec.f;\n\n// Ranking rows truncate long names, so a stored key that prefixes the caught\n// species counts as the same fish.\nfunction recFor(sp) {\n  if (rec[sp]) { return rec[sp]; }\n  var k;\n  for (k in rec) {\n    if (rec.hasOwnProperty(k) && k.length > 3 && sp.indexOf(k) === 0) { return rec[k]; }\n  }\n  return null;\n}\n// One angler: name and count over a bar in their colour, details beneath.\nfunction barRow(label, right, note, value, max, colour, me) {\n  var pct = max > 0 ? Math.round((value / max) * 100) : 0;\n  if (pct < 1 && value > 0) { pct = 1; }\n  var out = '<div style=\"margin:0 0 5px;\">';\n  out += '<div style=\"display:flex;justify-content:space-between;\"><span style=\"color:' + (me ? \"#ffffff\" : TXT) + ';\">' + swatch(colour) + esc(label) + (me ? ' <span style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">(you)</span>' : '') + '</span>';\n  out += '<span style=\"color:' + TXT + ';\">' + right + '</span></div>';\n  out += '<div style=\"background:' + TRACK + ';height:6px;width:100%;margin:2px 0 1px;\"><div style=\"background:' + colour + ';height:6px;width:' + pct + '%;\"></div></div>';\n  if (note) { out += '<div style=\"color:' + MUTED + ';\">' + note + '</div>'; }\n  return out + '</div>';\n}\n// Species bars are split into one segment per angler, all drawn on the same\n// scale as each other, so a segment's length is comparable across species as\n// well as within one.\nfunction stackRow(label, right, segs, notes, max) {\n  var out = '<div style=\"margin:0 0 5px;\">';\n  out += '<div style=\"display:flex;justify-content:space-between;\"><span style=\"color:' + TXT + ';\">' + esc(label) + '</span><span style=\"color:' + TXT + ';\">' + right + '</span></div>';\n  out += '<div style=\"background:' + TRACK + ';height:6px;width:100%;margin:2px 0 1px;display:flex;\">';\n  var i;\n  for (i = 0; i < segs.length; i++) {\n    var w = max > 0 ? (segs[i].n / max) * 100 : 0;\n    out += '<div title=\"' + esc(segs[i].who) + ' ' + segs[i].n + '\" style=\"background:' + segs[i].colour + ';height:6px;width:' + (Math.round(w * 10) / 10) + '%;' + (i < segs.length - 1 ? 'margin-right:1px;' : '') + '\"></div>';\n  }\n  out += '</div>';\n  for (i = 0; i < notes.length; i++) { out += '<div style=\"color:' + MUTED + ';\">' + notes[i] + '</div>'; }\n  return out + '</div>';\n}\nfunction byAnglerCount(a, b) { return s.anglers[b].n - s.anglers[a].n; }\nfunction bySpeciesCount(a, b) { return s.species[b].n - s.species[a].n; }\n\nvar now = Math.floor(new Date().getTime() / 1000);\nvar elapsed = now - (s.start || now);\nif (elapsed < 1) { elapsed = 1; }\n\nvar totHook = 0, totCast = 0, totOz = 0, kk;\nvar names = [];\nfor (kk in s.anglers) {\n  if (s.anglers.hasOwnProperty(kk)) {\n    names.push(kk);\n    totHook += s.anglers[kk].hooks || 0;\n    totCast += s.anglers[kk].casts || 0;\n    totOz += s.anglers[kk].oz || 0;\n  }\n}\nvar areaList = [];\nfor (kk in s.areas) { if (s.areas.hasOwnProperty(kk)) { areaList.push(kk); } }\n\nvar html = PANEL + header(\"FISHING\", dur(elapsed) + (s.year ? ' &middot; ' + s.year + ' AF' : ''));\n\nif (s.n === 0 && names.length === 0) {\n  html += hero(\"0\", \"fish landed so far\");\n  html += quiet(\"Nothing yet this session. Cast a line, or run FISHINGSTATS DEMO to preview the layout.\");\n} else {\n  html += hero(String(s.n), (s.n === 1 ? \"fish\" : \"fish\") + \" landed\" + (totOz > 0 ? \", \" + wt(totOz) + \" in all\" : \"\"));\n  // Where: flag a pinned area so a stale manual override is visible rather\n  // than looking like a detection failure.\n  if (areaList.length > 0) {\n    html += '<div style=\"color:' + MUTED + ';\">at <span style=\"color:' + TXT + ';font-family:' + SERIF + ';\">' + esc(areaList.join(\", \")) + '</span>' + (FS.areaSrc === \"manual\" ? ' <span style=\"font-style:italic;font-family:' + SERIF + ';\">(pinned)</span>' : '') + '</div>';\n  } else {\n    html += '<div style=\"color:' + MUTED + ';\">area unknown &mdash; FISHINGSTATS AREA to set</div>';\n  }\n\n  // Two ledger columns: the pace of the session, and its prize catch.\n  var lost = totHook - s.n;\n  var cols = '<div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;\">';\n  var pb = caps(\"The session\", WATER);\n  pb += row(\"per hour\", s.n > 0 ? String(Math.round((s.n / (elapsed / 3600)) * 10) / 10) : \"&hellip;\", s.n > 0 ? WATER : MUTED);\n  pb += row(\"landed / cast\", totCast > 0 ? s.n + \"/\" + totCast + \" (\" + Math.round((s.n / totCast) * 100) + \"%)\" : \"&mdash;\");\n  pb += row(\"got away\", lost > 0 ? String(lost) : \"none\", lost > 0 ? \"#de8a72\" : MUTED);\n  pb += row(\"avg cast\", s.castN > 0 ? Math.round(s.castFt / s.castN) + \"ft\" : \"&mdash;\", s.castN > 0 ? TXT : MUTED);\n  cols += box(pb, WATER);\n\n  var bestOz = 0, bestWho = \"\", bestSp = \"\";\n  for (kk = 0; kk < names.length; kk++) {\n    var an = s.anglers[names[kk]];\n    if (an.best > bestOz) { bestOz = an.best; bestWho = names[kk]; bestSp = an.bestSp || \"\"; }\n  }\n  var spCount = 0;\n  for (kk in s.species) { if (s.species.hasOwnProperty(kk)) { spCount++; } }\n  var bb = caps(\"Prize catch\", CATCH);\n  if (bestOz > 0) {\n    bb += '<div style=\"font-family:' + SERIF + ';font-size:16px;color:' + CATCH + ';\">' + wt(bestOz) + '</div>';\n    bb += row(\"species\", esc(bestSp));\n    bb += row(\"by\", esc(bestWho), bestWho === FS.me ? \"#ffffff\" : TXT);\n  } else {\n    bb += quiet(\"Nothing weighed yet.\");\n  }\n  bb += row(\"species seen\", String(spCount));\n  if (s.rec > 0) { bb += row(\"rankings beaten\", String(s.rec), RECORD); }\n  cols += box(bb, CATCH);\n  html += cols + '</div>';\n\n  names.sort(byAnglerCount);\n  var maxN = 0;\n  var k;\n  for (k = 0; k < names.length; k++) { if (s.anglers[names[k]].n > maxN) { maxN = s.anglers[names[k]].n; } }\n  var colourOf = {};\n  for (k = 0; k < names.length; k++) { colourOf[names[k]] = FS.col[names[k]] || pal[k % pal.length]; }\n\n  var ab = \"\";\n  for (k = 0; k < names.length; k++) {\n    var a = s.anglers[names[k]];\n    var share = s.n > 0 ? Math.round((a.n / s.n) * 100) : 0;\n    var note = 'total ' + wt(a.oz);\n    if (a.best > 0) { note += ' &middot; best ' + wt(a.best) + ' ' + esc(a.bestSp); }\n    if (a.casts > 0) { note += ' &middot; ' + Math.round((a.n / a.casts) * 100) + '% of casts landed'; }\n    ab += barRow(names[k], a.n + ' <span style=\"color:' + MUTED + ';\">&middot; ' + share + '%</span>', note, a.n, maxN, colourOf[names[k]], names[k] === FS.me);\n  }\n  html += section(\"By angler\", ab);\n\n  var sp = [];\n  for (k in s.species) { if (s.species.hasOwnProperty(k)) { sp.push(k); } }\n  if (sp.length > 0) {\n    sp.sort(bySpeciesCount);\n    var maxS = s.species[sp[0]].n;\n    var shown = sp.length > 10 ? 10 : sp.length;\n    var sb = \"\";\n    if (names.length > 1) {\n      sb += '<div style=\"margin:0 0 5px;\">';\n      for (k = 0; k < names.length; k++) { sb += '<span style=\"margin-right:9px;white-space:nowrap;color:' + MUTED + ';\">' + swatch(colourOf[names[k]]) + esc(names[k]) + '</span>'; }\n      sb += '</div>';\n    }\n    for (k = 0; k < shown; k++) {\n      var f = s.species[sp[k]];\n      var segs = [];\n      var parts = [];\n      var q;\n      for (q = 0; q < names.length; q++) {\n        var cnt = s.anglers[names[q]].sp ? (s.anglers[names[q]].sp[sp[k]] || 0) : 0;\n        if (cnt > 0) {\n          segs.push({ who: names[q], n: cnt, colour: colourOf[names[q]] });\n          parts.push('<span style=\"color:' + colourOf[names[q]] + ';\">' + esc(names[q]) + ' ' + cnt + '</span>');\n        }\n      }\n      var notes = [];\n      if (parts.length > 1) { notes.push(parts.join(' &middot; ')); }\n      var note2 = 'avg ' + wt(f.oz / f.n) + ' &middot; best ' + wt(f.best) + ' (' + esc(f.bestBy) + ')';\n      var rr = recFor(sp[k]);\n      if (rr) { note2 += ' &middot; <span style=\"color:' + RECORD + ';\">year&rsquo;s best ' + wt(rr[0]) + ' ' + esc(rr[1]) + '</span>'; }\n      notes.push(note2);\n      sb += stackRow(sp[k], String(f.n), segs, notes, maxS);\n    }\n    html += section(\"By species\", sb, sp.length > shown ? ' <span style=\"font-variant:normal;letter-spacing:0;font-style:italic;color:' + MUTED + ';\">top ' + shown + ' of ' + sp.length + '</span>' : '');\n  }\n\n  if (s.recent.length > 0) {\n    var rb = \"\";\n    for (k = s.recent.length - 1; k >= 0; k--) {\n      var r2 = s.recent[k];\n      var isMe = (r2[1] === FS.me);\n      rb += '<div style=\"display:flex;gap:8px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\">';\n      rb += '<span style=\"color:' + MUTED + ';min-width:3em;\">' + clock(r2[0]) + '</span>';\n      rb += '<span style=\"color:' + (colourOf[r2[1]] || TXT) + ';min-width:5.5em;' + (isMe ? 'font-weight:bold;' : '') + '\">' + esc(r2[1]) + '</span>';\n      rb += '<span style=\"flex:1 1 auto;color:' + TXT + ';\">' + esc(r2[2]) + '</span>';\n      rb += '<span style=\"color:' + CATCH + ';white-space:nowrap;\">' + wt(r2[3]) + '</span></div>';\n    }\n    html += section(\"Recent catches\", rb);\n  }\n}\nhtml += '</div>';\n\ntry { set_custom_tab_html(\"fishingstats\", html); } catch (e) {}"
    },
    {
     "type": "function",
     "name": "fishingstats_log_render",
     "enabled": true,
     "code": "if (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\n// Draws the 'fishinglog' tab: filed sessions and all-time totals.\n// House style shared in spirit with Coffers, Level and Ledger: ink panel,\n// serif small-caps headings, one large figure, monospace ledger rows.\nvar WATER = \"#7fd0c0\";\nvar DEEP = \"#3f7a72\";\nvar CATCH = \"#e6d27a\";\nvar TXT = \"#dbe8e4\";\nvar MUTED = \"#7f8f8b\";\nvar RULE = \"#20312d\";\nvar TRACK = \"#17241f\";\nvar RECORD = \"#b8d88a\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\n\nfunction esc(t) { return String(t).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\nfunction pad2(n) { return (n < 10 ? \"0\" : \"\") + n; }\nfunction clock(t) { var d = new Date(t * 1000); return d.getHours() + \":\" + pad2(d.getMinutes()); }\nfunction dur(secs) {\n  if (secs < 60) { return secs + \"s\"; }\n  if (secs < 3600) { return Math.round(secs / 60) + \"m\"; }\n  var h = Math.floor(secs / 3600);\n  var m = Math.round((secs - h * 3600) / 60);\n  return h + \"h\" + (m > 0 ? \" \" + m + \"m\" : \"\");\n}\nfunction wt(oz) {\n  oz = Math.round(oz);\n  var lb = Math.floor(oz / 16);\n  var o = oz % 16;\n  if (lb === 0) { return o + \"oz\"; }\n  return lb + \"lb\" + (o > 0 ? \" \" + o + \"oz\" : \"\");\n}\n// House typography, shared in spirit (not in code) with Coffers, Level and Ledger.\nfunction caps(t, col) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (col || DEEP) + ';font-size:11px;margin:0 0 3px;\">' + t + '</div>'; }\nfunction row(label, value, col) {\n  return '<div style=\"display:flex;justify-content:space-between;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"color:' + MUTED + ';white-space:nowrap;\">' + label + '</span><span style=\"color:' + (col || TXT) + ';white-space:nowrap;\">' + value + '</span></div>';\n}\nfunction box(inner, col) { return '<div style=\"flex:1 1 150px;min-width:150px;border-top:2px solid ' + (col || DEEP) + ';padding:3px 2px 0;\">' + inner + '</div>'; }\nfunction section(title, inner, extra) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title + (extra || \"\"), WATER) + inner + '</div>'; }\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">' + t + '</div>'; }\nfunction swatch(c) { return '<span style=\"display:inline-block;width:8px;height:8px;background:' + c + ';margin-right:4px;vertical-align:0;\"></span>'; }\n\n// A small leaping fish over a ripple, the fishing tabs' counterpart of the coin stack.\nvar glyph = '<svg width=\"20\" height=\"16\" viewBox=\"0 0 20 16\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<path d=\"M3 9 C6 3.5 12 3 15.5 6.5 C12 9.5 6 10 3 9 Z\" fill=\"' + WATER + '\"/>' +\n  '<path d=\"M15 6.3 L19 3.5 L18.2 7 L19 10 Z\" fill=\"' + WATER + '\"/><circle cx=\"6\" cy=\"7.2\" r=\"0.8\" fill=\"#0d1514\"/>' +\n  '<path d=\"M1 13.5 Q4 12 7 13.5 T13 13.5 T19 13.5\" fill=\"none\" stroke=\"' + DEEP + '\" stroke-width=\"1\"/></svg>';\nfunction header(title, right) {\n  return '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">' +\n    '<div style=\"font-family:' + SERIF + ';color:' + WATER + ';font-size:14px;letter-spacing:0.22em;\">' + glyph + title + '</div>' +\n    '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + DEEP + ';font-size:11px;\">' + right + '</div></div>';\n}\nfunction hero(num, tail) {\n  return '<div style=\"margin:6px 0 2px;\"><span style=\"font-family:' + SERIF + ';font-size:26px;color:' + WATER + ';\">' + num + '</span> ' +\n    '<span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">' + tail + '</span></div>';\n}\nvar PANEL = '<div style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:#0d1514;border:1px solid ' + RULE + ';padding:7px 8px 8px;\">';\n\nvar log = FS.log || [];\nvar pal = FS.palette;\n\nfunction stamp(t) {\n  if (!t || isNaN(Number(t))) { return \"undated\"; }\n  var MN = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"];\n  var d = new Date(t * 1000);\n  return d.getDate() + \" \" + MN[d.getMonth()] + \" \" + d.getHours() + \":\" + pad2(d.getMinutes());\n}\nvar perAngler = {};\nvar curL = null;\nfunction byTotal(a, b) { return perAngler[b][0] - perAngler[a][0]; }\nfunction bySessionCount(a, b) { return curL.ang[b][0] - curL.ang[a][0]; }\n\nvar html = PANEL;\nif (log.length === 0) {\n  html += header(\"FISHING LOG\", \"0 sessions\");\n  html += quiet(\"No sessions filed yet. A session is filed automatically after \" + FS.gap + \" minutes idle, or on demand with FISHINGSTATS END.\");\n} else {\n  // Aggregate across everything logged.\n  var tn = 0, toz = 0, tsec = 0, trec = 0, tnTimed = 0;\n  var bestOz = 0, bestSp = \"\", bestWho = \"\";\n  var perSpecies = {};\n  var i, k;\n  for (i = 0; i < log.length; i++) {\n    var L = log[i];\n    tn += L.n;\n    toz += L.oz || 0;\n    // Older entries can lack a start or end time; count only the sound ones.\n    var lsec = Number(L.e) - Number(L.s);\n    if (!isNaN(lsec) && lsec > 0) { tsec += lsec; tnTimed += L.n; }\n    trec += L.rec || 0;\n    for (k in L.ang) {\n      if (L.ang.hasOwnProperty(k)) {\n        if (!perAngler[k]) { perAngler[k] = [0, 0, 0, \"\"]; }\n        perAngler[k][0] += L.ang[k][0];\n        perAngler[k][1] += L.ang[k][1];\n        if (L.ang[k][2] > perAngler[k][2]) { perAngler[k][2] = L.ang[k][2]; perAngler[k][3] = L.ang[k][5] || \"\"; }\n        if (L.ang[k][2] > bestOz) { bestOz = L.ang[k][2]; bestWho = k; bestSp = L.ang[k][5] || \"\"; }\n      }\n    }\n    for (k in L.sp) { if (L.sp.hasOwnProperty(k)) { perSpecies[k] = (perSpecies[k] || 0) + L.sp[k][0]; } }\n  }\n  var spCount = 0;\n  for (k in perSpecies) { if (perSpecies.hasOwnProperty(k)) { spCount += 1; } }\n\n  html += header(\"FISHING LOG\", log.length + \" session\" + (log.length === 1 ? \"\" : \"s\"));\n  html += hero(String(tn), \"fish landed\" + (tsec > 0 ? \" over \" + dur(tsec) : \"\") + (toz > 0 ? \", \" + wt(toz) + \" in all\" : \"\"));\n\n  var cols = '<div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;\">';\n  var tb = caps(\"All sessions\", WATER);\n  tb += row(\"time fished\", dur(tsec));\n  tb += row(\"per hour\", tsec > 0 ? String(Math.round(tnTimed / (tsec / 3600) * 10) / 10) : \"&hellip;\", WATER);\n  tb += row(\"species seen\", String(spCount));\n  if (trec > 0) { tb += row(\"rankings beaten\", String(trec), RECORD); }\n  cols += box(tb, WATER);\n  var bb = caps(\"Biggest ever\", CATCH);\n  if (bestOz > 0) {\n    bb += '<div style=\"font-family:' + SERIF + ';font-size:16px;color:' + CATCH + ';\">' + wt(bestOz) + '</div>';\n    bb += row(\"species\", esc(bestSp));\n    bb += row(\"by\", esc(bestWho), bestWho === FS.me ? \"#ffffff\" : TXT);\n  } else {\n    bb += quiet(\"Nothing weighed yet.\");\n  }\n  cols += box(bb, CATCH);\n  html += cols + '</div>';\n\n  var an = [];\n  for (k in perAngler) { if (perAngler.hasOwnProperty(k)) { an.push(k); } }\n  an.sort(byTotal);\n  var tot = \"\";\n  var maxA = an.length > 0 ? perAngler[an[0]][0] : 0;\n  for (i = 0; i < an.length; i++) {\n    var colour = FS.col[an[i]] || pal[i % pal.length];\n    var pa = perAngler[an[i]];\n    var pct = maxA > 0 ? Math.round(pa[0] / maxA * 100) : 0;\n    tot += '<div style=\"display:flex;align-items:center;gap:6px;margin-top:2px;\">';\n    tot += '<span style=\"width:76px;color:' + (an[i] === FS.me ? \"#ffffff\" : TXT) + ';overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">' + swatch(colour) + esc(an[i]) + '</span>';\n    tot += '<span style=\"flex:1;background:' + TRACK + ';height:6px;\"><span style=\"display:block;background:' + colour + ';height:6px;width:' + pct + '%;\"></span></span>';\n    tot += '<span style=\"width:108px;text-align:right;color:' + TXT + ';white-space:nowrap;\">' + pa[0] + ' <span style=\"color:' + MUTED + ';\">&middot; ' + wt(pa[1]) + '</span></span></div>';\n  }\n  html += section(\"Anglers, all time\", tot);\n\n  // One entry per session, newest first.\n  var sb = \"\";\n  for (i = log.length - 1; i >= 0; i--) {\n    var L2 = log[i];\n    curL = L2;\n    sb += '<div style=\"border-bottom:1px dotted ' + RULE + ';padding:2px 0 5px;margin:0 0 3px;\">';\n    sb += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;\">';\n    sb += '<span style=\"font-family:' + SERIF + ';color:' + TXT + ';font-size:12px;\">' + stamp(L2.s) + '</span>';\n    sb += '<span style=\"color:' + TXT + ';\">' + L2.n + ' <span style=\"color:' + MUTED + ';\">&middot; ' + (isNaN(Number(L2.e) - Number(L2.s)) ? '?' : dur(L2.e - L2.s)) + ' &middot; ' + wt(L2.oz || 0) + '</span></span></div>';\n    var meta = [];\n    if (L2.ar) { meta.push('<span style=\"color:' + WATER + ';\">' + esc(L2.ar) + '</span>'); }\n    if (L2.y) { meta.push(L2.y + ' AF'); }\n    if (L2.ft) { meta.push('avg cast ' + L2.ft + 'ft'); }\n    if (L2.rec) { meta.push('<span style=\"color:' + RECORD + ';\">' + L2.rec + ' ranking' + (L2.rec === 1 ? \"\" : \"s\") + ' beaten</span>'); }\n    if (meta.length > 0) { sb += '<div style=\"color:' + MUTED + ';\">' + meta.join(' &middot; ') + '</div>'; }\n\n    var names = [];\n    for (k in L2.ang) { if (L2.ang.hasOwnProperty(k)) { names.push(k); } }\n    names.sort(bySessionCount);\n    var maxN = names.length > 0 ? L2.ang[names[0]][0] : 0;\n    var j;\n    for (j = 0; j < names.length; j++) {\n      var A = L2.ang[names[j]];\n      var colour2 = FS.col[names[j]] || pal[j % pal.length];\n      var pc = maxN > 0 ? Math.round((A[0] / maxN) * 100) : 0;\n      var lostN = (A[4] || 0) - A[0];\n      sb += '<div style=\"display:flex;align-items:center;gap:6px;margin-top:2px;\">';\n      sb += '<span style=\"width:76px;color:' + (names[j] === FS.me ? \"#ffffff\" : TXT) + ';overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">' + esc(names[j]) + '</span>';\n      sb += '<span style=\"flex:1;background:' + TRACK + ';height:5px;\"><span style=\"display:block;background:' + colour2 + ';height:5px;width:' + pc + '%;\"></span></span>';\n      sb += '<span style=\"width:108px;text-align:right;color:' + MUTED + ';white-space:nowrap;\"><span style=\"color:' + TXT + ';\">' + A[0] + '</span> &middot; ' + wt(A[1]) + (lostN > 0 ? ' &middot; ' + lostN + ' lost' : '') + '</span></div>';\n    }\n    sb += '</div>';\n  }\n  html += section(\"Sessions\", sb);\n}\nhtml += '</div>';\n\ntry { set_custom_tab_html(\"fishinglog\", html); } catch (e) {}"
    }
   ]
  },
  {
   "type": "group",
   "name": "learn",
   "enabled": true,
   "items": [
    {
     "type": "trigger",
     "name": "",
     "enabled": false,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "// Runs on every line, so it does nothing unless LEARN is on.\nif (client.loom && client.loom.fishingstats && client.loom.fishingstats.learn) {\n  var FS = client.loom.fishingstats;\n  if (!FS.buf) { FS.buf = []; }\n  // args[0] is only the matched text, so the whole line is captured\n  // explicitly with a group rather than relying on a bare wildcard.\n  var raw = args[1] || args[0] || \"\";\n  if (raw.length > 0 && raw.length < 300) {\n    FS.buf.push(raw);\n    while (FS.buf.length > 120) { FS.buf.shift(); }\n  }\n}"
      }
     ],
     "text": "^(.+)$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": true
    }
   ]
  }
 ],
 "description": "Fishing statistics for you and everyone around you: casts, hooks and catches per angler and per species, with weights, in a tab named 'fishingstats'; filed sessions in a tab named 'fishinglog'. Flags catches that beat this year's rankings (read from RANKINGS FISHING). State in client.loom.fishingstats. FISHINGSTATS HELP for commands."
}