  {
   "type": "trigger",
   "name": "Fishing Learn Capture",
   "enabled": false,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (client.fshLearn) {\n  if (!client.fshBuf) { client.fshBuf = []; }\n  // args[0] is only the matched text, so the whole line is captured\n  // explicitly with a group rather than relying on a bare wildcard.\n  var raw = args[1] || args[0] || \"\";\n  if (raw.length > 0 && raw.length < 300) {\n    client.fshBuf.push(raw);\n    while (client.fshBuf.length > 120) { client.fshBuf.shift(); }\n  }\n}"
    }
   ],
   "text": "^(.+)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "alias",
   "name": "Fishing Learn",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"fsh_ensure\", [], \"fishingstats\");\nvar a = args[1] || \"\";\nif (a === \"show\") {\n  var buf = client.fshBuf || [];\n  display_notice(\"[fishingstats] \" + buf.length + \" line(s) captured:\", \"cyan\");\n  for (var i = 0; i < buf.length; i++) { display_notice(\"| \" + buf[i], \"yellow\"); }\n} else if (a === \"clear\") {\n  client.fshBuf = [];\n  display_notice(\"[fishingstats] buffer cleared.\", \"cyan\");\n} else {\n  if (a === \"on\") { client.fshLearn = true; }\n  else if (a === \"off\") { client.fshLearn = false; }\n  else { client.fshLearn = !client.fshLearn; }\n  if (client.fshLearn) { client.fshBuf = []; }\n  display_notice(\"[fishingstats] capture \" + (client.fshLearn ? \"ON. Catch a fish, have someone else catch one, then FPLEARN OFF and FPLEARN SHOW.\" : \"off. FPLEARN SHOW dumps what was captured.\"), \"cyan\");\n}"
    }
   ],
   "text": "^fplearn(?:\\s+(on|off|show|clear))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "Fishing Add",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"fsh_ensure\", [], \"fishingstats\");\nvar lbv = parseInt(args[2], 10) || 0;\nvar ozv = parseInt(args[3], 10) || 0;\nclient.fshIn = { angler: args[1], species: args[4], oz: lbv * 16 + ozv };\nrun_function(\"fsh_record\", [], \"fishingstats\");\ndisplay_notice(\"[fishingstats] recorded \" + args[1] + \" \" + lbv + \"lb \" + ozv + \"oz \" + args[4] + \".\", \"cyan\");"
    }
   ],
   "text": "^fpadd\\s+(\\S+)\\s+(\\d+)(?:\\s+(\\d+))?\\s+(.+)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "Fishing Me",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"fsh_ensure\", [], \"fishingstats\");\nif (args[1]) {\n  client.fshMe = args[1];\n  try { set_variable(\"fsh_me\", args[1]); } catch (e) {}\n  run_function(\"fsh_render\", [], \"fishingstats\");\n  display_notice(\"[fishingstats] your angler name is set to \" + args[1] + \"; your row is highlighted.\", \"cyan\");\n} else { display_notice(\"[fishingstats] highlighted angler is \" + (client.fshMe || \"not set\") + \". Usage: fpme Neijel.\", \"cyan\"); }"
    }
   ],
   "text": "^fpme(?:\\s+(\\S+))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "Fishing Colour",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"fsh_ensure\", [], \"fishingstats\");\nvar who = args[1] || \"\";\nvar hex = args[2] || \"\";\nif (!who) {\n  var listed = [];\n  var q;\n  for (q in client.fsh.anglers) { if (client.fsh.anglers.hasOwnProperty(q)) { listed.push(q + \" \" + (client.fshCol[q] || \"default\")); } }\n  display_notice(\"[fishingstats] colours: \" + (listed.length ? listed.join(\", \") : \"none yet\") + \". Usage: fpcolour Oceana #e8a13f, or fpcolour Oceana reset.\", \"cyan\");\n} else if (!hex) {\n  display_notice(\"[fishingstats] \" + who + \" is \" + (client.fshCol[who] || \"on the default palette\") + \". Give a hex value like #e8a13f, or reset.\", \"cyan\");\n} else {\n  if (hex === \"reset\") { client.fshCol[who] = null; }\n  else { client.fshCol[who] = hex; }\n  try { set_variable(\"fsh_colours\", JSON.stringify(client.fshCol)); } catch (e) {}\n  run_function(\"fsh_render\", [], \"fishingstats\");\n  display_notice(\"[fishingstats] \" + who + \" is now \" + (hex === \"reset\" ? \"back on the default palette\" : hex) + \".\", \"cyan\");\n}"
    }
   ],
   "text": "^fpcolou?r(?:\\s+(\\S+)(?:\\s+(#[0-9a-fA-F]{6}|reset))?)?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "Fishing Reset",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"fsh_ensure\", [], \"fishingstats\");\nif ((args[1] || \"\") === \"confirm\") {\n  client.fsh = { start: Math.floor(new Date().getTime() / 1000), anglers: {}, species: {}, recent: [], n: 0 };\n  try { set_variable(\"fsh_session\", JSON.stringify(client.fsh)); } catch (e) {}\n  run_function(\"fsh_render\", [], \"fishingstats\");\n  display_notice(\"[fishingstats] new session started.\", \"cyan\");\n} else {\n  display_notice(\"[fishingstats] this clears the current session tally. Type 'fpreset confirm' to proceed.\", \"yellow\");\n}"
    }
   ],
   "text": "^fpreset(?:\\s+(confirm))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "Fishing Stats",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"fsh_ensure\", [], \"fishingstats\");\nvar s = client.fsh;\nvar now = Math.floor(new Date().getTime() / 1000);\nvar el = now - (s.start || now);\nif (el < 1) { el = 1; }\ndisplay_notice(\"[fishing] \" + s.n + \" catches over \" + Math.round(el / 60) + \" min\", \"cyan\");\nvar k;\nfor (k in s.anglers) {\n  if (s.anglers.hasOwnProperty(k)) {\n    var a = s.anglers[k];\n    display_notice(\"[fishingstats] \" + k + \": \" + a.n + \" (\" + Math.round((a.n / s.n) * 100) + \"%), \" + Math.floor(a.oz / 16) + \"lb \" + (a.oz % 16) + \"oz total, best \" + Math.floor(a.best / 16) + \"lb \" + (a.best % 16) + \"oz \" + a.bestSp, \"cyan\");\n  }\n}\nrun_function(\"fsh_render\", [], \"fishingstats\");"
    }
   ],
   "text": "^fpstats$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "Fishing Demo",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"fsh_ensure\", [], \"fishingstats\");\nclient.fsh = { start: Math.floor(new Date().getTime() / 1000) - 4500, anglers: {}, species: {}, recent: [], n: 0, areas: {}, year: client.fshRec.year || 0, rec: 0, castFt: 0, castN: 0 };\nvar who = [\"Neijel\", \"Oceana\", \"Sarapis\"];\nvar fishes = [\"pike\", \"blue eel\", \"rock bass\", \"catfish\", \"walleye\", \"trout\"];\nvar i;\nfor (i = 0; i < 34; i++) {\n  var w = who[i % 3 === 0 ? 0 : (i % 5 === 0 ? 2 : (i % 2))];\n  var extra = (i % 3 === 0) ? 2 : 1;\n  var j;\n  for (j = 0; j < extra; j++) {\n    client.fshEvt = { angler: w, type: \"cast\" };\n    run_function(\"fsh_event\", [], \"fishingstats\");\n  }\n  client.fshEvt = { angler: w, type: \"hook\" };\n  run_function(\"fsh_event\", [], \"fishingstats\");\n  var ozv = 12 + ((i * 37) % 900) + (i % 5) * 40;\n  client.fshIn = { angler: w, species: fishes[(i * 5) % fishes.length], oz: ozv };\n  run_function(\"fsh_record\", [], \"fishingstats\");\n}\ndisplay_notice(\"[fishingstats] demo data loaded into the tab. FPRESET CONFIRM clears it.\", \"cyan\");"
    }
   ],
   "text": "^fpdemo$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "Fishing Area",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"fsh_ensure\", [], \"fishingstats\");\nvar v = args[1] || \"\";\nif (!v) {\n  display_notice(\"[fishing] area now: \" + (client.fshAreaNow || \"unknown\") + \" (from \" + (client.fshAreaSrc || \"nothing found\") + \")\", \"cyan\");\n  display_notice(\"[fishing] fparea <name> to override, fparea auto to go back to detection, fparea reset to forget areas seen this session.\", \"white\");\n} else if (v === \"auto\" || v === \"reset\") {\n  if (v === \"auto\") {\n    client.fshAreaManual = \"\";\n    try { set_variable(\"fsh_area\", \"\"); } catch (e) {}\n  }\n  // Areas accumulate across a session, so a stale manual entry has to be\n  // cleared out too, then reseeded from whatever detection now reports.\n  client.fsh.areas = {};\n  run_function(\"fsh_ensure\", [], \"fishingstats\");\n  if (client.fshAreaNow) { client.fsh.areas[client.fshAreaNow] = 1; }\n  try { set_variable(\"fsh_session\", JSON.stringify(client.fsh)); } catch (e) {}\n  run_function(\"fsh_render\", [], \"fishingstats\");\n  display_notice(\"[fishingstats] area is now \" + (client.fshAreaNow || \"unknown\") + \" (from \" + (client.fshAreaSrc || \"nothing found\") + \"). Earlier areas this session were forgotten.\", \"cyan\");\n} else {\n  client.fshAreaManual = v;\n  try { set_variable(\"fsh_area\", v); } catch (e) {}\n  client.fsh.areas[v] = (client.fsh.areas[v] || 0) + 1;\n  try { set_variable(\"fsh_session\", JSON.stringify(client.fsh)); } catch (e) {}\n  run_function(\"fsh_render\", [], \"fishingstats\");\n  display_notice(\"[fishingstats] area pinned to \" + v + \". This overrides detection until fparea auto.\", \"cyan\");\n}"
    }
   ],
   "text": "^fparea(?:\\s+(.+))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "Fishing Where",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"fsh_ensure\", [], \"fishingstats\");\ndisplay_notice(\"[fishingstats] detected area: \" + (client.fshAreaNow || \"nothing found\"), \"cyan\");\ndisplay_notice(\"[fishingstats] source: \" + (client.fshAreaSrc || \"no candidate variable held a value\"), \"cyan\");\nvar probes = [\"currentArea\", \"room_area\", \"my_area\", \"area\", \"roomarea\", \"room_zone\"];\nfor (var i = 0; i < probes.length; i++) {\n  var v = \"(unset)\";\n  try { if (get_variable(probes[i]) !== undefined) { v = String(get_variable(probes[i])); } } catch (e) { v = \"(error)\"; }\n  display_notice(\"  \" + probes[i] + \" = \" + v, \"cyan\");\n}"
    }
   ],
   "text": "^fpwhere$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "Fishing Year",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"fsh_ensure\", [], \"fishingstats\");\nif (args[1]) {\n  client.fsh.year = parseInt(args[1], 10);\n  run_function(\"fsh_render\", [], \"fishingstats\");\n  display_notice(\"[fishingstats] session year set to \" + client.fsh.year + \" AF.\", \"cyan\");\n} else {\n  display_notice(\"[fishingstats] session year is \" + (client.fsh.year || \"unknown\") + \". It is picked up from the RANKINGS FISHING header, or set it with fpyear 1014.\", \"cyan\");\n}"
    }
   ],
   "text": "^fpyear(?:\\s+(\\d+))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "Fishing End",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"fsh_ensure\", [], \"fishingstats\");\nvar had = client.fsh.n;\nrun_function(\"fsh_archive\", [], \"fishingstats\");\nif (had > 0) { display_notice(\"[fishingstats] session filed to the log (\" + had + \" landed). New session started.\", \"cyan\"); }\nelse { display_notice(\"[fishingstats] nothing landed, so nothing was filed. Session restarted.\", \"yellow\"); }"
    }
   ],
   "text": "^fpend$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "Fishing Log",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"fsh_ensure\", [], \"fishingstats\");\nrun_function(\"fsh_log_render\", [], \"fishingstats\");\ndisplay_notice(\"[fishingstats] \" + client.fshLog.length + \" session(s) in the log; see the fishinglog tab.\", \"cyan\");"
    }
   ],
   "text": "^fplog$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "Fishing Gap",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"fsh_ensure\", [], \"fishingstats\");\nvar m = args[1] ? parseInt(args[1], 10) : 0;\nif (!m) { display_notice(\"[fishingstats] sessions are filed automatically after \" + client.fshGap + \" minutes idle. Usage: fpgap 5-1440.\", \"cyan\"); }\nelse if (m < 5 || m > 1440) { display_notice(\"[fishing] pick a gap between 5 and 1440 minutes.\", \"yellow\"); }\nelse {\n  client.fshGap = m;\n  try { set_variable(\"fsh_gap\", String(m)); } catch (e) {}\n  display_notice(\"[fishingstats] idle gap set to \" + m + \" minutes.\", \"cyan\");\n}"
    }
   ],
   "text": "^fpgap(?:\\s+(\\d+))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "Fishing Log Wipe",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"fsh_ensure\", [], \"fishingstats\");\nif ((args[1] || \"\") === \"confirm\") {\n  client.fshLog = [];\n  try { set_variable(\"fsh_log\", \"[]\"); } catch (e) {}\n  run_function(\"fsh_log_render\", [], \"fishingstats\");\n  display_notice(\"[fishingstats] session log cleared. The current session is untouched.\", \"red\");\n} else {\n  display_notice(\"[fishingstats] this clears ALL filed sessions. Type 'fplogwipe confirm' to proceed.\", \"yellow\");\n}"
    }
   ],
   "text": "^fplogwipe(?:\\s+(confirm))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "Fishing CSV",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"fsh_ensure\", [], \"fishingstats\");\nvar s = client.fsh;\ndisplay_notice(\"angler,landed,casts,hooks,total_oz,best_oz,best_species\", \"white\");\nvar k;\nfor (k in s.anglers) {\n  if (s.anglers.hasOwnProperty(k)) {\n    var a = s.anglers[k];\n    display_notice(k + \",\" + a.n + \",\" + (a.casts || 0) + \",\" + (a.hooks || 0) + \",\" + a.oz + \",\" + a.best + \",\" + a.bestSp, \"white\");\n  }\n}\ndisplay_notice(\"species,caught,total_oz,best_oz,best_by\", \"white\");\nfor (k in s.species) {\n  if (s.species.hasOwnProperty(k)) {\n    var f = s.species[k];\n    display_notice(k + \",\" + f.n + \",\" + f.oz + \",\" + f.best + \",\" + f.bestBy, \"white\");\n  }\n}"
    }
   ],
   "text": "^fpcsv$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true,
   "prefix_suffix": true
  }
 ],
 "description": "Group fishing tally for a UI tab named 'fishingstats'. Tracks catches per angler and per species with weights, drawn as horizontal bars. Catch parsing is not wired: triggers must call fsh_record with client.fshIn = {angler, species, lb}. Use FPLEARN to capture the real message wording first."
}