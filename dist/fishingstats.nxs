     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\nFS.evt = { angler: FS.me, type: \"hook\" };\nrun_function(\"fishingstats_event\", [], \"fishingstats\");"
      }
     ],
     "text": "^You quickly jerk back your fishing pole",
