    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\nFS.evt = { angler: args[1], type: \"cast\" };\nrun_function(\"fishingstats_event\", [], \"fishingstats\");"
      }
     ],
     "text": "^([A-Z][a-z]+) cocks back (?:his|her|their|its) arm and smoothly casts a line into",
