       "script": "if (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\nFS.inp = { angler: args[1], species: args[2], oz: (parseInt(args[3], 10) || 0) * 16 + (parseInt(args[4], 10) || 0) };\nrun_function(\"fishingstats_record\", [], \"fishingstats\");"
      }
     ],
     "text": "^With a final tug, ([A-Z][a-z]+) finishes reeling in (?:his|her|their|its) fishing line and lands (?:a|an|the) (.+?) weighing (\\d+) pounds?(?: and (\\d+) ounces?)?[.!]",
     "matching": "regexp",
