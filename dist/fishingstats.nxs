{
 "type": "group",
 "name": "fishingstats",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "var have = false;\ntry { if (get_variable(\"fsh_session\") !== undefined) { have = true; } } catch (e) { have = false; }\nif (!have) { set_variable(\"fsh_session\", \"\"); }\ndisplay_notice(\"[fishing] installed. Create a UI tab named 'fishingstats'. Casts, hooks and landings are parsed automatically for you and for others. Run FISHING RANKINGS once to load the yearly records. Tabs: 'fishingstats' and 'fishinglog'. Commands: fpstats, fpend, fplog, fparea, fpwhere, fpyear, fpgap, fpme, fpcolour, fpdemo, fpadd, fpcsv, fplearn.\", \"cyan\");"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; fsh_session is left intact."
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icons: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo them.\nvar tiTabs = [[\"fishingstats\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 16\"><path d=\"M3 9 C6 3.5 12 3 15.5 6.5 C12 9.5 6 10 3 9 Z\" fill=\"#7fd0c0\"/><path d=\"M15 6.3 L19 3.5 L18.2 7 L19 10 Z\" fill=\"#7fd0c0\"/><circle cx=\"6\" cy=\"7.2\" r=\"0.8\" fill=\"#0d1514\"/><path d=\"M1 13.5 Q4 12 7 13.5 T13 13.5 T19 13.5\" fill=\"none\" stroke=\"#3f7a72\" stroke-width=\"1\"/></svg>'], [\"fishinglog\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 16\"><path d=\"M3 9 C6 3.5 12 3 15.5 6.5 C12 9.5 6 10 3 9 Z\" fill=\"#3f7a72\"/><path d=\"M15 6.3 L19 3.5 L18.2 7 L19 10 Z\" fill=\"#3f7a72\"/><circle cx=\"6\" cy=\"7.2\" r=\"0.8\" fill=\"#0d1514\"/><path d=\"M1 12.5 H19 M1 15 H19\" stroke=\"#7fd0c0\" stroke-width=\"1\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}"
  },
  {
   "type": "function",
   "name": "fsh_ensure",
   "enabled": true,
   "code": "// Weights are stored as whole ounces. Achaea reports pounds and ounces, so an\n// integer count avoids float drift and formats back exactly.\nfunction fshBlank() {\n  return {\n    start: Math.floor(new Date().getTime() / 1000),\n    last: Math.floor(new Date().getTime() / 1000),\n    anglers: {}, species: {}, recent: [], n: 0,\n    areas: {}, year: 0, rec: 0, castFt: 0, castN: 0\n  };\n}\nif (!client.fsh) {\n  var s = null;\n  try { s = JSON.parse(get_variable(\"fsh_session\")); } catch (e) { s = null; }\n  if (!s || typeof s !== \"object\" || !s.anglers) { s = fshBlank(); }\n  if (!s.anglers) { s.anglers = {}; }\n  if (!s.species) { s.species = {}; }\n  if (!s.recent) { s.recent = []; }\n  if (!s.areas) { s.areas = {}; }\n  if (!s.n) { s.n = 0; }\n  if (!s.rec) { s.rec = 0; }\n  if (!s.castFt) { s.castFt = 0; }\n  if (!s.castN) { s.castN = 0; }\n  if (!s.last) { s.last = s.start || Math.floor(new Date().getTime() / 1000); }\n  client.fsh = s;\n}\nif (!client.fshLog) {\n  var lg = [];\n  try { lg = JSON.parse(get_variable(\"fsh_log\")) || []; } catch (e) { lg = []; }\n  if (Object.prototype.toString.call(lg) !== \"[object Array]\") { lg = []; }\n  client.fshLog = lg;\n}\nif (!client.fshRec) {\n  var r = null;\n  try { r = JSON.parse(get_variable(\"fsh_records\")); } catch (e) { r = null; }\n  if (!r || typeof r !== \"object\") { r = { year: 0, f: {}, a: {} }; }\n  if (!r.f) { r.f = {}; }\n  if (!r.a) { r.a = {}; }\n  client.fshRec = r;\n}\nif (client.fshMe === undefined) {\n  var me = \"\";\n  try { if (get_variable(\"fsh_me\") !== undefined) { me = String(get_variable(\"fsh_me\") || \"\"); } } catch (e) { me = \"\"; }\n  if (!me) { try { me = String(get_variable(\"my_name\") || \"\"); } catch (e) { me = \"\"; } }\n  if (!me || me === \"undefined\") { me = \"You\"; }\n  client.fshMe = me;\n}\nif (!client.fshCol) {\n  var c = null;\n  try { c = JSON.parse(get_variable(\"fsh_colours\")); } catch (e) { c = null; }\n  if (!c || typeof c !== \"object\") { c = {}; }\n  client.fshCol = c;\n}\nif (client.fshAreaManual === undefined) {\n  var am = \"\";\n  try { if (get_variable(\"fsh_area\") !== undefined) { am = String(get_variable(\"fsh_area\") || \"\"); } } catch (e) { am = \"\"; }\n  if (am === \"undefined\") { am = \"\"; }\n  client.fshAreaManual = am;\n}\nif (client.fshGap === undefined) {\n  var g = 90;\n  try { if (get_variable(\"fsh_gap\") !== undefined) { g = parseInt(get_variable(\"fsh_gap\"), 10); } } catch (e) { g = 90; }\n  if (!g || isNaN(g) || g < 5) { g = 90; }\n  if (g > 1440) { g = 1440; }\n  client.fshGap = g;\n}\nif (client.fshLearn === undefined) { client.fshLearn = false; }\nclient.fshRecentCap = 10;\nclient.fshLogCap = 30;\n// Ordered so consecutive anglers differ in hue AND lightness, not hue alone.\nclient.fshPalette = [\"#7fe0b4\", \"#e8a13f\", \"#a88fe0\", \"#5fb0e0\", \"#e0708f\", \"#c8d84a\", \"#d8845f\", \"#7fd8d8\"];\n\n// Area detection, recomputed on every call since fsh_ensure runs at the head\n// of every function. Nexus exposes GMCP room data under a name that varies by\n// setup, so several are tried; a manual override always wins and FPWHERE\n// reports which source actually answered.\nclient.fshAreaNow = \"\";\nclient.fshAreaSrc = \"\";\nif (client.fshAreaManual) {\n  client.fshAreaNow = client.fshAreaManual;\n  client.fshAreaSrc = \"manual\";\n} else {\n  // currentArea is maintained by the user's own GMCP handler, so it leads.\n  // The rest are fallbacks for a setup that does not define it.\n  var cand = [\"currentArea\", \"room_area\", \"my_area\", \"area\", \"roomarea\", \"room_zone\"];\n  var ci, cv;\n  for (ci = 0; ci < cand.length; ci++) {\n    cv = undefined;\n    try { cv = get_variable(cand[ci]); } catch (e) { cv = undefined; }\n    if (cv !== undefined && cv !== null && String(cv).length > 0 && String(cv) !== \"undefined\") {\n      client.fshAreaNow = String(cv);\n      client.fshAreaSrc = cand[ci];\n      break;\n    }\n  }\n}"
  },
  {
   "type": "function",
   "name": "fsh_touch",
   "enabled": true,
   "code": "// Called before any catch or cast is booked. If the session has been idle\n// longer than the gap threshold, the old one is archived and a fresh one\n// started, so sessions delimit themselves without needing to be told.\nrun_function(\"fsh_ensure\", [], \"fishingstats\");\nvar s = client.fsh;\nvar now = Math.floor(new Date().getTime() / 1000);\nif (s.n > 0 && s.last && (now - s.last) > client.fshGap * 60) {\n  var mins = Math.round((now - s.last) / 60);\n  run_function(\"fsh_archive\", [], \"fishingstats\");\n  display_notice(\"[fishing] \" + mins + \" minutes idle, so the previous session was filed to the log. Starting a new one.\", \"cyan\");\n}\nclient.fsh.last = now;\nvar ar = client.fshAreaNow;\nif (ar) { client.fsh.areas[ar] = (client.fsh.areas[ar] || 0) + 1; }\nif (!client.fsh.year && client.fshRec.year) { client.fsh.year = client.fshRec.year; }"
  },
  {
   "type": "function",
   "name": "fsh_archive",
   "enabled": true,
   "code": "// Files the current session into the log and starts a blank one. A session\n// with nothing landed is discarded rather than logged.\nrun_function(\"fsh_ensure\", [], \"fishingstats\");\nvar s = client.fsh;\nif (s.n > 0) {\n  var ang = {};\n  var sp = {};\n  var k;\n  for (k in s.anglers) {\n    if (s.anglers.hasOwnProperty(k)) {\n      var a = s.anglers[k];\n      ang[k] = [a.n, a.oz, a.best, a.casts || 0, a.hooks || 0, a.bestSp || \"\"];\n    }\n  }\n  for (k in s.species) {\n    if (s.species.hasOwnProperty(k)) { sp[k] = [s.species[k].n, s.species[k].best, s.species[k].bestBy]; }\n  }\n  var areas = [];\n  for (k in s.areas) { if (s.areas.hasOwnProperty(k)) { areas.push(k); } }\n  client.fshLog.push({\n    s: s.start, e: s.last, ar: areas.join(\", \"), y: s.year || 0,\n    n: s.n, oz: 0, rec: s.rec || 0,\n    ft: s.castN > 0 ? Math.round(s.castFt / s.castN) : 0,\n    ang: ang, sp: sp\n  });\n  var tot = 0;\n  for (k in s.anglers) { if (s.anglers.hasOwnProperty(k)) { tot += s.anglers[k].oz; } }\n  client.fshLog[client.fshLog.length - 1].oz = tot;\n  while (client.fshLog.length > client.fshLogCap) { client.fshLog.shift(); }\n  try { set_variable(\"fsh_log\", JSON.stringify(client.fshLog)); } catch (e) {}\n}\nvar now = Math.floor(new Date().getTime() / 1000);\nclient.fsh = { start: now, last: now, anglers: {}, species: {}, recent: [], n: 0, areas: {}, year: client.fshRec.year || 0, rec: 0, castFt: 0, castN: 0 };\ntry { set_variable(\"fsh_session\", JSON.stringify(client.fsh)); } catch (e) {}\nrun_function(\"fsh_render\", [], \"fishingstats\");\nrun_function(\"fsh_log_render\", [], \"fishingstats\");"
  },
  {
   "type": "function",
   "name": "fsh_record",
   "enabled": true,
   "code": "// Records a landed fish. Callers set:\n//   client.fshIn = { angler: \"Oceana\", species: \"blue eel\", oz: 41 }\n// Trigger wording can change without touching the tally or the display.\nrun_function(\"fsh_ensure\", [], \"fishingstats\");\nrun_function(\"fsh_touch\", [], \"fishingstats\");\nvar inp = client.fshIn;\nclient.fshIn = null;\nif (inp && inp.angler && inp.species) {\n  var s = client.fsh;\n  var now = Math.floor(new Date().getTime() / 1000);\n  var who = String(inp.angler);\n  var sp = String(inp.species).toLowerCase();\n  var oz = parseInt(inp.oz, 10);\n  if (isNaN(oz) || oz < 0) { oz = 0; }\n\n  if (!s.anglers[who]) { s.anglers[who] = { n: 0, oz: 0, best: 0, bestSp: \"\", casts: 0, hooks: 0, sp: {} }; }\n  var a = s.anglers[who];\n  a.n += 1;\n  a.oz += oz;\n  if (oz > a.best) { a.best = oz; a.bestSp = sp; }\n  a.sp[sp] = (a.sp[sp] || 0) + 1;\n\n  if (!s.species[sp]) { s.species[sp] = { n: 0, oz: 0, best: 0, bestBy: \"\" }; }\n  var f = s.species[sp];\n  f.n += 1;\n  f.oz += oz;\n  if (oz > f.best) { f.best = oz; f.bestBy = who; }\n\n  s.n += 1;\n  s.recent.push([now, who, sp, oz]);\n  while (s.recent.length > client.fshRecentCap) { s.recent.shift(); }\n\n  // Compare against the yearly rankings if they have been read. Ranking rows\n  // truncate long species names, so a stored key that prefixes the caught\n  // name counts as the same fish.\n  var rec = client.fshRec.f;\n  var hit = null;\n  var key;\n  if (rec[sp]) { hit = rec[sp]; }\n  else {\n    for (key in rec) {\n      if (rec.hasOwnProperty(key) && key.length > 3 && sp.indexOf(key) === 0) { hit = rec[key]; break; }\n    }\n  }\n  if (hit && oz > hit[0]) {\n    s.rec = (s.rec || 0) + 1;\n    var lb1 = Math.floor(oz / 16);\n    display_notice(\"[fishing] \" + who + \"'s \" + sp + \" at \" + lb1 + \"lb \" + (oz % 16) + \"oz beats this year's ranking of \" + Math.floor(hit[0] / 16) + \"lb \" + (hit[0] % 16) + \"oz by \" + hit[1] + \".\", \"cyan\");\n  }\n\n  try { set_variable(\"fsh_session\", JSON.stringify(s)); } catch (e) {}\n  run_function(\"fsh_render\", [], \"fishingstats\");\n}"
  },
  {
   "type": "function",
   "name": "fsh_event",
   "enabled": true,
   "code": "// Counts casts and hooks so a landing rate can be shown.\n//   client.fshEvt = { angler: \"Oceana\", type: \"cast\" }   type: cast | hook\nrun_function(\"fsh_ensure\", [], \"fishingstats\");\nrun_function(\"fsh_touch\", [], \"fishingstats\");\nvar ev = client.fshEvt;\nclient.fshEvt = null;\nif (ev && ev.angler && ev.type) {\n  var s = client.fsh;\n  var who = String(ev.angler);\n  if (!s.anglers[who]) { s.anglers[who] = { n: 0, oz: 0, best: 0, bestSp: \"\", casts: 0, hooks: 0, sp: {} }; }\n  var a = s.anglers[who];\n  if (!a.casts) { a.casts = 0; }\n  if (!a.hooks) { a.hooks = 0; }\n  if (ev.type === \"cast\") { a.casts += 1; }\n  else { a.hooks += 1; }\n  try { set_variable(\"fsh_session\", JSON.stringify(s)); } catch (e) {}\n  run_function(\"fsh_render\", [], \"fishingstats\");\n}"
  },
  {
   "type": "function",
   "name": "fsh_rank",
   "enabled": true,
   "code": "// Stores one row of a fishing rankings table.\n//   client.fshRank = { species, who, lb, oz, year }\n// RANKINGS FISHING prints two tables with identical layout: the year's bests\n// and the all-time bests since the last reset. Rows are attributed by which\n// header was seen last, with the row's own year as a second check, so the\n// all-time figures cannot overwrite the yearly ones.\nrun_function(\"fsh_ensure\", [], \"fishingstats\");\nvar r = client.fshRank;\nclient.fshRank = null;\nif (r && r.species) {\n  var oz = (parseInt(r.lb, 10) || 0) * 16 + (parseInt(r.oz, 10) || 0);\n  var key = String(r.species).toLowerCase();\n  var yr = parseInt(r.year, 10) || 0;\n  var mode = client.fshRankMode || \"\";\n\n  if (mode === \"year\" && yr === client.fshRec.year) {\n    if (!client.fshRec.f[key] || oz > client.fshRec.f[key][0]) {\n      client.fshRec.f[key] = [oz, String(r.who)];\n      try { set_variable(\"fsh_records\", JSON.stringify(client.fshRec)); } catch (e) {}\n    }\n  } else if (mode === \"reset\") {\n    // Kept for later use. Nothing displays these yet.\n    if (!client.fshRec.a) { client.fshRec.a = {}; }\n    if (!client.fshRec.a[key] || oz > client.fshRec.a[key][0]) {\n      client.fshRec.a[key] = [oz, String(r.who)];\n      try { set_variable(\"fsh_records\", JSON.stringify(client.fshRec)); } catch (e) {}\n    }\n  }\n}"
  },
  {
   "type": "function",
   "name": "fsh_render",
   "enabled": true,
   "code": "run_function(\"fsh_ensure\", [], \"fishingstats\");\n// Draws the 'fishingstats' tab: the live session.\n// House style shared in spirit with Coffers, Level and Ledger: ink panel,\n// serif small-caps headings, one large figure, monospace ledger rows.\nvar WATER = \"#7fd0c0\";\nvar DEEP = \"#3f7a72\";\nvar CATCH = \"#e6d27a\";\nvar TXT = \"#dbe8e4\";\nvar MUTED = \"#7f8f8b\";\nvar RULE = \"#20312d\";\nvar TRACK = \"#17241f\";\nvar RECORD = \"#b8d88a\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\n\nfunction esc(t) { return String(t).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\nfunction pad2(n) { return (n < 10 ? \"0\" : \"\") + n; }\nfunction clock(t) { var d = new Date(t * 1000); return d.getHours() + \":\" + pad2(d.getMinutes()); }\nfunction dur(secs) {\n  if (secs < 60) { return secs + \"s\"; }\n  if (secs < 3600) { return Math.round(secs / 60) + \"m\"; }\n  var h = Math.floor(secs / 3600);\n  var m = Math.round((secs - h * 3600) / 60);\n  return h + \"h\" + (m > 0 ? \" \" + m + \"m\" : \"\");\n}\nfunction wt(oz) {\n  oz = Math.round(oz);\n  var lb = Math.floor(oz / 16);\n  var o = oz % 16;\n  if (lb === 0) { return o + \"oz\"; }\n  return lb + \"lb\" + (o > 0 ? \" \" + o + \"oz\" : \"\");\n}\n// House typography, shared in spirit (not in code) with Coffers, Level and Ledger.\nfunction caps(t, col) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (col || DEEP) + ';font-size:11px;margin:0 0 3px;\">' + t + '</div>'; }\nfunction row(label, value, col) {\n  return '<div style=\"display:flex;justify-content:space-between;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"color:' + MUTED + ';white-space:nowrap;\">' + label + '</span><span style=\"color:' + (col || TXT) + ';white-space:nowrap;\">' + value + '</span></div>';\n}\nfunction box(inner, col) { return '<div style=\"flex:1 1 150px;min-width:150px;border-top:2px solid ' + (col || DEEP) + ';padding:3px 2px 0;\">' + inner + '</div>'; }\nfunction section(title, inner, extra) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title + (extra || \"\"), WATER) + inner + '</div>'; }\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">' + t + '</div>'; }\nfunction swatch(c) { return '<span style=\"display:inline-block;width:8px;height:8px;background:' + c + ';margin-right:4px;vertical-align:0;\"></span>'; }\n\n// A small leaping fish over a ripple, the fishing tabs' counterpart of the coin stack.\nvar glyph = '<svg width=\"20\" height=\"16\" viewBox=\"0 0 20 16\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<path d=\"M3 9 C6 3.5 12 3 15.5 6.5 C12 9.5 6 10 3 9 Z\" fill=\"' + WATER + '\"/>' +\n  '<path d=\"M15 6.3 L19 3.5 L18.2 7 L19 10 Z\" fill=\"' + WATER + '\"/><circle cx=\"6\" cy=\"7.2\" r=\"0.8\" fill=\"#0d1514\"/>' +\n  '<path d=\"M1 13.5 Q4 12 7 13.5 T13 13.5 T19 13.5\" fill=\"none\" stroke=\"' + DEEP + '\" stroke-width=\"1\"/></svg>';\nfunction header(title, right) {\n  return '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">' +\n    '<div style=\"font-family:' + SERIF + ';color:' + WATER + ';font-size:14px;letter-spacing:0.22em;\">' + glyph + title + '</div>' +\n    '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + DEEP + ';font-size:11px;\">' + right + '</div></div>';\n}\nfunction hero(num, tail) {\n  return '<div style=\"margin:6px 0 2px;\"><span style=\"font-family:' + SERIF + ';font-size:26px;color:' + WATER + ';\">' + num + '</span> ' +\n    '<span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">' + tail + '</span></div>';\n}\nvar PANEL = '<div style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:#0d1514;border:1px solid ' + RULE + ';padding:7px 8px 8px;\">';\n\nvar s = client.fsh;\nvar pal = client.fshPalette;\nvar rec = client.fshRec.f;\n\n// Ranking rows truncate long names, so a stored key that prefixes the caught\n// species counts as the same fish.\nfunction recFor(sp) {\n  if (rec[sp]) { return rec[sp]; }\n  var k;\n  for (k in rec) {\n    if (rec.hasOwnProperty(k) && k.length > 3 && sp.indexOf(k) === 0) { return rec[k]; }\n  }\n  return null;\n}\n// One angler: name and count over a bar in their colour, details beneath.\nfunction barRow(label, right, note, value, max, colour, me) {\n  var pct = max > 0 ? Math.round((value / max) * 100) : 0;\n  if (pct < 1 && value > 0) { pct = 1; }\n  var out = '<div style=\"margin:0 0 5px;\">';\n  out += '<div style=\"display:flex;justify-content:space-between;\"><span style=\"color:' + (me ? \"#ffffff\" : TXT) + ';\">' + swatch(colour) + esc(label) + (me ? ' <span style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">(you)</span>' : '') + '</span>';\n  out += '<span style=\"color:' + TXT + ';\">' + right + '</span></div>';\n  out += '<div style=\"background:' + TRACK + ';height:6px;width:100%;margin:2px 0 1px;\"><div style=\"background:' + colour + ';height:6px;width:' + pct + '%;\"></div></div>';\n  if (note) { out += '<div style=\"color:' + MUTED + ';\">' + note + '</div>'; }\n  return out + '</div>';\n}\n// Species bars are split into one segment per angler, all drawn on the same\n// scale as each other, so a segment's length is comparable across species as\n// well as within one.\nfunction stackRow(label, right, segs, notes, max) {\n  var out = '<div style=\"margin:0 0 5px;\">';\n  out += '<div style=\"display:flex;justify-content:space-between;\"><span style=\"color:' + TXT + ';\">' + esc(label) + '</span><span style=\"color:' + TXT + ';\">' + right + '</span></div>';\n  out += '<div style=\"background:' + TRACK + ';height:6px;width:100%;margin:2px 0 1px;display:flex;\">';\n  var i;\n  for (i = 0; i < segs.length; i++) {\n    var w = max > 0 ? (segs[i].n / max) * 100 : 0;\n    out += '<div title=\"' + esc(segs[i].who) + ' ' + segs[i].n + '\" style=\"background:' + segs[i].colour + ';height:6px;width:' + (Math.round(w * 10) / 10) + '%;' + (i < segs.length - 1 ? 'margin-right:1px;' : '') + '\"></div>';\n  }\n  out += '</div>';\n  for (i = 0; i < notes.length; i++) { out += '<div style=\"color:' + MUTED + ';\">' + notes[i] + '</div>'; }\n  return out + '</div>';\n}\nfunction byAnglerCount(a, b) { return s.anglers[b].n - s.anglers[a].n; }\nfunction bySpeciesCount(a, b) { return s.species[b].n - s.species[a].n; }\n\nvar now = Math.floor(new Date().getTime() / 1000);\nvar elapsed = now - (s.start || now);\nif (elapsed < 1) { elapsed = 1; }\n\nvar totHook = 0, totCast = 0, totOz = 0, kk;\nvar names = [];\nfor (kk in s.anglers) {\n  if (s.anglers.hasOwnProperty(kk)) {\n    names.push(kk);\n    totHook += s.anglers[kk].hooks || 0;\n    totCast += s.anglers[kk].casts || 0;\n    totOz += s.anglers[kk].oz || 0;\n  }\n}\nvar areaList = [];\nfor (kk in s.areas) { if (s.areas.hasOwnProperty(kk)) { areaList.push(kk); } }\n\nvar html = PANEL + header(\"FISHING\", dur(elapsed) + (s.year ? ' &middot; ' + s.year + ' AF' : ''));\n\nif (s.n === 0 && names.length === 0) {\n  html += hero(\"0\", \"fish landed so far\");\n  html += quiet(\"Nothing yet this session. Cast a line, or run FPDEMO to preview the layout.\");\n} else {\n  html += hero(String(s.n), (s.n === 1 ? \"fish\" : \"fish\") + \" landed\" + (totOz > 0 ? \", \" + wt(totOz) + \" in all\" : \"\"));\n  // Where: flag a pinned area so a stale manual override is visible rather\n  // than looking like a detection failure.\n  if (areaList.length > 0) {\n    html += '<div style=\"color:' + MUTED + ';\">at <span style=\"color:' + TXT + ';font-family:' + SERIF + ';\">' + esc(areaList.join(\", \")) + '</span>' + (client.fshAreaSrc === \"manual\" ? ' <span style=\"font-style:italic;font-family:' + SERIF + ';\">(pinned)</span>' : '') + '</div>';\n  } else {\n    html += '<div style=\"color:' + MUTED + ';\">area unknown &mdash; FPAREA to set</div>';\n  }\n\n  // Two ledger columns: the pace of the session, and its prize catch.\n  var lost = totHook - s.n;\n  var cols = '<div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;\">';\n  var pb = caps(\"The session\", WATER);\n  pb += row(\"per hour\", s.n > 0 ? String(Math.round((s.n / (elapsed / 3600)) * 10) / 10) : \"&hellip;\", s.n > 0 ? WATER : MUTED);\n  pb += row(\"landed / cast\", totCast > 0 ? s.n + \"/\" + totCast + \" (\" + Math.round((s.n / totCast) * 100) + \"%)\" : \"&mdash;\");\n  pb += row(\"got away\", lost > 0 ? String(lost) : \"none\", lost > 0 ? \"#de8a72\" : MUTED);\n  pb += row(\"avg cast\", s.castN > 0 ? Math.round(s.castFt / s.castN) + \"ft\" : \"&mdash;\", s.castN > 0 ? TXT : MUTED);\n  cols += box(pb, WATER);\n\n  var bestOz = 0, bestWho = \"\", bestSp = \"\";\n  for (kk = 0; kk < names.length; kk++) {\n    var an = s.anglers[names[kk]];\n    if (an.best > bestOz) { bestOz = an.best; bestWho = names[kk]; bestSp = an.bestSp || \"\"; }\n  }\n  var spCount = 0;\n  for (kk in s.species) { if (s.species.hasOwnProperty(kk)) { spCount++; } }\n  var bb = caps(\"Prize catch\", CATCH);\n  if (bestOz > 0) {\n    bb += '<div style=\"font-family:' + SERIF + ';font-size:16px;color:' + CATCH + ';\">' + wt(bestOz) + '</div>';\n    bb += row(\"species\", esc(bestSp));\n    bb += row(\"by\", esc(bestWho), bestWho === client.fshMe ? \"#ffffff\" : TXT);\n  } else {\n    bb += quiet(\"Nothing weighed yet.\");\n  }\n  bb += row(\"species seen\", String(spCount));\n  if (s.rec > 0) { bb += row(\"rankings beaten\", String(s.rec), RECORD); }\n  cols += box(bb, CATCH);\n  html += cols + '</div>';\n\n  names.sort(byAnglerCount);\n  var maxN = 0;\n  var k;\n  for (k = 0; k < names.length; k++) { if (s.anglers[names[k]].n > maxN) { maxN = s.anglers[names[k]].n; } }\n  var colourOf = {};\n  for (k = 0; k < names.length; k++) { colourOf[names[k]] = client.fshCol[names[k]] || pal[k % pal.length]; }\n\n  var ab = \"\";\n  for (k = 0; k < names.length; k++) {\n    var a = s.anglers[names[k]];\n    var share = s.n > 0 ? Math.round((a.n / s.n) * 100) : 0;\n    var note = 'total ' + wt(a.oz);\n    if (a.best > 0) { note += ' &middot; best ' + wt(a.best) + ' ' + esc(a.bestSp); }\n    if (a.casts > 0) { note += ' &middot; ' + Math.round((a.n / a.casts) * 100) + '% of casts landed'; }\n    ab += barRow(names[k], a.n + ' <span style=\"color:' + MUTED + ';\">&middot; ' + share + '%</span>', note, a.n, maxN, colourOf[names[k]], names[k] === client.fshMe);\n  }\n  html += section(\"By angler\", ab);\n\n  var sp = [];\n  for (k in s.species) { if (s.species.hasOwnProperty(k)) { sp.push(k); } }\n  if (sp.length > 0) {\n    sp.sort(bySpeciesCount);\n    var maxS = s.species[sp[0]].n;\n    var shown = sp.length > 10 ? 10 : sp.length;\n    var sb = \"\";\n    if (names.length > 1) {\n      sb += '<div style=\"margin:0 0 5px;\">';\n      for (k = 0; k < names.length; k++) { sb += '<span style=\"margin-right:9px;white-space:nowrap;color:' + MUTED + ';\">' + swatch(colourOf[names[k]]) + esc(names[k]) + '</span>'; }\n      sb += '</div>';\n    }\n    for (k = 0; k < shown; k++) {\n      var f = s.species[sp[k]];\n      var segs = [];\n      var parts = [];\n      var q;\n      for (q = 0; q < names.length; q++) {\n        var cnt = s.anglers[names[q]].sp ? (s.anglers[names[q]].sp[sp[k]] || 0) : 0;\n        if (cnt > 0) {\n          segs.push({ who: names[q], n: cnt, colour: colourOf[names[q]] });\n          parts.push('<span style=\"color:' + colourOf[names[q]] + ';\">' + esc(names[q]) + ' ' + cnt + '</span>');\n        }\n      }\n      var notes = [];\n      if (parts.length > 1) { notes.push(parts.join(' &middot; ')); }\n      var note2 = 'avg ' + wt(f.oz / f.n) + ' &middot; best ' + wt(f.best) + ' (' + esc(f.bestBy) + ')';\n      var rr = recFor(sp[k]);\n      if (rr) { note2 += ' &middot; <span style=\"color:' + RECORD + ';\">year&rsquo;s best ' + wt(rr[0]) + ' ' + esc(rr[1]) + '</span>'; }\n      notes.push(note2);\n      sb += stackRow(sp[k], String(f.n), segs, notes, maxS);\n    }\n    html += section(\"By species\", sb, sp.length > shown ? ' <span style=\"font-variant:normal;letter-spacing:0;font-style:italic;color:' + MUTED + ';\">top ' + shown + ' of ' + sp.length + '</span>' : '');\n  }\n\n  if (s.recent.length > 0) {\n    var rb = \"\";\n    for (k = s.recent.length - 1; k >= 0; k--) {\n      var r2 = s.recent[k];\n      var isMe = (r2[1] === client.fshMe);\n      rb += '<div style=\"display:flex;gap:8px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\">';\n      rb += '<span style=\"color:' + MUTED + ';min-width:3em;\">' + clock(r2[0]) + '</span>';\n      rb += '<span style=\"color:' + (colourOf[r2[1]] || TXT) + ';min-width:5.5em;' + (isMe ? 'font-weight:bold;' : '') + '\">' + esc(r2[1]) + '</span>';\n      rb += '<span style=\"flex:1 1 auto;color:' + TXT + ';\">' + esc(r2[2]) + '</span>';\n      rb += '<span style=\"color:' + CATCH + ';white-space:nowrap;\">' + wt(r2[3]) + '</span></div>';\n    }\n    html += section(\"Recent catches\", rb);\n  }\n}\nhtml += '</div>';\n\ntry { set_custom_tab_html(\"fishingstats\", html); } catch (e) {}"
  },
  {
   "type": "function",
   "name": "fsh_log_render",
   "enabled": true,
   "code": "run_function(\"fsh_ensure\", [], \"fishingstats\");\n// Draws the 'fishinglog' tab: filed sessions and all-time totals.\n// House style shared in spirit with Coffers, Level and Ledger: ink panel,\n// serif small-caps headings, one large figure, monospace ledger rows.\nvar WATER = \"#7fd0c0\";\nvar DEEP = \"#3f7a72\";\nvar CATCH = \"#e6d27a\";\nvar TXT = \"#dbe8e4\";\nvar MUTED = \"#7f8f8b\";\nvar RULE = \"#20312d\";\nvar TRACK = \"#17241f\";\nvar RECORD = \"#b8d88a\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\n\nfunction esc(t) { return String(t).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\nfunction pad2(n) { return (n < 10 ? \"0\" : \"\") + n; }\nfunction clock(t) { var d = new Date(t * 1000); return d.getHours() + \":\" + pad2(d.getMinutes()); }\nfunction dur(secs) {\n  if (secs < 60) { return secs + \"s\"; }\n  if (secs < 3600) { return Math.round(secs / 60) + \"m\"; }\n  var h = Math.floor(secs / 3600);\n  var m = Math.round((secs - h * 3600) / 60);\n  return h + \"h\" + (m > 0 ? \" \" + m + \"m\" : \"\");\n}\nfunction wt(oz) {\n  oz = Math.round(oz);\n  var lb = Math.floor(oz / 16);\n  var o = oz % 16;\n  if (lb === 0) { return o + \"oz\"; }\n  return lb + \"lb\" + (o > 0 ? \" \" + o + \"oz\" : \"\");\n}\n// House typography, shared in spirit (not in code) with Coffers, Level and Ledger.\nfunction caps(t, col) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (col || DEEP) + ';font-size:11px;margin:0 0 3px;\">' + t + '</div>'; }\nfunction row(label, value, col) {\n  return '<div style=\"display:flex;justify-content:space-between;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"color:' + MUTED + ';white-space:nowrap;\">' + label + '</span><span style=\"color:' + (col || TXT) + ';white-space:nowrap;\">' + value + '</span></div>';\n}\nfunction box(inner, col) { return '<div style=\"flex:1 1 150px;min-width:150px;border-top:2px solid ' + (col || DEEP) + ';padding:3px 2px 0;\">' + inner + '</div>'; }\nfunction section(title, inner, extra) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title + (extra || \"\"), WATER) + inner + '</div>'; }\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">' + t + '</div>'; }\nfunction swatch(c) { return '<span style=\"display:inline-block;width:8px;height:8px;background:' + c + ';margin-right:4px;vertical-align:0;\"></span>'; }\n\n// A small leaping fish over a ripple, the fishing tabs' counterpart of the coin stack.\nvar glyph = '<svg width=\"20\" height=\"16\" viewBox=\"0 0 20 16\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<path d=\"M3 9 C6 3.5 12 3 15.5 6.5 C12 9.5 6 10 3 9 Z\" fill=\"' + WATER + '\"/>' +\n  '<path d=\"M15 6.3 L19 3.5 L18.2 7 L19 10 Z\" fill=\"' + WATER + '\"/><circle cx=\"6\" cy=\"7.2\" r=\"0.8\" fill=\"#0d1514\"/>' +\n  '<path d=\"M1 13.5 Q4 12 7 13.5 T13 13.5 T19 13.5\" fill=\"none\" stroke=\"' + DEEP + '\" stroke-width=\"1\"/></svg>';\nfunction header(title, right) {\n  return '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">' +\n    '<div style=\"font-family:' + SERIF + ';color:' + WATER + ';font-size:14px;letter-spacing:0.22em;\">' + glyph + title + '</div>' +\n    '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + DEEP + ';font-size:11px;\">' + right + '</div></div>';\n}\nfunction hero(num, tail) {\n  return '<div style=\"margin:6px 0 2px;\"><span style=\"font-family:' + SERIF + ';font-size:26px;color:' + WATER + ';\">' + num + '</span> ' +\n    '<span style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:12px;\">' + tail + '</span></div>';\n}\nvar PANEL = '<div style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:#0d1514;border:1px solid ' + RULE + ';padding:7px 8px 8px;\">';\n\nvar log = client.fshLog || [];\nvar pal = client.fshPalette;\n\nfunction stamp(t) {\n  if (!t || isNaN(Number(t))) { return \"undated\"; }\n  var MN = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"];\n  var d = new Date(t * 1000);\n  return d.getDate() + \" \" + MN[d.getMonth()] + \" \" + d.getHours() + \":\" + pad2(d.getMinutes());\n}\nvar perAngler = {};\nvar curL = null;\nfunction byTotal(a, b) { return perAngler[b][0] - perAngler[a][0]; }\nfunction bySessionCount(a, b) { return curL.ang[b][0] - curL.ang[a][0]; }\n\nvar html = PANEL;\nif (log.length === 0) {\n  html += header(\"FISHING LOG\", \"0 sessions\");\n  html += quiet(\"No sessions filed yet. A session is filed automatically after \" + client.fshGap + \" minutes idle, or on demand with FPEND.\");\n} else {\n  // Aggregate across everything logged.\n  var tn = 0, toz = 0, tsec = 0, trec = 0, tnTimed = 0;\n  var bestOz = 0, bestSp = \"\", bestWho = \"\";\n  var perSpecies = {};\n  var i, k;\n  for (i = 0; i < log.length; i++) {\n    var L = log[i];\n    tn += L.n;\n    toz += L.oz || 0;\n    // Older entries can lack a start or end time; count only the sound ones.\n    var lsec = Number(L.e) - Number(L.s);\n    if (!isNaN(lsec) && lsec > 0) { tsec += lsec; tnTimed += L.n; }\n    trec += L.rec || 0;\n    for (k in L.ang) {\n      if (L.ang.hasOwnProperty(k)) {\n        if (!perAngler[k]) { perAngler[k] = [0, 0, 0, \"\"]; }\n        perAngler[k][0] += L.ang[k][0];\n        perAngler[k][1] += L.ang[k][1];\n        if (L.ang[k][2] > perAngler[k][2]) { perAngler[k][2] = L.ang[k][2]; perAngler[k][3] = L.ang[k][5] || \"\"; }\n        if (L.ang[k][2] > bestOz) { bestOz = L.ang[k][2]; bestWho = k; bestSp = L.ang[k][5] || \"\"; }\n      }\n    }\n    for (k in L.sp) { if (L.sp.hasOwnProperty(k)) { perSpecies[k] = (perSpecies[k] || 0) + L.sp[k][0]; } }\n  }\n  var spCount = 0;\n  for (k in perSpecies) { if (perSpecies.hasOwnProperty(k)) { spCount += 1; } }\n\n  html += header(\"FISHING LOG\", log.length + \" session\" + (log.length === 1 ? \"\" : \"s\"));\n  html += hero(String(tn), \"fish landed\" + (tsec > 0 ? \" over \" + dur(tsec) : \"\") + (toz > 0 ? \", \" + wt(toz) + \" in all\" : \"\"));\n\n  var cols = '<div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;\">';\n  var tb = caps(\"All sessions\", WATER);\n  tb += row(\"time fished\", dur(tsec));\n  tb += row(\"per hour\", tsec > 0 ? String(Math.round(tnTimed / (tsec / 3600) * 10) / 10) : \"&hellip;\", WATER);\n  tb += row(\"species seen\", String(spCount));\n  if (trec > 0) { tb += row(\"rankings beaten\", String(trec), RECORD); }\n  cols += box(tb, WATER);\n  var bb = caps(\"Biggest ever\", CATCH);\n  if (bestOz > 0) {\n    bb += '<div style=\"font-family:' + SERIF + ';font-size:16px;color:' + CATCH + ';\">' + wt(bestOz) + '</div>';\n    bb += row(\"species\", esc(bestSp));\n    bb += row(\"by\", esc(bestWho), bestWho === client.fshMe ? \"#ffffff\" : TXT);\n  } else {\n    bb += quiet(\"Nothing weighed yet.\");\n  }\n  cols += box(bb, CATCH);\n  html += cols + '</div>';\n\n  var an = [];\n  for (k in perAngler) { if (perAngler.hasOwnProperty(k)) { an.push(k); } }\n  an.sort(byTotal);\n  var tot = \"\";\n  var maxA = an.length > 0 ? perAngler[an[0]][0] : 0;\n  for (i = 0; i < an.length; i++) {\n    var colour = client.fshCol[an[i]] || pal[i % pal.length];\n    var pa = perAngler[an[i]];\n    var pct = maxA > 0 ? Math.round(pa[0] / maxA * 100) : 0;\n    tot += '<div style=\"display:flex;align-items:center;gap:6px;margin-top:2px;\">';\n    tot += '<span style=\"width:76px;color:' + (an[i] === client.fshMe ? \"#ffffff\" : TXT) + ';overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">' + swatch(colour) + esc(an[i]) + '</span>';\n    tot += '<span style=\"flex:1;background:' + TRACK + ';height:6px;\"><span style=\"display:block;background:' + colour + ';height:6px;width:' + pct + '%;\"></span></span>';\n    tot += '<span style=\"width:108px;text-align:right;color:' + TXT + ';white-space:nowrap;\">' + pa[0] + ' <span style=\"color:' + MUTED + ';\">&middot; ' + wt(pa[1]) + '</span></span></div>';\n  }\n  html += section(\"Anglers, all time\", tot);\n\n  // One entry per session, newest first.\n  var sb = \"\";\n  for (i = log.length - 1; i >= 0; i--) {\n    var L2 = log[i];\n    curL = L2;\n    sb += '<div style=\"border-bottom:1px dotted ' + RULE + ';padding:2px 0 5px;margin:0 0 3px;\">';\n    sb += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;\">';\n    sb += '<span style=\"font-family:' + SERIF + ';color:' + TXT + ';font-size:12px;\">' + stamp(L2.s) + '</span>';\n    sb += '<span style=\"color:' + TXT + ';\">' + L2.n + ' <span style=\"color:' + MUTED + ';\">&middot; ' + (isNaN(Number(L2.e) - Number(L2.s)) ? '?' : dur(L2.e - L2.s)) + ' &middot; ' + wt(L2.oz || 0) + '</span></span></div>';\n    var meta = [];\n    if (L2.ar) { meta.push('<span style=\"color:' + WATER + ';\">' + esc(L2.ar) + '</span>'); }\n    if (L2.y) { meta.push(L2.y + ' AF'); }\n    if (L2.ft) { meta.push('avg cast ' + L2.ft + 'ft'); }\n    if (L2.rec) { meta.push('<span style=\"color:' + RECORD + ';\">' + L2.rec + ' ranking' + (L2.rec === 1 ? \"\" : \"s\") + ' beaten</span>'); }\n    if (meta.length > 0) { sb += '<div style=\"color:' + MUTED + ';\">' + meta.join(' &middot; ') + '</div>'; }\n\n    var names = [];\n    for (k in L2.ang) { if (L2.ang.hasOwnProperty(k)) { names.push(k); } }\n    names.sort(bySessionCount);\n    var maxN = names.length > 0 ? L2.ang[names[0]][0] : 0;\n    var j;\n    for (j = 0; j < names.length; j++) {\n      var A = L2.ang[names[j]];\n      var colour2 = client.fshCol[names[j]] || pal[j % pal.length];\n      var pc = maxN > 0 ? Math.round((A[0] / maxN) * 100) : 0;\n      var lostN = (A[4] || 0) - A[0];\n      sb += '<div style=\"display:flex;align-items:center;gap:6px;margin-top:2px;\">';\n      sb += '<span style=\"width:76px;color:' + (names[j] === client.fshMe ? \"#ffffff\" : TXT) + ';overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">' + esc(names[j]) + '</span>';\n      sb += '<span style=\"flex:1;background:' + TRACK + ';height:5px;\"><span style=\"display:block;background:' + colour2 + ';height:5px;width:' + pc + '%;\"></span></span>';\n      sb += '<span style=\"width:108px;text-align:right;color:' + MUTED + ';white-space:nowrap;\"><span style=\"color:' + TXT + ';\">' + A[0] + '</span> &middot; ' + wt(A[1]) + (lostN > 0 ? ' &middot; ' + lostN + ' lost' : '') + '</span></div>';\n    }\n    sb += '</div>';\n  }\n  html += section(\"Sessions\", sb);\n}\nhtml += '</div>';\n\ntry { set_custom_tab_html(\"fishinglog\", html); } catch (e) {}"
  },
  {
   "type": "trigger",
   "name": "Fish Landed Self",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "run_function(\"fsh_ensure\", [], \"fishingstats\");\nclient.fshIn = { angler: client.fshMe, species: args[1], oz: (parseInt(args[2], 10) || 0) * 16 + (parseInt(args[3], 10) || 0) };\nrun_function(\"fsh_record\", [], \"fishingstats\");"
    }
   ],
