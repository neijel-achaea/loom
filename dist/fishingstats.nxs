{
 "type": "group",
 "name": "fishingstats",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"fishingstats_setup\", [], \"fishingstats\");\ndisplay_notice(\"[fishingstats] installed. Create UI tabs named 'fishingstats' and 'fishinglog'. Casts, hooks and catches are counted for you and everyone around you. Type RANKINGS FISHING once to load this year's records. FISHINGSTATS HELP for commands.\", \"cyan\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; the fishingstats_* variables are left intact.\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icons: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo them.\nvar tiTabs = [[\"fishingstats\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 16\"><path d=\"M3 9 C6 3.5 12 3 15.5 6.5 C12 9.5 6 10 3 9 Z\" fill=\"#7fd0c0\"/><path d=\"M15 6.3 L19 3.5 L18.2 7 L19 10 Z\" fill=\"#7fd0c0\"/><circle cx=\"6\" cy=\"7.2\" r=\"0.8\" fill=\"#0d1514\"/><path d=\"M1 13.5 Q4 12 7 13.5 T13 13.5 T19 13.5\" fill=\"none\" stroke=\"#3f7a72\" stroke-width=\"1\"/></svg>'], [\"fishinglog\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 16\"><path d=\"M3 9 C6 3.5 12 3 15.5 6.5 C12 9.5 6 10 3 9 Z\" fill=\"#3f7a72\"/><path d=\"M15 6.3 L19 3.5 L18.2 7 L19 10 Z\" fill=\"#3f7a72\"/><circle cx=\"6\" cy=\"7.2\" r=\"0.8\" fill=\"#0d1514\"/><path d=\"M1 12.5 H19 M1 15 H19\" stroke=\"#7fd0c0\" stroke-width=\"1\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\nrun_function(\"fishingstats_setup\", [], \"fishingstats\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Room.Info gives the area fished in; Char.Name your own name, used as your\n// angler name unless FISHINGSTATS ME sets one.\nvar fsM = \"\";\nvar fsA = null;\ntry { fsM = args.gmcp_method; fsA = args.gmcp_args; } catch (e) { fsM = \"\"; }\nif ((fsM === \"Room.Info\" || fsM === \"Char.Name\") && fsA) {\n  if (typeof fsA === \"string\") { try { fsA = JSON.parse(fsA); } catch (e) { fsA = null; } }\n  if (fsA) {\n    if (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\n    var FS = client.loom.fishingstats;\n    if (fsM === \"Room.Info\" && fsA.area) {\n      FS.areaGmcp = String(fsA.area);\n      if (!FS.areaManual) { FS.areaNow = FS.areaGmcp; FS.areaSrc = \"GMCP\"; }\n    }\n    if (fsM === \"Char.Name\" && fsA.name) {\n      FS.gmcpName = String(fsA.name);\n      if (!FS.meSet) FS.me = FS.gmcpName;\n    }\n  }\n}\n"
  },
  {
   "type": "group",
   "name": "core",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "fishingstats_setup",
     "enabled": true,
     "code": "// fishingstats_setup -- run from onLoad and onInstall, and by any reflex that\n// finds the namespace missing. Namespace, registry, one-time migration of the\n// fsh_* variables, then each piece built from stored variables if missing.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.fishingstats) client.loom.fishingstats = {};\nclient.loom.registry.fishingstats = { version: \"0.2.0\", keyword: \"FISHINGSTATS\" };\nvar FS = client.loom.fishingstats;\n\nfunction fsGet(name) {\n  var v;\n  try { v = get_variable(name); } catch (e) { v = undefined; }\n  return (v === null || v === \"undefined\") ? undefined : v;\n}\n\n// One-time migration: fsh_* -> fishingstats_*. A new variable that already\n// holds data wins; the old one is deleted either way.\nvar fsMoves = [\"session\", \"log\", \"records\", \"me\", \"colours\", \"area\", \"gap\"];\nfor (var fsI = 0; fsI < fsMoves.length; fsI++) {\n  var fsOld = fsGet(\"fsh_\" + fsMoves[fsI]);\n  if (fsOld !== undefined) {\n    var fsNew = fsGet(\"fishingstats_\" + fsMoves[fsI]);\n    if (fsNew === undefined || fsNew === \"\") set_variable(\"fishingstats_\" + fsMoves[fsI], fsOld);\n    delete_variable(\"fsh_\" + fsMoves[fsI]);\n  }\n}\n// The old package kept its state in 18 loose client.fsh* keys; drop them so a\n// reimport without a page reload doesn't leave two copies around. The open\n// session in memory carries over.\nvar fsOldKeys = [\"fsh\", \"fshAreaManual\", \"fshAreaNow\", \"fshAreaSrc\", \"fshBuf\", \"fshCol\", \"fshEvt\", \"fshGap\", \"fshIn\", \"fshLearn\", \"fshLog\", \"fshLogCap\", \"fshMe\", \"fshPalette\", \"fshRank\", \"fshRankMode\", \"fshRec\", \"fshRecentCap\"];\nif (client.fsh && client.fsh.anglers && !FS.session) FS.session = client.fsh;\nfor (var fsJ = 0; fsJ < fsOldKeys.length; fsJ++) {\n  if (client[fsOldKeys[fsJ]] !== undefined) delete client[fsOldKeys[fsJ]];\n}\n\n// Weights are stored as whole ounces. Achaea reports pounds and ounces, so an\n// integer count avoids float drift and formats back exactly.\nFS.blank = function () {\n  var now = Math.floor(new Date().getTime() / 1000);\n  return {\n    start: now, last: now,\n    anglers: {}, species: {}, recent: [], n: 0,\n    areas: {}, year: (client.loom.fishingstats.rec && client.loom.fishingstats.rec.year) || 0, rec: 0, castFt: 0, castN: 0\n  };\n};\nif (!FS.rec) {\n  var r = null;\n  try { r = JSON.parse(fsGet(\"fishingstats_records\")); } catch (e) { r = null; }\n  if (!r || typeof r !== \"object\") { r = { year: 0, f: {}, a: {} }; }\n  if (!r.f) { r.f = {}; }\n  if (!r.a) { r.a = {}; }\n  FS.rec = r;\n}\nif (!FS.session) {\n  var s = null;\n  try { s = JSON.parse(fsGet(\"fishingstats_session\")); } catch (e) { s = null; }\n  if (!s || typeof s !== \"object\" || !s.anglers) { s = FS.blank(); }\n  FS.session = s;\n}\nvar fsS = FS.session;\nif (!fsS.species) { fsS.species = {}; }\nif (!fsS.recent) { fsS.recent = []; }\nif (!fsS.areas) { fsS.areas = {}; }\nif (!fsS.n) { fsS.n = 0; }\nif (!fsS.rec) { fsS.rec = 0; }\nif (!fsS.castFt) { fsS.castFt = 0; }\nif (!fsS.castN) { fsS.castN = 0; }\nif (!fsS.last) { fsS.last = fsS.start || Math.floor(new Date().getTime() / 1000); }\nif (!FS.log) {\n  var lg = [];\n  try { lg = JSON.parse(fsGet(\"fishingstats_log\")) || []; } catch (e) { lg = []; }\n  if (Object.prototype.toString.call(lg) !== \"[object Array]\") { lg = []; }\n  FS.log = lg;\n}\nif (!FS.col) {\n  var c = null;\n  try { c = JSON.parse(fsGet(\"fishingstats_colours\")); } catch (e) { c = null; }\n  if (!c || typeof c !== \"object\") { c = {}; }\n  FS.col = c;\n}\n// Your angler name: FISHINGSTATS ME sets it; otherwise the name GMCP gives\n// (Char.Name), and \"You\" until that arrives.\nFS.meSet = String(fsGet(\"fishingstats_me\") || \"\");\nif (!FS.gmcpName) FS.gmcpName = \"\";\nFS.me = FS.meSet || FS.gmcpName || \"You\";\nvar fsG = parseInt(fsGet(\"fishingstats_gap\"), 10);\nif (!fsG || isNaN(fsG) || fsG < 5) { fsG = 90; }\nif (fsG > 1440) { fsG = 1440; }\nFS.gap = fsG;\nif (FS.learn === undefined) { FS.learn = false; }\nFS.recentCap = 10;\nFS.logCap = 30;\n// Ordered so consecutive anglers differ in hue AND lightness, not hue alone.\nFS.palette = [\"#7fe0b4\", \"#e8a13f\", \"#a88fe0\", \"#5fb0e0\", \"#e0708f\", \"#c8d84a\", \"#d8845f\", \"#7fd8d8\"];\n\n// Area: a manual pin (FISHINGSTATS AREA <name>) wins; otherwise the area\n// GMCP's Room.Info gave last (kept by this package's onGMCP).\nFS.areaManual = String(fsGet(\"fishingstats_area\") || \"\");\nif (!FS.areaGmcp) FS.areaGmcp = \"\";\nFS.areaNow = FS.areaManual || FS.areaGmcp;\nFS.areaSrc = FS.areaManual ? \"manual\" : (FS.areaGmcp ? \"GMCP\" : \"\");\n"
    },
    {
     "type": "function",
     "name": "fishingstats_help",
     "enabled": true,
     "code": "// fishingstats_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[fishingstats] catches, casts and hooks for you and everyone around you. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"FISHINGSTATS\", \"this session by angler, and the settings\"],\n  [\"FISHINGSTATS END\", \"file this session to the log and start a new one\"],\n  [\"FISHINGSTATS DISCARD [CONFIRM]\", \"throw this session away without filing it\"],\n  [\"FISHINGSTATS LOG [WIPE [CONFIRM]]\", \"redraw the fishinglog tab / clear the log\"],\n  [\"FISHINGSTATS GAP <5-1440>\", \"minutes idle before a session files itself\"],\n  [\"FISHINGSTATS AREA [<name>|AUTO|RESET]\", \"pin the area / follow the game / forget this session's\"],\n  [\"FISHINGSTATS YEAR <n>\", \"the Achaean year (normally read from RANKINGS FISHING)\"],\n  [\"FISHINGSTATS ME [<name>|AUTO]\", \"your angler name (normally your character's)\"],\n  [\"FISHINGSTATS COLOUR <name> <#rrggbb|RESET>\", \"an angler's colour in the tabs\"],\n  [\"FISHINGSTATS ADD <angler> <lb> [oz] <species>\", \"record a catch by hand\"],\n  [\"FISHINGSTATS CSV\", \"this session as CSV lines\"],\n  [\"FISHINGSTATS LEARN [ON|OFF|SHOW|CLEAR]\", \"capture raw lines to fix a missed catch message\"],\n  [\"FISHINGSTATS DEMO / DEBUG\", \"sample data in the tab / internal state\"],\n  [\"Type RANKINGS FISHING once a year so new records are flagged.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
    },
    {
     "type": "alias",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "// FISHINGSTATS [subcommand ...]: the one command for this package. The\n// subcommand is case-insensitive; names, species and colours keep their case.\nif (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\nvar fsSub = String(args[1] || \"\").toLowerCase();\nvar fsRest = String(args[2] || \"\").trim();\nvar fsW = fsRest === \"\" ? [] : fsRest.split(/\\s+/);\nvar fsW0 = (fsW[0] || \"\").toLowerCase();\nvar C = \"cyan\";\nfunction fsSay(t, col) { display_notice(\"[fishingstats] \" + t, col || C); }\nfunction fsSave() { try { set_variable(\"fishingstats_session\", JSON.stringify(FS.session)); } catch (e) {} }\n\nif (fsSub === \"\" || fsSub === \"status\") {\n  var s = FS.session;\n  var now = Math.floor(new Date().getTime() / 1000);\n  var el = now - (s.start || now);\n  if (el < 1) { el = 1; }\n  fsSay(s.n + \" catches over \" + Math.round(el / 60) + \" min; you are \" + FS.me + (FS.meSet ? \"\" : \" (from the game)\")\n    + \"; area \" + (FS.areaNow || \"unknown\") + (FS.areaSrc === \"manual\" ? \" (pinned)\" : \"\")\n    + \"; filed after \" + FS.gap + \" min idle; \" + FS.log.length + \" session(s) in the log. FISHINGSTATS HELP for commands.\");\n  for (var k in s.anglers) {\n    if (s.anglers.hasOwnProperty(k)) {\n      var a = s.anglers[k];\n      fsSay(k + \": \" + a.n + \" (\" + Math.round((a.n / Math.max(1, s.n)) * 100) + \"%), \" + Math.floor(a.oz / 16) + \"lb \" + (a.oz % 16) + \"oz total, best \" + Math.floor(a.best / 16) + \"lb \" + (a.best % 16) + \"oz \" + a.bestSp);\n    }\n  }\n  run_function(\"fishingstats_render\", [], \"fishingstats\");\n} else if (fsSub === \"help\") {\n  run_function(\"fishingstats_help\", [], \"fishingstats\");\n} else if (fsSub === \"end\") {\n  var had = FS.session.n;\n  run_function(\"fishingstats_archive\", [], \"fishingstats\");\n  if (had > 0) { fsSay(\"session filed to the log (\" + had + \" landed). New session started.\"); }\n  else { fsSay(\"nothing landed, so nothing was filed. Session restarted.\", \"yellow\"); }\n} else if (fsSub === \"discard\") {\n  if (fsW0 === \"confirm\") {\n    FS.session = FS.blank();\n    fsSave();\n    run_function(\"fishingstats_render\", [], \"fishingstats\");\n    fsSay(\"current session discarded, without filing it. New session started.\");\n  } else {\n    fsSay(\"this throws away the current session without filing it. FISHINGSTATS DISCARD CONFIRM to proceed.\", \"yellow\");\n  }\n} else if (fsSub === \"log\") {\n  if (fsW0 === \"wipe\") {\n    if ((fsW[1] || \"\").toLowerCase() === \"confirm\") {\n      FS.log = [];\n      try { set_variable(\"fishingstats_log\", \"[]\"); } catch (e) {}\n      run_function(\"fishingstats_log_render\", [], \"fishingstats\");\n      fsSay(\"session log cleared. The current session is untouched.\", \"red\");\n    } else {\n      fsSay(\"this clears ALL filed sessions. FISHINGSTATS LOG WIPE CONFIRM to proceed.\", \"yellow\");\n    }\n  } else {\n    run_function(\"fishingstats_log_render\", [], \"fishingstats\");\n    fsSay(FS.log.length + \" session(s) in the log; see the fishinglog tab.\");\n  }\n} else if (fsSub === \"area\") {\n  if (fsRest === \"\") {\n    fsSay(\"area now: \" + (FS.areaNow || \"unknown\") + \" (from \" + (FS.areaSrc || \"nothing yet\") + \"). FISHINGSTATS AREA <name> to pin one, AREA AUTO to follow the game again, AREA RESET to forget the areas seen this session.\");\n  } else if (fsW0 === \"auto\" || fsW0 === \"reset\") {\n    if (fsW0 === \"auto\") {\n      FS.areaManual = \"\";\n      try { set_variable(\"fishingstats_area\", \"\"); } catch (e) {}\n      FS.areaNow = FS.areaGmcp;\n      FS.areaSrc = FS.areaGmcp ? \"GMCP\" : \"\";\n    }\n    // Areas accumulate across a session, so a stale pinned entry has to be\n    // cleared out too, then reseeded from the area now in use.\n    FS.session.areas = {};\n    if (FS.areaNow) { FS.session.areas[FS.areaNow] = 1; }\n    fsSave();\n    run_function(\"fishingstats_render\", [], \"fishingstats\");\n    fsSay(\"area is now \" + (FS.areaNow || \"unknown\") + \" (from \" + (FS.areaSrc || \"nothing yet\") + \"). Earlier areas this session were forgotten.\");\n  } else {\n    FS.areaManual = fsRest;\n    FS.areaNow = fsRest;\n    FS.areaSrc = \"manual\";\n    try { set_variable(\"fishingstats_area\", fsRest); } catch (e) {}\n    FS.session.areas[fsRest] = (FS.session.areas[fsRest] || 0) + 1;\n    fsSave();\n    run_function(\"fishingstats_render\", [], \"fishingstats\");\n    fsSay(\"area pinned to \" + fsRest + \". FISHINGSTATS AREA AUTO to follow the game again.\");\n  }\n} else if (fsSub === \"year\") {\n  if (fsW0) {\n    FS.session.year = parseInt(fsW0, 10) || 0;\n    fsSave();\n    run_function(\"fishingstats_render\", [], \"fishingstats\");\n    fsSay(\"session year set to \" + FS.session.year + \" AF.\");\n  } else {\n    fsSay(\"session year is \" + (FS.session.year || \"unknown\") + \". It is picked up from the RANKINGS FISHING header, or set it with FISHINGSTATS YEAR 1014.\");\n  }\n} else if (fsSub === \"gap\") {\n  var m = fsW0 ? parseInt(fsW0, 10) : 0;\n  if (!m) { fsSay(\"sessions are filed automatically after \" + FS.gap + \" minutes idle. FISHINGSTATS GAP 5-1440 to change it.\"); }\n  else if (m < 5 || m > 1440) { fsSay(\"pick a gap between 5 and 1440 minutes.\", \"yellow\"); }\n  else {\n    FS.gap = m;\n    try { set_variable(\"fishingstats_gap\", String(m)); } catch (e) {}\n    fsSay(\"idle gap set to \" + m + \" minutes.\");\n  }\n} else if (fsSub === \"me\") {\n  if (fsW0 === \"auto\") {\n    FS.meSet = \"\";\n    try { set_variable(\"fishingstats_me\", \"\"); } catch (e) {}\n    FS.me = FS.gmcpName || \"You\";\n    run_function(\"fishingstats_render\", [], \"fishingstats\");\n    fsSay(\"your angler name follows the game again: \" + FS.me + \".\");\n  } else if (fsW[0]) {\n    FS.meSet = fsW[0];\n    FS.me = fsW[0];\n    try { set_variable(\"fishingstats_me\", fsW[0]); } catch (e) {}\n    run_function(\"fishingstats_render\", [], \"fishingstats\");\n    fsSay(\"your angler name is set to \" + fsW[0] + \"; your row is highlighted. FISHINGSTATS ME AUTO to take it from the game.\");\n  } else {\n    fsSay(\"your angler name is \" + FS.me + (FS.meSet ? \" (set with FISHINGSTATS ME)\" : \" (from the game)\") + \".\");\n  }\n} else if (fsSub === \"colour\" || fsSub === \"color\") {\n  var who = fsW[0] || \"\";\n  var hex = fsW[1] || \"\";\n  if (!who) {\n    var listed = [];\n    for (var q in FS.session.anglers) { if (FS.session.anglers.hasOwnProperty(q)) { listed.push(q + \" \" + (FS.col[q] || \"default\")); } }\n    fsSay(\"colours: \" + (listed.length ? listed.join(\", \") : \"none yet\") + \". FISHINGSTATS COLOUR <name> <#rrggbb|RESET>.\");\n  } else if (!hex) {\n    fsSay(who + \" is \" + (FS.col[who] || \"on the default palette\") + \". Give a hex value like #e8a13f, or RESET.\");\n  } else if (hex.toLowerCase() !== \"reset\" && !/^#[0-9a-fA-F]{6}$/.test(hex)) {\n    fsSay(\"'\" + hex + \"' isn't a colour like #e8a13f.\", \"orange\");\n  } else {\n    if (hex.toLowerCase() === \"reset\") { delete FS.col[who]; }\n    else { FS.col[who] = hex; }\n    try { set_variable(\"fishingstats_colours\", JSON.stringify(FS.col)); } catch (e) {}\n    run_function(\"fishingstats_render\", [], \"fishingstats\");\n    fsSay(who + \" is now \" + (hex.toLowerCase() === \"reset\" ? \"back on the default palette\" : hex) + \".\");\n  }\n} else if (fsSub === \"add\") {\n  var am = fsRest.match(/^(\\S+)\\s+(\\d+)(?:\\s+(\\d+))?\\s+(\\D.*)$/);\n  if (!am) {\n    fsSay(\"FISHINGSTATS ADD <angler> <lb> [oz] <species>, e.g. FISHINGSTATS ADD Arlen 3 4 rock bass.\", \"orange\");\n  } else {\n    var lbv = parseInt(am[2], 10) || 0;\n    var ozv = parseInt(am[3], 10) || 0;\n    FS.inp = { angler: am[1], species: am[4], oz: lbv * 16 + ozv };\n    run_function(\"fishingstats_record\", [], \"fishingstats\");\n    fsSay(\"recorded \" + am[1] + \" \" + lbv + \"lb \" + ozv + \"oz \" + am[4] + \".\");\n  }\n} else if (fsSub === \"csv\") {\n  var cs = FS.session;\n  display_notice(\"angler,landed,casts,hooks,total_oz,best_oz,best_species\", \"white\");\n  for (var ck in cs.anglers) {\n    if (cs.anglers.hasOwnProperty(ck)) {\n      var ca = cs.anglers[ck];\n      display_notice(ck + \",\" + ca.n + \",\" + (ca.casts || 0) + \",\" + (ca.hooks || 0) + \",\" + ca.oz + \",\" + ca.best + \",\" + ca.bestSp, \"white\");\n    }\n  }\n  display_notice(\"species,caught,total_oz,best_oz,best_by\", \"white\");\n  for (var cf in cs.species) {\n    if (cs.species.hasOwnProperty(cf)) {\n      var cfs = cs.species[cf];\n      display_notice(cf + \",\" + cfs.n + \",\" + cfs.oz + \",\" + cfs.best + \",\" + cfs.bestBy, \"white\");\n    }\n  }\n} else if (fsSub === \"learn\") {\n  if (fsW0 === \"show\") {\n    var buf = FS.buf || [];\n    fsSay(buf.length + \" line(s) captured:\");\n    for (var bi = 0; bi < buf.length; bi++) { display_notice(\"| \" + buf[bi], \"yellow\"); }\n  } else if (fsW0 === \"clear\") {\n    FS.buf = [];\n    fsSay(\"buffer cleared.\");\n  } else {\n    if (fsW0 === \"on\") { FS.learn = true; }\n    else if (fsW0 === \"off\") { FS.learn = false; }\n    else { FS.learn = !FS.learn; }\n    if (FS.learn) { FS.buf = []; }\n    fsSay(\"capture \" + (FS.learn ? \"ON. Catch a fish, have someone else catch one, then FISHINGSTATS LEARN OFF and LEARN SHOW.\" : \"off. FISHINGSTATS LEARN SHOW dumps what was captured.\"));\n  }\n} else if (fsSub === \"demo\") {\n  FS.session = FS.blank();\n  FS.session.start -= 4500;\n  var dWho = [\"Arlen\", \"Mirela\", \"Tobin\"];\n  var dFish = [\"pike\", \"blue eel\", \"rock bass\", \"catfish\", \"walleye\", \"trout\"];\n  for (var di = 0; di < 34; di++) {\n    var dw = dWho[di % 3 === 0 ? 0 : (di % 5 === 0 ? 2 : (di % 2))];\n    var dx = (di % 3 === 0) ? 2 : 1;\n    for (var dj = 0; dj < dx; dj++) {\n      FS.evt = { angler: dw, type: \"cast\" };\n      run_function(\"fishingstats_event\", [], \"fishingstats\");\n    }\n    FS.evt = { angler: dw, type: \"hook\" };\n    run_function(\"fishingstats_event\", [], \"fishingstats\");\n    FS.inp = { angler: dw, species: dFish[(di * 5) % dFish.length], oz: 12 + ((di * 37) % 900) + (di % 5) * 40 };\n    run_function(\"fishingstats_record\", [], \"fishingstats\");\n  }\n  fsSay(\"demo data loaded into the tab. FISHINGSTATS DISCARD CONFIRM clears it.\");\n} else if (fsSub === \"debug\") {\n  fsSay(\"me=\" + FS.me + \" meSet=\" + FS.meSet + \" gmcpName=\" + FS.gmcpName + \" area=\" + FS.areaNow + \" src=\" + FS.areaSrc + \" gmcpArea=\" + FS.areaGmcp\n    + \" gap=\" + FS.gap + \" learn=\" + FS.learn + \" log=\" + FS.log.length + \" records year=\" + FS.rec.year + \" (\" + Object.keys(FS.rec.f).length + \" species)\");\n} else {\n  fsSay(\"unknown command '\" + fsSub + \"'. FISHINGSTATS HELP for commands.\", \"orange\");\n}\n"
      }
     ],
     "text": "^fishingstats(?:\\s+(\\S+)(?:\\s+(.*?))?)?\\s*$",
     "matching": "regexp",
     "whole_words": false,
     "case_sensitive": false,
     "prefix_suffix": true
    }
   ]
  },
  {
   "type": "group",
   "name": "tally",
   "enabled": true,
   "items": [
    {
     "type": "function",
     "name": "fishingstats_touch",
     "enabled": true,
     "code": "// Called before any catch or cast is booked. If the session has been idle\n// longer than the gap threshold, the old one is archived and a fresh one\n// started, so sessions delimit themselves without needing to be told.\nif (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\nvar s = FS.session;\nvar now = Math.floor(new Date().getTime() / 1000);\nif (s.n > 0 && s.last && (now - s.last) > FS.gap * 60) {\n  var mins = Math.round((now - s.last) / 60);\n  run_function(\"fishingstats_archive\", [], \"fishingstats\");\n  display_notice(\"[fishingstats] \" + mins + \" minutes idle, so the previous session was filed to the log. Starting a new one.\", \"cyan\");\n}\nFS.session.last = now;\nvar ar = FS.areaNow;\nif (ar) { FS.session.areas[ar] = (FS.session.areas[ar] || 0) + 1; }\nif (!FS.session.year && FS.rec.year) { FS.session.year = FS.rec.year; }"
    },
    {
     "type": "function",
     "name": "fishingstats_record",
     "enabled": true,
     "code": "// Records a landed fish. Callers set:\n//   FS.inp = { angler: \"Arlen\", species: \"blue eel\", oz: 41 }\n// Trigger wording can change without touching the tally or the display.\nif (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\nrun_function(\"fishingstats_touch\", [], \"fishingstats\");\nvar inp = FS.inp;\nFS.inp = null;\nif (inp && inp.angler && inp.species) {\n  var s = FS.session;\n  var now = Math.floor(new Date().getTime() / 1000);\n  var who = String(inp.angler);\n  var sp = String(inp.species).toLowerCase();\n  var oz = parseInt(inp.oz, 10);\n  if (isNaN(oz) || oz < 0) { oz = 0; }\n\n  if (!s.anglers[who]) { s.anglers[who] = { n: 0, oz: 0, best: 0, bestSp: \"\", casts: 0, hooks: 0, sp: {} }; }\n  var a = s.anglers[who];\n  a.n += 1;\n  a.oz += oz;\n  if (oz > a.best) { a.best = oz; a.bestSp = sp; }\n  a.sp[sp] = (a.sp[sp] || 0) + 1;\n\n  if (!s.species[sp]) { s.species[sp] = { n: 0, oz: 0, best: 0, bestBy: \"\" }; }\n  var f = s.species[sp];\n  f.n += 1;\n  f.oz += oz;\n  if (oz > f.best) { f.best = oz; f.bestBy = who; }\n\n  s.n += 1;\n  s.recent.push([now, who, sp, oz]);\n  while (s.recent.length > FS.recentCap) { s.recent.shift(); }\n\n  // Compare against the yearly rankings if they have been read. Ranking rows\n  // truncate long species names, so a stored key that prefixes the caught\n  // name counts as the same fish.\n  var rec = FS.rec.f;\n  var hit = null;\n  var key;\n  if (rec[sp]) { hit = rec[sp]; }\n  else {\n    for (key in rec) {\n      if (rec.hasOwnProperty(key) && key.length > 3 && sp.indexOf(key) === 0) { hit = rec[key]; break; }\n    }\n  }\n  if (hit && oz > hit[0]) {\n    s.rec = (s.rec || 0) + 1;\n    var lb1 = Math.floor(oz / 16);\n    display_notice(\"[fishingstats] \" + who + \"'s \" + sp + \" at \" + lb1 + \"lb \" + (oz % 16) + \"oz beats this year's ranking of \" + Math.floor(hit[0] / 16) + \"lb \" + (hit[0] % 16) + \"oz by \" + hit[1] + \".\", \"cyan\");\n  }\n\n  try { set_variable(\"fishingstats_session\", JSON.stringify(s)); } catch (e) {}\n  run_function(\"fishingstats_render\", [], \"fishingstats\");\n}"
    },
    {
     "type": "function",
     "name": "fishingstats_event",
     "enabled": true,
     "code": "// Counts casts and hooks so a landing rate can be shown.\n//   FS.evt = { angler: \"Arlen\", type: \"cast\" }   type: cast | hook\nif (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\nrun_function(\"fishingstats_touch\", [], \"fishingstats\");\nvar ev = FS.evt;\nFS.evt = null;\nif (ev && ev.angler && ev.type) {\n  var s = FS.session;\n  var who = String(ev.angler);\n  if (!s.anglers[who]) { s.anglers[who] = { n: 0, oz: 0, best: 0, bestSp: \"\", casts: 0, hooks: 0, sp: {} }; }\n  var a = s.anglers[who];\n  if (!a.casts) { a.casts = 0; }\n  if (!a.hooks) { a.hooks = 0; }\n  if (ev.type === \"cast\") { a.casts += 1; }\n  else { a.hooks += 1; }\n  try { set_variable(\"fishingstats_session\", JSON.stringify(s)); } catch (e) {}\n  run_function(\"fishingstats_render\", [], \"fishingstats\");\n}"
    },
    {
     "type": "function",
     "name": "fishingstats_archive",
     "enabled": true,
     "code": "// Files the current session into the log and starts a blank one. A session\n// with nothing landed is discarded rather than logged.\nif (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\nvar s = FS.session;\nif (s.n > 0) {\n  var ang = {};\n  var sp = {};\n  var k;\n  for (k in s.anglers) {\n    if (s.anglers.hasOwnProperty(k)) {\n      var a = s.anglers[k];\n      ang[k] = [a.n, a.oz, a.best, a.casts || 0, a.hooks || 0, a.bestSp || \"\"];\n    }\n  }\n  for (k in s.species) {\n    if (s.species.hasOwnProperty(k)) { sp[k] = [s.species[k].n, s.species[k].best, s.species[k].bestBy]; }\n  }\n  var areas = [];\n  for (k in s.areas) { if (s.areas.hasOwnProperty(k)) { areas.push(k); } }\n  FS.log.push({\n    s: s.start, e: s.last, ar: areas.join(\", \"), y: s.year || 0,\n    n: s.n, oz: 0, rec: s.rec || 0,\n    ft: s.castN > 0 ? Math.round(s.castFt / s.castN) : 0,\n    ang: ang, sp: sp\n  });\n  var tot = 0;\n  for (k in s.anglers) { if (s.anglers.hasOwnProperty(k)) { tot += s.anglers[k].oz; } }\n  FS.log[FS.log.length - 1].oz = tot;\n  while (FS.log.length > FS.logCap) { FS.log.shift(); }\n  try { set_variable(\"fishingstats_log\", JSON.stringify(FS.log)); } catch (e) {}\n}\nvar now = Math.floor(new Date().getTime() / 1000);\nFS.session = { start: now, last: now, anglers: {}, species: {}, recent: [], n: 0, areas: {}, year: FS.rec.year || 0, rec: 0, castFt: 0, castN: 0 };\ntry { set_variable(\"fishingstats_session\", JSON.stringify(FS.session)); } catch (e) {}\nrun_function(\"fishingstats_render\", [], \"fishingstats\");\nrun_function(\"fishingstats_log_render\", [], \"fishingstats\");"
    },
    {
     "type": "trigger",
     "name": "",
     "enabled": true,
     "actions": [
      {
       "type": "script",
       "enabled": true,
       "script": "if (!client.loom || !client.loom.fishingstats || !client.loom.fishingstats.session) run_function(\"fishingstats_setup\", [], \"fishingstats\");\nvar FS = client.loom.fishingstats;\nFS.inp = { angler: FS.me, species: args[1], oz: (parseInt(args[2], 10) || 0) * 16 + (parseInt(args[3], 10) || 0) };\nrun_function(\"fishingstats_record\", [], \"fishingstats\");"
      }
     ],
