{
 "type": "group",
 "name": "room",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"room_setup\", [], \"room\");\nrun_function(\"room_render\", [], \"room\");\ndisplay_notice(\"[room] installed. Create a custom tab named Here; it fills in as you move. ROOM HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; room_name and room_desc are left intact.\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon (Here, #158): a \"you are here\" dot: pure CSS keyed on the tab button's title, so Nexus's\n// own redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"Here\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 17 17\"><circle cx=\"8.5\" cy=\"8.5\" r=\"7.5\" fill=\"#e0b46c\" fill-opacity=\"0.22\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"4.6\" fill=\"#ffffff\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"3.4\" fill=\"#e0b46c\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\n\nrun_function(\"room_setup\", [], \"room\");\nrun_function(\"room_render\", [], \"room\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Everything on the Here tab comes from GMCP: Room.Info for the room, Room.Players\n// and Add/RemovePlayer for who's here, Char.Items (location \"room\") for mobs and\n// items. A room change sends several of these in a row, so the tab is drawn\n// once, 50ms after the last of them.\nvar rmM = \"\";\nvar rmA = null;\ntry { rmM = args.gmcp_method; rmA = args.gmcp_args; } catch (e) { rmM = \"\"; }\nif (typeof rmA === \"string\") { try { rmA = JSON.parse(rmA); } catch (e) { /* a bare name, as RemovePlayer may send */ } }\nvar rmMine = /^Room\\.(Info|Players|AddPlayer|RemovePlayer)$/.test(rmM) || rmM === \"IRE.Target.Info\" || rmM === \"IRE.Target.Set\" || rmM === \"Char.Vitals\" || (/^Char\\.Items\\.(List|Add|Remove|Update)$/.test(rmM) && rmA && rmA.location === \"room\") || rmM === \"Char.Name\" || rmM === \"Char.Status\";\nif (rmMine) {\n  if (!client.loom || !client.loom.room || !client.loom.room.raw) run_function(\"room_setup\", [], \"room\");\n  var R = client.loom.room;\n  if (rmM !== \"Char.Status\" && rmM !== \"Char.Vitals\") R.raw[rmM] = rmA;\n  var rmDraw = true;\n  if (rmM === \"Room.Info\" && rmA) {\n    R.info = rmA;\n  } else if (rmM === \"Room.Players\" && rmA && rmA.length !== undefined) {\n    R.players = {};\n    for (var rmI = 0; rmI < rmA.length; rmI++) { if (rmA[rmI] && rmA[rmI].name) R.players[rmA[rmI].name] = rmA[rmI].fullname || rmA[rmI].name; }\n  } else if (rmM === \"Room.AddPlayer\" && rmA && rmA.name) {\n    R.players[rmA.name] = rmA.fullname || rmA.name;\n  } else if (rmM === \"Room.RemovePlayer\" && rmA) {\n    delete R.players[typeof rmA === \"string\" ? rmA : rmA.name];\n  } else if (rmM === \"Char.Items.List\") {\n    R.items = {};\n    // R.order: the ids in the game's own order (Char.Items.List, then each\n    // Add at the end). R.items alone would iterate by id, since JavaScript\n    // walks number-like keys in ascending order, and the room's order is\n    // what targeting by name follows.\n    R.order = [];\n    var rmL = rmA.items || [];\n    for (var rmJ = 0; rmJ < rmL.length; rmJ++) { R.items[rmL[rmJ].id] = rmL[rmJ]; R.order.push(String(rmL[rmJ].id)); }\n  } else if ((rmM === \"Char.Items.Add\" || rmM === \"Char.Items.Update\") && rmA.item) {\n    if (!R.order) R.order = [];\n    if (!R.items[rmA.item.id]) R.order.push(String(rmA.item.id));\n    R.items[rmA.item.id] = rmA.item;\n  } else if (rmM === \"Char.Items.Remove\" && rmA.item !== undefined) {\n    var rmRid = String(typeof rmA.item === \"object\" ? rmA.item.id : rmA.item);\n    delete R.items[rmRid];\n    if (R.order) { var rmAt = R.order.indexOf(rmRid); if (rmAt >= 0) R.order.splice(rmAt, 1); }\n  } else if (rmM === \"IRE.Target.Info\" && rmA) {\n    // Your target, for the glow on its mob: its id, and its health. Later\n    // updates for the same target can carry only the health.\n    var rmTi = String(rmA.id || \"\");\n    var rmTn = String(rmA.short_desc || \"\");\n    if (!rmTn && R.target && R.target.id === rmTi) rmTn = R.target.name || \"\";\n    R.target = { id: rmTi, name: rmTn, hp: String(rmA.hpperc || \"\").replace(\"%\", \"\"), at: Date.now() };\n  } else if (rmM === \"IRE.Target.Set\") {\n    // The game announcing a new target (ST/SETTARGET; Ricardo, #205: a\n    // player stayed lit after ST RAT). The payload is the target as typed or\n    // an id, maybe quoted; empty means none. Health comes with Info later.\n    var rmTs = String(rmA === null || rmA === undefined ? \"\" : (typeof rmA === \"object\" ? (rmA.target || rmA.id || \"\") : rmA)).replace(/^\"|\"$/g, \"\").trim();\n    R.target = rmTs ? { id: rmTs, name: \"\", hp: \"\", at: Date.now() } : { id: \"\", name: \"\", hp: \"\", none: true, at: Date.now() };\n  } else if (rmM === \"Char.Vitals\") {\n    // Every prompt: redraw only if the tar variable changed (ST, or a\n    // targeting alias), since that sends nothing of its own.\n    rmDraw = false;\n    var rmTar = String(get_variable(\"tar\") || \"\");\n    if (rmTar !== R.lastTar) { R.lastTar = rmTar; R.tarAt = Date.now(); rmDraw = true; }\n  } else if ((rmM === \"Char.Name\" || rmM === \"Char.Status\") && rmA && rmA.name) {\n    rmDraw = false;\n    if (String(rmA.name) !== R.me) { R.me = String(rmA.name); try { set_variable(\"room_name\", R.me); } catch (e) {} rmDraw = true; }\n  } else {\n    rmDraw = false;\n  }\n  if (rmDraw) {\n    clearTimeout(R.drawT);\n    R.drawT = setTimeout(function () { run_function(\"room_render\", [], \"room\"); }, 50);\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "room_setup",
   "enabled": true,
   "code": "// room_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Namespace, registry and state for the Here tab\n// (#158), a replacement for the stock Room tab fed only by GMCP:\n//   R.info     the last Room.Info (name, desc, area, environment, details, exits, num)\n//   R.players  name -> fullname, from Room.Players / AddPlayer / RemovePlayer\n//   R.items    id -> item, from Char.Items List / Add / Remove / Update (location \"room\")\n//   R.me       your name (Char.Name / Char.Status, kept as room_name), left off the players\n//   R.raw      the last payload of each method, for ROOM DEBUG\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.room) client.loom.room = {};\n// redraw: how loom redraws the Here tab when an integration's source changes (#159).\nclient.loom.registry.room = { version: \"0.1.10\", keyword: \"ROOM\", desc: \"A Here tab replacing the stock Room tab: exits, players, mobs and items\", redraw: function () { run_function(\"room_render\", [], \"room\"); } };\nvar R = client.loom.room;\nif (!R.info) R.info = null;\nif (!R.players) R.players = {};\nif (!R.items) R.items = {};\nif (!R.raw) R.raw = {};\n// Your target (IRE.Target.Info: id and health), and the tar variable as last\n// seen, so a change of it redraws the tab.\nif (R.target === undefined) R.target = null;\nif (R.lastTar === undefined) R.lastTar = \"\";\nif (R.tarAt === undefined) R.tarAt = 0;\nif (!R.me) { try { R.me = String(get_variable(\"room_name\") || \"\"); } catch (e) { R.me = \"\"; } }\n// The description starts folded to two lines (room_desc \"folded\"/\"open\").\nR.descOpen = get_variable(\"room_desc\") == \"open\";\nR.tab = \"Here\";\n"
  },
  {
   "type": "function",
   "name": "room_render",
   "enabled": true,
   "code": "// room_render -- the Here tab (#158), in the house style shared with Stats,\n// Online, Standings: ink panel, serif small-caps headings, monospace rows. The\n// accent is a warm lantern amber.\n//   - header: room name, area and environment, details as tags, exits, number\n//   - description folded to two lines; a click on it unfolds it (a class on the\n//     page body, as Online's offline section, so redraws never undo it)\n//   - PLAYERS (you left off, full title on hover, a targeted one glowing\n//     red), MOBS (one row each, in the room's own order, so the next one a\n//     name would hit is the next row down; your target glows yellow in\n//     place, with its health; dead ones greyed),\n//     ITEMS (things you can take stand out, fixtures are muted), each as a\n//     table: quantity when more than one, the name, and a type column the\n//     integrations can fill (shrine, plant…)\n// Integrations (0.5: #162 social colours (done), #163 hunting target, #164 shrines,\n// #165 sigils, #166 plants) will mark rows through the display entry point #159.\nvar R = client.loom.room;\nvar AMBER = \"#e0b46c\";\nvar DEEP = \"#7a5f33\";\nvar TXT = \"#e8e2d6\";\nvar MUTED = \"#8f877a\";\nvar DIM = \"#6d665b\";\nvar RULE = \"#2b2620\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\"); }\nfunction caps(t, n) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;font-size:11px;color:' + (n ? AMBER : DIM) + ';margin:8px 0 2px;border-top:1px solid ' + RULE + ';padding-top:5px;\">' + t + ' <span style=\"color:' + MUTED + ';\">' + n + '</span></div>'; }\n// A table row: quantity (when more than one), the name indented after it, and\n// a type column left empty for now (shrines, plants… from the integrations).\n// glow: false, or the colour of a targeted row (yellow mob, red player).\nfunction row(n, name, title, type, glow) {\n  return '<div' + (title ? ' title=\"' + esc(title) + '\"' : '') + ' style=\"display:flex;align-items:baseline;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;cursor:default;' + (glow ? 'background:' + (glow === PGLOW ? 'rgba(255,106,94,0.08)' : 'rgba(255,215,94,0.07)') + ';' : '') + '\">' +\n    '<span style=\"flex:0 0 2.6em;text-align:right;color:' + MUTED + ';\">' + (n > 1 ? n + '&times;' : '') + '</span>' +\n    '<span style=\"flex:1 1 auto;\">' + name + '</span>' +\n    (type ? '<span style=\"flex:0 0 auto;color:' + (glow || MUTED) + ';font-style:italic;font-family:' + SERIF + ';\">' + esc(type) + '</span>' : '') + '</div>';\n}\n// Merge items of the same name, keeping order of first appearance.\nfunction merge(list) {\n  var out = [], at = {};\n  for (var i = 0; i < list.length; i++) {\n    var k = list[i].name + \"|\" + (list[i].attrib || \"\");\n    if (at[k] === undefined) { at[k] = out.length; out.push({ it: list[i], n: 1 }); } else out[at[k]].n++;\n  }\n  return out;\n}\n\n// Your target: whichever changed last decides, alone. Either the game's\n// (IRE.Target.Info or IRE.Target.Set, in R.target: an id, or a word such as\n// a player's name or \"rat\"; an empty Set means no target) or the tar\n// variable (an id or a word). An id glows that mob; a word glows the player\n// of that name, else the first living mob whose name holds it. Info's\n// short_desc is the word when its id isn't in the room. The row glows, as in\n// the stock tab, with its health in the type column.\nvar GLOW = \"#ffd75e\";\nvar PGLOW = \"#ff6a5e\";\nvar tarV = String(get_variable(\"tar\") || \"\").trim();\nvar gm = R.target || null;\nvar useGmcp = !!(gm && (gm.none || gm.id || gm.name) && (!tarV || (gm.at || 0) >= (R.tarAt || 0)));\nvar tgtSrc = useGmcp ? (gm.none ? \"\" : String(gm.id || \"\")) : tarV;\nvar tgtId = /^\\d+$/.test(tgtSrc) ? tgtSrc : \"\";\nvar tgtWord = (tgtSrc && !tgtId) ? tgtSrc.toLowerCase() : ((useGmcp && !gm.none && gm.name) ? String(gm.name).toLowerCase() : \"\");\n\nvar I = R.info || {};\nvar html = '<div id=\"loom-here\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:#13110e;border:1px solid ' + RULE + ';padding:7px 8px 8px;min-height:100%;box-sizing:border-box;\">';\nif (!R.info) {\n  html += '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">Waiting for the room… (move, or LOOK)</div>';\n} else {\n  var name = String(I.name || \"\").replace(/\\s*\\((?:indoors|outdoors)\\)\\s*$/i, \"\");\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\n  html += '<div style=\"font-family:' + SERIF + ';color:' + AMBER + ';font-size:13px;letter-spacing:0.06em;\">' + esc(name) + '</div>';\n  html += '<div style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:11px;white-space:nowrap;\">' + esc(I.area || \"\") + (I.environment ? ' &middot; ' + esc(I.environment) : '') + '</div></div>';\n  // Details as tags, exits, room number.\n  var tags = \"\";\n  var det = I.details || [];\n  for (var di = 0; di < det.length; di++) tags += '<span style=\"display:inline-block;margin:0 4px 0 0;padding:0 4px;border:1px solid ' + DEEP + ';color:' + MUTED + ';\">' + esc(det[di]) + '</span>';\n  var ex = [];\n  for (var ek in (I.exits || {})) { if (I.exits.hasOwnProperty(ek)) ex.push(ek); }\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-top:3px;\">';\n  html += '<span>' + tags + '</span>';\n  html += '<span style=\"white-space:nowrap;color:' + MUTED + ';\">exits <span style=\"color:' + AMBER + ';\">' + (ex.length ? esc(ex.join(\"  \")) : \"none\") + '</span>' + (I.num ? ' &middot; ' + esc(I.num) : '') + '</span></div>';\n  if (I.desc) {\n    html += '<div onclick=\"document.body.classList.toggle(\\'loom-room-desc-open\\')\" title=\"click to unfold or fold\" class=\"loom-room-desc\" style=\"cursor:pointer;margin-top:4px;font-family:' + SERIF + ';font-size:11px;line-height:1.35;color:' + MUTED + ';\">' + esc(I.desc) + '</div>';\n  }\n\n  // Players, you left off. A player you target glows red: the tar name, or\n  // the game's target info naming them, whichever changed last. A player\n  // match wins over a mob whose name merely contains the word.\n  var pl = [];\n  for (var pk in R.players) { if (R.players.hasOwnProperty(pk) && pk.toLowerCase() !== String(R.me).toLowerCase()) pl.push(pk); }\n  pl.sort();\n  var tgtPl = \"\";\n  for (var pt = 0; pt < pl.length; pt++) {\n    var plL = pl[pt].toLowerCase();\n    if (tgtWord === plL) { tgtPl = pl[pt]; break; }\n  }\n  if (tgtPl) { tgtWord = \"\"; tgtId = \"\"; }\n  html += caps(\"players\", pl.length);\n  // Through loom's display entry point (#159): a player's highlight colour\n  // and group from social (#162), when both are installed and the link is\n  // on; otherwise plain. The target glow still wins.\n  var LL = client.loom.loom;\n  var ask = function (q, n) { return (LL && LL.answer) ? LL.answer(\"room\", q, n) : undefined; };\n  for (var pi = 0; pi < pl.length; pi++) {\n    var isT = pl[pi] === tgtPl;\n    var pHp = (isT && useGmcp && R.target.hp !== \"\") ? R.target.hp + \"%\" : (isT ? \"target\" : \"\");\n    var pCol = ask(\"person.colour\", pl[pi]);\n    var pGrp = ask(\"person.group\", pl[pi]);\n    var pTitle = R.players[pl[pi]] || \"\";\n    if (pGrp) pTitle = (pTitle ? pTitle + \" \\u00b7 \" : \"\") + pGrp;\n    html += row(1, '<span style=\"font-family:' + SERIF + ';font-size:12px;color:' + (isT ? PGLOW + ';text-shadow:0 0 6px ' + PGLOW + ',0 0 2px ' + PGLOW : (pCol || TXT)) + ';\">' + esc(pl[pi]) + '</span>', pTitle, pHp, isT ? PGLOW : false);\n  }\n\n  // Mobs and items, in the room's own order (R.order; ids not in it, which\n  // shouldn't happen, after them).\n  var mobs = [], items = [], seenId = {};\n  var ord = (R.order || []).slice();\n  for (var ik in R.items) { if (R.items.hasOwnProperty(ik) && ord.indexOf(String(ik)) < 0) ord.push(String(ik)); }\n  for (var oi = 0; oi < ord.length; oi++) {\n    var it = R.items[ord[oi]];\n    if (!it || seenId[ord[oi]]) continue;\n    seenId[ord[oi]] = true;\n    if (/m/.test(it.attrib || \"\")) mobs.push(it); else items.push(it);\n  }\n  // Mobs one row each (Ricardo: merging them, then splitting the target out\n  // and lifting it to the top, made it hard to see what comes next). The\n  // target glows where it stands: by id, or the first living mob whose name\n  // holds the tar word, as the game would pick it.\n  var tgtMob = null;\n  for (var ti = 0; ti < mobs.length && !tgtMob; ti++) { if (tgtId && String(mobs[ti].id) === tgtId) tgtMob = mobs[ti]; }\n  for (var tj = 0; tj < mobs.length && !tgtMob && tgtWord; tj++) { if (!/d/.test(mobs[tj].attrib || \"\") && mobs[tj].name.toLowerCase().indexOf(tgtWord) >= 0) tgtMob = mobs[tj]; }\n  html += caps(\"mobs\", mobs.length);\n  for (var mi = 0; mi < mobs.length; mi++) {\n    var mob = mobs[mi];\n    if (mob === tgtMob) {\n      var tHp = (R.target && String(R.target.id) === String(mob.id) && R.target.hp !== \"\") ? R.target.hp + \"%\" : \"target\";\n      html += row(1, '<span style=\"font-family:' + SERIF + ';font-size:12px;color:' + GLOW + ';text-shadow:0 0 6px ' + GLOW + ',0 0 2px ' + GLOW + ';\">' + esc(mob.name) + '</span>', \"your target\", tHp, GLOW);\n    } else {\n      // Dead ones are greyed out; their name already says \"the corpse of…\".\n      var dead = /d/.test(mob.attrib || \"\");\n      html += row(1, '<span style=\"font-family:' + SERIF + ';font-size:12px;color:' + (dead ? DIM : TXT) + ';\">' + esc(mob.name) + '</span>');\n    }\n  }\n  var im = merge(items);\n  html += caps(\"items\", items.length);\n  for (var ii = 0; ii < im.length; ii++) {\n    var take = /t/.test(im[ii].it.attrib || \"\");\n    html += row(im[ii].n, '<span style=\"font-family:' + SERIF + ';font-size:11px;color:' + (take ? TXT : MUTED) + ';\">' + esc(im[ii].it.name) + '</span>', take ? \"you can take this\" : \"\");\n  }\n}\nhtml += '</div>';\n// The description's fold: a style once per page, the body class from the setting.\ntry {\n  if (!document.getElementById(\"loom-room-style\")) {\n    var rmSt = document.createElement(\"style\");\n    rmSt.id = \"loom-room-style\";\n    // The fold, and the tab the same size whatever the room holds: the panel\n    // fills the tab, and the tab's own container takes the panel's ink in\n    // case Nexus doesn't pass its height down.\n    rmSt.textContent = 'body:not(.loom-room-desc-open) .loom-room-desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; } ' +\n      '.flexlayout__tab:has(#loom-here) { background: #13110e !important; } .flexlayout__tab:has(#loom-here) > * { min-height: 100%; }';\n    document.head.appendChild(rmSt);\n    document.body.classList.toggle(\"loom-room-desc-open\", R.descOpen === true);\n  }\n} catch (e) {}\ntry { set_custom_tab_html(R.tab, html); } catch (e) {}\n"
  },
  {
   "type": "function",
   "name": "room_help",
   "enabled": true,
   "code": "// room_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[room] the Here tab: the room you are in, its exits, players, mobs and items. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"ROOM\", \"the room in a line, and how the description starts\"],\n  [\"ROOM DESC OPEN|FOLDED\", \"show the description in full, or folded to two lines (clicking it flips it too)\"],\n  [\"ROOM DEBUG\", \"the last room GMCP payloads, as they came\"],\n  [\"The Here tab replaces the stock Room tab: create a custom tab named Here, then close the stock one from the layout if you like.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "trigger",
   "name": "room player arrives",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "client.loom = client.loom || {}; client.loom.room = client.loom.room || {}; client.loom.room.lineKind = \"in\";"
    },
    {
     "type": "script",
     "enabled": true,
     "script": "// Players arriving and leaving without GMCP: flying up and landing send no\n// Room.AddPlayer / Room.RemovePlayer, so these lines keep the Here tab right\n// until the next Room.Players (on your next move) settles it. Each line's\n// name is the first capture group that matched, so more wordings can be added\n// to the triggers' alternations as Ricardo finds them.\nif (!client.loom || !client.loom.room || !client.loom.room.raw) run_function(\"room_setup\", [], \"room\");\nvar R = client.loom.room;\nvar plName = \"\";\nfor (var plI = 1; plI < args.length; plI++) { if (args[plI]) { plName = String(args[plI]); break; } }\nif (plName && plName.toLowerCase() !== String(R.me).toLowerCase()) {\n  if (R.lineKind === \"in\") { if (!R.players[plName]) R.players[plName] = plName; }\n  else delete R.players[plName];\n  clearTimeout(R.drawT);\n  R.drawT = setTimeout(function () { run_function(\"room_render\", [], \"room\"); }, 50);\n}\n"
    }
   ],
   "text": "^(?:([A-Z][a-z]+) descends from above\\.)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "room player leaves",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "client.loom = client.loom || {}; client.loom.room = client.loom.room || {}; client.loom.room.lineKind = \"out\";"
    },
    {
     "type": "script",
     "enabled": true,
     "script": "// Players arriving and leaving without GMCP: flying up and landing send no\n// Room.AddPlayer / Room.RemovePlayer, so these lines keep the Here tab right\n// until the next Room.Players (on your next move) settles it. Each line's\n// name is the first capture group that matched, so more wordings can be added\n// to the triggers' alternations as Ricardo finds them.\nif (!client.loom || !client.loom.room || !client.loom.room.raw) run_function(\"room_setup\", [], \"room\");\nvar R = client.loom.room;\nvar plName = \"\";\nfor (var plI = 1; plI < args.length; plI++) { if (args[plI]) { plName = String(args[plI]); break; } }\nif (plName && plName.toLowerCase() !== String(R.me).toLowerCase()) {\n  if (R.lineKind === \"in\") { if (!R.players[plName]) R.players[plName] = plName; }\n  else delete R.players[plName];\n  clearTimeout(R.drawT);\n  R.drawT = setTimeout(function () { run_function(\"room_render\", [], \"room\"); }, 50);\n}\n"
    }
   ],
   "text": "^(?:([A-Z][a-z]+) begins to flap (?:his|her|their|its) wings powerfully, and rises quickly up into the firmament\\.)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "room target line",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// The game's own confirmation of a new target (ST / SETTARGET), e.g.\n// \"Your target is now: Rat (a denizen)\". Ricardo, #205: after targeting a\n// player, ST RAT left the player lit. This line arrives whatever GMCP does or\n// doesn't send, so it sets the target too, as a word (a player's name, or a\n// word in a mob's name): whichever of this, IRE.Target.*, or the tar variable\n// changed last decides the glow.\nif (!client.loom || !client.loom.room || !client.loom.room.raw) run_function(\"room_setup\", [], \"room\");\nvar R = client.loom.room;\nvar tlName = String(args[1] || \"\").trim();\nif (tlName) {\n  R.target = { id: tlName, name: \"\", hp: \"\", at: Date.now(), line: String(args[2] || \"\") };\n  clearTimeout(R.drawT);\n  R.drawT = setTimeout(function () { run_function(\"room_render\", [], \"room\"); }, 50);\n}\n"
    }
   ],
   "text": "^Your target is now: (.+?)(?: \\((.+)\\))?\\.?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "alias",
   "name": "room",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// ROOM [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.room || !client.loom.room.raw) run_function(\"room_setup\", [], \"room\");\nvar R = client.loom.room;\nvar rmW = String(args[1] || \"\").trim().toLowerCase().split(/\\s+/);\nvar rmSub = rmW[0];\nfunction rmSay(t, c) { display_notice(\"[room] \" + t, c || \"cyan\"); }\nif (rmSub === \"\" || rmSub === \"status\") {\n  var rmI = R.info || {};\n  var rmP = 0, rmMo = 0, rmIt = 0;\n  for (var k in R.players) { if (R.players.hasOwnProperty(k) && k.toLowerCase() !== String(R.me).toLowerCase()) rmP++; }\n  for (var j in R.items) { if (R.items.hasOwnProperty(j)) { if (/m/.test(R.items[j].attrib || \"\")) rmMo++; else rmIt++; } }\n  rmSay(R.info ? (String(rmI.name).replace(/\\s*\\((?:indoors|outdoors)\\)\\s*$/i, \"\") + \" (\" + rmI.num + \"), \" + rmI.area + \": \" + rmP + \" player\" + (rmP === 1 ? \"\" : \"s\") + \", \" + rmMo + \" mob\" + (rmMo === 1 ? \"\" : \"s\") + \", \" + rmIt + \" item\" + (rmIt === 1 ? \"\" : \"s\") + \".\") : \"no room data yet: move or LOOK.\");\n  rmSay(\"the Here tab shows it; the description starts \" + (R.descOpen ? \"open\" : \"folded\") + \". ROOM HELP for commands.\");\n} else if (rmSub === \"help\") {\n  run_function(\"room_help\", [], \"room\");\n} else if (rmSub === \"desc\") {\n  var rmD = rmW[1] || \"\";\n  if (rmD === \"open\" || rmD === \"folded\" || rmD === \"fold\") {\n    R.descOpen = rmD === \"open\";\n    set_variable(\"room_desc\", R.descOpen ? \"open\" : \"folded\");\n    try { document.body.classList.toggle(\"loom-room-desc-open\", R.descOpen); } catch (e) {}\n    rmSay(\"the description starts \" + (R.descOpen ? \"open\" : \"folded\") + \" now.\", \"lime\");\n  } else {\n    rmSay(\"the description starts \" + (R.descOpen ? \"open\" : \"folded\") + \". ROOM DESC OPEN or FOLDED to change it; clicking it flips it too.\");\n  }\n} else if (rmSub === \"debug\") {\n  // The last payload of each GMCP message the tab reads, as JSON.\n  var rmK = Object.keys(R.raw);\n  if (!rmK.length) rmSay(\"no room GMCP seen yet.\");\n  for (var rmX = 0; rmX < rmK.length; rmX++) {\n    var rmS = JSON.stringify(R.raw[rmK[rmX]]);\n    rmSay(rmK[rmX] + \" \" + (rmS.length > 600 ? rmS.slice(0, 600) + \"…\" : rmS), \"orange\");\n  }\n  rmSay(\"me=\" + (R.me || \"?\") + \" players=\" + Object.keys(R.players).length + \" items=\" + Object.keys(R.items).length, \"orange\");\n} else {\n  rmSay(\"unknown command '\" + rmSub + \"'. ROOM HELP for commands.\", \"orange\");\n}\nrun_function(\"room_render\", [], \"room\");\n"
    }
   ],
   "text": "^room(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false
  }
 ],
 "description": "A Here tab replacing the stock Room tab: exits, players, mobs and items"
}