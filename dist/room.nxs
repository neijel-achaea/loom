{
 "type": "group",
 "name": "room",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"room_setup\", [], \"room\");\nrun_function(\"room_render\", [], \"room\");\ndisplay_notice(\"[room] installed. Create a custom tab named Here; it fills in as you move. ROOM HELP for commands.\", \"lime\");\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"room_gmcp\", [], \"room\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// The tar watcher stops with the package; room_name, room_desc, room_probe and room_loyal_ignore are left\n// intact.\nif (client.loom && client.loom.room && client.loom.room.tarWatch) { clearInterval(client.loom.room.tarWatch); client.loom.room.tarWatch = null; }\nif (client.loom && client.loom.room) { clearTimeout(client.loom.room.probeT); clearTimeout(client.loom.room.probeLater); client.loom.room.probing = null; client.loom.room.probeQ = []; }\n// Leave LOOM and the integrations at once, not at the next load (#137):\n// loom takes the entry out and redraws the tabs that showed this package's answers.\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"room\");\n  else delete client.loom.registry.room;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon (Here, #158): a \"you are here\" dot: pure CSS keyed on the tab button's title, so Nexus's\n// own redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"Here\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 17 17\"><circle cx=\"8.5\" cy=\"8.5\" r=\"7.5\" fill=\"#e0b46c\" fill-opacity=\"0.22\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"4.6\" fill=\"#ffffff\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"3.4\" fill=\"#e0b46c\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\n\nrun_function(\"room_setup\", [], \"room\");\nrun_function(\"room_render\", [], \"room\");\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"room_gmcp\", [], \"room\");\n"
  },
  {
   "type": "function",
   "name": "room_gmcp",
   "enabled": true,
   "code": "// room_gmcp -- the work behind onGMCP, as a function made once per load\n// (client.loom.hooks.room.gmcp). Nexus compiles a script afresh every time it\n// runs, and long ones cost on every GMCP message, so the script itself stays two\n// lines and calls this (#136). Run from onLoad and onInstall, so a reimport\n// replaces it.\nif (!client.loom) client.loom = {};\nif (!client.loom.hooks) client.loom.hooks = {};\nif (!client.loom.hooks.room) client.loom.hooks.room = {};\nclient.loom.hooks.room.gmcp = function (args) {\n  // Everything on the Here tab comes from GMCP: Room.Info for the room, Room.Players\n  // and Add/RemovePlayer for who's here, Char.Items (location \"room\") for mobs and\n  // items. A room change sends several of these in a row, so the tab is drawn\n  // once, 50ms after the last of them.\n  var rmM = \"\";\n  var rmA = null;\n  try { rmM = args.gmcp_method; rmA = args.gmcp_args; } catch (e) { rmM = \"\"; }\n  if (typeof rmA === \"string\") { try { rmA = JSON.parse(rmA); } catch (e) { /* a bare name, as RemovePlayer may send */ } }\n  var rmMine = /^Room\\.(Info|Players|AddPlayer|RemovePlayer)$/.test(rmM) || rmM === \"IRE.Target.Info\" || rmM === \"IRE.Target.Set\" || rmM === \"Char.Vitals\" || (/^Char\\.Items\\.(List|Add|Remove|Update)$/.test(rmM) && rmA && rmA.location === \"room\") || rmM === \"Char.Name\" || rmM === \"Char.Status\";\n  if (rmMine) {\n    if (!client.loom || !client.loom.room || !client.loom.room.raw) run_function(\"room_setup\", [], \"room\");\n    var R = client.loom.room;\n    if (rmM !== \"Char.Status\" && rmM !== \"Char.Vitals\") R.raw[rmM] = rmA;\n    var rmDraw = true;\n    if (rmM === \"Room.Info\" && rmA) {\n      R.info = rmA;\n      // Back in the remembered room after GO BACK (#367): forget it, so the\n      // button offers REMEMBER again.\n      if (R.goingBack && R.mark && String(rmA.num) === R.mark.id) {\n        display_notice(\"[room] back in \" + R.markName(R.mark) + \".\", \"lime\");\n        R.mark = null;\n        R.goingBack = false;\n        delete_variable(\"room_mark\");\n      }\n      // A move: probes wait for this room's exits line (trigger room exits line).\n      R.probeHold = \"room\";\n      R.probeHoldN = 0;\n    } else if (rmM === \"Room.Players\" && rmA && rmA.length !== undefined) {\n      R.players = {};\n      var rmNew = false;\n      for (var rmI = 0; rmI < rmA.length; rmI++) { if (rmA[rmI] && rmA[rmI].name) { R.players[rmA[rmI].name] = rmA[rmI].fullname || rmA[rmI].name; if (R.seen(rmA[rmI].name, rmA[rmI].fullname)) rmNew = true; } }\n      if (rmNew) { R.saveNewbies(); if (client.loom.notify) client.loom.notify(\"room\"); }\n    } else if (rmM === \"Room.AddPlayer\" && rmA && rmA.name) {\n      R.players[rmA.name] = rmA.fullname || rmA.name;\n      if (R.seen(rmA.name, rmA.fullname)) { R.saveNewbies(); if (client.loom.notify) client.loom.notify(\"room\"); }\n    } else if (rmM === \"Room.RemovePlayer\" && rmA) {\n      delete R.players[typeof rmA === \"string\" ? rmA : rmA.name];\n    } else if (rmM === \"Char.Items.List\") {\n      R.items = {};\n      // R.order: the ids in the game's own order (Char.Items.List, then each\n      // Add at the end). R.items alone would iterate by id, since JavaScript\n      // walks number-like keys in ascending order, and the room's order is\n      // what targeting by name follows.\n      R.order = [];\n      var rmL = rmA.items || [];\n      for (var rmJ = 0; rmJ < rmL.length; rmJ++) { R.items[rmL[rmJ].id] = rmL[rmJ]; R.order.push(String(rmL[rmJ].id)); R.probeAdd(rmL[rmJ]); }\n    } else if ((rmM === \"Char.Items.Add\" || rmM === \"Char.Items.Update\") && rmA.item) {\n      if (!R.order) R.order = [];\n      if (!R.items[rmA.item.id]) R.order.push(String(rmA.item.id));\n      R.items[rmA.item.id] = rmA.item;\n      R.probeAdd(rmA.item);\n    } else if (rmM === \"Char.Items.Remove\" && rmA.item !== undefined) {\n      var rmRid = String(typeof rmA.item === \"object\" ? rmA.item.id : rmA.item);\n      delete R.items[rmRid];\n      if (R.order) { var rmAt = R.order.indexOf(rmRid); if (rmAt >= 0) R.order.splice(rmAt, 1); }\n    } else if (rmM === \"IRE.Target.Info\" && rmA) {\n      // Your target, for the glow on its mob: its id, and its health. Later\n      // updates for the same target can carry only the health.\n      var rmTi = String(rmA.id || \"\");\n      var rmTn = String(rmA.short_desc || \"\");\n      if (!rmTn && R.target && R.target.id === rmTi) rmTn = R.target.name || \"\";\n      R.target = { id: rmTi, name: rmTn, hp: String(rmA.hpperc || \"\").replace(\"%\", \"\"), at: Date.now() };\n    } else if (rmM === \"IRE.Target.Set\") {\n      // The game announcing a new target (ST/SETTARGET; Ricardo, #205: a\n      // player stayed lit after ST RAT). The payload is the target as typed or\n      // an id, maybe quoted; empty means none. Health comes with Info later.\n      var rmTs = String(rmA === null || rmA === undefined ? \"\" : (typeof rmA === \"object\" ? (rmA.target || rmA.id || \"\") : rmA)).replace(/^\"|\"$/g, \"\").trim();\n      R.target = rmTs ? { id: rmTs, name: \"\", hp: \"\", at: Date.now() } : { id: \"\", name: \"\", hp: \"\", none: true, at: Date.now() };\n    } else if (rmM === \"Char.Vitals\") {\n      // Every prompt: redraw only if the tar variable changed (ST, or a\n      // targeting alias), since that sends nothing of its own.\n      rmDraw = false;\n      // A probe whose answer is past its health line ends here; otherwise a\n      // mob that arrived where you stand may be probed now (a moved-into room\n      // waits for its exits line instead).\n      // The second prompt after a move lifts the hold too (no exits line seen:\n      // blind, or a display that leaves it out).\n      if (R.probeHold && ++R.probeHoldN >= 2) R.probeHold = \"\";\n      if (!R.probePrompt()) R.probeNext();\n      // GMCP can come ahead of its packet's text: an answer another package\n      // was waiting for may be in this same packet, so look again once the\n      // packet's lines are read (not a time gate: busy() decides).\n      if (!R.probing && R.probeQ.length && R.probeWaitOn && R.probeWaitOn.length) {\n        clearTimeout(R.probeLater);\n        R.probeLater = setTimeout(function () { R.probeNext(); }, 0);\n      }\n      var rmTar = String(get_variable(\"tar\") || \"\");\n      if (rmTar !== R.lastTar) { R.lastTar = rmTar; R.tarAt = Date.now(); rmDraw = true; }\n    } else if ((rmM === \"Char.Name\" || rmM === \"Char.Status\") && rmA && rmA.name) {\n      rmDraw = false;\n      if (String(rmA.name) !== R.me) { R.me = String(rmA.name); try { set_variable(\"room_name\", R.me); } catch (e) {} rmDraw = true; }\n    } else {\n      rmDraw = false;\n    }\n    if (rmDraw) {\n      R.drawSoon();\n    }\n  }\n};\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// onGMCP: the work is in room_gmcp (#136: this runs on every GMCP message, so it stays short).\nvar lkH = client.loom && client.loom.hooks && client.loom.hooks.room;\nif (!lkH || !lkH.gmcp) { run_function(\"room_gmcp\", [], \"room\"); lkH = client.loom.hooks.room; }\nlkH.gmcp(args);\n"
  },
  {
   "type": "function",
   "name": "room_setup",
   "enabled": true,
   "code": "// room_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Namespace, registry and state for the Here tab\n// (#158), a replacement for the stock Room tab fed only by GMCP:\n//   R.info     the last Room.Info (name, desc, area, environment, details, exits, num)\n//   R.players  name -> fullname, from Room.Players / AddPlayer / RemovePlayer\n//   R.items    id -> item, from Char.Items List / Add / Remove / Update (location \"room\")\n//   R.me       your name (Char.Name / Char.Status, kept as room_name), left off the players\n//   R.raw      the last payload of each method, for ROOM DEBUG\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.room) client.loom.room = {};\n// redraw: how loom redraws the Here tab when an integration's source changes (#159);\n// soon: that redraw gathers bursts itself, so loom calls it at once (#136).\n// busy (#318): true while a loyal probe's answer is still coming. Every\n// package that sends a command and reads its answer says so through its\n// registry entry's busy(), so others can wait their turn.\nclient.loom.registry.room = { version: \"0.2.15\", keyword: \"ROOM\", desc: \"A Here tab replacing the stock Room tab: exits, players, mobs and items\", redraw: function () { var r = client.loom.room; if (r && r.drawSoon) r.drawSoon(); else run_function(\"room_render\", [], \"room\"); }, soon: true, busy: function () { return !!(client.loom.room && client.loom.room.probing); } };\nvar R = client.loom.room;\n// One draw for a burst of changes: a room step brings Room.Info, the players\n// and the items, and loom's integrations (basher, patrolling…) ask for a\n// redraw of their own right after. All of them land here, so the tab draws\n// once, 50 ms after the last (it drew twice per step before, #136).\nR.drawSoon = function () {\n  clearTimeout(R.drawT);\n  R.drawT = setTimeout(function () { R.drawT = null; run_function(\"room_render\", [], \"room\"); }, 50);\n};\nif (!R.info) R.info = null;\nif (!R.players) R.players = {};\nif (!R.items) R.items = {};\nif (!R.raw) R.raw = {};\n// Your target (IRE.Target.Info: id and health), and the tar variable as last\n// seen, so a change of it redraws the tab.\nif (R.target === undefined) R.target = null;\nif (R.lastTar === undefined) R.lastTar = \"\";\nif (R.tarAt === undefined) R.tarAt = 0;\n// The tar variable is set inside Nexus (TAR, aliases) and sends nothing to\n// the game, so waiting for the next prompt to notice it made the glow lag\n// (Ricardo: \"less crisp than the stock tab\"). Look at it a few times a\n// second instead: one variable read and a compare, and a draw only when it\n// changed. Replaced on every setup, so a reimport never leaves two.\nif (R.tarWatch) clearInterval(R.tarWatch);\nR.tarWatch = setInterval(function () {\n  var tw;\n  try { tw = String(get_variable(\"tar\") || \"\"); } catch (e) { return; }\n  if (tw === R.lastTar) return;\n  R.lastTar = tw;\n  R.tarAt = Date.now();\n  clearTimeout(R.drawT);\n  run_function(\"room_render\", [], \"room\");\n}, 150);\nif (!R.me) { try { R.me = String(get_variable(\"room_name\") || \"\"); } catch (e) { R.me = \"\"; } }\n// The description starts folded to two lines (room_desc \"folded\"/\"open\").\nR.descOpen = get_variable(\"room_desc\") == \"open\";\nR.tab = \"Here\";\n\n// A remembered room (#367, Ricardo): { id, name, area }, saved as room_mark.\n// Here's button next to the room number: REMEMBER marks this room; once you\n// have moved on it reads GO BACK and walks you there (PATH FIND <id>);\n// arriving after GO BACK forgets it, so the button offers REMEMBER again.\n// In the marked room itself it reads \"remembered\" (a click forgets it).\n//   R.goingBack  true from GO BACK until you arrive (Room.Info in room_gmcp)\nR.mark = null;\ntry { var rmMk = JSON.parse(get_variable(\"room_mark\") || \"null\"); if (rmMk && rmMk.id) R.mark = rmMk; } catch (e) { R.mark = null; }\nif (R.goingBack === undefined) R.goingBack = false;\nR.markName = function (m) { return m ? (m.name || \"room\") + \" (\" + m.id + \")\" : \"\"; };\nR.markSave = function () {\n  if (R.mark) set_variable(\"room_mark\", JSON.stringify(R.mark)); else delete_variable(\"room_mark\");\n  run_function(\"room_render\", [], \"room\");\n};\nR.remember = function () {\n  var I = R.info;\n  if (!I || !I.num) { display_notice(\"[room] no room yet: move or LOOK first.\", \"orange\"); return; }\n  R.mark = { id: String(I.num), name: String(I.name || \"\").replace(/\\s*\\((?:indoors|outdoors)\\)\\s*$/i, \"\"), area: String(I.area || \"\") };\n  R.goingBack = false;\n  R.markSave();\n  display_notice(\"[room] remembered \" + R.markName(R.mark) + \". GO BACK in Here (or ROOM BACK) walks you here.\", \"lime\");\n};\nR.goBack = function () {\n  if (!R.mark) { display_notice(\"[room] no room remembered: ROOM REMEMBER, or REMEMBER in Here.\", \"orange\"); return; }\n  if (R.info && String(R.info.num) === R.mark.id) { display_notice(\"[room] you're in \" + R.markName(R.mark) + \" already.\", \"cyan\"); return; }\n  R.goingBack = true;\n  send_command(\"path find \" + R.mark.id, 1);\n  display_notice(\"[room] going back to \" + R.markName(R.mark) + \".\", \"cyan\");\n};\nR.forget = function () {\n  var was = R.mark;\n  R.mark = null;\n  R.goingBack = false;\n  R.markSave();\n  display_notice(was ? \"[room] forgot \" + R.markName(was) + \".\" : \"[room] no room remembered.\", \"cyan\");\n};\n// The tab's clicks (its page can't reach client.loom by name in every Nexus).\ntry {\n  window.loomRoom = {\n    remember: function () { client.loom.room.remember(); },\n    back: function () { client.loom.room.goBack(); },\n    forget: function () { client.loom.room.forget(); }\n  };\n} catch (e) {}\n\n// Newbies (#242): players whose full name (GMCP fullname) carries one of\n// these titles get a green leaf. Here reads the title live; for tabs that\n// see no titles (Online, Comms) the names are remembered (room_newbies,\n// name -> when last seen with the title) and forgotten once the player is\n// seen without it. Helpers rebuilt on every run, the list kept.\nR.newbieTitles = [\"Uaithne\", \"Ithin\", \"Tuqad\"];\nR.newbieTitle = function (name, full) {\n  var words = String(full || \"\").split(/[^A-Za-z']+/);\n  for (var i = 0; i < words.length; i++) { if (words[i] !== name && R.newbieTitles.indexOf(words[i]) >= 0) return words[i]; }\n  return \"\";\n};\nif (!R.newbies) {\n  try { R.newbies = JSON.parse(get_variable(\"room_newbies\") || \"{}\") || {}; } catch (e) { R.newbies = {}; }\n}\n// seen(name, full): note a player seen in a room; true when the remembered\n// list changed.\nR.seen = function (name, full) {\n  if (!name) return false;\n  var k = String(name).toLowerCase();\n  var t = R.newbieTitle(name, full);\n  if (t) { var was = R.newbies[k] ? R.newbies[k].title : \"\"; R.newbies[k] = { title: t, t: Date.now() }; return was !== t; }\n  if (R.newbies[k]) { delete R.newbies[k]; return true; }\n  return false;\n};\nR.saveNewbies = function () { try { set_variable(\"room_newbies\", JSON.stringify(R.newbies)); } catch (e) {} };\nR.leaf = function (title) { return '<span title=\"' + String(title || \"newbie\").replace(/&/g, \"&amp;\").replace(/\"/g, \"&quot;\").replace(/</g, \"&lt;\") + '\" style=\"margin-left:4px;cursor:default;\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" style=\"vertical-align:-1px;\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M1.2 8.8C1.2 4.2 3.8 1.2 8.8 1.2C8.8 6.2 5.8 8.8 1.2 8.8Z\" fill=\"#8fd694\"/><path d=\"M1.6 8.4L6.2 3.8\" stroke=\"#2f5532\" stroke-width=\"0.9\"/></svg></span>'; };\n// Loyals (Ricardo): GMCP says nothing about whose a mob is (a loyal is\n// attrib \"m\" like any other), but PROBE does: \"He is loyal to Falau.\" (and\n// \"You see nothing in it.\" in place of a holding list on some). So every\n// living mob id seen for the first time is probed once, silently: one probe\n// at a time, every line gagged from the send until the probe's answer ends:\n// the line after \"<mob> is holding:\", \"You see nothing in it.\", \"What do you\n// wish to examine?\" (gone), or a prompt after its health line. A 2 s safety\n// timeout only for an answer that never comes. Probes wait while the basher has a run (a gagged combat line\n// would be lost), while triggers are paused, and while another package's answer\n// is still coming (R.probeOthers, #318). PROBE is free (Ricardo).\n//   R.loyal    id -> owner, \"\" = loyal to nobody; in memory only (ids are\n//              per mob, so a reload just probes again)\n//   R.probeQ   ids waiting; R.probing {id, name, at, owner, holding, lines}\n//   R.probeLast  the last probe's lines and how it ended, for ROOM PROBE DEBUG\n// ROOM PROBE ON|OFF (room_probe, default on).\nR.probeOn = get_variable(\"room_probe\") != \"off\";\nif (!R.loyal) R.loyal = {};\nif (!R.probeQ) R.probeQ = [];\nif (R.probing === undefined) R.probing = null;\nR.probeMs = 2000;\nR.loyalCap = 3000;\n// Queue a mob from Char.Items, unless it's dead, known, queued or being probed.\nR.probeAdd = function (it) {\n  if (!it || !/m/.test(it.attrib || \"\") || /d/.test(it.attrib || \"\")) return;\n  var id = String(it.id);\n  if (R.loyal.hasOwnProperty(id) || R.probeQ.indexOf(id) >= 0 || (R.probing && R.probing.id === id)) return;\n  R.probeQ.push(id);\n};\n// Whether the basher is fighting (its run, read through the basher-room link).\nR.probeBusy = function () {\n  var LL = client.loom.loom;\n  var q = (LL && LL.answer) ? LL.answer(\"room\", \"room.queue\", {}) : undefined;\n  return !!(q && (q.state === \"RUNNING\" || q.state === \"FLEEING\"));\n};\n// When probes may go out, by the game's own text, never a timer (Ricardo:\n// lag breaks time gates). The room you walk into arrives with its mob list,\n// and a probe sent then took the room's text for its answer. So after a move\n// (Room.Info) probes wait for the room's exits line, its last line; a mob\n// arriving where you stand is probed at the next prompt.\n//   R.probeHold  \"room\" while a moved-into room's text is still coming;\n//                lifted by its exits line, or by the second prompt after it\nR.probeExits = /^(?:You see (?:a single exit|exits) leading .*\\.|There are no obvious exits\\.)$/;\n// Which other packages still have an answer coming to something they sent\n// (their registry entry's busy(), #318): sigils' monolith probe, patrolling's\n// PLANTS and INFO HERE, a room being harvested, social's QW. A probe sent\n// before those answers arrive would gag them (Ricardo: SIGILS WATCH and the\n// first harvest went missing), and their lines could end the probe early.\n// The game answers in order, so a probe waits for them, never the other way.\n//   R.probeWaitOn  the names it waited on last, for ROOM PROBE\nR.probeOthers = function () {\n  var out = [], reg = client.loom.registry || {};\n  for (var k in reg) {\n    if (!reg.hasOwnProperty(k) || k === \"room\" || !reg[k] || typeof reg[k].busy !== \"function\") continue;\n    var b = false;\n    try { b = reg[k].busy(); } catch (e) { b = false; }\n    if (b) out.push(k);\n  }\n  return out;\n};\n// Send the next probe, if nothing is in the way. Called on room changes and\n// every prompt, so a wait ends by itself.\nR.probeNext = function () {\n  if (R.probing) {\n    if (Date.now() - R.probing.at > R.probeMs) R.probeEnd(false);\n    else return;\n  }\n  if (!R.probeOn || !R.probeQ.length || R.probeHold) return;\n  if (get_variable(\"pauseTriggers\") == \"on\" || R.probeBusy()) return;\n  R.probeWaitOn = R.probeOthers();\n  if (R.probeWaitOn.length) return;\n  while (R.probeQ.length) {\n    var id = R.probeQ.shift();\n    var it = R.items[id];\n    if (it && !/d/.test(it.attrib || \"\")) {\n      var p = { id: id, name: String(it.name || \"a mob\"), at: Date.now(), owner: \"\", holding: false, health: false, lines: [], how: \"\" };\n      R.probing = p;\n      clearTimeout(R.probeT);\n      R.probeT = setTimeout(function () { if (R.probing === p) { p.how = \"timeout\"; R.probeEnd(false); } }, R.probeMs);\n      send_command(\"probe \" + id, 1);\n      return;\n    }\n  }\n};\n// Whom \"loyal to X\" names, when X is a player: one capitalised word that\n// isn't a city. Wild mobs are loyal to their home too (\"He is loyal to Gnoll\n// fortress.\", Ricardo), and city denizens to their city: those are nobody's.\nR.loyalNot = [\"Ashtan\", \"Cyrene\", \"Eleusis\", \"Hashan\", \"Mhaldor\", \"Targossas\"];\nR.loyalOwner = function (x) {\n  x = String(x || \"\").trim();\n  return (/^[A-Z][a-z]+$/.test(x) && R.loyalNot.indexOf(x) < 0) ? x : \"\";\n};\n// Places named in one word look like players (\"He is loyal to Qurnok.\",\n// Ricardo): the player adds them by hand, ROOM PROBE IGNORE <name>.\n//   R.loyalIgnore  lowercased names, saved in room_loyal_ignore (JSON list)\n// R.loyal keeps what the probe read; the list is applied when read, so\n// UNIGNORE brings the marks back without probing again.\nR.loyalIgnore = [];\ntry {\n  var rmIg = JSON.parse(get_variable(\"room_loyal_ignore\") || \"[]\");\n  if (Object.prototype.toString.call(rmIg) === \"[object Array]\") {\n    for (var rmIgI = 0; rmIgI < rmIg.length; rmIgI++) { if (typeof rmIg[rmIgI] == \"string\" && rmIg[rmIgI]) R.loyalIgnore.push(rmIg[rmIgI].toLowerCase()); }\n  }\n} catch (e) { R.loyalIgnore = []; }\nR.saveLoyalIgnore = function () {\n  try { if (R.loyalIgnore.length) set_variable(\"room_loyal_ignore\", JSON.stringify(R.loyalIgnore)); else delete_variable(\"room_loyal_ignore\"); } catch (e) {}\n};\nR.loyalIgnored = function (x) { return R.loyalIgnore.indexOf(String(x || \"\").toLowerCase()) >= 0; };\n// The owner of mob id as shown: \"\" when nobody's or ignored, undefined when\n// not probed yet.\nR.ownerOf = function (id) {\n  var k = String(id);\n  if (!R.loyal.hasOwnProperty(k)) return undefined;\n  var o = R.loyal[k] || \"\";\n  return (o && !R.loyalIgnored(o)) ? o : \"\";\n};\n// Every line while a probe is out: gagged, and read.\nR.probeLine = function (line) {\n  var p = R.probing;\n  if (!p) return;\n  if (p.start !== undefined && !p.lines.length && line === p.start) { p.start = undefined; return; }\n  gag_current_line();\n  line = String(line || \"\").trim();\n  if (p.lines.length < 20) p.lines.push(line);\n  if (/ health remaining\\.$/.test(line)) p.health = true;\n  if (/^What do you wish to examine\\?$/.test(line)) { p.how = \"gone\"; R.probeEnd(false); return; }\n  var m = /^(?:He|She|It|They) (?:is|are) loyal to (.+?)\\.$/.exec(line);\n  if (m) { p.owner = R.loyalOwner(m[1]); return; }\n  if (p.holding) { p.how = \"holding\"; R.probeEnd(true); return; }\n  if (/^You see nothing in it\\.$/.test(line)) { p.how = \"nothing\"; R.probeEnd(true); return; }\n  if (/ (?:is|are) holding:$/.test(line)) p.holding = true;\n};\n// A prompt after the answer's health line (\"He has 95% health remaining.\")\n// ends a probe whose last lines were worded some other way. A prompt before\n// it (GMCP can come ahead of a packet's text) doesn't.\nR.probePrompt = function () {\n  var p = R.probing;\n  if (!p || !p.health) return false;\n  p.how = \"prompt\";\n  R.probeEnd(true);\n  return true;\n};\n// A probe's end: ok = the whole output was read. A loyal gets one notice.\nR.probeEnd = function (ok) {\n  var p = R.probing;\n  R.probing = null;\n  clearTimeout(R.probeT);\n  if (!p) return;\n  R.probeLast = { id: p.id, name: p.name, lines: p.lines, how: p.how || \"?\", ms: Date.now() - p.at };\n  if (ok) {\n    if (Object.keys(R.loyal).length >= R.loyalCap) R.loyal = {};\n    R.loyal[p.id] = p.owner;\n    if (p.owner && !R.loyalIgnored(p.owner)) {\n      display_notice(\"[room] \" + p.name + \" (\" + p.id + \") is loyal to \" + p.owner + \".\", \"cyan\");\n      if (client.loom.notify) client.loom.notify(\"room\");\n      R.drawSoon();\n    }\n  }\n  R.probeNext();\n};\n// The read-only look other packages see through loom: never its variables.\n//   look.newbie(name) -> the newbie title (\"Ithin\") someone was last seen\n//     with, or undefined.\n//   look.loyal(id) -> the owner's name when that mob is someone's loyal, \"\"\n//     when probed and loyal to nobody, undefined when not probed yet.\nR.look = {\n  newbie: function (name) { var e = R.newbies[String(name || \"\").toLowerCase()]; return e ? e.title : undefined; },\n  loyal: function (id) { return R.ownerOf(id); }\n};\n"
  },
  {
   "type": "function",
   "name": "room_render",
   "enabled": true,
   "code": "// room_render -- the Here tab (#158), in the house style shared with Stats,\n// Online, Standings: ink panel, serif small-caps headings, monospace rows. The\n// accent is a warm lantern amber.\n//   - header: room name, area and environment, details as tags, exits, number\n//   - description folded to two lines; a click on it unfolds it (a class on the\n//     page body, as Online's offline section, so redraws never undo it)\n//   - PLAYERS (you left off, full title on hover, a targeted one glowing\n//     red), MOBS (one row each, in the room's own order, so the next one a\n//     name would hit is the next row down; your target glows yellow in\n//     place, with its health; dead ones greyed),\n//     ITEMS (things you can take stand out, fixtures are muted), each as a\n//     table: quantity when more than one, the name, and a type column the\n//     integrations can fill (shrine, plant…)\n//   - the plants of the room's environment, under the description: here and\n//     stocked, here but low, or missing (#166, from harvesting and patrolling)\n// Integrations (0.5: #162 social colours (done), #163 hunting target, #164 shrines (done),\n// #165 sigils (done), #166 plants (done)) will mark rows through the display entry point #159.\nvar R = client.loom.room;\n// Tab theme (#310): loom's city palette when one is on, else this tab's own colours.\nvar TH = (client.loom && client.loom.theme) || {};\nvar AMBER = TH.acc || \"#e0b46c\";\nvar DEEP = TH.deep || \"#7a5f33\";\nvar TXT = TH.txt || \"#e8e2d6\";\nvar MUTED = TH.muted || \"#8f877a\";\nvar DIM = TH.dim || \"#6d665b\";\nvar RULE = TH.rule || \"#2b2620\";\nvar BG = TH.bg || \"#13110e\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\"); }\nfunction caps(t, n) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;font-size:11px;color:' + (n ? AMBER : DIM) + ';margin:8px 0 2px;border-top:1px solid ' + RULE + ';padding-top:5px;\">' + t + ' <span style=\"color:' + MUTED + ';\">' + n + '</span></div>'; }\n// A table row: quantity (when more than one), the name indented after it, and\n// a type column left empty for now (shrines, plants… from the integrations).\n// glow: false, or the colour of a targeted row (yellow mob, red player).\n// tint: an explicit row background (a flagged item), else the glow's own.\n// icon: html for a mark beside the quantity (a flagged item's icon), so\n// names stay aligned in every section.\nfunction row(n, name, title, type, glow, tint, icon) {\n  return '<div' + (title ? ' title=\"' + esc(title) + '\"' : '') + ' style=\"display:flex;align-items:baseline;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;cursor:default;' + (tint ? 'background:' + tint + ';' : (glow ? 'background:' + (glow === PGLOW ? 'rgba(255,106,94,0.08)' : 'rgba(255,215,94,0.07)') + ';' : '')) + '\">' +\n    '<span style=\"flex:0 0 3.4em;text-align:right;font-size:11px;color:' + MUTED + ';white-space:nowrap;\">' + (n > 1 ? n + '&times;' : '') + (icon || '') + '</span>' +\n    '<span style=\"flex:1 1 auto;\">' + name + '</span>' +\n    (type ? '<span style=\"flex:0 0 auto;font-size:12px;color:' + (glow || MUTED) + ';font-style:italic;font-family:' + SERIF + ';\">' + esc(type) + '</span>' : '') + '</div>';\n}\n// Merge items of the same name, keeping order of first appearance.\nfunction merge(list) {\n  var out = [], at = {};\n  for (var i = 0; i < list.length; i++) {\n    var k = list[i].name + \"|\" + (list[i].attrib || \"\");\n    if (at[k] === undefined) { at[k] = out.length; out.push({ it: list[i], n: 1 }); } else out[at[k]].n++;\n  }\n  return out;\n}\n\n// Your target: whichever changed last decides, alone. Either the game's\n// (IRE.Target.Info or IRE.Target.Set, in R.target: an id, or a word such as\n// a player's name or \"rat\"; an empty Set means no target) or the tar\n// variable (an id or a word). An id glows that mob; a word glows the player\n// of that name, else the first living mob whose name holds it. Info's\n// short_desc is the word when its id isn't in the room. The row glows, as in\n// the stock tab, with its health in the type column.\nvar GLOW = \"#ffd75e\";\nvar PGLOW = \"#ff6a5e\";\nvar tarV = String(get_variable(\"tar\") || \"\").trim();\nvar gm = R.target || null;\nvar useGmcp = !!(gm && (gm.none || gm.id || gm.name) && (!tarV || (gm.at || 0) >= (R.tarAt || 0)));\nvar tgtSrc = useGmcp ? (gm.none ? \"\" : String(gm.id || \"\")) : tarV;\nvar tgtId = /^\\d+$/.test(tgtSrc) ? tgtSrc : \"\";\nvar tgtWord = (tgtSrc && !tgtId) ? tgtSrc.toLowerCase() : ((useGmcp && !gm.none && gm.name) ? String(gm.name).toLowerCase() : \"\");\n\nvar I = R.info || {};\nvar html = '<div id=\"loom-here\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + BG + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;min-height:100%;box-sizing:border-box;\">';\nif (!R.info) {\n  html += '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">Waiting for the room… (move, or LOOK)</div>';\n} else {\n  var name = String(I.name || \"\").replace(/\\s*\\((?:indoors|outdoors)\\)\\s*$/i, \"\");\n  // Title (#275): the room name on the top left, the basher's chip on the top\n  // right, the area and environment on a second line under the name; so the\n  // chip doesn't slide down when a long name or area wraps.\n  // The basher's queue and state (#163, link basher-room): asked once a draw.\n  var BQ = (client.loom.loom && client.loom.loom.answer) ? client.loom.loom.answer(\"room\", \"room.queue\", { area: I.area }) : undefined;\n  var bBadge = \"\";\n  if (BQ && BQ.state) {\n    var bCol = { PRIMED: \"#c8bfae\", RUNNING: AMBER, FLEEING: \"#ff9a4c\" }[BQ.state] || MUTED;\n    bBadge = '<span title=\"the basher\" style=\"padding:0 5px;border:1px solid ' + DEEP + ';color:' + bCol + ';font-family:' + MONO + ';font-size:10px;letter-spacing:0.08em;white-space:nowrap;\">&#9876;&#xfe0e; ' + BQ.state + '</span>';\n  }\n  // REMEMBER / GO BACK (#367): in the title, under the basher's chip, in\n  // its style (Ricardo).\n  var mkBtn = \"\";\n  if (I.num) {\n    var mkHere = R.mark && R.mark.id === String(I.num);\n    var mkLbl = !R.mark ? \"remember\" : (mkHere ? \"remembered\" : \"go back\");\n    var mkCol = !R.mark ? MUTED : (mkHere ? DIM : AMBER);\n    var mkFn = !R.mark ? \"remember\" : (mkHere ? \"forget\" : \"back\");\n    var mkTip = !R.mark ? \"remember this room: then GO BACK walks you here\" : (mkHere ? \"remembered; click to forget it\" : \"walk back to \" + R.markName(R.mark) + (R.mark.area ? \", \" + R.mark.area : \"\") + \" (PATH FIND)\");\n    mkBtn = '<span class=\"loom-room-mark\" onclick=\"window.loomRoom&&window.loomRoom.' + mkFn + '()\" title=\"' + esc(mkTip) + '\" style=\"cursor:pointer;padding:0 5px;border:1px solid ' + (R.mark && !mkHere ? mkCol : DEEP) + ';color:' + mkCol + ';font-family:' + MONO + ';font-size:10px;letter-spacing:0.08em;white-space:nowrap;\">' + mkLbl.toUpperCase() + '</span>';\n  }\n  var titleRight = (bBadge || mkBtn) ? '<div style=\"flex:none;margin-top:3px;display:flex;flex-direction:column;align-items:flex-end;gap:3px;\">' + bBadge + mkBtn + '</div>' : '';\n  html += '<div style=\"border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:8px;\">';\n  // The name and, under it, the area: one column, so the chips on the right\n  // sit beside both lines.\n  html += '<div style=\"min-width:0;\"><div style=\"font-family:' + SERIF + ';color:' + AMBER + ';font-size:15px;letter-spacing:0.06em;\">' + esc(name) + '</div>';\n  html += '<div style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:11px;\">' + esc(I.area || \"\") + (I.environment ? ' &middot; ' + esc(I.environment) : '') + '</div></div>' + titleRight + '</div></div>';\n  // Details as tags, exits, room number.\n  var tags = \"\";\n  var det = I.details || [];\n  for (var di = 0; di < det.length; di++) tags += '<span style=\"display:inline-block;margin:0 4px 0 0;padding:0 4px;border:1px solid ' + DEEP + ';color:' + MUTED + ';\">' + esc(det[di]) + '</span>';\n  // Items flagged through loom's display entry point (item.flags: { label,\n  // tone }): shrines and totems of friendly or hostile gods (#164, from\n  // patrolling), later monoliths (#165). Worked out here so an alert also\n  // shows as a tag beside the details, seen without scrolling.\n  var LLi = client.loom.loom;\n  var FLAG = { bad: \"#ff9a4c\", good: \"#8fd694\", info: \"#c8bfae\" };\n  // Party members' names on the mobs they target (#256).\n  var PARTY = \"#8fc3d8\";\n  var LOYAL = \"#c8bfae\";\n  var OWNLOYAL = \"#8fd694\";\n  var flagOf = {}, alerts = {};\n  for (var fk in R.items) {\n    if (!R.items.hasOwnProperty(fk) || /m/.test(R.items[fk].attrib || \"\")) continue;\n    var fa = (LLi && LLi.answers) ? LLi.answers(\"room\", \"item.flags\", R.items[fk].name) : [];\n    if (fa.length) { flagOf[fk] = fa[0].value; if (fa[0].value.tone === \"bad\") alerts[fa[0].value.label] = true; }\n  }\n  // Room-wide warnings (room.alerts: [{ label, tone }]), e.g. a city room\n  // without a monolith (#165, from sigils), shown like an item's alert.\n  if (LLi && LLi.answers) {\n    var rNames = [];\n    for (var rk in R.items) { if (R.items.hasOwnProperty(rk) && !/m/.test(R.items[rk].attrib || \"\")) rNames.push(R.items[rk].name); }\n    var ra = LLi.answers(\"room\", \"room.alerts\", { id: I.num, area: I.area, environment: I.environment, items: rNames });\n    for (var ri = 0; ri < ra.length; ri++) {\n      var rv = ra[ri].value || [];\n      for (var rj = 0; rj < rv.length; rj++) {\n        if (rv[rj].tone !== \"bad\") continue;\n        alerts[rv[rj].label] = true;\n        // The rows the alert is about (e.g. the monolith itself) turn bad too.\n        if (rv[rj].mark) { for (var mk in flagOf) { if (flagOf.hasOwnProperty(mk) && flagOf[mk].label === rv[rj].mark) flagOf[mk] = { label: flagOf[mk].label, tone: \"bad\", icon: flagOf[mk].icon, title: rv[rj].label }; } }\n      }\n    }\n  }\n  // The plants of this environment (room.plants: [{ plant, present, low, stock,\n  // min }], #166, from harvesting and patrolling), small, one line (Ricardo):\n  // green when here and stocked, yellow when here but under its minimum, red\n  // when it isn't here at all, with a warning beside the details. Shown only\n  // once patrolling's PLANTS check has seen this room.\n  var rp = (LLi && LLi.answer) ? LLi.answer(\"room\", \"room.plants\", { id: I.num, area: I.area, environment: I.environment }) : undefined;\n  var plantsHtml = \"\";\n  if (rp && rp.length) {\n    var PCOL = { ok: \"#8fd694\", low: \"#e6c75a\", gone: \"#ff6a5e\" };\n    var nfmt = function (v) { return String(v).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"); };\n    var pbits = [], gone = 0;\n    for (var pi = 0; pi < rp.length; pi++) {\n      var pp = rp[pi];\n      var pk2 = !pp.present ? \"gone\" : (pp.low ? \"low\" : \"ok\");\n      if (pk2 === \"gone\") gone++;\n      var ptitle = pp.plant + \": \" + (pp.present ? \"here\" : \"not here\") + (pp.tracked === false ? \"\" : \"; \" + (pp.stock === null || pp.stock === undefined ? \"not seen in your rift yet\" : nfmt(pp.stock) + \" in the rift\") + \", minimum \" + nfmt(pp.min));\n      pbits.push((pi ? ' ' : '') + '<span title=\"' + esc(ptitle) + '\" style=\"white-space:nowrap;cursor:default;color:' + PCOL[pk2] + ';\">' + esc(pp.plant) + (pi < rp.length - 1 ? '<span style=\"color:' + DIM + ';\"> &middot;</span>' : '') + '</span>');\n    }\n    if (gone) alerts[gone === 1 ? \"1 plant missing\" : gone + \" plants missing\"] = true;\n    plantsHtml = '<div style=\"margin-top:3px;font-size:9px;line-height:1.5;\">' + pbits.join('') + '</div>';\n  }\n  for (var al in alerts) { if (alerts.hasOwnProperty(al)) tags += '<span style=\"display:inline-block;margin:0 4px 0 0;padding:0 4px;border:1px solid ' + FLAG.bad + ';color:' + FLAG.bad + ';\">\\u26a0 ' + esc(al) + '</span>'; }\n  var ex = [];\n  for (var ek in (I.exits || {})) { if (I.exits.hasOwnProperty(ek)) ex.push(ek); }\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-top:3px;\">';\n  html += '<span>' + tags + '</span>';\n  html += '<span style=\"white-space:nowrap;color:' + MUTED + ';\">exits <span style=\"color:' + AMBER + ';\">' + (ex.length ? esc(ex.join(\"  \")) : \"none\") + '</span>' + (I.num ? ' &middot; ' + esc(I.num) : '') + '</span></div>';\n  if (I.desc) {\n    html += '<div onclick=\"document.body.classList.toggle(\\'loom-room-desc-open\\')\" title=\"click to unfold or fold\" class=\"loom-room-desc\" style=\"cursor:pointer;margin-top:4px;font-family:' + SERIF + ';font-size:11px;line-height:1.35;color:' + MUTED + ';\">' + esc(I.desc) + '</div>';\n  }\n  html += plantsHtml;\n\n  // Players, you left off. A player you target glows red: the tar name, or\n  // the game's target info naming them, whichever changed last. A player\n  // match wins over a mob whose name merely contains the word.\n  var pl = [];\n  for (var pk in R.players) { if (R.players.hasOwnProperty(pk) && pk.toLowerCase() !== String(R.me).toLowerCase()) pl.push(pk); }\n  pl.sort();\n  var tgtPl = \"\";\n  for (var pt = 0; pt < pl.length; pt++) {\n    var plL = pl[pt].toLowerCase();\n    if (tgtWord === plL) { tgtPl = pl[pt]; break; }\n  }\n  if (tgtPl) { tgtWord = \"\"; tgtId = \"\"; }\n  html += caps(\"players\", pl.length);\n  // Through loom's display entry point (#159): a player's highlight colour\n  // and group from social (#162), when both are installed and the link is\n  // on; otherwise plain. The target glow still wins.\n  var LL = client.loom.loom;\n  var ask = function (q, n) { return (LL && LL.answer) ? LL.answer(\"room\", q, n) : undefined; };\n  for (var pi = 0; pi < pl.length; pi++) {\n    var isT = pl[pi] === tgtPl;\n    var pHp = (isT && useGmcp && R.target.hp !== \"\") ? R.target.hp + \"%\" : (isT ? \"target\" : \"\");\n    var pCol = ask(\"person.colour\", pl[pi]);\n    var pGrp = ask(\"person.group\", pl[pi]);\n    var pTitle = R.players[pl[pi]] || \"\";\n    if (pGrp) pTitle = (pTitle ? pTitle + \" \\u00b7 \" : \"\") + pGrp;\n    html += row(1, '<span style=\"font-family:' + SERIF + ';font-size:14px;color:' + (isT ? PGLOW + ';text-shadow:0 0 6px ' + PGLOW + ',0 0 2px ' + PGLOW : (pCol || TXT)) + ';\">' + esc(pl[pi]) + '</span>' + (R.newbieTitle(pl[pi], R.players[pl[pi]]) ? R.leaf(\"newbie (\" + R.newbieTitle(pl[pi], R.players[pl[pi]]) + \")\") : ''), pTitle, pHp, isT ? PGLOW : false);\n  }\n\n  // Mobs and items, in the room's own order (R.order; ids not in it, which\n  // shouldn't happen, after them).\n  var mobs = [], items = [], seenId = {};\n  var ord = (R.order || []).slice();\n  for (var ik in R.items) { if (R.items.hasOwnProperty(ik) && ord.indexOf(String(ik)) < 0) ord.push(String(ik)); }\n  for (var oi = 0; oi < ord.length; oi++) {\n    var it = R.items[ord[oi]];\n    if (!it || seenId[ord[oi]]) continue;\n    seenId[ord[oi]] = true;\n    if (/m/.test(it.attrib || \"\")) mobs.push(it); else items.push(it);\n  }\n  // Items you can't pick up first, then the ones you can (#280), each in the\n  // room's order.\n  var fixedIt = [], takeIt = [];\n  for (var si = 0; si < items.length; si++) (/t/.test(items[si].attrib || \"\") ? takeIt : fixedIt).push(items[si]);\n  items = fixedIt.concat(takeIt);\n  // Mobs one row each (Ricardo: merging them, then splitting the target out\n  // and lifting it to the top, made it hard to see what comes next). The\n  // target glows where it stands: by id, or the first living mob whose name\n  // holds the tar word, as the game would pick it.\n  var tgtMob = null;\n  for (var ti = 0; ti < mobs.length && !tgtMob; ti++) { if (tgtId && String(mobs[ti].id) === tgtId) tgtMob = mobs[ti]; }\n  for (var tj = 0; tj < mobs.length && !tgtMob && tgtWord; tj++) { if (!/d/.test(mobs[tj].attrib || \"\") && mobs[tj].name.toLowerCase().indexOf(tgtWord) >= 0) tgtMob = mobs[tj]; }\n  html += caps(\"mobs\", mobs.length);\n  // With the basher's queue (#163): each living mob's place in the kill\n  // order as a badge (filled on your target, outlined in gold on the next),\n  // ignored types dimmed. Only once the area's list has an active type.\n  var useQ = !!(BQ && BQ.listed);\n  var badge = function (n, fill, ring) {\n    return '<span style=\"display:inline-block;min-width:1.4em;text-align:center;border-radius:8px;font-size:10px;padding:0 3px;' + (fill ? 'background:' + GLOW + ';color:' + BG + ';' : 'border:1px solid ' + ring + ';color:' + ring + ';') + '\">' + n + '</span>';\n  };\n  // Mobs flagged through loom (mob.flags: { label, tone, icon, title }), e.g.\n  // the oysters that drop pearls (#299, from crystalism): the name in the\n  // tone's colour and the icon after any kill-order badge. Living mobs only;\n  // your target's glow still wins.\n  var mobFlag = function (m) {\n    if (/d/.test(m.attrib || \"\") || !LLi || !LLi.answers) return undefined;\n    var a = LLi.answers(\"room\", \"mob.flags\", m.name);\n    return a.length ? a[0].value : undefined;\n  };\n  var flagIcon = function (f) {\n    return (f && f.icon) ? '<span style=\"font-family:\\'Segoe UI Symbol\\',\\'DejaVu Sans\\',\\'Noto Sans Symbols\\',\\'Noto Sans Symbols 2\\',sans-serif;font-size:13px;color:' + (FLAG[f.tone] || MUTED) + ';margin-left:3px;\">' + esc(f.icon) + '\\ufe0e</span>' : '';\n  };\n  for (var mi = 0; mi < mobs.length; mi++) {\n    var mob = mobs[mi];\n    var mf = mobFlag(mob);\n    var mfCol = mf ? (FLAG[mf.tone] || TXT) : TXT;\n    var mfTitle = mf ? (mf.title || mf.label || \"\") : \"\";\n    // Party members on this mob (mob.party, #256, from partycomms): their\n    // names after the mob's, small, and in the hover.\n    var pty = (!/d/.test(mob.attrib || \"\") && LLi && LLi.answer) ? LLi.answer(\"room\", \"mob.party\", String(mob.id)) : undefined;\n    // In the names' own font and size, as Players and the mob's name (#365).\n    var ptyTag = (pty && pty.length) ? ' <span style=\"font-family:' + SERIF + ';font-size:14px;color:' + PARTY + ';white-space:nowrap;text-shadow:none;\">&#9666; ' + esc(pty.join(\" \\u00b7 \")) + '</span>' : '';\n    if (pty && pty.length) mfTitle = (mfTitle ? mfTitle + \" \\u00b7 \" : \"\") + \"targeted by \" + pty.join(\", \");\n    // Someone's loyal (found by PROBE), Ricardo: a knight on the left (in the\n    // badge column: loyals never get a kill-order number) and the owner in\n    // brackets after the name, not to be confused with party members'\n    // targets. Your own loyals: the knight and the name green, no owner;\n    // others in the owner's Social group colour when they have one. The\n    // owner in the hover either way.\n    var loy = /d/.test(mob.attrib || \"\") ? \"\" : (R.ownerOf(mob.id) || \"\");\n    var loyIcon = \"\";\n    if (loy) {\n      var loyMine = !!R.me && loy.toLowerCase() === String(R.me).toLowerCase();\n      var loyCol = loyMine ? OWNLOYAL : (ask(\"person.colour\", loy) || LOYAL);\n      loyIcon = '<span style=\"font-family:\\'Segoe UI Symbol\\',\\'DejaVu Sans\\',\\'Noto Sans Symbols\\',\\'Noto Sans Symbols 2\\',sans-serif;font-size:13px;color:' + loyCol + ';\">&#9822;&#xfe0e;</span>';\n      // Yours: the mob's own name in green, no owner (Ricardo).\n      if (loyMine) mfCol = OWNLOYAL;\n      else ptyTag = ' <span style=\"font-family:' + SERIF + ';font-size:14px;color:' + loyCol + ';white-space:nowrap;text-shadow:none;\">(' + esc(loy) + ')</span>' + ptyTag;\n      mfTitle = \"loyal to \" + loy + (mfTitle ? \" \\u00b7 \" + mfTitle : \"\");\n    }\n    var mid = String(mob.id);\n    var rank = useQ ? BQ.order[mid] : undefined;\n    var isNext = useQ && BQ.next === mid;\n    var ignored = useQ && rank === undefined && !/d/.test(mob.attrib || \"\") && BQ.active && BQ.active[mob.name] === false;\n    if (mob === tgtMob) {\n      var tHp = (R.target && String(R.target.id) === String(mob.id) && R.target.hp !== \"\") ? R.target.hp + \"%\" : \"target\";\n      html += row(1, '<span style=\"font-family:' + SERIF + ';font-size:14px;color:' + GLOW + ';text-shadow:0 0 6px ' + GLOW + ',0 0 2px ' + GLOW + ';\">' + esc(mob.name) + '</span>' + ptyTag, \"your target\" + (rank ? \" \\u00b7 \" + rank + \" in the kill order\" : \"\") + (mfTitle ? \" \\u00b7 \" + mfTitle : \"\"), tHp, GLOW, false, loyIcon + (rank ? badge(rank, true) : \"\") + flagIcon(mf));\n    } else if (ignored) {\n      html += '<div style=\"opacity:.45;\">' + row(1, '<span style=\"font-family:' + SERIF + ';font-size:14px;color:' + mfCol + ';\">' + esc(mob.name) + '</span>' + ptyTag, \"ignored by the basher in this area\" + (mfTitle ? \" \\u00b7 \" + mfTitle : \"\"), \"ignored\", false, false, (loyIcon || '<span style=\"color:' + DIM + ';\">&ndash;</span>') + flagIcon(mf)) + '</div>';\n    } else {\n      // Dead ones are greyed out; their name already says \"the corpse of…\".\n      var dead = /d/.test(mob.attrib || \"\");\n      var bdg = rank ? badge(rank, false, isNext ? GLOW : DIM) : \"\";\n      html += row(1, '<span style=\"font-family:' + SERIF + ';font-size:14px;color:' + (dead ? DIM : mfCol) + ';\">' + esc(mob.name) + '</span>' + ptyTag, [rank ? (isNext ? \"next for the basher\" : rank + \" in the kill order\") : \"\", mfTitle].filter(Boolean).join(\" \\u00b7 \"), isNext ? \"next\" : \"\", isNext ? \"#c8a94e\" : false, isNext ? \"transparent\" : false, loyIcon + bdg + flagIcon(mf));\n    }\n  }\n  var im = merge(items);\n  html += caps(\"items\", items.length);\n  for (var ii = 0; ii < im.length; ii++) {\n    var take = /t/.test(im[ii].it.attrib || \"\");\n    var fl = flagOf[im[ii].it.id];\n    if (fl) {\n      var fc = FLAG[fl.tone] || MUTED;\n      // The flag as an icon left of the name, the words on hover (Ricardo).\n      var ficon = fl.icon ? '<span style=\"font-family:\\'Segoe UI Symbol\\',\\'DejaVu Sans\\',\\'Noto Sans Symbols\\',\\'Noto Sans Symbols 2\\',sans-serif;font-size:13px;color:' + fc + ';margin-left:3px;\">' + esc(fl.icon) + '\\ufe0e</span>' : '';\n      html += row(im[ii].n, '<span style=\"font-family:' + SERIF + ';font-size:13px;color:' + (fl.tone === \"bad\" || fl.tone === \"good\" ? fc : (take ? TXT : MUTED)) + ';\">' + esc(im[ii].it.name) + '</span>', fl.title || fl.label || \"\", fl.icon ? \"\" : fl.label, fc, fl.tone === \"bad\" ? \"rgba(255,154,76,0.09)\" : \"transparent\", ficon);\n    } else {\n      html += row(im[ii].n, '<span style=\"font-family:' + SERIF + ';font-size:13px;color:' + (take ? TXT : MUTED) + ';\">' + esc(im[ii].it.name) + '</span>', take ? \"you can take this\" : \"\");\n    }\n  }\n}\nhtml += '</div>';\n// The description's fold: a style once per page, the body class from the setting.\ntry {\n  var rmSt = document.getElementById(\"loom-room-style\");\n  if (!rmSt) {\n    rmSt = document.createElement(\"style\");\n    rmSt.id = \"loom-room-style\";\n    document.head.appendChild(rmSt);\n    document.body.classList.toggle(\"loom-room-desc-open\", R.descOpen === true);\n  }\n  // The fold, and the tab the same size whatever the room holds: the panel\n  // fills the tab, and the tab's own container takes the panel's ink in\n  // case Nexus doesn't pass its height down. Rewritten on every draw, so a\n  // theme change (#310) reaches it.\n  rmSt.textContent = 'body:not(.loom-room-desc-open) .loom-room-desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; } ' +\n    '.flexlayout__tab:has(#loom-here) { background: ' + BG + ' !important; } .flexlayout__tab:has(#loom-here) > * { min-height: 100%; }';\n} catch (e) {}\ntry { set_custom_tab_html(R.tab, html); } catch (e) {}\n"
  },
  {
   "type": "function",
   "name": "room_help",
   "enabled": true,
   "code": "// room_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[room] the Here tab: the room you are in, its exits, players, mobs and items. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"ROOM\", \"the room in a line, and how the description starts\"],\n  [\"ROOM DESC OPEN|FOLDED\", \"show the description in full, or folded to two lines (clicking it flips it too)\"],\n  [\"ROOM PROBE [ON|OFF]\", \"loyals: probe each new mob once, silently, and mark the ones loyal to someone (default ON)\"],\n  [\"ROOM PROBE IGNORE [name]\", \"places read as owners (\\\"loyal to Qurnok\\\"): mobs loyal to them aren't marked; no name lists them\"],\n  [\"ROOM PROBE UNIGNORE <name>\", \"take a name off that list\"],\n  [\"ROOM PROBE DEBUG\", \"the lines the last probe hid, and what ended it\"],\n  [\"ROOM REMEMBER\", \"remember this room (REMEMBER in Here does the same)\"],\n  [\"ROOM BACK\", \"walk back to the remembered room with PATH FIND (GO BACK in Here)\"],\n  [\"ROOM FORGET\", \"forget the remembered room\"],\n  [\"ROOM DEBUG\", \"the last room GMCP payloads, as they came\"],\n  [\"The Here tab replaces the stock Room tab: create a custom tab named Here, then close the stock one from the layout if you like.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "trigger",
   "name": "room cwho header",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// CWHO's header (\"Citizen Rank CT Class\"): the citizen rows that follow\n// tell who carries a newbie title (#242). Rows count for two seconds after\n// it (CWHO arrives in one go); nothing is sent for it.\nif (!client.loom || !client.loom.room || !client.loom.room.raw) run_function(\"room_setup\", [], \"room\");\nclient.loom.room.cwhoAt = Date.now();\nclient.loom.room.cwhoDirty = false;\n"
    }
   ],
   "text": "^Citizen\\s+Rank\\s+CT\\s+Class\\s*$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "room cwho row",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// A CWHO row, e.g. \"*Ithin Mealla, of Eleusis 1 On Sylvan\" or \"Sapling\n// Kryssla, Tuqad of the Aureliana 1 On Druid\" (#242): the name is the last\n// word before the comma (titles come first), the newbie title may be on\n// either side. Remembered as a newbie with one, forgotten without one.\n// Only right after CWHO's header.\nvar R = client.loom && client.loom.room;\nif (R && R.cwhoAt && Date.now() - R.cwhoAt < 2000) {\n  var cwFull = String(args[1]).replace(/^\\*/, \"\").trim();\n  var cwWords = cwFull.split(\",\")[0].trim().split(/\\s+/);\n  var cwName = cwWords[cwWords.length - 1];\n  if (/^[A-Z][a-z]+$/.test(cwName) && R.seen(cwName, cwFull)) {\n    R.saveNewbies();\n    if (client.loom.notify) client.loom.notify(\"room\");\n    if (R.drawSoon) R.drawSoon(); else run_function(\"room_render\", [], \"room\");\n  }\n}\n"
    }
   ],
   "text": "^(\\*?[A-Z].*?)\\s+\\d+\\s+(?:On|Off)\\s+[A-Z][A-Za-z ]+$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "room player arrives",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "client.loom = client.loom || {}; client.loom.room = client.loom.room || {}; client.loom.room.lineKind = \"in\";"
    },
    {
     "type": "script",
     "enabled": true,
     "script": "// Players arriving and leaving without GMCP: flying up and landing send no\n// Room.AddPlayer / Room.RemovePlayer, so these lines keep the Here tab right\n// until the next Room.Players (on your next move) settles it. Each line's\n// name is the first capture group that matched, so more wordings can be added\n// to the triggers' alternations as Ricardo finds them.\nif (!client.loom || !client.loom.room || !client.loom.room.raw) run_function(\"room_setup\", [], \"room\");\nvar R = client.loom.room;\nvar plName = \"\";\nfor (var plI = 1; plI < args.length; plI++) { if (args[plI]) { plName = String(args[plI]); break; } }\nif (plName && plName.toLowerCase() !== String(R.me).toLowerCase()) {\n  if (R.lineKind === \"in\") { if (!R.players[plName]) R.players[plName] = plName; }\n  else delete R.players[plName];\n  R.drawSoon();\n}\n"
    }
   ],
   "text": "^(?:([A-Z][a-z]+) descends from above\\.)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "room player leaves",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "client.loom = client.loom || {}; client.loom.room = client.loom.room || {}; client.loom.room.lineKind = \"out\";"
    },
    {
     "type": "script",
     "enabled": true,
     "script": "// Players arriving and leaving without GMCP: flying up and landing send no\n// Room.AddPlayer / Room.RemovePlayer, so these lines keep the Here tab right\n// until the next Room.Players (on your next move) settles it. Each line's\n// name is the first capture group that matched, so more wordings can be added\n// to the triggers' alternations as Ricardo finds them.\nif (!client.loom || !client.loom.room || !client.loom.room.raw) run_function(\"room_setup\", [], \"room\");\nvar R = client.loom.room;\nvar plName = \"\";\nfor (var plI = 1; plI < args.length; plI++) { if (args[plI]) { plName = String(args[plI]); break; } }\nif (plName && plName.toLowerCase() !== String(R.me).toLowerCase()) {\n  if (R.lineKind === \"in\") { if (!R.players[plName]) R.players[plName] = plName; }\n  else delete R.players[plName];\n  R.drawSoon();\n}\n"
    }
   ],
   "text": "^(?:([A-Z][a-z]+) begins to flap (?:his|her|their|its) wings powerfully, and rises quickly up into the firmament\\.)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "room target line",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// The game's own confirmation of a new target (ST / SETTARGET), e.g.\n// \"Your target is now: Rat (a denizen)\". Ricardo, #205: after targeting a\n// player, ST RAT left the player lit. This line arrives whatever GMCP does or\n// doesn't send, so it sets the target too, as a word (a player's name, or a\n// word in a mob's name): whichever of this, IRE.Target.*, or the tar variable\n// changed last decides the glow.\nif (!client.loom || !client.loom.room || !client.loom.room.raw) run_function(\"room_setup\", [], \"room\");\nvar R = client.loom.room;\nvar tlName = String(args[1] || \"\").trim();\nif (tlName) {\n  R.target = { id: tlName, name: \"\", hp: \"\", at: Date.now(), line: String(args[2] || \"\") };\n  R.drawSoon();\n}\n"
    }
   ],
   "text": "^Your target is now: (.+?)(?: \\((.+)\\))?\\.?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "room exits line",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// The exits line ends a room's text (LOOK, or walking in): probes held since\n// the move (R.probeHold) may go now, after it, never during it.\nif (client.loom && client.loom.room && client.loom.room.probeHold && !client.loom.room.probing) {\n  client.loom.room.probeHold = \"\";\n  client.loom.room.probeNext();\n  // The probe's catch-all trigger sees this same line next: not its answer.\n  if (client.loom.room.probing) client.loom.room.probing.start = current_text();\n}\n"
    }
   ],
   "text": "^(?:You see (?:a single exit|exits) leading .*\\.|There are no obvious exits\\.)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "room probe line",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Every line, while room has a PROBE out (loyals): gagged and read by\n// R.probeLine. Nothing happens otherwise.\nif (client.loom && client.loom.room && client.loom.room.probing) client.loom.room.probeLine(current_text());\n"
    }
   ],
   "text": "^",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "alias",
   "name": "room",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// ROOM [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.room || !client.loom.room.raw) run_function(\"room_setup\", [], \"room\");\nvar R = client.loom.room;\nvar rmW = String(args[1] || \"\").trim().toLowerCase().split(/\\s+/);\nvar rmSub = rmW[0];\nfunction rmSay(t, c) { display_notice(\"[room] \" + t, c || \"cyan\"); }\nif (rmSub === \"\" || rmSub === \"status\") {\n  var rmI = R.info || {};\n  var rmP = 0, rmMo = 0, rmIt = 0;\n  for (var k in R.players) { if (R.players.hasOwnProperty(k) && k.toLowerCase() !== String(R.me).toLowerCase()) rmP++; }\n  for (var j in R.items) { if (R.items.hasOwnProperty(j)) { if (/m/.test(R.items[j].attrib || \"\")) rmMo++; else rmIt++; } }\n  rmSay(R.info ? (String(rmI.name).replace(/\\s*\\((?:indoors|outdoors)\\)\\s*$/i, \"\") + \" (\" + rmI.num + \"), \" + rmI.area + \": \" + rmP + \" player\" + (rmP === 1 ? \"\" : \"s\") + \", \" + rmMo + \" mob\" + (rmMo === 1 ? \"\" : \"s\") + \", \" + rmIt + \" item\" + (rmIt === 1 ? \"\" : \"s\") + \".\") : \"no room data yet: move or LOOK.\");\n  rmSay(\"the Here tab shows it; the description starts \" + (R.descOpen ? \"open\" : \"folded\") + \". ROOM HELP for commands.\");\n} else if (rmSub === \"help\") {\n  run_function(\"room_help\", [], \"room\");\n} else if (rmSub === \"desc\") {\n  var rmD = rmW[1] || \"\";\n  if (rmD === \"open\" || rmD === \"folded\" || rmD === \"fold\") {\n    R.descOpen = rmD === \"open\";\n    set_variable(\"room_desc\", R.descOpen ? \"open\" : \"folded\");\n    try { document.body.classList.toggle(\"loom-room-desc-open\", R.descOpen); } catch (e) {}\n    rmSay(\"the description starts \" + (R.descOpen ? \"open\" : \"folded\") + \" now.\", \"lime\");\n  } else {\n    rmSay(\"the description starts \" + (R.descOpen ? \"open\" : \"folded\") + \". ROOM DESC OPEN or FOLDED to change it; clicking it flips it too.\");\n  }\n} else if (rmSub === \"probe\") {\n  var rmPv = rmW[1] || \"\";\n  if (rmPv === \"debug\") {\n    var rmPl = R.probeLast;\n    if (!rmPl) rmSay(\"no probe has ended yet.\");\n    else {\n      rmSay(\"last probe: \" + rmPl.name + \" (\" + rmPl.id + \"), ended by \" + rmPl.how + \" after \" + rmPl.ms + \" ms, \" + rmPl.lines.length + \" line\" + (rmPl.lines.length === 1 ? \"\" : \"s\") + \" hidden:\");\n      for (var rmPd = 0; rmPd < rmPl.lines.length; rmPd++) rmSay(\"  \" + rmPl.lines[rmPd]);\n    }\n  } else if (rmPv === \"ignore\" || rmPv === \"unignore\") {\n    // Names the probe reads as owners that are places (Qurnok): not loyals.\n    var rmNm = rmW.slice(2).join(\" \").trim();\n    if (!rmNm) {\n      rmSay(\"not loyals, whoever they're loyal to: \" + (R.loyalIgnore.length ? R.loyalIgnore.map(function (n) { return n.charAt(0).toUpperCase() + n.slice(1); }).join(\", \") : \"none\") + \". ROOM PROBE IGNORE <name> to add one, UNIGNORE <name> to take it off.\");\n    } else {\n      var rmNl = rmNm.toLowerCase(), rmNc = rmNl.charAt(0).toUpperCase() + rmNl.slice(1);\n      var rmAt = R.loyalIgnore.indexOf(rmNl);\n      if (rmPv === \"ignore\") {\n        if (rmAt >= 0) rmSay(\"mobs loyal to \" + rmNc + \" are already not marked.\");\n        else { R.loyalIgnore.push(rmNl); R.saveLoyalIgnore(); rmSay(\"mobs loyal to \" + rmNc + \" are no longer marked as loyals.\", \"lime\"); }\n      } else {\n        if (rmAt < 0) rmSay(rmNc + \" isn't on the list. ROOM PROBE IGNORE lists it.\", \"orange\");\n        else { R.loyalIgnore.splice(rmAt, 1); R.saveLoyalIgnore(); rmSay(\"mobs loyal to \" + rmNc + \" are marked as loyals again.\", \"lime\"); }\n      }\n      if (client.loom.notify) client.loom.notify(\"room\");\n    }\n  } else if (rmPv === \"on\" || rmPv === \"off\") {\n    R.probeOn = rmPv === \"on\";\n    set_variable(\"room_probe\", rmPv);\n    if (!R.probeOn) R.probeQ = [];\n    rmSay(R.probeOn ? \"new mobs are probed (silently) for whose loyal they are.\" : \"no more probing; loyals already found stay marked.\", \"lime\");\n    if (R.probeOn) { for (var rmPi in R.items) { if (R.items.hasOwnProperty(rmPi)) R.probeAdd(R.items[rmPi]); } R.probeHold = \"\"; R.probeNext(); }\n  } else {\n    var rmLy = [];\n    for (var rmLi in R.loyal) { if (R.loyal.hasOwnProperty(rmLi) && R.ownerOf(rmLi)) rmLy.push(rmLi + \" (\" + R.ownerOf(rmLi) + \")\"); }\n    rmSay(\"probing is \" + (R.probeOn ? \"on\" : \"off\") + \"; \" + Object.keys(R.loyal).length + \" mobs probed, loyals: \" + (rmLy.length ? rmLy.join(\", \") : \"none\") + (R.probeQ.length ? \"; \" + R.probeQ.length + \" waiting\" + (R.probeBusy() ? \" (the basher is fighting)\" : (R.probeOthers().length ? \" (after \" + R.probeOthers().join(\", \") + \")\" : \"\")) : \"\") + \". ROOM PROBE ON|OFF to change it.\");\n  }\n} else if (rmSub === \"remember\") {\n  R.remember();\n} else if (rmSub === \"back\") {\n  R.goBack();\n} else if (rmSub === \"forget\") {\n  R.forget();\n} else if (rmSub === \"debug\") {\n  // The last payload of each GMCP message the tab reads, as JSON.\n  var rmK = Object.keys(R.raw);\n  if (!rmK.length) rmSay(\"no room GMCP seen yet.\");\n  for (var rmX = 0; rmX < rmK.length; rmX++) {\n    var rmS = JSON.stringify(R.raw[rmK[rmX]]);\n    rmSay(rmK[rmX] + \" \" + (rmS.length > 600 ? rmS.slice(0, 600) + \"…\" : rmS));\n  }\n  rmSay(\"me=\" + (R.me || \"?\") + \" players=\" + Object.keys(R.players).length + \" items=\" + Object.keys(R.items).length);\n} else {\n  rmSay(\"unknown command '\" + rmSub + \"'. ROOM HELP for commands.\", \"orange\");\n}\nrun_function(\"room_render\", [], \"room\");\n"
    }
   ],
   "text": "^room(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false
  }
 ],
 "description": "A Here tab replacing the stock Room tab: exits, players, mobs and items"
}