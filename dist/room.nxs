{
 "type": "group",
 "name": "room",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"room_setup\", [], \"room\");\nrun_function(\"room_render\", [], \"room\");\ndisplay_notice(\"[room] installed. Create a custom tab named Here; it fills in as you move. ROOM HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; room_name and room_desc are left intact.\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon (Here, #158): pure CSS keyed on the tab button's title, so Nexus's\n// own redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"Here\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 17 17\"><path d=\"M3 15.5 V4.5 A5.5 5.5 0 0 1 14 4.5 V15.5\" fill=\"none\" stroke=\"#e8e2d6\" stroke-width=\"1.3\"/><path d=\"M1.5 15.5 H15.5\" stroke=\"#e8e2d6\" stroke-width=\"1.3\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"2\" fill=\"#e0b46c\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\n\nrun_function(\"room_setup\", [], \"room\");\nrun_function(\"room_render\", [], \"room\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Everything on the Here tab comes from GMCP: Room.Info for the room, Room.Players\n// and Add/RemovePlayer for who's here, Char.Items (location \"room\") for mobs and\n// items. A room change sends several of these in a row, so the tab is drawn\n// once, 50ms after the last of them.\nvar rmM = \"\";\nvar rmA = null;\ntry { rmM = args.gmcp_method; rmA = args.gmcp_args; } catch (e) { rmM = \"\"; }\nif (typeof rmA === \"string\") { try { rmA = JSON.parse(rmA); } catch (e) { /* a bare name, as RemovePlayer may send */ } }\nvar rmMine = /^Room\\.(Info|Players|AddPlayer|RemovePlayer)$/.test(rmM) || (/^Char\\.Items\\.(List|Add|Remove|Update)$/.test(rmM) && rmA && rmA.location === \"room\") || rmM === \"Char.Name\" || rmM === \"Char.Status\";\nif (rmMine) {\n  if (!client.loom || !client.loom.room || !client.loom.room.raw) run_function(\"room_setup\", [], \"room\");\n  var R = client.loom.room;\n  if (rmM !== \"Char.Status\") R.raw[rmM] = rmA;\n  var rmDraw = true;\n  if (rmM === \"Room.Info\" && rmA) {\n    R.info = rmA;\n  } else if (rmM === \"Room.Players\" && rmA && rmA.length !== undefined) {\n    R.players = {};\n    for (var rmI = 0; rmI < rmA.length; rmI++) { if (rmA[rmI] && rmA[rmI].name) R.players[rmA[rmI].name] = rmA[rmI].fullname || rmA[rmI].name; }\n  } else if (rmM === \"Room.AddPlayer\" && rmA && rmA.name) {\n    R.players[rmA.name] = rmA.fullname || rmA.name;\n  } else if (rmM === \"Room.RemovePlayer\" && rmA) {\n    delete R.players[typeof rmA === \"string\" ? rmA : rmA.name];\n  } else if (rmM === \"Char.Items.List\") {\n    R.items = {};\n    var rmL = rmA.items || [];\n    for (var rmJ = 0; rmJ < rmL.length; rmJ++) R.items[rmL[rmJ].id] = rmL[rmJ];\n  } else if ((rmM === \"Char.Items.Add\" || rmM === \"Char.Items.Update\") && rmA.item) {\n    R.items[rmA.item.id] = rmA.item;\n  } else if (rmM === \"Char.Items.Remove\" && rmA.item !== undefined) {\n    delete R.items[typeof rmA.item === \"object\" ? rmA.item.id : rmA.item];\n  } else if ((rmM === \"Char.Name\" || rmM === \"Char.Status\") && rmA && rmA.name) {\n    rmDraw = false;\n    if (String(rmA.name) !== R.me) { R.me = String(rmA.name); try { set_variable(\"room_name\", R.me); } catch (e) {} rmDraw = true; }\n  } else {\n    rmDraw = false;\n  }\n  if (rmDraw) {\n    clearTimeout(R.drawT);\n    R.drawT = setTimeout(function () { run_function(\"room_render\", [], \"room\"); }, 50);\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "room_setup",
   "enabled": true,
   "code": "// room_setup -- run from onLoad and onInstall, and by any reflex that finds\n// the namespace missing. Namespace, registry and state for the Here tab\n// (#158), a replacement for the stock Room tab fed only by GMCP:\n//   R.info     the last Room.Info (name, desc, area, environment, details, exits, num)\n//   R.players  name -> fullname, from Room.Players / AddPlayer / RemovePlayer\n//   R.items    id -> item, from Char.Items List / Add / Remove / Update (location \"room\")\n//   R.me       your name (Char.Name / Char.Status, kept as room_name), left off the players\n//   R.raw      the last payload of each method, for ROOM DEBUG\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.room) client.loom.room = {};\nclient.loom.registry.room = { version: \"0.1.0\", keyword: \"ROOM\", desc: \"A Here tab replacing the stock Room tab: exits, players, mobs and items\" };\nvar R = client.loom.room;\nif (!R.info) R.info = null;\nif (!R.players) R.players = {};\nif (!R.items) R.items = {};\nif (!R.raw) R.raw = {};\nif (!R.me) { try { R.me = String(get_variable(\"room_name\") || \"\"); } catch (e) { R.me = \"\"; } }\n// The description starts folded to two lines (room_desc \"folded\"/\"open\").\nR.descOpen = get_variable(\"room_desc\") == \"open\";\nR.tab = \"Here\";\n"
  },
  {
   "type": "function",
   "name": "room_render",
   "enabled": true,
   "code": "// room_render -- the Here tab (#158), in the house style shared with Stats,\n// Online, Standings: ink panel, serif small-caps headings, monospace rows. The\n// accent is a warm lantern amber.\n//   - header: room name, area and environment, details as tags, exits, number\n//   - description folded to two lines; a click on it unfolds it (a class on the\n//     page body, as Online's offline section, so redraws never undo it)\n//   - PLAYERS (you left off, full title on hover), MOBS (duplicates merged,\n//     dead ones marked), ITEMS (duplicates merged; things you can take stand\n//     out, fixtures are muted)\n// Integrations (0.5: #162 social colours, #163 hunting target, #164 shrines,\n// #165 sigils, #166 plants) will mark rows through the display entry point #159.\nvar R = client.loom.room;\nvar AMBER = \"#e0b46c\";\nvar DEEP = \"#7a5f33\";\nvar TXT = \"#e8e2d6\";\nvar MUTED = \"#8f877a\";\nvar DIM = \"#6d665b\";\nvar RULE = \"#2b2620\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\nfunction esc(s) { return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\"); }\nfunction caps(t, n) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;font-size:11px;color:' + (n ? AMBER : DIM) + ';margin:8px 0 2px;border-top:1px solid ' + RULE + ';padding-top:5px;\">' + t + ' <span style=\"color:' + MUTED + ';\">' + n + '</span></div>'; }\nfunction row(inner, title) { return '<div' + (title ? ' title=\"' + esc(title) + '\"' : '') + ' style=\"border-bottom:1px dotted ' + RULE + ';padding:1px 0;cursor:default;\">' + inner + '</div>'; }\n// Merge items of the same name, keeping order of first appearance.\nfunction merge(list) {\n  var out = [], at = {};\n  for (var i = 0; i < list.length; i++) {\n    var k = list[i].name + \"|\" + (list[i].attrib || \"\");\n    if (at[k] === undefined) { at[k] = out.length; out.push({ it: list[i], n: 1 }); } else out[at[k]].n++;\n  }\n  return out;\n}\nfunction many(m) { return (m.n > 1 ? '<span style=\"color:' + MUTED + ';\">' + m.n + '&times; </span>' : ''); }\n\nvar I = R.info || {};\nvar html = '<div style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:#13110e;border:1px solid ' + RULE + ';padding:7px 8px 8px;\">';\nif (!R.info) {\n  html += '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">Waiting for the room… (move, or LOOK)</div>';\n} else {\n  var name = String(I.name || \"\").replace(/\\s*\\((?:indoors|outdoors)\\)\\s*$/i, \"\");\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\n  html += '<div style=\"font-family:' + SERIF + ';color:' + AMBER + ';font-size:13px;letter-spacing:0.06em;\">' + esc(name) + '</div>';\n  html += '<div style=\"font-family:' + SERIF + ';font-style:italic;color:' + MUTED + ';font-size:11px;white-space:nowrap;\">' + esc(I.area || \"\") + (I.environment ? ' &middot; ' + esc(I.environment) : '') + '</div></div>';\n  // Details as tags, exits, room number.\n  var tags = \"\";\n  var det = I.details || [];\n  for (var di = 0; di < det.length; di++) tags += '<span style=\"display:inline-block;margin:0 4px 0 0;padding:0 4px;border:1px solid ' + DEEP + ';color:' + MUTED + ';\">' + esc(det[di]) + '</span>';\n  var ex = [];\n  for (var ek in (I.exits || {})) { if (I.exits.hasOwnProperty(ek)) ex.push(ek); }\n  html += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-top:3px;\">';\n  html += '<span>' + tags + '</span>';\n  html += '<span style=\"white-space:nowrap;color:' + MUTED + ';\">exits <span style=\"color:' + AMBER + ';\">' + (ex.length ? esc(ex.join(\"  \")) : \"none\") + '</span>' + (I.num ? ' &middot; ' + esc(I.num) : '') + '</span></div>';\n  if (I.desc) {\n    html += '<div onclick=\"document.body.classList.toggle(\\'loom-room-desc-open\\')\" title=\"click to unfold or fold\" class=\"loom-room-desc\" style=\"cursor:pointer;margin-top:4px;font-family:' + SERIF + ';font-size:11px;line-height:1.35;color:' + MUTED + ';\">' + esc(I.desc) + '</div>';\n  }\n\n  // Players, you left off.\n  var pl = [];\n  for (var pk in R.players) { if (R.players.hasOwnProperty(pk) && pk.toLowerCase() !== String(R.me).toLowerCase()) pl.push(pk); }\n  pl.sort();\n  html += caps(\"players\", pl.length);\n  for (var pi = 0; pi < pl.length; pi++) html += row('<span style=\"font-family:' + SERIF + ';font-size:12px;color:' + TXT + ';\">' + esc(pl[pi]) + '</span>', R.players[pl[pi]]);\n\n  // Mobs and items.\n  var mobs = [], items = [];\n  for (var ik in R.items) {\n    if (!R.items.hasOwnProperty(ik)) continue;\n    var it = R.items[ik];\n    if (/m/.test(it.attrib || \"\")) mobs.push(it); else items.push(it);\n  }\n  var mm = merge(mobs);\n  html += caps(\"mobs\", mobs.length);\n  for (var mi = 0; mi < mm.length; mi++) {\n    var dead = /d/.test(mm[mi].it.attrib || \"\");\n    html += row(many(mm[mi]) + '<span style=\"font-family:' + SERIF + ';font-size:12px;color:' + (dead ? DIM : TXT) + ';' + (dead ? 'text-decoration:line-through;' : '') + '\">' + esc(mm[mi].it.name) + '</span>' + (dead ? ' <span style=\"color:' + DIM + ';font-style:italic;\">dead</span>' : ''));\n  }\n  var im = merge(items);\n  html += caps(\"items\", items.length);\n  for (var ii = 0; ii < im.length; ii++) {\n    var take = /t/.test(im[ii].it.attrib || \"\");\n    html += row(many(im[ii]) + '<span style=\"font-family:' + SERIF + ';font-size:11px;color:' + (take ? TXT : MUTED) + ';\">' + esc(im[ii].it.name) + '</span>', take ? \"you can take this\" : \"\");\n  }\n}\nhtml += '</div>';\n// The description's fold: a style once per page, the body class from the setting.\ntry {\n  if (!document.getElementById(\"loom-room-style\")) {\n    var rmSt = document.createElement(\"style\");\n    rmSt.id = \"loom-room-style\";\n    rmSt.textContent = 'body:not(.loom-room-desc-open) .loom-room-desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }';\n    document.head.appendChild(rmSt);\n    document.body.classList.toggle(\"loom-room-desc-open\", R.descOpen === true);\n  }\n} catch (e) {}\ntry { set_custom_tab_html(R.tab, html); } catch (e) {}\n"
  },
  {
   "type": "function",
   "name": "room_help",
   "enabled": true,
   "code": "// room_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[room] the Here tab: the room you are in, its exits, players, mobs and items. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"ROOM\", \"the room in a line, and how the description starts\"],\n  [\"ROOM DESC OPEN|FOLDED\", \"show the description in full, or folded to two lines (clicking it flips it too)\"],\n  [\"ROOM DEBUG\", \"the last room GMCP payloads, as they came\"],\n  [\"The Here tab replaces the stock Room tab: create a custom tab named Here, then close the stock one from the layout if you like.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "room",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// ROOM [subcommand ...]: the one command for this package.\nif (!client.loom || !client.loom.room || !client.loom.room.raw) run_function(\"room_setup\", [], \"room\");\nvar R = client.loom.room;\nvar rmW = String(args[1] || \"\").trim().toLowerCase().split(/\\s+/);\nvar rmSub = rmW[0];\nfunction rmSay(t, c) { display_notice(\"[room] \" + t, c || \"cyan\"); }\nif (rmSub === \"\" || rmSub === \"status\") {\n  var rmI = R.info || {};\n  var rmP = 0, rmMo = 0, rmIt = 0;\n  for (var k in R.players) { if (R.players.hasOwnProperty(k) && k.toLowerCase() !== String(R.me).toLowerCase()) rmP++; }\n  for (var j in R.items) { if (R.items.hasOwnProperty(j)) { if (/m/.test(R.items[j].attrib || \"\")) rmMo++; else rmIt++; } }\n  rmSay(R.info ? (String(rmI.name).replace(/\\s*\\((?:indoors|outdoors)\\)\\s*$/i, \"\") + \" (\" + rmI.num + \"), \" + rmI.area + \": \" + rmP + \" player\" + (rmP === 1 ? \"\" : \"s\") + \", \" + rmMo + \" mob\" + (rmMo === 1 ? \"\" : \"s\") + \", \" + rmIt + \" item\" + (rmIt === 1 ? \"\" : \"s\") + \".\") : \"no room data yet: move or LOOK.\");\n  rmSay(\"the Here tab shows it; the description starts \" + (R.descOpen ? \"open\" : \"folded\") + \". ROOM HELP for commands.\");\n} else if (rmSub === \"help\") {\n  run_function(\"room_help\", [], \"room\");\n} else if (rmSub === \"desc\") {\n  var rmD = rmW[1] || \"\";\n  if (rmD === \"open\" || rmD === \"folded\" || rmD === \"fold\") {\n    R.descOpen = rmD === \"open\";\n    set_variable(\"room_desc\", R.descOpen ? \"open\" : \"folded\");\n    try { document.body.classList.toggle(\"loom-room-desc-open\", R.descOpen); } catch (e) {}\n    rmSay(\"the description starts \" + (R.descOpen ? \"open\" : \"folded\") + \" now.\", \"lime\");\n  } else {\n    rmSay(\"the description starts \" + (R.descOpen ? \"open\" : \"folded\") + \". ROOM DESC OPEN or FOLDED to change it; clicking it flips it too.\");\n  }\n} else if (rmSub === \"debug\") {\n  // The last payload of each GMCP message the tab reads, as JSON.\n  var rmK = Object.keys(R.raw);\n  if (!rmK.length) rmSay(\"no room GMCP seen yet.\");\n  for (var rmX = 0; rmX < rmK.length; rmX++) {\n    var rmS = JSON.stringify(R.raw[rmK[rmX]]);\n    rmSay(rmK[rmX] + \" \" + (rmS.length > 600 ? rmS.slice(0, 600) + \"…\" : rmS), \"orange\");\n  }\n  rmSay(\"me=\" + (R.me || \"?\") + \" players=\" + Object.keys(R.players).length + \" items=\" + Object.keys(R.items).length, \"orange\");\n} else {\n  rmSay(\"unknown command '\" + rmSub + \"'. ROOM HELP for commands.\", \"orange\");\n}\nrun_function(\"room_render\", [], \"room\");\n"
    }
   ],
   "text": "^room(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false
  }
 ],
 "description": "A Here tab replacing the stock Room tab: exits, players, mobs and items"
}