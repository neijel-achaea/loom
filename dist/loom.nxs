  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Pre-quit housekeeping. Closing the huntstats hunt is integration work and\n// moves into the v0.4 integrations; for now it only runs if huntstats is\n// there: v0.2 registers itself, the older one kept its hunt in client.track.\nif (client.loom && client.loom.registry && client.loom.registry.huntstats) run_function(\"huntstats_finalize\", [], \"huntstats\");\nelse if (client.track) run_function(\"hs_finalize\", [], \"huntstats\");\n\n// Pre-quit commands\nsend_command(\"inr all\");\nsend_command(\"pg\");\n\nsend_command(\"quit\", 1);\n"
    }
   ],
   "text": "^(quit|qq)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#23f50a",
     "highlight_bg": "#000000",
     "highlight": "match",
     "highlight_backref": ""
    }
   ],
   "text": "Amberous spores drift through the atmosphere, petrifying into the perennial form of the Earthmother.",
   "matching": "substring",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#ff8f00",
     "highlight_bg": "#000000",
     "highlight": "match",
     "highlight_backref": ""
    }
   ],
   "text": "a magnificent lightning eagle",
   "matching": "substring",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"on\");"
    }
   ],
   "text": "^You close your eyes\\, curl up in a bal\\l, and fall asleep\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"off\");"
    }
   ],
   "text": "^You open your eyes and yawn mightily\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"off\");"
    }
   ],
   "text": "^You open your eyes and stretch languidly\\, feeling deliciously well\\-rested\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"on\");"
    }
   ],
   "text": "^You close your eyes\\, bow your head\\, and empty your mind of all thought\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"off\");"
    }
   ],
   "text": "^You snap your head up as you break your meditation\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"off\");"
    }
   ],
   "text": "^You cease your meditation having achieved full will and mana\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"on\");"
    }
   ],
   "text": "^You begin to wade out into the depths of the Mnemosyne\\, Creation shivering around you as that which was and that which is begin to blur\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"off\");"
    }
   ],
   "text": "^You silently slip beneath the water and the world is as it once was\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"on\");\n"
    }
   ],
   "text": "^You begin to seek a path free of the Mnemosyne\\'s depths\\, the process taking all of your concentration\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"off\");\n"
    }
   ],
   "text": "^The Mnemosyne relinquishes memory\\'s grip upon you\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#00d7ff",
     "highlight_bg": "#000000",
     "highlight": "line",
     "highlight_backref": ""
    }
   ],
   "text": "^With the completion of your adventure\\, you feel your renown grow to new heights\\! \\(You gain (\\d+) Renown\\.\\)$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "var numberCredits = args[1];\n\nif (numberCredits <= 100) {\n  send_command(\"agree\");\n}"
    }
   ],
   "text": "^You are attempting to convert (\\d+) Bound Credits into (\\d+) Lessons\\. If you are sure you would like to do this\\, type in AGREE\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "rewrite",
     "enabled": true,
     "rewrite_text_type": "value",
     "rewrite_text": "[LEVEL UP!]",
     "rewrite": "prefix",
     "rewrite_backref": "",
     "rewrite_colors": false,
     "rewrite_fg": "#ffff00",
     "rewrite_bg": "#000000"
    },
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#8772ea",
     "highlight_bg": "#000000",
     "highlight": "line",
     "highlight_backref": ""
    }
   ],
   "text": "^You gasp with the realisation that (\\w+) has reached the level of (.*)\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  }
 ],
 "description": "The suite: package list, shared pause and debug flags, quit wrapper"
}