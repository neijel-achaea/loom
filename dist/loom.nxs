  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Pre-quit housekeeping. Closing the huntstats session is integration work\n// and moves into the v0.4 integrations; for now it only runs if huntstats is\n// there (client.track is huntstats' session state).\nif (client.track) run_function(\"hs_finalize\", [], \"huntstats\");\n\n// Pre-quit commands\nsend_command(\"inr all\");\nsend_command(\"pg\");\n\nsend_command(\"quit\", 1);\n"
    }
   ],
   "text": "^(quit|qq)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "var elixir = args[1];\n\nswitch (elixir){\n  case \"health\":\n    send_command(\"fill vial133566 with health from rift\");\n    break;\n\n  case \"mana\":\n    send_command(\"fill vial125267 with mana from rift\");\n    break;\n\n  case \"mending\":\n    send_command(\"fill vial134886 with mending from rift\");\n    break;\n\n  case \"venom\":\n    send_command(\"fill vial135919 with venom from rift\");\n    break;\n\n  case \"caloric\":\n    send_command(\"fill vial138895 with caloric from rift\");\n    break;\n\n  case \"frost\":\n    send_command(\"fill vial314996 with frost from rift\");\n    break;\n\n  case \"immunity\":\n    send_command(\"fill vial321329 with immunity from rift\");\n    break;\n\n  case \"levitation\":\n    send_command(\"fill vial21165 with levitation from rift\");\n    break;\n\n  case \"mass\":\n    send_command(\"fill vial433721 with mass from rift\");\n    break;\n\n  case \"speed\":\n    send_command(\"fill vial177369 with speed from rift\");\n    break;\n\n  case \"restoration\":\n    send_command(\"fill vial32277 with restoration from rift\");\n    break;\n\n  case \"epidermal\":\n    send_command(\"fill vial81690 with epidermal from rift\");\n    break;\n\n  case \"all\":\n    send_command(\"fill vial133566 with health from rift\");\n    send_command(\"fill vial125267 with mana from rift\");\n    send_command(\"fill vial134886 with mending from rift\");\n    send_command(\"fill vial135919 with venom from rift\");\n    send_command(\"fill vial138895 with caloric from rift\");\n    send_command(\"fill vial314996 with frost from rift\");\n    send_command(\"fill vial321329 with immunity from rift\");\n    send_command(\"fill vial21165 with levitation from rift\");\n    send_command(\"fill vial433721 with mass from rift\");\n    send_command(\"fill vial177369 with speed from rift\");\n    send_command(\"fill vial32277 with restoration from rift\");\n    send_command(\"fill vial81690 with epidermal from rift\");\n    break;\n}"
    }
   ],
   "text": "^refillvial (\\w+)$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#bcff00",
     "highlight_bg": "#000000",
     "highlight": "match",
     "highlight_backref": ""
    }
   ],
   "text": "Vines have overtaken this location.",
   "matching": "substring",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#23f50a",
     "highlight_bg": "#000000",
     "highlight": "match",
     "highlight_backref": ""
    }
   ],
   "text": "Amberous spores drift through the atmosphere, petrifying into the perennial form of the Earthmother.",
   "matching": "substring",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
     "highlight_fg": "#ff8f00",
     "highlight_bg": "#000000",
     "highlight": "match",
     "highlight_backref": ""
    }
   ],
   "text": "a magnificent lightning eagle",
   "matching": "substring",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "gag",
     "enabled": true
    }
   ],
   "text": "(Eleusian Techs):",
   "matching": "substring",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"on\");"
    }
   ],
   "text": "^You close your eyes\\, curl up in a bal\\l, and fall asleep\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"off\");"
    }
   ],
   "text": "^You open your eyes and yawn mightily\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"off\");"
    }
   ],
   "text": "^You open your eyes and stretch languidly\\, feeling deliciously well\\-rested\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"on\");"
    }
   ],
   "text": "^You close your eyes\\, bow your head\\, and empty your mind of all thought\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"off\");"
    }
   ],
   "text": "^You snap your head up as you break your meditation\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"off\");"
    }
   ],
   "text": "^You cease your meditation having achieved full will and mana\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"on\");"
    }
   ],
   "text": "^You begin to wade out into the depths of the Mnemosyne\\, Creation shivering around you as that which was and that which is begin to blur\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"off\");"
    }
   ],
   "text": "^You silently slip beneath the water and the world is as it once was\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"on\");\n"
    }
   ],
   "text": "^You begin to seek a path free of the Mnemosyne\\'s depths\\, the process taking all of your concentration\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "set_variable(\"pauseTriggers\", \"off\");\n"
    }
   ],
   "text": "^The Mnemosyne relinquishes memory\\'s grip upon you\\.$",
   "matching": "regexp",
   "whole_words": true,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
