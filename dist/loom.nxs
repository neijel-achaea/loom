{
 "type": "group",
 "name": "loom",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "// loom: the suite package. Holds the LOOM command, the shared settings and,\n// from v0.4, the integrations between packages. No package requires it.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.loom) client.loom.loom = {};\nclient.loom.registry.loom = { version: \"0.2.1\", keyword: \"LOOM\" };\n\nset_variable(\"pauseTriggers\", \"off\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Place any code here you'd like to autorun when the package is uninstalled"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// loom: the suite package. Holds the LOOM command, the shared settings and,\n// from v0.4, the integrations between packages. No package requires it.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.loom) client.loom.loom = {};\nclient.loom.registry.loom = { version: \"0.2.1\", keyword: \"LOOM\" };\n\nset_variable(\"pauseTriggers\", \"off\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "if (!client.loom) client.loom = {};\nif (!client.loom.loom) client.loom.loom = {};\nvar L = client.loom.loom;\n\nif (args.gmcp_method == \"Room.Info\") {\n  var g = args.gmcp_args;\n  L.room = { id: g.num, name: g.name, area: g.area, environment: g.environment };\n\n  // LEGACY shared variables. Packages that have not had their v0.2 pass still\n  // read these. Removed once none does (issue #2).\n  set_variable(\"currentRoomId\", g.num);\n  set_variable(\"currentRoomName\", g.name);\n  set_variable(\"currentArea\", g.area);\n  set_variable(\"currentEnvironment\", g.environment);\n}\n\nif (args.gmcp_method == \"Char.Status\" && args.gmcp_args.class) {\n  var cls = args.gmcp_args.class;\n  if (cls != get_variable(\"activeClass\")) {\n    // LEGACY shared variable, same as above.\n    set_variable(\"activeClass\", cls);\n    L.cls = cls;\n    display_notice(\"[loom] class: \" + cls, \"green\");\n\n    // LEGACY: tells roleplay to reload its emotes, only when roleplay's\n    // engine exists (otherwise AEM RELOAD would reach the game). Goes away\n    // when roleplay follows the class itself.\n    if (window.AEM) send_command(\"aem reload\");\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "loom_help",
   "enabled": true,
   "code": "// loom_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[loom] the suite package. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"LOOM\", \"packages loaded, with version and command\"],\n  [\"LOOM PAUSE ON|OFF\", \"stop packages sending commands (interruptible actions)\"],\n  [\"LOOM DEBUG ON|OFF\", \"debug notices\"],\n  [\"LOOM ROOM\", \"current room id, name, area and environment\"],\n  [\"Packages appear in the list once they have had their v0.2 update.\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// LOOM [LIST|HELP|PAUSE on/off|DEBUG on/off|ROOM]\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.loom) client.loom.loom = {};\n\nvar raw = String(args[1] || \"\").trim();\nvar parts = raw.split(/\\s+/);\nvar sub = String(parts[0] || \"\").toLowerCase();\nvar val = String(parts[1] || \"\").toLowerCase();\nvar C = \"cyan\";\n\nif (sub === \"\" || sub === \"list\") {\n  var reg = client.loom.registry;\n  var names = Object.keys(reg).sort();\n  display_notice(\"[loom] \" + names.length + \" package\" + (names.length == 1 ? \"\" : \"s\") + \" loaded\", C);\n  for (var i = 0; i < names.length; i++) {\n    var r = reg[names[i]] || {};\n    var label = (names[i] + \"                \").slice(0, 16);\n    display_notice(\"  \" + label + \"v\" + (r.version || \"?\") + \"   \" + (r.keyword || \"\"), C);\n  }\n  display_notice(\"[loom] pause \" + (get_variable(\"pauseTriggers\") || \"off\") + \", debug \" + (get_variable(\"debug\") || \"off\") + \". LOOM HELP for commands.\", C);\n} else if (sub === \"help\") {\n  run_function(\"loom_help\", [], \"loom\");\n} else if (sub === \"pause\" || sub === \"debug\") {\n  var vname = (sub === \"pause\") ? \"pauseTriggers\" : \"debug\";\n  if (val === \"on\" || val === \"off\") {\n    set_variable(vname, val);\n    display_notice(\"[loom] \" + sub + \" \" + val, C);\n  } else {\n    display_notice(\"[loom] \" + sub + \" is \" + (get_variable(vname) || \"off\") + \". Use LOOM \" + sub.toUpperCase() + \" ON or OFF.\", C);\n  }\n} else if (sub === \"room\") {\n  var rm = client.loom.loom.room;\n  if (rm) {\n    display_notice(\"[loom] room \" + rm.id + \": \" + rm.name + \" (\" + rm.area + \", \" + rm.environment + \")\", C);\n  } else {\n    display_notice(\"[loom] no room seen yet; move once and try again.\", C);\n  }\n} else {\n  display_notice(\"[loom] unknown command '\" + sub + \"'. LOOM HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^loom(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
