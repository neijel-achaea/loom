  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// Pre-quit housekeeping. Closing the huntstats hunt is integration work and\n// moves into the v0.4 integrations; for now it only runs if huntstats is\n// there: v0.2 registers itself, the older one kept its hunt in client.track.\nif (client.loom && client.loom.registry && client.loom.registry.huntstats) run_function(\"huntstats_finalize\", [], \"huntstats\");\nelse if (client.track) run_function(\"hs_finalize\", [], \"huntstats\");\n\n// Pre-quit commands\nsend_command(\"inr all\");\nsend_command(\"pg\");\n\nsend_command(\"quit\", 1);\n"
    }
   ],
   "text": "^(quit|qq)$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
  {
   "type": "trigger",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "highlight",
     "enabled": true,
