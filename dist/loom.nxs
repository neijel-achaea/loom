{
 "type": "group",
 "name": "loom",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "// loom: the suite package. Holds the LOOM command, the shared settings and,\n// from v0.5, the integrations between packages. No package requires it.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.loom) client.loom.loom = {};\nclient.loom.registry.loom = { version: \"1.0.3\", keyword: \"LOOM\", desc: \"The suite: package list, shared pause and debug flags, quit wrapper\" };\n\n// The legacy room variables loom used to set have no readers left: delete\n// them once. activeClass is left for hunting and defcon to seed\n// their own class from, and no longer updated.\nvar lmOld = [\"currentRoomId\", \"currentRoomName\", \"currentArea\", \"currentEnvironment\"];\nfor (var lmI = 0; lmI < lmOld.length; lmI++) {\n  var lmV;\n  try { lmV = get_variable(lmOld[lmI]); } catch (e) { lmV = undefined; }\n  if (lmV !== undefined && lmV !== null) delete_variable(lmOld[lmI]);\n}\n\nset_variable(\"pauseTriggers\", \"off\");\n\n// Which packages are really installed (LOOM, LOOM UPDATES).\nrun_function(\"loom_packages\", [], \"loom\");\n// The integrations catalogue and the LOOM LINK switches.\nrun_function(\"loom_links\", [], \"loom\");\n// City themes for the tabs (#310): after the links, so redraws can run.\nrun_function(\"loom_theme\", [], \"loom\");\n// LOOM PERF (#209): ends any sample an earlier copy left running.\nrun_function(\"loom_perf\", [], \"loom\");\n// Integrations that write (ledger reminders, …) look at their source once.\nclient.loom.loom.updateAll();\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"loom_gmcp\", [], \"loom\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Uninstalling loom ends a LOOM PERF sample, so nothing stays wrapped.\nif (client.__loomPerfRestore) { try { client.__loomPerfRestore(); } catch (e) {} client.__loomPerfRestore = null; }\nif (client.loom && client.loom.loom) client.loom.loom.perfState = null;\n// Leave at once, not at the next load (#137): with loom's entry gone every\n// link waits, so the tabs are redrawn without integrations or a theme.\nif (client.loom && client.loom.registry) {\n  delete client.loom.registry.loom;\n  client.loom.theme = null;\n  var lmL = client.loom.loom;\n  var lmReg = client.loom.registry;\n  for (var lmP in lmReg) {\n    if (lmReg[lmP] && typeof lmReg[lmP].redraw == \"function\") {\n      if (lmL && typeof lmL.redraw == \"function\") lmL.redraw(lmP);\n      else { try { lmReg[lmP].redraw(); } catch (e) {} }\n    }\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// loom: the suite package. Holds the LOOM command, the shared settings and,\n// from v0.5, the integrations between packages. No package requires it.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.loom) client.loom.loom = {};\nclient.loom.registry.loom = { version: \"1.0.3\", keyword: \"LOOM\", desc: \"The suite: package list, shared pause and debug flags, quit wrapper\" };\n\n// The legacy room variables loom used to set have no readers left: delete\n// them once. activeClass is left for hunting and defcon to seed\n// their own class from, and no longer updated.\nvar lmOld = [\"currentRoomId\", \"currentRoomName\", \"currentArea\", \"currentEnvironment\"];\nfor (var lmI = 0; lmI < lmOld.length; lmI++) {\n  var lmV;\n  try { lmV = get_variable(lmOld[lmI]); } catch (e) { lmV = undefined; }\n  if (lmV !== undefined && lmV !== null) delete_variable(lmOld[lmI]);\n}\n\nset_variable(\"pauseTriggers\", \"off\");\n\n// Which packages are really installed (LOOM, LOOM UPDATES).\nrun_function(\"loom_packages\", [], \"loom\");\n// The integrations catalogue and the LOOM LINK switches.\nrun_function(\"loom_links\", [], \"loom\");\n// City themes for the tabs (#310): after the links, so redraws can run.\nrun_function(\"loom_theme\", [], \"loom\");\n// LOOM PERF (#209): ends any sample an earlier copy left running.\nrun_function(\"loom_perf\", [], \"loom\");\n// Integrations that write (ledger reminders, …) look at their source once.\nclient.loom.loom.updateAll();\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"loom_gmcp\", [], \"loom\");\n"
  },
  {
   "type": "function",
   "name": "loom_gmcp",
   "enabled": true,
   "code": "// loom_gmcp -- the work behind onGMCP, as a function made once per load\n// (client.loom.hooks.loom.gmcp). Nexus compiles a script afresh every time it\n// runs, and long ones cost on every GMCP message, so the script itself stays two\n// lines and calls this (#136). Run from onLoad and onInstall, so a reimport\n// replaces it.\nif (!client.loom) client.loom = {};\nif (!client.loom.hooks) client.loom.hooks = {};\nif (!client.loom.hooks.loom) client.loom.hooks.loom = {};\nclient.loom.hooks.loom.gmcp = function (args) {\n  if (!client.loom) client.loom = {};\n  if (!client.loom.loom) client.loom.loom = {};\n  var L = client.loom.loom;\n  // A payload that came empty or as something other than an object reads as\n  // an empty one (#135).\n  var lmG = (args.gmcp_args && typeof args.gmcp_args == \"object\") ? args.gmcp_args : {};\n\n  if (args.gmcp_method == \"Room.Info\") {\n    var g = lmG;\n    L.room = { id: g.num, name: g.name, area: g.area, environment: g.environment };\n  }\n\n  // Once a session, at the first class message (every package has loaded by\n  // then): say if anything here is out of date. Silent otherwise.\n  if (args.gmcp_method == \"Char.Status\" && !L.updatesChecked) {\n    L.updatesChecked = true;\n    if ((get_variable(\"loom_autoupdates\") || \"on\") == \"on\") {\n      set_variable(\"loom_updates_mode\", \"auto\");\n      run_function(\"loom_updates\", [], \"loom\");\n    }\n  }\n\n  if (args.gmcp_method == \"Char.Status\" && lmG.class) {\n    var cls = lmG.class;\n    if (cls != L.cls) {\n      L.cls = cls;\n      display_notice(\"[loom] class: \" + cls, \"cyan\");\n    }\n  }\n\n  // The city, for tab themes (#310). Char.Status carries it at login.\n  if (args.gmcp_method == \"Char.Status\" && lmG.city !== undefined) {\n    if (!L.themeSeeCity) run_function(\"loom_theme\", [], \"loom\");\n    L.themeSeeCity(lmG.city);\n  }\n};\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// onGMCP: the work is in loom_gmcp (#136: this runs on every GMCP message, so it stays short).\nvar lkH = client.loom && client.loom.hooks && client.loom.hooks.loom;\nif (!lkH || !lkH.gmcp) { run_function(\"loom_gmcp\", [], \"loom\"); lkH = client.loom.hooks.loom; }\nlkH.gmcp(args);\n"
  },
  {
   "type": "function",
   "name": "loom_help",
   "enabled": true,
   "code": "// loom_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[loom] the suite package. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"LOOM\", \"packages loaded, with version and command\"],\n  [\"LOOM UPDATES\", \"packages here that are older than on GitHub\"],\n  [\"LOOM UPDATES AUTO ON|OFF\", \"the same check once at login, silent when all is current\"],\n  [\"LOOM PAUSE ON|OFF\", \"stop packages sending commands (interruptible actions)\"],\n  [\"LOOM DEBUG ON|OFF\", \"debug notices\"],\n  [\"LOOM ROOM\", \"current room id, name, area and environment\"],\n  [\"LOOM LINKS\", \"integrations between packages, on, off or waiting for a package\"],\n  [\"LOOM LINK <id> ON|OFF\", \"switch one integration\"],\n  [\"LOOM THEME\", \"the tabs' colour theme and the cities to choose from\"],\n  [\"LOOM THEME <city>|AUTO|OFF\", \"one city's colours, your own city's (default) or each tab's own\"],\n  [\"LOOM PERF [seconds]\", \"measure what each package costs while you play (default 60 s), then report\"],\n  [\"LOOM PERF STOP\", \"end the sample now and report\"],\n  [\"LOOM PERF DATA\", \"how much saved data each package keeps\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "function",
   "name": "loom_links",
   "enabled": true,
   "code": "// loom_links -- the integrations catalogue and its on/off switches (#37),\n// and the display entry point (#159): tabs ask loom questions, links answer\n// them from their source's read-only `look`, sources announce changes.\n// Run from onLoad and onInstall. Every integration lives in this package\n// and registers here with L.addLink; it is on as soon as both of its\n// packages are installed, unless the player switched it off. Only the\n// switched-off ids are stored (loom_links_off, a JSON list), so an\n// integration added in a later version starts on.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.loom) client.loom.loom = {};\nvar L = client.loom.loom;\n\n// The catalogue: id -> { id, src, dst, desc, issue, change, answers }, plus the ids\n// in the order they were added (the order LOOM LINKS lists them in).\n// Rebuilt on every load, so a removed integration leaves nothing behind.\nL.links = {};\nL.linkOrder = [];\n\n// Register an integration. e = { id, src, dst, desc, issue, change, answers, update }:\n// src and dst are package names as in client.loom.registry; change, if\n// given, is called with true/false when the player switches the link on or\n// off, so the integration can withdraw what it created (the destination is\n// redrawn either way). answers, for display integrations, maps a question\n// name to a function answering it from the source's `look`, e.g.\n//   answers: { \"person.colour\": function (name) { return client.loom.social.look.colour(name); } }\n// update, for integrations that write to their destination (a ledger item,\n// a coffers proposal): run when the source notifies, when the link is\n// switched on, and once at load; debounced, so a burst of changes (a whole\n// IR listing) runs it once. It reads the source's look and calls the\n// destination's entry; switching off withdraws on its own (setLink).\nL.addLink = function (e) {\n  if (!e || !e.id) return;\n  var id = String(e.id).toLowerCase();\n  if (!L.links[id]) L.linkOrder.push(id);\n  L.links[id] = { id: id, src: e.src, dst: e.dst, desc: e.desc || \"\", issue: e.issue || 0, change: e.change, answers: e.answers || {}, update: e.update };\n};\nL.updateT = L.updateT || {};\nL.runUpdate = function (id) {\n  var e = L.links[id];\n  if (!e || typeof e.update !== \"function\") return;\n  if (L.updateT[id]) clearTimeout(L.updateT[id]);\n  L.updateT[id] = setTimeout(function () {\n    L.updateT[id] = null;\n    if (!L.linkOn(id)) return;\n    try { L.links[id].update(); } catch (err) { display_notice(\"[loom] link \" + id + \" failed to update: \" + err, \"orange\"); }\n  }, 200);\n};\nL.updateAll = function () { for (var i = 0; i < L.linkOrder.length; i++) L.runUpdate(L.linkOrder[i]); };\n\n// Links whose id changed (old id -> new), so a link switched off under its\n// old name stays off: crystalism's became magi's when magi 0.1.0 replaced\n// crystalism and artificing.\nL.renamedLinks = { \"crystalism-ledger\": \"magi-ledger\", \"crystalism-room\": \"magi-room\" };\n\n// The switched-off ids, as a set. Read once per load and kept in step by\n// L.setLink, so the hot path (L.linkOn) never parses the variable.\nL.linksOff = {};\n(function () {\n  var raw;\n  try { raw = JSON.parse(get_variable(\"loom_links_off\") || \"[]\"); } catch (e) { raw = []; }\n  if (!Array.isArray(raw)) raw = [];\n  var moved = false;\n  for (var i = 0; i < raw.length; i++) {\n    var id = String(raw[i]).toLowerCase();\n    if (L.renamedLinks[id]) { id = L.renamedLinks[id]; moved = true; }\n    L.linksOff[id] = true;\n  }\n  if (moved) set_variable(\"loom_links_off\", JSON.stringify(Object.keys(L.linksOff).sort()));\n})();\n\n// The packages a link still needs, as a list of names (empty when both\n// are installed). A package counts as installed when it is in the registry.\nL.linkMissing = function (id) {\n  var e = L.links[String(id || \"\").toLowerCase()];\n  var out = [];\n  if (!e) return out;\n  var reg = client.loom.registry || {};\n  // Loom itself uninstalled (#137): every link waits, so no tab keeps\n  // asking a package that is gone.\n  if (!reg.loom) out.push(\"loom\");\n  if (e.src && !reg[e.src]) out.push(e.src);\n  if (e.dst && e.dst !== e.src && !reg[e.dst]) out.push(e.dst);\n  return out;\n};\n\n// \"on\", \"off\" (switched off by the player), \"waiting\" (a package missing)\n// or \"\" for an unknown id. Switched off wins over waiting.\nL.linkState = function (id) {\n  id = String(id || \"\").toLowerCase();\n  if (!L.links[id]) return \"\";\n  if (L.linksOff[id]) return \"off\";\n  if (L.linkMissing(id).length) return \"waiting\";\n  return \"on\";\n};\n\n// The one question integrations ask before doing anything.\nL.linkOn = function (id) { return L.linkState(id) === \"on\"; };\n\n// Switch a link on or off. Stores only the switched-off ids, and tells the\n// integration when its effective state changed. Returns false for an\n// unknown id.\nL.setLink = function (id, on) {\n  id = String(id || \"\").toLowerCase();\n  if (!L.links[id]) return false;\n  var was = L.linkOn(id);\n  if (on) delete L.linksOff[id]; else L.linksOff[id] = true;\n  var off = Object.keys(L.linksOff).sort();\n  if (off.length) set_variable(\"loom_links_off\", JSON.stringify(off));\n  else delete_variable(\"loom_links_off\");\n  var now = L.linkOn(id);\n  var ch = L.links[id].change;\n  if (was !== now && typeof ch === \"function\") {\n    try { ch(now); } catch (e) { display_notice(\"[loom] link \" + id + \" failed to switch: \" + e, \"orange\"); }\n  }\n  // Switched off: whatever the link created in its destination goes, for\n  // every destination with a write-side entry point (standings #36, ledger\n  // #34, coffers #35), so no integration can forget to clean up.\n  if (was && !now) {\n    var dn = client.loom[L.links[id].dst];\n    if (dn && dn.entry && typeof dn.entry.withdraw === \"function\") {\n      try { dn.entry.withdraw(L.links[id].src); } catch (e) { display_notice(\"[loom] link \" + id + \" could not take back its items: \" + e, \"orange\"); }\n    }\n  }\n  if (!was && now) L.runUpdate(id);\n  if (was !== now) L.redraw(L.links[id].dst);\n  return true;\n};\n\n// ---- The display entry point (#159) ----------------------------------\n// Questions are named by what the tab needs, dotted (person.colour,\n// item.flags, room.plants, target), never by who answers, so a later source\n// can answer the same question without the tab changing. A tab asks as its\n// own package (dst), so only links into that package answer: switching off\n// social-room takes the colours out of Here but not out of Comms. Answers\n// come only from links that are on; a link that throws or answers\n// undefined/null/\"\" is skipped. With no answer the tab renders plainly.\n\n// Every answer, in link order, as [{ link, value }]. For questions where\n// several sources may speak at once (flags on an item row).\nL.answers = function (dst, q, arg) {\n  var out = [];\n  for (var i = 0; i < L.linkOrder.length; i++) {\n    var e = L.links[L.linkOrder[i]];\n    var f = e && e.answers && e.answers[q];\n    if (typeof f !== \"function\" || e.dst !== dst || !L.linkOn(e.id)) continue;\n    var v;\n    try { v = f(arg); } catch (err) { v = undefined; }\n    if (v !== undefined && v !== null && v !== \"\") out.push({ link: e.id, value: v });\n  }\n  return out;\n};\n\n// The first answer, or undefined. For questions with one answer (a colour).\nL.answer = function (dst, q, arg) {\n  var a = L.answers(dst, q, arg);\n  return a.length ? a[0].value : undefined;\n};\n\n// Redraw a destination package's display, debounced per package (a burst of\n// changes is one draw). Destinations say how in their registry entry:\n// client.loom.registry.<pkg>.redraw.\nL.redrawT = L.redrawT || {};\nL.redraw = function (dst) {\n  if (!dst) return;\n  // A destination whose redraw already gathers a burst into one draw says so\n  // (registry `soon: true`, room): asked at once, it joins the draw already\n  // pending instead of adding one 50 ms later (#136).\n  var rs = (client.loom.registry || {})[dst];\n  if (rs && rs.soon && typeof rs.redraw === \"function\") {\n    try { rs.redraw(); } catch (e) { display_notice(\"[loom] redraw of \" + dst + \" failed: \" + e, \"orange\"); }\n    return;\n  }\n  if (L.redrawT[dst]) clearTimeout(L.redrawT[dst]);\n  L.redrawT[dst] = setTimeout(function () {\n    L.redrawT[dst] = null;\n    var r = (client.loom.registry || {})[dst];\n    if (r && typeof r.redraw === \"function\") {\n      try { r.redraw(); } catch (e) { display_notice(\"[loom] redraw of \" + dst + \" failed: \" + e, \"orange\"); }\n    }\n  }, 50);\n};\n\n// Sources call this when state their `look` reports has changed, guarded so\n// they work without loom:  if (client.loom.notify) client.loom.notify(\"social\");\n// Every destination of a link from that source that is on is redrawn.\nclient.loom.notify = function (src) {\n  var seen = {};\n  for (var i = 0; i < L.linkOrder.length; i++) {\n    var e = L.links[L.linkOrder[i]];\n    if (e.src !== src || !L.linkOn(e.id)) continue;\n    if (typeof e.update === \"function\") L.runUpdate(e.id);\n    if (!seen[e.dst]) { seen[e.dst] = true; L.redraw(e.dst); }\n  }\n};\n\n// A package being uninstalled calls this from its onUninstall (#137): its\n// registry entry goes at once, so LOOM stops listing it and every link from\n// it turns to waiting, and the tabs that showed its answers are redrawn\n// without them. Nothing is withdrawn: a reinstall finds its items as they\n// were, as after a reload.\nclient.loom.gone = function (pkg) {\n  var reg = client.loom.registry || {};\n  delete reg[pkg];\n  var seen = {};\n  for (var i = 0; i < L.linkOrder.length; i++) {\n    var e = L.links[L.linkOrder[i]];\n    if (e.src !== pkg || e.dst === pkg || !reg[e.dst] || seen[e.dst]) continue;\n    seen[e.dst] = true;\n    L.redraw(e.dst);\n  }\n};\n\n// Integrations register below, one L.addLink each, as they land in 0.5.\n\n// #162 social -> room: players in the Here tab in their highlight colours.\nL.addLink({\n  id: \"social-room\", src: \"social\", dst: \"room\", issue: 162,\n  desc: \"Players in the Here tab in their highlight colours\",\n  answers: {\n    \"person.colour\": function (n) { var s = client.loom.social; return s && s.look ? s.look.colour(n) : undefined; },\n    \"person.group\": function (n) { var s = client.loom.social; return s && s.look ? s.look.group(n) : undefined; }\n  }\n});\n\n// #160 social -> comms: talkers and Tells in their highlight colours.\nL.addLink({\n  id: \"social-comms\", src: \"social\", dst: \"comms\", issue: 160,\n  desc: \"Names in the Comms tab in their highlight colours\",\n  answers: {\n    \"person.colour\": function (n) { var s = client.loom.social; return s && s.look ? s.look.colour(n) : undefined; },\n    \"person.group\": function (n) { var s = client.loom.social; return s && s.look ? s.look.group(n) : undefined; }\n  }\n});\n\n// #196 standings -> social: your standing with each watched person in the\n// Online tab.\nL.addLink({\n  id: \"standings-online\", src: \"standings\", dst: \"social\", issue: 196,\n  desc: \"Your standing with each person in the Online tab\",\n  answers: {\n    \"person.standing\": function (n) { var s = client.loom.standings; return s && s.look ? s.look.standing(n) : undefined; }\n  }\n});\n\n// #161 standings -> comms: your standing with a talker, on hover.\nL.addLink({\n  id: \"standings-comms\", src: \"standings\", dst: \"comms\", issue: 161,\n  desc: \"Your standing with a talker, on hover in the Comms tab\",\n  answers: {\n    \"person.standing\": function (n) { var s = client.loom.standings; return s && s.look ? s.look.standing(n) : undefined; }\n  }\n});\n\n// #50 standings -> social: your standing with someone, as its icon, in the\n// \"has awoken\" notice (\"Ana \\u2665 has awoken\"). Its own question, so it\n// switches off apart from the Online column (standings-online).\nL.addLink({\n  id: \"standings-login\", src: \"standings\", dst: \"social\", issue: 50,\n  desc: \"Your standing's icon in the 'has awoken' notice\",\n  answers: {\n    \"notice.standing\": function (n) { var s = client.loom.standings; return s && s.look ? s.look.standing(n) : undefined; }\n  }\n});\n\n// #164 patrolling -> room: shrines and totems of friendly and hostile gods\n// flagged in the Here tab's items. item.flags answers { label, tone, icon,\n// title }: the tab owns the colours (\"bad\" = alert, \"good\" = reassuring),\n// the icon says what the thing is (Ricardo: an icon left of the name, other\n// icons for other things later). Neutral gods' shrines get the icon in the\n// plain colour, so a shrine still stands out (#277). Sigils\n// (#165) will answer the same question.\nL.addLink({\n  id: \"patrolling-room\", src: \"patrolling\", dst: \"room\", issue: 164,\n  desc: \"Shrines and totems in Here coloured by their god's stance\",\n  answers: {\n    \"item.flags\": function (name) {\n      var p = client.loom.patrolling;\n      var it = p && p.look ? p.look.item(name) : undefined;\n      if (!it) return undefined;\n      return { label: it.stance + \" \" + it.kind, tone: it.stance === \"hostile\" ? \"bad\" : (it.stance === \"friendly\" ? \"good\" : \"info\"), icon: it.kind === \"totem\" ? \"\\u2625\" : \"\\u26ea\", title: (it.god ? it.god.charAt(0).toUpperCase() + it.god.slice(1) + \": \" : \"\") + it.stance + \" \" + it.kind };\n    }\n  }\n});\n\n// #46 harvesting -> ledger: one standing \"Harvest run\" reminder (Ricardo:\n// one per plant would be spam). It appears when any plant falls below 90%\n// of its minimum, lists every plant under its minimum while it stands, and\n// goes away only when all are back at their minimum: the gap between the\n// two keeps a plant hovering near one line from making reminders \"like\n// sausages\".\nL.harvestTrigger = 0.9;\nL.addLink({\n  id: \"harvesting-ledger\", src: \"harvesting\", dst: \"ledger\", issue: 46,\n  desc: \"A harvest run reminder in the ledger when plant stock runs low\",\n  update: function () {\n    var h = client.loom.harvesting, lg = client.loom.ledger;\n    if (!h || !h.look || !lg || !lg.entry) return;\n    var lv = h.look.levels(), under = [], urgent = false;\n    for (var i = 0; i < lv.length; i++) {\n      if (lv[i].stock < lv[i].min) under.push(lv[i]);\n      if (lv[i].stock < lv[i].min * L.harvestTrigger) urgent = true;\n    }\n    if (!under.length) { lg.entry.withdraw(\"harvesting\", \"run\"); return; }\n    if (!urgent && !lg.entry.get(\"harvesting\", \"run\")) return;\n    under.sort(function (a, b) { return a.stock / a.min - b.stock / b.min; });\n    var fmt = function (n) { return String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"); };\n    var bits = [];\n    for (var j = 0; j < under.length; j++) bits.push(under[j].plant + \" \" + fmt(under[j].stock) + \"/\" + fmt(under[j].min));\n    lg.entry.upsert({ source: \"harvesting\", key: \"run\", text: \"Harvest run: \" + bits.join(\", \") });\n  }\n});\n\n// #54 talpieces -> ledger: a reminder per colour whose set is complete (all\n// seven commons and its rare), and one standing reminder of spare pieces to\n// trade away (Ricardo), with a buffer so a single extra piece doesn't make\n// one: it appears at L.talSpareOn spare pieces in all and goes below\n// L.talSpareOff. Spares are counted in level-1 pieces, as the goal counts.\nL.talSpareOn = 16;\nL.talSpareOff = 8;\nL.addLink({\n  id: \"talpieces-ledger\", src: \"talpieces\", dst: \"ledger\", issue: 54,\n  desc: \"Ledger reminders for complete talisman sets and spare pieces\",\n  update: function () {\n    var t = client.loom.talpieces, lg = client.loom.ledger;\n    if (!t || !t.look || !lg || !lg.entry) return;\n    var cs = t.look.colours(), spare = [], total = 0;\n    for (var i = 0; i < cs.length; i++) {\n      var done = true;\n      for (var j = 0; j < cs[i].types.length; j++) {\n        var x = cs[i].types[j];\n        if (x.have < x.need) done = false;\n        if (x.have > x.need) { spare.push({ name: cs[i].colour + \" \" + x.type, n: x.have - x.need }); total += x.have - x.need; }\n      }\n      var cap = cs[i].colour.charAt(0).toUpperCase() + cs[i].colour.slice(1);\n      if (done) lg.entry.upsert({ source: \"talpieces\", key: \"set:\" + cs[i].colour, text: cap + \" talisman set complete: turn it in\" });\n      else lg.entry.withdraw(\"talpieces\", \"set:\" + cs[i].colour);\n    }\n    var standing = !!lg.entry.get(\"talpieces\", \"spares\");\n    // Below the lower line it goes (and a dismissal of it ends); between the\n    // lines a standing reminder stays, and none is made.\n    if (total < L.talSpareOff) { lg.entry.withdraw(\"talpieces\", \"spares\"); return; }\n    if (!standing && total < L.talSpareOn) return;\n    spare.sort(function (a, b) { return b.n - a.n; });\n    var bits = [];\n    for (var k = 0; k < spare.length; k++) bits.push(spare[k].name + \" +\" + spare[k].n);\n    lg.entry.upsert({ source: \"talpieces\", key: \"spares\", text: \"Spare talisman pieces to trade (\" + total + \"): \" + bits.join(\", \") });\n  }\n});\n\n// #44 magi -> ledger (crystalism's until magi 0.1.0): one \"collect pearls\"\n// reminder, as harvesting's\n// (Ricardo): it appears when any shape falls below 90% of its minimum, goes\n// when all are back at it, and says how many pearls to fetch: the crystals\n// short in all (each low shape up to its minimum), 9 facets to a pearl\n// folded into the master crystal, one crystal refined from each facet.\n// Nothing happens until the rift has been read (MAGI REFINE).\nL.addLink({\n  id: \"magi-ledger\", src: \"magi\", dst: \"ledger\", issue: 44,\n  desc: \"A collect pearls reminder in the ledger when crystals run low\",\n  update: function () {\n    var c = client.loom.magi, lg = client.loom.ledger;\n    if (!c || !c.look || !lg || !lg.entry) return;\n    // The reminder used to come from crystalism: withdraw that one once, so\n    // magi's takes its place instead of sitting next to it.\n    if (!L.crystalismGone) { L.crystalismGone = true; lg.entry.withdraw(\"crystalism\"); }\n    var lv = c.look.levels();\n    if (!lv.length) return;\n    var under = [], urgent = false, short = 0;\n    for (var i = 0; i < lv.length; i++) {\n      if (lv[i].have < lv[i].min) { under.push(lv[i]); short += lv[i].min - lv[i].have; }\n      if (lv[i].have < lv[i].min * L.harvestTrigger) urgent = true;\n    }\n    if (!under.length) { lg.entry.withdraw(\"magi\", \"pearls\"); return; }\n    if (!urgent && !lg.entry.get(\"magi\", \"pearls\")) return;\n    // Just the pearls (Ricardo: REFINE fills the shapes evenly, so they top\n    // up together; the shapes' detail is in MAGI MIN).\n    var pearls = Math.ceil(short / (c.facetsPerPearl || 9));\n    lg.entry.upsert({ source: \"magi\", key: \"pearls\", text: \"Collect \" + pearls + \" pearl\" + (pearls === 1 ? \"\" : \"s\") });\n  }\n});\n\n// The cities: a room is in one when its GMCP area IS the city's name, exactly\n// (case aside). Ricardo: by area, not environment (a city holds rooms of many\n// environments), and exactly, so \"The Cyrene Road\" isn't Cyrene.\nL.cityAreas = [\"Targossas\", \"Cyrene\", \"Hashan\", \"Ashtan\", \"Mhaldor\", \"Eleusis\"];\n\n// #165 sigils -> room (Ricardo): monoliths shown in Here with their own icon,\n// and two warnings by the room's area: a city room without a monolith\n// (unless SIGILS IGNORE skips it), and a monolith outside the cities.\n// room.alerts answers [{ label, tone, mark }] for the whole room, given\n// { id, area, environment, items: [names] }; Here shows them as header tags, and\n// turns the rows flagged with `mark` (an item flag's label) to the alert.\nL.addLink({\n  id: \"sigils-room\", src: \"sigils\", dst: \"room\", issue: 165,\n  desc: \"Monoliths in Here; warns of a city room without one, or one outside the city\",\n  answers: {\n    \"item.flags\": function (name) {\n      var s = client.loom.sigils;\n      return (s && s.look && s.look.isMonolith(name)) ? { label: \"monolith\", tone: \"info\", icon: \"\\u25ae\", title: \"monolith\" } : undefined;\n    },\n    \"room.alerts\": function (ctx) {\n      var s = client.loom.sigils;\n      if (!s || !s.look || !ctx) return undefined;\n      var mono = false;\n      for (var i = 0; i < (ctx.items || []).length; i++) { if (s.look.isMonolith(ctx.items[i])) { mono = true; break; } }\n      var area = String(ctx.area || \"\").trim().toLowerCase(), urban = false;\n      for (var ci = 0; ci < L.cityAreas.length; ci++) { if (L.cityAreas[ci].toLowerCase() === area) { urban = true; break; } }\n      if (urban && !mono && !s.look.ignored(ctx.id)) return [{ label: \"no monolith\", tone: \"bad\" }];\n      if (!urban && mono) return [{ label: \"monolith outside the city\", tone: \"bad\", mark: \"monolith\" }];\n      return undefined;\n    }\n  }\n});\n\n// #42 sigils -> ledger (Ricardo): one \"Sigil patrol\" item, due the Achaean\n// day the earliest flagged monolith runs out (monoliths only; a room with\n// none is due at once). Withdrawn when nothing is flagged. A sigil month is\n// an Achaean month, 25 Achaean days; an Achaean day is about a real hour,\n// so a reading taken at real time t is dated back by the hours since then.\n// Each reading's day is worked out once and kept, so the due date doesn't\n// jitter as the hour turns. Waits until the ledger knows today's date.\nL.sigilDue = L.sigilDue || {};\nL.addLink({\n  id: \"sigils-ledger\", src: \"sigils\", dst: \"ledger\", issue: 42,\n  desc: \"A sigil patrol in the ledger, due when the first flagged monolith runs out\",\n  update: function () {\n    var s = client.loom.sigils, lg = client.loom.ledger;\n    if (!s || !s.look || !s.look.expiring || !lg || !lg.entry) return;\n    var rows = s.look.expiring();\n    if (!rows.length) { lg.entry.withdraw(\"sigils\", \"patrol\"); return; }\n    if (!(lg.day > 0)) return;\n    var now = Date.now(), due = null, first = null, none = 0, seen = {};\n    for (var i = 0; i < rows.length; i++) {\n      var r = rows[i], ck = r.id + \"|\" + r.t + \"|\" + r.months;\n      seen[ck] = true;\n      if (L.sigilDue[ck] === undefined) {\n        var read = lg.day - (r.t ? Math.max(0, Math.floor((now - r.t) / 3600000)) : 0);\n        L.sigilDue[ck] = read + Math.max(0, r.months) * 25;\n      }\n      if (r.months < 0) none++;\n      if (due === null || L.sigilDue[ck] < due) { due = L.sigilDue[ck]; first = r; }\n    }\n    for (var k in L.sigilDue) { if (L.sigilDue.hasOwnProperty(k) && !seen[k]) delete L.sigilDue[k]; }\n    var n = rows.length;\n    var text = \"Sigil patrol: \" + n + \" monolith\" + (n === 1 ? \"\" : \"s\") + \" to renew\" + (none ? \" (\" + none + \" missing)\" : \"\") + \", first \" + first.name + \" (\" + first.id + \")\";\n    lg.entry.upsert({ source: \"sigils\", key: \"patrol\", text: text, due: due });\n  }\n});\n\n// #60 standings -> social (Ricardo): a switch, SOCIAL COLOURS GROUPS|STANDINGS\n// (social's own setting, default groups). In standings mode social asks this\n// link for a name's colour: the band's colour for anyone on the books, groups\n// ignored, plain for everyone else (Ricardo). Social\n// passes it on to everything that shows its colours: game lines, Online,\n// Here and Comms. Its own question, so it switches apart from standings-online.\nL.addLink({\n  id: \"standings-social\", src: \"standings\", dst: \"social\", issue: 60,\n  desc: \"Names coloured by standing band, when SOCIAL COLOURS STANDINGS is chosen\",\n  answers: {\n    \"person.colour\": function (name) {\n      var st = client.loom.standings;\n      var r = st && st.look && st.look.standing ? st.look.standing(name) : undefined;\n      return r ? r.colour : undefined;\n    }\n  }\n});\n\n// #166 harvesting -> room (Ricardo): the plants that should grow in the\n// room's environment, in Here: green when here and stocked, yellow when here\n// but under the minimum (stock not seen counts as none, as harvesting does),\n// red when missing. The list and which plants are here come from patrolling\n// (its expected table, learnt from real PLANTS output, and its silent PLANTS\n// check with PATROLLING ON); stock and minimum from harvesting. Plants\n// harvesting doesn't track (fruit, grain…) are green when here. Until\n// patrolling has checked this room, nothing is shown. Display only.\nL.addLink({\n  id: \"harvesting-room\", src: \"harvesting\", dst: \"room\", issue: 166,\n  desc: \"The environment's plants in Here: stocked, low or missing (needs PATROLLING ON)\",\n  answers: {\n    \"room.plants\": function (ctx) {\n      var h = client.loom.harvesting, p = client.loom.patrolling;\n      if (!h || !h.look || !h.look.plant || !p || !p.look || !p.look.plants || !p.look.expected || !ctx) return undefined;\n      var here = p.look.plants(ctx.id), exp = p.look.expected(ctx.environment);\n      if (!here || !exp || !exp.length) return undefined;\n      var out = [];\n      for (var i = 0; i < exp.length; i++) {\n        var hp = h.look.plant(exp[i]);\n        out.push({ plant: exp[i], present: here.indexOf(exp[i]) >= 0, stock: hp.stock, min: hp.min, low: hp.tracked && (hp.stock === null ? 0 : hp.stock) < hp.min, tracked: hp.tracked });\n      }\n      return out;\n    }\n  }\n});\n\n// #39 huntstats -> coffers (Ricardo: realistic, a little better each time):\n// when a hunt starts in an area you've hunted before, propose a gold goal of\n// your average hunt there +10% (average gold/hr x average hunt length is just\n// total gold / hunts), rounded up to 100. Withdrawn when the hunt ends\n// (filed, or you leave the area); an accepted goal stays yours.\nL.huntGoalStretch = 1.1;\nL.addLink({\n  id: \"huntstats-coffers\", src: \"huntstats\", dst: \"coffers\", issue: 39,\n  desc: \"A gold goal 10% over your average hunt in an area, when you start hunting there\",\n  update: function () {\n    var hs = client.loom.huntstats, co = client.loom.coffers;\n    if (!hs || !hs.look || !hs.look.hunt || !hs.look.average || !co || !co.entry) return;\n    var h = hs.look.hunt();\n    var avg = h ? hs.look.average(h.area) : undefined;\n    if (!h || !avg) { co.entry.withdraw(\"huntstats\", \"hunt\"); return; }\n    var fmt = function (n) { return String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"); };\n    co.entry.propose({ source: \"huntstats\", key: \"hunt\", amount: Math.ceil(avg.gold * L.huntGoalStretch / 100) * 100, why: \"10% over your average hunt in \" + h.area + \" (\" + fmt(avg.gold) + \" gold over \" + avg.hunts + \" hunt\" + (avg.hunts === 1 ? \"\" : \"s\") + \")\" });\n  }\n});\n\n// #47 self -> ledger (Ricardo): when your explorer rank drops while you're\n// logged in (the red arrow in the Self tab), the ledger gets \"Explore a new\n// area\"; nothing stored, the starting point is this page load's first\n// reading, as the tab's. The item stays until you DONE or DROP it (Ricardo),\n// even when the rank recovers or the page reloads. Once it's gone and the\n// rank is no longer down, its dismissal is cleared (withdraw), so the next\n// drop brings a new one: one reminder per drop.\nL.addLink({\n  id: \"self-ledger\", src: \"self\", dst: \"ledger\", issue: 47,\n  desc: \"Explore a new area, when your explorer rank drops while you play\",\n  update: function () {\n    var sf = client.loom.self, lg = client.loom.ledger;\n    if (!sf || !sf.look || !sf.look.explorer || !lg || !lg.entry) return;\n    var e = sf.look.explorer();\n    if (!e || !e.dropped) { if (!lg.entry.get(\"self\", \"explore\")) lg.entry.withdraw(\"self\", \"explore\"); return; }\n    lg.entry.upsert({ source: \"self\", key: \"explore\", text: \"Explore a new area (explorer rank \" + e.base + \" \\u2192 \" + e.rank + \")\" });\n  }\n});\n\n// #59 dmgchart -> huntstats (Ricardo): the damage a hunt took. dmgchart keeps\n// a rolling record of fights in memory; huntstats asks at filing (and while\n// the Stats tab shows the hunt under way) for the stretch since the hunt's\n// first experience, the fight that brought it included. Per area: incoming\n// damage per combat second and the biggest hit, coloured by HUNTSTATS TANK.\nL.addLink({\n  id: \"dmgchart-huntstats\", src: \"dmgchart\", dst: \"huntstats\", issue: 59,\n  desc: \"Damage taken per combat second and the biggest hit, per hunt and per area\",\n  answers: {\n    \"hunt.damage\": function (arg) {\n      var dc = client.loom.dmgchart;\n      if (!dc || !dc.look || !dc.look.since || !arg) return undefined;\n      return dc.look.since(arg.from);\n    }\n  }\n});\n\n// #197 ledger -> social (with #49): open ledger items that name someone, as\n// a capitalised whole word (\"pay back Ana 5k\"). Online (ledger-online): a\n// quill on their row, with the count, in the ledger's warning colours. The\n// \"has awoken\" notice (ledger-login): the items after it. Two links, two\n// questions, so each switches on its own.\nfunction ledgerAbout(n) { var lg = client.loom.ledger; return (lg && lg.look && lg.look.about) ? lg.look.about(n) : undefined; }\nL.addLink({\n  id: \"ledger-online\", src: \"ledger\", dst: \"social\", issue: 197,\n  desc: \"A quill in the Online tab on people your open ledger items name\",\n  answers: { \"person.ledger\": function (n) { var a = ledgerAbout(n); return a && a.length ? a : undefined; } }\n});\nL.addLink({\n  id: \"ledger-login\", src: \"ledger\", dst: \"social\", issue: 197,\n  desc: \"Your open ledger items about someone in their 'has awoken' notice\",\n  answers: { \"notice.ledger\": function (n) { var a = ledgerAbout(n); return a && a.length ? a : undefined; } }\n});\n\n// #40 huntstats -> standings (Ricardo): a hunt of 30 minutes or more with\n// someone in the party suggests the smallest friendly dealing (+) with each\n// of them, to review (STANDINGS OK / SKIP). Acted on only right after the\n// hunt is filed (within a minute) and once per hunt, so a reload or a later\n// notice never brings it back. The party is huntstats' own (HUNTSTATS PARTY,\n// later filled from follow lines, #188). A newer hunt with the same person\n// replaces their pending suggestion.\nL.huntNudgeMs = 30 * 60000;\nL.addLink({\n  id: \"huntstats-standings\", src: \"huntstats\", dst: \"standings\", issue: 40,\n  desc: \"A small friendly dealing to review with people you hunted with for 30 minutes or more\",\n  update: function () {\n    var hs = client.loom.huntstats, st = client.loom.standings;\n    if (!hs || !hs.look || !hs.look.filed || !st || !st.entry) return;\n    var f = hs.look.filed();\n    if (!f || !f.at || f.at === L.huntNudged || Date.now() - f.at > 60000) return;\n    L.huntNudged = f.at;\n    if (!(f.ms >= L.huntNudgeMs) || !f.players || !f.players.length) return;\n    var mins = Math.round(f.ms / 60000);\n    var len = mins >= 60 ? Math.floor(mins / 60) + \"h \" + (mins % 60) + \"m\" : mins + \"m\";\n    for (var i = 0; i < f.players.length; i++) {\n      st.entry.suggest({ who: f.players[i], step: 1, why: \"hunted together in \" + f.area + \" for \" + len, source: \"huntstats\" });\n    }\n  }\n});\n\n// #176 defcon -> self (Ricardo): the Self tab watches what DEFCON keeps up\n// at its level, every defence of the effective table with a tier >= it, as\n// its own layer next to SELF WANT (never written into it). DEFCON's missing\n// defences show amber, yours red; DEFCON's losses only in the tab (its\n// curing puts them back); the Defences title and SELF's summary name the\n// level. A defence DEFCON relaxes on purpose isn't watched at that level.\nL.addLink({\n  id: \"defcon-self\", src: \"defcon\", dst: \"self\", issue: 176,\n  desc: \"The Self tab watches the defences DEFCON keeps up at its level\",\n  answers: {\n    \"defences.wanted\": function () { var d = client.loom.defcon; return (d && d.look && d.look.wanted) ? d.look.wanted() : undefined; }\n  }\n});\n\n// #53 coffers -> standings (Ricardo): gold given to you, 5,000 or more at\n// once, suggests the smallest friendly dealing (+) with the giver, to review.\n// Gold from someone in your huntstats party is the split being settled, not\n// a gift, so it's skipped (read from huntstats' look when it's installed).\n// Gifts are kept in memory only and each is looked at once, so a reload or\n// a SKIP never brings one back. A newer gift replaces that person's pending\n// suggestion.\nL.giftMin = 5000;\nL.addLink({\n  id: \"coffers-standings\", src: \"coffers\", dst: \"standings\", issue: 53,\n  desc: \"A small friendly dealing to review with whoever gives you 5,000 gold or more (party skipped, via huntstats)\",\n  update: function () {\n    var co = client.loom.coffers, st = client.loom.standings, hs = client.loom.huntstats;\n    if (!co || !co.look || !co.look.gifts || !st || !st.entry) return;\n    var gifts = co.look.gifts(L.giftSeen || 0);\n    if (!gifts.length) return;\n    L.giftSeen = gifts[gifts.length - 1].t;\n    var party = (hs && hs.look && hs.look.party) ? hs.look.party() : [];\n    var inParty = {};\n    for (var p = 0; p < party.length; p++) inParty[String(party[p]).toLowerCase()] = true;\n    var fmt = function (n) { return String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"); };\n    for (var i = 0; i < gifts.length; i++) {\n      var g = gifts[i];\n      if (g.amount < L.giftMin || inParty[g.who.toLowerCase()]) continue;\n      st.entry.suggest({ who: g.who, step: 1, why: \"gave you \" + fmt(g.amount) + \" gold\", source: \"coffers\" });\n    }\n  }\n});\n\n// #242 room -> social, comms (Ricardo): a green leaf on newbies, players\n// whose full name carries Uaithne, Ithin or Tuqad. Here reads the title\n// live (room's own); Online and Comms see no titles, so they ask for the\n// title someone was last seen with in a room (remembered by room).\nfunction roomNewbie(n) { var r = client.loom.room; return (r && r.look && r.look.newbie) ? r.look.newbie(n) : undefined; }\nL.addLink({\n  id: \"room-social\", src: \"room\", dst: \"social\", issue: 242,\n  desc: \"A green leaf in the Online tab on people last seen with a newbie title\",\n  answers: { \"person.newbie\": roomNewbie }\n});\nL.addLink({\n  id: \"room-comms\", src: \"room\", dst: \"comms\", issue: 242,\n  desc: \"A green leaf on newbies' names in the Comms tab\",\n  answers: { \"person.newbie\": roomNewbie }\n});\n\n// #122 social -> basher: an enemy arriving during a run makes the fight in\n// progress the last one (Ricardo: it finishes, nothing new starts; you can\n// always move by hand). The basher asks about each arrival.\nL.addLink({\n  id: \"social-basher\", src: \"social\", dst: \"basher\", issue: 122,\n  desc: \"An enemy arriving ends the basher's run after the current fight\",\n  answers: {\n    // The enemies list itself, not look.group (that gives only the first\n    // group in priority order, so family would hide an enemy).\n    \"person.enemy\": function (n) { var s = client.loom.social; var k = String(n || \"\").trim().toLowerCase(); return s && s.lists && s.lists.enemies && s.lists.enemies[k] ? true : undefined; }\n  }\n});\n\n// #163 basher -> room: Here shows the basher's kill order (Ricardo: as\n// visual as possible what happens next): each mob's place in the queue, the\n// next one, ignored types dimmed, the basher's state in the header. Answers\n// room's question room.queue (arg { area }); the basher notifies loom when\n// its queue or state changes, so Here redraws as mobs come and go.\nL.addLink({\n  id: \"basher-room\", src: \"basher\", dst: \"room\", issue: 163,\n  desc: \"Here shows the basher's kill order and state\",\n  answers: {\n    \"room.queue\": function () { var b = client.loom.basher; return b && b.look && b.look.queue ? b.look.queue() : undefined; }\n  }\n});\n\n// #299 magi -> room (crystalism's until magi 0.1.0; Ricardo): the oysters\n// that drop pearls and the pearls themselves stand out in Here, always, as a\n// green name with a green pearl icon. Pearls answer item.flags like shrines\n// and monoliths; oysters answer mob.flags, the same shape for the mobs list.\n// Corpses don't count, and your target's glow still wins.\nL.addLink({\n  id: \"magi-room\", src: \"magi\", dst: \"room\", issue: 299,\n  desc: \"Pearl-dropping oysters and pearls shown green in Here\",\n  answers: {\n    \"item.flags\": function (name) {\n      var c = client.loom.magi;\n      return (c && c.look && c.look.pearl && c.look.pearl(name)) ? { label: \"pearl\", tone: \"good\", icon: \"\\u25c9\", title: \"a pearl: refine it into crystals (magi)\" } : undefined;\n    },\n    \"mob.flags\": function (name) {\n      var c = client.loom.magi;\n      return (c && c.look && c.look.pearlMob && c.look.pearlMob(name)) ? { label: \"pearls\", tone: \"good\", icon: \"\\u25c9\", title: \"drops pearls (magi)\" } : undefined;\n    }\n  }\n});\n\n// #256 partycomms -> room (Ricardo): each mob row in Here names the party\n// members whose latest report (under 30 s old) targets it, so you see who's\n// on what. Answers mob.party (arg: the mob's id) -> [names], you left out.\nL.addLink({\n  id: \"partycomms-room\", src: \"partycomms\", dst: \"room\", issue: 256,\n  desc: \"Party members' targets shown on the mobs in Here\",\n  answers: {\n    \"mob.party\": function (id) {\n      var p = client.loom.partycomms;\n      var a = (p && p.look && p.look.targeting) ? p.look.targeting(id) : [];\n      return a.length ? a : undefined;\n    }\n  }\n});\n\n// Loyals (Ricardo) room -> basher: room probes each new mob once and learns\n// whose loyal it is (\"He is loyal to Falau.\"). The basher never queues or\n// auto-targets someone's loyal, even when its name is active in the area.\n// Answers mob.loyal (arg: the mob's id) -> the owner, or undefined.\nL.addLink({\n  id: \"room-basher\", src: \"room\", dst: \"basher\",\n  desc: \"The basher skips mobs that are someone's loyal (found by Here's probe)\",\n  answers: {\n    \"mob.loyal\": function (id) {\n      var r = client.loom.room;\n      var o = (r && r.look && r.look.loyal) ? r.look.loyal(id) : undefined;\n      return o ? o : undefined;\n    }\n  }\n});\n\n// #369 waypoints -> room (Ricardo): a room you've saved as a waypoint shows\n// \"⚑ <name>\" on Here's exits line, where the detail tags go; the note on\n// hover. Answers room.waypoint (arg: { id }) -> { name, note }.\nL.addLink({\n  id: \"waypoints-room\", src: \"waypoints\", dst: \"room\", issue: 369,\n  desc: \"A saved waypoint's name as a tag in Here, its note on hover\",\n  answers: {\n    \"room.waypoint\": function (ctx) {\n      var w = client.loom.waypoints;\n      return (w && w.look && w.look.at && ctx) ? w.look.at(ctx.id) : undefined;\n    }\n  }\n});\n\n// #376 waypoints -> questbook: a quest's GO step whose room is a saved waypoint\n// shows the waypoint's name (⚑ name) under the step. Answers questbook.waypoint\n// (arg: { id }) -> { name, note }.\nL.addLink({\n  id: \"waypoints-questbook\", src: \"waypoints\", dst: \"questbook\", issue: 376,\n  desc: \"A quest's GO step shows the waypoint's name when its room is one\",\n  answers: {\n    \"questbook.waypoint\": function (ctx) {\n      var w = client.loom.waypoints;\n      return (w && w.look && w.look.at && ctx) ? w.look.at(ctx.id) : undefined;\n    }\n  }\n});\n\n// #369 room -> waypoints (Ricardo): Here's REMEMBER is a shortcut waypoint,\n// pinned at the top of the Waypoints tab with GO BACK (or REMEMBER HERE when\n// nothing is remembered). Answers waypoints.remembered -> { id, name, area,\n// at } or {} when nothing is remembered, plus remember/back/forget, which\n// do what Here's buttons do.\nL.addLink({\n  id: \"room-waypoints\", src: \"room\", dst: \"waypoints\", issue: 369,\n  desc: \"Here's remembered room pinned at the top of Waypoints, with GO BACK\",\n  answers: {\n    \"waypoints.remembered\": function () {\n      var r = client.loom.room;\n      if (!r || !r.look || !r.look.mark || !r.entry) return undefined;\n      var m = r.look.mark() || {};\n      return { id: m.id, name: m.name, area: m.area, at: m.at, remember: r.entry.remember, back: r.entry.back, forget: r.entry.forget };\n    }\n  }\n});\n"
  },
  {
   "type": "function",
   "name": "loom_theme",
   "enabled": true,
   "code": "// loom_theme -- city themes for the custom tabs (#310).\n//\n// A theme gives every tab one city's palette. It covers each tab's identity\n// colours only (accent, headings, text, rules, bar tracks, backgrounds and\n// button surfaces); colours that mean something (good, warning, bad,\n// standings bands, social groups, the target glow, gold, damage dealt and\n// taken) are never themed.\n//\n// Tabs read client.loom.theme, an object of roles, or null for no theme:\n//   var TH = (client.loom && client.loom.theme) || {};\n//   var ACC = TH.acc || \"#e0b46c\";   // the tab's own colour when no theme\n// so with no theme, or without loom, every tab looks as it always has.\n//\n// Roles: acc (accent: titles, big figures), deep (headings, header rules,\n// outlines), hi (brightest text), txt (body text), muted, dim, rule (lines\n// and borders), track (bar tracks), bg (panel background), panel (button and\n// chip fill), edge (button border), sel (selected or highlighted row).\n//\n// The choice: loom_theme = auto (default: follow the city, from Char.Status),\n// off (each tab's own colours) or a city name. loom_city keeps the last city\n// seen (\"none\" when cityless), since Char.Status carries it only at login.\nif (!client.loom) client.loom = {};\nif (!client.loom.loom) client.loom.loom = {};\nvar L = client.loom.loom;\n\nL.themes = {\n  ashtan:    { label: \"Ashtan, purples\",       acc: \"#b89ae8\", deep: \"#5b4685\", hi: \"#f3effa\", txt: \"#e5e0ee\", muted: \"#8b8598\", dim: \"#665f73\", rule: \"#2a2336\", track: \"#1e1928\", bg: \"#110e16\", panel: \"#1a1621\", edge: \"#362d45\", sel: \"#251d33\" },\n  cyrene:    { label: \"Cyrene, blues\",         acc: \"#7fb0e8\", deep: \"#3a5f8a\", hi: \"#eef4fb\", txt: \"#dde6ef\", muted: \"#7f8b98\", dim: \"#5c6875\", rule: \"#1f2a37\", track: \"#16202b\", bg: \"#0c1117\", panel: \"#151d27\", edge: \"#2c3a4b\", sel: \"#172638\" },\n  eleusis:   { label: \"Eleusis, forest greens\", acc: \"#5fb59a\", deep: \"#2e6152\", hi: \"#e6f2ec\", txt: \"#dce7e0\", muted: \"#82918a\", dim: \"#5d6b64\", rule: \"#1f2e28\", track: \"#15211c\", bg: \"#0c1310\", panel: \"#15201b\", edge: \"#2b3d35\", sel: \"#17302a\" },\n  hashan:    { label: \"Hashan, steel greys\",   acc: \"#aebccb\", deep: \"#59636f\", hi: \"#f0f3f6\", txt: \"#e0e4e8\", muted: \"#868c94\", dim: \"#62686f\", rule: \"#262a30\", track: \"#1b1e22\", bg: \"#0f1113\", panel: \"#181b1f\", edge: \"#343a42\", sel: \"#22272e\" },\n  mhaldor:   { label: \"Mhaldor, oxblood reds\", acc: \"#cf6f86\", deep: \"#6e2a3a\", hi: \"#f8ecef\", txt: \"#ece0e3\", muted: \"#93838a\", dim: \"#6e5f65\", rule: \"#33202a\", track: \"#24171d\", bg: \"#140c0f\", panel: \"#1e1317\", edge: \"#422a33\", sel: \"#2e1820\" },\n  targossas: { label: \"Targossas, golds\",      acc: \"#ecd27e\", deep: \"#7c6830\", hi: \"#fbf4dc\", txt: \"#ebe5d2\", muted: \"#918a74\", dim: \"#6b6553\", rule: \"#2e2919\", track: \"#221e12\", bg: \"#13110a\", panel: \"#1d1a10\", edge: \"#3b3420\", sel: \"#2b2612\" }\n};\n\n// PK MODE's theme (Ricardo, 2026-10-28): while hunting's PK MODE is on,\n// every tab takes this palette whatever LOOM THEME says, so it's plain you\n// are set for PvP. Hot magenta: no city's hue, and no colour that means\n// something (the target's red glow, warnings, good/bad) is near it. Not a\n// LOOM THEME choice. L.themePk follows hunting's HU.pk (off at every load).\nL.themePkPalette = { label: \"PK MODE, hot magenta\", acc: \"#ff4fa3\", deep: \"#8a2457\", hi: \"#ffeef7\", txt: \"#f1e1ea\", muted: \"#9a8590\", dim: \"#71606a\", rule: \"#3a1d2c\", track: \"#2a1420\", bg: \"#160a10\", panel: \"#22101a\", edge: \"#4d2338\", sel: \"#381427\" };\nL.themePk = !!(client.loom.hunting && client.loom.hunting.pk);\nL.themeSetPk = function (on) {\n  on = !!on;\n  if (on === L.themePk) return false;\n  L.themePk = on;\n  return L.themeApply();\n};\n\n// The saved choice: \"auto\", \"off\" or a city.\nL.themeChoice = function () {\n  var c = String(get_variable(\"loom_theme\") || \"auto\").toLowerCase();\n  return (c === \"off\" || L.themes[c]) ? c : \"auto\";\n};\n\n// The city whose theme is in use, or \"\" for none.\nL.themeName = function () {\n  if (L.themePk) return \"pk\";\n  var c = L.themeChoice();\n  if (c === \"off\") return \"\";\n  if (c === \"auto\") c = String(get_variable(\"loom_city\") || \"\").toLowerCase();\n  return L.themes[c] ? c : \"\";\n};\n\n// Publish the theme and, when it changed, redraw every tab.\nL.themeApply = function () {\n  var n = L.themeName();\n  var t = null;\n  var pal = n === \"pk\" ? L.themePkPalette : L.themes[n];\n  if (n && pal) {\n    t = {};\n    for (var k in pal) if (k !== \"label\") t[k] = pal[k];\n  }\n  client.loom.theme = t;\n  if (n === (L.themeNow || \"\")) return false;\n  L.themeNow = n;\n  var reg = client.loom.registry || {};\n  for (var p in reg) if (reg[p] && typeof reg[p].redraw === \"function\" && L.redraw) L.redraw(p);\n  return true;\n};\n\n// Char.Status gives the city as \"Eleusis (12)\", \"Eleusis\" or \"(none)\".\nL.themeSeeCity = function (raw) {\n  var c = String(raw || \"\").replace(/\\s*\\(.*\\)\\s*$/, \"\").trim().toLowerCase() || \"none\";\n  if (c === (String(get_variable(\"loom_city\") || \"\").toLowerCase())) return;\n  set_variable(\"loom_city\", c);\n  L.themeApply();\n};\n\nL.themeApply();\n"
  },
  {
   "type": "function",
   "name": "loom_perf",
   "enabled": true,
   "code": "// loom_perf -- LOOM PERF (#209): what the packages cost while you play.\n// Run from onLoad/onInstall; defines L.perf (start, stop, data). Nothing is\n// measured, and nothing wrapped, unless a sample is running.\n//\n// How it measures (found by probing the client, 2026-10-20): package scripts\n// see `client` as Nexus's own nexusclient, and every script the client runs\n// (function bodies, trigger and alias scripts) goes through\n// client.exec_script(code, args, package, label). A sample wraps that one\n// method, plus _reflexes.handle_triggers (each game line), the triggers'\n// shared do_matching (each pattern tried) and _datahandler.handle_GMCP (each\n// GMCP message), with performance.now(). Stopping puts every one back.\nif (!client.loom) client.loom = {};\nif (!client.loom.loom) client.loom.loom = {};\nvar L = client.loom.loom;\n\n// A sample left running by an earlier copy of this script (loom reimported\n// mid-sample) is ended first, so no wrapper outlives the code that knows it.\nif (client.__loomPerfRestore) { try { client.__loomPerfRestore(); } catch (e) {} client.__loomPerfRestore = null; }\nL.perfState = null;\n\nL.perfNow = function () { return (typeof performance != \"undefined\" && performance.now) ? performance.now() : Date.now(); };\nL.perfMin = 5;\nL.perfMax = 600;\nL.perfDefault = 60;\n// A single call longer than one frame at 60 fps is worth a look.\nL.perfSlow = 16;\n\n// Can this client be measured? Lists what's missing.\nL.perfMissing = function () {\n  var miss = [];\n  if (typeof client.exec_script != \"function\") miss.push(\"exec_script\");\n  return miss;\n};\n\n// Which script ran: \"Function [name]\" labels name themselves; trigger and\n// alias scripts are often unnamed, so their first comment line stands in.\nL.perfWhat = function (code, label, trig) {\n  var lb = String(label || \"\");\n  var m = /^(\\w+)\\s*\\[(.*)\\]\\s*$/.exec(lb);\n  var kind = m ? m[1].toLowerCase() : (lb ? lb.split(/\\s/)[0].toLowerCase() : \"script\");\n  var name = m ? m[2] : \"\";\n  // Unnamed: the script's opening comment says what it is (house style);\n  // failing that, a trigger's pattern; failing that, its first line.\n  var first = String(code || \"\").replace(/^\\s+/, \"\").split(\"\\n\")[0];\n  if (!name && /^\\/\\//.test(first)) name = first.replace(/^\\/\\/\\s*/, \"\");\n  if (!name && kind === \"trigger\" && trig) {\n    var pat = trig.text !== undefined ? trig.text : trig.regexp;\n    if (pat) name = \"/\" + String(pat) + \"/\";\n  }\n  if (!name) name = first;\n  if (name.length > 44) name = name.substring(0, 43) + \"…\";\n  return { kind: kind, name: name || \"(unnamed)\" };\n};\n\nL.perfStart = function (secs) {\n  if (L.perfState) return \"running\";\n  var miss = L.perfMissing();\n  if (miss.length) return \"missing\";\n  var now = L.perfNow;\n  // The clock's step: Firefox, for one, rounds to whole milliseconds.\n  var g0 = now(), g1 = g0, gN = 0;\n  while (g1 === g0 && gN < 5000000) { g1 = now(); gN++; }\n  var g2 = g1; gN = 0;\n  while (g2 === g1 && gN < 5000000) { g2 = now(); gN++; }\n  var st = {\n    grain: Math.max(0, g2 - g1),\n    t0: now(), wall0: Date.now(), secs: secs, done: false,\n    stack: [], scripts: {}, pkgs: {}, gmcp: {}, lines: 0, lineMs: 0, execInLines: 0,\n    matchPkg: {}, gmcpCount: 0, inLine: false,\n  };\n  var pkgOf = function (p) { return p ? String(p) : \"(yours)\"; };\n  var pk = function (p) { return st.pkgs[p] || (st.pkgs[p] = { self: 0, calls: 0, worst: 0, worstWhat: \"\", match: 0 }); };\n  var undo = [];\n  // Wraps obj[key] for the sample; undo puts back exactly what was there.\n  var wrap = function (obj, key, make) {\n    if (!obj || typeof obj[key] != \"function\") return false;\n    var own = Object.prototype.hasOwnProperty.call(obj, key), orig = obj[key];\n    obj[key] = make(orig);\n    undo.push(function () { if (own) obj[key] = orig; else delete obj[key]; });\n    return true;\n  };\n\n  wrap(client, \"exec_script\", function (orig) {\n    return function (code, a, p, label) {\n      var fr = { t: now(), child: 0 };\n      st.stack.push(fr);\n      try { return orig.apply(this, arguments); }\n      finally {\n        st.stack.pop();\n        var d = now() - fr.t, self = d - fr.child;\n        if (st.stack.length) st.stack[st.stack.length - 1].child += d;\n        else if (st.inLine) st.execInLines += d;\n        var pn = pkgOf(p), w = L.perfWhat(code, label, st.lastTrig), key = pn + \"\\u0000\" + w.kind + \"\\u0000\" + w.name;\n        var r = st.scripts[key] || (st.scripts[key] = { pkg: pn, kind: w.kind, name: w.name, calls: 0, self: 0, max: 0 });\n        r.calls++; r.self += self; if (d > r.max) r.max = d;\n        var P = pk(pn); P.self += self; P.calls++;\n        if (d > P.worst) { P.worst = d; P.worstWhat = w.kind + \" \" + w.name; }\n      }\n    };\n  });\n\n  var RX = client._reflexes;\n  wrap(RX, \"handle_triggers\", function (orig) {\n    return function () {\n      var t = now(), was = st.inLine;\n      st.inLine = true;\n      try { return orig.apply(this, arguments); }\n      finally { st.inLine = was; st.lines++; st.lineMs += now() - t; }\n    };\n  });\n  // Each pattern tried, by package: what its triggers cost on every line,\n  // matched or not. The triggers share do_matching on their prototype.\n  var trig = null;\n  try { var al = RX && RX.get_active_list ? RX.get_active_list(\"trigger\") : []; trig = al && al.length ? Object.getPrototypeOf(al[0]) : null; } catch (e) { trig = null; }\n  var owner = typeof WeakMap != \"undefined\" ? new WeakMap() : null;\n  // The package a trigger belongs to: its top group, reached through `p`\n  // (the client's own package_for_reflex climbs a field these don't have).\n  var pkgNames = {};\n  try { var pls = client._packages.list(); for (var pi = 0; pi < pls.length; pi++) pkgNames[pls[pi].name] = true; } catch (e) {}\n  var ownerOf = function (rx) {\n    if (owner && owner.has(rx)) return owner.get(rx);\n    var n = \"(yours)\", x = rx;\n    try {\n      for (var d = 0; x && d < 30; d++) {\n        if (x.is_package || (!x.p && x !== rx)) { if (x.is_package || pkgNames[x.name]) n = String(x.name); break; }\n        x = x.p;\n      }\n    } catch (e) {}\n    if (owner) owner.set(rx, n);\n    return n;\n  };\n  if (trig) wrap(trig, \"do_matching\", function (orig) {\n    return function () {\n      var t = now(), m = null;\n      try { m = orig.apply(this, arguments); return m; }\n      finally {\n        var n = ownerOf(this);\n        st.matchPkg[n] = (st.matchPkg[n] || 0) + (now() - t);\n        // The trigger whose script runs next, for its label.\n        if (m) st.lastTrig = this;\n      }\n    };\n  });\n  wrap(client._datahandler, \"handle_GMCP\", function (orig) {\n    return function (method) {\n      var t = now();\n      try { return orig.apply(this, arguments); }\n      finally {\n        var d = now() - t, g = st.gmcp[method] || (st.gmcp[method] = { calls: 0, ms: 0, max: 0 });\n        g.calls++; g.ms += d; if (d > g.max) g.max = d; st.gmcpCount++;\n      }\n    };\n  });\n\n  st.restore = function () { while (undo.length) { try { undo.pop()(); } catch (e) {} } };\n  client.__loomPerfRestore = st.restore;\n  L.perfState = st;\n  st.timer = setTimeout(function () { if (L.perfState === st) L.perfStop(); }, secs * 1000);\n  return \"started\";\n};\n\n// Ends the sample (or does nothing), puts everything back, prints the report.\nL.perfStop = function () {\n  var st = L.perfState;\n  if (!st || st.done) return false;\n  st.done = true;\n  st.restore();\n  client.__loomPerfRestore = null;\n  try { clearTimeout(st.timer); } catch (e) {}\n  st.elapsed = Math.max(1, L.perfNow() - st.t0);\n  L.perfState = null;\n  L.perfReport(st);\n  return true;\n};\n\n// Saved data by package: every variable, by its package's prefix.\nL.perfData = function () {\n  var vars = (client._variables && client._variables.vars && typeof client._variables.vars == \"object\") ? client._variables.vars : null;\n  if (!vars) return null;\n  var names = Object.keys(client.loom.registry || {}).sort(function (a, b) { return b.length - a.length; });\n  var out = {}, total = 0;\n  for (var k in vars) {\n    if (!Object.prototype.hasOwnProperty.call(vars, k)) continue;\n    var v = vars[k], s;\n    try { s = typeof v == \"string\" ? v.length : JSON.stringify(v).length; } catch (e) { s = 0; }\n    if (!s) continue;\n    var p = \"(other)\";\n    for (var i = 0; i < names.length; i++) if (k.indexOf(names[i] + \"_\") === 0) { p = names[i]; break; }\n    var o = out[p] || (out[p] = { size: 0, n: 0, big: \"\", bigSize: 0 });\n    o.size += s; o.n++; total += s;\n    if (s > o.bigSize) { o.bigSize = s; o.big = k; }\n  }\n  return { pkgs: out, total: total };\n};\n\n// ---- Printing -----------------------------------------------------------\nL.perfFmtMs = function (ms) { return ms >= 100 ? Math.round(ms) + \" ms\" : ms >= 10 ? ms.toFixed(1) + \" ms\" : ms.toFixed(2) + \" ms\"; };\nL.perfFmtN = function (n) { return String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"); };\nL.perfFmtKB = function (c) { return c >= 1024 * 1024 ? (c / 1048576).toFixed(1) + \" MB\" : c >= 1024 ? (c / 1024).toFixed(1) + \" KB\" : c + \" B\"; };\n\n// Lines of [text, colour] cells, printed as one monospace block.\nL.perfPrint = function (title, rows) {\n  var esc = function (t) { return String(t).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); };\n  var html = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\n  display_notice(title, \"cyan\");\n  var out = [];\n  for (var i = 0; i < rows.length; i++) {\n    var r = rows[i];\n    if (!html) { display_notice(\"  \" + r.map(function (c) { return c[0]; }).join(\"\"), \"cyan\"); continue; }\n    out.push(\"  \" + r.map(function (c) { return '<span style=\"color:' + (c[1] || \"#9fc9c9\") + '\">' + esc(c[0]) + \"</span>\"; }).join(\"\"));\n  }\n  if (html && out.length) nexusclient.add_html_line('<div style=\"font-family:monospace;white-space:pre\">' + out.join(\"<br>\") + \"</div>\");\n};\nL.perfPad = function (s, w, right) {\n  s = String(s);\n  if (s.length > w) s = s.substring(0, w - 1) + \"…\";\n  var sp = new Array(w - s.length + 1).join(\" \");\n  return right ? sp + s : s + sp;\n};\n\nL.perfReport = function (st) {\n  var pad = L.perfPad, n = L.perfFmtN;\n  // A coarse clock (a step of half a millisecond or more) shows whole ms:\n  // decimals would only be noise. Totals over many calls stay fair.\n  var coarse = st.grain >= 0.5;\n  var ms = coarse ? function (v) { return (v < 1 && v > 0 ? \"<1\" : String(Math.round(v))) + \" ms\"; } : L.perfFmtMs;\n  var H = \"#00ffff\", T = \"#9fc9c9\", W = \"#e6c25a\";\n  var secs = st.elapsed / 1000;\n  var scriptMs = 0, k;\n  for (k in st.pkgs) scriptMs += st.pkgs[k].self;\n  var matchMs = 0;\n  for (k in st.matchPkg) { matchMs += st.matchPkg[k]; (st.pkgs[k] || (st.pkgs[k] = { self: 0, calls: 0, worst: 0, worstWhat: \"\", match: 0 })).match = st.matchPkg[k]; }\n  // No per-pattern figures (no trigger to hook): the lines' time less the scripts they ran.\n  if (!matchMs && st.lines) matchMs = Math.max(0, st.lineMs - st.execInLines);\n  var busy = scriptMs + matchMs;\n  var rows = [];\n  rows.push([[n(st.lines) + \" game lines, \" + n(st.gmcpCount) + \" GMCP messages. Package scripts took \" + ms(scriptMs) + \", trigger matching \" + ms(matchMs) + \": \" + (busy / st.elapsed * 100).toFixed(2) + \"% of the time.\", T]]);\n  // Each game line, in all: the patterns tried, the trigger scripts they ran,\n  // and the rest (the client's own work on the line).\n  if (st.lines) {\n    var lineMatch = 0;\n    for (k in st.matchPkg) lineMatch += st.matchPkg[k];\n    var other = Math.max(0, st.lineMs - lineMatch - st.execInLines);\n    rows.push([[\"Game lines took \" + ms(st.lineMs) + \" in all: \" + (lineMatch ? \"patterns \" + ms(lineMatch) + \", \" : \"\") + \"trigger scripts \" + ms(st.execInLines) + \", the client's own work \" + ms(other) + \".\", T]]);\n  }\n  rows.push([[\"\"]]);\n\n  // Per package, costliest first.\n  var pl = Object.keys(st.pkgs).sort(function (a, b) { return (st.pkgs[b].self + st.pkgs[b].match) - (st.pkgs[a].self + st.pkgs[a].match); });\n  var nw = 12;\n  for (var i = 0; i < pl.length; i++) if (pl[i].length + 1 > nw) nw = Math.min(16, pl[i].length + 1);\n  rows.push([[pad(\"package\", nw) + pad(\"scripts\", 10, true) + pad(\"calls\", 8, true) + pad(\"matching\", 10, true) + \"   slowest call\", H]]);\n  for (i = 0; i < pl.length && i < 30; i++) {\n    var P = st.pkgs[pl[i]];\n    rows.push([\n      [pad(pl[i], nw) + pad(ms(P.self), 10, true) + pad(n(P.calls), 8, true) + pad(P.match ? ms(P.match) : \"-\", 10, true) + \"   \", T],\n      [P.calls ? pad(ms(P.worst), 9, true) : \"\", P.worst >= L.perfSlow ? W : T],\n      [P.calls ? \"  \" + P.worstWhat : \"\", T],\n    ]);\n  }\n\n  // The costliest pieces of work.\n  var sl = [];\n  for (k in st.scripts) sl.push(st.scripts[k]);\n  sl.sort(function (a, b) { return b.self - a.self; });\n  if (sl.length) {\n    rows.push([[\"\"]]);\n    rows.push([[pad(\"costliest scripts\", 46) + pad(\"package\", 13) + pad(\"calls\", 7, true) + pad(\"total\", 10, true) + pad(\"avg\", 10, true) + pad(\"max\", 10, true), H]]);\n    for (i = 0; i < sl.length && i < 12; i++) {\n      var s = sl[i];\n      rows.push([\n        [pad(s.kind + \" \" + s.name, 46) + pad(s.pkg, 13) + pad(n(s.calls), 7, true) + pad(ms(s.self), 10, true) + pad(ms(s.self / s.calls), 10, true), T],\n        [pad(ms(s.max), 10, true), s.max >= L.perfSlow ? W : T],\n      ]);\n    }\n  }\n\n  // GMCP: the client's own handling of each message, every onGMCP included.\n  var gl = Object.keys(st.gmcp).sort(function (a, b) { return st.gmcp[b].ms - st.gmcp[a].ms; });\n  if (gl.length) {\n    rows.push([[\"\"]]);\n    rows.push([[pad(\"GMCP message (all handling)\", 34) + pad(\"count\", 8, true) + pad(\"total\", 10, true) + pad(\"max\", 10, true), H]]);\n    for (i = 0; i < gl.length && i < 8; i++) {\n      var g = st.gmcp[gl[i]];\n      rows.push([[pad(gl[i], 34) + pad(n(g.calls), 8, true) + pad(ms(g.ms), 10, true), T], [pad(ms(g.max), 10, true), g.max >= L.perfSlow ? W : T]]);\n    }\n  }\n  L.perfDataRows(rows);\n  rows.push([[\"\"]]);\n  if (coarse) rows.push([[\"This browser's clock ticks every \" + (Math.round(st.grain * 10) / 10) + \" ms, so a single call reads as 0, 1, 2 ms…; totals over many calls even out.\", T]]);\n  rows.push([[\"Times are the scripts' own (a function called from another counts under itself). Measuring adds a little to every figure. Yellow: one call over \" + L.perfSlow + \" ms, a frame at 60 fps.\", T]]);\n  L.perfPrint(\"[loom] PERF: \" + (secs < 10 ? secs.toFixed(1) : Math.round(secs)) + \" s sample\", rows);\n};\n\n// The saved-data block (also LOOM PERF DATA on its own).\nL.perfDataRows = function (rows) {\n  var pad = L.perfPad, kb = L.perfFmtKB;\n  var d = L.perfData();\n  if (!d) return;\n  var dl = Object.keys(d.pkgs).sort(function (a, b) { return d.pkgs[b].size - d.pkgs[a].size; });\n  rows.push([[\"\"]]);\n  rows.push([[pad(\"saved data\", 16) + pad(\"size\", 10, true) + pad(\"vars\", 6, true) + \"   largest\", \"#00ffff\"]]);\n  for (var i = 0; i < dl.length && i < 12; i++) {\n    var o = d.pkgs[dl[i]];\n    rows.push([[pad(dl[i], 16) + pad(kb(o.size), 10, true) + pad(o.n, 6, true) + \"   \" + o.big + \" (\" + kb(o.bigSize) + \")\", o.size >= 512 * 1024 ? \"#e6c25a\" : \"#9fc9c9\"]]);\n  }\n  rows.push([[pad(\"all\", 16) + pad(kb(d.total), 10, true), \"#9fc9c9\"]]);\n};\n"
  },
  {
   "type": "function",
   "name": "loom_packages",
   "enabled": true,
   "code": "// loom_packages -- which Loom packages are really installed. The registry\n// keeps a package until the next page load, even after it was uninstalled,\n// so LOOM and LOOM UPDATES check Nexus's own package list when it has one\n// (client._packages, as LOOM PERF reads it) and fall back to the registry.\n// Retired packages still installed are named, so the player can remove them.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.loom) client.loom.loom = {};\nvar L = client.loom.loom;\n\n// Retired package -> the one that replaced it (\"\" when none did). Only the\n// packages Loom itself retired with 0.1.0 of magi: a player's own package\n// may carry any other name (roleplay is free again, for #262 and for\n// players' own).\nL.retired = { crystalism: \"magi\", artificing: \"magi\", elementalism: \"\" };\n\n// Nexus's package names as registry keys (\"numpad movement\" ->\n// \"numpad_movement\"), or null when this Nexus doesn't offer the list.\nL.nexusPackages = function () {\n  try {\n    var pls = client._packages.list();\n    if (!pls || typeof pls.length != \"number\") return null;\n    var out = {};\n    for (var i = 0; i < pls.length; i++) out[String(pls[i].name || \"\").toLowerCase().replace(/\\s+/g, \"_\")] = true;\n    return out;\n  } catch (e) { return null; }\n};\n\n// The registered packages that are installed now, retired ones left out.\nL.installed = function () {\n  var reg = client.loom.registry || {}, nx = L.nexusPackages(), out = [];\n  for (var n in reg) {\n    if (!reg.hasOwnProperty(n) || L.retired.hasOwnProperty(n)) continue;\n    if (!nx || nx[n]) out.push(n);\n  }\n  return out.sort();\n};\n\n// Retired packages still installed: [{ name, by }]. Only Loom's own copy\n// counts: it must have registered this page (a player's package of the same\n// name doesn't), and, when Nexus's list is there, still be installed.\nL.retiredHere = function () {\n  var reg = client.loom.registry || {}, nx = L.nexusPackages(), out = [];\n  for (var n in L.retired) {\n    if (!L.retired.hasOwnProperty(n)) continue;\n    if (reg[n] && (!nx || nx[n])) out.push({ name: n, by: L.retired[n] });\n  }\n  return out;\n};\n"
  },
  {
   "type": "function",
   "name": "loom_updates",
   "enabled": true,
   "code": "// loom_updates -- compares the packages loaded here with the versions on\n// main (dist/versions.json, written by tools/versions.py on every push).\n// LOOM UPDATES runs it with loom_updates_mode \"manual\": it always reports,\n// including packages you don't have and when everything is current. The\n// first class message of a session runs it with \"auto\": silent unless\n// something here is out of date, and silent if the fetch fails.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.loom) client.loom.loom = {};\nvar luL = client.loom.loom;\nvar luManual = get_variable(\"loom_updates_mode\") !== \"auto\";\nvar luURL = \"https://raw.githubusercontent.com/neijel-achaea/loom/main/dist/versions.json\";\n\n// \"0.4.31\" < \"0.4.33\": compares each number in turn.\nluL.newer = (a, b) => {\n  var x = String(a || \"0\").split(\".\"), y = String(b || \"0\").split(\".\");\n  for (var i = 0; i < Math.max(x.length, y.length); i++) {\n    var p = Number(x[i] || 0), q = Number(y[i] || 0);\n    if (p != q) return p > q;\n  }\n  return false;\n};\n\nluL.report = (data, manual) => {\n  var latest = (data && data.packages) || {};\n  var reg = client.loom.registry;\n  // Installed now (the registry keeps uninstalled packages until a reload).\n  var inst = {};\n  (luL.installed ? luL.installed() : Object.keys(reg)).forEach((n) => { inst[n] = true; });\n  var old = [], ahead = [], missing = [];\n  Object.keys(latest).sort().forEach((n) => {\n    var have = inst[n] && reg[n] && reg[n].version;\n    if (!have) missing.push(n);\n    else if (luL.newer(latest[n], have)) old.push(n + \" \" + have + \" → \" + latest[n]);\n    else if (luL.newer(have, latest[n])) ahead.push(n + \" \" + have);\n  });\n  if (old.length) {\n    display_notice(\"[loom] \" + old.length + \" package\" + (old.length == 1 ? \"\" : \"s\") + \" out of date: \" + old.join(\", \") + \". Reimport from github.com/neijel-achaea/loom (dist/).\", \"orange\");\n  } else if (manual) {\n    display_notice(\"[loom] every package here is up to date.\", \"lime\");\n  }\n  if (manual && ahead.length) display_notice(\"[loom] newer than main (a branch build): \" + ahead.join(\", \") + \".\", \"cyan\");\n  if (manual && missing.length) display_notice(\"[loom] not installed here: \" + missing.join(\", \") + \".\", \"cyan\");\n  // Retired packages still installed: named when asked, not at login.\n  if (manual) (luL.retiredHere ? luL.retiredHere() : []).forEach((r) => {\n    display_notice(\"[loom] \" + r.name + \" is retired: uninstall it\" + (r.by ? \" (\" + r.by + \" replaces it)\" : \"\") + \".\", \"orange\");\n  });\n};\n\nif (luManual) display_notice(\"[loom] checking package versions...\", \"cyan\");\nfetch(luURL, { cache: \"no-store\" })\n  .then((r) => { if (!r.ok) throw new Error(\"HTTP \" + r.status); return r.json(); })\n  .then((data) => luL.report(data, luManual))\n  .catch((e) => { if (luManual || get_variable(\"debug\") == \"on\") display_notice(\"[loom] couldn't check versions: \" + e.message, \"orange\"); });\n"
  },
  {
   "type": "alias",
   "name": "",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "// LOOM [LIST|STATUS|HELP|UPDATES [AUTO on/off]|PAUSE on/off|DEBUG on/off|ROOM|LINKS|LINK <id> [on/off]|THEME [<city>|auto|off]|PERF [<seconds>|STOP|DATA]]\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nif (!client.loom.loom) client.loom.loom = {};\n\nvar raw = String(args[1] || \"\").trim();\nvar parts = raw.split(/\\s+/);\nvar sub = String(parts[0] || \"\").toLowerCase();\nvar val = String(parts[1] || \"\").toLowerCase();\nvar C = \"cyan\";\n\nif (sub === \"\" || sub === \"list\" || sub === \"status\") {\n  // The package list prints in a monospace block through\n  // nexusclient.add_html_line when this Nexus has it, so the columns line\n  // up; otherwise as plain notices.\n  var reg = client.loom.registry;\n  // Only what is really installed (a package uninstalled before #137 kept\n  // its registry entry until the next load), and retired ones named apart below.\n  var lpL = client.loom.loom || {};\n  var names = lpL.installed ? lpL.installed() : Object.keys(reg).sort();\n  var html = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\n  var esc = function (t) { return String(t).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); };\n  var rows = [];\n  display_notice(\"[loom] \" + names.length + \" package\" + (names.length == 1 ? \"\" : \"s\") + \" loaded\", C);\n  for (var i = 0; i < names.length; i++) {\n    var r = reg[names[i]] || {};\n    var label = (names[i] + \"                \").slice(0, 16);\n    var ver = \"v\" + (r.version || \"?\");\n    // The description, when the package has one, on its own dimmer line.\n    // (An unbuilt package would still hold the placeholder, \"{{\" then\n    // \"description\"; tested with a pattern so the build doesn't fill it in.)\n    var desc = (r.desc && !/^\\{\\{/.test(r.desc)) ? r.desc : \"\";\n    // Name and version, the description below. Indented with non-breaking\n    // spaces: Nexus trims ordinary spaces at the start of an HTML line.\n    if (html) {\n      rows.push('&nbsp;&nbsp;<span style=\"color:#00ffff\">' + esc(label) + '</span><span style=\"color:#9fc9c9\">' + esc(ver) + '</span>');\n      if (desc) rows.push('&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:#6f8f8f\">' + esc(desc) + '</span>');\n    } else {\n      display_notice(\"  \" + label + ver, C);\n      if (desc) display_notice(\"    \" + desc, \"#6f8f8f\");\n    }\n  }\n  if (html && rows.length) nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + rows.join(\"\\n\") + '</span>');\n  var lpOld = lpL.retiredHere ? lpL.retiredHere() : [];\n  for (var lpI = 0; lpI < lpOld.length; lpI++) {\n    display_notice(\"[loom] \" + lpOld[lpI].name + \" is retired: uninstall it\" + (lpOld[lpI].by ? \" (\" + lpOld[lpI].by + \" replaces it)\" : \"\") + \".\", \"orange\");\n  }\n  display_notice(\"[loom] pause \" + (get_variable(\"pauseTriggers\") || \"off\") + \", debug \" + (get_variable(\"debug\") || \"off\") + \". LOOM HELP for commands.\", C);\n} else if (sub === \"updates\") {\n  // LOOM UPDATES: check now. LOOM UPDATES AUTO ON|OFF: the check at login.\n  if (val === \"auto\") {\n    var luAuto = String(parts[2] || \"\").toLowerCase();\n    if (luAuto === \"on\" || luAuto === \"off\") set_variable(\"loom_autoupdates\", luAuto);\n    display_notice(\"[loom] version check at login is \" + (get_variable(\"loom_autoupdates\") || \"on\") + \".\", (luAuto === \"on\" || luAuto === \"off\") ? \"lime\" : C);\n  } else {\n    set_variable(\"loom_updates_mode\", \"manual\");\n    run_function(\"loom_updates\", [], \"loom\");\n  }\n} else if (sub === \"links\" || (sub === \"link\" && !val)) {\n  // LOOM LINKS: every integration, its state and what it does.\n  if (!client.loom.loom.addLink) run_function(\"loom_links\", [], \"loom\");\n  var LK = client.loom.loom;\n  var lkIds = LK.linkOrder || [];\n  if (!lkIds.length) {\n    display_notice(\"[loom] no integrations yet: they arrive with Loom 0.5 and are listed here as each one lands.\", C);\n  } else {\n    var lkHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\n    var lkEsc = function (t) { return String(t).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); };\n    var lkCol = { on: \"#7fe07f\", off: \"#ff9f43\", waiting: \"#6f8f8f\" };\n    var lkW = 0, lkN = { on: 0, off: 0, waiting: 0 };\n    for (var lkI = 0; lkI < lkIds.length; lkI++) if (lkIds[lkI].length > lkW) lkW = lkIds[lkI].length;\n    var lkPad = \"                                        \";\n    var lkRows = [];\n    for (var lkJ = 0; lkJ < lkIds.length; lkJ++) {\n      var lkId = lkIds[lkJ];\n      var lkE = LK.links[lkId];\n      var lkSt = LK.linkState(lkId);\n      lkN[lkSt]++;\n      var lkMiss = LK.linkMissing(lkId);\n      // The description, then why it's waiting when a package is missing.\n      var lkDesc = lkE.desc + (lkSt === \"waiting\" || (lkSt === \"off\" && lkMiss.length) ? \" (needs \" + lkMiss.join(\" and \") + \")\" : \"\");\n      var lkName = (lkId + lkPad).slice(0, lkW + 2);\n      var lkStw = (lkSt + lkPad).slice(0, 9);\n      if (lkHtml) {\n        lkRows.push('&nbsp;&nbsp;<span style=\"color:#00ffff\">' + lkEsc(lkName) + '</span><span style=\"color:' + lkCol[lkSt] + '\">' + lkEsc(lkStw) + '</span><span style=\"color:#9fc9c9\">' + lkEsc(lkDesc) + '</span>');\n      } else {\n        display_notice(\"  \" + lkName + lkStw + lkDesc, lkCol[lkSt]);\n      }\n    }\n    if (lkHtml) {\n      display_notice(\"[loom] integrations: \" + lkN.on + \" on, \" + lkN.off + \" off, \" + lkN.waiting + \" waiting for a package\", C);\n      nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + lkRows.join(\"\\n\") + '</span>');\n    }\n    display_notice(\"[loom] LOOM LINK <id> ON|OFF to switch one. New integrations start on.\", C);\n  }\n} else if (sub === \"link\") {\n  // LOOM LINK <id> [ON|OFF]: show or switch one integration.\n  if (!client.loom.loom.addLink) run_function(\"loom_links\", [], \"loom\");\n  var LN = client.loom.loom;\n  var lnTo = String(parts[2] || \"\").toLowerCase();\n  if (!LN.links[val]) {\n    display_notice(\"[loom] no integration '\" + val + \"'. LOOM LINKS lists them.\", \"orange\");\n  } else if (lnTo !== \"\" && lnTo !== \"on\" && lnTo !== \"off\") {\n    display_notice(\"[loom] usage: LOOM LINK \" + val + \" ON|OFF\", \"orange\");\n  } else {\n    if (lnTo) LN.setLink(val, lnTo === \"on\");\n    var lnSt = LN.linkState(val);\n    var lnMiss = LN.linkMissing(val);\n    var lnMsg = \"[loom] \" + val + \" is \" + (lnTo ? \"now \" : \"\") + (lnSt === \"waiting\" ? \"on\" : lnSt);\n    if (lnMiss.length) lnMsg += (lnSt === \"off\" ? \"\" : \", waiting for \") + (lnSt === \"off\" ? \" (and needs \" + lnMiss.join(\" and \") + \")\" : lnMiss.join(\" and \") + \" to be installed\");\n    display_notice(lnMsg + \".\", lnTo ? \"lime\" : C);\n  }\n} else if (sub === \"theme\") {\n  // LOOM THEME [<city>|AUTO|OFF]: the tabs' colours (#310).\n  if (!client.loom.loom.themeApply) run_function(\"loom_theme\", [], \"loom\");\n  var TM = client.loom.loom;\n  var tmCities = Object.keys(TM.themes).sort();\n  var tmCap = function (t) { return t.charAt(0).toUpperCase() + t.slice(1); };\n  var tmSay = function (changed) {\n    var ch = TM.themeChoice();\n    // The chosen theme, as it will be once PK MODE (if on) ends.\n    var pkOn = !!TM.themePk; TM.themePk = false;\n    var nm = TM.themeName();\n    TM.themePk = pkOn;\n    var city = String(get_variable(\"loom_city\") || \"\");\n    var msg;\n    if (ch === \"off\") msg = \"off: each tab keeps its own colours\";\n    else if (ch === \"auto\") msg = \"following your city: \" + (nm ? TM.themes[nm].label : (city === \"none\" ? \"you have no city, so each tab keeps its own colours\" : (city ? tmCap(city) + \" has no theme, so each tab keeps its own colours\" : \"no city seen yet (it comes at login), so each tab keeps its own colours\")));\n    else msg = TM.themes[nm].label;\n    display_notice(\"[loom] tab theme \" + (changed ? \"now \" : \"\") + msg + (pkOn ? \"; PK MODE's magenta shows until it's off\" : \"\") + \".\", changed ? \"lime\" : C);\n  };\n  if (val === \"\") {\n    tmSay(false);\n    display_notice(\"[loom] LOOM THEME \" + tmCities.map(function (c) { return c.toUpperCase(); }).join(\"|\") + \"|AUTO|OFF\", C);\n  } else if (val === \"auto\" || val === \"off\" || TM.themes[val]) {\n    if (val === \"auto\") delete_variable(\"loom_theme\"); else set_variable(\"loom_theme\", val);\n    TM.themeApply();\n    tmSay(true);\n  } else {\n    display_notice(\"[loom] no theme '\" + val + \"'. Themes: \" + tmCities.map(tmCap).join(\", \") + \", or AUTO or OFF.\", \"orange\");\n  }\n} else if (sub === \"help\") {\n  run_function(\"loom_help\", [], \"loom\");\n} else if (sub === \"pause\" || sub === \"debug\") {\n  var vname = (sub === \"pause\") ? \"pauseTriggers\" : \"debug\";\n  if (val === \"on\" || val === \"off\") {\n    set_variable(vname, val);\n    display_notice(\"[loom] \" + sub + \" \" + val, \"lime\");\n  } else {\n    display_notice(\"[loom] \" + sub + \" is \" + (get_variable(vname) || \"off\") + \". Use LOOM \" + sub.toUpperCase() + \" ON or OFF.\", C);\n  }\n} else if (sub === \"perf\") {\n  var PL = client.loom.loom;\n  if (!PL.perfStart) run_function(\"loom_perf\", [], \"loom\");\n  if (val === \"stop\") {\n    if (!PL.perfStop()) display_notice(\"[loom] no sample running. LOOM PERF [seconds] starts one.\", C);\n  } else if (val === \"data\") {\n    var pfRows = [];\n    PL.perfDataRows(pfRows);\n    if (pfRows.length) PL.perfPrint(\"[loom] PERF: saved data by package\", pfRows.slice(1));\n    else display_notice(\"[loom] this client doesn't show its variables, so there's nothing to size.\", \"orange\");\n  } else if (PL.perfState) {\n    var pfLeft = Math.max(0, Math.round(PL.perfState.secs - (Date.now() - PL.perfState.wall0) / 1000));\n    display_notice(\"[loom] a sample is running, \" + pfLeft + \" s left. LOOM PERF STOP ends it now.\", C);\n  } else if (val !== \"\" && !/^\\d+$/.test(val)) {\n    display_notice(\"[loom] usage: LOOM PERF [\" + PL.perfMin + \"-\" + PL.perfMax + \"] | STOP | DATA.\", \"orange\");\n  } else {\n    var pfSecs = val === \"\" ? PL.perfDefault : parseInt(val, 10);\n    if (pfSecs < PL.perfMin || pfSecs > PL.perfMax) {\n      display_notice(\"[loom] a sample lasts \" + PL.perfMin + \" to \" + PL.perfMax + \" seconds.\", \"orange\");\n    } else {\n      var pfRes = PL.perfStart(pfSecs);\n      if (pfRes === \"missing\") display_notice(\"[loom] this client doesn't run scripts the way LOOM PERF expects (no \" + PL.perfMissing().join(\", \") + \"), so it can't measure here.\", \"orange\");\n      else display_notice(\"[loom] measuring for \" + pfSecs + \" s: play as usual. The report prints when it ends (LOOM PERF STOP to end sooner).\", \"lime\");\n    }\n  }\n} else if (sub === \"room\") {\n  var rm = client.loom.loom.room;\n  if (rm) {\n    display_notice(\"[loom] room \" + rm.id + \": \" + rm.name + \" (\" + rm.area + \", \" + rm.environment + \")\", C);\n  } else {\n    display_notice(\"[loom] no room seen yet; move once and try again.\", \"orange\");\n  }\n} else {\n  display_notice(\"[loom] unknown command '\" + sub + \"'. LOOM HELP for commands.\", \"orange\");\n}\n"
    }
   ],
   "text": "^loom(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  },
