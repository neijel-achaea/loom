{
 "type": "group",
 "name": "dmgchart",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"dmgchart_setup\", [], \"dmgchart\");\nrun_function(\"dmgchart_render\", [], \"dmgchart\");\ndisplay_notice(\"[dmgchart] installed. Create a UI tab named 'DmgChart' for the charts. DMGCHART HELP for commands.\", \"lime\");\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"dmgchart_gmcp\", [], \"dmgchart\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; the dmgchart_* variables are left intact.\n// Leave LOOM and the integrations at once, not at the next load (#137):\n// loom takes the entry out and redraws the tabs that showed this package's answers.\nif (client.loom && client.loom.registry) {\n  if (typeof client.loom.gone == \"function\") client.loom.gone(\"dmgchart\");\n  else delete client.loom.registry.dmgchart;\n}\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"DmgChart\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 17 17\"><path d=\"M2 2 L11.5 11.5\" stroke=\"#eaa25c\" stroke-width=\"1.6\"/><path d=\"M15 2 L5.5 11.5\" stroke=\"#e0605a\" stroke-width=\"1.6\"/><path d=\"M10 13.5 L13.5 10 M3.5 10 L7 13.5\" stroke=\"#ecdfd9\" stroke-width=\"1.2\"/><path d=\"M12.5 12.5 L15 15 M4.5 12.5 L2 15\" stroke=\"#7a3f30\" stroke-width=\"1.8\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\n\nrun_function(\"dmgchart_setup\", [], \"dmgchart\");\nrun_function(\"dmgchart_render\", [], \"dmgchart\");\n// The two-line scripts' work (#136): made afresh, so a reimport replaces it.\nrun_function(\"dmgchart_gmcp\", [], \"dmgchart\");\n"
  },
  {
   "type": "function",
   "name": "dmgchart_gmcp",
   "enabled": true,
   "code": "// dmgchart_gmcp -- the work behind onGMCP, as a function made once per load\n// (client.loom.hooks.dmgchart.gmcp). Nexus compiles a script afresh every time it\n// runs, and long ones cost on every GMCP message, so the script itself stays two\n// lines and calls this (#136). Run from onLoad and onInstall, so a reimport\n// replaces it.\nif (!client.loom) client.loom = {};\nif (!client.loom.hooks) client.loom.hooks = {};\nif (!client.loom.hooks.dmgchart) client.loom.hooks.dmgchart = {};\nclient.loom.hooks.dmgchart.gmcp = function (args) {\n  // Current health from Char.Vitals, logged with its time for \"health lasts\" in\n  // the exchange: how fast health is really falling, whatever hit or healed it.\n  // While a fight is on (up to the gap after its last blow) every reading\n  // works health lasts out again (and the WARN notice, #93) and redraws the\n  // tab, so the figure follows sips and regeneration too.\n  var dcM = \"\";\n  var dcA = null;\n  try { dcM = args.gmcp_method; dcA = args.gmcp_args; } catch (e) { dcM = \"\"; }\n  if (dcM === \"Char.Vitals\" && dcA) {\n    if (typeof dcA === \"string\") { try { dcA = JSON.parse(dcA); } catch (e) { dcA = null; } }\n    if (dcA && dcA.hp !== undefined) {\n      if (!client.loom || !client.loom.dmgchart || !client.loom.dmgchart.saved) run_function(\"dmgchart_setup\", [], \"dmgchart\");\n      var DC = client.loom.dmgchart;\n      var dcHp = parseInt(dcA.hp, 10);\n      if (!isNaN(dcHp)) {\n        var dcNow = Date.now();\n        var dcChanged = dcHp !== DC.hp;\n        DC.hp = dcHp;\n        if (dcChanged || !DC.recent || !DC.recent.length) run_function(\"dmgchart_recent\", { t: dcNow, hp: dcHp }, \"dmgchart\");\n        if (DC.fight && dcNow - DC.fight.last <= DC.gap * 1000) {\n          run_function(\"dmgchart_lasts\", [], \"dmgchart\");\n          if (!DC.view) { if (DC.drawSoon) DC.drawSoon(); else run_function(\"dmgchart_render\", [], \"dmgchart\"); }\n        }\n      }\n    }\n  }\n};\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// onGMCP: the work is in dmgchart_gmcp (#136: this runs on every GMCP message, so it stays short).\nvar lkH = client.loom && client.loom.hooks && client.loom.hooks.dmgchart;\nif (!lkH || !lkH.gmcp) { run_function(\"dmgchart_gmcp\", [], \"dmgchart\"); lkH = client.loom.hooks.dmgchart; }\nlkH.gmcp(args);\n"
  },
  {
   "type": "function",
   "name": "dmgchart_setup",
   "enabled": true,
   "code": "// dmgchart_setup -- run from onLoad and onInstall, by DMGCHART REBUILD (which\n// empties the namespace first, as run_function cannot pass parameters), and\n// by any reflex that finds the namespace missing. Namespace, registry,\n// one-time migration of the dc_* variables and the old client.dc, then the\n// state, each part built if missing.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nclient.loom.registry.dmgchart = { version: \"0.4.0\", keyword: \"DMGCHART\", desc: \"Damage dealt and taken by type per fight, health lasts, recorded sessions\",\n  // Redrawn by loom when the tab theme changes (#310).\n  redraw: function () { run_function(\"dmgchart_render\", [], \"dmgchart\"); } };\nif (!client.loom.dmgchart) client.loom.dmgchart = {};\nvar DC = client.loom.dmgchart;\n// One draw per prompt in a fight: each damage line and the prompt's vitals\n// asked for one of their own (#136: twice a prompt, ~4 a second). They now\n// share a 50 ms timer, so a hit and the health that follows draw together.\nDC.drawSoon = function () {\n  clearTimeout(DC.drawT);\n  DC.drawT = setTimeout(function () { DC.drawT = null; run_function(\"dmgchart_render\", [], \"dmgchart\"); }, 50);\n};\n\n// One-time migration: dc_* -> dmgchart_*. A new variable that already holds\n// data wins; the old one is deleted either way.\nvar dcMoves = [[\"gap\", \"\"], [\"sessions\", \"[]\"], [\"open\", \"\"]];\nfor (var dcI = 0; dcI < dcMoves.length; dcI++) {\n  var dcOld;\n  try { dcOld = get_variable(\"dc_\" + dcMoves[dcI][0]); } catch (e) { dcOld = undefined; }\n  if (dcOld !== undefined && dcOld !== null) {\n    var dcNew;\n    try { dcNew = get_variable(\"dmgchart_\" + dcMoves[dcI][0]); } catch (e) { dcNew = undefined; }\n    if (dcNew === undefined || dcNew === null || dcNew === \"\" || dcNew === dcMoves[dcI][1]) set_variable(\"dmgchart_\" + dcMoves[dcI][0], dcOld);\n    delete_variable(\"dc_\" + dcMoves[dcI][0]);\n  }\n}\n\n// The old package kept everything in client.dc. On a reimport without a page\n// reload, the fight, open session, view and colours in memory carry over.\nif (client.dc) {\n  var dcCarry = [\"fight\", \"lastInc\", \"sess\", \"sessSaved\", \"view\", \"colors\", \"spareIdx\", \"hp\"];\n  for (var dcJ = 0; dcJ < dcCarry.length; dcJ++) {\n    if (DC[dcCarry[dcJ]] === undefined && client.dc[dcCarry[dcJ]] !== undefined) DC[dcCarry[dcJ]] = client.dc[dcCarry[dcJ]];\n  }\n  delete client.dc;\n}\n\nif (DC.gap === undefined) {\n  DC.gap = parseFloat(get_variable(\"dmgchart_gap\"));\n  if (isNaN(DC.gap) || DC.gap <= 0) DC.gap = 6;\n}\nif (DC.window === undefined) {\n  DC.window = parseFloat(get_variable(\"dmgchart_window\"));\n  if (isNaN(DC.window) || DC.window <= 0) DC.window = 6;\n}\n// DMGCHART WARN: seconds of health left that set off the notice (#93),\n// 0 when off. Saved as dmgchart_warn (\"off\" or the seconds).\nif (DC.warn === undefined) {\n  var dcWarn = String(get_variable(\"dmgchart_warn\") || \"\").trim().toLowerCase();\n  DC.warn = dcWarn == \"off\" ? 0 : parseFloat(dcWarn);\n  if (isNaN(DC.warn) || DC.warn < 0) DC.warn = 10;\n}\nif (DC.lasts === undefined) DC.lasts = null;\nif (!DC.recent) DC.recent = [];\nDC.tab = \"DmgChart\";\nif (!DC.colors) DC.colors = { \"cutting\": \"#d9534f\", \"blunt\": \"#b08968\", \"magical\": \"#9b6bd6\", \"unblockable\": \"#d8d8d8\", \"poison\": \"#6abf4b\", \"fire\": \"#f0883e\", \"cold\": \"#5bc0de\", \"electricity\": \"#f2d43d\", \"asphyxiation\": \"#7f8fa6\", \"psychic\": \"#e36bb8\", \"raw\": \"#8c8c8c\", \"bleed\": \"#8b1e2d\" };\nDC.spare = [\"#4fb0a5\", \"#c9a0dc\", \"#a3c45a\", \"#e0b070\", \"#6f8fd8\", \"#d97a9a\"];\nif (DC.spareIdx === undefined) DC.spareIdx = 0;\nif (DC.fight === undefined) DC.fight = null;\nif (DC.lastInc === undefined) DC.lastInc = null;\nDC.ev = null;\nif (DC.view === undefined) DC.view = \"\";\nif (!DC.saved) {\n  DC.saved = [];\n  try { var dcRaw = get_variable(\"dmgchart_sessions\"); if (dcRaw && String(dcRaw).length) DC.saved = JSON.parse(dcRaw) || []; } catch (e) { DC.saved = []; }\n}\nDC.nextId = 1;\nfor (var dcK = 0; dcK < DC.saved.length; dcK++) { if (DC.saved[dcK].id >= DC.nextId) DC.nextId = DC.saved[dcK].id + 1; }\nif (DC.sess === undefined) {\n  DC.sess = null;\n  try { var dcOpen = get_variable(\"dmgchart_open\"); if (dcOpen && String(dcOpen).length) DC.sess = JSON.parse(dcOpen); } catch (e) { DC.sess = null; }\n}\nif (DC.sessSaved === undefined) DC.sessSaved = 0;\n\n// The rolling record of fights for other packages (#59), in memory only:\n// one segment per fight, as the session counts them (a fight ends after\n// DMGCHART GAP seconds without a hit either way; bleeding is no hit).\n// seg = { start, last, ms (combat time), dmg (incoming), max (biggest\n// incoming hit) }. recFrom is when the record begins: this page load, or\n// the oldest segment kept once the cap trims it, so a question about\n// earlier than that gets no answer rather than a short one.\nif (!DC.rec) { DC.rec = []; DC.recFrom = Date.now(); }\nDC.recCap = 3000;\n\n// The read-only look other packages see through loom: never its variables.\n//   look.since(t) -> { dmg, combatMs, maxHit, fights } for the fights that\n//                    were still going at t or started after it (the fight\n//                    that brought t counts whole), or undefined when the\n//                    record doesn't reach back to t (a reload since).\nDC.look = {\n  since: function (t) {\n    t = Number(t);\n    if (!t || t < DC.recFrom) return undefined;\n    var out = { dmg: 0, combatMs: 0, maxHit: 0, fights: 0 };\n    for (var i = DC.rec.length - 1; i >= 0; i--) {\n      var g = DC.rec[i];\n      if (g.last < t - 2000) break;\n      out.dmg += g.dmg; out.combatMs += g.ms; out.fights++;\n      if (g.max > out.maxHit) out.maxHit = g.max;\n    }\n    return out;\n  }\n};\n"
  },
  {
   "type": "function",
   "name": "dmgchart_add",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.dmgchart || !client.loom.dmgchart.saved) run_function(\"dmgchart_setup\", [], \"dmgchart\");\n// Adds client.loom.dmgchart.ev ({dir, type, amt}) to the current fight and, if one is open, the session.\n// Incoming bleeding is passive: it counts in the totals but is not a hit, does\n// not keep a fight going and does not start one (#152). A tick after the gap\n// goes to the fight that just ended; with no fight at all, only to the session.\nvar d = client.loom.dmgchart;\nvar e = d.ev;\n// A crit on a hits.out object: cn crits, cdmg their damage, ct per tier\n// {n, dmg}. Saved sessions keep it with the hit counts (#185).\nfunction addCrit(h, c) {\n  h.cn = (h.cn || 0) + 1;\n  h.cdmg = (h.cdmg || 0) + c.amt;\n  if (!h.ct) h.ct = {};\n  if (!h.ct[c.tier]) h.ct[c.tier] = { n: 0, dmg: 0 };\n  h.ct[c.tier].n++;\n  h.ct[c.tier].dmg += c.amt;\n}\nif (e && !isNaN(e.amt)) {\n  var now = Date.now();\n  var gapMs = d.gap * 1000;\n  var passive = (e.dir == \"inc\" && e.type == \"bleed\");\n  // A crit line just before this outgoing hit makes it a crit (#185).\n  var crit = null;\n  if (e.dir == \"out\" && d.crit && now - d.crit.t < 1500) crit = { tier: d.crit.tier, amt: e.amt };\n  if (e.dir == \"out\") d.crit = null;\n  var f = d.fight;\n  var ss = d.sess;\n  // What this event changes, so trigger_bleed can take back a raw line that\n  // turns out to be bleeding (the game prints \"Health lost: N (raw).\" first).\n  var undo = { fight: f, opened: false, last: f ? f.last : 0, sLastT: ss ? ss.lastT : 0, sCombat: ss ? ss.combatMs : 0, sFights: ss ? ss.fights : 0 };\n  if (!passive && (!f || now - f.last > gapMs)) {\n    f = { start: now, last: now, inc: {}, out: {}, incTotal: 0, outTotal: 0 };\n    d.fight = f;\n    d.lastInc = null;\n    undo.opened = true;\n  }\n  if (f) {\n    f[e.dir][e.type] = (f[e.dir][e.type] || 0) + e.amt;\n    f[e.dir + \"Total\"] += e.amt;\n    if (!passive) {\n      // Hit counts and the biggest single hit, per direction, for the exchange stats.\n      if (!f.hits) { f.hits = { inc: { n: 0, max: 0 }, out: { n: 0, max: 0 } }; }\n      undo.max = f.hits[e.dir].max;\n      f.hits[e.dir].n++;\n      if (e.amt > f.hits[e.dir].max) { f.hits[e.dir].max = e.amt; }\n      if (crit) addCrit(f.hits.out, crit);\n      f.last = now;\n    }\n  }\n  // The rolling record (#59): fights as segments, combat time as the\n  // session counts it, incoming damage and the biggest incoming hit.\n  if (!passive && d.rec) {\n    var rg = d.rec.length ? d.rec[d.rec.length - 1] : null;\n    undo.rec = { opened: false, seg: rg, last: rg ? rg.last : 0, ms: rg ? rg.ms : 0, dmg: rg ? rg.dmg : 0, max: rg ? rg.max : 0 };\n    if (!rg || now - rg.last > gapMs) {\n      rg = { start: now, last: now, ms: 0, dmg: 0, max: 0 };\n      d.rec.push(rg);\n      undo.rec.opened = true;\n      undo.rec.seg = rg;\n      if (d.rec.length > d.recCap) { d.rec.splice(0, d.rec.length - d.recCap); d.recFrom = d.rec[0].start; }\n    } else {\n      rg.ms += now - rg.last;\n      rg.last = now;\n    }\n    if (e.dir == \"inc\") {\n      rg.dmg += e.amt;\n      if (e.amt > rg.max) rg.max = e.amt;\n    }\n  }\n  if (ss) {\n    if (!passive) {\n      if (ss.lastT && now - ss.lastT <= gapMs) { ss.combatMs += now - ss.lastT; } else { ss.fights++; }\n      ss.lastT = now;\n      if (!ss.hits) { ss.hits = { inc: { n: 0, max: 0 }, out: { n: 0, max: 0 } }; }\n      undo.sMax = ss.hits[e.dir].max;\n      ss.hits[e.dir].n++;\n      if (e.amt > ss.hits[e.dir].max) { ss.hits[e.dir].max = e.amt; }\n      if (crit) addCrit(ss.hits.out, crit);\n    }\n    ss[e.dir][e.type] = (ss[e.dir][e.type] || 0) + e.amt;\n    ss[e.dir + \"Total\"] += e.amt;\n    if (now - d.sessSaved > 5000) { set_variable(\"dmgchart_open\", JSON.stringify(ss)); d.sessSaved = now; }\n  }\n  if (e.dir == \"inc\") {\n    d.lastInc = { type: e.type, amt: e.amt, t: now, inSess: !!ss, undo: undo };\n    run_function(\"dmgchart_lasts\", [], \"dmgchart\");\n  }\n  if (d.drawSoon) d.drawSoon(); else run_function(\"dmgchart_render\", [], \"dmgchart\");\n}\nd.ev = null;\n"
  },
  {
   "type": "function",
   "name": "dmgchart_recent",
   "enabled": true,
   "code": "// dmgchart_recent -- args {t, hp}: one health reading from Char.Vitals in\n// client.loom.dmgchart.recent, for \"health lasts\" (how fast health is really\n// falling, #153). Readings older than two minutes are dropped, but the last\n// one before that is kept as the baseline for a window that reaches back past it.\nvar d = client.loom.dmgchart;\nif (!d.recent) d.recent = [];\nd.recent.push({ t: args.t, hp: args.hp });\nvar rcKeep = args.t - 120000;\nwhile (d.recent.length > 1 && d.recent[1].t < rcKeep) d.recent.shift();\n"
  },
  {
   "type": "function",
   "name": "dmgchart_lasts",
   "enabled": true,
   "code": "// dmgchart_lasts -- health lasts for the live fight, into\n// client.loom.dmgchart.lasts ({secs, drop, span, start}) or null, and the\n// DMGCHART WARN notice (#93). Run on every Char.Vitals reading during a\n// fight and after every hit taken, whatever the tab shows, so the warning\n// follows the live fight even while a recording is on screen.\n//\n// Health lasts is current health over how fast health really fell across\n// the last d.window seconds (or the fight so far), from the Char.Vitals\n// readings, so every hit and heal counts and nothing counts twice. Only while\n// health is falling, after a warm-up of 3s and 2 hits taken (#153).\n//\n// The warning fires once when the figure drops below d.warn seconds, and\n// re-arms once health would last half as much again as d.warn at the rate\n// that is falling now, or (when it isn't falling) at the rate that set the\n// warning off; so a sip that only pauses the fall doesn't warn again. A new\n// fight starts armed.\nvar d = client.loom.dmgchart;\nvar f = d.fight;\nd.lasts = null;\nif (f && f.incTotal > 0 && Date.now() - f.last <= d.gap * 1000) {\n  var hpNow = d.hp;\n  var wNow = Date.now();\n  var wFrom = Math.max(wNow - d.window * 1000, f.start);\n  var wSpan = (wNow - wFrom) / 1000;\n  var rc = d.recent || [];\n  var hpThen = null;\n  for (var ri = 0; ri < rc.length; ri++) {\n    if (rc[ri].t <= wFrom) { hpThen = rc[ri].hp; } else { if (hpThen === null) hpThen = rc[ri].hp; break; }\n  }\n  if (typeof hpNow === \"number\" && !isNaN(hpNow) && hpNow > 0 && hpThen !== null && wSpan >= 3 && f.hits && f.hits.inc.n >= 2 && hpThen > hpNow) {\n    var drop = (hpThen - hpNow) / wSpan;\n    d.lasts = { secs: hpNow / drop, drop: drop, span: wSpan, start: f.start };\n  }\n  if (d.warn > 0) {\n    if (d.lasts && d.lasts.secs < d.warn) {\n      if (!f.warned) {\n        f.warned = true;\n        f.warnDrop = d.lasts.drop;\n        var ls = d.lasts.secs;\n        display_notice(\"[dmgchart] health lasts ~\" + (ls < 10 ? ls.toFixed(1) : Math.round(ls)) + \"s (losing \" + Math.round(d.lasts.drop) + \"/s over the last \" + Math.round(d.lasts.span) + \"s)\", \"orange\");\n      }\n    } else if (f.warned) {\n      var reDrop = d.lasts ? d.lasts.drop : f.warnDrop;\n      if (typeof hpNow === \"number\" && hpNow / reDrop > d.warn * 1.5) f.warned = false;\n    }\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "dmgchart_render",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.dmgchart || !client.loom.dmgchart.saved) run_function(\"dmgchart_setup\", [], \"dmgchart\");\n// dmgchart_render -- paints the DmgChart tab in the house style shared with Coffers, Level,\n// Ledger and Fishing: ink panel, serif small-caps headings, the two dps\n// figures set large, donuts for the chosen source, then the session list.\n// Accents are ember for damage dealt and crimson for damage taken.\nvar d = client.loom.dmgchart;\n// Tab theme (#310): loom's city palette when one is on, else this tab's own colours.\nvar TH = (client.loom && client.loom.theme) || {};\nvar EMBER = \"#eaa25c\";\nvar CRIMSON = \"#e0605a\";\nvar DEEP = TH.deep || \"#7a3f30\";\nvar TXT = TH.txt || \"#ecdfd9\";\nvar MUTED = TH.muted || \"#90807a\";\nvar RULE = TH.rule || \"#33231f\";\nvar BG = TH.bg || \"#150f0d\";\nvar SEL = TH.sel || \"#2a1a16\";\nvar HI = TH.hi || \"#ffffff\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\n\nfunction esc(t) { return String(t).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\nfunction p2(n) { return (\"0\" + n).slice(-2); }\nfunction hm(dt) { return p2(dt.getHours()) + \":\" + p2(dt.getMinutes()); }\nfunction md(dt) { return dt.getDate() + \"/\" + (dt.getMonth() + 1); }\nfunction secs(s) {\n  if (s < 60) { return (s < 10 ? s.toFixed(1) : Math.round(s)) + \"s\"; }\n  if (s < 3600) { return Math.floor(s / 60) + \"m \" + p2(Math.round(s % 60)) + \"s\"; }\n  return Math.floor(s / 3600) + \"h \" + Math.round((s % 3600) / 60) + \"m\";\n}\nfunction caps(t, col) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (col || DEEP) + ';font-size:11px;margin:0 0 3px;\">' + t + '</div>'; }\nfunction section(title, inner) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title, EMBER) + inner + '</div>'; }\n// One exchange row: a label, then the dealt and taken figures in their accents.\nfunction xline(label, text, c) {\n  return '<div style=\"display:flex;justify-content:space-between;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"color:' + MUTED + ';\">' + label + '</span><span style=\"color:' + c + ';\">' + text + '</span></div>';\n}\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">' + t + '</div>'; }\nvar REC = '<span style=\"color:' + CRIMSON + ';\">&#9679;</span>';\n\n// Pick the source: an open session, a saved one, or the live fight.\nvar src = null;\nvar label = \"\";\nvar sub = \"\";\nvar dt = null;\nif (d.view == \"session\" && d.sess) {\n  src = d.sess;\n  dt = new Date(d.sess.start);\n  label = REC + \" recording\";\n  sub = '<span style=\"font-family:' + SERIF + ';color:' + TXT + ';\">&ldquo;' + esc(d.sess.name) + '&rdquo;</span> since ' + hm(dt) + ' &middot; ' + d.sess.fights + ' fights &middot; ' + secs(d.sess.combatMs / 1000) + ' in combat';\n  src.dur = Math.max(1, d.sess.combatMs / 1000);\n} else if (d.view && d.view != \"session\") {\n  for (var q = 0; q < d.saved.length; q++) { if (String(d.saved[q].id) == String(d.view)) { src = d.saved[q]; } }\n  if (src) {\n    dt = new Date(src.start);\n    label = \"session #\" + src.id;\n    sub = '<span style=\"font-family:' + SERIF + ';color:' + TXT + ';\">&ldquo;' + esc(src.name) + '&rdquo;</span> ' + md(dt) + ' ' + hm(dt) + ' &middot; ' + src.fights + ' fights &middot; ' + secs(src.combatMs / 1000) + ' in combat';\n    src.dur = Math.max(1, src.combatMs / 1000);\n  }\n}\nif (!src && d.fight) {\n  src = d.fight;\n  dt = new Date(src.start);\n  src.dur = Math.max(1, (src.last - src.start) / 1000);\n  label = \"live fight\";\n  sub = 'fight from ' + hm(dt) + ':' + p2(dt.getSeconds()) + ' &middot; ' + secs(src.dur) + ' <span style=\"font-style:italic;font-family:' + SERIF + ';\">(a new one after ' + d.gap + 's quiet)</span>';\n  if (d.sess) { sub += '<br>' + REC + ' recording <span style=\"font-family:' + SERIF + ';color:' + TXT + ';\">&ldquo;' + esc(d.sess.name) + '&rdquo;</span>'; }\n}\n\n// Crossed blades for the title, the damage tab's counterpart of the coin stack.\nvar glyph = '<svg width=\"17\" height=\"17\" viewBox=\"0 0 17 17\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<path d=\"M2 2 L11.5 11.5\" stroke=\"' + EMBER + '\" stroke-width=\"1.6\"/><path d=\"M15 2 L5.5 11.5\" stroke=\"' + CRIMSON + '\" stroke-width=\"1.6\"/>' +\n  '<path d=\"M10 13.5 L13.5 10 M3.5 10 L7 13.5\" stroke=\"' + TXT + '\" stroke-width=\"1.2\"/>' +\n  '<path d=\"M12.5 12.5 L15 15 M4.5 12.5 L2 15\" stroke=\"' + DEEP + '\" stroke-width=\"1.8\"/></svg>';\n\nvar html = '<div id=\"loom-dmgchart\" style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:' + BG + ';border:1px solid ' + RULE + ';padding:7px 8px 8px;min-height:100%;box-sizing:border-box;\">';\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\nhtml += '<div style=\"font-family:' + SERIF + ';color:' + EMBER + ';font-size:14px;letter-spacing:0.22em;\">' + glyph + 'DAMAGE</div>';\nhtml += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + MUTED + ';font-size:11px;\">' + (label || (d.sess ? REC + ' recording' : 'waiting')) + '</div></div>';\n\nif (!src) {\n  html += '<div style=\"margin-top:8px;\">' + quiet(\"No damage recorded yet. A new fight starts after \" + d.gap + \"s without damage in either direction.\") + '</div>';\n  if (d.sess) { html += '<div style=\"color:' + MUTED + ';margin-top:3px;\">' + REC + ' recording &ldquo;' + esc(d.sess.name) + '&rdquo;</div>'; }\n} else {\n  var dur = src.dur;\n  // The dealt and taken rates sit inside the donuts; above them, only what\n  // the tab is showing.\n  html += '<div style=\"color:' + MUTED + ';margin-top:5px;\">' + sub + '</div>';\n\n  html += '<div style=\"display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;\">';\n  var dirs = [\"out\", \"inc\"];\n  var titles = { out: \"Dealt\", inc: \"Taken\" };\n  var accents = { out: EMBER, inc: CRIMSON };\n  var R = 45;\n  var C = 2 * Math.PI * R;\n  for (var di = 0; di < dirs.length; di++) {\n    var dir = dirs[di];\n    var acc = accents[dir];\n    var bucket = src[dir];\n    var total = src[dir + \"Total\"];\n    var rows = [];\n    for (var k in bucket) {\n      if (bucket.hasOwnProperty(k)) {\n        var r = { type: k, amt: bucket[k] };\n        var i = rows.length;\n        while (i > 0 && rows[i - 1].amt < r.amt) { rows[i] = rows[i - 1]; i--; }\n        rows[i] = r;\n        if (!d.colors[k]) { d.colors[k] = d.spare[d.spareIdx % d.spare.length]; d.spareIdx++; }\n      }\n    }\n    var col = '<div style=\"flex:1 1 200px;min-width:200px;border-top:2px solid ' + acc + ';padding:3px 2px 0;\">';\n    col += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;\">' + caps(titles[dir], acc) + '<span style=\"color:' + MUTED + ';\">' + total + ' total</span></div>';\n    col += '<svg viewBox=\"0 0 120 120\" width=\"140\" height=\"140\" style=\"display:block;margin:4px auto 6px;\">';\n    col += '<circle cx=\"60\" cy=\"60\" r=\"' + R + '\" fill=\"none\" stroke=\"' + RULE + '\" stroke-width=\"16\"/>';\n    var off = 0;\n    for (var s = 0; s < rows.length; s++) {\n      var len = total > 0 ? C * rows[s].amt / total : 0;\n      col += '<circle cx=\"60\" cy=\"60\" r=\"' + R + '\" fill=\"none\" stroke=\"' + d.colors[rows[s].type] + '\" stroke-width=\"16\" stroke-dasharray=\"' + len.toFixed(3) + ' ' + (C - len).toFixed(3) + '\" stroke-dashoffset=\"' + (-off).toFixed(3) + '\" transform=\"rotate(-90 60 60)\"/>';\n      off += len;\n    }\n    col += '<text x=\"60\" y=\"60\" text-anchor=\"middle\" font-family=\"' + SERIF + '\" font-size=\"20\" fill=\"' + acc + '\">' + Math.round(total / dur) + '</text>';\n    col += '<text x=\"60\" y=\"75\" text-anchor=\"middle\" font-family=\"' + SERIF + '\" font-style=\"italic\" font-size=\"9\" fill=\"' + MUTED + '\">per second</text>';\n    col += '</svg>';\n    if (rows.length == 0) {\n      col += quiet(\"none\");\n    } else {\n      for (var t = 0; t < rows.length; t++) {\n        var row = rows[t];\n        col += '<div style=\"display:flex;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\">';\n        col += '<span style=\"flex:1 1 auto;white-space:nowrap;\"><span style=\"display:inline-block;width:8px;height:8px;background:' + d.colors[row.type] + ';margin-right:4px;\"></span>' + esc(row.type) + '</span>';\n        col += '<span style=\"min-width:3.5em;text-align:right;\">' + row.amt + '</span>';\n        col += '<span style=\"min-width:3.5em;text-align:right;color:' + MUTED + ';\">' + (100 * row.amt / total).toFixed(1) + '%</span>';\n        col += '<span style=\"min-width:3.5em;text-align:right;color:' + acc + ';\">' + Math.round(row.amt / dur) + '/s</span></div>';\n      }\n    }\n    html += col + '</div>';\n  }\n  html += '</div>';\n\n  // The exchange: your hits, split into normal hits and each crit tier\n  // (#185), with their count, share of all your hits and average. The four\n  // usual tiers always have a row; the two rarest only once reached. Then\n  // your biggest hit and hits a minute. Incoming is in the donut above.\n  // Hit counts were added after the first sessions were saved, so those\n  // show no exchange rows.\n  var H = src.hits || null;\n  var ex = \"\";\n  if (H && H.out.n > 0) {\n    var crOrder = [[\"CRITICAL\", \"critical hits\"], [\"CRUSHING\", \"crushing hits\"], [\"OBLITERATING\", \"obliterating hits\"], [\"ANNIHILATINGLY POWERFUL\", \"annihilatingly powerful hits\"], [\"WORLD-SHATTERING\", \"world-shattering hits\"], [\"PLANE-RAZING\", \"plane-razing hits\"]];\n    var crT = H.out.ct || {};\n    var crN = H.out.cn || 0;\n    var crD = H.out.cdmg || 0;\n    function hrow(label, n, dmg, c) {\n      return '<div style=\"display:flex;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"flex:1 1 auto;color:' + (n > 0 ? c : MUTED) + ';\">' + label + '</span><span style=\"min-width:4em;text-align:right;color:' + (n > 0 ? TXT : MUTED) + ';\">' + n + '</span><span style=\"min-width:4em;text-align:right;color:' + MUTED + ';\">' + Math.round(100 * n / H.out.n) + '%</span><span style=\"min-width:5em;text-align:right;color:' + (n > 0 ? EMBER : MUTED) + ';\">' + (n > 0 ? Math.round(dmg / n) : \"&mdash;\") + '</span></div>';\n    }\n    ex += '<div style=\"display:flex;gap:6px;color:' + MUTED + ';border-bottom:1px solid ' + RULE + ';padding-bottom:1px;\"><span style=\"flex:1 1 auto;\"></span><span style=\"min-width:4em;text-align:right;\">hits</span><span style=\"min-width:4em;text-align:right;\">share</span><span style=\"min-width:5em;text-align:right;\">average</span></div>';\n    ex += hrow(\"hits\", H.out.n - crN, src.outTotal - crD, TXT);\n    for (var crI = 0; crI < crOrder.length; crI++) {\n      var crE = crT[crOrder[crI][0]];\n      var crCn = crE ? (typeof crE === \"number\" ? crE : crE.n) : 0;\n      var crCd = crE && typeof crE === \"object\" ? crE.dmg : 0;\n      if (crI < 4 || crCn > 0) ex += hrow(crOrder[crI][1], crCn, crCd, EMBER);\n    }\n    ex += xline(\"biggest hit\", H.out.max, TXT);\n    ex += xline(\"hits a minute\", Math.round(H.out.n / (dur / 60)), TXT);\n  }\n  // Health lasts, for the live fight only, as dmgchart_lasts worked it out\n  // (#153, #93): absent while health isn't falling.\n  var LA = d.lasts;\n  if (!d.view && LA && LA.start == src.start && Date.now() - src.last <= d.gap * 1000) {\n    ex += xline(\"health lasts\", \"~\" + secs(LA.secs) + \" (losing \" + Math.round(LA.drop) + \"/s over the last \" + Math.round(LA.span) + \"s)\", LA.secs < 10 ? CRIMSON : (LA.secs < 30 ? \"#e6c25a\" : MUTED));\n  }\n  if (ex) { html += section(\"The exchange\", ex); }\n}\n\nif (d.saved.length) {\n  var list = '<div style=\"display:flex;gap:6px;color:' + MUTED + ';border-bottom:1px solid ' + RULE + ';padding-bottom:1px;\">';\n  list += '<span style=\"min-width:2.2em;\">#</span><span style=\"flex:1 1 auto;\">name</span><span style=\"min-width:6.5em;\">when</span><span style=\"min-width:3em;text-align:right;\">fights</span><span style=\"min-width:3.5em;text-align:right;\">combat</span><span style=\"min-width:3em;text-align:right;\">dealt</span><span style=\"min-width:3em;text-align:right;\">taken</span></div>';\n  var shown = 0;\n  for (var w = d.saved.length - 1; w >= 0 && shown < 10; w--) {\n    var sv = d.saved[w];\n    var sd = new Date(sv.start);\n    var sdur = Math.max(1, sv.combatMs / 1000);\n    var sel = String(d.view) == String(sv.id);\n    list += '<div style=\"display:flex;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;' + (sel ? 'background:' + SEL + ';' : '') + '\">';\n    list += '<span style=\"min-width:2.2em;color:' + DEEP + ';\">' + sv.id + '</span>';\n    list += '<span style=\"flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:' + (sel ? HI : TXT) + ';\">' + esc(sv.name) + '</span>';\n    list += '<span style=\"min-width:6.5em;color:' + MUTED + ';\">' + md(sd) + ' ' + hm(sd) + '</span>';\n    list += '<span style=\"min-width:3em;text-align:right;\">' + sv.fights + '</span>';\n    list += '<span style=\"min-width:3.5em;text-align:right;\">' + Math.round(sdur / 60) + 'm</span>';\n    list += '<span style=\"min-width:3em;text-align:right;color:' + EMBER + ';\">' + Math.round(sv.outTotal / sdur) + '</span>';\n    list += '<span style=\"min-width:3em;text-align:right;color:' + CRIMSON + ';\">' + Math.round(sv.incTotal / sdur) + '</span></div>';\n    shown++;\n  }\n  html += section(\"Saved sessions\", list);\n}\nif (d.view) { html += '<div style=\"color:' + MUTED + ';margin-top:6px;font-family:' + SERIF + ';font-style:italic;\">DMGCHART LIVE returns to the live fight.</div>'; }\nhtml += '</div>';\n// The whole tab in the panel's colour (#355), as Self and Comms do: the\n// panel fills the tab, and the tab itself takes the colour while it resizes.\ntry {\n  var dcSt = document.getElementById(\"loom-dmgchart-style\");\n  if (!dcSt) { dcSt = document.createElement(\"style\"); dcSt.id = \"loom-dmgchart-style\"; document.head.appendChild(dcSt); }\n  var dcCss = '.flexlayout__tab:has(#loom-dmgchart) { background: ' + BG + ' !important; } .flexlayout__tab:has(#loom-dmgchart) > * { min-height: 100%; }';\n  if (dcSt.textContent !== dcCss) dcSt.textContent = dcCss;\n} catch (e) {}\ntry { set_custom_tab_html(d.tab, html); } catch (err) {}"
  },
  {
   "type": "function",
   "name": "dmgchart_help",
   "enabled": true,
   "code": "// dmgchart_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[dmgchart] damage dealt and taken by type, per fight and per recorded session. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"DMGCHART\", \"the fight in the tab, any recording, gap and saved sessions\"],\n  [\"DMGCHART START [name]\", \"start recording a session\"],\n  [\"DMGCHART END\", \"stop recording and save the session\"],\n  [\"DMGCHART SHOW [#]\", \"show the recording, or saved session #, in the tab\"],\n  [\"DMGCHART LIVE\", \"back to the live fight\"],\n  [\"DMGCHART LIST\", \"the saved sessions\"],\n  [\"DMGCHART DEL <#>\", \"delete saved session #\"],\n  [\"DMGCHART GAP <seconds>\", \"quiet time that ends a fight (default 6; bleeding doesn't count)\"],\n  [\"DMGCHART WINDOW <seconds>\", \"how far back health lasts looks (default 6)\"],\n  [\"DMGCHART WARN [<seconds>|OFF]\", \"warn in the main window when health lasts drops below this (default 10)\"],\n  [\"DMGCHART RESET\", \"clear the live fight and rebuild from the saved variables (a recording carries on)\"],\n  [\"DMGCHART WIPE CONFIRM\", \"delete all saved sessions\"],\n  [\"DMGCHART DEBUG\", \"internal state\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "trigger",
   "name": "dmgchart crit",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.dmgchart || !client.loom.dmgchart.saved) run_function(\"dmgchart_setup\", [], \"dmgchart\");\n// \"You have scored a CRUSHING CRITICAL hit!\" comes right before the Damage\n// dealt line it belongs to; dmgchart_add counts that hit as a crit (#185).\n// Anchored on \"You have scored\", so other people's crits never match.\nvar crTier = String(args[1] || \"\").trim();\nclient.loom.dmgchart.crit = { tier: crTier.length ? crTier : \"CRITICAL\", t: Date.now() };\n"
    }
   ],
   "text": "^You have scored an? (.*?) ?CRITICAL hit!$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "dmgchart outgoing",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.dmgchart || !client.loom.dmgchart.saved) run_function(\"dmgchart_setup\", [], \"dmgchart\");\nclient.loom.dmgchart.ev = { dir: \"out\", type: String(args[2]).replace(\"physical \", \"\"), amt: parseInt(args[1], 10) };\nrun_function(\"dmgchart_add\", [], \"dmgchart\");\n"
    }
   ],
   "text": "^Damage dealt: (\\d+) \\(([^)]+)\\)\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "dmgchart incoming",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.dmgchart || !client.loom.dmgchart.saved) run_function(\"dmgchart_setup\", [], \"dmgchart\");\nclient.loom.dmgchart.ev = { dir: \"inc\", type: String(args[2]).replace(\"physical \", \"\"), amt: parseInt(args[1], 10) };\nrun_function(\"dmgchart_add\", [], \"dmgchart\");\n"
    }
   ],
   "text": "^Health lost: (\\d+) \\(([^)]+)\\)\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "dmgchart bleed",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.dmgchart || !client.loom.dmgchart.saved) run_function(\"dmgchart_setup\", [], \"dmgchart\");\n// Bleeding arrives as \"Health lost: N (raw).\" then \"You bleed N health.\"\n// If that raw line was just recorded, take it back (amount, hit, fight time,\n// and the fight it opened, if any), then record the amount as passive bleeding,\n// which counts but doesn't keep a fight going (#152).\nvar amt = parseInt(args[1], 10);\nvar d = client.loom.dmgchart;\nvar li = d.lastInc;\nif (li && li.type == \"raw\" && li.amt == amt && li.undo && Date.now() - li.t < 1500) {\n  var u = li.undo;\n  var f = d.fight;\n  if (f && (f.inc.raw || 0) >= amt) {\n    f.inc.raw -= amt;\n    if (f.inc.raw <= 0) { delete f.inc.raw; }\n    f.incTotal -= amt;\n    if (f.hits) { f.hits.inc.n--; f.hits.inc.max = u.max || 0; }\n    if (u.opened) { d.fight = u.fight; } else { f.last = u.last; }\n  }\n  // The rolling record (#59): the raw line came off it too.\n  var ur = u.rec;\n  if (ur && d.rec && ur.seg && d.rec[d.rec.length - 1] === ur.seg) {\n    if (ur.opened) { d.rec.pop(); }\n    else { ur.seg.last = ur.last; ur.seg.ms = ur.ms; ur.seg.dmg = ur.dmg; ur.seg.max = ur.max; }\n  }\n  var ss = d.sess;\n  if (li.inSess && ss && (ss.inc.raw || 0) >= amt) {\n    ss.inc.raw -= amt;\n    if (ss.inc.raw <= 0) { delete ss.inc.raw; }\n    ss.incTotal -= amt;\n    if (ss.hits) { ss.hits.inc.n--; ss.hits.inc.max = u.sMax || 0; }\n    ss.lastT = u.sLastT;\n    ss.combatMs = u.sCombat;\n    ss.fights = u.sFights;\n  }\n}\nd.ev = { dir: \"inc\", type: \"bleed\", amt: amt };\nrun_function(\"dmgchart_add\", [], \"dmgchart\");\n"
    }
   ],
   "text": "^You bleed (\\d+) health\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "alias",
   "name": "dmgchart",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.dmgchart || !client.loom.dmgchart.saved) run_function(\"dmgchart_setup\", [], \"dmgchart\");\n// DMGCHART [subcommand ...]: the one command for this package.\nvar dcRaw = String(args[1] || \"\").trim();\nvar dcSp = dcRaw.search(/\\s/);\nvar sub = (dcSp < 0 ? dcRaw : dcRaw.slice(0, dcSp)).toLowerCase();\nvar rest = dcSp < 0 ? \"\" : dcRaw.slice(dcSp + 1).trim();\nvar d = client.loom.dmgchart;\n// Session numbers may be typed as 3 or #3.\nvar restId = rest.replace(/^#/, \"\");\nif (sub == \"show\" || sub == \"del\") rest = restId;\nif (sub == \"gap\") {\n  var g = parseFloat(rest);\n  if (isNaN(g) || g <= 0) {\n    display_notice(\"[dmgchart] usage: DMGCHART GAP <seconds>  (currently \" + d.gap + \"s)\", \"orange\");\n  } else {\n    d.gap = g;\n    set_variable(\"dmgchart_gap\", String(g));\n    display_notice(\"[dmgchart] fight gap set to \" + g + \"s\", \"lime\");\n  }\n} else if (sub == \"window\") {\n  var w = parseFloat(rest);\n  if (isNaN(w) || w <= 0 || w > 120) {\n    display_notice(\"[dmgchart] usage: DMGCHART WINDOW <seconds>, 1 to 120  (currently \" + d.window + \"s)\", \"orange\");\n  } else {\n    d.window = w;\n    set_variable(\"dmgchart_window\", String(w));\n    display_notice(\"[dmgchart] health lasts now uses the last \" + w + \"s of the fight\", \"lime\");\n  }\n} else if (sub == \"warn\") {\n  // DMGCHART WARN [<seconds> | OFF] (#93): the notice when health lasts drops\n  // below the threshold.\n  var wa = rest.toLowerCase();\n  if (wa == \"\") {\n    display_notice(\"[dmgchart] \" + (d.warn > 0 ? \"warns when health lasts drops below \" + d.warn + \"s\" : \"health lasts warning is off\") + \". DMGCHART WARN <seconds> or WARN OFF to change it.\", \"cyan\");\n  } else if (wa == \"off\") {\n    d.warn = 0;\n    set_variable(\"dmgchart_warn\", \"off\");\n    display_notice(\"[dmgchart] health lasts warning off\", \"lime\");\n  } else {\n    var wv = parseFloat(wa);\n    if (isNaN(wv) || wv <= 0 || wv > 120) {\n      display_notice(\"[dmgchart] usage: DMGCHART WARN <seconds>, 1 to 120, or WARN OFF  (currently \" + (d.warn > 0 ? d.warn + \"s\" : \"off\") + \")\", \"orange\");\n    } else {\n      d.warn = wv;\n      set_variable(\"dmgchart_warn\", String(wv));\n      if (d.fight) d.fight.warned = false;\n      display_notice(\"[dmgchart] warns when health lasts drops below \" + wv + \"s\", \"lime\");\n    }\n  }\n} else if (sub == \"reset\" || sub == \"rebuild\") {\n  // DMGCHART RESET (#137): clears the live fight and rebuilds the namespace\n  // from the saved variables; REBUILD, its old name, works until Loom 1.1.\n  // A recording in progress is saved first, so it resumes where it was.\n  if (sub == \"rebuild\") display_notice(\"[dmgchart] DMGCHART REBUILD is now DMGCHART RESET.\", \"orange\");\n  // The damage record other packages read (huntstats) is kept too.\n  if (d.sess) { set_variable(\"dmgchart_open\", JSON.stringify(d.sess)); }\n  client.loom.dmgchart = { hp: d.hp, rec: d.rec, recFrom: d.recFrom };\n  run_function(\"dmgchart_setup\", [], \"dmgchart\");\n  d = client.loom.dmgchart;\n  display_notice(\"[dmgchart] reset: live fight cleared, rebuilt from the saved variables (gap \" + d.gap + \"s, window \" + d.window + \"s\" + (d.sess ? \", recording '\" + d.sess.name + \"' carries on\" : \"\") + \")\", \"lime\");\n} else if (sub == \"start\") {\n  if (d.sess) {\n    display_notice(\"[dmgchart] session '\" + d.sess.name + \"' is already recording. DMGCHART END first.\", \"orange\");\n  } else {\n    d.sess = { name: rest || (\"session \" + d.nextId), start: Date.now(), lastT: 0, combatMs: 0, fights: 0, inc: {}, out: {}, incTotal: 0, outTotal: 0 };\n    set_variable(\"dmgchart_open\", JSON.stringify(d.sess));\n    d.sessSaved = Date.now();\n    display_notice(\"[dmgchart] recording session '\" + d.sess.name + \"'. DMGCHART END to save it.\", \"lime\");\n  }\n} else if (sub == \"end\") {\n  if (!d.sess) {\n    display_notice(\"[dmgchart] no session is recording. DMGCHART START [name] to begin one.\", \"orange\");\n  } else {\n    var ss = d.sess;\n    if (ss.fights == 0) {\n      display_notice(\"[dmgchart] session '\" + ss.name + \"' had no damage; discarded.\", \"orange\");\n    } else {\n      var rec = { id: d.nextId, name: ss.name, start: ss.start, end: Date.now(), combatMs: ss.combatMs, fights: ss.fights, inc: ss.inc, out: ss.out, incTotal: ss.incTotal, outTotal: ss.outTotal, hits: ss.hits || null };\n      d.nextId++;\n      d.saved.push(rec);\n      while (d.saved.length > 50) { d.saved.shift(); }\n      set_variable(\"dmgchart_sessions\", JSON.stringify(d.saved));\n      var cs = Math.max(1, rec.combatMs / 1000);\n      display_notice(\"[dmgchart] saved session #\" + rec.id + \" '\" + rec.name + \"': \" + rec.fights + \" fights, \" + Math.round(cs) + \"s in combat, out \" + Math.round(rec.outTotal / cs) + \" dps, in \" + Math.round(rec.incTotal / cs) + \" dps\", \"lime\");\n    }\n    d.sess = null;\n    set_variable(\"dmgchart_open\", \"\");\n    if (d.view == \"session\") { d.view = \"\"; }\n  }\n} else if (sub == \"show\") {\n  if (rest == \"\") {\n    if (d.sess) { d.view = \"session\"; } else { display_notice(\"[dmgchart] no session recording. DMGCHART SHOW <#> for a saved one.\", \"orange\"); }\n  } else {\n    var found = false;\n    for (var q = 0; q < d.saved.length; q++) { if (String(d.saved[q].id) == rest) { found = true; } }\n    if (found) { d.view = rest; } else { display_notice(\"[dmgchart] no saved session #\" + rest, \"orange\"); }\n  }\n} else if (sub == \"live\") {\n  d.view = \"\";\n} else if (sub == \"del\") {\n  var kept = [];\n  for (var x = 0; x < d.saved.length; x++) { if (String(d.saved[x].id) != rest) { kept.push(d.saved[x]); } }\n  if (kept.length == d.saved.length) {\n    display_notice(\"[dmgchart] no saved session #\" + rest, \"orange\");\n  } else {\n    d.saved = kept;\n    set_variable(\"dmgchart_sessions\", JSON.stringify(d.saved));\n    if (String(d.view) == rest) { d.view = \"\"; }\n    display_notice(\"[dmgchart] deleted session #\" + rest, \"orange\");\n  }\n} else if (sub == \"wipe\") {\n  if (rest.toLowerCase() == \"confirm\") {\n    d.saved = [];\n    set_variable(\"dmgchart_sessions\", \"[]\");\n    if (d.view != \"session\") { d.view = \"\"; }\n    display_notice(\"[dmgchart] all saved sessions wiped\", \"orange\");\n  } else {\n    display_notice(\"[dmgchart] this deletes ALL saved sessions. DMGCHART WIPE CONFIRM to proceed.\", \"orange\");\n  }\n} else if (sub == \"\" || sub == \"status\") {\n  var dcF = d.fight;\n  var dcLine = \"gap \" + d.gap + \"s, health lasts over the last \" + d.window + \"s, \" + (d.warn > 0 ? \"warning below \" + d.warn + \"s\" : \"warning off\") + \", \" + d.saved.length + \" saved session\" + (d.saved.length == 1 ? \"\" : \"s\");\n  if (d.sess) dcLine += \", recording '\" + d.sess.name + \"' (\" + d.sess.fights + \" fights so far)\";\n  display_notice(\"[dmgchart] \" + dcLine + \".\", \"cyan\");\n  if (dcF) {\n    var dcDur = Math.max(1, (dcF.last - dcF.start) / 1000);\n    var dcAgo = Math.round((Date.now() - dcF.last) / 1000);\n    display_notice(\"[dmgchart] last fight: \" + Math.round(dcDur) + \"s, dealt \" + dcF.outTotal + \" (\" + Math.round(dcF.outTotal / dcDur) + \"/s), taken \" + dcF.incTotal + \" (\" + Math.round(dcF.incTotal / dcDur) + \"/s), \" + (Date.now() - dcF.last > d.gap * 1000 ? \"ended \" + dcAgo + \"s ago\" : \"under way\") + \".\", \"cyan\");\n  } else {\n    display_notice(\"[dmgchart] no fight yet.\", \"cyan\");\n  }\n  display_notice(\"[dmgchart] tab showing \" + (d.view == \"session\" ? \"the recording\" : (d.view ? \"saved session #\" + d.view : \"the live fight\")) + \". DMGCHART HELP for commands.\", \"cyan\");\n} else if (sub == \"help\") {\n  run_function(\"dmgchart_help\", [], \"dmgchart\");\n} else if (sub == \"list\") {\n  if (!d.saved.length) {\n    display_notice(\"[dmgchart] no saved sessions. DMGCHART START [name] to record one.\", \"cyan\");\n  } else {\n    display_notice(\"[dmgchart] \" + d.saved.length + \" saved session\" + (d.saved.length == 1 ? \"\" : \"s\") + \", newest first:\", \"cyan\");\n    for (var li = d.saved.length - 1; li >= 0; li--) {\n      var lv = d.saved[li];\n      var lcs = Math.max(1, lv.combatMs / 1000);\n      var ldt = new Date(lv.start);\n      display_notice(\"  #\" + lv.id + \" \" + lv.name + \" - \" + ldt.getDate() + \"/\" + (ldt.getMonth() + 1) + \", \" + lv.fights + \" fights, \" + (lcs < 60 ? Math.round(lcs) + \"s\" : Math.round(lcs / 60) + \"m\") + \" in combat, dealt \" + Math.round(lv.outTotal / lcs) + \"/s, taken \" + Math.round(lv.incTotal / lcs) + \"/s\");\n    }\n  }\n} else if (sub == \"debug\") {\n  display_notice(\"[dmgchart] gap=\" + d.gap + \" window=\" + d.window + \" warn=\" + d.warn + \" lasts=\" + (d.lasts ? Math.round(d.lasts.secs) + \"s\" : \"none\") + \" recent=\" + (d.recent ? d.recent.length : 0) + \" view='\" + d.view + \"' saved=\" + d.saved.length + \" nextId=\" + d.nextId + \" hp=\" + d.hp + \" sess=\" + (d.sess ? d.sess.name + \"/\" + d.sess.fights : \"none\") + \" fight=\" + (d.fight ? d.fight.outTotal + \"/\" + d.fight.incTotal : \"none\") + \" lastInc=\" + (d.lastInc ? d.lastInc.type + \":\" + d.lastInc.amt : \"none\"), \"cyan\");\n} else {\n  display_notice(\"[dmgchart] unknown command '\" + sub + \"'. DMGCHART HELP for commands.\", \"orange\");\n}\nrun_function(\"dmgchart_render\", [], \"dmgchart\");\n"
    }
   ],
   "text": "^dmgchart(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  }
 ],
 "description": "Damage dealt and taken by type per fight, health lasts, recorded sessions"
}