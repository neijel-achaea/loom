{
 "type": "group",
 "name": "dmgchart",
 "enabled": true,
 "items": [
  {
   "type": "function",
   "name": "onInstall",
   "enabled": true,
   "code": "run_function(\"dmgchart_setup\", [], \"dmgchart\");\nrun_function(\"dmgchart_render\", [], \"dmgchart\");\ndisplay_notice(\"[dmgchart] installed. Create a UI tab named 'DmgChart' for the charts. DMGCHART HELP for commands.\", \"lime\");\n"
  },
  {
   "type": "function",
   "name": "onUninstall",
   "enabled": true,
   "code": "// Nothing to tear down; the dmgchart_* variables are left intact.\n"
  },
  {
   "type": "function",
   "name": "onLoad",
   "enabled": true,
   "code": "// Tab icon: pure CSS keyed on the tab button's title, so Nexus's own\n// redraws (selecting, dragging, layout resets) cannot undo it.\nvar tiTabs = [[\"DmgChart\", '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 17 17\"><path d=\"M2 2 L11.5 11.5\" stroke=\"#eaa25c\" stroke-width=\"1.6\"/><path d=\"M15 2 L5.5 11.5\" stroke=\"#e0605a\" stroke-width=\"1.6\"/><path d=\"M10 13.5 L13.5 10 M3.5 10 L7 13.5\" stroke=\"#ecdfd9\" stroke-width=\"1.2\"/><path d=\"M12.5 12.5 L15 15 M4.5 12.5 L2 15\" stroke=\"#7a3f30\" stroke-width=\"1.8\"/></svg>']];\nfor (var tiI = 0; tiI < tiTabs.length; tiI++) {\n  var tiId = \"tabicon-\" + tiTabs[tiI][0].toLowerCase();\n  if (!document.getElementById(tiId)) {\n    var tiSel = '.flexlayout__tab_button[title=\"' + tiTabs[tiI][0] + '\" i]';\n    var tiSt = document.createElement(\"style\");\n    tiSt.id = tiId;\n    tiSt.textContent = tiSel + ' > * { display: none !important; } ' + tiSel + '::before { content: \"\"; display: block; width: 20px; height: 20px; margin: auto; background: url(\"data:image/svg+xml,' + encodeURIComponent(tiTabs[tiI][1]) + '\") center / contain no-repeat; }';\n    document.head.appendChild(tiSt);\n  }\n}\n\nrun_function(\"dmgchart_setup\", [], \"dmgchart\");\nrun_function(\"dmgchart_render\", [], \"dmgchart\");\n"
  },
  {
   "type": "function",
   "name": "onGMCP",
   "enabled": true,
   "code": "// Current health from Char.Vitals: for \"health lasts\" in the exchange, and\n// to count healing. Between two prompts, healing is the change in health\n// plus the damage taken in between (so a heal and a hit on the same prompt\n// both count); while a fight is on (up to the gap after its last blow) it\n// is added to that fight.\nvar dcM = \"\";\nvar dcA = null;\ntry { dcM = args.gmcp_method; dcA = args.gmcp_args; } catch (e) { dcM = \"\"; }\nif (dcM === \"Char.Vitals\" && dcA) {\n  if (typeof dcA === \"string\") { try { dcA = JSON.parse(dcA); } catch (e) { dcA = null; } }\n  if (dcA && dcA.hp !== undefined) {\n    if (!client.loom || !client.loom.dmgchart || !client.loom.dmgchart.saved) run_function(\"dmgchart_setup\", [], \"dmgchart\");\n    var DC = client.loom.dmgchart;\n    var dcHp = parseInt(dcA.hp, 10);\n    if (!isNaN(dcHp)) {\n      var dcF = DC.fight;\n      var dcGain = (typeof DC.hp === \"number\") ? dcHp - DC.hp + (DC.incSince || 0) : 0;\n      var dcHealed = false;\n      if (dcF && dcGain > 0 && Date.now() - dcF.last <= DC.gap * 1000) { dcF.heal = (dcF.heal || 0) + dcGain; dcHealed = true; run_function(\"dmgchart_recent\", { t: Date.now(), inc: 0, heal: dcGain }, \"dmgchart\"); }\n      DC.hp = dcHp;\n      DC.incSince = 0;\n      if (dcHealed && !DC.view) run_function(\"dmgchart_render\", [], \"dmgchart\");\n    }\n  }\n}\n"
  },
  {
   "type": "function",
   "name": "dmgchart_setup",
   "enabled": true,
   "code": "// dmgchart_setup -- run from onLoad and onInstall, by DMGCHART REBUILD (which\n// empties the namespace first, as run_function cannot pass parameters), and\n// by any reflex that finds the namespace missing. Namespace, registry,\n// one-time migration of the dc_* variables and the old client.dc, then the\n// state, each part built if missing.\nif (!client.loom) client.loom = {};\nif (!client.loom.registry) client.loom.registry = {};\nclient.loom.registry.dmgchart = { version: \"0.3.1\", keyword: \"DMGCHART\", desc: \"Damage dealt and taken by type per fight, healing, recorded sessions\" };\nif (!client.loom.dmgchart) client.loom.dmgchart = {};\nvar DC = client.loom.dmgchart;\n\n// One-time migration: dc_* -> dmgchart_*. A new variable that already holds\n// data wins; the old one is deleted either way.\nvar dcMoves = [[\"gap\", \"\"], [\"sessions\", \"[]\"], [\"open\", \"\"]];\nfor (var dcI = 0; dcI < dcMoves.length; dcI++) {\n  var dcOld;\n  try { dcOld = get_variable(\"dc_\" + dcMoves[dcI][0]); } catch (e) { dcOld = undefined; }\n  if (dcOld !== undefined && dcOld !== null) {\n    var dcNew;\n    try { dcNew = get_variable(\"dmgchart_\" + dcMoves[dcI][0]); } catch (e) { dcNew = undefined; }\n    if (dcNew === undefined || dcNew === null || dcNew === \"\" || dcNew === dcMoves[dcI][1]) set_variable(\"dmgchart_\" + dcMoves[dcI][0], dcOld);\n    delete_variable(\"dc_\" + dcMoves[dcI][0]);\n  }\n}\n\n// The old package kept everything in client.dc. On a reimport without a page\n// reload, the fight, open session, view and colours in memory carry over.\nif (client.dc) {\n  var dcCarry = [\"fight\", \"lastInc\", \"sess\", \"sessSaved\", \"view\", \"colors\", \"spareIdx\", \"hp\"];\n  for (var dcJ = 0; dcJ < dcCarry.length; dcJ++) {\n    if (DC[dcCarry[dcJ]] === undefined && client.dc[dcCarry[dcJ]] !== undefined) DC[dcCarry[dcJ]] = client.dc[dcCarry[dcJ]];\n  }\n  delete client.dc;\n}\n\nif (DC.gap === undefined) {\n  DC.gap = parseFloat(get_variable(\"dmgchart_gap\"));\n  if (isNaN(DC.gap) || DC.gap <= 0) DC.gap = 6;\n}\nif (DC.window === undefined) {\n  DC.window = parseFloat(get_variable(\"dmgchart_window\"));\n  if (isNaN(DC.window) || DC.window <= 0) DC.window = 10;\n}\nif (!DC.recent) DC.recent = [];\nDC.tab = \"DmgChart\";\nif (!DC.colors) DC.colors = { \"cutting\": \"#d9534f\", \"blunt\": \"#b08968\", \"magical\": \"#9b6bd6\", \"unblockable\": \"#d8d8d8\", \"poison\": \"#6abf4b\", \"fire\": \"#f0883e\", \"cold\": \"#5bc0de\", \"electricity\": \"#f2d43d\", \"asphyxiation\": \"#7f8fa6\", \"psychic\": \"#e36bb8\", \"raw\": \"#8c8c8c\", \"bleed\": \"#8b1e2d\" };\nDC.spare = [\"#4fb0a5\", \"#c9a0dc\", \"#a3c45a\", \"#e0b070\", \"#6f8fd8\", \"#d97a9a\"];\nif (DC.spareIdx === undefined) DC.spareIdx = 0;\nif (DC.fight === undefined) DC.fight = null;\nif (DC.lastInc === undefined) DC.lastInc = null;\nDC.ev = null;\nif (DC.view === undefined) DC.view = \"\";\nif (!DC.saved) {\n  DC.saved = [];\n  try { var dcRaw = get_variable(\"dmgchart_sessions\"); if (dcRaw && String(dcRaw).length) DC.saved = JSON.parse(dcRaw) || []; } catch (e) { DC.saved = []; }\n}\nDC.nextId = 1;\nfor (var dcK = 0; dcK < DC.saved.length; dcK++) { if (DC.saved[dcK].id >= DC.nextId) DC.nextId = DC.saved[dcK].id + 1; }\nif (DC.sess === undefined) {\n  DC.sess = null;\n  try { var dcOpen = get_variable(\"dmgchart_open\"); if (dcOpen && String(dcOpen).length) DC.sess = JSON.parse(dcOpen); } catch (e) { DC.sess = null; }\n}\nif (DC.sessSaved === undefined) DC.sessSaved = 0;\n"
  },
  {
   "type": "function",
   "name": "dmgchart_add",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.dmgchart || !client.loom.dmgchart.saved) run_function(\"dmgchart_setup\", [], \"dmgchart\");\n// Adds client.loom.dmgchart.ev ({dir, type, amt}) to the current fight and, if one is open, the session.\n// Incoming bleeding is passive: it counts in the totals but is not a hit, does\n// not keep a fight going and does not start one (#152). A tick after the gap\n// goes to the fight that just ended; with no fight at all, only to the session.\nvar d = client.loom.dmgchart;\nvar e = d.ev;\nif (e && !isNaN(e.amt)) {\n  var now = Date.now();\n  var gapMs = d.gap * 1000;\n  var passive = (e.dir == \"inc\" && e.type == \"bleed\");\n  var f = d.fight;\n  var ss = d.sess;\n  // What this event changes, so trigger_bleed can take back a raw line that\n  // turns out to be bleeding (the game prints \"Health lost: N (raw).\" first).\n  var undo = { fight: f, opened: false, last: f ? f.last : 0, sLastT: ss ? ss.lastT : 0, sCombat: ss ? ss.combatMs : 0, sFights: ss ? ss.fights : 0 };\n  if (!passive && (!f || now - f.last > gapMs)) {\n    f = { start: now, last: now, inc: {}, out: {}, incTotal: 0, outTotal: 0, heal: 0 };\n    d.fight = f;\n    d.lastInc = null;\n    undo.opened = true;\n  }\n  if (f) {\n    f[e.dir][e.type] = (f[e.dir][e.type] || 0) + e.amt;\n    f[e.dir + \"Total\"] += e.amt;\n    if (!passive) {\n      // Hit counts and the biggest single hit, per direction, for the exchange stats.\n      if (!f.hits) { f.hits = { inc: { n: 0, max: 0 }, out: { n: 0, max: 0 } }; }\n      undo.max = f.hits[e.dir].max;\n      f.hits[e.dir].n++;\n      if (e.amt > f.hits[e.dir].max) { f.hits[e.dir].max = e.amt; }\n      f.last = now;\n    }\n  }\n  if (ss) {\n    if (!passive) {\n      if (ss.lastT && now - ss.lastT <= gapMs) { ss.combatMs += now - ss.lastT; } else { ss.fights++; }\n      ss.lastT = now;\n      if (!ss.hits) { ss.hits = { inc: { n: 0, max: 0 }, out: { n: 0, max: 0 } }; }\n      undo.sMax = ss.hits[e.dir].max;\n      ss.hits[e.dir].n++;\n      if (e.amt > ss.hits[e.dir].max) { ss.hits[e.dir].max = e.amt; }\n    }\n    ss[e.dir][e.type] = (ss[e.dir][e.type] || 0) + e.amt;\n    ss[e.dir + \"Total\"] += e.amt;\n    if (now - d.sessSaved > 5000) { set_variable(\"dmgchart_open\", JSON.stringify(ss)); d.sessSaved = now; }\n  }\n  if (e.dir == \"inc\") {\n    d.incSince = (d.incSince || 0) + e.amt;\n    // Recent incoming, for health lasts over the last few seconds (#153).\n    run_function(\"dmgchart_recent\", { t: now, inc: e.amt, heal: 0 }, \"dmgchart\");\n    d.lastInc = { type: e.type, amt: e.amt, t: now, inSess: !!ss, undo: undo };\n  }\n  run_function(\"dmgchart_render\", [], \"dmgchart\");\n}\nd.ev = null;\n"
  },
  {
   "type": "function",
   "name": "dmgchart_recent",
   "enabled": true,
   "code": "// dmgchart_recent -- args {t, inc, heal}: one entry in client.loom.dmgchart.recent,\n// the incoming damage and healing of the last few seconds, for health lasts (#153).\n// Entries older than the window (at most two minutes) are dropped.\nvar d = client.loom.dmgchart;\nif (!d.recent) d.recent = [];\nd.recent.push({ t: args.t, inc: args.inc || 0, heal: args.heal || 0 });\nvar rcKeep = args.t - Math.min(120, Math.max(d.window || 10, 1)) * 1000;\nwhile (d.recent.length && d.recent[0].t < rcKeep) d.recent.shift();\n"
  },
  {
   "type": "function",
   "name": "dmgchart_render",
   "enabled": true,
   "code": "if (!client.loom || !client.loom.dmgchart || !client.loom.dmgchart.saved) run_function(\"dmgchart_setup\", [], \"dmgchart\");\n// dmgchart_render -- paints the DmgChart tab in the house style shared with Coffers, Level,\n// Ledger and Fishing: ink panel, serif small-caps headings, the two dps\n// figures set large, donuts for the chosen source, then the session list.\n// Accents are ember for damage dealt and crimson for damage taken.\nvar d = client.loom.dmgchart;\nvar EMBER = \"#eaa25c\";\nvar CRIMSON = \"#e0605a\";\nvar DEEP = \"#7a3f30\";\nvar TXT = \"#ecdfd9\";\nvar MUTED = \"#90807a\";\nvar RULE = \"#33231f\";\nvar SERIF = \"Georgia,'Palatino Linotype','Book Antiqua',serif\";\nvar MONO = \"Consolas,'DejaVu Sans Mono',monospace\";\n\nfunction esc(t) { return String(t).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\nfunction p2(n) { return (\"0\" + n).slice(-2); }\nfunction hm(dt) { return p2(dt.getHours()) + \":\" + p2(dt.getMinutes()); }\nfunction md(dt) { return dt.getDate() + \"/\" + (dt.getMonth() + 1); }\nfunction secs(s) {\n  if (s < 60) { return (s < 10 ? s.toFixed(1) : Math.round(s)) + \"s\"; }\n  if (s < 3600) { return Math.floor(s / 60) + \"m \" + p2(Math.round(s % 60)) + \"s\"; }\n  return Math.floor(s / 3600) + \"h \" + Math.round((s % 3600) / 60) + \"m\";\n}\nfunction caps(t, col) { return '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.12em;color:' + (col || DEEP) + ';font-size:11px;margin:0 0 3px;\">' + t + '</div>'; }\nfunction section(title, inner) { return '<div style=\"border-top:1px solid ' + RULE + ';margin-top:8px;padding-top:5px;\">' + caps(title, EMBER) + inner + '</div>'; }\n// One exchange row: a label, then the dealt and taken figures in their accents.\nfunction xrow(label, a, b) {\n  return '<div style=\"display:flex;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"flex:1 1 auto;color:' + MUTED + ';\">' + label + '</span><span style=\"min-width:5em;text-align:right;color:' + TXT + ';\">' + a + '</span><span style=\"min-width:5em;text-align:right;color:' + TXT + ';\">' + b + '</span></div>';\n}\nfunction xline(label, text, c) {\n  return '<div style=\"display:flex;justify-content:space-between;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\"><span style=\"color:' + MUTED + ';\">' + label + '</span><span style=\"color:' + c + ';\">' + text + '</span></div>';\n}\nfunction quiet(t) { return '<div style=\"color:' + MUTED + ';font-family:' + SERIF + ';font-style:italic;\">' + t + '</div>'; }\nvar REC = '<span style=\"color:' + CRIMSON + ';\">&#9679;</span>';\n\n// Pick the source: an open session, a saved one, or the live fight.\nvar src = null;\nvar label = \"\";\nvar sub = \"\";\nvar dt = null;\nif (d.view == \"session\" && d.sess) {\n  src = d.sess;\n  dt = new Date(d.sess.start);\n  label = REC + \" recording\";\n  sub = '<span style=\"font-family:' + SERIF + ';color:' + TXT + ';\">&ldquo;' + esc(d.sess.name) + '&rdquo;</span> since ' + hm(dt) + ' &middot; ' + d.sess.fights + ' fights &middot; ' + secs(d.sess.combatMs / 1000) + ' in combat';\n  src.dur = Math.max(1, d.sess.combatMs / 1000);\n} else if (d.view && d.view != \"session\") {\n  for (var q = 0; q < d.saved.length; q++) { if (String(d.saved[q].id) == String(d.view)) { src = d.saved[q]; } }\n  if (src) {\n    dt = new Date(src.start);\n    label = \"session #\" + src.id;\n    sub = '<span style=\"font-family:' + SERIF + ';color:' + TXT + ';\">&ldquo;' + esc(src.name) + '&rdquo;</span> ' + md(dt) + ' ' + hm(dt) + ' &middot; ' + src.fights + ' fights &middot; ' + secs(src.combatMs / 1000) + ' in combat';\n    src.dur = Math.max(1, src.combatMs / 1000);\n  }\n}\nif (!src && d.fight) {\n  src = d.fight;\n  dt = new Date(src.start);\n  src.dur = Math.max(1, (src.last - src.start) / 1000);\n  label = \"live fight\";\n  sub = 'fight from ' + hm(dt) + ':' + p2(dt.getSeconds()) + ' &middot; ' + secs(src.dur) + ' <span style=\"font-style:italic;font-family:' + SERIF + ';\">(a new one after ' + d.gap + 's quiet)</span>';\n  if (d.sess) { sub += '<br>' + REC + ' recording <span style=\"font-family:' + SERIF + ';color:' + TXT + ';\">&ldquo;' + esc(d.sess.name) + '&rdquo;</span>'; }\n}\n\n// Crossed blades for the title, the damage tab's counterpart of the coin stack.\nvar glyph = '<svg width=\"17\" height=\"17\" viewBox=\"0 0 17 17\" style=\"vertical-align:-3px;margin-right:6px;\" xmlns=\"http://www.w3.org/2000/svg\">' +\n  '<path d=\"M2 2 L11.5 11.5\" stroke=\"' + EMBER + '\" stroke-width=\"1.6\"/><path d=\"M15 2 L5.5 11.5\" stroke=\"' + CRIMSON + '\" stroke-width=\"1.6\"/>' +\n  '<path d=\"M10 13.5 L13.5 10 M3.5 10 L7 13.5\" stroke=\"' + TXT + '\" stroke-width=\"1.2\"/>' +\n  '<path d=\"M12.5 12.5 L15 15 M4.5 12.5 L2 15\" stroke=\"' + DEEP + '\" stroke-width=\"1.8\"/></svg>';\n\nvar html = '<div style=\"font-family:' + MONO + ';font-size:10px;color:' + TXT + ';background:#150f0d;border:1px solid ' + RULE + ';padding:7px 8px 8px;\">';\nhtml += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ' + DEEP + ';padding-bottom:3px;\">';\nhtml += '<div style=\"font-family:' + SERIF + ';color:' + EMBER + ';font-size:14px;letter-spacing:0.22em;\">' + glyph + 'DAMAGE</div>';\nhtml += '<div style=\"font-family:' + SERIF + ';font-variant:small-caps;letter-spacing:0.1em;color:' + MUTED + ';font-size:11px;\">' + (label || (d.sess ? REC + ' recording' : 'waiting')) + '</div></div>';\n\nif (!src) {\n  html += '<div style=\"margin-top:8px;\">' + quiet(\"No damage recorded yet. A new fight starts after \" + d.gap + \"s without damage in either direction.\") + '</div>';\n  if (d.sess) { html += '<div style=\"color:' + MUTED + ';margin-top:3px;\">' + REC + ' recording &ldquo;' + esc(d.sess.name) + '&rdquo;</div>'; }\n} else {\n  var dur = src.dur;\n  // The dealt and taken rates sit inside the donuts; above them, only what\n  // the tab is showing.\n  html += '<div style=\"color:' + MUTED + ';margin-top:5px;\">' + sub + '</div>';\n\n  html += '<div style=\"display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;\">';\n  var dirs = [\"out\", \"inc\"];\n  var titles = { out: \"Dealt\", inc: \"Taken\" };\n  var accents = { out: EMBER, inc: CRIMSON };\n  var R = 45;\n  var C = 2 * Math.PI * R;\n  for (var di = 0; di < dirs.length; di++) {\n    var dir = dirs[di];\n    var acc = accents[dir];\n    var bucket = src[dir];\n    var total = src[dir + \"Total\"];\n    var rows = [];\n    for (var k in bucket) {\n      if (bucket.hasOwnProperty(k)) {\n        var r = { type: k, amt: bucket[k] };\n        var i = rows.length;\n        while (i > 0 && rows[i - 1].amt < r.amt) { rows[i] = rows[i - 1]; i--; }\n        rows[i] = r;\n        if (!d.colors[k]) { d.colors[k] = d.spare[d.spareIdx % d.spare.length]; d.spareIdx++; }\n      }\n    }\n    var col = '<div style=\"flex:1 1 200px;min-width:200px;border-top:2px solid ' + acc + ';padding:3px 2px 0;\">';\n    col += '<div style=\"display:flex;justify-content:space-between;align-items:baseline;\">' + caps(titles[dir], acc) + '<span style=\"color:' + MUTED + ';\">' + total + ' total</span></div>';\n    col += '<svg viewBox=\"0 0 120 120\" width=\"140\" height=\"140\" style=\"display:block;margin:4px auto 6px;\">';\n    col += '<circle cx=\"60\" cy=\"60\" r=\"' + R + '\" fill=\"none\" stroke=\"' + RULE + '\" stroke-width=\"16\"/>';\n    var off = 0;\n    for (var s = 0; s < rows.length; s++) {\n      var len = total > 0 ? C * rows[s].amt / total : 0;\n      col += '<circle cx=\"60\" cy=\"60\" r=\"' + R + '\" fill=\"none\" stroke=\"' + d.colors[rows[s].type] + '\" stroke-width=\"16\" stroke-dasharray=\"' + len.toFixed(3) + ' ' + (C - len).toFixed(3) + '\" stroke-dashoffset=\"' + (-off).toFixed(3) + '\" transform=\"rotate(-90 60 60)\"/>';\n      off += len;\n    }\n    col += '<text x=\"60\" y=\"60\" text-anchor=\"middle\" font-family=\"' + SERIF + '\" font-size=\"20\" fill=\"' + acc + '\">' + Math.round(total / dur) + '</text>';\n    col += '<text x=\"60\" y=\"75\" text-anchor=\"middle\" font-family=\"' + SERIF + '\" font-style=\"italic\" font-size=\"9\" fill=\"' + MUTED + '\">per second</text>';\n    col += '</svg>';\n    if (rows.length == 0) {\n      col += quiet(\"none\");\n    } else {\n      for (var t = 0; t < rows.length; t++) {\n        var row = rows[t];\n        col += '<div style=\"display:flex;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;\">';\n        col += '<span style=\"flex:1 1 auto;white-space:nowrap;\"><span style=\"display:inline-block;width:8px;height:8px;background:' + d.colors[row.type] + ';margin-right:4px;\"></span>' + esc(row.type) + '</span>';\n        col += '<span style=\"min-width:3.5em;text-align:right;\">' + row.amt + '</span>';\n        col += '<span style=\"min-width:3.5em;text-align:right;color:' + MUTED + ';\">' + (100 * row.amt / total).toFixed(1) + '%</span>';\n        col += '<span style=\"min-width:3.5em;text-align:right;color:' + acc + ';\">' + Math.round(row.amt / dur) + '/s</span></div>';\n      }\n    }\n    html += col + '</div>';\n  }\n  html += '</div>';\n\n  // The exchange: how the blows compare. Hit counts were added after the\n  // first sessions were saved, so those show only the ratio.\n  var H = src.hits || null;\n  var ex = \"\";\n  if (H) {\n    ex += '<div style=\"display:flex;gap:6px;color:' + MUTED + ';border-bottom:1px solid ' + RULE + ';padding-bottom:1px;\"><span style=\"flex:1 1 auto;\"></span><span style=\"min-width:5em;text-align:right;color:' + EMBER + ';\">dealt</span><span style=\"min-width:5em;text-align:right;color:' + CRIMSON + ';\">taken</span></div>';\n    ex += xrow(\"hits\", H.out.n, H.inc.n);\n    ex += xrow(\"average hit\", H.out.n > 0 ? Math.round(src.outTotal / H.out.n) : \"&mdash;\", H.inc.n > 0 ? Math.round(src.incTotal / H.inc.n) : \"&mdash;\");\n    ex += xrow(\"biggest hit\", H.out.max || \"&mdash;\", H.inc.max || \"&mdash;\");\n    ex += xrow(\"hits a minute\", Math.round(H.out.n / (dur / 60)), Math.round(H.inc.n / (dur / 60)));\n  }\n  if (src.incTotal > 0) {\n    var ratio = src.outTotal / src.incTotal;\n    ex += xline(\"trading\", (ratio >= 10 ? Math.round(ratio) : Math.round(ratio * 10) / 10) + \" dealt for every 1 taken\", ratio >= 1 ? EMBER : CRIMSON);\n  } else if (src.outTotal > 0) {\n    ex += xline(\"trading\", \"untouched so far\", EMBER);\n  }\n  // Staying power, for the live fight only: current health (from Char.Vitals)\n  // over incoming dps less healing, both over the last d.window seconds (or\n  // the fight so far, if shorter), so a fresh attacker shows at once (#153).\n  // Healing is every rise in health during the fight (elixirs, regeneration,\n  // anything), as onGMCP counts it.\n  if (!d.view && src.incTotal > 0) {\n    var hpNow = d.hp;\n    var heal = src.heal || 0;\n    if (heal > 0) ex += xline(\"healed\", heal + \" (\" + Math.round(heal / dur) + \"/s)\", \"#7fbf7f\");\n    var wNow = Date.now();\n    var wSpan = Math.max(1, Math.min(d.window, (wNow - src.start) / 1000));\n    var wInc = 0, wHeal = 0;\n    var rc = d.recent || [];\n    for (var ri = 0; ri < rc.length; ri++) {\n      if (rc[ri].t >= wNow - wSpan * 1000 && rc[ri].t >= src.start) { wInc += rc[ri].inc; wHeal += rc[ri].heal; }\n    }\n    var wSec = Math.round(wSpan) + \"s\";\n    var wTag = \"at the rate of the last \" + wSec;\n    if (typeof hpNow === \"number\" && !isNaN(hpNow) && hpNow > 0) {\n      if (wInc <= 0) {\n        ex += xline(\"health lasts\", \"nothing taken in the last \" + wSec, \"#7fbf7f\");\n      } else if (wInc <= wHeal) {\n        ex += xline(\"health lasts\", \"healing keeps up \" + wTag, \"#7fbf7f\");\n      } else {\n        var last = hpNow / ((wInc - wHeal) / wSpan);\n        ex += xline(\"health lasts\", \"~\" + secs(last) + \" \" + wTag + (wHeal > 0 ? \", after healing\" : \"\"), last < 10 ? CRIMSON : (last < 30 ? \"#e6c25a\" : MUTED));\n      }\n    }\n  }\n  if (ex) { html += section(\"The exchange\", ex); }\n}\n\nif (d.saved.length) {\n  var list = '<div style=\"display:flex;gap:6px;color:' + MUTED + ';border-bottom:1px solid ' + RULE + ';padding-bottom:1px;\">';\n  list += '<span style=\"min-width:2.2em;\">#</span><span style=\"flex:1 1 auto;\">name</span><span style=\"min-width:6.5em;\">when</span><span style=\"min-width:3em;text-align:right;\">fights</span><span style=\"min-width:3.5em;text-align:right;\">combat</span><span style=\"min-width:3em;text-align:right;\">dealt</span><span style=\"min-width:3em;text-align:right;\">taken</span></div>';\n  var shown = 0;\n  for (var w = d.saved.length - 1; w >= 0 && shown < 10; w--) {\n    var sv = d.saved[w];\n    var sd = new Date(sv.start);\n    var sdur = Math.max(1, sv.combatMs / 1000);\n    var sel = String(d.view) == String(sv.id);\n    list += '<div style=\"display:flex;gap:6px;border-bottom:1px dotted ' + RULE + ';padding:1px 0;' + (sel ? 'background:#2a1a16;' : '') + '\">';\n    list += '<span style=\"min-width:2.2em;color:' + DEEP + ';\">' + sv.id + '</span>';\n    list += '<span style=\"flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:' + (sel ? '#ffffff' : TXT) + ';\">' + esc(sv.name) + '</span>';\n    list += '<span style=\"min-width:6.5em;color:' + MUTED + ';\">' + md(sd) + ' ' + hm(sd) + '</span>';\n    list += '<span style=\"min-width:3em;text-align:right;\">' + sv.fights + '</span>';\n    list += '<span style=\"min-width:3.5em;text-align:right;\">' + Math.round(sdur / 60) + 'm</span>';\n    list += '<span style=\"min-width:3em;text-align:right;color:' + EMBER + ';\">' + Math.round(sv.outTotal / sdur) + '</span>';\n    list += '<span style=\"min-width:3em;text-align:right;color:' + CRIMSON + ';\">' + Math.round(sv.incTotal / sdur) + '</span></div>';\n    shown++;\n  }\n  html += section(\"Saved sessions\", list);\n}\nif (d.view) { html += '<div style=\"color:' + MUTED + ';margin-top:6px;font-family:' + SERIF + ';font-style:italic;\">DMGCHART LIVE returns to the live fight.</div>'; }\nhtml += '</div>';\ntry { set_custom_tab_html(d.tab, html); } catch (err) {}"
  },
  {
   "type": "function",
   "name": "dmgchart_help",
   "enabled": true,
   "code": "// dmgchart_help -- the HELP screen. Printed in a monospace block through\n// nexusclient.add_html_line when this Nexus has it, so the columns line up;\n// otherwise as plain notices.\nvar hlTitle = \"[dmgchart] damage dealt and taken by type, per fight and per recorded session. Commands:\";\n// [command, what it does]; a one-element row is a note or section line.\nvar hlRows = [\n  [\"DMGCHART\", \"the fight in the tab, any recording, gap and saved sessions\"],\n  [\"DMGCHART START [name]\", \"start recording a session\"],\n  [\"DMGCHART END\", \"stop recording and save the session\"],\n  [\"DMGCHART SHOW [#]\", \"show the recording, or saved session #, in the tab\"],\n  [\"DMGCHART LIVE\", \"back to the live fight\"],\n  [\"DMGCHART LIST\", \"the saved sessions\"],\n  [\"DMGCHART DEL <#>\", \"delete saved session #\"],\n  [\"DMGCHART GAP <seconds>\", \"quiet time that ends a fight (default 6; bleeding doesn't count)\"],\n  [\"DMGCHART WINDOW <seconds>\", \"how far back health lasts looks (default 10)\"],\n  [\"DMGCHART RESET\", \"clear the live fight\"],\n  [\"DMGCHART WIPE CONFIRM\", \"delete all saved sessions\"],\n  [\"DMGCHART REBUILD\", \"rebuild from the saved variables (a recording resumes from its last checkpoint)\"],\n  [\"DMGCHART DEBUG\", \"internal state\"]\n];\nvar hlW = 0;\nfor (var hlI = 0; hlI < hlRows.length; hlI++) {\n  if (hlRows[hlI].length > 1 && hlRows[hlI][0].length > hlW) hlW = hlRows[hlI][0].length;\n}\nvar hlPad = \"                                                            \";\nvar hlHtml = (typeof nexusclient != \"undefined\" && nexusclient && typeof nexusclient.add_html_line == \"function\");\nvar hlOut = [];\nif (!hlHtml) display_notice(hlTitle, \"cyan\");\nfor (var hlJ = 0; hlJ < hlRows.length; hlJ++) {\n  var hlR = hlRows[hlJ];\n  var hlCmd = hlR.length > 1 ? hlR[0] : \"\";\n  var hlText = hlR.length > 1 ? hlR[1] : hlR[0];\n  if (hlR.length > 1) hlCmd = (hlCmd + hlPad).substring(0, hlW + 3);\n  if (hlHtml) {\n    hlCmd = hlCmd.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlText = hlText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    hlOut.push(\"  \" + (hlR.length > 1 ? '<span style=\"color:#00ffff\">' + hlCmd + '</span>' + '<span style=\"color:#9fc9c9\">' + hlText + '</span>' : '<span style=\"color:#9fc9c9\">' + hlText + '</span>'));\n  } else {\n    display_notice(\"  \" + hlCmd + hlText, \"cyan\");\n  }\n}\nif (hlHtml) {\n  display_notice(hlTitle, \"cyan\");\n  nexusclient.add_html_line('<span style=\"font-family:\\'Courier New\\',monospace;white-space:pre\">' + hlOut.join(\"\\n\") + '</span>');\n}\n"
  },
  {
   "type": "trigger",
   "name": "dmgchart outgoing",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.dmgchart || !client.loom.dmgchart.saved) run_function(\"dmgchart_setup\", [], \"dmgchart\");\nclient.loom.dmgchart.ev = { dir: \"out\", type: String(args[2]).replace(\"physical \", \"\"), amt: parseInt(args[1], 10) };\nrun_function(\"dmgchart_add\", [], \"dmgchart\");\n"
    }
   ],
   "text": "^Damage dealt: (\\d+) \\(([^)]+)\\)\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "dmgchart incoming",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.dmgchart || !client.loom.dmgchart.saved) run_function(\"dmgchart_setup\", [], \"dmgchart\");\nclient.loom.dmgchart.ev = { dir: \"inc\", type: String(args[2]).replace(\"physical \", \"\"), amt: parseInt(args[1], 10) };\nrun_function(\"dmgchart_add\", [], \"dmgchart\");\n"
    }
   ],
   "text": "^Health lost: (\\d+) \\(([^)]+)\\)\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "trigger",
   "name": "dmgchart bleed",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.dmgchart || !client.loom.dmgchart.saved) run_function(\"dmgchart_setup\", [], \"dmgchart\");\n// Bleeding arrives as \"Health lost: N (raw).\" then \"You bleed N health.\"\n// If that raw line was just recorded, take it back (amount, hit, fight time,\n// and the fight it opened, if any), then record the amount as passive bleeding,\n// which counts but doesn't keep a fight going (#152).\nvar amt = parseInt(args[1], 10);\nvar d = client.loom.dmgchart;\nvar li = d.lastInc;\nif (li && li.type == \"raw\" && li.amt == amt && li.undo && Date.now() - li.t < 1500) {\n  var u = li.undo;\n  var f = d.fight;\n  if (f && (f.inc.raw || 0) >= amt) {\n    f.inc.raw -= amt;\n    if (f.inc.raw <= 0) { delete f.inc.raw; }\n    f.incTotal -= amt;\n    if (f.hits) { f.hits.inc.n--; f.hits.inc.max = u.max || 0; }\n    if (u.opened) { d.fight = u.fight; } else { f.last = u.last; }\n  }\n  var ss = d.sess;\n  if (li.inSess && ss && (ss.inc.raw || 0) >= amt) {\n    ss.inc.raw -= amt;\n    if (ss.inc.raw <= 0) { delete ss.inc.raw; }\n    ss.incTotal -= amt;\n    if (ss.hits) { ss.hits.inc.n--; ss.hits.inc.max = u.sMax || 0; }\n    ss.lastT = u.sLastT;\n    ss.combatMs = u.sCombat;\n    ss.fights = u.sFights;\n  }\n  d.incSince = (d.incSince || 0) - amt;\n  // The raw line's entry in the recent list stays: dmgchart_add below adds the\n  // bleed again, so drop it first.\n  if (d.recent && d.recent.length && d.recent[d.recent.length - 1].inc == amt) d.recent.pop();\n}\nd.ev = { dir: \"inc\", type: \"bleed\", amt: amt };\nrun_function(\"dmgchart_add\", [], \"dmgchart\");\n"
    }
   ],
   "text": "^You bleed (\\d+) health\\.$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": true
  },
  {
   "type": "alias",
   "name": "dmgchart",
   "enabled": true,
   "actions": [
    {
     "type": "script",
     "enabled": true,
     "script": "if (!client.loom || !client.loom.dmgchart || !client.loom.dmgchart.saved) run_function(\"dmgchart_setup\", [], \"dmgchart\");\n// DMGCHART [subcommand ...]: the one command for this package.\nvar dcRaw = String(args[1] || \"\").trim();\nvar dcSp = dcRaw.search(/\\s/);\nvar sub = (dcSp < 0 ? dcRaw : dcRaw.slice(0, dcSp)).toLowerCase();\nvar rest = dcSp < 0 ? \"\" : dcRaw.slice(dcSp + 1).trim();\nvar d = client.loom.dmgchart;\n// Session numbers may be typed as 3 or #3.\nvar restId = rest.replace(/^#/, \"\");\nif (sub == \"show\" || sub == \"del\") rest = restId;\nif (sub == \"gap\") {\n  var g = parseFloat(rest);\n  if (isNaN(g) || g <= 0) {\n    display_notice(\"[dmgchart] usage: DMGCHART GAP <seconds>  (currently \" + d.gap + \"s)\", \"orange\");\n  } else {\n    d.gap = g;\n    set_variable(\"dmgchart_gap\", String(g));\n    display_notice(\"[dmgchart] fight gap set to \" + g + \"s\", \"lime\");\n  }\n} else if (sub == \"window\") {\n  var w = parseFloat(rest);\n  if (isNaN(w) || w <= 0 || w > 120) {\n    display_notice(\"[dmgchart] usage: DMGCHART WINDOW <seconds>, 1 to 120  (currently \" + d.window + \"s)\", \"orange\");\n  } else {\n    d.window = w;\n    set_variable(\"dmgchart_window\", String(w));\n    display_notice(\"[dmgchart] health lasts now uses the last \" + w + \"s of the fight\", \"lime\");\n  }\n} else if (sub == \"reset\") {\n  d.fight = null;\n  d.lastInc = null;\n  d.recent = [];\n  display_notice(\"[dmgchart] fight cleared; the next damage line starts a new one\", \"lime\");\n} else if (sub == \"start\") {\n  if (d.sess) {\n    display_notice(\"[dmgchart] session '\" + d.sess.name + \"' is already recording. DMGCHART END first.\", \"orange\");\n  } else {\n    d.sess = { name: rest || (\"session \" + d.nextId), start: Date.now(), lastT: 0, combatMs: 0, fights: 0, inc: {}, out: {}, incTotal: 0, outTotal: 0 };\n    set_variable(\"dmgchart_open\", JSON.stringify(d.sess));\n    d.sessSaved = Date.now();\n    display_notice(\"[dmgchart] recording session '\" + d.sess.name + \"'. DMGCHART END to save it.\", \"lime\");\n  }\n} else if (sub == \"end\") {\n  if (!d.sess) {\n    display_notice(\"[dmgchart] no session is recording. DMGCHART START [name] to begin one.\", \"orange\");\n  } else {\n    var ss = d.sess;\n    if (ss.fights == 0) {\n      display_notice(\"[dmgchart] session '\" + ss.name + \"' had no damage; discarded.\", \"orange\");\n    } else {\n      var rec = { id: d.nextId, name: ss.name, start: ss.start, end: Date.now(), combatMs: ss.combatMs, fights: ss.fights, inc: ss.inc, out: ss.out, incTotal: ss.incTotal, outTotal: ss.outTotal, hits: ss.hits || null };\n      d.nextId++;\n      d.saved.push(rec);\n      while (d.saved.length > 50) { d.saved.shift(); }\n      set_variable(\"dmgchart_sessions\", JSON.stringify(d.saved));\n      var cs = Math.max(1, rec.combatMs / 1000);\n      display_notice(\"[dmgchart] saved session #\" + rec.id + \" '\" + rec.name + \"': \" + rec.fights + \" fights, \" + Math.round(cs) + \"s in combat, out \" + Math.round(rec.outTotal / cs) + \" dps, in \" + Math.round(rec.incTotal / cs) + \" dps\", \"lime\");\n    }\n    d.sess = null;\n    set_variable(\"dmgchart_open\", \"\");\n    if (d.view == \"session\") { d.view = \"\"; }\n  }\n} else if (sub == \"show\") {\n  if (rest == \"\") {\n    if (d.sess) { d.view = \"session\"; } else { display_notice(\"[dmgchart] no session recording. DMGCHART SHOW <#> for a saved one.\", \"orange\"); }\n  } else {\n    var found = false;\n    for (var q = 0; q < d.saved.length; q++) { if (String(d.saved[q].id) == rest) { found = true; } }\n    if (found) { d.view = rest; } else { display_notice(\"[dmgchart] no saved session #\" + rest, \"orange\"); }\n  }\n} else if (sub == \"live\") {\n  d.view = \"\";\n} else if (sub == \"del\") {\n  var kept = [];\n  for (var x = 0; x < d.saved.length; x++) { if (String(d.saved[x].id) != rest) { kept.push(d.saved[x]); } }\n  if (kept.length == d.saved.length) {\n    display_notice(\"[dmgchart] no saved session #\" + rest, \"orange\");\n  } else {\n    d.saved = kept;\n    set_variable(\"dmgchart_sessions\", JSON.stringify(d.saved));\n    if (String(d.view) == rest) { d.view = \"\"; }\n    display_notice(\"[dmgchart] deleted session #\" + rest, \"orange\");\n  }\n} else if (sub == \"wipe\") {\n  if (rest.toLowerCase() == \"confirm\") {\n    d.saved = [];\n    set_variable(\"dmgchart_sessions\", \"[]\");\n    if (d.view != \"session\") { d.view = \"\"; }\n    display_notice(\"[dmgchart] all saved sessions wiped\", \"orange\");\n  } else {\n    display_notice(\"[dmgchart] this deletes ALL saved sessions. DMGCHART WIPE CONFIRM to proceed.\", \"orange\");\n  }\n} else if (sub == \"\" || sub == \"status\") {\n  var dcF = d.fight;\n  var dcLine = \"gap \" + d.gap + \"s, health lasts over the last \" + d.window + \"s, \" + d.saved.length + \" saved session\" + (d.saved.length == 1 ? \"\" : \"s\");\n  if (d.sess) dcLine += \", recording '\" + d.sess.name + \"' (\" + d.sess.fights + \" fights so far)\";\n  display_notice(\"[dmgchart] \" + dcLine + \".\", \"cyan\");\n  if (dcF) {\n    var dcDur = Math.max(1, (dcF.last - dcF.start) / 1000);\n    var dcAgo = Math.round((Date.now() - dcF.last) / 1000);\n    display_notice(\"[dmgchart] last fight: \" + Math.round(dcDur) + \"s, dealt \" + dcF.outTotal + \" (\" + Math.round(dcF.outTotal / dcDur) + \"/s), taken \" + dcF.incTotal + \" (\" + Math.round(dcF.incTotal / dcDur) + \"/s), \" + (Date.now() - dcF.last > d.gap * 1000 ? \"ended \" + dcAgo + \"s ago\" : \"under way\") + \".\", \"cyan\");\n  } else {\n    display_notice(\"[dmgchart] no fight yet.\", \"cyan\");\n  }\n  display_notice(\"[dmgchart] tab showing \" + (d.view == \"session\" ? \"the recording\" : (d.view ? \"saved session #\" + d.view : \"the live fight\")) + \". DMGCHART HELP for commands.\", \"cyan\");\n} else if (sub == \"help\") {\n  run_function(\"dmgchart_help\", [], \"dmgchart\");\n} else if (sub == \"list\") {\n  if (!d.saved.length) {\n    display_notice(\"[dmgchart] no saved sessions. DMGCHART START [name] to record one.\", \"cyan\");\n  } else {\n    display_notice(\"[dmgchart] \" + d.saved.length + \" saved session\" + (d.saved.length == 1 ? \"\" : \"s\") + \", newest first:\", \"cyan\");\n    for (var li = d.saved.length - 1; li >= 0; li--) {\n      var lv = d.saved[li];\n      var lcs = Math.max(1, lv.combatMs / 1000);\n      var ldt = new Date(lv.start);\n      display_notice(\"  #\" + lv.id + \" \" + lv.name + \" - \" + ldt.getDate() + \"/\" + (ldt.getMonth() + 1) + \", \" + lv.fights + \" fights, \" + (lcs < 60 ? Math.round(lcs) + \"s\" : Math.round(lcs / 60) + \"m\") + \" in combat, dealt \" + Math.round(lv.outTotal / lcs) + \"/s, taken \" + Math.round(lv.incTotal / lcs) + \"/s\");\n    }\n  }\n} else if (sub == \"rebuild\") {\n  // Empty the namespace, keeping only the health reading, then build it again\n  // from the saved variables.\n  client.loom.dmgchart = { hp: d.hp };\n  run_function(\"dmgchart_setup\", [], \"dmgchart\");\n  d = client.loom.dmgchart;\n  display_notice(\"[dmgchart] rebuilt from the saved variables (gap \" + d.gap + \"s, window \" + d.window + \"s\" + (d.sess ? \", recording '\" + d.sess.name + \"' resumed from its last checkpoint\" : \"\") + \")\", \"lime\");\n} else if (sub == \"debug\") {\n  display_notice(\"[dmgchart] gap=\" + d.gap + \" window=\" + d.window + \" recent=\" + (d.recent ? d.recent.length : 0) + \" view='\" + d.view + \"' saved=\" + d.saved.length + \" nextId=\" + d.nextId + \" hp=\" + d.hp + \" sess=\" + (d.sess ? d.sess.name + \"/\" + d.sess.fights : \"none\") + \" fight=\" + (d.fight ? d.fight.outTotal + \"/\" + d.fight.incTotal : \"none\") + \" lastInc=\" + (d.lastInc ? d.lastInc.type + \":\" + d.lastInc.amt : \"none\"), \"orange\");\n} else {\n  display_notice(\"[dmgchart] unknown command '\" + sub + \"'. DMGCHART HELP for commands.\", \"orange\");\n}\nrun_function(\"dmgchart_render\", [], \"dmgchart\");\n"
    }
   ],
   "text": "^dmgchart(?:\\s+(.*))?$",
   "matching": "regexp",
   "whole_words": false,
   "case_sensitive": false,
   "prefix_suffix": true
  }
 ],
 "description": "Damage dealt and taken by type per fight, healing, recorded sessions"
}